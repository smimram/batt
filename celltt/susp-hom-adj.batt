open import stdlib
open import bipointed
open import suspension
open import hom

--
-- The adjunction susp ⊣ hom 
--

-- unit
susphom-unit ∷ (X ∷ U) → X → hom' (susp' X)
susphom-unit = merid'

-- counit
susphom-counit ∷ (X' ∷ Ubipt) → mapbipt (susp' (hom' X')) X'
susphom-counit X' =
  let X ∷ U = type-Ubipt X' in
  let x0 ∷ X = leftpt X' in
  let x1 ∷ X = rightpt X' in
  let leg-cyl ∷ hom' X' ⨂ I → X = λ (f ⊗ s) . oplax-oplaxbipt I' X' f s in
  let leg-bool ∷ Bool → X = ind-bool X x0 x1 in
  let ho-legs ∷ (u : hom' X' ⨂ Bool) → leg-cyl (cylbnd-inclusion (hom' X') u) ≡ leg-bool (tens-snd (hom' X') Bool u) =
    λ (f ⊗ b) . rec-bool (λb. leg-cyl (cylbnd-inclusion (hom' X') (f ⊗ b)) ≡ leg-bool (tens-snd (hom' X') Bool (f ⊗ b)))
      (oplaxleftcoh I' X' f) (oplaxrightcoh I' X' f) b
  in
  let counit-map : susp (hom' X') → X = pushout-univ (cylbnd-inclusion (hom' X')) (tens-snd (hom' X') Bool) X leg-cyl leg-bool ho-legs in
  let counit-lcoh : counit-map (left-susp (hom' X')) ≡ x0 =
    pushout-univr (cylbnd-inclusion (hom' X')) (tens-snd (hom' X') Bool) X leg-cyl leg-bool ho-legs false
  in
  let counit-rcoh : counit-map (right-susp (hom' X')) ≡ x1 =
    pushout-univr (cylbnd-inclusion (hom' X')) (tens-snd (hom' X') Bool) X leg-cyl leg-bool ho-legs true
  in
  (counit-map, (counit-lcoh, counit-rcoh))

--
-- susp X →.. (Y,y₀,y₁) // X → hom (Y,y₀,y₁)
--

to-hom-from-susp ∷ (X ∷ U) (Y' ∷ Ubipt) → mapbipt (susp' X) Y' → X → hom' Y'
to-hom-from-susp X Y' f' x =
  let Y ∷ U = type-Ubipt Y' in
  let y0 ∷ Y = leftpt Y'  in
  let y1 ∷ Y = rightpt Y' in
  let f : susp X → Y = map-mapbipt (susp' X) Y' f' in
  let f0 : f (left-susp X)  ≡ y0 = leftcoh  (susp' X) Y' f' in
  let f1 : f (right-susp X) ≡ y1 = rightcoh (susp' X) Y' f' in
  let cyl-to-Y : X ⨂ I → Y = circ f (cyl-to-susp X) in
  let arrow-x : I →ᵣ Y = λ sᵣ. cyl-to-Y (x ⊗ s) in
  let p0 : arrow-x I0 ≡ f (left-susp X)  = cong f (cyl-to-susp X (x ⊗ I0)) (left-susp X)  (cyl-to-susp-leftcoh X x)  in
  let p1 : arrow-x I1 ≡ f (right-susp X) = cong f (cyl-to-susp X (x ⊗ I1)) (right-susp X) (cyl-to-susp-rightcoh X x) in
  let leftcoh-arrow-x  : arrow-x I0 ≡ y0 = trans (arrow-x I0) (f (left-susp X))  p0 y0 f0 in
  let rightcoh-arrow-x : arrow-x I1 ≡ y1 = trans (arrow-x I1) (f (right-susp X)) p1 y1 f1 in
  (arrow-x, (leftcoh-arrow-x, rightcoh-arrow-x))