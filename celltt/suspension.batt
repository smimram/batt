open import stdlib
open import interval
open import bipointed

-- Gray cylinder
cyl ∷ (X ∷ U) → U
cyl X = X ⨂ I

-- Boundary of the Gray cylinder
cylbnd ∷ (X ∷ U) → U
cylbnd X = X ⨂ Bool

-- Inclusion X ⨂ ∂I ↪ X ⨂ I
cylbnd-inclusion ∷ (X ∷ U) → cylbnd X → cyl X
cylbnd-inclusion X = tens-map id boundary-inclusion

-- Suspension operation
susp ∷ (X ∷ U) → U
susp X = pushout-obj (cylbnd-inclusion X) tens-snd

-- map from the Gray cylinder (quotient map)
cyl-to-susp ∷ (X ∷ U) → X ⨂ I → susp X
cyl-to-susp X = pushout-inl (cylbnd-inclusion X) tens-snd

-- inclusion ∂I ↪ susp X
bool-to-susp ∷ (X ∷ U) → Bool → susp X
bool-to-susp X = pushout-inr (cylbnd-inclusion X) tens-snd

-- left (source) point of the suspension
left-susp ∷ (X ∷ U) → susp X
left-susp X = bool-to-susp X false

-- right (sink) point of the suspension
right-susp ∷ (X ∷ U) → susp X
right-susp X = bool-to-susp X true

-- bipointed suspension type
susp' ∷ (X ∷ U) → Ubipt
susp' X = (susp(X), (left-susp(X), right-susp(X)))

cyl-to-susp-leftcoh ∷ {X ∷ U} (x : X) → cyl-to-susp X (x ⊗ I0) ≡ left-susp X
cyl-to-susp-leftcoh {X} x = pushout-eq (cylbnd-inclusion X) tens-snd (x ⊗ false)

cyl-to-susp-rightcoh ∷ {X ∷ U} (x : X) → cyl-to-susp X (x ⊗ I1) ≡ right-susp X
cyl-to-susp-rightcoh {X} x = pushout-eq (cylbnd-inclusion X) tens-snd (x ⊗ true)

--
-- canonical projection (susp X → I)
--

-- auxiliary homotopy
ho-susp-to-I ∷ (X ∷ U) (u : X ⨂ Bool) → tens-snd (cylbnd-inclusion X u) ≡ boundary-inclusion (tens-snd {X} {Bool} u)
ho-susp-to-I X (x ⊗ b) = rec-bool (λb. tens-snd (cylbnd-inclusion X (x ⊗ b)) ≡ boundary-inclusion b) refl refl b

-- the projection
susp-to-I ∷ (X ∷ U) → susp X → I
susp-to-I X = pushout-univ (cylbnd-inclusion X) tens-snd I
  tens-snd boundary-inclusion (ho-susp-to-I X)

-- meridian map
merid ∷ {X ∷ U} (x : X) → (I →ᵣ susp X)
merid {X} x s = cyl-to-susp X (x ⊗ s)

lcoh-merid ∷ {X ∷ U} (x : X) → merid x I0 ≡ left-susp X
lcoh-merid x = cyl-to-susp-leftcoh x

rcoh-merid ∷ {X ∷ U} (x : X) → merid x I0 ≡ right-susp X
rcoh-merid x = cyl-to-susp-rightcoh x

merid' ∷ {X ∷ U} (x : X) → oplaxbipt I' (susp' X)
merid' x = (merid(x), (lcoh-merid(x), rcoh-merid(x)))

--
-- functoriality of the suspension
--

susp-map ∷ (X Y ∷ U) (f ∷ X → Y) → susp X → susp Y
susp-map X Y f =
  let leg-cyl ∷ X ⨂ I → susp Y = circ (cyl-to-susp Y) (tens-map f id) in
  let leg-bool ∷ Bool → susp Y = bool-to-susp Y in
  let ho-legs ∷ (u : X ⨂ Bool) → leg-cyl (cylbnd-inclusion X u) ≡ leg-bool (tens-snd u) =
    λ (x ⊗ b) . pushout-eq (cylbnd-inclusion Y) tens-snd (f(x) ⊗ b)
  in
  pushout-univ (cylbnd-inclusion X) tens-snd (susp Y)
    leg-cyl leg-bool ho-legs