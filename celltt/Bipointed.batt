open import Stdlib

-- type of bipointed types
Ubipt ∷ TYPE
Ubipt = Σ (X : U) . (X × X)

type-Ubipt ∷ Ubipt → U
type-Ubipt (X, _) = X

leftpt ∷ (X' : Ubipt) → type-Ubipt X'
leftpt (X, u) = fst (λ_.X) u

rightpt ∷ (X' : Ubipt) → type-Ubipt X'
rightpt (X, u) = snd (λ_.X) u

-- type of bipointed maps between bipointed types
mapbipt ∷ (X' Y' : Ubipt) → U
mapbipt X' Y' =
  let X : U = type-Ubipt X' in
  let Y : U = type-Ubipt Y' in
  Σ (f : X → Y) . ((f (leftpt X') ≡ leftpt Y') × (f (rightpt X') ≡ rightpt Y'))

map-mapbipt ∷ {X' Y' : Ubipt} → mapbipt X' Y' → type-Ubipt X' → type-Ubipt Y'
map-mapbipt (f, _) = f

leftcoh ∷ {X' Y' : Ubipt} → (f' : mapbipt X' Y') → map-mapbipt f' (leftpt X') ≡ leftpt Y'
leftcoh {X'} {Y'} (f, u) = fst (λ_. f (rightpt X') ≡ rightpt Y') u

rightcoh ∷ {X' Y' : Ubipt} → (f' : mapbipt X' Y') → map-mapbipt f' (rightpt X') ≡ rightpt Y'
rightcoh {X'} {Y'} (f, u) = snd (λ_. f (rightpt X') ≡ rightpt Y') u

-- identity and composition for bipointed maps
idbipt ∷ {X' : Ubipt} → mapbipt X' X'
idbipt {X'} = (id, refl, refl)

circbipt ∷ {X' Y' Z' : Ubipt} → mapbipt Y' Z' → mapbipt X' Y' → mapbipt X' Z'
circbipt {X'} {Y'} {Z'} g' f' =
  let X : U = type-Ubipt X' in
  let x0 : X = leftpt X' in
  let x1 : X = rightpt X' in
  let Y : U = type-Ubipt Y' in
  let y0 : Y = leftpt Y' in
  let y1 : Y = rightpt Y' in
  let Z : U = type-Ubipt Z' in
  let z0 : Z = leftpt Z' in
  let z1 : Z = rightpt Z' in
  let f : X → Y = map-mapbipt f' in
  let g : Y → Z = map-mapbipt g' in
  let fx0-y0 : f x0 ≡ y0 = leftcoh f' in
  let fx1-y1 : f x1 ≡ y1 = rightcoh f' in
  let gy0-z0 : g y0 ≡ z0 = leftcoh g' in
  let gy1-z1 : g y1 ≡ z1 = rightcoh g' in
  let gf : X → Z = circ g f in
  let gfx0-gy0 : g (f x0) ≡ g y0 = cong g fx0-y0 in
  let gfx1-gy1 : g (f x1) ≡ g y1 = cong g fx1-y1 in
  let gfx0-z0 : g (f x0) ≡ z0 = trans gfx0-gy0 gy0-z0 in
  let gfx1-z1 : g (f x1) ≡ z1 = trans gfx1-gy1 gy1-z1 in
  (gf, (gfx0-z0, gfx1-z1))

-- oplax type of bipointed maps between bipointed types
oplaxbipt ∷ (X' Y' ∷ Ubipt) → U
oplaxbipt X' Y' =
  let X ∷ U = type-Ubipt X' in
  let Y ∷ U = type-Ubipt Y' in
  Σ (f : X →ᵣ Y) . ((f (leftpt X') ≡ leftpt Y') × (f (rightpt X') ≡ rightpt Y'))

oplax-oplaxbipt ∷ {X' Y' ∷ Ubipt} → oplaxbipt X' Y' → type-Ubipt X' →ᵣ type-Ubipt Y'
oplax-oplaxbipt (f, _) = f

oplaxleftcoh ∷ {X' Y' ∷ Ubipt} → (f' : oplaxbipt X' Y') → oplax-oplaxbipt f' (leftpt X') ≡ leftpt Y'
oplaxleftcoh {X'} {Y'} (f, u) = fst (λ_. f (rightpt X') ≡ rightpt Y') u

oplaxrightcoh ∷ {X' Y' ∷ Ubipt} → (f' : oplaxbipt X' Y') → oplax-oplaxbipt f' (rightpt X') ≡ rightpt Y'
oplaxrightcoh {X'} {Y'} (f, u) = snd (λ_. f (rightpt X') ≡ rightpt Y') u

-- bipointed homotopies of bipointed maps

biptho : {X' Y' ∷ Ubipt} (f' g' : mapbipt X' Y') → U
biptho {X'} {Y'} f' g' =
  let X : U = type-Ubipt X' in
  let Y : U = type-Ubipt Y' in
  let x0 : X = leftpt X' in
  let x1 : X = rightpt X' in
  let y0 : Y = leftpt Y' in
  let y1 : Y = rightpt Y' in
  let f : X → Y = map-mapbipt f' in
  let f0 : f x0 ≡ y0 = leftcoh f' in
  let f1 : f x1 ≡ y1 = rightcoh f' in
  let g : X → Y = map-mapbipt g' in
  let g0 : g x0 ≡ y0 = leftcoh g' in 
  let g1 : g x1 ≡ y1 = rightcoh g' in
  Σ (H : ho f g) . (f0 ≡ trans (H x0) g0) × (f1 ≡ trans (H x1) g1)
