-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A : U) → (B : U) → (A → B) → A → B
app = fun A → fun B → fun f → fun x → (f x)

cstf : Unit → Bool
cstf = λ u → Unit_ind (x, Bool, false, u)

