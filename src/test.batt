open import stdlib

-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A B : U) → (A → B) → A → B
app A B f x = f x

bnot : Bool → Bool
bnot = Bool_ind(true,false)

cstf : Unit → Bool
cstf tt = false

-- identity on bool
idBool : Bool → Bool
idBool x = x

idBool' : Bool → Bool
idBool' = Bool_ind(false,true)

idBool'IsId : (b : Bool) → idBool' b ≡ b
idBool'IsId = Bool_ind(refl,refl)

-- fst : (A B : U) → A × B → A
-- fst A B (x,y) = x

-- testing let
n : Bool
n =
  let id : (A : Type) → A → A = λ A x → x in
  id Bool false

---
--- Bunches
---

idt :: (A B :: U) → A ⨂ B → A ⨂ B
idt A B (x ⊗ y) = x ⊗ y

fstb :: Bool ⨂ Bool → Bool
fstb (x ⊗ y) = x

sndb :: Bool ⨂ Bool → Bool
sndb (x ⊗ y) = y

-- idt :: (A B :: U) → A ⨂ B → A ⨂ B
-- idt A B (x ⊗ y) = x ⊗ y

-- -- TODO: this is not supposed to work
-- swap :: (A B :: U) → A ⨂ B → B ⨂ A
-- swap A B (x ⊗ y) = y ⊗ x

pi-to-arr :: (A B :: U) → (A → B) → (A →ₗ B)
pi-to-arr A B f aₗ = f a

comp-left :: (A B C :: U) → (A →ₗ B) →ₗ (B →ₗ C) →ₗ (A →ₗ C)
comp-left A B C fₗ gₗ aₗ = g (f a)

unitl :: (A :: U) → ⊤ ⨂ A → A
unitl A (x ⊗ a) = a

counitl :: (A :: U) → A → ⊤ ⨂ A
counitl A a = (tt ⊗ a)

unitl-counitl :: (A :: U) (a : A) → unitl A (counitl A a) ≡ a
unitl-counitl A a = refl

counitl-unitl :: (A :: U) (x : ⊤ ⨂ A) → counitl A (unitl A x) ≡ x
counitl-unitl A (t ⊗ a) =
  -- let tt = t in refl
  let f : (t : ⊤) → counitl A (unitl A (t ⊗ a)) ≡ (t ⊗ a) = λ tt → refl in
  f t

flat-tens-to-prod :: (A B :: U) → ♭(A ⨂ B) → ♭(A × B)
flat-tens-to-prod A B = flat-map (A ⨂ B) (A × B) (tens-to-prod A B)
-- flat-tens-to-prod A B 𝄫ab =
--   let f : (ab ∷ A ⨂ B) → ♭(A × B) = fun (a ⊗ b) → 𝄫 (a , b) in
--   f ab

flat-prod-to-tens :: (A B ∷ U) → ♭(A × B) → ♭(A ⨂ B)
flat-prod-to-tens A B 𝄫ab =
  let f : (ab :: A × B) → ♭(A ⨂ B) = fun (a , b) → 𝄫(a ⊗ b) in
  f ab

flat-prod-to-tens-to-prod :: (A B :: U) (x : ♭(A × B)) → flat-tens-to-prod A B (flat-prod-to-tens A B x) ≡ x
flat-prod-to-tens-to-prod A B 𝄫x =
  let f : (x : A × B) → flat-tens-to-prod A B (flat-prod-to-tens A B 𝄫x) ≡ 𝄫x = fun (a , b) → refl in
  f x

flat-tens-to-prod-to-tens :: (A B :: U) (x : ♭(A ⨂ B)) → flat-prod-to-tens A B (flat-tens-to-prod A B x) ≡ x
flat-tens-to-prod-to-tens A B 𝄫x =
  let f : (x : A ⨂ B) → flat-prod-to-tens A B (flat-tens-to-prod A B 𝄫x) ≡ 𝄫x = fun (a ⊗ b) → refl in
  f x
