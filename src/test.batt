  -- f ab

curry-left :: (A B C :: U) → (A ⨂ B → C) → (B → A →ₗ C)
curry-left A B C f a bₗ = f (b ⊗ a)

curry-right :: (A B C :: U) → (A ⨂ B → C) → (A → B →ᵣ C)
curry-right A B C f a bᵣ = f (a ⊗ b)

-- -- Not supposed to work
-- curry-bad :: (A B C :: U) → (A ⨂ B → C) → (B → A →ᵣ C)
-- curry-bad A B C f a bᵣ = f (b ⊗ a)

uncurry-left :: (A B C :: U) → (B → A →ₗ C) → (A ⨂ B → C)
uncurry-left A B C f (a ⊗ b) = f b a

-- stronger version with a →ₗ
uncurry-left-left :: (A B C :: U) → (B →ₗ A →ₗ C) → (A ⨂ B →ₗ C)
uncurry-left-left A B C f uₗ =
  let g : A ⨂ B → C = λ (a ⊗ b) → f b a in
  g u

uncurry-right :: (A B C :: U) → (A → B →ᵣ C) → (A ⨂ B → C)
uncurry-right A B C f (a ⊗ b) = f a b

uncurry-curry-left :: (A B C :: U) (f : A ⨂ B → C) (u : A ⨂ B) → uncurry-left A B C (curry-left A B C f) u ≡ f u
uncurry-curry-left A B C f (a ⊗ b) = refl

curry-uncurry-left :: (A B C :: U) (f : B → A →ₗ C) → curry-left A B C (uncurry-left A B C f) ≡ (λ b aₗ → f b a)
curry-uncurry-left A B C f = refl

comp-left :: (A B C :: U) → (A →ₗ B) →ₗ (B →ₗ C) →ₗ (A →ₗ C)
comp-left A B C fₗ gₗ aₗ = g (f a)

unitl :: (A :: U) → ⊤ ⨂ A → A
unitl A (x ⊗ a) = a

counitl :: (A :: U) → A → ⊤ ⨂ A
counitl A a = (tt ⊗ a)

unitl-counitl :: (A :: U) (a : A) → unitl A (counitl A a) ≡ a
unitl-counitl A a = refl

counitl-unitl :: (A :: U) (x : ⊤ ⨂ A) → counitl A (unitl A x) ≡ x
counitl-unitl A (t ⊗ a) =
  -- let tt = t in refl
  let f : (t : ⊤) → counitl A (unitl A (t ⊗ a)) ≡ (t ⊗ a) = λ tt → refl in
  f t
