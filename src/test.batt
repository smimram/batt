-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A B : U) → (A → B) → A → B
app A B f x = f @ x

bnot : Bool → Bool
bnot = Bool_ind(true,false)

cstf : Unit → Bool
cstf tt = false

-- terminal arrow
term : (A : U) → A → Unit
term A x = tt

-- polymorphic identity
id :: (A : U) → A → A
id A x = x

-- identity on bool
idBool : Bool → Bool
idBool x = x

idBool' : Bool → Bool
idBool' = Bool_ind(false,true)

idBool'IsId : (b : Bool) → idBool' @ b ≡ b
idBool'IsId = Bool_ind(refl,refl)

-- fst : (A B : U) → A × B → A
-- fst A B (x,y) = x

fst :: (A : U) (B : A → U) → (Σ (x : A) . B @ x) → A
fst A B (x,y) = x

snd :: (A B : U) → A × B → B
snd A B (x,y) = y

not :: (A : Type) → Type
not A = Empty

exfalso : (A : Type) → ⊥ → A
exfalso A ()

-- testing let
n : Bool
n =
  let id : (A : Type) → A → A = λ A x → x in
  id @ Bool @ false

---
--- Identity types
---

r : (A : U) (x : A) → (x ≡ x)
r A x = refl

sym : (A : Type) (x y : A) → x ≡ y → y ≡ x
sym A refl = refl

trans : (A : Type) (x y : A) → x ≡ y → (z : A) → y ≡ z → x ≡ z
trans A refl z p = p

cong : (A B : Type) (f : A → B) (x y : A) → x ≡ y → f @ x ≡ f @ y
cong A B f refl = refl

transport : (A B : Type) → A ≡ B → A → B
transport refl A = A

subst : (A : Type) (P : A → Type) (x y : A) → x ≡ y → P @ x → P @ y
subst A P refl z = z

---
--- Flat
---

flat : ♭U → U
flat 𝄫A = A

unflatten : (A :: U) → ♭A → A
unflatten A 𝄫x = x
