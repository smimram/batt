-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A B : U) → (A → B) → A → B
app A B f x = f @ x

bnot : Bool → Bool
bnot = Bool_ind(true,false)

cstf : Unit → Bool
cstf tt = false

-- terminal arrow
term : (A : U) → A → Unit
term A x = tt

-- polymorphic identity
id : (A : U) → A → A
id A x = x

r : (A : U) (x : A) → (x ≡ x)
r A x = refl

-- identity on bool
idBool : Bool → Bool
idBool x = x

idBool' : Bool → Bool
idBool' = Bool_ind(false,true)

idBool'IsId : (b : Bool) → idBool' @ b ≡ b
idBool'IsId = Bool_ind(refl,refl)

-- fst : (A B : U) → A × B → A
-- fst A B (x,y) = x

fst : (A : U) (B : A → U) → (Σ (x : A) . B @ x) → A
fst A B (x,y) = x

snd : (A B : U) → A × B → B
snd A B (x,y) = y

not : (A : Type) → Type
not A = Empty

exfalso : (A : Type) → ⊥ → A
exfalso A ()

---
--- Flat
---

unflatten : (A :: U) → ♭A → A
unflatten A 𝄫x = x
-- unflatten A = ♭_ind(x, x)
-- unflatten = fun A a → let♭ x = a in x

-- unflatten : (A : U) → ♭A → A
-- unflatten = fun A → ♭_ind(A,♭_ind(x, x)) @ 𝄫A

-- unflatten : (A : ♭U) → ♭A → A
-- unflatten = ♭_ind(A,♭_ind(x, x))

-- should not work
-- flatten : (A :: U) → A → ♭A
-- flatten = fun A → fun a → 𝄫a

-- Lemma 4.4 in Sulman 2017
flat-eta : (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C @ x) (x : ♭A) → C @ x
flat-eta A C f 𝄫x = f @ 𝄫x

-- flat-unique : (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C @ x) (x : ♭A) → flat-eta A C f x ≡ f @ x


---
--- Bunch
---

fstb : Bool ⨂ Bool → Bool
fstb (x ⊗ y) = x

