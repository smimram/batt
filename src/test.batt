-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A B : U) → (A → B) → A → B
app A B f x = f @ x

bnot : Bool → Bool
bnot = Bool_ind(true,false)

cstf : Unit → Bool
cstf tt = false

-- terminal arrow
term : (A : U) → A → Unit
term A x = tt

-- polymorphic identity
id : (A : U) → A → A
id A x = x

r : (A : U) (x : A) → (x ≡ x)
r A x = refl

-- identity on bool
idBool : Bool → Bool
idBool x = x

idBool' : Bool → Bool
idBool' = Bool_ind(false,true)

idBool'IsId : (b : Bool) → (idBool' @ b) ≡ b
idBool'IsId = Bool_ind(refl,refl)

fst : (A B : U) → A × B → A
fst A B (x,y) = x

snd : (A B : U) → A × B → B
snd A B (x,y) = y

---
--- Flat
---

unflatten : (A :: U) → ♭A → A
unflatten A 𝄫x = x
