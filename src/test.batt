---
--- Bunches
---

idt :: (A B :: U) → A ⨂ B → A ⨂ B
idt A B (x ⊗ y) = x ⊗ y

fstb :: Bool ⨂ Bool → Bool
fstb (x ⊗ y) = x

sndb :: Bool ⨂ Bool → Bool
sndb (x ⊗ y) = y

-- idt :: (A B :: U) → A ⨂ B → A ⨂ B
-- idt A B (x ⊗ y) = x ⊗ y

-- -- TODO: this is not supposed to work
-- swap :: (A B :: U) → A ⨂ B → B ⨂ A
-- swap A B (x ⊗ y) = y ⊗ x

fst :: (A B :: U) → A ⨂ B → A
fst A B (a ⊗ b) = a

snd :: (A B :: U) → A ⨂ B → A
snd A B (a ⊗ b) = a

tens-to-prod :: (A B :: U) → A ⨂ B → A × B
tens-to-prod A B (a ⊗ b) = (a , b)

pi-to-arr :: (A B :: U) → (A → B) → (A →ₗ B)
pi-to-arr A B f aₗ = f a

