--- Formalizing Shulman 2017

-- Lemma 4.4
-- flat-unique : (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → ((λ 𝄫u → f 𝄫 u) x) ≡ f x
-- flat-unique A C f 𝄫x = refl

flat-eta :: (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → C x
flat-eta A C f 𝄫x = f 𝄫x

flat-unique :: (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → flat-eta A C f x ≡ f x
flat-unique A C f 𝄫x = refl

-- TODO: dependent version?
flat-map :: (A :: Type) (B :: Type) (f :: A → B) → ♭A → ♭B
flat-map A B f 𝄫a = 𝄫(f a)

-- -- Lemma 5.2
-- flat-commutation : (A : Type) (B : ♭A → Type) (M : ♭A) (N : (u : A) → B 𝄫u) →

---
--- Bunches
---

idt :: (A B :: U) → A ⨂ B → A ⨂ B
idt A B (x ⊗ y) = x ⊗ y

fstb :: Bool ⨂ Bool → Bool
fstb (x ⊗ y) = x

sndb :: Bool ⨂ Bool → Bool
sndb (x ⊗ y) = y

-- idt :: (A B :: U) → A ⨂ B → A ⨂ B
-- idt A B (x ⊗ y) = x ⊗ y

-- -- TODO: this is not supposed to work
-- swap :: (A B :: U) → A ⨂ B → B ⨂ A
-- swap A B (x ⊗ y) = y ⊗ x

fst :: (A B :: U) → A ⨂ B → A
fst A B (a ⊗ b) = a

snd :: (A B :: U) → A ⨂ B → A
snd A B (a ⊗ b) = a

tens-to-prod :: (A B :: U) → A ⨂ B → A × B
tens-to-prod A B (a ⊗ b) = (a , b)

pi-to-arr :: (A B :: U) → (A → B) → (A →ₗ B)
pi-to-arr A B f aₗ = f a

assoc :: (A B C :: U) → (A ⨂ B) ⨂ C → A ⨂ (B ⨂ C)
assoc A B C (ab ⊗ c) =
  let f : A ⨂ B → C →ᵣ A ⨂ (B ⨂ C) = fun (a ⊗ b) cᵣ → a ⊗ (b ⊗ c) in
  f ab c

coassoc :: (A B C :: U) → A ⨂ (B ⨂ C) → (A ⨂ B) ⨂ C
coassoc A B C (a ⊗ bc) =
  let f : B ⨂ C → A →ₗ (A ⨂ B) ⨂ C = fun (b ⊗ c) aₗ → (a ⊗ b) ⊗ c in
  f bc a

curry-left :: (A B C :: U) → (A ⨂ B → C) → (B → A →ₗ C)
curry-left A B C f b aₗ = f (a ⊗ b)

uncurry-left :: (A B C :: U) → (B → A →ₗ C) → (A ⨂ B → C)
uncurry-left A B C f (a ⊗ b) = f b a

curry-right :: (A B C :: U) → (A ⨂ B → C) → (A → B →ᵣ C)
curry-right A B C f a bᵣ = f (a ⊗ b)

uncurry-right :: (A B C :: U) → (A → B →ᵣ C) → (A ⨂ B → C)
uncurry-right A B C f (a ⊗ b) = f a b

-- stronger version with a →ₗ
curry-left-l :: (A B C :: U) → (A ⨂ B →ₗ C) → (B →ₗ A →ₗ C)
curry-left-l A B C f bₗ aₗ = f (a ⊗ b)

uncurry-left-l :: (A B C :: U) → (B →ₗ A →ₗ C) → (A ⨂ B →ₗ C)
uncurry-left-l A B C f abₗ =
  let g : A ⨂ B → C = λ (a ⊗ b) → f b a in
  g ab

uncurry-right-r :: (A B C :: U) → (A →ᵣ B →ᵣ C) → (A ⨂ B →ᵣ C)
uncurry-right-r A B C f abᵣ =
  let g : A ⨂ B → C = fun (a ⊗ b) → f a b in
  g ab

-- version of assoc using curry-l/r
assoc :: (A B C :: U) → (A ⨂ B) ⨂ C → A ⨂ (B ⨂ C)
assoc A B C =
  uncurry-right (A ⨂ B) C (A ⨂ (B ⨂ C))
    (uncurry-right A B (C →ᵣ A ⨂ (B ⨂ C))
      (λ a bᵣ cᵣ → a ⊗ (b ⊗ c)))

uncurry-curry-left :: (A B C :: U) (f : A ⨂ B → C) (u : A ⨂ B) → uncurry-left A B C (curry-left A B C f) u ≡ f u
uncurry-curry-left A B C f (a ⊗ b) = refl

curry-uncurry-left :: (A B C :: U) (f : B → A →ₗ C) → curry-left A B C (uncurry-left A B C f) ≡ (λ b aₗ → f b a)
curry-uncurry-left A B C f = refl


comp-left :: (A B C :: U) → (A →ₗ B) →ₗ (B →ₗ C) →ₗ (A →ₗ C)
comp-left A B C fₗ gₗ aₗ = g (f a)

unitl :: (A :: U) → ⊤ ⨂ A → A
unitl A (x ⊗ a) = a

counitl :: (A :: U) → A → ⊤ ⨂ A
counitl A a = (tt ⊗ a)

unitl-counitl :: (A :: U) (a : A) → unitl A (counitl A a) ≡ a
unitl-counitl A a = refl

counitl-unitl :: (A :: U) (x : ⊤ ⨂ A) → counitl A (unitl A x) ≡ x
counitl-unitl A (t ⊗ a) =
  -- let tt = t in refl
  let f : (t : ⊤) → counitl A (unitl A (t ⊗ a)) ≡ (t ⊗ a) = λ tt → refl in
  f t

flat-tens-to-prod :: (A B :: U) → ♭(A ⨂ B) → ♭(A × B)
flat-tens-to-prod A B = flat-map (A ⨂ B) (A × B) (tens-to-prod A B)
-- flat-tens-to-prod A B 𝄫ab =
--   let f : (ab ∷ A ⨂ B) → ♭(A × B) = fun (a ⊗ b) → 𝄫 (a , b) in
--   f ab

flat-prod-to-tens :: (A B ∷ U) → ♭(A × B) → ♭(A ⨂ B)
flat-prod-to-tens A B 𝄫ab =
  let f : (ab :: A × B) → ♭(A ⨂ B) = fun (a , b) → 𝄫(a ⊗ b) in
  f ab

flat-prod-to-tens-to-prod :: (A B :: U) (x : ♭(A × B)) → flat-tens-to-prod A B (flat-prod-to-tens A B x) ≡ x
flat-prod-to-tens-to-prod A B 𝄫x =
  let f : (x : A × B) → flat-tens-to-prod A B (flat-prod-to-tens A B 𝄫x) ≡ 𝄫x = fun (a , b) → refl in
  f x

flat-tens-to-prod-to-tens :: (A B :: U) (x : ♭(A ⨂ B)) → flat-prod-to-tens A B (flat-tens-to-prod A B x) ≡ x
flat-tens-to-prod-to-tens A B 𝄫x =
  let f : (x : A ⨂ B) → flat-prod-to-tens A B (flat-tens-to-prod A B 𝄫x) ≡ 𝄫x = fun (a ⊗ b) → refl in
  f x
