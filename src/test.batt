-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

-- terminal arrow
term : (A : U) → A → Unit
term = fun A → fun x → tt

-- unflatten : (A :: U) → ♭A → A
-- unflatten = fun A → fun a → let♭ x = a in x

-- should not work
-- flatten : (A :: U) → A → ♭A
-- flatten = fun A → fun a → 𝄫a

-- identity on bool
idBool : Bool → Bool
idBool = fun x → x

-- polymorphic identity
id : (A : U) → A → A
id = fun A → fun x → x

