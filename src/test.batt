-- a boolean
b : Bool
b = false

-- a pair of booleans
bb : Bool × Bool
bb = (false , true)

bb' : Bool ⨂ Bool
bb' = (false ⊗ true)

app : (A B : U) → (A → B) → A → B
app = fun A B f x → f @ x

not : Bool → Bool
not = Bool_ind(true,false)

cstf : Unit → Bool
cstf = Unit_ind(false)

-- terminal arrow
term : (A : U) → A → Unit
term = fun A x → tt

unflatten : (A :: U) → ♭A → A
unflatten = fun A → ♭_ind(x, x)
-- unflatten = fun A a → let♭ x = a in x

-- unflatten : (A : U) → ♭A → A
-- unflatten = fun A → ♭_ind(A,♭_ind(x, x)) @ (𝄫 A)

-- unflatten : (A : ♭U) → ♭A → A
-- unflatten = ♭_ind(A,♭_ind(x, x))

-- should not work
-- flatten : (A :: U) → A → ♭A
-- flatten = fun A → fun a → 𝄫a

-- identity on bool
idBool : Bool → Bool
idBool = fun x → x

-- polymorphic identity
id : (A : U) → A → A
id = fun A x → x

r : (A : U) (x : A) → (x ≡ x)
r = fun A x → refl

