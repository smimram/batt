idt :: (A B :: U) → A ⨂ B → A ⨂ B
idt A B (x ⊗ y) = x ⊗ y

fstb :: Bool ⨂ Bool → Bool
fstb (x ⊗ y) = x

sndb :: Bool ⨂ Bool → Bool
sndb (x ⊗ y) = y

-- idt :: (A B :: U) → A ⨂ B → A ⨂ B
-- idt A B (x ⊗ y) = x ⊗ y

