-- swap A B (x ⊗ y) = y ⊗ x

fst :: (A B :: U) → A ⨂ B → A
fst A B (a ⊗ b) = a

snd :: (A B :: U) → A ⨂ B → A
snd A B (a ⊗ b) = a

tens-to-pair :: (A B :: U) → A ⨂ B → A × B
tens-to-pair A B (a ⊗ b) = (a , b)

