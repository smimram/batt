--
-- Cartesian products
--

pair ∷ {A B : U} → A → B → A × B
pair x y = (x , y)

fst ∷ {A B : U} → A × B → A
fst (x , y) = x

snd ∷ {A B : U} → A × B → B
snd (x , y) = y

---
--- Products preserve contractible types and propositions
---

open import Prop
open import Equality

is-contr-prod ∷ {A B : U} → is-contr A → is-contr B → is-contr (A × B)
is-contr-prod {A} {B} (a , p) (b , q) = ((a , b) , λ (x , y) . cong2 {A} {B} {A × B} pair (p x) (q y))

-- an inhabited proposition is contractible, and A × B is then a product of contractible types
is-prop-prod ∷ {A B : U} → is-prop A → is-prop B → is-prop (A × B)
is-prop-prod {A} {B} pA pB (a , b) v =
  let cA : is-contr A = (a , λ x . center (a ≡ x) (pA a x)) in
  let cB : is-contr B = (b , λ y . center (b ≡ y) (pB b y)) in
  is-contr→is-prop {A × B} (is-contr-prod {A} {B} cA cB) (a , b) v

-- transport in a family of pairs of paths with a fixed endpoint
subst-path-pair ∷ {X Y Y' : U} (l : X → Y) (l' : X → Y') {c : Y} {c' : Y'} {x x' : X} (P : x ≡ x') (q : l x ≡ c) (q' : l' x ≡ c') →
  subst (λ w . (l w ≡ c) × (l' w ≡ c')) P (q , q') ≡ (trans (sym (cong l P)) q , trans (sym (cong l' P)) q')
subst-path-pair {X} {Y} {Y'} l l' {c} {c'} {x} refl q q' = cong2 {l x ≡ c} {l' x ≡ c'} {(l x ≡ c) × (l' x ≡ c')} pair (sym (trans-refl-l q)) (sym (trans-refl-l q'))

-- paths into a pair, towards an arbitrary point, and η for them
prod-path-join' ∷ {A B : U} {a : A} {c : B} (w : A × B) → a ≡ fst w → c ≡ snd w → (a , c) ≡{A × B} w
prod-path-join' {A} {B} {a} {c} (d0 , d1) p0 p1 = cong2 {A} {B} {A × B} pair p0 p1

prod-path-join'-eta ∷ {A B : U} {a : A} {c : B} (w : A × B) (D : (a , c) ≡{A × B} w) →
  prod-path-join' {A} {B} {a} {c} w (cong (fst {A} {B}) D) (cong (snd {A} {B}) D) ≡ D
prod-path-join'-eta {A} {B} {a} {c} w D =
  J {A × B} (a , c) (λ w' D' . prod-path-join' {A} {B} {a} {c} w' (cong (fst {A} {B}) D') (cong (snd {A} {B}) D') ≡ D') refl D
