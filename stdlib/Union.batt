--
-- A union of two subtypes is the pushout of the two subtypes over their intersection
--
-- For a type X and two families of propositions A, B over X, the union
--   union A B := Σ (x : X) . A x ∨ B x
-- has the universal property of the pushout of Σ A ← Σ (A ∧ B) → Σ B: maps out of it are
-- cocones, pairs of maps out of Σ A and Σ B that agree on the intersection.
--
--   union-up : is-equiv (union-restr A B Y : (union A B → Y) → union-cocone A B Y)
--
-- No pushout type is used. Since the truncated ∨ only eliminates into propositions, a map out of
-- the union is defined through a descent family: at x, the type union-D of values compatible
-- with both pieces of the cocone, which is contractible as soon as A x ∨ B x holds.
--
-- References.
--
-- * For a single point (X = 1) this is the statement that the disjunction of two propositions is
--   their join, i.e. the pushout of P ← P × Q → Q. With pushouts as a higher inductive type it
--   is proved the other way round: the join P ∗ Q of propositions is a proposition and satisfies
--   the universal property of the disjunction, hence P ∗ Q ≃ P ∨ Q.
--     - E. Rijke, Introduction to Homotopy Type Theory, lecture notes, Carnegie Mellon University,
--       2018: exercise on joins of propositions in the lecture on homotopy pushouts
--     - The agda-unimath library, module synthetic-homotopy-theory.joins-of-types, section
--       "Disjunction is the join of propositions": equiv-disjunction-join-Prop : (P ∗ Q) ≃ (P ∨ Q),
--       with is-prop-join-is-prop.
--
-- * For a general X this is the statement that the join of two embeddings into X is their union
--   as subtypes, the join of maps f ∗ g being the pushout of A ← A ×_X B → B.
--     - E. Rijke, The join construction, arXiv:1701.07538 (2017): the fibres of the join of maps
--       are the joins of the fibres, and the join of two embeddings is again an embedding, namely
--       the union of the two subtypes.
--     - The agda-unimath library, module foundation.unions-subtypes: union-subtype P Q x = P x ∨ Q x.
--
-- * Defining a map out of a proposition by eliminating into the proposition is-contr of a type of
--   candidate values is a form of the principle of unique choice (The Univalent Foundations
--   Program, HoTT book, chapter on sets and logic: a family of propositions that is merely
--   inhabited everywhere has a section); the same device appears in the proofs above that P ∗ Q
--   is a proposition. Here it is applied fibrewise, without the join: the descent family union-D plays
--   the role of the type of candidate values.
--
-- Unlike the references, no pushout or join is assumed: the union is defined by the truncated
-- disjunction, and its universal property is proved directly. X need not be a set.
--

open import Equality
open import Product
open import Prop
open import Contr
open import Equivalence
open import PropTrunc
open import Sum
open import Funext
open import Sigma
open import Subtype

-- Union
union ∷ {X : U} → subtype X → subtype X → subtype X
union A B x = HProp.or (A x) (B x)

inl ∷ {X : U} {A B : subtype X} → ⟨ A ⟩ → ⟨ union A B ⟩
inl (x , a) = pt (or-l a)

inr ∷ {X : U} {A B : subtype X} → ⟨ B ⟩ → ⟨ union A B ⟩
inr (x , b) = pt (or-r b)

-- Intersection
intersection ∷ {X : U} → subtype X → subtype X → subtype X
intersection A B x = HProp.and (A x) (B x)

fst ∷ {X : U} {A B : subtype X} → ⟨ intersection A B ⟩ → ⟨ A ⟩
fst (x , ab) = pt (Product.fst ab)

snd ∷ {X : U} {A B : subtype X} → ⟨ intersection A B ⟩ → ⟨ B ⟩
snd (x , ab) = pt (Product.snd ab)

-- The two pieces agree on the intersection
glue ∷ {X : U} {A B : subtype X} → (c : ⟨ intersection A B ⟩) → inl (fst c) ≡ inr (snd c)
glue (x , ab) = cong pt (prop-path (is-prop-trunc _) (or-l (Product.fst ab)) (or-r (Product.snd ab)))

-- Cocones: two maps that agree on the intersection
cocone ∷ {X : U} (A B : subtype X) (Y : U) → U
cocone {X} A B Y =
  Σ (f : ⟨ A ⟩ → Y) .
  Σ (g : ⟨ B ⟩ → Y) .
  (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)

-- Restriction to the cocone
restr ∷ {X : U} {A B : subtype X} {Y : U} → (⟨ union A B ⟩ → Y) → cocone A B Y
restr f = (f ∘ inl , f ∘ inr , λ c . cong f (glue c))

--
-- The descent family of a cocone (f , g , h) at x: the candidate values for a map extending the
-- cocone, in the sense of the principle of unique choice (see the references above)
--

D-base ∷ {X : U} {A : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (x : X) → U
D-base f x = Σ (y : Y) . (a : x ∈ A) → y ≡ f (x , a)

D-fib ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → D-base f x → U
D-fib f g h x (y , α) =
  Σ (β : (b : x ∈ B) → y ≡ g (x , b)) . (a : x ∈ A) (b : x ∈ B) → β b ≡ trans (α a) (h (x , (a , b)))

D ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → U
D f g h x = Σ (u : D-base f x) . D-fib f g h x u

-- The descent family with the roles of the two pieces exchanged (the B-path first)
D'-base ∷ {X : U} {B : subtype X} {Y : U} (g : ⟨ B ⟩ → Y) (x : X) → U
D'-base g x = Σ (y : Y) . (b : x ∈ B) → y ≡ g (x , b)

D'-fib ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → D'-base g x → U
D'-fib f g h x (y , β) =
  Σ (α : (a : x ∈ A) → y ≡ f (x , a)) . (a : x ∈ A) (b : x ∈ B) → β b ≡ trans (α a) (h (x , (a , b)))

--
-- The descent family is contractible wherever x belongs to the union
--

-- If x ∈ A: contract the value with its A-path, then each B-path is determined
D-contr-A ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → x ∈ A → is-contr (D f g h x)
D-contr-A f g h x a0 =
  let κ : (a : x ∈ A) → a0 ≡ a = λ a . prop-path (is-prop-type (A x)) a0 a in
  let base : is-contr (D-base f x) =
    contr-Π-in-Σ (λ y a . y ≡ f (x , a)) a0 κ (is-contr-sing' (f (x , a0))) in
  let fib : (u : D-base f x) → is-contr (D-fib f g h x u) = λ (y , α) .
    let V : U = (b : x ∈ B) → Σ (βb : y ≡ g (x , b)) . (a : x ∈ A) → βb ≡ trans (α a) (h (x , (a , b))) in
    let F : U = D-fib f g h x (y , α) in
    let s : F → V = λ (β , γ) . λ b . (β b , λ a . γ a b) in
    let r : V → F = λ v .
      ((λ b . Sigma.fst (λ βb . (a : x ∈ A) → βb ≡ trans (α a) (h (x , (a , b)))) (v b)) ,
       (λ a b . Sigma.snd (λ βb . (a : x ∈ A) → βb ≡ trans (α a) (h (x , (a , b)))) (v b) a)) in
    let rs : (w : F) → r (s w) ≡ w = λ (β , γ) . refl in
    is-contr-retract s (r , rs)
      (is-contr-Π (λ b . Σ (βb : y ≡ g (x , b)) . (a : x ∈ A) → βb ≡ trans (α a) (h (x , (a , b))))
        (λ b . contr-Π-in-Σ (λ βb a . βb ≡ trans (α a) (h (x , (a , b)))) a0 κ
          (is-contr-sing' (trans (α a0) (h (x , (a0 , b)))))))
  in
  is-contr-Σ (D-fib f g h x) base fib

-- If x ∈ B: contract the value with its B-path, then each A-path is determined
D-contr-B ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → x ∈ B → is-contr (D f g h x)
D-contr-B f g h x b0 =
  let κ : (b : x ∈ B) → b0 ≡ b = λ b . prop-path (is-prop-type (B x)) b0 b in
  let D0 : U = D f g h x in
  let D1 : U = Σ (v : D'-base g x) . D'-fib f g h x v in
  let s : D0 → D1 = λ (u , w) .
    let k : (u : D-base f x) → D-fib f g h x u → D1 =
      fun (y , α) (β , γ) → ((y , β) , (α , γ)) in k u w in
  let r : D1 → D0 = λ (v , w) .
    let k : (v : D'-base g x) → D'-fib f g h x v → D0 =
      fun (y , β) (α , γ) → ((y , α) , (β , γ)) in k v w in
  let rs : (z : D0) → r (s z) ≡ z = λ (u , w) .
    let k : (u : D-base f x) (w : D-fib f g h x u) → r (s (u , w)) ≡ (u , w) =
      fun (y , α) (β , γ) → refl in k u w in
  let base : is-contr (D'-base g x) =
    contr-Π-in-Σ (λ y b . y ≡ g (x , b)) b0 κ (is-contr-sing' (g (x , b0))) in
  let fib : (v : D'-base g x) → is-contr (D'-fib f g h x v) = λ (y , β) .
    let V : U = (a : x ∈ A) → Σ (αa : y ≡ f (x , a)) . (b : x ∈ B) → β b ≡ trans αa (h (x , (a , b))) in
    let F : U = D'-fib f g h x (y , β) in
    let s' : F → V = λ (α , γ) . λ a . (α a , λ b . γ a b) in
    let r' : V → F = λ v .
      ((λ a . Sigma.fst {y ≡ f (x , a)} (λ αa . (b : x ∈ B) → β b ≡ trans αa (h (x , (a , b)))) (v a)) ,
       (λ a b . Sigma.snd {y ≡ f (x , a)} (λ αa . (b : x ∈ B) → β b ≡ trans αa (h (x , (a , b)))) (v a) b)) in
    let rs' : (w : F) → r' (s' w) ≡ w = λ (α , γ) . refl in
    is-contr-retract s' (r' , rs')
      (is-contr-Π (λ a . Σ (αa : y ≡ f (x , a)) . (b : x ∈ B) → β b ≡ trans αa (h (x , (a , b))))
        (λ a . contr-Π-in-Σ {y ≡ f (x , a)} (λ αa b . β b ≡ trans αa (h (x , (a , b)))) b0 κ
          (trans-contr (h (x , (a , b0))) (β b0))))
  in
  is-contr-retract s (r , rs) (is-contr-Σ (D'-fib f g h x) base fib)

D-contr ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → x ∈ union A B → is-contr (D f g h x)
D-contr f g h x w =
  PropTrunc.rec' (is-prop-is-contr (D f g h x))
    (Sum.rec (D-contr-A f g h x) (D-contr-B f g h x)) w

-- The value of a point of the descent family
D-y ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → D f g h x → Y
D-y f g h x (u , w) = Sigma.fst (λ y . (a : x ∈ A) → y ≡ f (x , a)) u

--
-- Extension from the cocone: the value of the center of the descent family
--

ext ∷ {X : U} {A B : subtype X} {Y : U} → cocone A B Y → (⟨ union A B ⟩ → Y)
ext (f , r) (x , w) =
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) → Y =
    fun (g , h) → D-y f g h x (center (D f g h x) (D-contr f g h x w)) in
  k r

--
-- The center of the descent family, and the paths and coherence of its points
--

Z ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) → x ∈ union A B → D f g h x
Z f g h x w = center (D f g h x) (D-contr f g h x w)

D-α ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (z : D f g h x) (a : x ∈ A) →
  D-y f g h x z ≡ f (x , a)
D-α f g h x (u , w) = Sigma.snd (λ y . (a : x ∈ A) → y ≡ f (x , a)) u

D-β ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (z : D f g h x) (b : x ∈ B) →
  D-y f g h x z ≡ g (x , b)
D-β f g h x (u , w) =
  let k : (u : D-base f x) (w : D-fib f g h x u) (b : x ∈ B) → D-y f g h x (u , w) ≡ g (x , b) =
    fun (y , α) (β , γ) → β in
  k u w

D-γ ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (z : D f g h x) (a : x ∈ A) (b : x ∈ B) →
  D-β f g h x z b ≡ trans (D-α f g h x z a) (h (x , (a , b)))
D-γ f g h x (u , w) =
  let k : (u : D-base f x) (w : D-fib f g h x u) (a : x ∈ A) (b : x ∈ B) →
      D-β f g h x (u , w) b ≡ trans (D-α f g h x (u , w) a) (h (x , (a , b))) =
    fun (y , α) (β , γ) → γ in
  k u w

-- A path in the descent family moves the B-path along the value
D-β-path ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (z z' : D f g h x) (ζ : z ≡ z') (b : x ∈ B) →
  trans (cong (D-y f g h x) ζ) (D-β f g h x z' b) ≡ D-β f g h x z b
D-β-path f g h x z z' ζ b =
  J z (λ z' ζ . trans (cong (D-y f g h x) ζ) (D-β f g h x z' b) ≡ D-β f g h x z b)
    (trans-refl-l (D-β f g h x z b)) ζ

--
-- Paths between cocones
--

cocone-path-J ∷ {X : U} {A B : subtype X} {Y : U}
  (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y) (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c))
  (f' : ⟨ A ⟩ → Y) (Pf : f ≡ f') (g' : ⟨ B ⟩ → Y) (Pg : g ≡ g')
  (h' : (c : ⟨ intersection A B ⟩) → f' (fst c) ≡ g' (snd c)) →
  ((c : ⟨ intersection A B ⟩) → trans (h c) (happly Pg (snd c)) ≡ trans (happly Pf (fst c)) (h' c)) →
  (f , g , h) ≡{cocone A B Y} (f' , g' , h')
cocone-path-J f g h f' Pf =
  J f
    (λ f' Pf . (g' : ⟨ B ⟩ → Y) (Pg : g ≡ g') (h' : (c : ⟨ intersection A B ⟩) → f' (fst c) ≡ g' (snd c)) →
      ((c : ⟨ intersection A B ⟩) → trans (h c) (happly Pg (snd c)) ≡ trans (happly Pf (fst c)) (h' c)) →
      (f , g , h) ≡{cocone A B Y} (f' , g' , h'))
    (λ g' Pg . J g
      (λ g' Pg . (h' : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g' (snd c)) →
        ((c : ⟨ intersection A B ⟩) → trans (h c) (happly Pg (snd c)) ≡ trans (happly {⟨ A ⟩} {λ _ . Y} {f} refl (fst c)) (h' c)) →
        (f , g , h) ≡{cocone A B Y} (f , g' , h'))
      (λ h' θ .
        cong {(c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)} {cocone A B Y} (λ k . (f , g , k))
          (funext {⟨ intersection A B ⟩} (λ c . f (fst c) ≡ g (snd c)) h h' (λ c . trans (θ c) (trans-refl-l (h' c)))))
      Pg)
    Pf

-- A path of cocones from homotopies of the two maps and a coherence on the intersection
cocone-path ∷ {X : U} {A B : subtype X} {Y : U}
  (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y) (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c))
  (f' : ⟨ A ⟩ → Y) (g' : ⟨ B ⟩ → Y) (h' : (c : ⟨ intersection A B ⟩) → f' (fst c) ≡ g' (snd c))
  (α : (p : ⟨ A ⟩) → f p ≡ f' p) (β : (q : ⟨ B ⟩) → g q ≡ g' q) →
  ((c : ⟨ intersection A B ⟩) → trans (h c) (β (snd c)) ≡ trans (α (fst c)) (h' c)) →
  (f , g , h) ≡{cocone A B Y} (f' , g' , h')
cocone-path f g h f' g' h' α β θ =
  let Pf : f ≡ f' = funext-htpy f f' α in
  let Pg : g ≡ g' = funext-htpy g g' β in
  let eα : (p : ⟨ A ⟩) → happly Pf p ≡ α p = λ p . happly (happly-funext-htpy f f' α) p in
  let eβ : (q : ⟨ B ⟩) → happly Pg q ≡ β q = λ q . happly (happly-funext-htpy g g' β) q in
  cocone-path-J f g h f' Pf g' Pg h'
    (λ c .
      trans (cong {g (snd c) ≡ g' (snd c)} (λ e . trans (h c) e) (eβ (snd c)))
        (trans (θ c)
          (sym (cong {f (fst c) ≡ f' (fst c)} (λ e . trans e (h' c)) (eα (fst c))))))

--
-- First round trip: the restriction of the extension of a cocone is the cocone
--

sec-α ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (a : x ∈ A) →
  ext (f , g , h) (inl (x , a)) ≡ f (x , a)
sec-α f g h x a = D-α f g h x (Z f g h x (or-l a)) a

sec-β ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (b : x ∈ B) →
  ext (f , g , h) (inr (x , b)) ≡ g (x , b)
sec-β f g h x b = D-β f g h x (Z f g h x (or-r b)) b

-- The extension sends the glue to h: the centres at (x , or-l a) and (x , or-r b) are related by a
-- path in the descent family, which moves the B-path along the value; conclude by the coherence
-- of the first centre
sec-θ ∷ {X : U} {A B : subtype X} {Y : U} (f : ⟨ A ⟩ → Y) (g : ⟨ B ⟩ → Y)
  (h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) (x : X) (a : x ∈ A) (b : x ∈ B) →
  trans (cong (ext (f , g , h)) (glue {X} {A} {B} (x , (a , b)))) (sec-β f g h x b) ≡ trans (sec-α f g h x a) (h (x , (a , b)))
sec-θ f g h x a b =
  let e : ⟨ union A B ⟩ → Y = ext (f , g , h) in
  let ι : x ∈ union A B → ⟨ union A B ⟩ = pt in
  let ζ : x ∈ union A B → D f g h x = Z f g h x in
  let τ : or-l a ≡{x ∈ union A B} or-r b = prop-path (is-prop-trunc _) (or-l a) (or-r b) in
  trans
    (cong {e (ι (or-l a)) ≡ e (ι (or-r b))} (λ q . trans q (sec-β f g h x b))
      (trans (sym (cong-comp e ι τ))
             (cong-comp (D-y f g h x) ζ τ)))
    (trans (D-β-path f g h x (ζ (or-l a)) (ζ (or-r b)) (cong ζ τ) b)
           (D-γ f g h x (ζ (or-l a)) a b))

sec ∷ {X : U} {A B : subtype X} {Y : U} (c : cocone A B Y) → restr (ext c) ≡ c
sec (f , r) =
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) → restr (ext (f , r)) ≡ (f , r) =
    fun (g , h) →
      cocone-path (ext (f , g , h) ∘ inl) (ext (f , g , h) ∘ inr) (λ c . cong (ext (f , g , h)) (glue c))
        f g h
        (λ (x , a) . sec-α f g h x a)
        (λ (x , b) . sec-β f g h x b)
        (λ (x , ab) .
          let l : (ab : x ∈ intersection A B) →
              trans (cong (ext (f , g , h)) (glue (x , ab))) (sec-β f g h x (Product.snd ab))
                ≡ trans (sec-α f g h x (Product.fst ab)) (h (x , ab)) =
            fun (a , b) → sec-θ f g h x a b in
          l ab)
  in
  k r

--
-- Second round trip: the extension of the restriction of a map is the map
--

-- k gives a point of the descent family of its restriction: all paths live in one fibre of the
-- union, which is a proposition, so the coherence holds
ret-z ∷ {X : U} {A B : subtype X} {Y : U} (k : ⟨ union A B ⟩ → Y) (x : X) (w : x ∈ union A B) →
  D (k ∘ inl) (k ∘ inr) (λ c . cong k (glue c)) x
ret-z k x w =
  let ι : x ∈ union A B → ⟨ union A B ⟩ = pt in
  let τ : (w w' : x ∈ union A B) → w ≡ w' = λ w w' . prop-path (is-prop-trunc _) w w' in
  ((k (x , w) , λ a . cong k (cong ι (τ w (or-l a)))) ,
   ((λ b . cong k (cong ι (τ w (or-r b)))) ,
    λ a b .
      trans (cong {w ≡ or-r b} (λ t . cong k (cong ι t))
              (prop-path (is-prop→is-set (is-prop-trunc _) w (or-r b))
                (τ w (or-r b)) (trans (τ w (or-l a)) (τ (or-l a) (or-r b)))))
        (trans (cong {ι w ≡ ι (or-r b)} (λ e . cong k e)
                 (cong-trans ι (τ w (or-l a)) (τ (or-l a) (or-r b))))
          (cong-trans k (cong ι (τ w (or-l a))) (cong ι (τ (or-l a) (or-r b)))))))

ret-pw ∷ {X : U} {A B : subtype X} {Y : U} (k : ⟨ union A B ⟩ → Y) (z : ⟨ union A B ⟩) → ext (restr k) z ≡ k z
ret-pw k (x , w) =
  let f : ⟨ A ⟩ → Y = k ∘ inl in
  let g : ⟨ B ⟩ → Y = k ∘ inr in
  let h : (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c) = λ c . cong k (glue c) in
  cong (D-y f g h x) (is-contr-eq (D-contr f g h x w) (Z f g h x w) (ret-z k x w))

ret ∷ {X : U} {A B : subtype X} {Y : U} (k : ⟨ union A B ⟩ → Y) → ext (restr k) ≡ k
ret k = funext-nd (ext (restr k)) k (ret-pw k)

--
-- The universal property of the union
--

union-up ∷ {X : U} (A B : subtype X) (Y : U) → is-equiv (restr {X} {A} {B} {Y})
union-up A B Y = ((ext , sec) , (ext , ret))

--
-- The universal property of union over a point
--
-- If the intersection is contractible, with centre i0, then a cocone is determined by its two maps
-- and the single path f (fst i0) ≡ g (snd i0) at the centre: the union is a pushout over a point.
--

-- Cocones over a point of the intersection
pt-cocone ∷ {X : U} (A B : subtype X) (Y : U) → ⟨ intersection A B ⟩ → U
pt-cocone A B Y i = Σ (f : ⟨ A ⟩ → Y) . Σ (g : ⟨ B ⟩ → Y) . f (fst i) ≡ g (snd i)

-- Evaluation of the glue at a point
ev-pt ∷ {X : U} {A B : subtype X} {Y : U} (i : ⟨ intersection A B ⟩) → cocone A B Y → pt-cocone A B Y i
ev-pt i (f , r) =
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . (c : ⟨ intersection A B ⟩) → f (fst c) ≡ g (snd c)) → pt-cocone A B Y i =
    fun (g , h) → (f , g , h i) in
  k r

-- The inverse: spread the glue at the centre along the contraction
pt-inv ∷ {X : U} {A B : subtype X} {Y : U} (c : is-contr ⟨ intersection A B ⟩) →
  pt-cocone A B Y (center _ c) → cocone A B Y
pt-inv c (f , r) =
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . f (fst (center _ c)) ≡ g (snd (center _ c))) → cocone A B Y =
    fun (g , e) → (f , g , λ t . subst {⟨ intersection A B ⟩} (λ t . f (fst t) ≡ g (snd t)) (is-contr-eq c (center _ c) t) e) in
  k r

pt-sec ∷ {X : U} {A B : subtype X} {Y : U} (c : is-contr ⟨ intersection A B ⟩)
  (d : pt-cocone A B Y (center _ c)) → ev-pt (center _ c) (pt-inv c d) ≡ d
pt-sec c (f , r) =
  let i0 : ⟨ intersection A B ⟩ = center _ c in
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . f (fst i0) ≡ g (snd i0)) → ev-pt i0 (pt-inv c (f , r)) ≡ (f , r) =
    fun (g , e) →
      cong {f (fst i0) ≡ g (snd i0)} {pt-cocone A B Y i0} (λ z . (f , g , z))
        (cong {i0 ≡ i0} (λ π . subst {⟨ intersection A B ⟩} (λ t . f (fst t) ≡ g (snd t)) π e) (is-contr-eq-refl c i0)) in
  k r

pt-ret ∷ {X : U} {A B : subtype X} {Y : U} (c : is-contr ⟨ intersection A B ⟩)
  (d : cocone A B Y) → pt-inv c (ev-pt (center _ c) d) ≡ d
pt-ret c (f , r) =
  let i0 : ⟨ intersection A B ⟩ = center _ c in
  let k : (r : Σ (g : ⟨ B ⟩ → Y) . (t : ⟨ intersection A B ⟩) → f (fst t) ≡ g (snd t)) → pt-inv c (ev-pt i0 (f , r)) ≡ (f , r) =
    fun (g , h) →
      let P : ⟨ intersection A B ⟩ → U = λ t . f (fst t) ≡ g (snd t) in
      cong {(t : ⟨ intersection A B ⟩) → P t} {cocone A B Y} (λ z . (f , g , z))
        (funext P (λ t . subst P (is-contr-eq c i0 t) (h i0)) h (λ t . subst-section P h (is-contr-eq c i0 t))) in
  k r

-- With a contractible intersection, cocones on the union are cocones over the centre
is-equiv-ev-pt ∷ {X : U} {A B : subtype X} {Y : U} (c : is-contr ⟨ intersection A B ⟩) →
  is-equiv (ev-pt {X} {A} {B} {Y} (center _ c))
is-equiv-ev-pt c = ((pt-inv c , pt-sec c) , (pt-inv c , pt-ret c))

-- The universal property of a union with a contractible intersection, as a pushout over a point
pt-up ∷ {X : U} (A B : subtype X) (Y : U) (c : is-contr ⟨ intersection A B ⟩) → is-equiv (ev-pt (center _ c) ∘ restr)
pt-up A B Y c = is-equiv-circ (ev-pt (center _ c)) restr (is-equiv-ev-pt c) (union-up A B Y)
