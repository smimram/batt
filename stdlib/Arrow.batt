---
--- left/right arrows
---

open import Equality

pi-to-arr-right ∷ (A B ∷ U) → (A → B) → (A →ᵣ B)
pi-to-arr-right A B f a = f a

pi-to-arr-left ∷ (A B ∷ U) → (A → B) → (A →ₗ B)
pi-to-arr-left A B f a = f a

arr-comp-right ∷ (A B C ∷ U) → (B →ᵣ C) →ᵣ (A →ᵣ B) →ᵣ (A →ᵣ C)
arr-comp-right A B C g f a = g (f a)

arr-comp-left ∷ (A B C ∷ U) → (B →ₗ C) →ₗ (A →ₗ B) →ₗ (A →ₗ C)
arr-comp-left A B C g f a = g (f a)

---
--- Lax evaluation of the images of cartesian paths
---

-- evaluating the funext-built glue gives back the pointwise glue
ev-l-at-κ ∷ {G X ∷ U} {k k' ∷ G → X} (p ∷ k ≡ k') (w : G) →
  ev-l-at {G} {X} {pi-to-arr-left G X k} {pi-to-arr-left G X k'} (cong {G → X} {G →ₗ X} (pi-to-arr-left G X) p) w ≡ happly {G} {λ _ . X} {k} {k'} p w
ev-l-at-κ {G} {X} {k} refl w = refl

cong-ev-r-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  cong {S} {(S →ᵣ X) →ₗ X} (λ x . λ φ . φ x) c ≡ cong {(S →ᵣ X) → X} {(S →ᵣ X) →ₗ X} (pi-to-arr-left (S →ᵣ X) X) (ev-r-path {S} {X} c)
cong-ev-r-path {S} {X} {y0} refl = refl

-- the lax mirrors
ev-r-at-κ ∷ {G X ∷ U} {k k' ∷ G → X} (p ∷ k ≡ k') (w : G) →
  ev-r-at {G} {X} {pi-to-arr-right G X k} {pi-to-arr-right G X k'} (cong {G → X} {G →ᵣ X} (pi-to-arr-right G X) p) w ≡ happly {G} {λ _ . X} {k} {k'} p w
ev-r-at-κ {G} {X} {k} refl w = refl

cong-ev-l-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  cong {S} {(S →ₗ X) →ᵣ X} (λ x . λ φ . φ x) c ≡ cong {(S →ₗ X) → X} {(S →ₗ X) →ᵣ X} (pi-to-arr-right (S →ₗ X) X) (ev-l-path {S} {X} c)
cong-ev-l-path {S} {X} {y0} refl = refl
