--
-- Arrows
--
-- The arrows of a type A are the maps 𝕀 → A (cartesian), 𝕀 →ₗ A (lax) and 𝕀 →ᵣ A (oplax),
-- with their sources and targets, and the squares (maps from 𝕀 × 𝕀 or 𝕀 ⨂ 𝕀) as arrows of arrows.
--

arr ∷ U → U
arr A = 𝕀 → A

arrₗ ∷ (A ∷ U) → U
arrₗ A = 𝕀 →ₗ A

arrᵣ ∷ (A ∷ U) → U
arrᵣ A = 𝕀 →ᵣ A

src ∷ {A : U} → arr A → A
src f = f 𝕀0

tgt ∷ {A : U} → arr A → A
tgt f = f 𝕀1

srcₗ ∷ {A ∷ U} → arrₗ A → A
srcₗ f = f 𝕀0

tgtₗ ∷ {A ∷ U} → arrₗ A → A
tgtₗ f = f 𝕀1

srcᵣ ∷ {A ∷ U} → arrᵣ A → A
srcᵣ f = f 𝕀0

tgtᵣ ∷ {A ∷ U} → arrᵣ A → A
tgtᵣ f = f 𝕀1

---
--- Conversion
---

-- a cartesian map can be seen as a lax (resp. oplax) one
arr→arrₗ ∷ {A B ∷ U} → (A → B) → (A →ₗ B)
arr→arrₗ f a = f a

arr→arrᵣ ∷ {A B ∷ U} → (A → B) → (A →ᵣ B)
arr→arrᵣ f a = f a

---
--- Squares
---

-- The squares of a type A are the maps from the cartesian square 𝕀 × 𝕀 (cartesian), or from the
-- Gray square 𝕀 ⨂ 𝕀 (lax and oplax)

square ∷ (A ∷ U) → U
square A = 𝕀 × 𝕀 → A

squareₗ ∷ (A ∷ U) → U
squareₗ A = 𝕀 ⨂ 𝕀 →ₗ A

squareᵣ ∷ (A ∷ U) → U
squareᵣ A = 𝕀 ⨂ 𝕀 →ᵣ A

Square = record
  t  = square
  tₗ = squareₗ
  tᵣ = squareᵣ

  -- Currying: a square is an arrow of arrows. In the lax case, the argument of an inner lax
  -- arrow goes to the left of the tensor (and to the right in the oplax case), so that the
  -- coordinates are swapped.

  -- cartesian squares, a square s corresponds to the arrow i ↦ (j ↦ s (i , j))
  of-arr : {A ∷ U} → arr (arr A) → square A
  of-arr f (i , j) = f i j

  to-arr : {A ∷ U} → square A → arr (arr A)
  to-arr s i j = s (i , j)

  -- lax squares, a square s corresponds to the arrow i ↦ (j ↦ s (j ⊗ i))
  of-arrₗ : {A ∷ U} → arrₗ (arrₗ A) → squareₗ A
  of-arrₗ f (i ⊗ j) = f j i

  to-arrₗ : {A ∷ U} → squareₗ A → arrₗ (arrₗ A)
  to-arrₗ s i j = s (j ⊗ i)

  -- oplax squares, a square s corresponds to the arrow i ↦ (j ↦ s (i ⊗ j))
  of-arrᵣ : {A ∷ U} → arrᵣ (arrᵣ A) → squareᵣ A
  of-arrᵣ f (i ⊗ j) = f i j

  to-arrᵣ : {A ∷ U} → squareᵣ A → arrᵣ (arrᵣ A)
  to-arrᵣ s i j = s (i ⊗ j)

  -- sides of oplax squares, the horizontal direction being the first variable and the vertical
  -- one the second (going up)
  leftᵣ : {A ∷ U} → squareᵣ A → arrᵣ A
  leftᵣ s i = s (𝕀0 ⊗ i)

  rightᵣ : {A ∷ U} → squareᵣ A → arrᵣ A
  rightᵣ s i = s (𝕀1 ⊗ i)

  bottomᵣ : {A ∷ U} → squareᵣ A → arrᵣ A
  bottomᵣ s i = s (i ⊗ 𝕀0)

  topᵣ : {A ∷ U} → squareᵣ A → arrᵣ A
  topᵣ s i = s (i ⊗ 𝕀1)

  -- corners of oplax squares
  bottom-leftᵣ : {A ∷ U} → squareᵣ A → A
  bottom-leftᵣ s = s (𝕀0 ⊗ 𝕀0)

  bottom-rightᵣ : {A ∷ U} → squareᵣ A → A
  bottom-rightᵣ s = s (𝕀1 ⊗ 𝕀0)

  top-leftᵣ : {A ∷ U} → squareᵣ A → A
  top-leftᵣ s = s (𝕀0 ⊗ 𝕀1)

  top-rightᵣ : {A ∷ U} → squareᵣ A → A
  top-rightᵣ s = s (𝕀1 ⊗ 𝕀1)
end
