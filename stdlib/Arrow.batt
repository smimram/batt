---
--- left/right arrows
---

open import Equality

---
--- Lax evaluation of the images of cartesian paths
---

-- evaluating the funext-built glue gives back the pointwise glue
ev-l-at-κ ∷ {G X ∷ U} {k k' ∷ G → X} (p ∷ k ≡ k') (w : G) →
  ev-l-at {G} {X} {arr→l {G} {X} k} {arr→l {G} {X} k'} (cong {G → X} {G →ₗ X} (arr→l {G} {X}) p) w ≡ happly {G} {λ _ . X} {k} {k'} p w
ev-l-at-κ {G} {X} {k} refl w = refl

cong-ev-r-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  cong {S} {(S →ᵣ X) →ₗ X} (λ x . λ φ . φ x) c ≡ cong {(S →ᵣ X) → X} {(S →ᵣ X) →ₗ X} (arr→l {S →ᵣ X} {X}) (ev-r-path {S} {X} c)
cong-ev-r-path {S} {X} {y0} refl = refl

-- the lax mirrors
ev-r-at-κ ∷ {G X ∷ U} {k k' ∷ G → X} (p ∷ k ≡ k') (w : G) →
  ev-r-at {G} {X} {arr→r {G} {X} k} {arr→r {G} {X} k'} (cong {G → X} {G →ᵣ X} (arr→r {G} {X}) p) w ≡ happly {G} {λ _ . X} {k} {k'} p w
ev-r-at-κ {G} {X} {k} refl w = refl

cong-ev-l-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  cong {S} {(S →ₗ X) →ᵣ X} (λ x . λ φ . φ x) c ≡ cong {(S →ₗ X) → X} {(S →ₗ X) →ᵣ X} (arr→r {S →ₗ X} {X}) (ev-l-path {S} {X} c)
cong-ev-l-path {S} {X} {y0} refl = refl
