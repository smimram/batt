ind ∷ (C : Bool → U) → C false → C true → (b : Bool) → C b
ind C f t false = f
ind C f t true  = t

rec ∷ {C : U} → C → C → Bool → C
rec f t false = f
rec f t true  = t

REC ∷ {C : TYPE} → C → C → Bool → C
REC f t false = f
REC f t true  = t

not ∷ Bool → Bool
not false = true
not true  = false

and ∷ Bool → Bool → Bool
and false _ = false
and true  b = b

or ∷ Bool → Bool → Bool
or false b = b
or true  b = b
