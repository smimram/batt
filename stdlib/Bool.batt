ind ∷ (C : Bool → U) → C false → C true → (b : Bool) → C b
ind C cf ct false = cf
ind C cf ct true  = ct

rec ∷ (C : U) → C → C → Bool → C
rec C cf ct false = cf
rec C cf ct true  = ct

REC ∷ (C : TYPE) → C → C → Bool → C
REC C cf ct false = cf
REC C cf ct true = ct

not ∷ Bool → Bool
not false = true
not true  = false

and ∷ Bool → Bool → Bool
and false _ = false
and true  b = b

or ∷ Bool → Bool → Bool
or false b = b
or true  b = b
