ind ∷ (A : Bool → U) → A false → A true → (b : Bool) → A b
ind A f t false = f
ind A f t true  = t

rec ∷ {A : U} → A → A → Bool → A
rec = ind (λ _ . A)

REA ∷ {A : TYPE} → A → A → Bool → A
REA f t false = f
REA f t true  = t

not ∷ Bool → Bool
not false = true
not true  = false

and ∷ Bool → Bool → Bool
and false _ = false
and true  b = b

or ∷ Bool → Bool → Bool
or false b = b
or true  b = b
