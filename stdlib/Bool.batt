--
-- Booleans
--
-- Eliminators (ind, rec into U, REC into TYPE) and the usual operations.
--

ind ∷ (A : Bool → U) → A false → A true → (b : Bool) → A b
ind A f t false = f
ind A f t true  = t

rec ∷ {A : U} → A → A → Bool → A
rec = ind (λ _ . A)

REC ∷ {A : TYPE} → A → A → Bool → A
REC f t false = f
REC f t true  = t

not ∷ Bool → Bool
not false = true
not true  = false

and ∷ Bool → Bool → Bool
and false _ = false
and true  b = b

or ∷ Bool → Bool → Bool
or false b = b
or true  b = b
