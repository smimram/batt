--
-- Cubes, simplices and spines
--
-- Gray (⊗) and cartesian (×) cubes 𝕀ⁿ, the ℕ-indexed simplices Δⁿ (sorted points of the
-- cartesian cube) and spines Spₙ with their inclusion into Δⁿ, grids □[a₀, …, a_{d-1}], and the
-- edges and faces of low-dimensional simplices.
--

open import Interval
open import Unit
open import Sigma
open import Equivalence
open import PropTrunc
open import Subtype

-- The directed square
gray-square ∷ Type
gray-square = 𝕀 ⨂ 𝕀

-- The non-directed square
cart-square ∷ Type
cart-square = 𝕀 × 𝕀

-- Canonical inclusion
gray-square→cart-square ∷ gray-square → cart-square
gray-square→cart-square (x ⊗ y) = (x , y)

-- The 2-simplex as within the square
simplex2-sub ∷ subtype cart-square
simplex2-sub (i , j) = hprop (is-prop-geq i j)

-- The 2-simplex (a filled triangle)
simplex2 ∷ Type
simplex2 = ⟨ simplex2-sub ⟩

spine2-sub ∷ subtype cart-square
spine2-sub (i , j) = (j ≡ 𝕀0 , ?) ∨ (i ≡ 𝕀1 , ?)

-- The 2-spine (two consecutive edges)
spine2 ∷ Type
spine2 = ⟨ spine2-sub ⟩

-- -- Canonical inclusion from the 2-spine to the 2-simplex
-- spine2→simplex2 ∷ spine2 → simplex2
-- spine2→simplex2 (i , y) =
  -- let j : 𝕀 = fst _ y in
  -- let p : (j ≡ 𝕀0) ∨ (i ≡ 𝕀1) = snd _ y in
  -- -- geq i j is an identity type in the set 𝕀, hence a proposition: the truncation can be eliminated
  -- (i , j , PropTrunc.rec' {sum (j ≡ 𝕀0) (i ≡ 𝕀1)} {i ≥ j} (is-set-𝕀 (i 𝕀∨ j) i)
    -- (Sum.rec {j ≡ 𝕀0} {i ≡ 𝕀1} {i ≥ j}
      -- (λ q . cong (λ k . i 𝕀∨ k) q)                      -- j ≡ 𝕀0 : i 𝕀∨ j ≡ i 𝕀∨ 𝕀0 = i
      -- (λ q . trans (cong (λ k . k 𝕀∨ j) q) (sym q)))     -- i ≡ 𝕀1 : i 𝕀∨ j ≡ 𝕀1 𝕀∨ j = 𝕀1 ≡ i
    -- p)

-- Directed cubes
gray-cube ∷ (n ∷ ℕ) → Type
gray-cube zero = ⊤
gray-cube (succ n) = 𝕀 ⨂ rec

-- Non-directed cubes
cart-cube ∷ (n ∷ ℕ) → Type
cart-cube zero = ⊤
cart-cube (succ n) = 𝕀 × rec

-- Canonical inclusion
gray-cube→cart-cube ∷ (n ∷ ℕ) → gray-cube n → cart-cube n
gray-cube→cart-cube zero x = tt
gray-cube→cart-cube (succ n) (x ⊗ y) = (x , rec y)

-- The origin (0, …, 0) of the n-cube
origin ∷ (n ∷ ℕ) → cart-cube n
origin zero = tt
origin (succ n) = (𝕀0, rec)

-- A point x = (x₁, …, x_{n+1}) of the (n+1)-cube is sorted when x₁ ≥ x₂ ≥ … ≥ x_{n+1}
is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → Type
is-sorted zero x = ⊤
is-sorted (succ n) x = 
  let x1 : 𝕀 = Product.fst x in
  let x2 : 𝕀 = Product.fst (Product.snd x) in
  (x1 ≥ x2) × (rec (Product.snd x))

-- An n-simplex (a sorted n-cube)
simplex ∷ (n ∷ ℕ) → Type
simplex zero = ⊤
simplex (succ n) = Σ (x : cart-cube (succ n)) . is-sorted n x

-- Grids: □[a₀, …, a_{d-1}] := Δ^{a₀} ⊗ … ⊗ Δ^{a_{d-1}}
-- A grid is given by the list of its dimensions, the head being the last factor. It is nested
-- to the left, with a leading unit: grid [a₂, a₁, a₀] = ((⊤ ⊗ Δ^{a₀}) ⊗ Δ^{a₁}) ⊗ Δ^{a₂}, and
-- grid nil = ⊤ is the unit of ⊗. Extending a grid by one factor is thus cons, judgmentally:
-- grid (cons m b) = grid b ⊗ Δᵐ.
grid ∷ (a ∷ list ℕ) → Type
grid nil = ⊤
grid (cons m a) = rec ⨂ simplex m

-- The n-cube is a set
is-set-cart-cube ∷ (n ∷ ℕ) → is-set (cart-cube n)
is-set-cart-cube zero     = is-set-unit
is-set-cart-cube (succ n) = is-set-prod {𝕀} {cart-cube n} is-set-𝕀 rec

-- Whether a point of the cartesian cube is in the n-spine: either x = (x₁, 0, …, 0), or x₁ = 1
-- and the tail is in the spine
spine-sub ∷ (n ∷ ℕ) → subtype (cart-cube n)
spine-sub zero     _         = hprop is-prop-unit
spine-sub (succ n) (x1 , xs) = (xs ≡ origin n , is-set-cart-cube n xs (origin n)) ∨ (hprop (is-set-𝕀 x1 𝕀1) ∧ rec xs)

-- -- Whether a point of the cartesian cube is in the n-spine
-- is-in-spine ∷ (n ∷ ℕ) → (x : cart-cube n) → Type
-- is-in-spine zero _ = ⊤
-- is-in-spine (succ n) x =
  -- let x1 : 𝕀 = Product.fst x in
  -- let xs : cart-cube n = Product.snd x in
  -- (xs ≡ origin n) ∨ ((x1 ≡ 𝕀1) × (rec xs))

-- -- The n-spine
-- spine ∷ (n ∷ ℕ) → Type
-- spine n = Σ (x : cart-cube n) . is-in-spine n x

-- -- being sorted is a proposition
-- is-prop-is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → is-prop (is-sorted n x)
-- is-prop-is-sorted zero x = is-prop-unit
-- is-prop-is-sorted (succ n) x =
  -- let x1 : 𝕀 = Product.fst x in
  -- let xs : cart-cube (succ n) = Product.snd x in
  -- is-prop-prod {x1 ≥ Product.fst xs} {is-sorted n xs} (is-prop-geq x1 (Product.fst xs)) (rec xs)

-- -- the origin (0, …, 0) is sorted
-- is-sorted-origin ∷ (n ∷ ℕ) → is-sorted n (origin (succ n))
-- is-sorted-origin zero = tt
-- is-sorted-origin (succ n) = (refl , rec)

-- -- a point of the spine is sorted: either x = (x₁, 0, …, 0), or x₁ = 1 and the tail is in the
-- -- spine (hence sorted by induction)
-- is-in-spine→is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → is-in-spine (succ n) x → is-sorted n x
-- is-in-spine→is-sorted zero x p = tt
-- is-in-spine→is-sorted (succ n) x p =
  -- let x1 : 𝕀 = Product.fst x in
  -- let xs : cart-cube (succ n) = Product.snd x in
  -- let T : U = (x1 ≥ Product.fst xs) × is-sorted n xs in
  -- PropTrunc.rec' {sum (xs ≡ origin (succ n)) ((x1 ≡ 𝕀1) × is-in-spine (succ n) xs)} {T}
    -- (is-prop-prod {x1 ≥ Product.fst xs} {is-sorted n xs} (is-prop-geq x1 (Product.fst xs)) (is-prop-is-sorted n xs))
    -- (Sum.rec {xs ≡ origin (succ n)} {(x1 ≡ 𝕀1) × is-in-spine (succ n) xs} {T}
      -- -- xs ≡ (0, …, 0) : x₁ ∨ 0 = x₁ judgmentally, and the origin is sorted
      -- (λ q . subst {cart-cube (succ n)} (λ y . (x1 ≥ Product.fst y) × is-sorted n y) (sym q) (refl , is-sorted-origin n))
      -- -- x₁ ≡ 1 : x₁ ∨ x₂ = 1 ∨ x₂ = 1 = x₁
      -- (λ w .
        -- let q : x1 ≡ 𝕀1 = Product.fst w in
        -- (trans (cong (λ k . k 𝕀∨ Product.fst xs) q) (sym q) , rec xs (Product.snd w))))
    -- p

-- -- the inclusion ιₙ of the spine into the simplex
-- spine→simplex ∷ (n ∷ ℕ) → spine n → simplex n
-- spine→simplex zero x = tt
-- spine→simplex (succ n) (x , p) = (x , is-in-spine→is-sorted n x p)

-- -- the inclusion of the simplex into the cube
-- simplex→cube ∷ (n ∷ ℕ) → simplex n → cart-cube n
-- simplex→cube zero x = tt
-- simplex→cube (succ n) (x , p) = x

-- -- two points of a simplex with the same coordinates are equal (sortedness is a proposition)
-- sorted-path ∷ (n ∷ ℕ) (x ∷ cart-cube (succ n)) (p q ∷ is-sorted n x) → (x , p) ≡{simplex (succ n)} (x , q)
-- sorted-path n x p q =
  -- let e ∷ p ≡ q = center (p ≡ q) (is-prop-is-sorted n x p q) in
  -- cong {is-sorted n x} {simplex (succ n)} (λ z . (x , z)) e

-- --
-- -- The spine as a set, and its vertex seen from both edges
-- --

-- -- Being in a spine is a proposition
-- is-prop-is-in-spine ∷ (n ∷ ℕ) (x : cart-cube n) → is-prop (is-in-spine n x)
-- is-prop-is-in-spine zero x = is-prop-unit
-- is-prop-is-in-spine (succ n) x = is-prop-trunc _

-- -- The n-spine is a set
-- is-set-spine ∷ (n ∷ ℕ) → is-set (spine n)
-- is-set-spine n = is-set-Σ-prop (is-in-spine n) (is-set-cart-cube n) (is-prop-is-in-spine n)

-- spine1-pt ∷ (t : 𝕀) → is-in-spine 1 (t , tt)
-- spine1-pt t = PropTrunc.unit (inl {tt ≡ origin 0} {(t ≡ 𝕀1) × is-in-spine 0 tt} refl)

-- -- simplices are sets
-- is-set-simplex ∷ (n ∷ ℕ) → is-set (simplex (succ n))
-- is-set-simplex n = is-set-Σ-prop (is-sorted n) (is-set-cart-cube (succ n)) (is-prop-is-sorted n)

-- -- a path of coordinates gives a path of points of a simplex, whatever the sortedness proofs
-- -- simplex-path ∷ (n ∷ ℕ) {x x' : cart-cube (succ n)} (e : x ≡ x') (p : is-sorted n x) (p' : is-sorted n x') → (x , p) ≡{simplex (succ n)} (x' , p')
-- simplex-path n {x} {x'} e =
  -- J' (λ x x' e . (p : is-sorted n x) (p' : is-sorted n x') → (x , p) ≡{simplex (succ n)} (x' , p'))
    -- (λ x p p' . cong {is-sorted n x} {simplex (succ n)} (λ z . (x , z)) (prop-path (is-prop-is-sorted n x) p p')) e

