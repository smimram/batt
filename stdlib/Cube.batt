-- Simplex2 = record
  -- --
  -- -- The 2-simplex (coordinates x₁ ≥ x₂; vertices (0,0), (1,0), (1,1))
  -- --

  -- t = simplex 2

  -- to-cube2 = simplex→cube 2

  -- -- the first and second edges of the 2-simplex, t ↦ (t, 0) and t ↦ (1, t)
  -- edge₀₁ ∷ 𝕀 → t
  -- edge₀₁ t = ((t , 𝕀0 , tt) , (refl , tt))

  -- edge₁₂ ∷ 𝕀 → t
  -- edge₁₂ t = ((𝕀1 , t , tt) , (refl , tt))

  -- -- long edge of the 2-simplex, t ↦ (t, t)
  -- edge₀₂ ∷ 𝕀 → t
  -- edge₀₂ t = ((t , t , tt) , (refl , tt))

  -- -- the two coordinates of a point of the 2-simplex
  -- fst ∷ t → 𝕀
  -- fst z = Product.fst {𝕀} {cart-cube 1} (Sigma.fst (is-sorted 1) z)

  -- snd ∷ t → 𝕀
  -- snd z = Product.fst {𝕀} {⊤} (Product.snd {𝕀} {cart-cube 1} (Sigma.fst (is-sorted 1) z))

  -- -- the inequality of a point of the 2-simplex
  -- geq ∷ (y : t) → fst y ≥ snd y
  -- geq y = Product.fst (Sigma.snd (is-sorted 1) y)
-- end

-- CCube3 = record
  -- t = cart-cube 3

  -- fst ∷ t → 𝕀
  -- fst = Product.fst

  -- snd ∷ t → 𝕀
  -- snd x = Product.fst (Product.snd x)

  -- thd ∷ t → 𝕀
  -- thd x = Product.fst (Product.snd (Product.snd x))
-- end

-- Simplex3 = record
  -- --
  -- -- Faces and edges of the 3-simplex (coordinates x₁ ≥ x₂ ≥ x₃; vertices 0 = (0,0,0),
  -- -- 1 = (1,0,0), 2 = (1,1,0), 3 = (1,1,1)). All sortedness proofs are refl (the lattice laws are
  -- -- judgmental), so that faces of edges are edges judgmentally.
  -- --

  -- t = simplex 3

  -- -- the edges of the 3-simplex
  -- edge₀₁ ∷ 𝕀 → t
  -- edge₀₁ t = ((t , 𝕀0 , 𝕀0 , tt) , (refl , (refl , tt)))

  -- edge₁₂ ∷ 𝕀 → t
  -- edge₁₂ t = ((𝕀1 , t , 𝕀0 , tt) , (refl , (refl , tt)))

  -- edge₂₃ ∷ 𝕀 → t
  -- edge₂₃ t = ((𝕀1 , 𝕀1 , t , tt) , (refl , (refl , tt)))

  -- edge₀₂ ∷ 𝕀 → t
  -- edge₀₂ t = ((t , t , 𝕀0 , tt) , (refl , (refl , tt)))

  -- edge₁₃ ∷ 𝕀 → t
  -- edge₁₃ t = ((𝕀1 , t , t , tt) , (refl , (refl , tt)))

  -- edge₀₃ ∷ 𝕀 → t
  -- edge₀₃ t = ((t , t , t , tt) , (refl , (refl , tt)))

  -- -- the faces dᵢ : Δ² → Δ³, missing the vertex i
  -- d₀ ∷ Simplex2.t → t
  -- d₀ y = ((𝕀1 , Simplex2.fst y , Simplex2.snd y , tt) , (refl , (Simplex2.geq y , tt)))

  -- d₁ ∷ Simplex2.t → t
  -- d₁ y = ((Simplex2.fst y , Simplex2.fst y , Simplex2.snd y , tt) , (refl , (Simplex2.geq y , tt)))

  -- d₂ ∷ Simplex2.t → t
  -- d₂ y = ((Simplex2.fst y , Simplex2.snd y , Simplex2.snd y , tt) , (Simplex2.geq y , (refl , tt)))

  -- d₃ ∷ Simplex2.t → t
  -- d₃ y = ((Simplex2.fst y , Simplex2.snd y , 𝕀0 , tt) , (Simplex2.geq y , (refl , tt)))
-- end
