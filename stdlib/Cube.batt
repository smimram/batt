open import Interval
open import Unit

two-simplex ∷ Type
two-simplex = Σ (i : 𝕀) . Σ (j : 𝕀) . i ≥ j

two-spine ∷ Type
two-spine = Σ (i : 𝕀) . Σ (j : 𝕀) . (j ≡ 𝕀0) ∨ (i ≡ 𝕀1)

two-spine→two-simplex ∷ two-spine → two-simplex
two-spine→two-simplex (i , y) =
  let j : 𝕀 = fst _ y in
  let p : (j ≡ 𝕀0) ∨ (i ≡ 𝕀1) = snd _ y in
  -- geq i j is an identity type in the set 𝕀, hence a proposition: the truncation can be eliminated
  (i , j , rec-prop-trunc' (sum (j ≡ 𝕀0) (i ≡ 𝕀1)) (i ≥ j) (is-set-𝕀 (i 𝕀∨ j) i)
    (rec-sum {j ≡ 𝕀0} {i ≡ 𝕀1} {i ≥ j}
      (λ q . cong (λ k . i 𝕀∨ k) q)                      -- j ≡ 𝕀0 : i 𝕀∨ j ≡ i 𝕀∨ 𝕀0 = i
      (λ q . trans (cong (λ k . k 𝕀∨ j) q) (sym q)))     -- i ≡ 𝕀1 : i 𝕀∨ j ≡ 𝕀1 𝕀∨ j = 𝕀1 ≡ i
    p)

gray-square ∷ Type
gray-square = 𝕀 ⨂ 𝕀

cart-square ∷ Type
cart-square = 𝕀 × 𝕀

gray-cube ∷ (n ∷ ℕ) → Type
gray-cube zero = unit
gray-cube (succ n) = 𝕀 ⨂ rec

cart-cube ∷ (n ∷ ℕ) → Type
cart-cube zero = unit
cart-cube (succ n) = 𝕀 × rec

fst-cube ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → 𝕀
fst-cube n x = prod-fst x

is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → Type
is-sorted zero x = ⊤
is-sorted (succ n) x = 
  let x1 : 𝕀 = prod-fst x in
  let x2 : 𝕀 = prod-fst (prod-snd x) in
  (geq x1 x2) × (rec (prod-snd x))

simplex ∷ (n ∷ ℕ) → Type
simplex zero = unit
simplex (succ n) = Σ (x : cart-cube (succ n)) . is-sorted n x

-- Grids: □[a₀, …, a_{d-1}] := Δ^{a₀} ⊗ … ⊗ Δ^{a_{d-1}}
-- A grid is given by the list of its dimensions, the head being the last factor. It is nested
-- to the left, with a leading unit: grid [a₂, a₁, a₀] = ((⊤ ⊗ Δ^{a₀}) ⊗ Δ^{a₁}) ⊗ Δ^{a₂}, and
-- grid nil = ⊤ is the unit of ⊗. Extending a grid by one factor is thus cons, judgmentally:
-- grid (cons m b) = grid b ⊗ Δᵐ.
grid ∷ (a ∷ List ℕ) → Type
grid nil = ⊤
grid (cons m a) = rec ⨂ simplex m

zero-cube ∷ (n ∷ ℕ) → cart-cube n
zero-cube zero = tt
zero-cube (succ n) = (𝕀0, rec)

is-in-spine ∷ (n ∷ ℕ) → (x : cart-cube n) → Type
is-in-spine zero _ = ⊤
is-in-spine (succ n) x =
  let x1 : 𝕀 = prod-fst x in
  let xs : cart-cube n = prod-snd x in
  or (xs ≡ zero-cube n) ((x1 ≡ 𝕀1) × (rec xs))

spine ∷ (n ∷ ℕ) → Type
spine n = Σ (x : cart-cube n) . is-in-spine n x

-- being sorted is a proposition
abstract is-prop-is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → is-prop (is-sorted n x)
is-prop-is-sorted zero x = is-prop-unit
is-prop-is-sorted (succ n) x =
  let x1 : 𝕀 = prod-fst x in
  let xs : cart-cube (succ n) = prod-snd x in
  is-prop-prod {x1 ≥ prod-fst xs} {is-sorted n xs} (is-prop-geq x1 (prod-fst xs)) (rec xs)

-- the origin (0, …, 0) is sorted
is-sorted-zero ∷ (n ∷ ℕ) → is-sorted n (zero-cube (succ n))
is-sorted-zero zero = tt
is-sorted-zero (succ n) = (refl , rec)

-- a point of the spine is sorted: either x = (x₁, 0, …, 0), or x₁ = 1 and the tail is in the
-- spine (hence sorted by induction)
is-in-spine→is-sorted ∷ (n ∷ ℕ) → (x : cart-cube (succ n)) → is-in-spine (succ n) x → is-sorted n x
is-in-spine→is-sorted zero x p = tt
is-in-spine→is-sorted (succ n) x p =
  let x1 : 𝕀 = prod-fst x in
  let xs : cart-cube (succ n) = prod-snd x in
  let T : U = (x1 ≥ prod-fst xs) × is-sorted n xs in
  rec-prop-trunc' (sum (xs ≡ zero-cube (succ n)) ((x1 ≡ 𝕀1) × is-in-spine (succ n) xs)) T
    (is-prop-prod {x1 ≥ prod-fst xs} {is-sorted n xs} (is-prop-geq x1 (prod-fst xs)) (is-prop-is-sorted n xs))
    (rec-sum {xs ≡ zero-cube (succ n)} {(x1 ≡ 𝕀1) × is-in-spine (succ n) xs} {T}
      -- xs ≡ (0, …, 0) : x₁ ∨ 0 = x₁ judgmentally, and the origin is sorted
      (λ q . subst {cart-cube (succ n)} (λ y . (x1 ≥ prod-fst y) × is-sorted n y) (sym q) (refl , is-sorted-zero n))
      -- x₁ ≡ 1 : x₁ ∨ x₂ = 1 ∨ x₂ = 1 = x₁
      (λ w .
        let q : x1 ≡ 𝕀1 = prod-fst w in
        (trans (cong (λ k . k 𝕀∨ prod-fst xs) q) (sym q) , rec xs (prod-snd w))))
    p

-- the inclusion ιₙ of the spine into the simplex
spine→simplex ∷ (n ∷ ℕ) → spine n → simplex n
spine→simplex zero x = tt
spine→simplex (succ n) (x , p) = (x , is-in-spine→is-sorted n x p)

--
-- Edges of the 2-spine and of the 2-simplex (coordinates x₁ ≥ x₂; vertices (0,0), (1,0), (1,1))
--

-- first edge of the spine, t ↦ (t, 0)
spine-edge-1 ∷ 𝕀 → spine 2
spine-edge-1 t =
  ((t , 𝕀0 , tt) ,
   unit-prop-trunc (sum ((𝕀0 , tt) ≡{cart-cube 1} zero-cube 1) ((t ≡ 𝕀1) × is-in-spine 1 (𝕀0 , tt)))
     (inl {(𝕀0 , tt) ≡{cart-cube 1} zero-cube 1} {(t ≡ 𝕀1) × is-in-spine 1 (𝕀0 , tt)} refl))

-- second edge of the spine, t ↦ (1, t)
spine-edge-2 ∷ 𝕀 → spine 2
spine-edge-2 t =
  let p : is-in-spine 1 (t , tt) =
    unit-prop-trunc (sum (tt ≡ zero-cube 0) ((t ≡ 𝕀1) × is-in-spine 0 tt))
      (inl {tt ≡ zero-cube 0} {(t ≡ 𝕀1) × is-in-spine 0 tt} refl)
  in
  ((𝕀1 , t , tt) ,
   unit-prop-trunc (sum ((t , tt) ≡{cart-cube 1} zero-cube 1) ((𝕀1 ≡ 𝕀1) × is-in-spine 1 (t , tt)))
     (inr {(t , tt) ≡{cart-cube 1} zero-cube 1} {(𝕀1 ≡ 𝕀1) × is-in-spine 1 (t , tt)} (refl , p)))

-- long edge of the 2-simplex, t ↦ (t, t)
long-edge ∷ 𝕀 → simplex 2
long-edge t = ((t , t , tt) , (refl , tt))

-- two points of a simplex with the same coordinates are equal (sortedness is a proposition)
abstract sorted-path ∷ (n ∷ ℕ) (x ∷ cart-cube (succ n)) (p q ∷ is-sorted n x) → (x , p) ≡{simplex (succ n)} (x , q)
sorted-path n x p q =
  let e ∷ p ≡ q = center (p ≡ q) (is-prop-is-sorted n x p q) in
  cong {is-sorted n x} {simplex (succ n)} (λ z . (x , z)) e

--
-- The spine as a set, and its vertex seen from both edges
--

abstract is-set-cart-cube ∷ (n ∷ ℕ) → is-set (cart-cube n)
is-set-cart-cube zero = is-set-unit
is-set-cart-cube (succ n) = is-set-prod {𝕀} {cart-cube n} is-set-𝕀 rec

is-prop-is-in-spine ∷ (n ∷ ℕ) (x : cart-cube n) → is-prop (is-in-spine n x)
is-prop-is-in-spine zero x = is-prop-unit
is-prop-is-in-spine (succ n) x = is-prop-type-prop-trunc _

abstract is-set-spine ∷ (n ∷ ℕ) → is-set (spine n)
is-set-spine n = is-set-Σ-prop (is-in-spine n) (is-set-cart-cube n) (is-prop-is-in-spine n)

spine-1-pt ∷ (t : 𝕀) → is-in-spine 1 (t , tt)
spine-1-pt t = unit-prop-trunc (sum (tt ≡ zero-cube 0) ((t ≡ 𝕀1) × is-in-spine 0 tt)) (inl {tt ≡ zero-cube 0} {(t ≡ 𝕀1) × is-in-spine 0 tt} refl)

spine-glue ∷ spine-edge-1 𝕀1 ≡{spine 2} spine-edge-2 𝕀0
spine-glue =
  let c0 ∷ cart-cube 2 = (𝕀1 , 𝕀0 , tt) in
  let τ ∷ snd (is-in-spine 2) (spine-edge-1 𝕀1) ≡ snd (is-in-spine 2) (spine-edge-2 𝕀0) =
    prop-path (is-prop-is-in-spine 2 c0) (snd (is-in-spine 2) (spine-edge-1 𝕀1)) (snd (is-in-spine 2) (spine-edge-2 𝕀0)) in
  cong {is-in-spine 2 c0} {spine 2} (λ w . (c0 , w)) τ

-- the two coordinates of a point of the 2-simplex
simplex-2-fst ∷ simplex 2 → 𝕀
simplex-2-fst z = prod-fst {𝕀} {cart-cube 1} (fst (is-sorted 1) z)

simplex-2-snd ∷ simplex 2 → 𝕀
simplex-2-snd z = prod-fst {𝕀} {⊤} (prod-snd {𝕀} {cart-cube 1} (fst (is-sorted 1) z))

-- simplices are sets
abstract is-set-simplex ∷ (n ∷ ℕ) → is-set (simplex (succ n))
is-set-simplex n = is-set-Σ-prop (is-sorted n) (is-set-cart-cube (succ n)) (is-prop-is-sorted n)

--
-- Edges of the 2-simplex, and faces and edges of the 3-simplex (coordinates x₁ ≥ x₂ ≥ x₃;
-- vertices 0 = (0,0,0), 1 = (1,0,0), 2 = (1,1,0), 3 = (1,1,1)). All sortedness proofs are refl
-- (the lattice laws are judgmental), so that faces of edges are edges judgmentally.
--

-- the first and second edges of the 2-simplex, t ↦ (t, 0) and t ↦ (1, t)
simplex-2-e01 ∷ 𝕀 → simplex 2
simplex-2-e01 t = ((t , 𝕀0 , tt) , (refl , tt))

simplex-2-e12 ∷ 𝕀 → simplex 2
simplex-2-e12 t = ((𝕀1 , t , tt) , (refl , tt))

-- the edges of the 3-simplex
simplex-3-e01 ∷ 𝕀 → simplex 3
simplex-3-e01 t = ((t , 𝕀0 , 𝕀0 , tt) , (refl , (refl , tt)))

simplex-3-e12 ∷ 𝕀 → simplex 3
simplex-3-e12 t = ((𝕀1 , t , 𝕀0 , tt) , (refl , (refl , tt)))

simplex-3-e23 ∷ 𝕀 → simplex 3
simplex-3-e23 t = ((𝕀1 , 𝕀1 , t , tt) , (refl , (refl , tt)))

simplex-3-e02 ∷ 𝕀 → simplex 3
simplex-3-e02 t = ((t , t , 𝕀0 , tt) , (refl , (refl , tt)))

simplex-3-e13 ∷ 𝕀 → simplex 3
simplex-3-e13 t = ((𝕀1 , t , t , tt) , (refl , (refl , tt)))

simplex-3-e03 ∷ 𝕀 → simplex 3
simplex-3-e03 t = ((t , t , t , tt) , (refl , (refl , tt)))

-- the inequality of a point of the 2-simplex
simplex-2-geq ∷ (y : simplex 2) → simplex-2-fst y ≥ simplex-2-snd y
simplex-2-geq y = prod-fst (snd (is-sorted 1) y)

-- the faces dᵢ : Δ² → Δ³, missing the vertex i
simplex-3-d0 ∷ simplex 2 → simplex 3
simplex-3-d0 y = ((𝕀1 , simplex-2-fst y , simplex-2-snd y , tt) , (refl , (simplex-2-geq y , tt)))

simplex-3-d1 ∷ simplex 2 → simplex 3
simplex-3-d1 y = ((simplex-2-fst y , simplex-2-fst y , simplex-2-snd y , tt) , (refl , (simplex-2-geq y , tt)))

simplex-3-d2 ∷ simplex 2 → simplex 3
simplex-3-d2 y = ((simplex-2-fst y , simplex-2-snd y , simplex-2-snd y , tt) , (simplex-2-geq y , (refl , tt)))

simplex-3-d3 ∷ simplex 2 → simplex 3
simplex-3-d3 y = ((simplex-2-fst y , simplex-2-snd y , 𝕀0 , tt) , (simplex-2-geq y , (refl , tt)))

-- the faces of the edges are edges, judgmentally
simplex-3-faces-edges ∷
  ((λ t . simplex-3-d3 (simplex-2-e01 t)) ≡{𝕀 → simplex 3} simplex-3-e01) ×
  ((λ t . simplex-3-d3 (simplex-2-e12 t)) ≡{𝕀 → simplex 3} simplex-3-e12) ×
  ((λ t . simplex-3-d3 (long-edge t)) ≡{𝕀 → simplex 3} simplex-3-e02) ×
  ((λ t . simplex-3-d0 (simplex-2-e01 t)) ≡{𝕀 → simplex 3} simplex-3-e12) ×
  ((λ t . simplex-3-d0 (simplex-2-e12 t)) ≡{𝕀 → simplex 3} simplex-3-e23) ×
  ((λ t . simplex-3-d0 (long-edge t)) ≡{𝕀 → simplex 3} simplex-3-e13) ×
  ((λ t . simplex-3-d1 (simplex-2-e01 t)) ≡{𝕀 → simplex 3} simplex-3-e02) ×
  ((λ t . simplex-3-d1 (simplex-2-e12 t)) ≡{𝕀 → simplex 3} simplex-3-e23) ×
  ((λ t . simplex-3-d1 (long-edge t)) ≡{𝕀 → simplex 3} simplex-3-e03) ×
  ((λ t . simplex-3-d2 (simplex-2-e01 t)) ≡{𝕀 → simplex 3} simplex-3-e01) ×
  ((λ t . simplex-3-d2 (simplex-2-e12 t)) ≡{𝕀 → simplex 3} simplex-3-e13) ×
  ((λ t . simplex-3-d2 (long-edge t)) ≡{𝕀 → simplex 3} simplex-3-e03)
simplex-3-faces-edges = (refl , refl , refl , refl , refl , refl , refl , refl , refl , refl , refl , refl)


-- a path of coordinates gives a path of points of a simplex, whatever the sortedness proofs
simplex-path ∷ (n ∷ ℕ) {x x' : cart-cube (succ n)} (e : x ≡ x') (p : is-sorted n x) (p' : is-sorted n x') → (x , p) ≡{simplex (succ n)} (x' , p')
simplex-path n {x} {x'} e =
  J' (λ x x' e . (p : is-sorted n x) (p' : is-sorted n x') → (x , p) ≡{simplex (succ n)} (x' , p'))
    (λ x p p' . cong {is-sorted n x} {simplex (succ n)} (λ z . (x , z)) (prop-path (is-prop-is-sorted n x) p p')) e
