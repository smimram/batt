--
-- Equivalences
--
-- Sections and retractions, equivalences and isomorphisms, contractible fibres, the
-- fundamental theorem of identity types, 2-out-of-3 and fiberwise equivalences.
--

open import Product
open import Function
open import Equality
open import Sigma

---
--- sections and retractions
---

is-section ∷ {A B : U} → (A → B) → (B → A) → U
is-section {A} {B} f s = (y : B) → f (s y) ≡ y

section ∷ {A B : U} → (A → B) → U
section {A} {B} f = Σ (s : B → A) . is-section f s

section-map ∷ {A B : U} (f : A → B) → section f → B → A
section-map f s' = fst _ s'

is-retraction ∷ {A B : U} → (A → B) → (B → A) → U
is-retraction {A} {B} f r = (x : A) → r (f x) ≡ x

retraction ∷ {A B : U} → (A → B) → U
retraction {A} {B} f = Σ (r : B → A) . is-retraction f r

retraction-map ∷ {A B : U} (f : A → B) → retraction f → B → A
retraction-map f r' = fst _ r'

-- maps with a retraction are injective
retraction-inj ∷ {A B : U} (f : A → B) → retraction f → {x y : A} → f x ≡ f y → x ≡ y
retraction-inj f (r , rr) {x} {y} p = trans (sym (rr x)) (trans (cong r p) (rr y))

---
--- equivalences
---

-- proof of equivalence

is-equiv ∷ {A B : U} → (A → B) → U
is-equiv {A} {B} f = section f × retraction f

-- sections and retraction obtained from a proof of equivalence

is-equiv-sec ∷ {A B : U} (f : A → B) → is-equiv f → section f
is-equiv-sec f (s, _) = s

is-equiv-inv-r ∷ {A B : U} (f : A → B) → is-equiv f → B → A
is-equiv-inv-r {A} {B} f (s', _) = section-map f s'

is-equiv-ret ∷ {A B : U} (f : A → B) → is-equiv f → retraction f
is-equiv-ret f (_, r) = r

is-equiv-inv-l ∷ {A B : U} (f : A → B) → is-equiv f → B → A
is-equiv-inv-l {A} {B} f (_, r') = retraction-map f r'

-- type of equivalences

equiv ∷ U → U → U
equiv A B = Σ (f : A → B) . is-equiv f

_≃_ ∷ U → U → U
_≃_ = equiv

-- helper functions

-- underlying function
equiv-fun ∷ {A B : U} → equiv A B → A → B
equiv-fun (f , _) = f

-- left inverse (retraction)
equiv-inv-l ∷ {A B : U} → equiv A B → B → A
equiv-inv-l (f , e) = retraction-map f (is-equiv-ret f e)

-- right inverse (section)
equiv-inv-r ∷ {A B : U} → equiv A B → B → A
equiv-inv-r (f , e) = section-map f (is-equiv-sec f e)

-- the left inverse is a retraction
equiv-ret ∷ {A B : U} (e : equiv A B) (x : A) → equiv-inv-l e (equiv-fun e x) ≡ x
equiv-ret (f , e) = snd _ (is-equiv-ret f e)

-- the right inverse is a section
equiv-sec ∷ {A B : U} (e : equiv A B) (y : B) → equiv-fun e (equiv-inv-r e y) ≡ y
equiv-sec (f , e) = snd _ (is-equiv-sec f e)

-- identity equivalence

is-equiv-id ∷ (A : U) → is-equiv id
is-equiv-id A =
  let f : A → A = id in
  let r : (x : A) → x ≡ x = fun _ → refl in
  ((f , r) , (f , r))

id-equiv ∷ (A : U) → equiv A A
id-equiv A = (id {A} , is-equiv-id A)

---
--- isomorphisms
---

is-iso ∷ {A B : U} → (A → B) → U
is-iso {A} {B} f = Σ (g : B → A) . (is-section f g) × (is-retraction f g)

is-iso→is-equiv ∷ {A B : U} → (f : A → B) → is-iso {A} {B} f → is-equiv f
is-iso→is-equiv f (g , sr) = (g , Product.fst sr) , (g , Product.snd sr)

iso→equiv ∷ {A B : U} → (f : A → B) (g : B → A) → is-section f g → is-retraction f g → A ≃ B
iso→equiv f g sec ret = (f , (g , sec) , (g , ret))

-- underlying map of an equivalence

map-equiv ∷ {A B : U} → equiv A B → A → B
map-equiv (f , _) = f

---
--- closure properties
---

-- being an equivalence only depends on the homotopy class of the map
is-equiv-htpy ∷ {A B : U} {f g : A → B} → ho f g → is-equiv f → is-equiv g
is-equiv-htpy {A} {B} {f} {g} h e =
  let sec : section f → section g = fun (s , ss) → (s , fun y → trans (sym (h (s y))) (ss y)) in
  let ret : retraction f → retraction g = fun (r , rr) → (r , fun x → trans (cong r (sym (h x))) (rr x)) in
  let k : is-equiv f → is-equiv g = fun (s , r) → (sec s , ret r) in
  k e

-- equivalences are closed under composition
is-equiv-circ ∷ {A B C : U} (g : B → C) (f : A → B) → is-equiv g → is-equiv f → is-equiv (g ∘ f)
is-equiv-circ {A} {B} {C} g f eg ef =
  let sec : section g → section f → section (g ∘ f) =
    fun (sg , ssg) → fun (sf , ssf) → (sf ∘ sg , fun z → trans (cong g (ssf (sg z))) (ssg z)) in
  let ret : retraction g → retraction f → retraction (g ∘ f) =
    fun (rg , rrg) → fun (rf , rrf) → (rf ∘ rg , fun x → trans (cong rf (rrg (f x))) (rrf x)) in
  let k : is-equiv g → is-equiv f → is-equiv (g ∘ f) =
    fun (sg , rg) → fun (sf , rf) → (sec sg sf , ret rg rf) in
  k eg ef

-- a retract of a contractible type is contractible
is-contr-retract ∷ {A B : U} (s : A → B) → retraction s → is-contr B → is-contr A
is-contr-retract s (r , rs) (b , p) = (r b , fun x → trans (cong r (p (s x))) (rs x))

---
--- Contractible maps
---

is-contr-map ∷ {A B : U} → (A → B) → U
is-contr-map {A} {B} f = (y : B) → is-contr (fib f y)

---
--- Equivalences have contractible fibres
---

-- naturality of a homotopy
htpy-nat ∷ {A B : U} {h k : A → B} (H : (a : A) → h a ≡ k a) {a a' : A} (p : a ≡ a') →
  trans (H a) (cong k p) ≡ trans (cong h p) (H a')
htpy-nat {A} {B} {h} {k} H {a} refl = sym (trans-refl-l (H a))

-- right cancellation of a path
trans-cancel-r ∷ {A : U} {x y : A} {p q : x ≡ y} {z : A} (r : y ≡ z) → trans p r ≡ trans q r → p ≡ q
trans-cancel-r {A} {x} {y} {p} {q} refl e = e

-- a homotopy g ∘ f ~ id commutes with g ∘ f
htpy-gf-coh ∷ {A B : U} (f : A → B) (g : B → A) (η : (x : A) → g (f x) ≡ x) (x : A) →
  η (g (f x)) ≡ cong (λ a . g (f a)) (η x)
htpy-gf-coh {A} {B} f g η x =
  trans-cancel-r (η x)
    (trans (cong {g (f x) ≡ x} {g (f (g (f x))) ≡ x} (λ w . trans (η (g (f x))) w) (sym (cong-id (η x))))
      (htpy-nat {A} {A} {λ a . g (f a)} {λ a . a} η (η x)))

-- the half-adjoint section homotopy
ha-sec ∷ {A B : U} (f : A → B) (g : B → A) (η : (x : A) → g (f x) ≡ x) (ε : (y : B) → f (g y) ≡ y) (y : B) → f (g y) ≡ y
ha-sec {A} {B} f g η ε y = trans (sym (ε (f (g y)))) (trans (cong f (η (g y))) (ε y))

-- cancelling a path on the left
trans-sym-cancel ∷ {A : U} {x y : A} (E : x ≡ y) {z : A} (q : y ≡ z) (X : x ≡ z) → X ≡ trans E q → trans (sym E) X ≡ q
trans-sym-cancel {A} {x} {y} E {z} q X h =
  trans (cong {x ≡ z} {y ≡ z} (λ w . trans (sym E) w) h) (trans (sym (assoc (sym E) E q)) (trans (cong {y ≡ y} {y ≡ z} (λ w . trans w q) (trans-sym-l E)) (trans-refl-l q)))

ha-coh ∷ {A B : U} (f : A → B) (g : B → A) (η : (x : A) → g (f x) ≡ x) (ε : (y : B) → f (g y) ≡ y) (x : A) →
  ha-sec f g η ε (f x) ≡ cong f (η x)
ha-coh {A} {B} f g η ε x =
  trans-sym-cancel (ε (f (g (f x)))) (cong f (η x)) (trans (cong f (η (g (f x)))) (ε (f x)))
    (trans (cong {g (f (g (f x))) ≡ g (f x)} {f (g (f (g (f x)))) ≡ f x} (λ w . trans (cong f w) (ε (f x))) (htpy-gf-coh f g η x))
      (trans (cong {f (g (f (g (f x)))) ≡ f (g (f x))} {f (g (f (g (f x)))) ≡ f x} (λ w . trans w (ε (f x)))
                (trans (sym (cong-comp f (λ a . g (f a)) (η x))) (cong-comp (λ b . f (g b)) f (η x))))
        (trans (sym (htpy-nat {B} {B} {λ b . f (g b)} {λ b . b} ε (cong f (η x))))
          (cong {f (g (f x)) ≡ f x} {f (g (f (g (f x)))) ≡ f x} (λ w . trans (ε (f (g (f x)))) w) (cong-id (cong f (η x)))))))

-- a point of the fibre over f x, with a path to x over which its path is the image of that path
fib-path ∷ {A B : U} (f : A → B) {a x : A} (e : a ≡ x) (q : f a ≡ f x) → q ≡ cong f e → (a , q) ≡{fib f (f x)} (x , refl)
fib-path {A} {B} f {a} {x} e =
  J' (λ a x e . (q : f a ≡ f x) → q ≡ cong f e → (a , q) ≡{fib f (f x)} (x , refl))
    (λ x q h . cong {f x ≡ f x} {fib f (f x)} (λ w . (x , w)) h) e

-- quasi-inverses have contractible fibres
is-contr-fib-qinv ∷ {A B : U} (f : A → B) (g : B → A) (η : (x : A) → g (f x) ≡ x) (ε : (y : B) → f (g y) ≡ y) (y : B) →
  is-contr (fib f y)
is-contr-fib-qinv {A} {B} f g η ε y =
  ((g y , ha-sec f g η ε y) ,
   fun (x , p) →
     J (f x) (λ y p . (g y , ha-sec f g η ε y) ≡{fib f y} (x , p))
       (fib-path f (η x) (ha-sec f g η ε (f x)) (ha-coh f g η ε x)) p)

-- equivalences have contractible fibres
is-contr-fib ∷ {A B : U} (f : A → B) → is-equiv f → (y : B) → is-contr (fib f y)
is-contr-fib {A} {B} f (sec , ret) y =
  let h : section f → retraction f → is-contr (fib f y) = fun (g , ε) (r , rf) →
    is-contr-fib-qinv f g (λ x . trans (sym (trans (sym (cong r (ε (f x)))) (rf (g (f x))))) (rf x)) ε y
  in
  h sec ret

---
--- Fundamental theorem of identity types
---

-- the fiberwise map obtained by transporting a point p0 : P x0
fund-id-map ∷ {X : U} (P : X → U) (x0 : X) (p0 : P x0) (x : X) → x0 ≡ x → P x
fund-id-map P x0 p0 x p = subst P p p0

-- if the total space of P is contractible, transporting p0 is a fiberwise equivalence
fund-id ∷ {X : U} (P : X → U) (x0 : X) (p0 : P x0) → is-contr (Σ (x : X) . P x) → (x : X) → is-equiv (fund-id-map P x0 p0 x)
fund-id {X} P x0 p0 c x =
  let inv : (x : X) → P x → x0 ≡ x = fun x y → cong (fst P) (is-contr-eq c (x0 , p0) (x , y)) in
  -- section: by induction on the path in the total space
  let sec : (w : Σ (x : X) . P x) (q : (x0 , p0) ≡{Σ (x : X) . P x} w) → subst P (cong (fst P) q) p0 ≡ snd P w =
    fun w q → J {Σ (x : X) . P x} (x0 , p0) (fun w q → subst P (cong (fst P) q) p0 ≡ snd P w) refl q in
  -- retraction: by induction on the path in the base
  let ret : (x : X) (p : x0 ≡ x) → inv x (subst P p p0) ≡ p =
    fun x p → J x0 (fun x p → inv x (subst P p p0) ≡ p)
      (cong {(x0 , p0) ≡{Σ (x : X) . P x} (x0 , p0)} {x0 ≡ x0} (fun q → cong (fst P) q) (is-contr-eq-refl c (x0 , p0))) p in
  ((inv x , fun y → sec (x , y) (is-contr-eq c (x0 , p0) (x , y))) , (inv x , ret x))

---
--- 2-out-of-3 and conjugation
---

-- left and right cancellation (2-out-of-3)
is-equiv-cancel-l ∷ {A B C : U} (g : B → C) (f : A → B) → is-equiv g → is-equiv (g ∘ f) → is-equiv f
is-equiv-cancel-l {A} {B} {C} g f eg egf =
  let r : C → B = retraction-map g (is-equiv-ret g eg) in
  let rr : (b : B) → r (g b) ≡ b = snd _ (is-equiv-ret g eg) in
  let s : C → B = section-map g (is-equiv-sec g eg) in
  let ss : (c : C) → g (s c) ≡ c = snd _ (is-equiv-sec g eg) in
  let gr : (c : C) → g (r c) ≡ c = λ c .
    trans (cong (λ c' . g (r c')) (sym (ss c))) (trans (cong g (rr (s c))) (ss c)) in
  let er : is-equiv r = ((g , rr) , (g , gr)) in
  is-equiv-htpy {A} {B} {r ∘ (g ∘ f)} {f} (λ a . rr (f a)) (is-equiv-circ r (g ∘ f) er egf)

is-equiv-cancel-r ∷ {A B C : U} (g : B → C) (f : A → B) → is-equiv f → is-equiv (g ∘ f) → is-equiv g
is-equiv-cancel-r {A} {B} {C} g f ef egf =
  let r : B → A = retraction-map f (is-equiv-ret f ef) in
  let rr : (a : A) → r (f a) ≡ a = snd _ (is-equiv-ret f ef) in
  let s : B → A = section-map f (is-equiv-sec f ef) in
  let ss : (b : B) → f (s b) ≡ b = snd _ (is-equiv-sec f ef) in
  let sf : (a : A) → s (f a) ≡ a = λ a .
    trans (sym (rr (s (f a)))) (trans (cong r (ss (f a))) (rr a)) in
  let es : is-equiv s = ((f , sf) , (f , ss)) in
  is-equiv-htpy {B} {C} {(g ∘ f) ∘ s} {g} (λ b . cong g (ss b)) (is-equiv-circ (g ∘ f) s egf es)

-- conjugation: if g ∘ α = β ∘ f (pointwise) with α and β equivalences, f and g are equivalent
is-equiv-conj ∷ {A B C D : U} (f : A → B) (g : C → D) (α : A → C) (β : B → D) →
  ((a : A) → g (α a) ≡ β (f a)) → is-equiv α → is-equiv β → is-equiv f → is-equiv g
is-equiv-conj {A} {B} {C} {D} f g α β H eα eβ ef =
  is-equiv-cancel-r g α eα (is-equiv-htpy {A} {D} {β ∘ f} {g ∘ α} (λ a . sym (H a)) (is-equiv-circ β f eβ ef))

is-equiv-conj' ∷ {A B C D : U} (f : A → B) (g : C → D) (α : A → C) (β : B → D) →
  ((a : A) → g (α a) ≡ β (f a)) → is-equiv α → is-equiv β → is-equiv g → is-equiv f
is-equiv-conj' {A} {B} {C} {D} f g α β H eα eβ eg =
  is-equiv-cancel-l β f eβ (is-equiv-htpy {A} {D} {g ∘ α} {β ∘ f} H (is-equiv-circ g α eg eα))

---
--- Base change of equivalences along families, and rotation of squares of paths
---

-- a point transported back along a path is equal to the original one, in the total space
Σ-subst-sym ∷ {B : U} (Q : B → U) {b' b : B} (p : b' ≡ b) (q : Q b) → (b' , subst Q (sym p) q) ≡{Σ (b : B) . Q b} (b , q)
Σ-subst-sym {B} Q {b'} refl q = refl

Σ-subst-sym-cong ∷ {A B : U} (f : A → B) (Q : B → U) {a' a : A} (p : a' ≡ a) (q : Q (f a)) →
  (a' , subst Q (sym (cong f p)) q) ≡{Σ (a : A) . Q (f a)} (a , q)
Σ-subst-sym-cong {A} {B} f Q {a'} refl q = refl

Σ-base ∷ {A B : U} (f : A → B) (Q : B → U) → (Σ (a : A) . Q (f a)) → Σ (b : B) . Q b
Σ-base {A} {B} f Q (a , q) = (f a , q)

-- base change of an equivalence along a family
abstract is-equiv-Σ-base ∷ {A B : U} (f : A → B) → is-equiv f → (Q : B → U) → is-equiv (Σ-base f Q)
is-equiv-Σ-base {A} {B} f (sec , ret) Q =
  let h : section f → retraction f → is-equiv (Σ-base f Q) = fun (g , ε) (r , rf) →
    let η : (x : A) → g (f x) ≡ x = λ x . trans (sym (trans (sym (cong r (ε (f x)))) (rf (g (f x))))) (rf x) in
    let ε' : (y : B) → f (g y) ≡ y = ha-sec f g η ε in
    let inv : (Σ (b : B) . Q b) → Σ (a : A) . Q (f a) = fun (b , q) → (g b , subst Q (sym (ε' b)) q) in
    let s : (w : Σ (b : B) . Q b) → Σ-base f Q (inv w) ≡ w = fun (b , q) → Σ-subst-sym Q (ε' b) q in
    let rt : (w : Σ (a : A) . Q (f a)) → inv (Σ-base f Q w) ≡ w = fun (a , q) →
      trans (cong {f (g (f a)) ≡ f a} {Σ (a' : A) . Q (f a')} (λ r' . (g (f a) , subst Q (sym r') q)) (ha-coh f g η ε a))
        (Σ-subst-sym-cong f Q (η a) q) in
    ((inv , s) , (inv , rt))
  in
  h sec ret

-- rotating a square of paths
trans-sym-trans ∷ {T : U} {a0 a1 : T} (A : a0 ≡ a1) {a3 : T} (X : a1 ≡ a3) → trans (sym A) (trans A X) ≡ X
trans-sym-trans {T} {a0} {a1} A refl = trans-sym-l A

path-rot ∷ {T : U} {a0 a1 a2 a3 : T} (A : a0 ≡ a1) (B : a1 ≡ a2) (C : a2 ≡ a3) {d1 : T} (D : a0 ≡ d1) {d2 : T} (E : d1 ≡ d2) (F : d2 ≡ a3) →
  trans A (trans B C) ≡ trans D (trans E F) → trans B (trans C (trans (sym F) (sym E))) ≡ trans (sym A) D
path-rot {T} {a0} {a1} {a2} {a3} A B C {d1} D {d2} E F =
  J' (λ d2' a3' F' . (C' : a2 ≡ a3') (E' : d1 ≡ d2') → trans A (trans B C') ≡ trans D (trans E' F') →
        trans B (trans C' (trans (sym F') (sym E'))) ≡ trans (sym A) D)
    (λ d C' E' .
      J' (λ d1' d' E'' . (C'' : a2 ≡ d') (D' : a0 ≡ d1') → trans A (trans B C'') ≡ trans D' (trans E'' refl) →
            trans B (trans C'' (trans refl (sym E''))) ≡ trans (sym A) D')
        (λ d' C'' D' h . trans (sym (trans-sym-trans A (trans B C''))) (cong {a0 ≡ d'} {a1 ≡ d'} (λ w . trans (sym A) w) h))
        E' C' D)
    F C E

-- the total map of a fiberwise map
tot ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) → (Σ (a : A) . P a) → Σ (a : A) . Q a
tot {A} {P} {Q} f (a , x) = (a , f a x)

-- a fiberwise equivalence induces an equivalence of total spaces
abstract is-equiv-tot ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) → ((a : A) → is-equiv (f a)) → is-equiv (tot {A} {P} {Q} f)
is-equiv-tot {A} {P} {Q} f e =
  let s : (Σ (a : A) . Q a) → Σ (a : A) . P a = fun (a , y) → (a , section-map (f a) (is-equiv-sec (f a) (e a)) y) in
  let ss : (w : Σ (a : A) . Q a) → tot {A} {P} {Q} f (s w) ≡ w = fun (a , y) →
    cong {Q a} {Σ (a : A) . Q a} (λ z . (a , z)) (snd _ (is-equiv-sec (f a) (e a)) y) in
  let r : (Σ (a : A) . Q a) → Σ (a : A) . P a = fun (a , y) → (a , retraction-map (f a) (is-equiv-ret (f a) (e a)) y) in
  let rr : (w : Σ (a : A) . P a) → r (tot {A} {P} {Q} f w) ≡ w = fun (a , x) →
    cong {P a} {Σ (a : A) . P a} (λ z . (a , z)) (snd _ (is-equiv-ret (f a) (e a)) x) in
  ((s , ss) , (r , rr))

-- a construction on the codomain of an equivalence e, obtained by transporting a construction g
-- on its domain along a section, agrees with g: the fibres of e are contractible
abstract transfer-equiv ∷ {S T : U} (e : S → T) → is-equiv e → (F : T → U) (g : (s : S) → F (e s)) (s s' : S) (E : e s' ≡ e s) →
  subst F E (g s') ≡ g s
transfer-equiv {S} {T} e ee F g s s' E =
  let c : is-contr (fib e (e s)) = is-contr-fib e ee (e s) in
  let G : fib e (e s) → F (e s) = fun (x , q) → subst F q (g x) in
  cong G (is-contr-eq c (s' , E) (s , refl))

---
--- Contractible maps and fibrewise equivalences
---

-- a map with contractible fibres is an equivalence
is-contr-map→is-equiv ∷ {A B : U} (f : A → B) → is-contr-map f → is-equiv f
is-contr-map→is-equiv {A} {B} f c =
  let s : B → A = λ y . fst (λ x . f x ≡ y) (fst (λ z . (z' : fib f y) → z ≡ z') (c y)) in
  let ε : (y : B) → f (s y) ≡ y = λ y . snd (λ x . f x ≡ y) (fst (λ z . (z' : fib f y) → z ≡ z') (c y)) in
  let η : (x : A) → s (f x) ≡ x = λ x .
    cong (fst (λ x' . f x' ≡ f x)) (snd (λ z . (z' : fib f (f x)) → z ≡ z') (c (f x)) (x , refl)) in
  ((s , ε) , (s , η))

-- the fibres of a map are retracts of the fibres of its total map
tot-fib→fib ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) (z : Σ (a : A) . Q a) →
  fib (tot {A} {P} {Q} f) z → fib (f (fst Q z)) (snd Q z)
tot-fib→fib {A} {P} {Q} f z (x , e) =
  let h : (x : Σ (a : A) . P a) (e : tot {A} {P} {Q} f x ≡ z) → fib (f (fst Q z)) (snd Q z) = fun (a' , p') e →
    J {Σ (a : A) . Q a} (a' , f a' p') (λ z' e' . fib (f (fst Q z')) (snd Q z')) (p' , refl) e in
  h x e

fib→tot-fib ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) (a : A) (q : Q a) →
  fib (f a) q → fib (tot {A} {P} {Q} f) (a , q)
fib→tot-fib {A} {P} {Q} f a q (p , e) = ((a , p) , cong {Q a} {Σ (a' : A) . Q a'} (λ q' . (a , q')) e)

fib→tot-fib-retr ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) (a : A) (q : Q a) (w : fib (f a) q) →
  tot-fib→fib {A} {P} {Q} f (a , q) (fib→tot-fib {A} {P} {Q} f a q w) ≡ w
fib→tot-fib-retr {A} {P} {Q} f a q (p , e) =
  J {Q a} (f a p)
    (λ q' e' . tot-fib→fib {A} {P} {Q} f (a , q') (fib→tot-fib {A} {P} {Q} f a q' (p , e')) ≡{fib (f a) q'} (p , e'))
    refl e

-- a total equivalence is a fibrewise equivalence
is-equiv-tot-fibrewise ∷ {A : U} {P Q : A → U} (f : (a : A) → P a → Q a) → is-equiv (tot {A} {P} {Q} f) → (a : A) → is-equiv (f a)
is-equiv-tot-fibrewise {A} {P} {Q} f e a =
  is-contr-map→is-equiv (f a)
    (λ q . is-contr-retract (fib→tot-fib {A} {P} {Q} f a q)
      (tot-fib→fib {A} {P} {Q} f (a , q) , fib→tot-fib-retr {A} {P} {Q} f a q)
      (is-contr-fib (tot {A} {P} {Q} f) e (a , q)))

-- paths in a Σ-type are pairs of a path and a transport
is-equiv-Σ-path-split ∷ {B : U} {Q : B → U} {b : B} {v : Q b} (w : Σ (b' : B) . Q b') →
  is-equiv (Σ-path-split {B} {Q} {b} {v} {w})
is-equiv-Σ-path-split {B} {Q} {b} {v} w =
  ((Σ-path-join' {B} {Q} {b} {v} w , Σ-path-split-join' {B} {Q} {b} {v} w) ,
   (Σ-path-join' {B} {Q} {b} {v} w , Σ-path-join'-split {B} {Q} {b} {v} w))

-- composing with a fixed path on the right is an equivalence
trans-right-retr ∷ {A : U} {x y z : A} (p : y ≡ z) (q : x ≡ y) → trans (trans q p) (sym p) ≡ q
trans-right-retr {A} {x} {y} {z} p q = J y (λ z' p' . trans (trans q p') (sym p') ≡ q) refl p

trans-right-sec ∷ {A : U} {x y z : A} (p : y ≡ z) (q : x ≡ z) → trans (trans q (sym p)) p ≡ q
trans-right-sec {A} {x} {y} {z} p q =
  J y (λ z' p' . (q' : x ≡ z') → trans (trans q' (sym p')) p' ≡ q') (λ q' . refl) p q

trans-right ∷ {A : U} {x y z : A} (p : y ≡ z) → x ≡ y → x ≡ z
trans-right {A} {x} {y} {z} p q = trans q p

is-equiv-trans-right ∷ {A : U} {x y z : A} (p : y ≡ z) → is-equiv (trans-right {A} {x} {y} {z} p)
is-equiv-trans-right {A} {x} {y} {z} p =
  ((λ q . trans q (sym p) , trans-right-sec {A} {x} {y} {z} p) , (λ q . trans q (sym p) , trans-right-retr {A} {x} {y} {z} p))

-- inverting paths is an equivalence
is-equiv-sym ∷ {A : U} {x y : A} → is-equiv (sym {A} {x} {y})
is-equiv-sym {A} {x} {y} = ((sym {A} {y} {x} , sym-sym {A} {y} {x}) , (sym {A} {y} {x} , sym-sym {A} {x} {y}))

-- the inverse of an equivalence is an equivalence
is-equiv-section-map ∷ {A B : U} (f : A → B) (e : is-equiv f) → is-equiv (section-map f (is-equiv-sec f e))
is-equiv-section-map {A} {B} f e =
  let s : B → A = section-map f (is-equiv-sec f e) in
  let ε : (y : B) → f (s y) ≡ y = snd (is-section f) (is-equiv-sec f e) in
  ((f , λ x . retraction-inj f (is-equiv-ret f e) {s (f x)} {x} (ε (f x))) , (f , ε))

---
--- Pulling back a family along a map
---
--- Σ over the pullback of fst : Σ C → M along φ : K → M is Σ (k : K) . C (φ k).
---

-- contracting the path in Σ (mc : Σ m . C m) . Σ k . fst mc ≡ φ k
family-pullback→Σ ∷ {M K : U} (C : M → U) (φ : K → M) → (Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k) → Σ (k : K) . C (φ k)
family-pullback→Σ {M} {K} C φ (mc , r) =
  let h : (mc : Σ (m : M) . C m) (r : Σ (k : K) . fst C mc ≡ φ k) → Σ (k : K) . C (φ k) =
    fun (m , c) (k , e) → (k , subst C e c) in
  h mc r

Σ→family-pullback ∷ {M K : U} (C : M → U) (φ : K → M) → (Σ (k : K) . C (φ k)) → Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k
Σ→family-pullback {M} {K} C φ (k , c) = ((φ k , c) , (k , refl))

family-pullback→Σ-retr-aux ∷ {M K : U} (C : M → U) (φ : K → M) (k : K) {m : M} (e' : φ k ≡ m) (c : C m) →
  Σ→family-pullback C φ (family-pullback→Σ C φ ((m , c) , (k , sym e')))
    ≡{Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k} ((m , c) , (k , sym e'))
family-pullback→Σ-retr-aux {M} {K} C φ k refl c = refl

family-pullback→Σ-retr ∷ {M K : U} (C : M → U) (φ : K → M) (w : Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k) →
  Σ→family-pullback C φ (family-pullback→Σ C φ w) ≡ w
family-pullback→Σ-retr {M} {K} C φ (mc , r) =
  let T : U = Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k in
  let h : (mc : Σ (m : M) . C m) (r : Σ (k : K) . fst C mc ≡ φ k) → Σ→family-pullback C φ (family-pullback→Σ C φ (mc , r)) ≡{T} (mc , r) =
    fun (m , c) (k , e) →
      let P : (m ≡ φ k) → U = λ e'' . Σ→family-pullback C φ (family-pullback→Σ C φ ((m , c) , (k , e''))) ≡{T} ((m , c) , (k , e'')) in
      subst P (sym-sym e) (family-pullback→Σ-retr-aux C φ k {m} (sym e) c) in
  h mc r

is-equiv-family-pullback→Σ ∷ {M K : U} (C : M → U) (φ : K → M) → is-equiv (family-pullback→Σ C φ)
is-equiv-family-pullback→Σ {M} {K} C φ = ((Σ→family-pullback C φ , fun (k , c) → refl) , (Σ→family-pullback C φ , family-pullback→Σ-retr C φ))
