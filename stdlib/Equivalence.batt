open import Product
open import Function
open import Equality

---
--- sections and retractions
---

is-section ∷ {A B : U} → (A → B) → (B → A) → U
is-section {A} {B} f s = (y : B) → f (s y) ≡ y

section ∷ {A B : U} → (A → B) → U
section {A} {B} f = Σ (s : B → A) . is-section f s

map-section ∷ {A B : U} (f : A → B) → section f → B → A
map-section f s' = fst _ s'

is-retraction ∷ {A B : U} → (A → B) → (B → A) → U
is-retraction {A} {B} f r = (x : A) → r (f x) ≡ x

retraction ∷ {A B : U} → (A → B) → U
retraction {A} {B} f = Σ (r : B → A) . is-retraction f r

map-retraction ∷ {A B : U} (f : A → B) → retraction f → B → A
map-retraction f r' = fst _ r'

---
--- equivalences
---

-- proof of equivalence

is-equiv ∷ {A B : U} → (A → B) → U
is-equiv {A} {B} f = section f × retraction f

-- sections and retraction obtained from a proof of equivalence

section-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → section f
section-is-equiv f (s, _) = s

map-section-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → B → A
map-section-is-equiv {A} {B} f (s', _) = map-section f s'

retraction-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → retraction f
retraction-is-equiv f (_, r) = r

map-retraction-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → B → A
map-retraction-is-equiv {A} {B} f (_, r') = map-retraction f r'

-- type of equivalences

equiv ∷ U → U → U
equiv A B = Σ (f : A → B) . is-equiv f

_≃_ :: U → U → U
_≃_ = equiv

-- identity equivalence

is-equiv-id ∷ (A : U) → is-equiv id
is-equiv-id A =
  let f : A → A = id in
  let r : (x : A) → x ≡ x = fun _ → refl in
  ((f , r) , (f , r))

id-equiv ∷ (A : U) → equiv A A
id-equiv A = (id {A} , is-equiv-id A)

---
--- isomorphisms
---

is-iso :: {A B : U} → (A → B) → U
is-iso {A} {B} f = Σ (g : B → A) . (is-section f g) × (is-retraction f g)

is-iso→is-equiv :: {A B : U} → (f : A → B) → is-iso {A} {B} f → is-equiv f
is-iso→is-equiv f (g , sr) = (g , prod-fst sr) , (g , prod-snd sr)

-- underlying map of an equivalence

map-equiv ∷ {A B : U} → equiv A B → A → B
map-equiv (f , _) = f

---
--- closure properties
---

-- being an equivalence only depends on the homotopy class of the map
is-equiv-htpy ∷ {A B : U} {f g : A → B} → ho f g → is-equiv f → is-equiv g
is-equiv-htpy {A} {B} {f} {g} h e =
  let sec : section f → section g = fun (s , ss) → (s , fun y → trans (sym (h (s y))) (ss y)) in
  let ret : retraction f → retraction g = fun (r , rr) → (r , fun x → trans (cong r (sym (h x))) (rr x)) in
  let k : is-equiv f → is-equiv g = fun (s , r) → (sec s , ret r) in
  k e

-- equivalences are closed under composition
is-equiv-circ ∷ {A B C : U} (g : B → C) (f : A → B) → is-equiv g → is-equiv f → is-equiv (circ g f)
is-equiv-circ {A} {B} {C} g f eg ef =
  let sec : section g → section f → section (circ g f) =
    fun (sg , ssg) → fun (sf , ssf) → (circ sf sg , fun z → trans (cong g (ssf (sg z))) (ssg z)) in
  let ret : retraction g → retraction f → retraction (circ g f) =
    fun (rg , rrg) → fun (rf , rrf) → (circ rf rg , fun x → trans (cong rf (rrg (f x))) (rrf x)) in
  let k : is-equiv g → is-equiv f → is-equiv (circ g f) =
    fun (sg , rg) → fun (sf , rf) → (sec sg sf , ret rg rf) in
  k eg ef
