--
-- Tensor products ⨂
--
-- Unit, associativity, currying (into lax and oplax functions) and distributivity over ×.
--

open import Equivalence

fst ∷ {A B ∷ U} → A ⨂ B → A
fst (a ⊗ b) = a

snd ∷ {A B ∷ U} → A ⨂ B → B
snd (a ⊗ b) = b

tens→prod ∷ {A B ∷ U} → A ⨂ B → A × B
tens→prod (a ⊗ b) = (a , b)

unit-left ∷ {A ∷ U} → ⊤ ⨂ A → A
unit-left (x ⊗ a) = a

counit-left ∷ {A ∷ U} → A → ⊤ ⨂ A
counit-left a = (tt ⊗ a)

unit-counit-left ∷ {A ∷ U} (a : A) → unit-left (counit-left a) ≡ a
unit-counit-left a = refl

counit-unit-left ∷ {A ∷ U} (x : ⊤ ⨂ A) → counit-left (unit-left x) ≡ x
counit-unit-left (t ⊗ a) =
  -- let tt = t in refl
  let f : (t : ⊤) → counit-left (unit-left (t ⊗ a)) ≡ (t ⊗ a) = λ tt → refl in
  f t

unit-left-equiv ∷ {A ∷ U} → ⊤ ⨂ A ≃ A
unit-left-equiv =
  (unit-left ,
   (counit-left , unit-counit-left) ,
   (counit-left , counit-unit-left))

unit-right ∷ {A ∷ U} → A ⨂ ⊤ → A
unit-right (a ⊗ x) = a

counit-right ∷ {A ∷ U} → A → A ⨂ ⊤
counit-right a = a ⊗ tt

unit-counit-right ∷ {A ∷ U} (a : A) → unit-right (counit-right a) ≡ a
unit-counit-right a = refl

counit-unit-right ∷ {A ∷ U} (x : A ⨂ ⊤) → counit-right (unit-right x) ≡ x
counit-unit-right (a ⊗ t) =
  let f : (t : ⊤) → counit-right (unit-right (a ⊗ t)) ≡ (a ⊗ t) = λ tt → refl in
  f t

unit-right-equiv ∷ {A ∷ U} → A ⨂ ⊤ ≃ A
unit-right-equiv =
  (unit-right ,
   (counit-right , unit-counit-right) ,
   (counit-right , counit-unit-right))

assoc ∷ {A B C ∷ U} → (A ⨂ B) ⨂ C → A ⨂ (B ⨂ C)
assoc {A} {B} {C} (ab ⊗ c) =
  let f ∷ A ⨂ B → C →ᵣ A ⨂ (B ⨂ C) = fun (a ⊗ b) c → a ⊗ (b ⊗ c) in
  f ab c

coassoc ∷ {A B C ∷ U} → A ⨂ (B ⨂ C) → (A ⨂ B) ⨂ C
coassoc {A} {B} {C} (a ⊗ bc) =
  let f ∷ B ⨂ C → A →ₗ (A ⨂ B) ⨂ C = fun (b ⊗ c) a → (a ⊗ b) ⊗ c in
  f bc a

assoc-equiv ∷ {A B C ∷ U} → (A ⨂ B) ⨂ C ≃ A ⨂ (B ⨂ C)
assoc-equiv {A} {B} {C} =
  let f ∷ (A ⨂ B) ⨂ C → A ⨂ (B ⨂ C) = assoc in
  let g ∷ A ⨂ (B ⨂ C) → (A ⨂ B) ⨂ C = coassoc in
  let fg ∷ (y : A ⨂ (B ⨂ C)) → f (g y) ≡ y = fun (a ⊗ w) →
    let h : (w : B ⨂ C) → f (g (a ⊗ w)) ≡ (a ⊗ w) = fun (b ⊗ c) → refl in
    h w
  in
  let gf ∷ (x : (A ⨂ B) ⨂ C) → g (f x) ≡ x = fun (u ⊗ c) →
    let h : (u : A ⨂ B) → g (f (u ⊗ c)) ≡ (u ⊗ c) = fun (a ⊗ b) → refl in
    h u
  in
  (f , (g , fg) , (g , gf))

map ∷ {A B C D ∷ U} (f ∷ A → B) (g ∷ C → D) → A ⨂ C → B ⨂ D
map f g (a ⊗ c) = (f(a) ⊗ g(c))

curry-left ∷ {A B C ∷ U} → (A ⨂ B →ₗ C) → (B →ₗ A →ₗ C)
curry-left f b a = f (a ⊗ b)

uncurry-left ∷ {A B C ∷ U} → (B →ₗ A →ₗ C) → (A ⨂ B →ₗ C)
uncurry-left {A} {B} {C} f (a ⊗ b) = f b a

curry-right ∷ {A B C ∷ U} → (A ⨂ B →ᵣ C) → (A →ᵣ B →ᵣ C)
curry-right f a b = f (a ⊗ b)

uncurry-right ∷ {A B C ∷ U} → (A →ᵣ B →ᵣ C) → (A ⨂ B →ᵣ C)
uncurry-right {A} {B} {C} f (a ⊗ b) = f a b

-- -- version of assoc using curry-l/r
-- assoc ∷ {A B C ∷ U} → (A ⨂ B) ⨂ C → A ⨂ (B ⨂ C)
-- assoc {A} {B} {C} =
  -- uncurry-right
    -- (uncurry-right {A} {B} {C →ᵣ A ⨂ (B ⨂ C)}
      -- (λ a b c → a ⊗ (b ⊗ c)))

-- NOTE: this cannot be expressed like this because dependent linear application does not make sense
-- uncurry-curry-left ∷ {A B C ∷ U} (u : A ⨂ B) (f : A ⨂ B →ₗ C) → uncurry-left (curry-left f) u ≡ f u
-- uncurry-curry-left f (a ⊗ b) = refl

uncurry-curry-left ∷ {A B C ∷ U} (f : A ⨂ B →ₗ C) → uncurry-left (curry-left f) ≡ f
uncurry-curry-left f = refl

curry-uncurry-left ∷ {A B C ∷ U} (f : B →ₗ A →ₗ C) → curry-left (uncurry-left f) ≡ f
curry-uncurry-left f = refl

uncurry-curry-right ∷ {A B C ∷ U} (f : A ⨂ B →ᵣ C) → uncurry-right (curry-right f) ≡ f
uncurry-curry-right f = refl

curry-uncurry-right ∷ {A B C ∷ U} (f : A →ᵣ B →ᵣ C) → curry-right (uncurry-right f) ≡ f
curry-uncurry-right f = refl

curry-equiv-left ∷ {A B C ∷ U}  → (A ⨂ B →ₗ C) ≃ (B →ₗ A →ₗ C)
curry-equiv-left =
  (curry-left ,
   (uncurry-left , curry-uncurry-left) ,
   (uncurry-left , uncurry-curry-left))

curry-equiv-right ∷ {A B C ∷ U}  → (A ⨂ B →ᵣ C) ≃ (A →ᵣ B →ᵣ C)
curry-equiv-right =
  (curry-right ,
   (uncurry-right , curry-uncurry-right) ,
   (uncurry-right , uncurry-curry-right))

-- Alternative versions (without ₗ/ᵣ also exist but do not have an inverse)

curry-left' ∷ {A B C ∷ U} → (A ⨂ B → C) → (B → A →ₗ C)
curry-left' f b a = f (a ⊗ b)

-- uncurry-left ∷ {A B C ∷ U} → (B → A →ₗ C) → (A ⨂ B → C)
-- uncurry-left f (a ⊗ b) = f b a

curry-right' ∷ {A B C ∷ U} → (A ⨂ B → C) → (A → B →ᵣ C)
curry-right' f a b = f (a ⊗ b)

-- uncurry-right ∷ {A B C ∷ U} → (A → B →ᵣ C) → (A ⨂ B → C)
-- uncurry-right f (a ⊗ b) = f a b

--- Distributivity

dist-l ∷ {A B C ∷ U} → A ⨂ (B × C) → (A ⨂ B) × C
dist-l (a ⊗ bc) = ((a ⊗ Product.fst bc) , Product.snd bc)

dist-r ∷ {A B C ∷ U} → (A × B) ⨂ C → A × (B ⨂ C)
dist-r (ab ⊗ c) = (Product.fst ab , (Product.snd ab ⊗ c))

-- the converse goes through only when the C is crisp
dist-l⁻ ∷ {A B C ∷ U} → (A ⨂ B) → (_ ∷ C) → A ⨂ (B × C)
dist-l⁻ (a ⊗ b) c = a ⊗ (b , c)
