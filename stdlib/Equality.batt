--
-- Identity types
--
-- Path induction, path algebra, homotopies, and the action of oplax and lax maps on crisp
-- paths.
--

open import Function

---
--- Identity types
---

eq ∷ {A : Type} (x y : A) → Type
eq x y = x ≡ y

refl' ∷ {A : Type} {x : A} → x ≡ x
refl' = refl

J ∷ {A : Type} (x : A) (P : (y : A) → x ≡ y → Type) → P x refl → {y : A} (p : x ≡ y) → P y p
J x P r refl = r

J' ∷ {A : Type} (P : (x y : A) → x ≡ y → Type) → ((x : A) → P x x refl) → {x y : A} (p : x ≡ y) → P x y p
J' P r {x} refl = r x

-- J-from-J' ∷ {A : Type} (x : A) (P : (y : A) → x ≡ y → Type) → P x refl → (y : A) (p : x ≡ y) → P y p
-- J-from-J' {A} x P r y p =
  -- let D : (x y : A) → x ≡ y → Type 1 = fun x y p → (P : (y : A) → x ≡ y → Type) → P x refl → P y p in
  -- let R : (x : A) → D x x refl = fun x P r → r in
  -- J' D R p P r

sym ∷ {A : Type} {x y : A} → x ≡ y → y ≡ x
sym {A} {x} refl = refl

trans ∷ {A : Type} {x y : A} → x ≡ y → {z : A} → y ≡ z → x ≡ z
trans p refl = p

cong ∷ {A B : Type} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f {x} refl = refl

cong2 ∷ {A B C : Type} (f : A → B → C) {x x' : A} → x ≡ x' → {y y' : B} → y ≡ y' → f x y ≡ f x' y'
cong2 f {x} refl {y} refl = refl

transport ∷ {A B : Type} → A ≡ B → A → B
transport {A} refl a = a

subst ∷ {A : Type} (P : A → Type) {x y : A} → x ≡ y → P x → P y
subst P {x} refl z = z

happly ∷ {A : Type} {B : A → Type} {f g : (x : A) → B x} → f ≡ g → (x : A) → f x ≡ g x
happly {A} {B} {f} refl x = refl

---
--- Basic lemmas
---

-- transport in a family along e : t0 ≡ t sends the value at t0 of a section to its value at t
subst-section ∷ {T : Type} (P : T → Type) (h : (t : T) → P t) {t0 t : T} (e : t0 ≡ t) → subst P e (h t0) ≡ h t
subst-section {T} P h {t0} {t} e = J t0 (λ t e . subst P e (h t0) ≡ h t) refl e

sym-sym ∷ {A : Type} {x y : A} (p : x ≡ y) → sym (sym p) ≡ p
sym-sym {A} {x} refl = refl

cong-id ∷ {A : Type} {x y : A} (p : x ≡ y) → cong id p ≡ p
cong-id {A} {x} refl = refl

cong-sym ∷ {A B : Type} (f : A → B) {x y : A} (p : x ≡ y) → cong f (sym p) ≡ sym (cong f p)
cong-sym f {x} refl = refl

assoc ∷ {A : Type} {x y : A} (p : x ≡ y) {z : A} (q : y ≡ z) {w : A} (r : z ≡ w) → trans (trans p q) r ≡ trans p (trans q r)
assoc p refl refl = refl

---
--- Homotopies
---

ho ∷ {A B : U} (f g : A → B) → U
ho {A} f g = (x : A) → f x ≡ g x

depho ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → U
depho {A} f g = (x : A) → f x ≡ g x

-- a path left composed with its inverse is refl
trans-sym-l ∷ {A : Type} {x y : A} (p : x ≡ y) → trans (sym p) p ≡ refl
trans-sym-l {A} {x} refl = refl

-- a path right composed with its inverse is refl
trans-sym-r ∷ {A : Type} {x y : A} (p : x ≡ y) → trans p (sym p) ≡ refl
trans-sym-r {A} {x} refl = refl

---
--- Paths and directed functions
---

-- an oplax map sends a crisp path between crisp points to a path (crisp path induction)
apᵣ ∷ {S X ∷ U} {y0 y1 ∷ S} (q ∷ y0 ≡ y1) (φ : S →ᵣ X) → φ y0 ≡ φ y1
apᵣ {S} {X} {y0} refl φ = refl

-- evaluation of a path between oplax maps at a crisp point
evᵣ ∷ {S X ∷ U} (y ∷ S) {φ ψ : S →ᵣ X} → φ ≡ ψ → φ y ≡ ψ y
evᵣ {S} {X} y {φ} {ψ} p = cong {S →ᵣ X} {X} (λ h . h y) p

-- a lax map sends a crisp path between crisp points to a path (crisp path induction)
apₗ ∷ {S X ∷ U} {y0 y1 ∷ S} (q ∷ y0 ≡ y1) (φ : S →ₗ X) → φ y0 ≡ φ y1
apₗ {S} {X} {y0} refl φ = refl

-- evaluation of a path between lax maps at a crisp point
evₗ ∷ {S X ∷ U} (y ∷ S) {φ ψ : S →ₗ X} → φ ≡ ψ → φ y ≡ ψ y
evₗ {S} {X} y {φ} {ψ} p = cong {S →ₗ X} {X} (λ h . h y) p

---
--- More path algebra
---

-- Equality
trans-refl-l ∷ {A : Type} {x y : A} (p : x ≡ y) → trans refl p ≡ p
trans-refl-l {A} {x} refl = refl

-- the image of a path under a constant map is refl
cong-cst ∷ {A B : Type} (b : B) {x y : A} (p : x ≡ y) → cong (λ _ . b) p ≡ refl
cong-cst {A} {B} b {x} refl = refl

cong-comp ∷ {A B C : Type} (g : B → C) (f : A → B) {x y : A} (p : x ≡ y) → cong (λ a . g (f a)) p ≡ cong g (cong f p)
cong-comp g f {x} refl = refl

cong-trans ∷ {A B : Type} (f : A → B) {x y : A} (p : x ≡ y) {z : A} (q : y ≡ z) → cong f (trans p q) ≡ trans (cong f p) (cong f q)
cong-trans f {x} p refl = refl

-- path algebra
cong-trans4 ∷ {A B : Type} (k : A → B) {x y z u v : A} (p : x ≡ y) (q : y ≡ z) (r : z ≡ u) (s : u ≡ v) →
  cong k (trans p (trans q (trans r s))) ≡ trans (cong k p) (trans (cong k q) (trans (cong k r) (cong k s)))
cong-trans4 {A} {B} k {x} {y} {z} {u} {v} p q r s =
  trans (cong-trans k p (trans q (trans r s)))
    (cong {k y ≡ k v} {k x ≡ k v} (λ e . trans (cong k p) e)
      (trans (cong-trans k q (trans r s)) (cong {k z ≡ k v} {k y ≡ k v} (λ e . trans (cong k q) e) (cong-trans k r s))))

ap-trans-mid ∷ {A : Type} {x y z u w : A} (X : x ≡ y) {m m' : y ≡ z} (e : m ≡ m') (Z : z ≡ u) {n n' : u ≡ w} (e' : n ≡ n') →
  trans X (trans m (trans Z n)) ≡ trans X (trans m' (trans Z n'))
ap-trans-mid X {m} refl Z {n} refl = refl

---
--- Crisp paths and directed functions
---

evₗ-at ∷ {G X ∷ U} {h h' ∷ G →ₗ X} (q ∷ h ≡ h') (w : G) → h w ≡ h' w
evₗ-at {G} {X} {h} refl w = refl

evᵣ-at ∷ {G X ∷ U} {h h' ∷ G →ᵣ X} (q ∷ h ≡ h') (w : G) → h w ≡ h' w
evᵣ-at {G} {X} {h} refl w = refl

-- the glue of the restriction of λ x . e x w is the evaluation of the glue of the restriction of e
apᵣ-family ∷ {S G X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) (e ∷ S → (G →ₗ X)) (w : G) →
  apᵣ {S} {X} {y0} {y1} c (λ x . e x w) ≡ evₗ-at {G} {X} {e y0} {e y1} (cong e c) w
apᵣ-family {S} {G} {X} {y0} refl e w = refl

-- applying a crisp path of families to a point
familyᵣ-path ∷ {S G X ∷ U} {e e' ∷ S → (G →ₗ X)} (p ∷ e ≡ e') (φ : G) → (λ x . e x φ) ≡{S →ᵣ X} (λ x . e' x φ)
familyᵣ-path {S} {G} {X} {e} refl φ = refl

-- the cartesian map "evaluate at y" and its action on crisp paths
evᵣ-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) → (λ φ . φ y0) ≡{(S →ᵣ X) → X} (λ φ . φ y1)
evᵣ-path {S} {X} {y0} refl = refl

happly-evᵣ-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  happly {S →ᵣ X} {λ _ . X} {λ φ . φ y0} {λ φ . φ y1} (evᵣ-path {S} {X} c) ≡ (λ φ . apᵣ {S} {X} {y0} {y1} c φ)
happly-evᵣ-path {S} {X} {y0} refl = refl

-- evaluating the path between two constant oplax maps induced by a path of values
evᵣ-const ∷ {S X ∷ U} (y ∷ S) {z z' : X} (p : z ≡ z') →
  evᵣ {S} {X} y {λ b . z} {λ b . z'} (cong {X} {S →ᵣ X} (λ v . λ b . v) p) ≡ p
evᵣ-const {S} {X} y {z} refl = refl

-- a crisp path of maps k ≡ k' gives a path between the precompositions of an oplax (lax) map
preᵣ-path ∷ (A ∷ U) {B X ∷ U} {k k' ∷ A → B} (p ∷ k ≡ k') (φ : B →ᵣ X) → preᵣ {A} {B} {X} φ k ≡ preᵣ {A} {B} {X} φ k'
preᵣ-path A {B} {X} {k} refl φ = refl

preₗ-path ∷ (A ∷ U) {B X ∷ U} {k k' ∷ A → B} (p ∷ k ≡ k') (φ : B →ₗ X) → preₗ {A} {B} {X} φ k ≡ preₗ {A} {B} {X} φ k'
preₗ-path A {B} {X} {k} refl φ = refl

-- evaluated at a crisp point, it is the image of the pointwise path
evᵣ-preᵣ-path ∷ (A ∷ U) {B X ∷ U} {k k' ∷ A → B} (p ∷ k ≡ k') (y ∷ A) (φ : B →ᵣ X) →
  evᵣ {A} {X} y {preᵣ {A} {B} {X} φ k} {preᵣ {A} {B} {X} φ k'} (preᵣ-path A {B} {X} {k} {k'} p φ)
    ≡ apᵣ {B} {X} {k y} {k' y} (happly {A} {λ _ . B} {k} {k'} p y) φ
evᵣ-preᵣ-path A {B} {X} {k} refl y φ = refl

-- apᵣ only depends on its crisp path up to a crisp path
apᵣ-path ∷ {S X ∷ U} {y0 y1 ∷ S} {e e' ∷ y0 ≡ y1} (E ∷ e ≡ e') (φ : S →ᵣ X) → apᵣ {S} {X} {y0} {y1} e φ ≡ apᵣ {S} {X} {y0} {y1} e' φ
apᵣ-path {S} {X} {y0} {y1} {e} refl φ = refl

-- apᵣ of a concatenation of crisp paths
apᵣ-trans ∷ {S X ∷ U} {y0 y1 ∷ S} (p ∷ y0 ≡ y1) {y2 ∷ S} (q ∷ y1 ≡ y2) (φ : S →ᵣ X) →
  apᵣ {S} {X} {y0} {y2} (trans p q) φ ≡ trans (apᵣ {S} {X} {y0} {y1} p φ) (apᵣ {S} {X} {y1} {y2} q φ)
apᵣ-trans {S} {X} {y0} {y1} p refl φ = refl

-- apᵣ of a precomposition is apᵣ of the image path
apᵣ-preᵣ ∷ (A ∷ U) {B X ∷ U} {y0 y1 ∷ A} (c ∷ y0 ≡ y1) (k ∷ A → B) (φ : B →ᵣ X) →
  apᵣ {A} {X} {y0} {y1} c (preᵣ {A} {B} {X} φ k) ≡ apᵣ {B} {X} {k y0} {k y1} (cong k c) φ
apᵣ-preᵣ A {B} {X} {y0} refl k φ = refl

-- the lax mirrors of the four lemmas above
apₗ-family ∷ {S G X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) (e ∷ S → (G →ᵣ X)) (w : G) →
  apₗ {S} {X} {y0} {y1} c (λ x . e x w) ≡ evᵣ-at {G} {X} {e y0} {e y1} (cong e c) w
apₗ-family {S} {G} {X} {y0} refl e w = refl

familyₗ-path ∷ {S G X ∷ U} {e e' ∷ S → (G →ᵣ X)} (p ∷ e ≡ e') (φ : G) → (λ x . e x φ) ≡{S →ₗ X} (λ x . e' x φ)
familyₗ-path {S} {G} {X} {e} refl φ = refl

evₗ-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) → (λ φ . φ y0) ≡{(S →ₗ X) → X} (λ φ . φ y1)
evₗ-path {S} {X} {y0} refl = refl

happly-evₗ-path ∷ {S X ∷ U} {y0 y1 ∷ S} (c ∷ y0 ≡ y1) →
  happly {S →ₗ X} {λ _ . X} {λ φ . φ y0} {λ φ . φ y1} (evₗ-path {S} {X} c) ≡ (λ φ . apₗ {S} {X} {y0} {y1} c φ)
happly-evₗ-path {S} {X} {y0} refl = refl

happly-cong-pre ∷ {A A' B : U} (h : A' → A) {k k' : A → B} (p : k ≡ k') →
  happly {A'} {λ _ . B} {λ a . k (h a)} {λ a . k' (h a)} (cong {A → B} {A' → B} (λ m . λ a . m (h a)) p)
    ≡ (λ a . happly {A} {λ _ . B} {k} {k'} p (h a))
happly-cong-pre {A} {A'} {B} h {k} refl = refl
