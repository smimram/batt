--
-- Identity types
--
-- Path induction, path algebra, homotopies, and the action of oplax and lax maps on crisp
-- paths.
--

open import Function
open import Arrow

---
--- Identity types
---

eq ∷ {A : Type} (x y : A) → Type
eq x y = x ≡ y

J ∷ {A : Type} (x : A) (P : (y : A) → x ≡ y → Type) → P x refl → {y : A} (p : x ≡ y) → P y p
J x P r refl = r

J' ∷ {A : Type} (P : (x y : A) → x ≡ y → Type) → ((x : A) → P x x refl) → {x y : A} (p : x ≡ y) → P x y p
J' P r {x} refl = r x

-- J-from-J' ∷ {A : Type} (x : A) (P : (y : A) → x ≡ y → Type) → P x refl → (y : A) (p : x ≡ y) → P y p
-- J-from-J' {A} x P r y p =
  -- let D : (x y : A) → x ≡ y → Type 1 = fun x y p → (P : (y : A) → x ≡ y → Type) → P x refl → P y p in
  -- let R : (x : A) → D x x refl = fun x P r → r in
  -- J' D R p P r

sym ∷ {A : Type} {x y : A} → x ≡ y → y ≡ x
sym {A} {x} refl = refl

trans ∷ {A : Type} {x y : A} → x ≡ y → {z : A} → y ≡ z → x ≡ z
trans p refl = p

cong ∷ {A B : Type} (f : A → B) {x y : A} → x ≡ y → f x ≡ f y
cong f {x} refl = refl

cong2 ∷ {A B C : Type} (f : A → B → C) {x x' : A} → x ≡ x' → {y y' : B} → y ≡ y' → f x y ≡ f x' y'
cong2 f {x} refl {y} refl = refl

transport ∷ {A B : Type} → A ≡ B → A → B
transport {A} refl a = a

subst ∷ {A : Type} (P : A → Type) {x y : A} → x ≡ y → P x → P y
subst P {x} refl z = z

happly ∷ {A : Type} {B : A → Type} {f g : (x : A) → B x} (p : f ≡ g) (x : A) → f x ≡ g x
happly {A} {B} {f} refl x = refl

---
--- Basic lemmas
---

-- transport in a family along e : t0 ≡ t sends the value at t0 of a section to its value at t
subst-section ∷ {T : Type} (P : T → Type) (h : (t : T) → P t) {t0 t : T} (e : t0 ≡ t) → subst P e (h t0) ≡ h t
subst-section {T} P h {t0} {t} e = J t0 (λ t e . subst P e (h t0) ≡ h t) refl e

sym-sym ∷ {A : Type} {x y : A} (p : x ≡ y) → sym (sym p) ≡ p
sym-sym {A} {x} refl = refl

cong-id ∷ {A : Type} {x y : A} (p : x ≡ y) → cong id p ≡ p
cong-id {A} {x} refl = refl

cong-sym ∷ {A B : Type} (f : A → B) {x y : A} (p : x ≡ y) → cong f (sym p) ≡ sym (cong f p)
cong-sym f {x} refl = refl

assoc ∷ {A : Type} {x y : A} (p : x ≡ y) {z : A} (q : y ≡ z) {w : A} (r : z ≡ w) → trans (trans p q) r ≡ trans p (trans q r)
assoc p refl refl = refl

---
--- Homotopies
---

ho ∷ {A B : U} (f g : A → B) → U
ho {A} f g = (x : A) → f x ≡ g x

depho ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → U
depho {A} f g = (x : A) → f x ≡ g x

-- a path left composed with its inverse is refl
trans-sym-l ∷ {A : Type} {x y : A} (p : x ≡ y) → trans (sym p) p ≡ refl
trans-sym-l {A} {x} refl = refl

-- a path right composed with its inverse is refl
trans-sym-r ∷ {A : Type} {x y : A} (p : x ≡ y) → trans p (sym p) ≡ refl
trans-sym-r {A} {x} refl = refl

---
--- Paths and directed functions
---

-- A lax map sends a crisp path between crisp points to a path (crisp path induction)
congₗ ∷ {A B ∷ U} (f : A →ₗ B) {x y ∷ A} (p ∷ x ≡ y) → f x ≡ f y
congₗ f {x} refl = refl

-- An oplax map sends a crisp path between crisp points to a path (crisp path induction)
congᵣ ∷ {A B ∷ U} (f : A →ᵣ B) {x y ∷ A} (p ∷ x ≡ y) → f x ≡ f y
congᵣ f {x} refl = refl

-- Evaluation of a path between lax maps at a crisp point
happlyₗ ∷ {A B ∷ U} {f g : A →ₗ B} (p : f ≡ g) (x ∷ A) → f x ≡ g x
happlyₗ {A} {B} p x = cong {A →ₗ B} (λ f . f x) p

-- Evaluation of a path between oplax maps at a crisp point
happlyᵣ ∷ {A B ∷ U} {f g : A →ᵣ B} (p : f ≡ g) (x ∷ A) → f x ≡ g x
happlyᵣ {A} {B} p x = cong {A →ᵣ B} {B} (λ f . f x) p

---
--- More path algebra
---

-- Equality
trans-refl-l ∷ {A : Type} {x y : A} (p : x ≡ y) → trans refl p ≡ p
trans-refl-l {A} {x} refl = refl

-- the image of a path under a constant map is refl
cong-cst ∷ {A B : Type} (b : B) {x y : A} (p : x ≡ y) → cong (λ _ . b) p ≡ refl
cong-cst {A} {B} b {x} refl = refl

cong-comp ∷ {A B C : Type} (g : B → C) (f : A → B) {x y : A} (p : x ≡ y) → cong (λ a . g (f a)) p ≡ cong g (cong f p)
cong-comp g f {x} refl = refl

cong-trans ∷ {A B : Type} (f : A → B) {x y : A} (p : x ≡ y) {z : A} (q : y ≡ z) → cong f (trans p q) ≡ trans (cong f p) (cong f q)
cong-trans f {x} p refl = refl

-- path algebra
cong-trans4 ∷ {A B : Type} (k : A → B) {x y z u v : A} (p : x ≡ y) (q : y ≡ z) (r : z ≡ u) (s : u ≡ v) →
  cong k (trans p (trans q (trans r s))) ≡ trans (cong k p) (trans (cong k q) (trans (cong k r) (cong k s)))
cong-trans4 {A} {B} k {x} {y} {z} {u} {v} p q r s =
  trans (cong-trans k p (trans q (trans r s)))
    (cong {k y ≡ k v} {k x ≡ k v} (λ e . trans (cong k p) e)
      (trans (cong-trans k q (trans r s)) (cong {k z ≡ k v} {k y ≡ k v} (λ e . trans (cong k q) e) (cong-trans k r s))))

ap-trans-mid ∷ {A : Type} {x y z u w : A} (X : x ≡ y) {m m' : y ≡ z} (e : m ≡ m') (Z : z ≡ u) {n n' : u ≡ w} (e' : n ≡ n') →
  trans X (trans m (trans Z n)) ≡ trans X (trans m' (trans Z n'))
ap-trans-mid X {m} refl Z {n} refl = refl

---
--- Crisp paths and directed functions
---

-- Evaluation of a crisp path between lax maps at a (non-crisp) point (crisp path induction)
happlyₗ-at ∷ {A B ∷ U} {f g ∷ A →ₗ B} (p ∷ f ≡ g) (x : A) → f x ≡ g x
happlyₗ-at {A} {B} {f} refl x = refl

-- Evaluation of a crisp path between oplax maps at a (non-crisp) point (crisp path induction)
happlyᵣ-at ∷ {A B ∷ U} {f g ∷ A →ᵣ B} (p ∷ f ≡ g) (x : A) → f x ≡ g x
happlyᵣ-at {A} {B} {f} refl x = refl

-- evaluating the image of a cartesian path under arr→arrₗ (resp. arr→arrᵣ) gives back the pointwise path
happlyₗ-at-κ ∷ {A B ∷ U} {f g ∷ A → B} (p ∷ f ≡ g) (x : A) →
  happlyₗ-at {A} {B} {arr→arrₗ {A} {B} f} {arr→arrₗ {A} {B} g} (cong {A → B} {A →ₗ B} (arr→arrₗ {A} {B}) p) x ≡ happly
    {A} {λ _ . B} {f} {g} p x
happlyₗ-at-κ {A} {B} {f} refl x = refl

happlyᵣ-at-κ ∷ {A B ∷ U} {f g ∷ A → B} (p ∷ f ≡ g) (x : A) →
  happlyᵣ-at {A} {B} {arr→arrᵣ {A} {B} f} {arr→arrᵣ {A} {B} g} (cong {A → B} {A →ᵣ B} (arr→arrᵣ {A} {B}) p) x ≡ happly
    {A} {λ _ . B} {f} {g} p x
happlyᵣ-at-κ {A} {B} {f} refl x = refl

-- the glue of the restriction of λ a . f a z is the evaluation of the glue of the restriction of f
congᵣ-family ∷ {A B C ∷ U} {x y ∷ A} (p ∷ x ≡ y) (f ∷ A → (B →ₗ C)) (z : B) →
  congᵣ {A} {C} (λ a . f a z) {x} {y} p ≡ happlyₗ-at {B} {C} {f x} {f y} (cong f p) z
congᵣ-family {A} {B} {C} {x} refl f z = refl

-- applying a crisp path of families to a point
familyᵣ-path ∷ {A B C ∷ U} {f g ∷ A → (B →ₗ C)} (p ∷ f ≡ g) (x : B) → (λ a . f a x) ≡{A →ᵣ C} (λ a . g a x)
familyᵣ-path {A} {B} {C} {f} refl x = refl

-- the cartesian map "evaluate at x" and its action on crisp paths
evᵣ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) → (λ f . f x) ≡{(A →ᵣ B) → B} (λ f . f y)
evᵣ-path {A} {B} {x} refl = refl

happly-evᵣ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) →
  happly {A →ᵣ B} {λ _ . B} {λ f . f x} {λ f . f y} (evᵣ-path {A} {B} p) ≡ (λ f . congᵣ {A} {B} f {x} {y} p)
happly-evᵣ-path {A} {B} {x} refl = refl

-- the image of a crisp path under the lax evaluation family is that of evᵣ-path
cong-evᵣ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) →
  cong {A} {(A →ᵣ B) →ₗ B} (λ a . λ f . f a) p ≡ cong {(A →ᵣ B) → B} {(A →ᵣ B) →ₗ B} (arr→arrₗ {A →ᵣ B} {B}) (evᵣ-path {A} {B} p)
cong-evᵣ-path {A} {B} {x} refl = refl

-- evaluating the path between two constant oplax maps induced by a path of values
happlyᵣ-const ∷ {A B ∷ U} (x ∷ A) {y y' : B} (p : y ≡ y') →
  happlyᵣ {A} {B} {λ _ . y} {λ _ . y'} (cong {B} {A →ᵣ B} (λ b . λ _ . b) p) x ≡ p
happlyᵣ-const {A} {B} x {y} refl = refl

-- a crisp path of maps f ≡ g gives a path between the precompositions of an oplax (lax) map
preᵣ-path ∷ (A ∷ U) {B C ∷ U} {f g ∷ A → B} (p ∷ f ≡ g) (h : B →ᵣ C) → preᵣ {A} {B} {C} h f ≡ preᵣ {A} {B} {C} h g
preᵣ-path A {B} {C} {f} refl h = refl

preₗ-path ∷ (A ∷ U) {B C ∷ U} {f g ∷ A → B} (p ∷ f ≡ g) (h : B →ₗ C) → preₗ {A} {B} {C} h f ≡ preₗ {A} {B} {C} h g
preₗ-path A {B} {C} {f} refl h = refl

-- evaluated at a crisp point, it is the image of the pointwise path
happlyᵣ-preᵣ-path ∷ (A ∷ U) {B C ∷ U} {f g ∷ A → B} (p ∷ f ≡ g) (x ∷ A) (h : B →ᵣ C) →
  happlyᵣ {A} {C} {preᵣ {A} {B} {C} h f} {preᵣ {A} {B} {C} h g} (preᵣ-path A {B} {C} {f} {g} p h) x
    ≡ congᵣ {B} {C} h {f x} {g x} (happly {A} {λ _ . B} {f} {g} p x)
happlyᵣ-preᵣ-path A {B} {C} {f} refl x h = refl

-- congᵣ only depends on its crisp path up to a crisp path
congᵣ-path ∷ {A B ∷ U} {x y ∷ A} {p q ∷ x ≡ y} (r ∷ p ≡ q) (f : A →ᵣ B) → congᵣ {A} {B} f {x} {y} p ≡ congᵣ {A} {B} f {x} {y} q
congᵣ-path {A} {B} {x} {y} {p} refl f = refl

-- congᵣ of a concatenation of crisp paths
congᵣ-trans ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) {z ∷ A} (q ∷ y ≡ z) (f : A →ᵣ B) →
  congᵣ {A} {B} f {x} {z} (trans p q) ≡ trans (congᵣ {A} {B} f {x} {y} p) (congᵣ {A} {B} f {y} {z} q)
congᵣ-trans {A} {B} {x} {y} p refl f = refl

-- congᵣ of a precomposition is congᵣ of the image path
congᵣ-preᵣ ∷ (A ∷ U) {B C ∷ U} {x y ∷ A} (p ∷ x ≡ y) (f ∷ A → B) (h : B →ᵣ C) →
  congᵣ {A} {C} (preᵣ {A} {B} {C} h f) {x} {y} p ≡ congᵣ {B} {C} h {f x} {f y} (cong f p)
congᵣ-preᵣ A {B} {C} {x} refl f h = refl

-- the lax mirrors of the four lemmas above
congₗ-family ∷ {A B C ∷ U} {x y ∷ A} (p ∷ x ≡ y) (f ∷ A → (B →ᵣ C)) (z : B) →
  congₗ {A} {C} (λ a . f a z) {x} {y} p ≡ happlyᵣ-at {B} {C} {f x} {f y} (cong f p) z
congₗ-family {A} {B} {C} {x} refl f z = refl

familyₗ-path ∷ {A B C ∷ U} {f g ∷ A → (B →ᵣ C)} (p ∷ f ≡ g) (x : B) → (λ a . f a x) ≡{A →ₗ C} (λ a . g a x)
familyₗ-path {A} {B} {C} {f} refl x = refl

evₗ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) → (λ f . f x) ≡{(A →ₗ B) → B} (λ f . f y)
evₗ-path {A} {B} {x} refl = refl

happly-evₗ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) →
  happly {A →ₗ B} {λ _ . B} {λ f . f x} {λ f . f y} (evₗ-path {A} {B} p) ≡ (λ f . congₗ {A} {B} f {x} {y} p)
happly-evₗ-path {A} {B} {x} refl = refl

-- the image of a crisp path under the oplax evaluation family is that of evₗ-path
cong-evₗ-path ∷ {A B ∷ U} {x y ∷ A} (p ∷ x ≡ y) →
  cong {A} {(A →ₗ B) →ᵣ B} (λ a . λ f . f a) p ≡ cong {(A →ₗ B) → B} {(A →ₗ B) →ᵣ B} (arr→arrᵣ {A →ₗ B} {B}) (evₗ-path {A} {B} p)
cong-evₗ-path {A} {B} {x} refl = refl

happly-cong-pre ∷ {A B C : U} (h : A → B) {f g : B → C} (p : f ≡ g) →
  happly {A} {λ _ . C} {λ a . f (h a)} {λ a . g (h a)} (cong {B → C} {A → C} (λ k . λ a . k (h a)) p)
    ≡ (λ a . happly {B} {λ _ . C} {f} {g} p (h a))
happly-cong-pre {A} {B} {C} h {f} refl = refl

---
--- More path algebra
---

-- naturality of a family of paths to a fixed point
nat-to-point ∷ {H T : Type} (P : H → T) {t : T} (k : (h : H) → P h ≡ t) {h h' : H} (α : h ≡ h') → k h ≡ trans (cong P α) (k h')
nat-to-point {H} {T} P {t} k {h} refl = sym (trans-refl-l (k h))

trans-sym-refl-cancel ∷ {T : Type} {x y z : T} (a : x ≡ y) (c : z ≡ y) → a ≡ trans (trans a (sym c)) (trans refl c)
trans-sym-refl-cancel {T} {x} {y} {z} a c =
  J' (λ z' y' c' . (a' : x ≡ y') → a' ≡ trans (trans a' (sym c')) (trans refl c')) (λ y' a' . refl) c a

trans-trans-sym-cancel ∷ {A : Type} {x y z : A} (p : x ≡ y) (q : x ≡ z) → trans p (trans (sym p) q) ≡ q
trans-trans-sym-cancel {A} {x} {y} {z} p q = J x (λ y' p' . trans p' (trans (sym p') q) ≡ q) (trans (trans-refl-l (trans refl q)) (trans-refl-l q)) p

subst-path-l ∷ {M T : Type} (P : M → T) {t : T} {m m' : M} (e : m ≡ m') (c : P m ≡ t) →
  subst (λ n . P n ≡ t) e c ≡ trans (cong P (sym e)) c
subst-path-l {M} {T} P {t} {m} refl c = sym (trans-refl-l c)

cong2-split ∷ {P1 P2 T : Type} (F : P1 → P2 → T) {a a' : P1} (p : a ≡ a') {c c' : P2} (q : c ≡ c') →
  cong2 F p q ≡ trans (cong (λ x . F x c) p) (cong (F a') q)
cong2-split {P1} {P2} {T} F {a} refl {c} refl = refl

-- going back and forth along a path
trans-sym-trans-cancel ∷ {A : Type} {x y z : A} (p : x ≡ y) (q : z ≡ y) → trans (trans p (sym q)) q ≡ p
trans-sym-trans-cancel {A} {x} {y} {z} p q =
  J' (λ z' y' q' . (p' : x ≡ y') → trans (trans p' (sym q')) q' ≡ p') (λ y' p' . refl) q p

-- a fibrewise map commutes with transport
subst-fibrewise ∷ {A : Type} (F G : A → Type) (φ : (x : A) → F x → G x) {x y : A} (q : x ≡ y) (v : F x) →
  φ y (subst F q v) ≡ subst G q (φ x v)
subst-fibrewise {A} F G φ {x} refl v = refl

-- cancelling the second argument of cong2 f d e against cong (f x) e
trans-cong2-cancel-r ∷ {T S1 S2 : U} (f : S1 → S2 → T) {t0 t1 t2 : T} (a : t0 ≡ t1) (b : t1 ≡ t2)
  {x x' : S1} (d : x ≡ x') {y y' : S2} (e : y ≡ y') (c : t2 ≡ f x' y') →
  trans (trans a (trans b (trans c (sym (cong2 f d e))))) (cong (f x) e)
    ≡ trans a (trans (trans b c) (cong (λ m . f m y') (sym d)))
trans-cong2-cancel-r {T} {S1} {S2} f a b {x} refl {y} refl c = refl

-- cancelling the first argument of cong2 F d1 d2 against cong (λ x . F x b0) d1, under a
-- conjugation by c0 and a transport along e'
private
trans-cong2-cancel-l-core ∷ {T : U} {X0 Y0 : T} (c0 : X0 ≡ Y0) {Z0 : T} (h : Y0 ≡ Z0) → trans refl h ≡ trans (sym c0) (trans c0 (trans refl h))
trans-cong2-cancel-l-core {T} {X0} {Y0} c0 refl = sym (trans-sym-l c0)

trans-cong2-cancel-l ∷ {M T P1 P2 : U} (P : M → T) (F : P1 → P2 → T) {X0 : T} {m : M} (c0 : X0 ≡ P m) {m' : M} (e' : m ≡ m')
  {a0 a : P1} (d1 : a0 ≡ a) {b0 b : P2} (d2 : b0 ≡ b) (h : P m' ≡ F a b) →
  trans (sym (cong P (sym e'))) (trans h (cong (F a) (sym d2)))
  ≡ trans (sym c0) (trans (trans c0 (trans (cong P e') (trans h (sym (cong2 F d1 d2))))) (cong (λ x . F x b0) d1))
trans-cong2-cancel-l {M} {T} {P1} {P2} P F {X0} {m} c0 refl {a0} refl {b0} refl h = trans-cong2-cancel-l-core c0 h
