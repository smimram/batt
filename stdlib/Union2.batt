--
-- A union of two subtypes is the pushout of the two subtypes over their intersection
--
-- For a type X and two families of propositions A, B over X, the union
--   union A B := Σ (x : X) . A x ∨ B x
-- has the universal property of the pushout of Σ A ← Σ (A ∧ B) → Σ B: maps out of it are
-- cocones, pairs of maps out of Σ A and Σ B that agree on the intersection.
--
--   union-up : is-equiv (restr : (union A B → Y) → cocone A B Y)
--
-- No pushout type is used. Since the truncated ∨ only eliminates into propositions, a map out of
-- the union is defined through a descent family: at x, the type union-D of values compatible
-- with both pieces of the cocone, which is contractible as soon as A x ∨ B x holds.
--
-- References.
--
-- * For a single point (X = 1) this is the statement that the disjunction of two propositions is
--   their join, i.e. the pushout of P ← P × Q → Q. With pushouts as a higher inductive type it
--   is proved the other way round: the join P ∗ Q of propositions is a proposition and satisfies
--   the universal property of the disjunction, hence P ∗ Q ≃ P ∨ Q.
--     - E. Rijke, Introduction to Homotopy Type Theory, lecture notes, Carnegie Mellon University,
--       2018: exercise on joins of propositions in the lecture on homotopy pushouts
--     - The agda-unimath library, module synthetic-homotopy-theory.joins-of-types, section
--       "Disjunction is the join of propositions": equiv-disjunction-join-Prop : (P ∗ Q) ≃ (P ∨ Q),
--       with is-prop-join-is-prop.
--
-- * For a general X this is the statement that the join of two embeddings into X is their union
--   as subtypes, the join of maps f ∗ g being the pushout of A ← A ×_X B → B.
--     - E. Rijke, The join construction, arXiv:1701.07538 (2017): the fibres of the join of maps
--       are the joins of the fibres, and the join of two embeddings is again an embedding, namely
--       the union of the two subtypes.
--     - The agda-unimath library, module foundation.unions-subtypes: union-subtype P Q x = P x ∨ Q x.
--
-- * Defining a map out of a proposition by eliminating into the proposition is-contr of a type of
--   candidate values is a form of the principle of unique choice (The Univalent Foundations
--   Program, HoTT book, chapter on sets and logic: a family of propositions that is merely
--   inhabited everywhere has a section); the same device appears in the proofs above that P ∗ Q
--   is a proposition. Here it is applied fibrewise, without the join: the descent family union-D plays
--   the role of the type of candidate values.
--
-- Unlike the references, no pushout or join is assumed: the union is defined by the truncated
-- disjunction, and its universal property is proved directly. X need not be a set.
--

open import Equality
open import Product
open import Prop
open import Contr
open import Equivalence
open import PropTrunc
open import Sum
open import Funext
open import Sigma

-- The union and its two pieces
union ∷ {X : U} (A B : X → U) → U
union {X} A B = Σ (x : X) . (A x) ∨ (B x)

pt ∷ {X : U} {A B : X → U} {x : X} → (A x) ∨ (B x) → union A B
pt {X} {A} {B} {x} u = (x , u)

inl ∷ {X : U} {A B : X → U} {x : X} → A x → union A B
inl a = pt (or-l a)

inr ∷ {X : U} {A B : X → U} {x : X} → B x → union A B
inr b = pt (or-r b)

-- The two pieces agree on the intersection
glue ∷ {X : U} {A B : X → U} {x : X} (a : A x) (b : B x) → inl a ≡ inr b
glue {X} {A} {B} {x} a b = cong (pt {X} {A} {B} {x}) (prop-path (is-prop-trunc _) (or-l a) (or-r b))

-- Cocones: two maps that agree on the intersection
cocone ∷ {X : U} (A B : X → U) (Y : U) → U
cocone {X} A B Y =
  Σ (f : {x : X} → A x → Y) .
  Σ (g : {x : X} → B x → Y) .
  {x : X} (a : A x) (b : B x) → f a ≡ g b

-- Restriction to the cocone
restr ∷ {X : U} {A B : X → U} {Y : U} → (union A B → Y) → cocone A B Y
restr {X} {A} {B} {Y} f = (f ∘ inl , f ∘ inr , λ a b . cong f (glue a b))

--
-- The descent family of a cocone (f , g , h) at x: the candidate values for a map extending the
-- cocone, in the sense of the principle of unique choice (see the references above)
--

D-base ∷ {X : U} {A : X → U} {Y : U} (f : {x : X} → A x → Y) (x : X) → U
D-base {X} {A} {Y} f x = Σ (y : Y) . (a : A x) → y ≡ f {x} a

D-fib ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → D-base {X} {A} {Y} f x → U
D-fib {X} {A} {B} {Y} f g h x (y , α) =
  Σ (β : (b : B x) → y ≡ g {x} b) . (a : A x) (b : B x) → β b ≡ trans (α a) (h {x} a b)

D ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → U
D {X} {A} {B} {Y} f g h x = Σ (u : D-base {X} {A} {Y} f x) . D-fib {X} {A} {B} {Y} f g h x u

-- The descent family with the roles of the two pieces exchanged (the B-path first)
D'-base ∷ {X : U} {B : X → U} {Y : U} (g : {x : X} → B x → Y) (x : X) → U
D'-base {X} {B} {Y} g x = Σ (y : Y) . (b : B x) → y ≡ g {x} b

D'-fib ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → D'-base {X} {B} {Y} g x → U
D'-fib {X} {A} {B} {Y} f g h x (y , β) =
  Σ (α : (a : A x) → y ≡ f {x} a) . (a : A x) (b : B x) → β b ≡ trans (α a) (h {x} a b)

--
-- The descent family is contractible wherever A x ∨ B x holds
--

-- If A x holds: contract the value with its A-path, then each B-path is determined
D-contr-A ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → A x → is-contr (D {X} {A} {B} {Y} f g h x)
D-contr-A {X} {A} {B} pA {Y} f g h x a0 =
  let κ : (a : A x) → a0 ≡ a = λ a . prop-path (pA x) a0 a in
  let base : is-contr (D-base {X} {A} {Y} f x) =
    contr-Π-in-Σ {Y} {A x} (λ y a . y ≡ f {x} a) a0 κ (is-contr-sing' (f {x} a0)) in
  let fib : (u : D-base {X} {A} {Y} f x) → is-contr (D-fib {X} {A} {B} {Y} f g h x u) = λ (y , α) .
    let V : U = (b : B x) → Σ (βb : y ≡ g {x} b) . (a : A x) → βb ≡ trans (α a) (h {x} a b) in
    let F : U = D-fib {X} {A} {B} {Y} f g h x (y , α) in
    let s : F → V = λ (β , γ) . λ b . (β b , λ a . γ a b) in
    let r : V → F = λ v .
      ((λ b . fst {y ≡ g {x} b} (λ βb . (a : A x) → βb ≡ trans (α a) (h {x} a b)) (v b)) ,
       (λ a b . snd {y ≡ g {x} b} (λ βb . (a : A x) → βb ≡ trans (α a) (h {x} a b)) (v b) a)) in
    let rs : (w : F) → r (s w) ≡ w = λ (β , γ) . refl in
    is-contr-retract s (r , rs)
      (is-contr-Π (λ b . Σ (βb : y ≡ g {x} b) . (a : A x) → βb ≡ trans (α a) (h {x} a b))
        (λ b . contr-Π-in-Σ {y ≡ g {x} b} {A x} (λ βb a . βb ≡ trans (α a) (h {x} a b)) a0 κ
          (is-contr-sing' (trans (α a0) (h {x} a0 b)))))
  in
  is-contr-Σ (D-fib {X} {A} {B} {Y} f g h x) base fib

-- If B x holds: contract the value with its B-path, then each A-path is determined
D-contr-B ∷ {X : U} {A B : X → U} (pB : (x : X) → is-prop (B x)) {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → B x → is-contr (D {X} {A} {B} {Y} f g h x)
D-contr-B {X} {A} {B} pB {Y} f g h x b0 =
  let κ : (b : B x) → b0 ≡ b = λ b . prop-path (pB x) b0 b in
  let D0 : U = D {X} {A} {B} {Y} f g h x in
  let D1 : U = Σ (v : D'-base {X} {B} {Y} g x) . D'-fib {X} {A} {B} {Y} f g h x v in
  let s : D0 → D1 = λ (u , w) .
    let k : (u : D-base {X} {A} {Y} f x) → D-fib {X} {A} {B} {Y} f g h x u → D1 =
      fun (y , α) (β , γ) → ((y , β) , (α , γ)) in k u w in
  let r : D1 → D0 = λ (v , w) .
    let k : (v : D'-base {X} {B} {Y} g x) → D'-fib {X} {A} {B} {Y} f g h x v → D0 =
      fun (y , β) (α , γ) → ((y , α) , (β , γ)) in k v w in
  let rs : (z : D0) → r (s z) ≡ z = λ (u , w) .
    let k : (u : D-base {X} {A} {Y} f x) (w : D-fib {X} {A} {B} {Y} f g h x u) → r (s (u , w)) ≡ (u , w) =
      fun (y , α) (β , γ) → refl in k u w in
  let base : is-contr (D'-base {X} {B} {Y} g x) =
    contr-Π-in-Σ {Y} {B x} (λ y b . y ≡ g {x} b) b0 κ (is-contr-sing' (g {x} b0)) in
  let fib : (v : D'-base {X} {B} {Y} g x) → is-contr (D'-fib {X} {A} {B} {Y} f g h x v) = λ (y , β) .
    let V : U = (a : A x) → Σ (αa : y ≡ f {x} a) . (b : B x) → β b ≡ trans αa (h {x} a b) in
    let F : U = D'-fib {X} {A} {B} {Y} f g h x (y , β) in
    let s' : F → V = λ (α , γ) . λ a . (α a , λ b . γ a b) in
    let r' : V → F = λ v .
      ((λ a . fst {y ≡ f {x} a} (λ αa . (b : B x) → β b ≡ trans αa (h {x} a b)) (v a)) ,
       (λ a b . snd {y ≡ f {x} a} (λ αa . (b : B x) → β b ≡ trans αa (h {x} a b)) (v a) b)) in
    let rs' : (w : F) → r' (s' w) ≡ w = λ (α , γ) . refl in
    is-contr-retract s' (r' , rs')
      (is-contr-Π (λ a . Σ (αa : y ≡ f {x} a) . (b : B x) → β b ≡ trans αa (h {x} a b))
        (λ a . contr-Π-in-Σ {y ≡ f {x} a} {B x} (λ αa b . β b ≡ trans αa (h {x} a b)) b0 κ
          (trans-contr (h {x} a b0) (β b0))))
  in
  is-contr-retract s (r , rs) (is-contr-Σ (D'-fib {X} {A} {B} {Y} f g h x) base fib)

D-contr ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  (x : X) → (A x) ∨ (B x) → is-contr (D {X} {A} {B} {Y} f g h x)
D-contr {X} {A} {B} pA pB {Y} f g h x w =
  PropTrunc.rec' (is-prop-is-contr (D {X} {A} {B} {Y} f g h x))
    (Sum.rec {A x} {B x} {is-contr (D {X} {A} {B} {Y} f g h x)}
      (D-contr-A {X} {A} {B} pA {Y} f g h x) (D-contr-B {X} {A} {B} pB {Y} f g h x)) w

-- The value of a point of the descent family
D-y ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) → D {X} {A} {B} {Y} f g h x → Y
D-y {X} {A} {B} {Y} f g h x (u , w) = fst (λ y . (a : A x) → y ≡ f {x} a) u

-- The value and the two paths of a point of the descent family, and their coherence
D-α ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) (z : D {X} {A} {B} {Y} f g h x) (a : A x) →
  D-y {X} {A} {B} {Y} f g h x z ≡ f {x} a
D-α {X} {A} {B} {Y} f g h x (u , w) = snd (λ y . (a : A x) → y ≡ f {x} a) u

D-β ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) (z : D {X} {A} {B} {Y} f g h x) (b : B x) →
  D-y {X} {A} {B} {Y} f g h x z ≡ g {x} b
D-β {X} {A} {B} {Y} f g h x (u , w) =
  let k : (u : D-base {X} {A} {Y} f x) (w : D-fib {X} {A} {B} {Y} f g h x u) (b : B x) →
      D-y {X} {A} {B} {Y} f g h x (u , w) ≡ g {x} b = fun (y , α) (β , γ) → β in
  k u w

D-γ ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) (z : D {X} {A} {B} {Y} f g h x) (a : A x) (b : B x) →
  D-β {X} {A} {B} {Y} f g h x z b ≡ trans (D-α {X} {A} {B} {Y} f g h x z a) (h {x} a b)
D-γ {X} {A} {B} {Y} f g h x (u , w) =
  let k : (u : D-base {X} {A} {Y} f x) (w : D-fib {X} {A} {B} {Y} f g h x u) (a : A x) (b : B x) →
      D-β {X} {A} {B} {Y} f g h x (u , w) b ≡ trans (D-α {X} {A} {B} {Y} f g h x (u , w) a) (h {x} a b) =
    fun (y , α) (β , γ) → γ in
  k u w

-- A path in the descent family moves the B-path along the value
D-β-path ∷ {X : U} {A B : X → U} {Y : U} (f : {x : X} → A x → Y) (g : {x : X} → B x → Y)
  (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) (x : X) (z z' : D {X} {A} {B} {Y} f g h x) (ζ : z ≡ z') (b : B x) →
  trans (cong (D-y {X} {A} {B} {Y} f g h x) ζ) (D-β {X} {A} {B} {Y} f g h x z' b) ≡ D-β {X} {A} {B} {Y} f g h x z b
D-β-path {X} {A} {B} {Y} f g h x z z' ζ b =
  J z (λ z' ζ . trans (cong (D-y {X} {A} {B} {Y} f g h x) ζ) (D-β {X} {A} {B} {Y} f g h x z' b) ≡ D-β {X} {A} {B} {Y} f g h x z b)
    (trans-refl-l (D-β {X} {A} {B} {Y} f g h x z b)) ζ

-- The center of the descent family at x, for a given witness of A x ∨ B x
Z ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  (x : X) → (A x) ∨ (B x) → D {X} {A} {B} {Y} f g h x
Z {X} {A} {B} pA pB {Y} f g h x w = center (D {X} {A} {B} {Y} f g h x) (D-contr {X} {A} {B} pA pB {Y} f g h x w)

--
-- The extension of a cocone to the union
--

extend ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) → union A B → Y
extend {X} {A} {B} pA pB {Y} f g h (x , w) = D-y {X} {A} {B} {Y} f g h x (Z {X} {A} {B} pA pB {Y} f g h x w)

union-ext ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) (Y : U) → cocone A B Y → (union A B → Y)
union-ext {X} {A} {B} pA pB Y (f , r) =
  let k : (r : Σ (g : {x : X} → B x → Y) . {x : X} (a : A x) (b : B x) → f a ≡ g b) → union A B → Y =
    fun (g , h) → extend {X} {A} {B} pA pB {Y} f g h in
  k r

--
-- Function extensionality for the maps of a cocone
--

impl ∷ {X : U} {A : X → U} {Y : U} → ((x : X) → A x → Y) → {x : X} → A x → Y
impl k {x} a = k x a

hap ∷ {X : U} {A : X → U} {Y : U} {f f' : {x : X} → A x → Y} → f ≡ f' → {x : X} (a : A x) → f a ≡ f' a
hap {X} {A} {Y} {f} {f'} P {x} a = cong { {x : X} → A x → Y } {Y} (λ m . m {x} a) P

fext ∷ {X : U} {A : X → U} {Y : U} (f f' : {x : X} → A x → Y) → ({x : X} (a : A x) → f a ≡ f' a) → f ≡ f'
fext {X} {A} {Y} f f' α =
  cong {(x : X) → A x → Y} { {x : X} → A x → Y } (impl {X} {A} {Y})
    (funext-htpy {X} {λ x . A x → Y} (λ x . f {x}) (λ x . f' {x})
      (λ x . funext-htpy {A x} {λ _ . Y} (f {x}) (f' {x}) (λ a . α {x} a)))

cong-ev ∷ {T : U} {P : T → U} {k k' : (t : T) → P t} (e : k ≡ k') (t : T) → cong {(t : T) → P t} {P t} (λ m . m t) e ≡ happly e t
cong-ev {T} {P} {k} e t = J k (λ k' e . cong {(t : T) → P t} {P t} (λ m . m t) e ≡ happly e t) refl e

hap-fext ∷ {X : U} {A : X → U} {Y : U} (f f' : {x : X} → A x → Y) (α : {x : X} (a : A x) → f a ≡ f' a) {x : X} (a : A x) →
  hap {X} {A} {Y} {f} {f'} (fext f f' α) a ≡ α a
hap-fext {X} {A} {Y} f f' α {x} a =
  let F : (x : X) → f {x} ≡ f' {x} = λ x . funext-htpy {A x} {λ _ . Y} (f {x}) (f' {x}) (λ a . α {x} a) in
  let P : (λ x . f {x}) ≡{(x : X) → A x → Y} (λ x . f' {x}) = funext-htpy {X} {λ x . A x → Y} (λ x . f {x}) (λ x . f' {x}) F in
  trans (sym (cong-comp {(x : X) → A x → Y} { {x : X} → A x → Y } {Y} (λ m . m {x} a) (impl {X} {A} {Y}) P))
  (trans (cong-comp {(x : X) → A x → Y} {A x → Y} {Y} (λ n . n a) (λ k . k x) P)
  (trans (cong {f {x} ≡ f' {x}} {f {x} a ≡ f' {x} a} (λ e . cong {A x → Y} {Y} (λ n . n a) e)
           (trans (cong-ev {X} {λ x . A x → Y} P x) (happly (happly-funext-htpy {X} {λ x . A x → Y} (λ x . f {x}) (λ x . f' {x}) F) x)))
  (trans (cong-ev {A x} {λ _ . Y} (F x) a)
         (happly (happly-funext-htpy {A x} {λ _ . Y} (f {x}) (f' {x}) (λ a . α {x} a)) a))))

--
-- Paths between cocones
--

cocone-path-J ∷ {X : U} {A B : X → U} {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  (f' : {x : X} → A x → Y) (Pf : f ≡ f') (g' : {x : X} → B x → Y) (Pg : g ≡ g')
  (h' : {x : X} (a : A x) (b : B x) → f' a ≡ g' b) →
  ({x : X} (a : A x) (b : B x) → trans (h a b) (hap {X} {B} {Y} {g} {g'} Pg b) ≡ trans (hap {X} {A} {Y} {f} {f'} Pf a) (h' a b)) →
  (f , g , h) ≡{cocone A B Y} (f' , g' , h')
cocone-path-J {X} {A} {B} {Y} f g h f' Pf =
  J { {x : X} → A x → Y } f
    (λ f' Pf . (g' : {x : X} → B x → Y) (Pg : g ≡ g') (h' : {x : X} (a : A x) (b : B x) → f' a ≡ g' b) →
      ({x : X} (a : A x) (b : B x) → trans (h a b) (hap {X} {B} {Y} {g} {g'} Pg b) ≡ trans (hap {X} {A} {Y} {f} {f'} Pf a) (h' a b)) →
      (f , g , h) ≡{cocone A B Y} (f' , g' , h'))
    (λ g' Pg . J { {x : X} → B x → Y } g
      (λ g' Pg . (h' : {x : X} (a : A x) (b : B x) → f a ≡ g' b) →
        ({x : X} (a : A x) (b : B x) → trans (h a b) (hap {X} {B} {Y} {g} {g'} Pg b) ≡ trans (hap {X} {A} {Y} {f} {f} refl a) (h' a b)) →
        (f , g , h) ≡{cocone A B Y} (f , g' , h'))
      (λ h' θ .
        cong { {x : X} (a : A x) (b : B x) → f a ≡ g b } {cocone A B Y} (λ k . (f , g , k))
          (cong {(x : X) (a : A x) (b : B x) → f {x} a ≡ g {x} b} { {x : X} (a : A x) (b : B x) → f a ≡ g b } (λ k {x} . k x)
            (funext (λ x . (a : A x) (b : B x) → f {x} a ≡ g {x} b) (λ x . h {x}) (λ x . h' {x}) (λ x .
              funext (λ a . (b : B x) → f {x} a ≡ g {x} b) (h {x}) (h' {x}) (λ a .
                funext (λ b . f {x} a ≡ g {x} b) (h {x} a) (h' {x} a) (λ b .
                  trans (θ {x} a b) (trans-refl-l (h' {x} a b))))))))
      Pg)
    Pf

-- A path of cocones from pointwise homotopies of the two maps and a coherence on the intersection
cocone-path ∷ {X : U} {A B : X → U} {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  (f' : {x : X} → A x → Y) (g' : {x : X} → B x → Y) (h' : {x : X} (a : A x) (b : B x) → f' a ≡ g' b)
  (α : {x : X} (a : A x) → f a ≡ f' a) (β : {x : X} (b : B x) → g b ≡ g' b) →
  ({x : X} (a : A x) (b : B x) → trans (h a b) (β b) ≡ trans (α a) (h' a b)) →
  (f , g , h) ≡{cocone A B Y} (f' , g' , h')
cocone-path {X} {A} {B} {Y} f g h f' g' h' α β θ =
  cocone-path-J {X} {A} {B} {Y} f g h f' (fext {X} {A} {Y} f f' α) g' (fext {X} {B} {Y} g g' β) h'
    (λ {x} a b .
      trans (cong {g {x} b ≡ g' {x} b} {f {x} a ≡ g' {x} b} (λ e . trans (h {x} a b) e) (hap-fext {X} {B} {Y} g g' β {x} b))
        (trans (θ {x} a b)
          (sym (cong {f {x} a ≡ f' {x} a} {f {x} a ≡ g' {x} b} (λ e . trans e (h' {x} a b)) (hap-fext {X} {A} {Y} f f' α {x} a)))))

--
-- First round trip: the restriction of the extension of a cocone is the cocone
--

sec-α ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  {x : X} (a : A x) → extend {X} {A} {B} pA pB {Y} f g h (inl {X} {A} {B} {x} a) ≡ f a
sec-α {X} {A} {B} pA pB {Y} f g h {x} a =
  D-α {X} {A} {B} {Y} f g h x (Z {X} {A} {B} pA pB {Y} f g h x (or-l a)) a

sec-β ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  {x : X} (b : B x) → extend {X} {A} {B} pA pB {Y} f g h (inr {X} {A} {B} {x} b) ≡ g b
sec-β {X} {A} {B} pA pB {Y} f g h {x} b =
  D-β {X} {A} {B} {Y} f g h x (Z {X} {A} {B} pA pB {Y} f g h x (or-r b)) b

-- The extension sends the glue to h: the centres at (x , or-l a) and (x , or-r b) are related by a
-- path in the descent family, which moves the B-path along the value; conclude by the coherence
-- of the first centre
sec-θ ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b)
  {x : X} (a : A x) (b : B x) →
  trans (cong (extend {X} {A} {B} pA pB {Y} f g h) (glue {X} {A} {B} {x} a b)) (sec-β {X} {A} {B} pA pB {Y} f g h {x} b)
    ≡ trans (sec-α {X} {A} {B} pA pB {Y} f g h {x} a) (h a b)
sec-θ {X} {A} {B} pA pB {Y} f g h {x} a b =
  let e : union A B → Y = extend {X} {A} {B} pA pB {Y} f g h in
  let ι : (A x) ∨ (B x) → union A B = pt {X} {A} {B} {x} in
  let ζ : (A x) ∨ (B x) → D {X} {A} {B} {Y} f g h x = Z {X} {A} {B} pA pB {Y} f g h x in
  let τ : or-l a ≡{(A x) ∨ (B x)} or-r b = prop-path (is-prop-trunc _) (or-l a) (or-r b) in
  trans
    (cong {e (ι (or-l a)) ≡ e (ι (or-r b))} {e (ι (or-l a)) ≡ g b} (λ q . trans q (sec-β {X} {A} {B} pA pB {Y} f g h {x} b))
      (trans (sym (cong-comp {(A x) ∨ (B x)} {union A B} {Y} e ι τ))
             (cong-comp {(A x) ∨ (B x)} {D {X} {A} {B} {Y} f g h x} {Y} (D-y {X} {A} {B} {Y} f g h x) ζ τ)))
    (trans (D-β-path {X} {A} {B} {Y} f g h x (ζ (or-l a)) (ζ (or-r b)) (cong ζ τ) b)
           (D-γ {X} {A} {B} {Y} f g h x (ζ (or-l a)) a b))

sec3 ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) {Y : U}
  (f : {x : X} → A x → Y) (g : {x : X} → B x → Y) (h : {x : X} (a : A x) (b : B x) → f a ≡ g b) →
  restr (extend {X} {A} {B} pA pB {Y} f g h) ≡ (f , g , h)
sec3 {X} {A} {B} pA pB {Y} f g h =
  cocone-path {X} {A} {B} {Y}
    (λ {x} a . extend {X} {A} {B} pA pB {Y} f g h (inl {X} {A} {B} {x} a))
    (λ {x} b . extend {X} {A} {B} pA pB {Y} f g h (inr {X} {A} {B} {x} b))
    (λ {x} a b . cong (extend {X} {A} {B} pA pB {Y} f g h) (glue {X} {A} {B} {x} a b))
    f g h
    (λ {x} a . sec-α {X} {A} {B} pA pB {Y} f g h {x} a)
    (λ {x} b . sec-β {X} {A} {B} pA pB {Y} f g h {x} b)
    (λ {x} a b . sec-θ {X} {A} {B} pA pB {Y} f g h {x} a b)

sec ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) (Y : U)
  (c : cocone A B Y) → restr (union-ext pA pB Y c) ≡ c
sec {X} {A} {B} pA pB Y (f , r) =
  let k : (r : Σ (g : {x : X} → B x → Y) . {x : X} (a : A x) (b : B x) → f a ≡ g b) → restr (union-ext pA pB Y (f , r)) ≡ (f , r) =
    fun (g , h) → sec3 {X} {A} {B} pA pB {Y} f g h in
  k r

--
-- Second round trip: the extension of the restriction of a map is the map
--

-- k gives a point of the descent family of its restriction: all paths live in one fibre of the
-- union, which is a proposition, so the coherence holds
ret-z ∷ {X : U} {A B : X → U} {Y : U} (k : union A B → Y) (x : X) (w : (A x) ∨ (B x)) →
  D {X} {A} {B} {Y} (λ {x} a . k (inl a)) (λ {x} b . k (inr b)) (λ {x} a b . cong k (glue {X} {A} {B} {x} a b)) x
ret-z {X} {A} {B} {Y} k x w =
  let ι : (A x) ∨ (B x) → union A B = pt {X} {A} {B} {x} in
  let τ : (w w' : (A x) ∨ (B x)) → w ≡ w' = λ w w' . prop-path (is-prop-trunc _) w w' in
  ((k (x , w) , λ a . cong k (cong ι (τ w (or-l a)))) ,
   ((λ b . cong k (cong ι (τ w (or-r b)))) ,
    λ a b .
      trans (cong {w ≡ or-r b} {k (x , w) ≡ k (x , or-r b)} (λ t . cong k (cong ι t))
              (prop-path (is-prop→is-set (is-prop-trunc _) w (or-r b))
                (τ w (or-r b)) (trans (τ w (or-l a)) (τ (or-l a) (or-r b)))))
        (trans (cong {ι w ≡ ι (or-r b)} {k (x , w) ≡ k (x , or-r b)} (λ e . cong k e)
                 (cong-trans ι (τ w (or-l a)) (τ (or-l a) (or-r b))))
          (cong-trans k (cong ι (τ w (or-l a))) (cong ι (τ (or-l a) (or-r b)))))))

ret-pw ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) (Y : U)
  (k : union A B → Y) (z : union A B) → union-ext pA pB Y (restr k) z ≡ k z
ret-pw {X} {A} {B} pA pB Y k (x , w) =
  let f : {x : X} → A x → Y = λ {x} a . k (inl a) in
  let g : {x : X} → B x → Y = λ {x} b . k (inr b) in
  let h : {x : X} (a : A x) (b : B x) → f a ≡ g b = λ {x} a b . cong k (glue {X} {A} {B} {x} a b) in
  cong (D-y {X} {A} {B} {Y} f g h x)
    (is-contr-eq (D-contr {X} {A} {B} pA pB {Y} f g h x w)
      (Z {X} {A} {B} pA pB {Y} f g h x w) (ret-z {X} {A} {B} {Y} k x w))

ret ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) (Y : U)
  (k : union A B → Y) → union-ext pA pB Y (restr k) ≡ k
ret {X} {A} {B} pA pB Y k = funext-nd (union-ext pA pB Y (restr k)) k (ret-pw pA pB Y k)

--
-- The universal property of the union
--

union-up ∷ {X : U} {A B : X → U} (pA : (x : X) → is-prop (A x)) (pB : (x : X) → is-prop (B x)) (Y : U) →
  is-equiv (restr {X} {A} {B} {Y})
union-up {X} {A} {B} pA pB Y = ((union-ext pA pB Y , sec pA pB Y) , (union-ext pA pB Y , ret pA pB Y))
