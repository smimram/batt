--
-- Function extensionality
--
-- Function extensionality follows from univalence (Voevodsky), for cartesian, oplax and lax
-- maps. Also: being an equivalence is a proposition.
--

open import Prop
open import Set
open import Function
open import Product
open import Equality
open import Contr
open import Equivalence
open import Univalence
open import Path
open import Sigma

---
--- Non-dependent function extensionality from univalence (Voevodsky)
---

funext-nd ∷ {X : U} {Y : U} (f g : X → Y) → ((x : X) → f x ≡ g x) → f ≡ g
funext-nd {X} {Y} f g h =
  let e : is-equiv (post {X} (path-src {Y})) = post-equiv path-src (is-equiv-path-src Y) X in
  -- both homotopies have source f, so they are equal
  let p : homotopy-cst f ≡ homotopy-of h = retraction-inj (post {X} path-src) (is-equiv-ret (post {X} path-src) e) {homotopy-cst f} {homotopy-of h} refl in
  cong (post {X} (path-tgt {Y})) p

---
--- Dependent function extensionality from univalence
---

-- the first projection of a family of contractible types is an equivalence
private
fst-contr-ret ∷ {X : U} (P : X → U) (c : (x : X) → is-contr (P x)) (x : X) (y : P x) → (x , center (P x) (c x)) ≡{Σ (x : X) . P x} (x , y)
fst-contr-ret {X} P c x y = cong {P x} {Σ (w : X) . P w} (fun z → (x , z)) (is-contr-eq (c x) (center (P x) (c x)) y)

is-equiv-fst-contr ∷ {X : U} (P : X → U) → ((x : X) → is-contr (P x)) → is-equiv (fst P)
is-equiv-fst-contr {X} P c =
  let s : X → Σ (x : X) . P x = fun x → (x , center (P x) (c x)) in
  ((s , fun _ → refl) , (s , fun (x , y) → fst-contr-ret P c x y))

-- weak function extensionality: a product of contractible types is contractible
is-contr-Π ∷ {X : U} (P : X → U) → ((x : X) → is-contr (P x)) → is-contr ((x : X) → P x)
is-contr-Π {X} P c =
  let F : U = fib (post {X} (fst P)) (fun x → x) in
  let s : ((x : X) → P x) → F = fun f → ((fun x → (x , f x)) , refl) in
  let r : F → (x : X) → P x = fun (g , p) → fun x → subst P (happly p x) (snd P (g x)) in
  is-contr-retract s (r , fun _ → refl) (post-contr (fst P) (is-equiv-fst-contr P c) X id)

funext ∷ {X : U} (Y : X → U) (f g : (x : X) → Y x) → ((x : X) → f x ≡ g x) → f ≡ g
funext {X} Y f g h =
  let T : U = (x : X) → Σ (y : Y x) . f x ≡ y in
  let c : is-contr T = is-contr-Π (fun x → Σ (y : Y x) . f x ≡ y) (fun x → is-contr-sing (f x)) in
  let p : (fun x → (f x , refl)) ≡{T} (fun x → (g x , h x)) = is-contr-eq c _ _ in
  cong {T} {(x : X) → Y x} (fun u x → fst _ (u x)) p

-- funext-nd {X} {Y} f g p = funext (λ_.Y) f g p

---
--- l/r versions are admissible from univalence
---

-- By path induction on the path between f and g (a direct cong (λ h . h a) p does not
-- typecheck: h and a would have to be separated by ⊗ while they are only related by ",").

happlyᵣ ∷ (A B ∷ U) → path (A →ᵣ B) → A →ᵣ path B
happlyᵣ A B (f , u) =
  let h : (Σ (g : A →ᵣ B) . f ≡ g) → A →ᵣ path B =
    λ (g , p) . J f (λ _ _ . A →ᵣ path B) (λ a . (f a , f a , refl)) p
  in
  h u

happlyₗ ∷ (A B ∷ U) → path (A →ₗ B) → A →ₗ path B
happlyₗ A B (f , u) =
  let h : (Σ (g : A →ₗ B) . f ≡ g) → A →ₗ path B =
    λ (g , p) . J f (λ _ _ . A →ₗ path B) (λ a . (f a , f a , refl)) p
  in
  h u

-- r-function extensionality in a total version, following funext-nd (Voevodsky)
funextᵣ ∷ (A B ∷ U) → (A →ᵣ path B) → path (A →ᵣ B)
funextᵣ A B H =
  let e ∷ is-equiv (postᵣ {A} (path-src {B})) = postᵣ-equiv A (path-src {B}) (is-equiv-path-src B) in
  let f : A →ᵣ B = postᵣ {A} (path-src {B}) H in
  let g : A →ᵣ B = postᵣ {A} (path-tgt {B}) H in
  -- the constant homotopy on f has the same source as H, so it is equal to H
  let Hc : A →ᵣ path B = postᵣ {A} (path-cst {B}) f in
  let p : Hc ≡ H = retraction-inj (postᵣ {A} (path-src {B})) (is-equiv-ret (postᵣ {A} (path-src {B})) e) {Hc} {H} refl in
  (f , g , cong (postᵣ {A} (path-tgt {B})) p)

-- l-function extensionality n a total version, following funext-nd (Voevodsky)
funextₗ ∷ (A B ∷ U) → (A →ₗ path B) → path (A →ₗ B)
funextₗ A B H =
  let e ∷ is-equiv (postₗ {A} (path-src {B})) = postₗ-equiv A (path-src {B}) (is-equiv-path-src B) in
  let f : A →ₗ B = postₗ {A} (path-src {B}) H in
  let g : A →ₗ B = postₗ {A} (path-tgt {B}) H in
  -- the constant homotopy on f has the same source as H, so it is equal to H
  let Hc : A →ₗ path B = postₗ {A} (path-cst {B}) f in
  let p : Hc ≡ H = retraction-inj (postₗ {A} (path-src {B})) (is-equiv-ret (postₗ {A} (path-src {B})) e) {Hc} {H} refl in
  (f , g , cong (postₗ {A} (path-tgt {B})) p)

---
--- happlyᵣ/ₗ and funextᵣ/ₗ are mutually inverse
---

-- happly preserves sources (by path induction)
happlyᵣ-src ∷ (A B ∷ U) (x : path (A →ᵣ B)) → postᵣ {A} (path-src {B}) (happlyᵣ A B x) ≡ path-src x
happlyᵣ-src A B (f , u) =
  let h : (v : Σ (g : A →ᵣ B) . f ≡ g) → postᵣ {A} (path-src {B}) (happlyᵣ A B (f , v)) ≡ f =
    fun (g , p) → J f (fun g p → postᵣ {A} (path-src {B}) (happlyᵣ A B (f , g , p)) ≡ f) refl p
  in
  h u

happlyₗ-src ∷ (A B ∷ U) (x : path (A →ₗ B)) → postₗ {A} (path-src {B}) (happlyₗ A B x) ≡ path-src x
happlyₗ-src A B (f , u) =
  let h : (v : Σ (g : A →ₗ B) . f ≡ g) → postₗ {A} (path-src {B}) (happlyₗ A B (f , v)) ≡ f =
    fun (g , p) → J f (fun g p → postₗ {A} (path-src {B}) (happlyₗ A B (f , g , p)) ≡ f) refl p
  in
  h u

-- funext preserves sources judgmentally, and taking sources is an equivalence on both sides:
-- the round trips follow by injectivity of the sources

happly-funextᵣ ∷ (A B ∷ U) (H : A →ᵣ path B) → happlyᵣ A B (funextᵣ A B H) ≡ H
happly-funextᵣ A B H =
  let e ∷ is-equiv (postᵣ {A} (path-src {B})) = postᵣ-equiv A (path-src {B}) (is-equiv-path-src B) in
  retraction-inj (postᵣ {A} (path-src {B})) (is-equiv-ret (postᵣ {A} (path-src {B})) e) (happlyᵣ-src A B (funextᵣ A B H))

happly-funextₗ ∷ (A B ∷ U) (H : A →ₗ path B) → happlyₗ A B (funextₗ A B H) ≡ H
happly-funextₗ A B H =
  let e ∷ is-equiv (postₗ {A} (path-src {B})) = postₗ-equiv A (path-src {B}) (is-equiv-path-src B) in
  retraction-inj (postₗ {A} (path-src {B})) (is-equiv-ret (postₗ {A} (path-src {B})) e) (happlyₗ-src A B (funextₗ A B H))

funext-happlyᵣ ∷ (A B ∷ U) (x : path (A →ᵣ B)) → funextᵣ A B (happlyᵣ A B x) ≡ x
funext-happlyᵣ A B x =
  retraction-inj (path-src {A →ᵣ B}) (is-equiv-ret (path-src {A →ᵣ B}) (is-equiv-path-src (A →ᵣ B)))
    {funextᵣ A B (happlyᵣ A B x)} {x} (happlyᵣ-src A B x)

funext-happlyₗ ∷ (A B ∷ U) (x : path (A →ₗ B)) → funextₗ A B (happlyₗ A B x) ≡ x
funext-happlyₗ A B x =
  retraction-inj (path-src {A →ₗ B}) (is-equiv-ret (path-src {A →ₗ B}) (is-equiv-path-src (A →ₗ B)))
    {funextₗ A B (happlyₗ A B x)} {x} (happlyₗ-src A B x)

is-equiv-happlyᵣ ∷ (A B ∷ U) → is-equiv (happlyᵣ A B)
is-equiv-happlyᵣ A B = ((funextᵣ A B , happly-funextᵣ A B) , (funextᵣ A B , funext-happlyᵣ A B))

is-equiv-happlyₗ ∷ (A B ∷ U) → is-equiv (happlyₗ A B)
is-equiv-happlyₗ A B = ((funextₗ A B , happly-funextₗ A B) , (funextₗ A B , funext-happlyₗ A B))

happlyᵣ-equiv ∷ (A B ∷ U) → path (A →ᵣ B) ≃ (A →ᵣ path B)
happlyᵣ-equiv A B = (happlyᵣ A B , is-equiv-happlyᵣ A B)

happlyₗ-equiv ∷ (A B ∷ U) → path (A →ₗ B) ≃ (A →ₗ path B)
happlyₗ-equiv A B = (happlyₗ A B , is-equiv-happlyₗ A B)

---
--- the associated fiberwise equivalences: paths between r-maps (resp. l-maps) are r-homotopies (resp. l-homotopies)
---

-- r-homotopies (oplax) from f to g: r-maps into paths, with source f and target g
Htpyᵣ ∷ (A B ∷ U) → (A →ᵣ B) → (A →ᵣ B) → U
Htpyᵣ A B f g = Σ (H : A →ᵣ path B) . (postᵣ {A} (path-src {B}) H ≡ f) × (postᵣ {A} (path-tgt {B}) H ≡ g)

-- the constant homotopy
refl-htpyᵣ ∷ (A B ∷ U) (f : A →ᵣ B) → Htpyᵣ A B f f
refl-htpyᵣ A B f = (postᵣ {A} (path-cst {B}) f , refl , refl)

-- r-homotopies out of f form a contractible type: it is a retract of a fiber of the
-- source map, which is contractible since the source map is an equivalence
is-contr-total-htpyᵣ ∷ (A B ∷ U) (f : A →ᵣ B) → is-contr (Σ (g : A →ᵣ B) . Htpyᵣ A B f g)
is-contr-total-htpyᵣ A B f =
  let T : U = Σ (g : A →ᵣ B) . Htpyᵣ A B f g in
  let Q : (g : A →ᵣ B) → (A →ᵣ path B) → U = fun g H → (postᵣ {A} (path-src {B}) H ≡ f) × (postᵣ {A} (path-tgt {B}) H ≡ g) in
  let F : U = fib (postᵣ {A} (path-src {B})) f in
  let s : T → F = fun (g , v) → (fst (Q g) v , Product.fst (snd (Q g) v)) in
  let r : F → T = fun (H , s1) → (postᵣ {A} (path-tgt {B}) H , H , s1 , refl) in
  -- contracting the free endpoint g together with t
  let k : (g : A →ᵣ B) (H : A →ᵣ path B) (w : Q g H) → r (H , Product.fst w) ≡{T} (g , H , w) =
    fun g → fun H → fun (s1 , t) → J (postᵣ {A} (path-tgt {B}) H) (fun g t → r (H , s1) ≡{T} (g , H , s1 , t)) refl t in
  let k2 : (g : A →ᵣ B) (v : Htpyᵣ A B f g) → r (s (g , v)) ≡{T} (g , v) = fun g → fun (H , w) → k g H w in
  let rs : (w : T) → r (s w) ≡ w = fun (g , v) → k2 g v in
  is-contr-retract s (r , rs) (postᵣ-contr A (path-src {B}) (is-equiv-path-src B) f)

-- the fiberwise map: transport of the constant homotopy
happlyᵣ-fib ∷ (A B ∷ U) (f g : A →ᵣ B) → f ≡ g → Htpyᵣ A B f g
happlyᵣ-fib A B f g = fund-id-map (Htpyᵣ A B f) f (refl-htpyᵣ A B f) g

-- it is an equivalence (fundamental theorem of identity types)
is-equiv-happlyᵣ-fib ∷ (A B ∷ U) (f g : A →ᵣ B) → is-equiv (happlyᵣ-fib A B f g)
is-equiv-happlyᵣ-fib A B f g = fund-id (Htpyᵣ A B f) f (refl-htpyᵣ A B f) (is-contr-total-htpyᵣ A B f) g

htpyᵣ-equiv ∷ (A B ∷ U) (f g : A →ᵣ B) → (f ≡ g) ≃ Htpyᵣ A B f g
htpyᵣ-equiv A B f g = (happlyᵣ-fib A B f g , is-equiv-happlyᵣ-fib A B f g)

-- an oplax homotopy gives a path between its source and its target maps
htpyᵣ→path ∷ (A B ∷ U) (H : A →ᵣ path B) → postᵣ {A} (path-src {B}) H ≡ postᵣ {A} (path-tgt {B}) H
htpyᵣ→path A B H =
  let f : A →ᵣ B = postᵣ {A} (path-src {B}) H in
  let g : A →ᵣ B = postᵣ {A} (path-tgt {B}) H in
  section-map (happlyᵣ-fib A B f g) (is-equiv-sec (happlyᵣ-fib A B f g) (is-equiv-happlyᵣ-fib A B f g)) (H , refl , refl)

-- the homotopy underlying the fiberwise equivalence is happlyᵣ
happlyᵣ-fib-happlyᵣ ∷ (A B ∷ U) (f g : A →ᵣ B) (p : f ≡ g) →
  fst (fun H → (postᵣ {A} (path-src {B}) H ≡ f) × (postᵣ {A} (path-tgt {B}) H ≡ g)) (happlyᵣ-fib A B f g p) ≡ happlyᵣ A B (f , g , p)
happlyᵣ-fib-happlyᵣ A B f g p =
  J f (fun g p → fst (fun H → (postᵣ {A} (path-src {B}) H ≡ f) × (postᵣ {A} (path-tgt {B}) H ≡ g)) (happlyᵣ-fib A B f g p) ≡ happlyᵣ A B (f , g , p)) refl p
  
-- l-homotopies (lax) from f to g: l-maps into paths, with source f and target g
Htpyₗ ∷ (A B ∷ U) → (A →ₗ B) → (A →ₗ B) → U
Htpyₗ A B f g = Σ (H : A →ₗ path B) . (postₗ {A} (path-src {B}) H ≡ f) × (postₗ {A} (path-tgt {B}) H ≡ g)

-- the constant homotopy
refl-htpyₗ ∷ (A B ∷ U) (f : A →ₗ B) → Htpyₗ A B f f
refl-htpyₗ A B f = (postₗ {A} (path-cst {B}) f , refl , refl)

-- l-homotopies out of f form a contractible type: it is a retract of a fiber of the
-- source map, which is contractible since the source map is an equivalence
is-contr-total-htpyₗ ∷ (A B ∷ U) (f : A →ₗ B) → is-contr (Σ (g : A →ₗ B) . Htpyₗ A B f g)
is-contr-total-htpyₗ A B f =
  let T : U = Σ (g : A →ₗ B) . Htpyₗ A B f g in
  let Q : (g : A →ₗ B) → (A →ₗ path B) → U = fun g H → (postₗ {A} (path-src {B}) H ≡ f) × (postₗ {A} (path-tgt {B}) H ≡ g) in
  let F : U = fib (postₗ {A} (path-src {B})) f in
  let s : T → F = fun (g , v) → (fst (Q g) v , Product.fst (snd (Q g) v)) in
  let r : F → T = fun (H , s1) → (postₗ {A} (path-tgt {B}) H , H , s1 , refl) in
  -- contracting the free endpoint g together with t
  let k : (g : A →ₗ B) (H : A →ₗ path B) (w : Q g H) → r (H , Product.fst w) ≡{T} (g , H , w) =
    fun g → fun H → fun (s1 , t) → J (postₗ {A} (path-tgt {B}) H) (fun g t → r (H , s1) ≡{T} (g , H , s1 , t)) refl t in
  let k2 : (g : A →ₗ B) (v : Htpyₗ A B f g) → r (s (g , v)) ≡{T} (g , v) = fun g → fun (H , w) → k g H w in
  let rs : (w : T) → r (s w) ≡ w = fun (g , v) → k2 g v in
  is-contr-retract s (r , rs) (postₗ-contr A (path-src {B}) (is-equiv-path-src B) f)

-- the fiberwise map: transport of the constant homotopy
happlyₗ-fib ∷ (A B ∷ U) (f g : A →ₗ B) → f ≡ g → Htpyₗ A B f g
happlyₗ-fib A B f g = fund-id-map (Htpyₗ A B f) f (refl-htpyₗ A B f) g

-- it is an equivalence (fundamental theorem of identity types)
is-equiv-happlyₗ-fib ∷ (A B ∷ U) (f g : A →ₗ B) → is-equiv (happlyₗ-fib A B f g)
is-equiv-happlyₗ-fib A B f g = fund-id (Htpyₗ A B f) f (refl-htpyₗ A B f) (is-contr-total-htpyₗ A B f) g

htpyₗ-equiv ∷ (A B ∷ U) (f g : A →ₗ B) → (f ≡ g) ≃ Htpyₗ A B f g
htpyₗ-equiv A B f g = (happlyₗ-fib A B f g , is-equiv-happlyₗ-fib A B f g)

-- the homotopy underlying the fiberwise equivalence is happlyₗ
happlyₗ-fib-happlyₗ ∷ (A B ∷ U) (f g : A →ₗ B) (p : f ≡ g) →
  fst (fun H → (postₗ {A} (path-src {B}) H ≡ f) × (postₗ {A} (path-tgt {B}) H ≡ g)) (happlyₗ-fib A B f g p) ≡ happlyₗ A B (f , g , p)
happlyₗ-fib-happlyₗ A B f g p =
  J f (fun g p → fst (fun H → (postₗ {A} (path-src {B}) H ≡ f) × (postₗ {A} (path-tgt {B}) H ≡ g)) (happlyₗ-fib A B f g p) ≡ happlyₗ A B (f , g , p)) refl p

---
--- Π-types of propositions; fibrewise (dependent) function extensionality
---

-- Funext
is-prop-Π ∷ {A : U} (P : A → U) → ((x : A) → is-prop (P x)) → is-prop ((x : A) → P x)
is-prop-Π {A} P pP = prop-from-paths (λ f g . funext P f g (λ x . prop-path (pP x) (f x) (g x)))

-- variant for implicit arguments, as a retract of the explicit one
is-prop-Π-impl ∷ {A : U} (P : A → U) → ((x : A) → is-prop (P x)) → is-prop ({x : A} → P x)
is-prop-Π-impl {A} P pP =
  is-prop-retract {{x : A} → P x} {(x : A) → P x} (λ f x . f {x}) (λ g {x} . g x) (λ f . refl) (is-prop-Π P pP)

is-prop-is-contr ∷ (A : U) → is-prop (is-contr A)
is-prop-is-contr A =
  let P : A → U = λ a . (x : A) → a ≡ x in
  prop-from-paths (λ c c' .
    let h : (c c' : is-contr A) → c ≡ c' = fun (a , κ) (a' , κ') →
      let pA : is-prop A = is-contr→is-prop {A} (a , κ) in
      subtype-path P (λ b . is-prop-Π (λ x . b ≡ x) (λ x . is-prop→is-set pA b x)) (κ a') κ κ'
    in h c c')

-- a Π over a contractible type T inside a Σ can be evaluated at the center
contr-Π-in-Σ ∷ {S T : U} (P : S → T → U) (t0 : T) → ((t : T) → t0 ≡ t) → is-contr (Σ (x : S) . P x t0) → is-contr (Σ (x : S) . (t : T) → P x t)
contr-Π-in-Σ {S} {T} P t0 κ c =
  let apd : (x : S) (h : (t : T) → P x t) (t : T) (e : t0 ≡ t) → subst (P x) e (h t0) ≡ h t =
    λ x h t e . J t0 (λ t e . subst (P x) e (h t0) ≡ h t) refl e in
  let s : (Σ (x : S) . (t : T) → P x t) → Σ (x : S) . P x t0 = λ (x , h) . (x , h t0) in
  let r : (Σ (x : S) . P x t0) → Σ (x : S) . (t : T) → P x t = λ (x , p) . (x , λ t . subst (P x) (κ t) p) in
  let rs : (w : Σ (x : S) . (t : T) → P x t) → r (s w) ≡ w = λ (x , h) .
    cong {(t : T) → P x t} {Σ (x : S) . (t : T) → P x t} (λ z . (x , z))
      (funext (P x) (λ t . subst (P x) (κ t) (h t0)) h (λ t . apd x h t (κ t))) in
  is-contr-retract s (r , rs) c

is-contr-total-htpy ∷ {A : U} {B : A → U} (f : (x : A) → B x) → is-contr (Σ (g : (x : A) → B x) . (x : A) → f x ≡ g x)
is-contr-total-htpy {A} {B} f =
  let T : U = Σ (g : (x : A) → B x) . (x : A) → f x ≡ g x in
  let S : U = (x : A) → Σ (y : B x) . f x ≡ y in
  let s : T → S = λ (g , h) . λ x . (g x , h x) in
  let r : S → T = λ u . ((λ x . fst (λ y . f x ≡ y) (u x)) , (λ x . snd (λ y . f x ≡ y) (u x))) in
  let rs : (w : T) → r (s w) ≡ w = λ (g , h) . refl in
  is-contr-retract s (r , rs) (is-contr-Π (λ x . Σ (y : B x) . f x ≡ y) (λ x . is-contr-sing (f x)))

happly-fib ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → f ≡ g → (x : A) → f x ≡ g x
happly-fib {A} {B} f g = fund-id-map {(x : A) → B x} (λ g . (x : A) → f x ≡ g x) f (λ x . refl) g

happly-fib-happly ∷ {A : U} {B : A → U} (f g : (x : A) → B x) (p : f ≡ g) → happly-fib {A} {B} f g p ≡ happly p
happly-fib-happly {A} {B} f g p = J f (λ g p . happly-fib {A} {B} f g p ≡ happly p) refl p

is-equiv-happly ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → is-equiv (happly {A} {B} {f} {g})
is-equiv-happly {A} {B} f g =
  is-equiv-htpy {f ≡ g} {(x : A) → f x ≡ g x} {happly-fib {A} {B} f g} {happly {A} {B} {f} {g}} (happly-fib-happly {A} {B} f g)
    (fund-id {(x : A) → B x} (λ g . (x : A) → f x ≡ g x) f (λ x . refl) (is-contr-total-htpy {A} {B} f) g)

-- fibrewise function extensionality, with its computation rule
funext-htpy ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → ((x : A) → f x ≡ g x) → f ≡ g
funext-htpy {A} {B} f g = section-map (happly {A} {B} {f} {g}) (is-equiv-sec (happly {A} {B} {f} {g}) (is-equiv-happly {A} {B} f g))

happly-funext-htpy ∷ {A : U} {B : A → U} (f g : (x : A) → B x) (h : (x : A) → f x ≡ g x) → happly (funext-htpy {A} {B} f g h) ≡ h
happly-funext-htpy {A} {B} f g =
  snd (is-section (happly {A} {B} {f} {g})) (is-equiv-sec (happly {A} {B} {f} {g}) (is-equiv-happly {A} {B} f g))

---
--- precomposition with a crisp equivalence is an equivalence, for oplax and lax maps
---

preᵣ-equiv ∷ (A B ∷ U) (f ∷ A → B) (e ∷ is-equiv f) (X ∷ U) → is-equiv {B →ᵣ X} {A →ᵣ X} (λ φ . preᵣ {A} {B} {X} φ f)
preᵣ-equiv A B f e X =
  let s ∷ B → A = section-map f (is-equiv-sec f e) in
  let r ∷ B → A = retraction-map f (is-equiv-ret f e) in
  let fs ∷ (λ b . f (s b)) ≡{B → B} (λ b . b) =
    funext-nd (λ b . f (s b)) (λ b . b) (snd (is-section f) (is-equiv-sec f e)) in
  let rf ∷ (λ a . r (f a)) ≡{A → A} (λ a . a) =
    funext-nd (λ a . r (f a)) (λ a . a) (snd (is-retraction f) (is-equiv-ret f e)) in
  (((λ ψ . preᵣ {B} {A} {X} ψ r) , (λ ψ . preᵣ-path A {A} {X} {λ a . r (f a)} {λ a . a} rf ψ)) ,
   ((λ ψ . preᵣ {B} {A} {X} ψ s) , (λ φ . preᵣ-path B {B} {X} {λ b . f (s b)} {λ b . b} fs φ)))

preₗ-equiv ∷ (A B ∷ U) (f ∷ A → B) (e ∷ is-equiv f) (X ∷ U) → is-equiv {B →ₗ X} {A →ₗ X} (λ φ . preₗ {A} {B} {X} φ f)
preₗ-equiv A B f e X =
  let s ∷ B → A = section-map f (is-equiv-sec f e) in
  let r ∷ B → A = retraction-map f (is-equiv-ret f e) in
  let fs ∷ (λ b . f (s b)) ≡{B → B} (λ b . b) =
    funext-nd (λ b . f (s b)) (λ b . b) (snd (is-section f) (is-equiv-sec f e)) in
  let rf ∷ (λ a . r (f a)) ≡{A → A} (λ a . a) =
    funext-nd (λ a . r (f a)) (λ a . a) (snd (is-retraction f) (is-equiv-ret f e)) in
  (((λ ψ . preₗ {B} {A} {X} ψ r) , (λ ψ . preₗ-path A {A} {X} {λ a . r (f a)} {λ a . a} rf ψ)) ,
   ((λ ψ . preₗ {B} {A} {X} ψ s) , (λ φ . preₗ-path B {B} {X} {λ b . f (s b)} {λ b . b} fs φ)))

---
--- Being an equivalence is a proposition
---

-- the type of maps g with a homotopy g ~ id is contractible
is-contr-htpy-id ∷ (A : U) → is-contr (Σ (g : A → A) . (x : A) → g x ≡ x)
is-contr-htpy-id A =
  let T : U = Σ (g : A → A) . (x : A) → g x ≡ x in
  let S : U = (x : A) → Σ (y : A) . y ≡ x in
  let s : T → S = λ (g , h) . λ x . (g x , h x) in
  let r : S → T = λ u . ((λ x . fst (λ y . y ≡ x) (u x)) , (λ x . snd (λ y . y ≡ x) (u x))) in
  let rs : (w : T) → r (s w) ≡ w = λ (g , h) . refl in
  is-contr-retract s (r , rs) (is-contr-Π (λ x . Σ (y : A) . y ≡ x) (λ x . is-contr-sing' x))

is-contr-is-equiv-eq ∷ {A B : U} (P : A ≡ B) → is-contr (is-equiv (map-equiv (equiv-eq P)))
is-contr-is-equiv-eq {A} refl = is-contr-prod (is-contr-htpy-id A) (is-contr-htpy-id A)

is-contr-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → is-contr (is-equiv f)
is-contr-is-equiv {A} {B} f e =
  let k : section (equiv-eq {A} {B}) → is-contr (is-equiv f) = fun (ua , uae) →
    subst {A → B} (fun g → is-contr (is-equiv g)) (cong map-equiv (uae (f , e))) (is-contr-is-equiv-eq (ua (f , e)))
  in
  k (is-equiv-sec equiv-eq (univalence A B))

is-prop-is-equiv ∷ {A B : U} (f : A → B) → is-prop (is-equiv f)
is-prop-is-equiv f e e' = is-contr→is-prop (is-contr-is-equiv f e) e e'

-- funext-htpy is also a retraction of happly
funext-htpy-happly ∷ {A : U} {B : A → U} {f g : (x : A) → B x} (p : f ≡ g) → funext-htpy {A} {B} f g (happly {A} {B} {f} {g} p) ≡ p
funext-htpy-happly {A} {B} {f} {g} p =
  retraction-inj (happly {A} {B} {f} {g}) (is-equiv-ret (happly {A} {B} {f} {g}) (is-equiv-happly {A} {B} f g))
    (happly-funext-htpy {A} {B} f g (happly {A} {B} {f} {g} p))

-- evaluating the image of a path of functions under postcomposition
happly-cong-post ∷ {Z X Y : U} (f : X → Y) {G G' : Z → X} (P : G ≡ G') (z : Z) →
  happly {Z} {λ _ . Y} {post {Z} {X} {Y} f G} {post {Z} {X} {Y} f G'} (cong (post {Z} {X} {Y} f) P) z ≡ cong f (happly {Z} {λ _ . X} {G} {G'} P z)
happly-cong-post {Z} {X} {Y} f {G} refl z = refl

-- postcomposition of a funext path is the funext of the pointwise images
cong-post-funext ∷ {Z X Y : U} (f : X → Y) (G G' : Z → X) (h : (z : Z) → G z ≡ G' z) →
  cong (post {Z} {X} {Y} f) (funext-htpy {Z} {λ _ . X} G G' h)
    ≡ funext-htpy {Z} {λ _ . Y} (post {Z} {X} {Y} f G) (post {Z} {X} {Y} f G') (λ z . cong f (h z))
cong-post-funext {Z} {X} {Y} f G G' h =
  let fG : Z → Y = post {Z} {X} {Y} f G in
  let fG' : Z → Y = post {Z} {X} {Y} f G' in
  let ha : (fG ≡ fG') → (z : Z) → fG z ≡ fG' z = happly {Z} {λ _ . Y} {fG} {fG'} in
  let P : G ≡ G' = funext-htpy {Z} {λ _ . X} G G' h in
  retraction-inj ha (is-equiv-ret ha (is-equiv-happly {Z} {λ _ . Y} fG fG'))
    (trans (funext-htpy {Z} {λ z . fG z ≡ fG' z} (ha (cong (post {Z} {X} {Y} f) P)) (λ z . cong f (h z))
              (λ z . trans (happly-cong-post {Z} {X} {Y} f {G} {G'} P z)
                       (cong {G z ≡ G' z} {fG z ≡ fG' z} (cong f) (happly {Z} {λ z' . G z' ≡ G' z'} {happly {Z} {λ _ . X} {G} {G'} P} {h} (happly-funext-htpy {Z} {λ _ . X} G G' h) z))))
      (sym (happly-funext-htpy {Z} {λ _ . Y} fG fG' (λ z . cong f (h z)))))

-- funext-htpy is an equivalence (its inverse is happly)
is-equiv-funext-htpy ∷ {A : U} {B : A → U} (f g : (x : A) → B x) → is-equiv (funext-htpy {A} {B} f g)
is-equiv-funext-htpy {A} {B} f g =
  ((happly {A} {B} {f} {g} , funext-htpy-happly {A} {B} {f} {g}) ,
   (happly {A} {B} {f} {g} , happly-funext-htpy {A} {B} f g))

-- the homotopy of the image of a path of functions, by postcomposition along an oplax map
happlyᵣ-fib-cong-postᵣ ∷ {A S B ∷ U} (c : A →ᵣ S) {φ0 φ1 : S → B} (G' : φ0 ≡ φ1) →
  happlyᵣ-fib A B (postᵣ {A} {S} {B} φ0 c) (postᵣ {A} {S} {B} φ1 c) (cong (λ φ . postᵣ {A} {S} {B} φ c) G')
    ≡ ((λ k . (φ0 (c k) , φ1 (c k) , happly {S} {λ _ . B} G' (c k))) , refl , refl)
happlyᵣ-fib-cong-postᵣ {A} {S} {B} c {φ0} {φ1} G' =
  J φ0 (λ φ' G'' . happlyᵣ-fib A B (postᵣ {A} {S} {B} φ0 c) (postᵣ {A} {S} {B} φ' c) (cong (λ φ . postᵣ {A} {S} {B} φ c) G'')
                     ≡ ((λ k . (φ0 (c k) , φ' (c k) , happly {S} {λ _ . B} G'' (c k))) , refl , refl)) refl G'
