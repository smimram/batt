open import Function
open import Product
open import Equality
open import Contr
open import Equivalence
open import Univalence

-- Function extensionality follows from univalence

---
--- Non-dependent function extensionality from univalence (Voevodsky)
---

-- free paths
Path ∷ U → U
Path A = Σ (x : A) . Σ (y : A) . x ≡ y

Path-src ∷ {A : U} → Path A → A
Path-src (x , _) = x

Path-tgt ∷ {A : U} → Path A → A
Path-tgt {A} (x , q) = fst _ q

Path-of ∷ {A : U} {x y : A} → x ≡ y → Path A
Path-of {A} {x} {y} p = (x , y , p)

Path-cst ∷ {A : U} → A → Path A
Path-cst x = (x , x , refl)

Path-cst-src' ∷ {A : U} (x : A) (q : Σ (y : A) . x ≡ y) → Path-cst x ≡ (x , q)
Path-cst-src' x (y , p) = J x (fun y p → Path-cst x ≡ (x , y , p)) refl p

Path-cst-src ∷ {A : U} (p : Path A) → Path-cst (Path-src p) ≡ p
Path-cst-src (x , q) = Path-cst-src' x q

-- the space of free paths is equivalent to the base
is-equiv-Path-src ∷ (A : U) → is-equiv (Path-src {A})
is-equiv-Path-src A = ((Path-cst , fun x → refl) , (Path-cst , Path-cst-src))

-- postcomposition
post ∷ {A B : U} (X : U) → (A → B) → (X → A) → (X → B)
post X f h = fun x → f (h x)

post-equiv-eq ∷ {A B : U} (P : A ≡ B) (X : U) → is-equiv (post X (map-equiv (equiv-eq P)))
post-equiv-eq {A} refl X = is-equiv-id (X → A)

-- by univalence, postcomposition with an equivalence is an equivalence
post-equiv ∷ {A B : U} (f : A → B) → is-equiv f → (X : U) → is-equiv (post X f)
post-equiv {A} {B} f e X =
  let k : section (equiv-eq {A} {B}) → is-equiv (post X f) = fun (ua , uae) →
    subst {A → B} (fun g → is-equiv (post X g)) (cong map-equiv (uae (f , e))) (post-equiv-eq (ua (f , e)) X)
  in
  k (section-is-equiv equiv-eq (univalence A B))

-- maps with a retraction are injective
retraction-inj ∷ {A B : U} (f : A → B) → retraction f → {x y : A} → f x ≡ f y → x ≡ y
retraction-inj f (r , rr) {x} {y} p = trans (sym (rr x)) (trans (cong r p) (rr y))

-- homotopies as maps to free paths
Homotopy-of ∷ {A B : U} {f g : A → B} → ((x : A) → f x ≡ g x) → A → Path B
Homotopy-of {A} {B} {f} {g} h x = Path-of (h x)

Homotopy-cst ∷ {A B : U} → (A → B) → A → Path B
Homotopy-cst f x = Path-cst (f x)

funext-nd ∷ {X : U} {Y : U} (f g : X → Y) → ((x : X) → f x ≡ g x) → f ≡ g
funext-nd {X} {Y} f g h =
  let e : is-equiv (post X (Path-src {Y})) = post-equiv Path-src (is-equiv-Path-src Y) X in
  -- both homotopies have source f, so they are equal
  let p : Homotopy-cst f ≡ Homotopy-of h = retraction-inj (post X Path-src) (retraction-is-equiv (post X Path-src) e) {Homotopy-cst f} {Homotopy-of h} refl in
  cong (post X (Path-tgt {Y})) p

---
--- Dependent function extensionality from univalence
---

-- singletons are contractible
is-contr-sing ∷ {A : U} (x : A) → is-contr (Σ (y : A) . x ≡ y)
is-contr-sing {A} x = ((x , refl) , fun (y , p) → J x (fun y p → (x , refl) ≡{Σ (y : A) . x ≡ y} (y , p)) refl p)

is-contr-sing' ∷ {A : U} (y : A) → is-contr (Σ (x : A) . x ≡ y)
is-contr-sing' {A} y = ((y , refl) , fun (x , p) → J' (fun x y p → (y , refl) ≡{Σ (x : A) . x ≡ y} (x , p)) (fun x → refl) p)

-- equality in contractible types
is-contr-eq ∷ {A : U} → is-contr A → (x y : A) → x ≡ y
is-contr-eq (a , p) x y = trans (sym (p x)) (p y)

-- a retract of a contractible type is contractible
is-contr-retract ∷ {A B : U} (s : A → B) (r : B → A) → ((x : A) → r (s x) ≡ x) → is-contr B → is-contr A
is-contr-retract s r rs (b , p) = (r b , fun x → trans (cong r (p (s x))) (rs x))

-- fibers
fib ∷ {A B : U} → (A → B) → B → U
fib {A} f y = Σ (x : A) . f x ≡ y

is-contr-map ∷ {A B : U} → (A → B) → U
is-contr-map {A} {B} f = (y : B) → is-contr (fib f y)

post-contr-eq ∷ {A B : U} (P : A ≡ B) (X : U) → is-contr-map (post X (map-equiv (equiv-eq P)))
post-contr-eq {A} refl X = fun y → is-contr-sing' y

-- by univalence, postcomposition with an equivalence has contractible fibers
post-contr ∷ {A B : U} (f : A → B) → is-equiv f → (X : U) → is-contr-map (post X f)
post-contr {A} {B} f e X =
  let k : section (equiv-eq {A} {B}) → is-contr-map (post X f) = fun (ua , uae) →
    subst {A → B} (fun g → is-contr-map (post X g)) (cong map-equiv (uae (f , e))) (post-contr-eq (ua (f , e)) X)
  in
  k (section-is-equiv equiv-eq (univalence A B))

-- the first projection of a family of contractible types is an equivalence
fst-contr-ret ∷ {X : U} (P : X → U) (c : (x : X) → is-contr (P x)) (x : X) (y : P x) → (x , center (P x) (c x)) ≡{Σ (x : X) . P x} (x , y)
fst-contr-ret {X} P c x y = cong {P x} {Σ (w : X) . P w} (fun z → (x , z)) (is-contr-eq (c x) (center (P x) (c x)) y)

is-equiv-fst-contr ∷ {X : U} (P : X → U) → ((x : X) → is-contr (P x)) → is-equiv (fst P)
is-equiv-fst-contr {X} P c =
  let s : X → Σ (x : X) . P x = fun x → (x , center (P x) (c x)) in
  ((s , fun x → refl) , (s , fun (x , y) → fst-contr-ret P c x y))

-- weak function extensionality: a product of contractible types is contractible
is-contr-Π ∷ {X : U} (P : X → U) → ((x : X) → is-contr (P x)) → is-contr ((x : X) → P x)
is-contr-Π {X} P c =
  let F : U = fib (post X (fst P)) (fun x → x) in
  let s : ((x : X) → P x) → F = fun f → ((fun x → (x , f x)) , refl) in
  let r : F → (x : X) → P x = fun (g , p) → fun x → subst P (happly p x) (snd P (g x)) in
  is-contr-retract s r (fun f → refl) (post-contr (fst P) (is-equiv-fst-contr P c) X (fun x → x))

funext ∷ {X : U} (Y : X → U) (f g : (x : X) → Y x) → ((x : X) → f x ≡ g x) → f ≡ g
funext {X} Y f g h =
  let T : U = (x : X) → Σ (y : Y x) . f x ≡ y in
  let c : is-contr T = is-contr-Π (fun x → Σ (y : Y x) . f x ≡ y) (fun x → is-contr-sing (f x)) in
  let p : (fun x → (f x , refl)) ≡{T} (fun x → (g x , h x)) = is-contr-eq c _ _ in
  cong {T} {(x : X) → Y x} (fun u x → fst _ (u x)) p
