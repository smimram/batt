--
-- Propositional truncation (postulated)
--

open import Prop

postulate trunc ∷ U → U
postulate is-prop-trunc ∷ (X : U) → is-prop (‖ X ‖)

prop-trunc ∷ U → hProp
prop-trunc X = (‖ X ‖ , is-prop-trunc X)

postulate unit ∷ {X : U} → X → ‖ X ‖
postulate ind ∷ {X : U} (P : ‖ X ‖ → hProp) → ((x : X) → ⟨ P (unit x) ⟩) → (u : ‖ X ‖) → ⟨ P u ⟩
postulate ind-unit ∷ {X : U} (P : ‖ X ‖ → hProp) → (f : (x : X) → ⟨ P (unit x) ⟩) → (x : X) → ind P f (unit x) ≡ f x

rec ∷ {X : U} (P : hProp) → (X → ⟨ P ⟩) → ‖ X ‖ → ⟨ P ⟩
rec P = ind (λ_.P)

rec-unit ∷ {X : U} (P : hProp) (f : X → ⟨ P ⟩) (x : X) → rec P f (unit x) ≡ f x
rec-unit P = ind-unit (λ_.P)

rec' ∷ {X Y : U} → is-prop Y → (X → Y) → (‖ X ‖ → Y)
rec' {X} {Y} p = ind (λ_.(Y,p))

rec-unit' ∷ {X Y : U} (p : is-prop Y) (f : X → Y) (x : X) → rec' p f (unit x) ≡ f x
rec-unit' {X} {Y} p = ind-unit (λ_.(Y,p))

or ∷ Type → Type → Type
or A B = ‖ A + B ‖
