--
-- The unit type ⊤
--

t = ⊤

ind ∷ (A ∷ ⊤ → U) → A tt → (x : ⊤) → A x
ind A a tt = a

recₗ ∷ {A ∷ U} → A → ⊤ →ₗ A
recₗ a tt = a

recᵣ ∷ {A ∷ U} → A → ⊤ →ᵣ A
recᵣ a tt = a

-- terminal arrow
terminal ∷ (A : U) → A → ⊤
terminal A x = tt

---
--- Functions out of the unit type
---

open import Funext
open import Sigma

unit→-equiv ∷ {A ∷ U} → (⊤ → A) ≃ A
unit→-equiv {A} = iso→equiv {⊤ → A} {A} (λ f . f tt) (λ a _ . a) (λ a . refl) (λ f . funext-nd (λ _ . f tt) f (λ tt . refl))

terminal-equiv ∷ {A : U} → (A → ⊤) ≃ ⊤
terminal-equiv {A} = iso→equiv {A → ⊤} {⊤} (λ _ . tt) (λ _ _ . tt) (λ tt . refl) (λ f . funext-nd (λ _ . tt) f (λ a . ind (λ y . tt ≡ y) refl (f a)))

terminal-equivₗ ∷ {A ∷ U} → (A →ₗ ⊤) ≃ ⊤
terminal-equivₗ {A} = iso→equiv {A →ₗ ⊤} {⊤} (λ _ . tt) (λ _ _ . tt) (λ tt . refl) (λ f . snd _ (snd _ (funextₗ A ⊤ (λ a . (tt , f a , ind (λ y . tt ≡ y) refl (f a))))))

terminal-equivᵣ ∷ {A ∷ U} → (A →ᵣ ⊤) ≃ ⊤
terminal-equivᵣ {A} = iso→equiv {A ⇁ ⊤} {⊤} (λ _ . tt) (λ _ _ . tt) (λ tt . refl) (λ f . snd _ (snd _ (funextᵣ A ⊤ (λ a . (tt , f a , ind (λ y . tt ≡ y) refl (f a))))))

---
--- The unit type is a proposition
---

open import Prop

is-contr-unit ∷ is-contr ⊤
is-contr-unit = (tt , λ tt . refl)

is-prop-unit ∷ is-prop ⊤
is-prop-unit = is-contr→is-prop is-contr-unit

open import Set

is-set-unit ∷ is-set ⊤
is-set-unit = is-prop→is-set is-prop-unit

-- oplax maps into ⊤ are constant
terminalᵣ-path ∷ (K ∷ U) (v : K →ᵣ ⊤) → (λ _ . tt) ≡{K →ᵣ ⊤} v
terminalᵣ-path K v =
  let t : (K →ᵣ ⊤) → ⊤ = λ _ . tt in
  retraction-inj t (is-equiv-ret t (snd _ (terminal-equivᵣ {K}))) {λ _ . tt} {v} refl
