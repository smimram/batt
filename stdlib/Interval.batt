open import Set
open import Empty
open import Logic
open import Product

postulate is-set-𝕀 ∷ is-set 𝕀

-- This one is not provable as for now (we have the trivial model for the
-- interval). It might become the case if we assume some form of directed
-- univalence.
postulate neq-𝕀0-𝕀1 ∷ ¬ (𝕀0 ≡ 𝕀1)

boundary-inclusion ∷ bool → 𝕀
boundary-inclusion false = 𝕀0
boundary-inclusion true  = 𝕀1

leq ∷ 𝕀 → 𝕀 → Type
leq i j = i 𝕀∨ j ≡ j

geq ∷ 𝕀 → 𝕀 → Type
geq i j = i 𝕀∨ j ≡ i

