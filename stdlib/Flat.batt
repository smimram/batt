open import Tensor
open import Empty
open import Unit
open import Bool
open import Equality

flat :: ♭U → U
flat 𝄫A = A

unflatten :: {A :: U} → ♭A → A
unflatten 𝄫x = x
-- unflatten A = ♭_ind(x, x)
-- unflatten = fun A a → let♭ x = a in x

