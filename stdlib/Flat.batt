--
-- The flat modality ♭
--
-- Following Shulman, Brouwer's fixed-point theorem in real-cohesive homotopy type theory
-- (https://arxiv.org/abs/1509.07584v3): discreteness, and the interaction of ♭ with tensors
-- and with cartesian, oplax and lax function types.
--

import Tensor
open import Empty
open import Unit
open import Bool
open import Equality
open import Equivalence

flat ∷ ♭U → U
flat 𝄫A = A

unflatten ∷ {A ∷ U} → ♭A → A
unflatten 𝄫x = x
-- unflatten A = ♭_ind(x, x)
-- unflatten = fun A a → let♭ x = a in x

-- unflatten : (A : U) → ♭A → A
-- unflatten = fun A → ♭_ind(A,♭_ind(x, x)) 𝄫A

-- unflatten : (A : ♭U) → ♭A → A
-- unflatten = ♭_ind(A,♭_ind(x, x))

-- TODO: this should work!
-- unflatten' : (A : ♭Type) → let f : ♭Type → Type = λ 𝄫B → (♭B → B) in f A
-- unflatten' A 𝄫x = x

-- unflatten' : (A : ♭Type) → flat A → unflatten U A
-- unflatten' A 𝄫x = x

-- should not work
-- flatten : (A ∷ U) → A → ♭A
-- flatten = fun A → fun a → 𝄫a

--- Formalizing Shulman 2017 ( https://arxiv.org/abs/1509.07584v3 )

flat-eta ∷ {A ∷ Type} (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → C x
flat-eta C f 𝄫x = f 𝄫x

-- Lemma 4.4
flat-unique ∷ {A ∷ Type} (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → flat-eta C f x ≡ f x
flat-unique C f 𝄫x = refl

-- TODO: dependent version?
flat-map ∷ {A B ∷ Type} (f ∷ A → B) → ♭A → ♭B
flat-map f 𝄫a = 𝄫(f a)

crispify-empty ∷ ⊥ → ♭⊥
crispify-empty ()

is-section-crispify-empty ∷ (t : ⊥) → unflatten (crispify-empty t) ≡ t
is-section-crispify-empty ()

crispify-unit ∷ ⊤ → ♭⊤
crispify-unit tt = 𝄫tt

is-section-crispify-unit ∷ (t : ⊤) → unflatten (crispify-unit t) ≡ t
is-section-crispify-unit tt = refl

crispify-bool ∷ Bool → ♭Bool
crispify-bool false = 𝄫false
crispify-bool true  = 𝄫true

is-section-crispify-bool ∷ (b : Bool) → unflatten (crispify-bool b) ≡ b
is-section-crispify-bool = Bool.ind (λb. unflatten (crispify-bool b) ≡ b) refl refl

---
--- Discreteness
---

open import Funext

-- Theorem 6.1
flat-code ∷ {A ∷ U} → ♭A → ♭A → U
flat-code {A} = fun 𝄫x → fun 𝄫y → ♭(x ≡ y)

flat-refl ∷ {A ∷ U} (u : ♭A) → flat-code u u
flat-refl {A} = fun 𝄫x → 𝄫refl

-- transporting flat-refl along the path
flat-encode ∷ {A ∷ U} (u v : ♭A) → u ≡ v → flat-code u v
flat-encode {A} u v p = subst (flat-code u) p (flat-refl u)

-- crisp path induction, after matching on everybody
flat-decode ∷ {A ∷ U} (u v : ♭A) → flat-code u v → u ≡ v
flat-decode {A} = fun 𝄫x → fun 𝄫y → fun 𝄫p →
  let h : (y ∷ A) (p ∷ x ≡ y) → 𝄫x ≡ 𝄫y = fun refl → refl in
  h y p

flat-encode-decode ∷ {A ∷ U} (u v : ♭A) (c : flat-code u v) → flat-encode u v (flat-decode u v c) ≡ c
flat-encode-decode {A} = fun 𝄫x → fun 𝄫y → fun 𝄫p →
  let h : (y ∷ A) (p ∷ x ≡ y) → flat-encode 𝄫x 𝄫y (flat-decode 𝄫x 𝄫y 𝄫p) ≡ 𝄫p = fun refl → refl in
  h y p

flat-decode-encode ∷ {A ∷ U} (u v : ♭A) (p : u ≡ v) → flat-decode u v (flat-encode u v p) ≡ p
flat-decode-encode {A} =
  let lem : (u : ♭A) → flat-decode {A} u u (flat-encode {A} u u refl) ≡ refl = fun 𝄫x → refl in
  fun u → fun v → fun p → J' (fun u → fun v → fun p → flat-decode {A} u v (flat-encode {A} u v p) ≡ p) lem p

flat-id ∷ {A ∷ U} {x y ∷ A} → (𝄫x ≡ 𝄫y) ≃ ♭(x ≡ y)
flat-id {A} {x} {y} =
  ( flat-encode 𝄫x 𝄫y
  , ( (flat-decode 𝄫x 𝄫y , flat-encode-decode 𝄫x 𝄫y)
    , (flat-decode 𝄫x 𝄫y , flat-decode-encode 𝄫x 𝄫y) ) )

flat-id-inv ∷ {A ∷ U} {x y ∷ A} → is-equiv (flat-decode 𝄫x 𝄫y)
flat-id-inv {A} {x} {y} =
  ( (flat-encode 𝄫x 𝄫y , flat-decode-encode 𝄫x 𝄫y)
  , (flat-encode 𝄫x 𝄫y , flat-encode-decode 𝄫x 𝄫y) )

-- Corollary 6.2
flat-id' ∷ {A ∷ U} {u v ∷ ♭A} → (u ≡ v) ≃ ♭(unflatten u ≡ unflatten v)
flat-id' {A} {u} {v} =
  -- every crisp u ∷ ♭A is 𝄫(unflatten u)
  let h : (u v ∷ ♭A) → (u ≡ v) ≃ ♭(unflatten u ≡ unflatten v) = fun 𝄫x → fun 𝄫y → flat-id {A} {x} {y} in
  h u v

-- Corollary 6.3
flat-≡ ∷ {A ∷ U} {u v ∷ A} (p ∷ u ≡ v) → 𝄫u ≡ 𝄫v
flat-≡ {A} {u} {v} p =
  let f : (v ∷ A) (p ∷ u ≡ v) → 𝄫u ≡ 𝄫v = fun refl → refl in
  f v p

-- Lemma 6.8
-- the type family u ↦ ♭(B u) on ♭A: since ♭ requires a crisp argument, it is
-- defined by ♭-induction (it computes to ♭(B a) on 𝄫a)
flat-fam ∷ {A ∷ U} (B ∷ A → U) → ♭A → U
flat-fam {A} B = fun 𝄫a → ♭(B a)

flat-sigma-split ∷ {A ∷ U} {B ∷ A → U} → ♭(Σ (x : A) . B x) → Σ (u : ♭A) . flat-fam B u
flat-sigma-split {A} {B} 𝄫p =
  let h : (p ∷ Σ (x : A) . B x) → Σ (u : ♭A) . flat-fam B u = fun (a , b) → (𝄫a , 𝄫b) in
  h p

flat-sigma-unsplit ∷ {A ∷ U} {B ∷ A → U} → (Σ (u : ♭A) . flat-fam B u) → ♭(Σ (x : A) . B x)
flat-sigma-unsplit {A} {B} (u , v) =
  let h : (u : ♭A) → flat-fam B u → ♭(Σ (x : A) . B x) = fun 𝄫a → fun 𝄫b → 𝄫(a , b) in
  h u v

flat-sigma-split-unsplit ∷ {A ∷ U} {B ∷ A → U} (y : Σ (u : ♭A) . flat-fam B u) →
  flat-sigma-split {A} {B} (flat-sigma-unsplit {A} {B} y) ≡ y
flat-sigma-split-unsplit {A} {B} (u , v) =
  let h : (u : ♭A) (v : flat-fam B u) →
    flat-sigma-split {A} {B} (flat-sigma-unsplit {A} {B} (u , v)) ≡ (u , v) =
    fun 𝄫a → fun 𝄫b → refl
  in
  h u v

flat-sigma-unsplit-split ∷ {A ∷ U} {B ∷ A → U} (x : ♭(Σ (x : A) . B x)) →
  flat-sigma-unsplit {A} {B} (flat-sigma-split {A} {B} x) ≡ x
flat-sigma-unsplit-split {A} {B} 𝄫p =
  let h : (p ∷ Σ (x : A) . B x) →
    flat-sigma-unsplit {A} {B} (flat-sigma-split {A} {B} 𝄫p) ≡ 𝄫p = fun (a , b) → refl in
  h p

flat-sigma-equiv ∷ {A ∷ Type} {B ∷ A → Type} → ♭(Σ (x : A) . B x) ≃ (Σ (u : ♭A) . flat-fam B u)
flat-sigma-equiv {A} {B} =
  ( flat-sigma-split {A} {B}
  , ( (flat-sigma-unsplit {A} {B} , flat-sigma-split-unsplit {A} {B})
    , (flat-sigma-unsplit {A} {B} , flat-sigma-unsplit-split {A} {B}) ) )

-- Theorem 6.9
flat-split ∷ {A B ∷ U} → ♭(A × B) → ♭A × ♭B
flat-split {A} {B} 𝄫x =
  let h : (x ∷ A × B) → ♭A × ♭B = fun (a , b) → (𝄫a , 𝄫b) in
  h x

flat-unsplit ∷ {A B ∷ U} → ♭A × ♭B → ♭(A × B)
flat-unsplit {A} {B} (u , v) =
  let h : (u : ♭A) (v : ♭B) → ♭(A × B) = fun 𝄫a → fun 𝄫b → 𝄫(a , b) in
  h u v

flat-split-unsplit ∷ {A B ∷ U} (y : ♭A × ♭B) → flat-split (flat-unsplit y) ≡ y
flat-split-unsplit {A} {B} (u , v) =
  let h : (u : ♭A) (v : ♭B) → flat-split (flat-unsplit (u , v)) ≡ (u , v) =
    fun 𝄫a → fun 𝄫b → refl
  in
  h u v

flat-unsplit-split ∷ {A B ∷ U} (x : ♭(A × B)) → flat-unsplit (flat-split x) ≡ x
flat-unsplit-split {A} {B} 𝄫x =
  let h : (x ∷ A × B) → flat-unsplit (flat-split 𝄫x) ≡ 𝄫x = fun (a , b) → refl in
  h x

flat-prod-equiv ∷ {A B ∷ Type} → ♭(A × B) ≃ ♭A × ♭B
flat-prod-equiv {A} {B} =
  ( flat-split {A} {B}
  , ( (flat-unsplit {A} {B} , flat-split-unsplit {A} {B})
    , (flat-unsplit {A} {B} , flat-unsplit-split {A} {B}) ) )

-- Theorem 6.14
-- forward
flat-unflatten-target ∷ {A B ∷ Type} → ♭(♭B → ♭A) → ♭(♭B → A)
flat-unflatten-target 𝄫f = 𝄫(λ b.unflatten (f b))

-- backward
flat-flatten-target ∷ {A B ∷ Type} → ♭(♭B → A) → ♭(♭B → ♭A)
flat-flatten-target 𝄫f = 𝄫(λ𝄫b.𝄫(f(𝄫b)))

-- flat-unflatten-target-section ∷ {A B ∷ Type} (f : ♭(♭B → A)) → flat-unflatten-target (flat-flatten-target f) ≡ f
-- flat-unflatten-target-section 𝄫f = funext-nd _ _ (λb.?)

-- flat-unflatten-target-equiv ∷ {A B ∷ Type} → is-equiv (flat-unflatten-target {A} {B})
-- flat-unflatten-target-equiv {A} {B} = is-iso→is-equiv (flat-unflatten-target {A} {B}) (? , _)

is-discrete ∷ (A ∷ U) → Type
is-discrete A = is-equiv {♭ A} {A} unflatten

unflatten-postcomp ∷ {A B ∷ Type} → (B → ♭A) → (B → A)
unflatten-postcomp f = unflatten ∘ f

-- Corollary 6.15
unflatten-postcomp-section ∷ {A B ∷ Type} (e ∷ section (unflatten {A})) →
  section (flat-map (unflatten-postcomp {A} {B}))
unflatten-postcomp-section {A} {B} (s , ss) =
  ( flat-map {B → A} {B → ♭A} (fun g → s ∘ g)
  , fun 𝄫g → flat-≡ (funext-nd _ _ (fun b → ss (g b))) )

unflatten-postcomp-retraction ∷ {A B ∷ Type} (e ∷ retraction (unflatten {A})) →
  retraction (flat-map (unflatten-postcomp {A} {B}))
unflatten-postcomp-retraction {A} {B} (r , rr) =
  ( flat-map {B → A} {B → ♭A} (fun h → r ∘ h)
  , fun 𝄫f → flat-≡ (funext-nd _ _ (fun b → rr (f b))) )

unflatten-equiv ∷ {A B ∷ Type} (d ∷ is-discrete A) → is-equiv (flat-map (unflatten-postcomp {A} {B}))
unflatten-equiv {A} {B} (sec , ret) =
  (unflatten-postcomp-section {A} {B} sec , unflatten-postcomp-retraction {A} {B} ret)

-- Theorem 6.18
is-discrete-flat ∷ (A ∷ U) → is-discrete (♭ A)
is-discrete-flat A =
  let f : ♭ ♭ A → ♭ A = unflatten {♭ A} in
  let g : ♭ A → ♭ ♭ A = λ 𝄫 a . 𝄫 𝄫 a in
  let fg : (x : ♭ A) → f (g x) ≡ x = fun 𝄫a → refl in
  let gf : (x : ♭ ♭ A) → g (f x) ≡ x = fun 𝄫 x →
    let h : (x ∷ ♭ A) → g (f (𝄫 x)) ≡ 𝄫 x = fun 𝄫 x → refl in -- here crisp ♭-induction is prformed, it seems crucial
    h x
  in
  -- is-iso→is-equiv (g , fg , gf)
  ((g , fg) , (g , gf))

-- pairing of flat elements
flat-pair ∷ {A B ∷ U} → ♭A → ♭B → ♭(A × B)
flat-pair 𝄫a 𝄫b = 𝄫(a , b)

unflatten-flat-pair ∷ {A B ∷ U} (x : ♭A) (y : ♭B) → unflatten (flat-pair x y) ≡ (unflatten x , unflatten y)
unflatten-flat-pair 𝄫a 𝄫b = refl

-- Theorem 6.19
flat-pair-section ∷ {A B ∷ U} → section (unflatten {A}) → section (unflatten {B}) → section (unflatten {A × B})
flat-pair-section {A} {B} (s , ss) (s' , ss') =
  ( (fun (a , b) → flat-pair (s a) (s' b))
  , (fun (a , b) → trans (unflatten-flat-pair (s a) (s' b)) (cong2 (pair {A} {B}) (ss a) (ss' b))) )

flat-pair-retraction ∷ {A B ∷ U} → retraction (unflatten {A}) → retraction (unflatten {B}) → retraction (unflatten {A × B})
flat-pair-retraction {A} {B} (r , rr) (r' , rr') =
  let ret : A × B → ♭(A × B) = fun (a , b) → flat-pair (r a) (r' b) in
  ( ret
  , (fun 𝄫x →
      let h : (x ∷ A × B) → ret (unflatten 𝄫x) ≡ 𝄫x =
        fun (a , b) → cong2 flat-pair (rr 𝄫a) (rr' 𝄫b)
      in
      h x) )

is-discrete-prod ∷ {A B ∷ U} → is-discrete A → is-discrete B → is-discrete (A × B)
is-discrete-prod {A} {B} (sA , rA) (sB , rB) = (flat-pair-section sA sB , flat-pair-retraction rA rB)

-- Theorem 6.19
is-discrete-unit ∷ is-discrete ⊤
is-discrete-unit =
  let ret : (x : ♭⊤) → crispify-unit (unflatten x) ≡ x = fun 𝄫x →
    let h : (x ∷ ⊤) → crispify-unit (unflatten 𝄫x) ≡ 𝄫x = fun tt → refl in
    h x
  in
  ((crispify-unit , is-section-crispify-unit) , (crispify-unit , ret))

open import Univalence

-- unflatten on ♭(x ≡ y) is the action of unflatten on paths
unflatten-flat-decode ∷ {A ∷ U} {x y ∷ A} (c : ♭(x ≡ y)) → cong (unflatten {A}) (flat-decode 𝄫x 𝄫y c) ≡ unflatten c
unflatten-flat-decode {A} {x} {y} 𝄫p =
  let h : (y ∷ A) (p ∷ x ≡ y) → cong (unflatten {A}) (flat-decode 𝄫x 𝄫y 𝄫p) ≡ unflatten 𝄫p = fun refl → refl in
  h y p

-- Theorem 6.19: identity types of a discrete type are discrete
is-discrete-id ∷ {A ∷ U} {x y ∷ A} → is-discrete A → is-discrete (x ≡ y)
is-discrete-id {A} {x} {y} d =
  is-equiv-htpy
    {♭(x ≡ y)} {x ≡ y}
    {cong (unflatten {A}) {𝄫x} {𝄫y} ∘ flat-decode {A} 𝄫x 𝄫y} {unflatten {x ≡ y}}
    (unflatten-flat-decode {A} {x} {y})
    (is-equiv-circ (cong (unflatten {A}) {𝄫x} {𝄫y}) (flat-decode {A} 𝄫x 𝄫y) (ap-equiv (unflatten {A}) d 𝄫x 𝄫y) (flat-id-inv {A} {x} {y}))

---
--- Tensor
---

flat-tens-to-prod ∷ {A B ∷ U} → ♭(A ⨂ B) → ♭(A × B)
flat-tens-to-prod = flat-map Tensor.tens→prod
-- flat-tens-to-prod A B 𝄫ab =
--   let f : (ab ∷ A ⨂ B) → ♭(A × B) = fun (a ⊗ b) → 𝄫 (a , b) in
--   f ab

flat-prod-to-tens ∷ {A B ∷ U} → ♭(A × B) → ♭(A ⨂ B)
flat-prod-to-tens {A} {B} 𝄫ab =
  let f : (ab ∷ A × B) → ♭(A ⨂ B) = fun (a , b) → 𝄫(a ⊗ b) in
  f ab

flat-prod-to-tens-to-prod ∷ {A B ∷ U} (x : ♭(A × B)) → flat-tens-to-prod (flat-prod-to-tens x) ≡ x
flat-prod-to-tens-to-prod {A} {B} 𝄫x =
  let f : (x : A × B) → flat-tens-to-prod (flat-prod-to-tens 𝄫x) ≡ 𝄫x = fun (a , b) → refl in
  f x

flat-tens-to-prod-to-tens ∷ {A B ∷ U} (x : ♭(A ⨂ B)) → flat-prod-to-tens (flat-tens-to-prod x) ≡ x
flat-tens-to-prod-to-tens {A} {B} 𝄫x =
  let f : (x : A ⨂ B) → flat-prod-to-tens (flat-tens-to-prod 𝄫x) ≡ 𝄫x = fun (a ⊗ b) → refl in
  f x

flat-tens≃prod ∷ {A B ∷ U} → ♭(A ⨂ B) ≃ ♭(A × B)
flat-tens≃prod {A} {B} =
  ( flat-tens-to-prod {A} {B}
  , ( (flat-prod-to-tens {A} {B} , flat-prod-to-tens-to-prod {A} {B})
    , (flat-prod-to-tens {A} {B} , flat-tens-to-prod-to-tens {A} {B}) ) )

-- a crisp left factor makes the tensor cartesian
flat-tens-prod-l ∷ {A B ∷ U} → ♭A ⨂ B ≃ ♭A × B
flat-tens-prod-l {A} {B} =
  let f ∷ ♭A ⨂ B → ♭A × B = Tensor.tens→prod in
  let g ∷ ♭A × B → ♭A ⨂ B = fun (u , b) →
    let h : (u : ♭A) → B → ♭A ⨂ B = fun 𝄫a → fun b → 𝄫a ⊗ b in
    h u b
  in
  let fg ∷ (y : ♭A × B) → f (g y) ≡ y = fun (u , b) →
    let h : (u : ♭A) → f (g (u , b)) ≡ (u , b) = fun 𝄫a → refl in
    h u
  in
  let gf ∷ (x : ♭A ⨂ B) → g (f x) ≡ x = fun (u ⊗ b) →
    let h : (u : ♭A) → g (f (u ⊗ b)) ≡ (u ⊗ b) = fun 𝄫a → refl in
    h u
  in
  (f , (g , fg) , (g , gf))

flat-tens-prod-r ∷ {A B ∷ U} → A ⨂ ♭B ≃ A × ♭B
flat-tens-prod-r {A} {B} =
  let f ∷ A ⨂ ♭B → A × ♭B = Tensor.tens→prod in
  let g ∷ A × ♭B → A ⨂ ♭B = fun (a , v) →
    let h : (v : ♭B) → A → A ⨂ ♭B = fun 𝄫b → fun a → a ⊗ 𝄫b in
    h v a
  in
  let fg ∷ (y : A × ♭B) → f (g y) ≡ y = fun (a , v) →
    let h : (v : ♭B) → f (g (a , v)) ≡ (a , v) = fun 𝄫b → refl in
    h v
  in
  let gf ∷ (x : A ⨂ ♭B) → g (f x) ≡ x = fun (a ⊗ v) →
    let h : (v : ♭B) → g (f (a ⊗ v)) ≡ (a ⊗ v) = fun 𝄫b → refl in
    h v
  in
  (f , (g , fg) , (g , gf))

---
--- Global points of cartesian, oplax and lax function types
---

flat-pi-to-arrᵣ ∷ {A B ∷ U} → ♭(A → B) → ♭(A →ᵣ B)
flat-pi-to-arrᵣ {A} {B} 𝄫f = 𝄫(λ a . f a)

flat-arrᵣ-to-pi ∷ {A B ∷ U} → ♭(A →ᵣ B) → ♭(A → B)
flat-arrᵣ-to-pi {A} {B} 𝄫f = 𝄫(λ a . f a)

flat-pi-arrᵣ-pi ∷ {A B ∷ U} (x : ♭(A → B)) → flat-arrᵣ-to-pi {A} {B} (flat-pi-to-arrᵣ {A} {B} x) ≡ x
flat-pi-arrᵣ-pi {A} {B} 𝄫f = refl

flat-arrᵣ-pi-arrᵣ ∷ {A B ∷ U} (x : ♭(A →ᵣ B)) → flat-pi-to-arrᵣ {A} {B} (flat-arrᵣ-to-pi {A} {B} x) ≡ x
flat-arrᵣ-pi-arrᵣ {A} {B} 𝄫f = refl

flat-pi≃arrᵣ ∷ {A B ∷ U} → ♭(A → B) ≃ ♭(A →ᵣ B)
flat-pi≃arrᵣ {A} {B} =
  ( flat-pi-to-arrᵣ {A} {B}
  , ( (flat-arrᵣ-to-pi {A} {B} , flat-arrᵣ-pi-arrᵣ {A} {B})
    , (flat-arrᵣ-to-pi {A} {B} , flat-pi-arrᵣ-pi {A} {B}) ) )

flat-pi-to-arrₗ ∷ {A B ∷ U} → ♭(A → B) → ♭(A →ₗ B)
flat-pi-to-arrₗ {A} {B} 𝄫f = 𝄫(λ a . f a)

flat-arrₗ-to-pi ∷ {A B ∷ U} → ♭(A →ₗ B) → ♭(A → B)
flat-arrₗ-to-pi {A} {B} 𝄫f = 𝄫(λ a . f a)

flat-pi-arrₗ-pi ∷ {A B ∷ U} (x : ♭(A → B)) → flat-arrₗ-to-pi {A} {B} (flat-pi-to-arrₗ {A} {B} x) ≡ x
flat-pi-arrₗ-pi {A} {B} 𝄫f = refl

flat-arrₗ-pi-arrₗ ∷ {A B ∷ U} (x : ♭(A →ₗ B)) → flat-pi-to-arrₗ {A} {B} (flat-arrₗ-to-pi {A} {B} x) ≡ x
flat-arrₗ-pi-arrₗ {A} {B} 𝄫f = refl

flat-pi≃arrₗ ∷ {A B ∷ U} → ♭(A → B) ≃ ♭(A →ₗ B)
flat-pi≃arrₗ {A} {B} =
  ( flat-pi-to-arrₗ {A} {B}
  , ( (flat-arrₗ-to-pi {A} {B} , flat-arrₗ-pi-arrₗ {A} {B})
    , (flat-arrₗ-to-pi {A} {B} , flat-pi-arrₗ-pi {A} {B}) ) )

---
--- Crisp functions and crisp currying
---

-- a function defined on crisp arguments only sends crisp paths to paths
crisp-cong ∷ {X Y ∷ U} (Φ ∷ (x ∷ X) → Y) {x y ∷ X} (p ∷ x ≡ y) → Φ x ≡ Φ y
crisp-cong {X} {Y} Φ {x} refl = refl

-- oplax crisp currying: a crisp T → (K →ᵣ W) is a cartesian map T ⨂ K → W (only for a crisp F: F is used across ⊗)
tens-uncurry-crispᵣ ∷ {T K W ∷ U} (F ∷ T → K →ᵣ W) → T ⨂ K → W
tens-uncurry-crispᵣ {T} {K} {W} F (t ⊗ k) = F t k

-- the two round trips
tens-curry-uncurry-crispᵣ ∷ {T K W ∷ U} (F ∷ T → K →ᵣ W) → Tensor.curry-right' {T} {K} {W} (tens-uncurry-crispᵣ {T} {K} {W} F) ≡ F
tens-curry-uncurry-crispᵣ {T} {K} {W} F = refl

tens-uncurry-curry-crispᵣ ∷ {T K W ∷ U} (G ∷ T ⨂ K → W) → tens-uncurry-crispᵣ {T} {K} {W} (Tensor.curry-right' {T} {K} {W} G) ≡ G
tens-uncurry-curry-crispᵣ {T} {K} {W} G =
  funext-htpy {T ⨂ K} {λ _ . W} (tens-uncurry-crispᵣ {T} {K} {W} (Tensor.curry-right' {T} {K} {W} G)) G
    (λ z . let h : (z : T ⨂ K) → tens-uncurry-crispᵣ {T} {K} {W} (Tensor.curry-right' {T} {K} {W} G) z ≡ G z = fun (t ⊗ k) → refl in h z)

-- on global points, currying is an equivalence
flat-tens-curryᵣ ∷ {T K W ∷ U} → ♭(T → K →ᵣ W) → ♭(T ⨂ K → W)
flat-tens-curryᵣ {T} {K} {W} 𝄫F = 𝄫(tens-uncurry-crispᵣ {T} {K} {W} F)

flat-tens-uncurryᵣ ∷ {T K W ∷ U} → ♭(T ⨂ K → W) → ♭(T → K →ᵣ W)
flat-tens-uncurryᵣ {T} {K} {W} = flat-map {T ⨂ K → W} {T → K →ᵣ W} (Tensor.curry-right' {T} {K} {W})

is-equiv-flat-tens-curryᵣ ∷ {T K W ∷ U} → is-equiv (flat-tens-curryᵣ {T} {K} {W})
is-equiv-flat-tens-curryᵣ {T} {K} {W} =
  ((flat-tens-uncurryᵣ {T} {K} {W} , fun 𝄫G → flat-≡ {T ⨂ K → W} (tens-uncurry-curry-crispᵣ {T} {K} {W} G)) ,
   (flat-tens-uncurryᵣ {T} {K} {W} , fun 𝄫F → refl))

---
--- ♭ and equivalences
---

-- ♭ preserves crisp equivalences
flat-map-equiv ∷ {A B ∷ U} (f ∷ A → B) (e ∷ is-equiv f) → is-equiv (flat-map {A} {B} f)
flat-map-equiv {A} {B} f e =
  let s ∷ B → A = section-map f (is-equiv-sec f e) in
  let ss ∷ (y : B) → f (s y) ≡ y = snd (is-section f) (is-equiv-sec f e) in
  let r ∷ B → A = retraction-map f (is-equiv-ret f e) in
  let rr ∷ (x : A) → r (f x) ≡ x = snd (is-retraction f) (is-equiv-ret f e) in
  ((flat-map {B} {A} s , fun 𝄫y → flat-≡ {B} {f (s y)} {y} (ss y)) ,
   (flat-map {B} {A} r , fun 𝄫x → flat-≡ {A} {r (f x)} {x} (rr x)))

-- the inverse of flat-sigma-split is an equivalence too
is-equiv-flat-sigma-unsplit ∷ {A ∷ U} {B ∷ A → U} → is-equiv (flat-sigma-unsplit {A} {B})
is-equiv-flat-sigma-unsplit {A} {B} =
  ((flat-sigma-split {A} {B} , flat-sigma-unsplit-split {A} {B}) , (flat-sigma-split {A} {B} , flat-sigma-split-unsplit {A} {B}))

-- ♭ of a map of Σ-types is an equivalence when ♭ of the base map and ♭ of the fibre maps (at crisp
-- points) are
flat-Σ-map ∷ {X Y ∷ U} {P ∷ X → U} {Q ∷ Y → U} (F ∷ X → Y) (m ∷ (x : X) → P x → Q (F x)) →
  (Σ (x : X) . P x) → Σ (y : Y) . Q y
flat-Σ-map {X} {Y} {P} {Q} F m (x , p) = (F x , m x p)

flat-Σ-map-equiv ∷ {X Y ∷ U} {P ∷ X → U} {Q ∷ Y → U} (F ∷ X → Y) (m ∷ (x : X) → P x → Q (F x)) →
  is-equiv (flat-map {X} {Y} F) → ((x ∷ X) → is-equiv (flat-map {P x} {Q (F x)} (m x))) →
  is-equiv (flat-map {Σ (x : X) . P x} {Σ (y : Y) . Q y} (flat-Σ-map {X} {Y} {P} {Q} F m))
flat-Σ-map-equiv {X} {Y} {P} {Q} F m eF em =
  let m♭ : (u : ♭X) → flat-fam P u → flat-fam Q (flat-map {X} {Y} F u) = fun 𝄫x → flat-map {P x} {Q (F x)} (m x) in
  let em♭ : (u : ♭X) → is-equiv (m♭ u) = fun 𝄫x → em x in
  let T : (Σ (u : ♭X) . flat-fam P u) → Σ (u : ♭X) . flat-fam Q (flat-map {X} {Y} F u) =
    tot {♭X} {flat-fam P} {λ u . flat-fam Q (flat-map {X} {Y} F u)} m♭ in
  let eT : is-equiv T = is-equiv-tot {♭X} {flat-fam P} {λ u . flat-fam Q (flat-map {X} {Y} F u)} m♭ em♭ in
  let B : (Σ (u : ♭X) . flat-fam Q (flat-map {X} {Y} F u)) → Σ (v : ♭Y) . flat-fam Q v =
    Σ-base (flat-map {X} {Y} F) (flat-fam Q) in
  let eB : is-equiv B = is-equiv-Σ-base (flat-map {X} {Y} F) eF (flat-fam Q) in
  let S : (Σ (u : ♭X) . flat-fam P u) → Σ (v : ♭Y) . flat-fam Q v = λ w . B (T w) in
  let eS : is-equiv S = is-equiv-circ B T eB eT in
  let C : ♭(Σ (x : X) . P x) → ♭(Σ (y : Y) . Q y) = λ w . flat-sigma-unsplit {Y} {Q} (S (flat-sigma-split {X} {P} w)) in
  let eC : is-equiv C =
    is-equiv-circ (flat-sigma-unsplit {Y} {Q}) (λ w . S (flat-sigma-split {X} {P} w)) (is-equiv-flat-sigma-unsplit {Y} {Q})
      (is-equiv-circ S (flat-sigma-split {X} {P}) eS (snd _ (flat-sigma-equiv {X} {P}))) in
  is-equiv-htpy {♭(Σ (x : X) . P x)} {♭(Σ (y : Y) . Q y)} {C} {flat-map {Σ (x : X) . P x} {Σ (y : Y) . Q y} (flat-Σ-map {X} {Y} {P} {Q} F m)}
    (fun 𝄫w →
      let h : (w ∷ Σ (x : X) . P x) → C 𝄫w ≡ flat-map {Σ (x : X) . P x} {Σ (y : Y) . Q y} (flat-Σ-map {X} {Y} {P} {Q} F m) 𝄫w =
        fun (x , p) → refl in
      h w)
    eC

-- ♭ of cong φ, on paths between crisp points, is an equivalence when ♭ of φ is
flat-cong-htpy ∷ {Z W ∷ U} (φ ∷ Z → W) {z ∷ Z} {z' ∷ Z} (p ∷ z ≡ z') →
  flat-encode {W} 𝄫(φ z) 𝄫(φ z') (cong (flat-map {Z} {W} φ) (flat-decode {Z} 𝄫z 𝄫z' 𝄫p)) ≡ 𝄫(cong φ p)
flat-cong-htpy {Z} {W} φ {z} refl = refl

flat-cong-equiv ∷ {Z W ∷ U} (φ ∷ Z → W) → is-equiv (flat-map {Z} {W} φ) → (z z' ∷ Z) →
  is-equiv (flat-map {z ≡ z'} {φ z ≡ φ z'} (cong φ {z} {z'}))
flat-cong-equiv {Z} {W} φ eφ z z' =
  let D : ♭(z ≡ z') → 𝄫z ≡ 𝄫z' = flat-decode {Z} 𝄫z 𝄫z' in
  let A : 𝄫z ≡ 𝄫z' → 𝄫(φ z) ≡ 𝄫(φ z') = cong (flat-map {Z} {W} φ) {𝄫z} {𝄫z'} in
  let E : 𝄫(φ z) ≡ 𝄫(φ z') → ♭(φ z ≡ φ z') = flat-encode {W} 𝄫(φ z) 𝄫(φ z') in
  let eD : is-equiv D = flat-id-inv {Z} {z} {z'} in
  let eA : is-equiv A = ap-equiv (flat-map {Z} {W} φ) eφ 𝄫z 𝄫z' in
  let eE : is-equiv E = snd _ (flat-id {W} {φ z} {φ z'}) in
  is-equiv-htpy {♭(z ≡ z')} {♭(φ z ≡ φ z')} {λ q . E (A (D q))} {flat-map {z ≡ z'} {φ z ≡ φ z'} (cong φ {z} {z'})}
    (fun 𝄫p → flat-cong-htpy {Z} {W} φ {z} {z'} p)
    (is-equiv-circ E (λ q . A (D q)) eE (is-equiv-circ A D eA eD))

is-equiv-flat-tens-uncurryᵣ ∷ {T K W ∷ U} → is-equiv (flat-tens-uncurryᵣ {T} {K} {W})
is-equiv-flat-tens-uncurryᵣ {T} {K} {W} =
  ((flat-tens-curryᵣ {T} {K} {W} , fun 𝄫F → refl) ,
   (flat-tens-curryᵣ {T} {K} {W} , fun 𝄫G → flat-≡ {T ⨂ K → W} (tens-uncurry-curry-crispᵣ {T} {K} {W} G)))

-- lax crisp currying: a crisp B → (A →ₗ W) is a cartesian map A ⨂ B → W
tens-uncurry-crispₗ ∷ {A B W ∷ U} (F ∷ B → A →ₗ W) → A ⨂ B → W
tens-uncurry-crispₗ {A} {B} {W} F (a ⊗ b) = F b a

tens-curry-uncurry-crispₗ ∷ {A B W ∷ U} (F ∷ B → A →ₗ W) → Tensor.curry-left' {A} {B} {W} (tens-uncurry-crispₗ {A} {B} {W} F) ≡ F
tens-curry-uncurry-crispₗ {A} {B} {W} F = refl

tens-uncurry-curry-crispₗ ∷ {A B W ∷ U} (G ∷ A ⨂ B → W) → tens-uncurry-crispₗ {A} {B} {W} (Tensor.curry-left' {A} {B} {W} G) ≡ G
tens-uncurry-curry-crispₗ {A} {B} {W} G =
  funext-htpy {A ⨂ B} {λ _ . W} (tens-uncurry-crispₗ {A} {B} {W} (Tensor.curry-left' {A} {B} {W} G)) G
    (λ z . let h : (z : A ⨂ B) → tens-uncurry-crispₗ {A} {B} {W} (Tensor.curry-left' {A} {B} {W} G) z ≡ G z = fun (a ⊗ b) → refl in h z)

flat-tens-curryₗ ∷ {A B W ∷ U} → ♭(B → A →ₗ W) → ♭(A ⨂ B → W)
flat-tens-curryₗ {A} {B} {W} 𝄫F = 𝄫(tens-uncurry-crispₗ {A} {B} {W} F)

flat-tens-uncurryₗ ∷ {A B W ∷ U} → ♭(A ⨂ B → W) → ♭(B → A →ₗ W)
flat-tens-uncurryₗ {A} {B} {W} = flat-map {A ⨂ B → W} {B → A →ₗ W} (Tensor.curry-left' {A} {B} {W})

is-equiv-flat-tens-curryₗ ∷ {A B W ∷ U} → is-equiv (flat-tens-curryₗ {A} {B} {W})
is-equiv-flat-tens-curryₗ {A} {B} {W} =
  ((flat-tens-uncurryₗ {A} {B} {W} , fun 𝄫G → flat-≡ {A ⨂ B → W} (tens-uncurry-curry-crispₗ {A} {B} {W} G)) ,
   (flat-tens-uncurryₗ {A} {B} {W} , fun 𝄫F → refl))

is-equiv-flat-tens-uncurryₗ ∷ {A B W ∷ U} → is-equiv (flat-tens-uncurryₗ {A} {B} {W})
is-equiv-flat-tens-uncurryₗ {A} {B} {W} =
  ((flat-tens-curryₗ {A} {B} {W} , fun 𝄫F → refl) ,
   (flat-tens-curryₗ {A} {B} {W} , fun 𝄫G → flat-≡ {A ⨂ B → W} (tens-uncurry-curry-crispₗ {A} {B} {W} G)))

-- on crisp paths, oplax currying is lax currying followed by the crisp swap (and conversely)
cong-curry-swapₗᵣ ∷ {T X Y ∷ U} {φ₀ φ₁ ∷ T ⨂ X → Y} (p ∷ φ₀ ≡ φ₁) →
  cong (Tensor.curry-right' {T} {X} {Y}) p ≡ crisp-cong {X → T →ₗ Y} {T → X →ᵣ Y} (crisp-swapₗᵣ {X} {T} {Y}) (cong (Tensor.curry-left' {T} {X} {Y}) p)
cong-curry-swapₗᵣ {T} {X} {Y} {φ₀} refl = refl

cong-curry-swapᵣₗ ∷ {X T Y ∷ U} {φ₀ φ₁ ∷ X ⨂ T → Y} (p ∷ φ₀ ≡ φ₁) →
  cong (Tensor.curry-left' {X} {T} {Y}) p ≡ crisp-cong {X → T →ᵣ Y} {T → X →ₗ Y} (crisp-swapᵣₗ {X} {T} {Y}) (cong (Tensor.curry-right' {X} {T} {Y}) p)
cong-curry-swapᵣₗ {X} {T} {Y} {φ₀} refl = refl
