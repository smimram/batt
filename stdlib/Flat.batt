-- Theorem 6.14
-- forward
flat-unflatten-target :: {A B :: Type} → ♭(♭B → ♭A) → ♭(♭B → A)
flat-unflatten-target 𝄫f = 𝄫(λ b.unflatten (f b))

-- backward
flat-flatten-target :: {A B :: Type} → ♭(♭B → A) → ♭(♭B → ♭A)
flat-flatten-target 𝄫f = 𝄫(λ𝄫b.𝄫(f(𝄫b)))

-- flat-unflatten-target-section :: {A B :: Type} (f : ♭(♭B → A)) → flat-unflatten-target (flat-flatten-target f) ≡ f
-- flat-unflatten-target-section 𝄫f = funext-nd _ _ (λb.?)

-- flat-unflatten-target-equiv :: {A B :: Type} → is-equiv (flat-unflatten-target {A} {B})
-- flat-unflatten-target-equiv {A} {B} = is-iso→is-equiv (flat-unflatten-target {A} {B}) (? , _)

is-discrete :: (A :: U) → Type
is-discrete A = is-equiv {♭ A} {A} unflatten

-- Theorem 6.18
is-discrete-flat :: (A :: U) → is-discrete (♭ A)
is-discrete-flat A =
  let f : ♭ ♭ A → ♭ A = unflatten {♭ A} in
  let g : ♭ A → ♭ ♭ A = λ 𝄫 a . 𝄫 𝄫 a in
  let fg : (x : ♭ A) → f (g x) ≡ x = fun 𝄫a → refl in
  let gf : (x : ♭ ♭ A) → g (f x) ≡ x = fun 𝄫 x →
    let h : (x :: ♭ A) → g (f (𝄫 x)) ≡ 𝄫 x = fun 𝄫 x → refl in
    h x
  in
  -- is-iso→is-equiv (g , fg , gf)
  ((g , fg) , (g , gf))

-- pairing of flat elements
flat-pair :: {A B :: U} → ♭A → ♭B → ♭(A × B)
flat-pair 𝄫a 𝄫b = 𝄫(a , b)

unflatten-flat-pair :: {A B :: U} (x : ♭A) (y : ♭B) → unflatten (flat-pair x y) ≡ (unflatten x , unflatten y)
unflatten-flat-pair 𝄫a 𝄫b = refl

-- Theorem 6.19
flat-pair-section :: {A B :: U} → section (unflatten {A}) → section (unflatten {B}) → section (unflatten {A × B})
flat-pair-section {A} {B} (s , ss) (s' , ss') =
  ( (fun (a , b) → flat-pair (s a) (s' b))
  , (fun (a , b) → trans (unflatten-flat-pair (s a) (s' b)) (cong2 (pair {A} {B}) (ss a) (ss' b))) )

flat-pair-retraction :: {A B :: U} → retraction (unflatten {A}) → retraction (unflatten {B}) → retraction (unflatten {A × B})
flat-pair-retraction {A} {B} (r , rr) (r' , rr') =
  let ret : A × B → ♭(A × B) = fun (a , b) → flat-pair (r a) (r' b) in
  ( ret
  , (fun 𝄫x →
      let h : (x :: A × B) → ret (unflatten 𝄫x) ≡ 𝄫x =
        fun (a , b) → cong2 flat-pair (rr 𝄫a) (rr' 𝄫b)
      in
      h x) )

is-discrete-prod :: {A B :: U} → is-discrete A → is-discrete B → is-discrete (A × B)
is-discrete-prod {A} {B} (sA , rA) (sB , rB) = (flat-pair-section sA sB , flat-pair-retraction rA rB)

-- Theorem 6.19
is-discrete-unit :: is-discrete ⊤
is-discrete-unit =
  let ret : (x : ♭⊤) → crispify-unit (unflatten x) ≡ x = fun 𝄫x →
    let h : (x :: ⊤) → crispify-unit (unflatten 𝄫x) ≡ 𝄫x = fun tt → refl in
    h x
  in
  ((crispify-unit , is-section-crispify-unit) , (crispify-unit , ret))

-- Theorem 6.1
flat-id :: {A :: U} {x y :: A} → (𝄫x ≡ 𝄫y) ≃ ♭(x ≡ y)
flat-id {A} {x} {y} =
  let code : ♭A → ♭A → U = fun 𝄫x → fun 𝄫y → ♭(x ≡ y) in
  let r : (u : ♭A) → code u u = fun 𝄫x → 𝄫refl in
  let encode : (u v : ♭A) → u ≡ v → code u v = fun u → fun v → fun p → subst (code u) p (r u) in
  let decode : (u v : ♭A) → code u v → u ≡ v = fun 𝄫x → fun 𝄫y → fun 𝄫p →
    let h : (y :: A) (p :: x ≡ y) → 𝄫x ≡ 𝄫y = fun refl → refl in
    h y p
  in
  let enc-dec : (u v : ♭A) (c : code u v) → encode u v (decode u v c) ≡ c = fun 𝄫x → fun 𝄫y → fun 𝄫p →
    let h : (y :: A) (p :: x ≡ y) → encode 𝄫x 𝄫y (decode 𝄫x 𝄫y 𝄫p) ≡ 𝄫p = fun refl → refl in
    h y p
  in
  let dec-enc : (u v : ♭A) (p : u ≡ v) → decode u v (encode u v p) ≡ p =
    let lem : (u : ♭A) → decode u u (encode u u refl) ≡ refl = fun 𝄫x → refl in
    fun u → fun v → fun p → J' (fun u → fun v → fun p → decode u v (encode u v p) ≡ p) lem p
  in
  ( encode 𝄫x 𝄫y
  , ( (decode 𝄫x 𝄫y , enc-dec 𝄫x 𝄫y)
    , (decode 𝄫x 𝄫y , dec-enc 𝄫x 𝄫y) ) )

-- Corollary 6.2
flat-id' :: {A :: U} {u v :: ♭A} → (u ≡ v) ≃ ♭(unflatten u ≡ unflatten v)
flat-id' {A} {u} {v} =
  -- every crisp u :: ♭A is 𝄫(unflatten u)
  let h : (u v :: ♭A) → (u ≡ v) ≃ ♭(unflatten u ≡ unflatten v) = fun 𝄫x → fun 𝄫y → flat-id {A} {x} {y} in
  h u v

-- Theorem 6.19
is-discrete-id :: {A :: U} {x y :: A} → is-discrete (x ≡ y)
is-discrete-id = ? -- by flat-id' and is-discrete-flat