--
-- Pullbacks (fibre products)
--
-- The fibre product of f : A → X and g : B → X is pullback f g = Σ (a : A) . Σ (b : B) . f a ≡ g b,
-- for arbitrary (not necessarily crisp) types, so that it applies e.g. to hom types between
-- non-crisp points.
--

open import Product
open import Function
open import Equality
open import Equivalence
open import Sigma
open import Funext
open import Path

pullback ∷ {A B X : U} (f : A → X) (g : B → X) → U
pullback {A} {B} f g = Σ (a : A) . Σ (b : B) . f a ≡ g b

--
-- Paths in a fibre product
--

-- two points with the same second component are equal when their first components are, along a
-- path α whose image relates their identifications
pb-path ∷ {H B C : U} (F : H → C) (G : B → C) {h1 h2 : H} (α : h1 ≡ h2) (k : B) (e1 : F h1 ≡ G k) (e2 : F h2 ≡ G k) →
  e1 ≡ trans (cong F α) e2 → (h1 , k , e1) ≡{pullback {H} {B} {C} F G} (h2 , k , e2)
pb-path {H} {B} {C} F G {h1} refl k e1 e2 E = cong {F h1 ≡ G k} {pullback {H} {B} {C} F G} (λ e . (h1 , k , e)) (trans E (trans-refl-l e2))

-- two points are equal when both their components are, along paths α and β whose images relate
-- their identifications
pb-path-both ∷ {H L T : U} (a : H → T) (b : L → T) {h1 h2 : H} (α : h1 ≡ h2) {l1 l2 : L} (β : l1 ≡ l2) (e1 : a h1 ≡ b l1) (e2 : a h2 ≡ b l2) →
  trans (sym (cong a α)) (trans e1 (cong b β)) ≡ e2 → (h1 , l1 , e1) ≡{Σ (h : H) . Σ (l : L) . a h ≡ b l} (h2 , l2 , e2)
pb-path-both {H} {L} {T} a b {h1} refl {l1} refl e1 e2 E =
  cong {a h1 ≡ b l1} {Σ (h : H) . Σ (l : L) . a h ≡ b l} (λ e . (h1 , l1 , e)) (trans (sym (trans-refl-l e1)) E)

-- two points with the same first component are equal when their second components are
pb-path-right ∷ {H L T : U} (a : H → T) (b : L → T) (h : H) {l1 l2 : L} (α : l1 ≡ l2) (e1 : a h ≡ b l1) (e2 : a h ≡ b l2) →
  trans e1 (cong b α) ≡ e2 → (h , l1 , e1) ≡{Σ (h : H) . Σ (l : L) . a h ≡ b l} (h , l2 , e2)
pb-path-right {H} {L} {T} a b h {l1} refl e1 e2 E =
  cong {a h ≡ b l1} {Σ (h : H) . Σ (l : L) . a h ≡ b l} (λ e . (h , l1 , e)) E

-- along such a path, a function of the second component is constant
cong-right-pb-path ∷ {H B C D : U} (F : H → C) (G : B → C) (t : B → D) {h1 h2 : H} (α : h1 ≡ h2) (k : B) (e1 : F h1 ≡ G k)
  (e2 : F h2 ≡ G k) (E : e1 ≡ trans (cong F α) e2) →
  cong (λ w . t (fst {B} (λ b . F (fst {H} (λ h . Σ (b' : B) . F h ≡ G b') w) ≡ G b) (snd {H} (λ h . Σ (b' : B) . F h ≡ G b') w)))
    (pb-path F G α k e1 e2 E) ≡ refl
cong-right-pb-path {H} {B} {C} {D} F G t {h1} refl k e1 e2 E =
  trans (sym (cong-comp (λ w . t (fst {B} (λ b . F (fst {H} (λ h . Σ (b' : B) . F h ≡ G b') w) ≡ G b) (snd {H} (λ h . Σ (b' : B) . F h ≡ G b') w)))
                        (λ e . (h1 , k , e)) (trans E (trans-refl-l e2))))
    (cong-cst (t k) (trans E (trans-refl-l e2)))

--
-- Pasting fibre products
--
-- Given a : H → C, b : L → C, c : K → L and d : K → C with a homotopy R : b ∘ c ~ d, the fibre
-- product of the projection H ×_C L → L with c pastes with H ×_C L into the fibre product
-- H ×_C K of a and d:
--
--   pb-paste : (H ×_C L) ×_L K ≃ H ×_C K,   ((h , l , e1) , (k , e2)) ↦ (h , k , e1 · b e2 · R k)
--
-- The left-hand side is presented as a Σ-type over H ×_C L of the family pb-Q (pb-pasted), so that it can be
-- obtained by base change of a family (see is-equiv-Σ-base in Equivalence.batt).
--

-- the fibre of H ×_C L ×_L K over a point of H ×_C L
pb-Q ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) → (pullback {H} {L} {C} a b) → U
pb-Q {H} {L} {K} {C} a b c (h , r) = Σ (k : K) . fst (λ l . a h ≡ b l) r ≡ c k

-- the domain of the pasting map, (H ×_C L) ×_L K
private
pb-pasted ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) → U
pb-pasted {H} {L} {K} {C} a b c = Σ (t : pullback {H} {L} {C} a b) . pb-Q a b c t

-- the pasting map, by successive pattern matching
private
pb-paste-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (l : L) (e1 : a h ≡ b l) →
  (Σ (k : K) . l ≡ c k) → pullback {H} {K} {C} a d
pb-paste-r {H} {L} {K} {C} a b c d R h l e1 (k , e2) = (h , k , trans e1 (trans (cong b e2) (R k)))

private
pb-paste-h ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (r : Σ (l : L) . a h ≡ b l) →
  pb-Q a b c (h , r) → pullback {H} {K} {C} a d
pb-paste-h {H} {L} {K} {C} a b c d R h (l , e1) = pb-paste-r a b c d R h l e1

private
pb-paste-t ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (t : pullback {H} {L} {C} a b) →
  pb-Q a b c t → pullback {H} {K} {C} a d
pb-paste-t {H} {L} {K} {C} a b c d R (h , r) = pb-paste-h a b c d R h r

pb-paste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  (pb-pasted {H} {L} {K} {C} a b c) → pullback {H} {K} {C} a d
pb-paste {H} {L} {K} {C} a b c d R (t , q) = pb-paste-t a b c d R t q

-- its inverse: l is c k, with the identification e · R k⁻¹
private
pb-unpaste-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) →
  (Σ (k : K) . a h ≡ d k) → pb-pasted {H} {L} {K} {C} a b c
pb-unpaste-r {H} {L} {K} {C} a b c d R h (k , e) = ((h , c k , trans e (sym (R k))) , (k , refl))

private
pb-unpaste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  (pullback {H} {K} {C} a d) → pb-pasted {H} {L} {K} {C} a b c
pb-unpaste {H} {L} {K} {C} a b c d R (h , r) = pb-unpaste-r a b c d R h r

-- path algebra for the two round trips
private
trans-sym-trans-r ∷ {T : U} {x y z : T} (r : y ≡ z) (e : x ≡ z) → trans (trans e (sym r)) (trans refl r) ≡ e
trans-sym-trans-r {T} {x} {y} refl e = refl

private
trans-trans-sym ∷ {T : U} {x y : T} (e : x ≡ y) {z : T} (r : y ≡ z) → trans (trans e (trans refl r)) (sym r) ≡ e
trans-trans-sym {T} {x} {y} e refl = refl

-- first round trip
private
pb-paste-sec-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (w : Σ (k : K) . a h ≡ d k) →
  pb-paste a b c d R (pb-unpaste-r a b c d R h w) ≡ (h , w)
pb-paste-sec-r {H} {L} {K} {C} a b c d R h (k , e) =
  cong {a h ≡ d k} {pullback {H} {K} {C} a d} (λ e' . (h , k , e')) (trans-sym-trans-r (R k) e)

private
pb-paste-sec ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (w : pullback {H} {K} {C} a d) →
  pb-paste a b c d R (pb-unpaste a b c d R w) ≡ w
pb-paste-sec {H} {L} {K} {C} a b c d R (h , w) = pb-paste-sec-r a b c d R h w

-- the second round trip, by induction on the path l ≡ c k
private
pb-paste-ret-aux ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (k : K) {l : L} (e2 : c k ≡ l) (e1 : a h ≡ b l) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , (k , sym e2))) ≡{pb-pasted {H} {L} {K} {C} a b c} ((h , l , e1) , (k , sym e2))
pb-paste-ret-aux {H} {L} {K} {C} a b c d R h k refl e1 =
  cong {a h ≡ b (c k)} {pb-pasted {H} {L} {K} {C} a b c} (λ e . ((h , c k , e) , (k , refl))) (trans-trans-sym e1 (R k))

private
pb-paste-ret-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (l : L) (e1 : a h ≡ b l)
  (q : Σ (k : K) . l ≡ c k) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , q)) ≡{pb-pasted {H} {L} {K} {C} a b c} ((h , l , e1) , q)
pb-paste-ret-r {H} {L} {K} {C} a b c d R h l e1 (k , e2) =
  let T : U = pb-pasted {H} {L} {K} {C} a b c in
  trans (cong {l ≡ c k} {T} (λ e . pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , (k , e)))) (sym (sym-sym e2)))
    (trans (pb-paste-ret-aux a b c d R h k (sym e2) e1)
      (cong {l ≡ c k} {T} (λ e . ((h , l , e1) , (k , e))) (sym-sym e2)))

private
pb-paste-ret-h ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (r : Σ (l : L) . a h ≡ b l)
  (q : pb-Q a b c (h , r)) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , r) , q)) ≡{pb-pasted {H} {L} {K} {C} a b c} ((h , r) , q)
pb-paste-ret-h {H} {L} {K} {C} a b c d R h (l , e1) = pb-paste-ret-r a b c d R h l e1

private
pb-paste-ret-t ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (t : pullback {H} {L} {C} a b)
  (q : pb-Q a b c t) →
  pb-unpaste a b c d R (pb-paste a b c d R (t , q)) ≡{pb-pasted {H} {L} {K} {C} a b c} (t , q)
pb-paste-ret-t {H} {L} {K} {C} a b c d R (h , r) = pb-paste-ret-h a b c d R h r

abstract is-equiv-pb-paste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  is-equiv (pb-paste a b c d R)
is-equiv-pb-paste {H} {L} {K} {C} a b c d R =
  ((pb-unpaste a b c d R , pb-paste-sec a b c d R) ,
   (pb-unpaste a b c d R , fun (t , q) → pb-paste-ret-t a b c d R t q))

---
--- The universal property of pullbacks
---
--- Maps into the pullback of g and h are pullbacks of maps (postcomposition commutes with
--- pullbacks): for every Z,
---   pullback-post : (Z → A ×_C B) → (Z → A) ×_{Z → C} (Z → B)
--- is an equivalence, with inverse (α , β , S) ↦ λ z . (α z , β z , happly S z).
---


pullback-post ∷ {Z A B C : U} (g : A → C) (h : B → C) → (Z → pullback {A} {B} {C} g h) →
  pullback {Z → A} {Z → B} {Z → C} (post {Z} {A} {C} g) (post {Z} {B} {C} h)
pullback-post {Z} {A} {B} {C} g h φ =
  let a : Z → A = λ z . fst (λ a' . Σ (b : B) . g a' ≡ h b) (φ z) in
  let b : Z → B = λ z . fst (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
  (a , b , funext-htpy {Z} {λ _ . C} (λ z . g (a z)) (λ z . h (b z))
             (λ z . snd (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z))))

private
pullback-post-inv ∷ {Z A B C : U} (g : A → C) (h : B → C) →
  pullback {Z → A} {Z → B} {Z → C} (post {Z} {A} {C} g) (post {Z} {B} {C} h) → (Z → pullback {A} {B} {C} g h)
pullback-post-inv {Z} {A} {B} {C} g h (α , r) z =
  let k : (r : Σ (β : Z → B) . post {Z} {A} {C} g α ≡ post {Z} {B} {C} h β) → pullback {A} {B} {C} g h = fun (β , S) →
    (α z , β z , happly {Z} {λ _ . C} {λ z' . g (α z')} {λ z' . h (β z')} S z) in
  k r

-- Σ-η for the pullback, pointwise
pullback-eta ∷ {A B C : U} (g : A → C) (h : B → C) (w : pullback {A} {B} {C} g h) →
  (fst (λ a . Σ (b : B) . g a ≡ h b) w ,
   fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') w) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) w) ,
   snd (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') w) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) w))
    ≡{pullback {A} {B} {C} g h} w
pullback-eta {A} {B} {C} g h (a , r) =
  let k : (r : Σ (b : B) . g a ≡ h b) → (a , fst (λ b . g a ≡ h b) r , snd (λ b . g a ≡ h b) r) ≡{pullback {A} {B} {C} g h} (a , r) =
    fun (b , e) → refl in
  k r

private
pullback-post-retr ∷ {Z A B C : U} (g : A → C) (h : B → C) (φ : Z → pullback {A} {B} {C} g h) →
  pullback-post-inv {Z} {A} {B} {C} g h (pullback-post {Z} {A} {B} {C} g h φ) ≡ φ
pullback-post-retr {Z} {A} {B} {C} g h φ =
  let a : Z → A = λ z . fst (λ a' . Σ (b : B) . g a' ≡ h b) (φ z) in
  let b : Z → B = λ z . fst (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
  let e : (z : Z) → g (a z) ≡ h (b z) = λ z . snd (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
  let he : happly {Z} {λ _ . C} {λ z . g (a z)} {λ z . h (b z)} (funext-htpy {Z} {λ _ . C} (λ z . g (a z)) (λ z . h (b z)) e) ≡ e =
    happly-funext-htpy {Z} {λ _ . C} (λ z . g (a z)) (λ z . h (b z)) e in
  funext-htpy {Z} {λ _ . pullback {A} {B} {C} g h} (pullback-post-inv {Z} {A} {B} {C} g h (pullback-post {Z} {A} {B} {C} g h φ)) φ
    (λ z . trans (cong {g (a z) ≡ h (b z)} {pullback {A} {B} {C} g h} (λ q . (a z , b z , q))
                   (happly {Z} {λ z' . g (a z') ≡ h (b z')} {happly {Z} {λ _ . C} {λ z' . g (a z')} {λ z' . h (b z')} (funext-htpy {Z} {λ _ . C} (λ z' . g (a z')) (λ z' . h (b z')) e)} {e} he z))
             (pullback-eta {A} {B} {C} g h (φ z)))

private
pullback-post-sec ∷ {Z A B C : U} (g : A → C) (h : B → C) (d : pullback {Z → A} {Z → B} {Z → C} (post {Z} {A} {C} g) (post {Z} {B} {C} h)) →
  pullback-post {Z} {A} {B} {C} g h (pullback-post-inv {Z} {A} {B} {C} g h d) ≡ d
pullback-post-sec {Z} {A} {B} {C} g h (α , r) =
  let k : (r : Σ (β : Z → B) . post {Z} {A} {C} g α ≡ post {Z} {B} {C} h β) →
      pullback-post {Z} {A} {B} {C} g h (pullback-post-inv {Z} {A} {B} {C} g h (α , r)) ≡ (α , r) = fun (β , S) →
    cong {post {Z} {A} {C} g α ≡ post {Z} {B} {C} h β} {pullback {Z → A} {Z → B} {Z → C} (post {Z} {A} {C} g) (post {Z} {B} {C} h)}
      (λ q . (α , β , q)) (funext-htpy-happly {Z} {λ _ . C} {λ z . g (α z)} {λ z . h (β z)} S) in
  k r

is-equiv-pullback-post ∷ {Z A B C : U} (g : A → C) (h : B → C) → is-equiv (pullback-post {Z} {A} {B} {C} g h)
is-equiv-pullback-post {Z} {A} {B} {C} g h =
  ((pullback-post-inv {Z} {A} {B} {C} g h , pullback-post-sec {Z} {A} {B} {C} g h) , (pullback-post-inv {Z} {A} {B} {C} g h , pullback-post-retr {Z} {A} {B} {C} g h))

---
--- The universal property of pullbacks, homotopy form
---
--- The same, with the commutation given by a homotopy H : Z → path C and two paths fixing its
--- endpoints (the form used for oplax maps, where the homotopy has to be a map into path C):
---   pullback→cone : (Z → A ×_C B) → pullback-cone g h,   φ ↦ ((a , b , λ z . (g (a z) , h (b z) , e z)) , refl , refl)
--- is an equivalence; its inverse cone→pullback is the gap map.
---


pullback-cone-data ∷ (Z A B C : U) → U
pullback-cone-data Z A B C = (Z → A) × (Z → B) × (Z → path C)

pullback-cone ∷ {Z A B C : U} (g : A → C) (h : B → C) → U
pullback-cone {Z} {A} {B} {C} g h =
  Σ (x : pullback-cone-data Z A B C) .
    (post {Z} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {Z} {A} {C} g (Product.fst x)) ×
    (post {Z} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {Z} {B} {C} h (Product.fst (Product.snd x)))

pullback→cone ∷ {Z A B C : U} (g : A → C) (h : B → C) → (Z → pullback {A} {B} {C} g h) → pullback-cone {Z} {A} {B} {C} g h
pullback→cone {Z} {A} {B} {C} g h φ =
  let a : Z → A = λ z . fst (λ a' . Σ (b : B) . g a' ≡ h b) (φ z) in
  let b : Z → B = λ z . fst (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
  let e : (z : Z) → g (a z) ≡ h (b z) = λ z . snd (λ b' . g (a z) ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
  ((a , b , λ z . (g (a z) , h (b z) , e z)) , refl , refl)

cone→pullback ∷ {Z A B C : U} (g : A → C) (h : B → C) → pullback-cone {Z} {A} {B} {C} g h → (Z → pullback {A} {B} {C} g h)
cone→pullback {Z} {A} {B} {C} g h (x , ss) z =
  let α : Z → A = Product.fst x in
  let β : Z → B = Product.fst (Product.snd x) in
  let H : Z → path C = Product.snd (Product.snd x) in
  let s : post {Z} {path C} {C} (path-src {C}) H ≡ post {Z} {A} {C} g α = Product.fst ss in
  let s' : post {Z} {path C} {C} (path-tgt {C}) H ≡ post {Z} {B} {C} h β = Product.snd ss in
  (α z , β z ,
   trans (sym (happly {Z} {λ _ . C} {post {Z} {path C} {C} (path-src {C}) H} {post {Z} {A} {C} g α} s z))
     (trans (path-eq {C} (H z)) (happly {Z} {λ _ . C} {post {Z} {path C} {C} (path-tgt {C}) H} {post {Z} {B} {C} h β} s' z)))

private
pullback→cone-retr ∷ {Z A B C : U} (g : A → C) (h : B → C) (φ : Z → pullback {A} {B} {C} g h) →
  cone→pullback {Z} {A} {B} {C} g h (pullback→cone {Z} {A} {B} {C} g h φ) ≡ φ
pullback→cone-retr {Z} {A} {B} {C} g h φ =
  funext-htpy {Z} {λ _ . pullback {A} {B} {C} g h} (cone→pullback {Z} {A} {B} {C} g h (pullback→cone {Z} {A} {B} {C} g h φ)) φ
    (λ z .
      let a : A = fst (λ a' . Σ (b : B) . g a' ≡ h b) (φ z) in
      let b : B = fst (λ b' . g a ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)) in
      trans (cong {g a ≡ h b} {pullback {A} {B} {C} g h} (λ q . (a , b , q))
               (trans-refl-l (snd (λ b' . g a ≡ h b') (snd (λ a' . Σ (b' : B) . g a' ≡ h b') (φ z)))))
        (pullback-eta {A} {B} {C} g h (φ z)))

-- the coherence of the second round trip: re-gluing a homotopy along its endpoint paths gives it
-- back (by J on the two endpoint paths, then the η of free paths)
private
pullback-cone-reglue ∷ {Z C : U} (H : Z → path C) {F : Z → C} (s : post {Z} {path C} {C} (path-src {C}) H ≡ F)
  {F' : Z → C} (s' : post {Z} {path C} {C} (path-tgt {C}) H ≡ F') →
  ((λ z . (F z , F' z , trans (sym (happly {Z} {λ _ . C} {post {Z} {path C} {C} (path-src {C}) H} {F} s z))
                          (trans (path-eq {C} (H z)) (happly {Z} {λ _ . C} {post {Z} {path C} {C} (path-tgt {C}) H} {F'} s' z)))) ,
   refl , refl)
    ≡{Σ (H' : Z → path C) . (post {Z} {path C} {C} (path-src {C}) H' ≡ F) × (post {Z} {path C} {C} (path-tgt {C}) H' ≡ F')}
  (H , s , s')
pullback-cone-reglue {Z} {C} H refl refl =
  let src : Z → C = post {Z} {path C} {C} (path-src {C}) H in
  let tgt : Z → C = post {Z} {path C} {C} (path-tgt {C}) H in
  let H'' : Z → path C = λ z . (src z , tgt z , trans refl (path-eq {C} (H z))) in
  let rho : (z : Z) → H'' z ≡ H z = λ z .
    trans (cong {src z ≡ tgt z} {path C} (λ q . (src z , tgt z , q)) (trans-refl-l (path-eq {C} (H z)))) (path-eta {C} (H z)) in
  let P : H'' ≡ H = funext-htpy {Z} {λ _ . path C} H'' H rho in
  -- the endpoints of P are trivial
  let κs : (z : Z) → cong (path-src {C}) (rho z) ≡ refl = λ z .
    trans (cong-trans {path C} {C} (path-src {C}) (cong {src z ≡ tgt z} {path C} (λ q . (src z , tgt z , q)) (trans-refl-l (path-eq {C} (H z)))) (path-eta {C} (H z)))
      (trans (cong2 {src z ≡ src z} {src z ≡ src z} {src z ≡ src z} (λ a b . trans a b)
                (trans (sym (cong-comp {src z ≡ tgt z} {path C} {C} (path-src {C}) (λ q . (src z , tgt z , q)) (trans-refl-l (path-eq {C} (H z)))))
                  (cong-cst {src z ≡ tgt z} {C} (src z) (trans-refl-l (path-eq {C} (H z)))))
                (cong-src-path-eta {C} (H z)))
        refl) in
  let κt : (z : Z) → cong (path-tgt {C}) (rho z) ≡ refl = λ z .
    trans (cong-trans {path C} {C} (path-tgt {C}) (cong {src z ≡ tgt z} {path C} (λ q . (src z , tgt z , q)) (trans-refl-l (path-eq {C} (H z)))) (path-eta {C} (H z)))
      (trans (cong2 {tgt z ≡ tgt z} {tgt z ≡ tgt z} {tgt z ≡ tgt z} (λ a b . trans a b)
                (trans (sym (cong-comp {src z ≡ tgt z} {path C} {C} (path-tgt {C}) (λ q . (src z , tgt z , q)) (trans-refl-l (path-eq {C} (H z)))))
                  (cong-cst {src z ≡ tgt z} {C} (tgt z) (trans-refl-l (path-eq {C} (H z)))))
                (cong-tgt-path-eta {C} (H z)))
        refl) in
  let Ps : cong (post {Z} {path C} {C} (path-src {C})) P ≡ refl =
    trans (cong-post-funext {Z} {path C} {C} (path-src {C}) H'' H rho)
      (trans (cong {(z : Z) → src z ≡ src z} {src ≡ src} (funext-htpy {Z} {λ _ . C} src src)
                (funext-htpy {Z} {λ z . src z ≡ src z} (λ z . cong (path-src {C}) (rho z)) (λ z . refl) κs))
        (funext-htpy-happly {Z} {λ _ . C} {src} {src} refl)) in
  let Pt : cong (post {Z} {path C} {C} (path-tgt {C})) P ≡ refl =
    trans (cong-post-funext {Z} {path C} {C} (path-tgt {C}) H'' H rho)
      (trans (cong {(z : Z) → tgt z ≡ tgt z} {tgt ≡ tgt} (funext-htpy {Z} {λ _ . C} tgt tgt)
                (funext-htpy {Z} {λ z . tgt z ≡ tgt z} (λ z . cong (path-tgt {C}) (rho z)) (λ z . refl) κt))
        (funext-htpy-happly {Z} {λ _ . C} {tgt} {tgt} refl)) in
  Σ-path-join {Z → path C} {λ w . (post {Z} {path C} {C} (path-src {C}) w ≡ src) × (post {Z} {path C} {C} (path-tgt {C}) w ≡ tgt)}
    P
    (trans (subst-path-pair {Z → path C} {Z → C} {Z → C} (post {Z} {path C} {C} (path-src {C})) (post {Z} {path C} {C} (path-tgt {C})) {src} {tgt} P refl refl)
      (cong2 {src ≡ src} {tgt ≡ tgt} {(src ≡ src) × (tgt ≡ tgt)} pair (cong {src ≡ src} {src ≡ src} (sym {Z → C} {src} {src}) Ps) (cong {tgt ≡ tgt} {tgt ≡ tgt} (sym {Z → C} {tgt} {tgt}) Pt)))

private
pullback→cone-sec ∷ {Z A B C : U} (g : A → C) (h : B → C) (d : pullback-cone {Z} {A} {B} {C} g h) →
  pullback→cone {Z} {A} {B} {C} g h (cone→pullback {Z} {A} {B} {C} g h d) ≡ d
pullback→cone-sec {Z} {A} {B} {C} g h (x , ss) =
  let k : (α : Z → A) (β : Z → B) (H : Z → path C)
          (s : post {Z} {path C} {C} (path-src {C}) H ≡ post {Z} {A} {C} g α) (s' : post {Z} {path C} {C} (path-tgt {C}) H ≡ post {Z} {B} {C} h β) →
          pullback→cone {Z} {A} {B} {C} g h (cone→pullback {Z} {A} {B} {C} g h ((α , β , H) , s , s')) ≡ ((α , β , H) , s , s') =
    λ α β H s s' .
      cong {Σ (H' : Z → path C) . (post {Z} {path C} {C} (path-src {C}) H' ≡ post {Z} {A} {C} g α) × (post {Z} {path C} {C} (path-tgt {C}) H' ≡ post {Z} {B} {C} h β)}
           {pullback-cone {Z} {A} {B} {C} g h}
        (λ w . ((α , β , fst (λ H' . (post {Z} {path C} {C} (path-src {C}) H' ≡ post {Z} {A} {C} g α) × (post {Z} {path C} {C} (path-tgt {C}) H' ≡ post {Z} {B} {C} h β)) w) ,
                snd (λ H' . (post {Z} {path C} {C} (path-src {C}) H' ≡ post {Z} {A} {C} g α) × (post {Z} {path C} {C} (path-tgt {C}) H' ≡ post {Z} {B} {C} h β)) w))
        (pullback-cone-reglue {Z} {C} H {post {Z} {A} {C} g α} s {post {Z} {B} {C} h β} s') in
  let k2 : (x : pullback-cone-data Z A B C) (ss : (post {Z} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {Z} {A} {C} g (Product.fst x)) ×
                                       (post {Z} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {Z} {B} {C} h (Product.fst (Product.snd x)))) →
           pullback→cone {Z} {A} {B} {C} g h (cone→pullback {Z} {A} {B} {C} g h (x , ss)) ≡ (x , ss) =
    fun (α , r) →
      let k3 : (r : (Z → B) × (Z → path C))
               (ss : (post {Z} {path C} {C} (path-src {C}) (Product.snd r) ≡ post {Z} {A} {C} g α) ×
                     (post {Z} {path C} {C} (path-tgt {C}) (Product.snd r) ≡ post {Z} {B} {C} h (Product.fst r))) →
               pullback→cone {Z} {A} {B} {C} g h (cone→pullback {Z} {A} {B} {C} g h ((α , r) , ss)) ≡ ((α , r) , ss) =
        fun (β , H) (s , s') → k α β H s s' in
      k3 r in
  k2 x ss

is-equiv-pullback→cone ∷ {Z A B C : U} (g : A → C) (h : B → C) → is-equiv (pullback→cone {Z} {A} {B} {C} g h)
is-equiv-pullback→cone {Z} {A} {B} {C} g h =
  ((cone→pullback {Z} {A} {B} {C} g h , pullback→cone-sec {Z} {A} {B} {C} g h) , (cone→pullback {Z} {A} {B} {C} g h , pullback→cone-retr {Z} {A} {B} {C} g h))

---
--- Oplax and lax cones
---
--- An oplax (resp. lax) cone over g : A → C, h : B → C with vertex a crisp K is a pair of oplax
--- (resp. lax) maps K → A, K → B with a homotopy K →ᵣ path C between their images, whose endpoints
--- are fixed by two paths. Maps K →ᵣ pullback g h give such cones (pullback→coneᵣ), with refl
--- paths; that this is an equivalence is the oplax universal property of pullbacks
--- (graytt/Pullback-up.batt).
---

-- the data of an oplax cone with vertex K: two oplax maps and an oplax homotopy
pullback-coneᵣ-data ∷ (K A B C ∷ U) → U
pullback-coneᵣ-data K A B C = (K →ᵣ A) × (K →ᵣ B) × (K →ᵣ path C)

-- the endpoints of the homotopy are the images of the two maps
pullback-coneᵣ-paths ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneᵣ-data K A B C → U
pullback-coneᵣ-paths K {A} {B} {C} g h x =
  (postᵣ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ postᵣ {K} {A} {C} g (Product.fst x)) ×
  (postᵣ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ postᵣ {K} {B} {C} h (Product.fst (Product.snd x)))

pullback-coneᵣ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullback-coneᵣ K {A} {B} {C} g h = Σ (x : pullback-coneᵣ-data K A B C) . pullback-coneᵣ-paths K {A} {B} {C} g h x

-- an oplax map into the pullback gives an oplax cone (with refl endpoint paths)
pullback→coneᵣ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → (K →ᵣ pullback {A} {B} {C} g h) → pullback-coneᵣ K {A} {B} {C} g h
pullback→coneᵣ K {A} {B} {C} g h φ =
  (((λ k . fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
   (λ k . fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
   (λ k . (g (fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
           h (fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
           snd (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))))) ,
  refl , refl)

-- components of an oplax cone
pullback-coneᵣ-fst ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneᵣ K {A} {B} {C} g h → K →ᵣ A
pullback-coneᵣ-fst K {A} {B} {C} g h w = Product.fst (fst (pullback-coneᵣ-paths K {A} {B} {C} g h) w)

pullback-coneᵣ-snd ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneᵣ K {A} {B} {C} g h → K →ᵣ B
pullback-coneᵣ-snd K {A} {B} {C} g h w = Product.fst (Product.snd (fst (pullback-coneᵣ-paths K {A} {B} {C} g h) w))

pullback-coneᵣ-htpy ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneᵣ K {A} {B} {C} g h → K →ᵣ path C
pullback-coneᵣ-htpy K {A} {B} {C} g h w = Product.snd (Product.snd (fst (pullback-coneᵣ-paths K {A} {B} {C} g h) w))

-- η for oplax cones
pullback-coneᵣ-eta ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (w : pullback-coneᵣ K {A} {B} {C} g h) →
  ((pullback-coneᵣ-fst K {A} {B} {C} g h w , pullback-coneᵣ-snd K {A} {B} {C} g h w , pullback-coneᵣ-htpy K {A} {B} {C} g h w) ,
   Product.fst (snd (pullback-coneᵣ-paths K {A} {B} {C} g h) w) , Product.snd (snd (pullback-coneᵣ-paths K {A} {B} {C} g h) w))
    ≡{pullback-coneᵣ K {A} {B} {C} g h} w
pullback-coneᵣ-eta K {A} {B} {C} g h (x , ps) =
  let k : (u : K →ᵣ A) (r : (K →ᵣ B) × (K →ᵣ path C)) (ps : pullback-coneᵣ-paths K {A} {B} {C} g h (u , r)) →
      ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullback-coneᵣ K {A} {B} {C} g h} ((u , r) , ps) =
    λ u r ps . let k2 : (r : (K →ᵣ B) × (K →ᵣ path C)) (ps : pullback-coneᵣ-paths K {A} {B} {C} g h (u , r)) →
                   ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullback-coneᵣ K {A} {B} {C} g h} ((u , r) , ps) =
                 fun (v , H) (p , p') → refl in k2 r ps in
  let k1 : (x : pullback-coneᵣ-data K A B C) (ps : pullback-coneᵣ-paths K {A} {B} {C} g h x) →
      ((Product.fst x , Product.fst (Product.snd x) , Product.snd (Product.snd x)) , Product.fst ps , Product.snd ps) ≡{pullback-coneᵣ K {A} {B} {C} g h} (x , ps) =
    fun (u , r) ps → k u r ps in
  k1 x ps

-- the data of a lax cone with vertex K: two lax maps and a lax homotopy
pullback-coneₗ-data ∷ (K A B C ∷ U) → U
pullback-coneₗ-data K A B C = (K →ₗ A) × (K →ₗ B) × (K →ₗ path C)

-- the endpoints of the homotopy are the images of the two maps
pullback-coneₗ-paths ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneₗ-data K A B C → U
pullback-coneₗ-paths K {A} {B} {C} g h x =
  (postₗ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ postₗ {K} {A} {C} g (Product.fst x)) ×
  (postₗ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ postₗ {K} {B} {C} h (Product.fst (Product.snd x)))

pullback-coneₗ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullback-coneₗ K {A} {B} {C} g h = Σ (x : pullback-coneₗ-data K A B C) . pullback-coneₗ-paths K {A} {B} {C} g h x

-- a lax map into the pullback gives a lax cone (with refl endpoint paths)
pullback→coneₗ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → (K →ₗ pullback {A} {B} {C} g h) → pullback-coneₗ K {A} {B} {C} g h
pullback→coneₗ K {A} {B} {C} g h φ =
  (((λ k . fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
   (λ k . fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
   (λ k . (g (fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
           h (fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
           snd (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))))) ,
  refl , refl)

-- components of a lax cone
pullback-coneₗ-fst ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneₗ K {A} {B} {C} g h → K →ₗ A
pullback-coneₗ-fst K {A} {B} {C} g h w = Product.fst (fst (pullback-coneₗ-paths K {A} {B} {C} g h) w)

pullback-coneₗ-snd ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneₗ K {A} {B} {C} g h → K →ₗ B
pullback-coneₗ-snd K {A} {B} {C} g h w = Product.fst (Product.snd (fst (pullback-coneₗ-paths K {A} {B} {C} g h) w))

pullback-coneₗ-htpy ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-coneₗ K {A} {B} {C} g h → K →ₗ path C
pullback-coneₗ-htpy K {A} {B} {C} g h w = Product.snd (Product.snd (fst (pullback-coneₗ-paths K {A} {B} {C} g h) w))

-- η for lax cones
pullback-coneₗ-eta ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (w : pullback-coneₗ K {A} {B} {C} g h) →
  ((pullback-coneₗ-fst K {A} {B} {C} g h w , pullback-coneₗ-snd K {A} {B} {C} g h w , pullback-coneₗ-htpy K {A} {B} {C} g h w) ,
   Product.fst (snd (pullback-coneₗ-paths K {A} {B} {C} g h) w) , Product.snd (snd (pullback-coneₗ-paths K {A} {B} {C} g h) w))
    ≡{pullback-coneₗ K {A} {B} {C} g h} w
pullback-coneₗ-eta K {A} {B} {C} g h (x , ps) =
  let k : (u : K →ₗ A) (r : (K →ₗ B) × (K →ₗ path C)) (ps : pullback-coneₗ-paths K {A} {B} {C} g h (u , r)) →
      ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullback-coneₗ K {A} {B} {C} g h} ((u , r) , ps) =
    λ u r ps . let k2 : (r : (K →ₗ B) × (K →ₗ path C)) (ps : pullback-coneₗ-paths K {A} {B} {C} g h (u , r)) →
                   ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullback-coneₗ K {A} {B} {C} g h} ((u , r) , ps) =
                 fun (v , H) (p , p') → refl in k2 r ps in
  let k1 : (x : pullback-coneₗ-data K A B C) (ps : pullback-coneₗ-paths K {A} {B} {C} g h x) →
      ((Product.fst x , Product.fst (Product.snd x) , Product.snd (Product.snd x)) , Product.fst ps , Product.snd ps) ≡{pullback-coneₗ K {A} {B} {C} g h} (x , ps) =
    fun (u , r) ps → k u r ps in
  k1 x ps

-- Restricting a fibre product along a map a : H → M of its left factor: the type of points h : H
-- with a point of M ×_T L lying over a h is the fibre product H ×_T L of Q ∘ a and b (the path
-- a h ≡ m is contracted with m).
private
pb-restrict-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) {m : M} (e : a h ≡ m) (s : Σ (l : L) . Q m ≡ b l) →
  Σ (l : L) . Q (a h) ≡ b l
pb-restrict-r {H} {M} {L} {T} a Q b h e (l , f) = (l , trans (cong Q e) f)

private
pb-restrict-z ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (z : pullback {M} {L} {T} Q b) →
  a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z → Σ (l : L) . Q (a h) ≡ b l
pb-restrict-z {H} {M} {L} {T} a Q b h (m , s) e = pb-restrict-r a Q b h {m} e s

pb-restrict ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) →
  (Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  pullback {H} {L} {T} (λ h . Q (a h)) b
pb-restrict {H} {M} {L} {T} a Q b (h , r) =
  let k : (r : Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) → Σ (l : L) . Q (a h) ≡ b l =
    fun (z , e) → pb-restrict-z a Q b h z e in
  (h , k r)

private
pb-unrestrict ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) →
  (Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l) →
  Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z
pb-unrestrict {H} {M} {L} {T} a Q b (h , s) = (h , ((a h , s) , refl))

private
pb-restrict-sec-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (s : Σ (l : L) . Q (a h) ≡ b l) →
  pb-restrict a Q b (pb-unrestrict a Q b (h , s)) ≡{pullback {H} {L} {T} (λ h . Q (a h)) b} (h , s)
pb-restrict-sec-r {H} {M} {L} {T} a Q b h (l , f) =
  cong {Q (a h) ≡ b l} {Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l} (λ f' . (h , (l , f'))) (trans-refl-l f)

private
pb-restrict-retr-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) {m : M} (e : a h ≡ m) (l : L) (f : Q m ≡ b l) →
  pb-unrestrict a Q b (pb-restrict a Q b (h , ((m , (l , f)) , e)))
    ≡{Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , ((m , (l , f)) , e))
pb-restrict-retr-r {H} {M} {L} {T} a Q b h refl l f =
  cong {Q (a h) ≡ b l} {Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z}
    (λ f' . (h , ((a h , (l , f')) , refl))) (trans-refl-l f)

private
pb-restrict-retr-s ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (m : M) (s : Σ (l : L) . Q m ≡ b l) (e : a h ≡ m) →
  pb-unrestrict a Q b (pb-restrict a Q b (h , ((m , s) , e)))
    ≡{Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , ((m , s) , e))
pb-restrict-retr-s {H} {M} {L} {T} a Q b h m (l , f) e = pb-restrict-retr-r a Q b h {m} e l f

private
pb-restrict-retr-z ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (z : pullback {M} {L} {T} Q b)
  (e : a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  pb-unrestrict a Q b (pb-restrict a Q b (h , (z , e)))
    ≡{Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , (z , e))
pb-restrict-retr-z {H} {M} {L} {T} a Q b h (m , s) e = pb-restrict-retr-s a Q b h m s e

private
pb-restrict-retr ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T)
  (w : Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  pb-unrestrict a Q b (pb-restrict a Q b w) ≡ w
pb-restrict-retr {H} {M} {L} {T} a Q b (h , r) =
  let k : (r : Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
          pb-unrestrict a Q b (pb-restrict a Q b (h , r))
            ≡{Σ (h : H) . Σ (z : pullback {M} {L} {T} Q b) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , r) =
    fun (z , e) → pb-restrict-retr-z a Q b h z e in
  k r

private
pb-restrict-sec ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (w : pullback {H} {L} {T} (λ h . Q (a h)) b) →
  pb-restrict a Q b (pb-unrestrict a Q b w) ≡ w
pb-restrict-sec {H} {M} {L} {T} a Q b (h , s) = pb-restrict-sec-r a Q b h s

is-equiv-pb-restrict ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) → is-equiv (pb-restrict a Q b)
is-equiv-pb-restrict {H} {M} {L} {T} a Q b =
  ((pb-unrestrict a Q b , pb-restrict-sec a Q b) , (pb-unrestrict a Q b , pb-restrict-retr a Q b))
