rec-bool :: (C : Bool → U) → C false → C true → (b : Bool) → C b
rec-bool C cf ct = Bool_ind(cf,ct)

ind-bool :: (C : U) → C → C → Bool → C
ind-bool C cf ct = Bool_ind(cf,ct)

bnot : Bool → Bool
bnot = Bool_ind(true,false)

band : Bool → Bool → Bool
band = Bool_ind(fun _ → false,fun b → b)

bor : Bool → Bool → Bool
bor = Bool_ind(fun b → b,fun _ → true)
