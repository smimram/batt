---
--- Operations on lists.
---

open import Equality
open import Nat

-- Length
length ∷ {A : Type} → List A → ℕ
length nil = zero
length (cons _ l) = succ rec

-- Concatenation
concat ∷ {A : Type} → List A → List A → List A
concat nil m = m
concat (cons x l) m = cons x (rec m)

-- Map
map ∷ {A B : Type} → (A → B) → List A → List B
map f nil = nil
map f (cons x l) = cons (f x) rec

-- Reversal
rev ∷ {A : Type} → List A → List A
rev nil = nil
rev (cons x l) = concat rec (cons x nil)
