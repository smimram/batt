open import Contr

is-prop :: U → U
is-prop A = (a b : A) → is-contr (a ≡ b)

Prop :: TYPE
Prop = Σ (A : U) . is-prop A

type-Prop :: Prop → U
type-Prop (A, p) = A

-- open import equality

