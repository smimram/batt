open import Contr

is-prop :: U → U
is-prop A = (a b : A) → is-contr (a ≡ b)

HProp :: TYPE
HProp = Σ (A : U) . is-prop A

type-Prop :: HProp → U
type-Prop (A, p) = A

-- open import equality

-- is-contr→is-prop :: {A :: Type} → is-contr A → is-prop A
-- is-contr→is-prop (a , p) x y = (trans (sym (p x)) (p y) , ?)