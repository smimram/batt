open import Equality

-- Predecessor
pred ∷ ℕ → ℕ
pred zero = zero
pred (succ n) = n

-- Addition
add ∷ ℕ → ℕ → ℕ
add m zero = m
add m (succ n) = succ rec

zero-add ∷ (n : ℕ) → add zero n ≡ n
zero-add zero = refl
zero-add (succ n) = cong succ rec

add-assoc ∷ (l m n : ℕ) → add (add l m) n ≡ add l (add m n)
add-assoc l m zero = refl
add-assoc l m (succ n) = cong succ rec
