--
-- Natural numbers
--
-- Eliminators (including oplax and lax recursion), arithmetic and order.
--

open import Equality
open import Product
open import Sigma

-- Dependent eliminator
ind ∷ (A : ℕ → U) → A zero → ((n : ℕ) → A n → A (succ n)) → (n : ℕ) → A n
ind A z s zero = z
ind A z s (succ n) = s n rec

-- Recursor
rec ∷ {A : U} → A → (ℕ → A → A) → ℕ → A
rec {A} z s = ind (λ _ . A) z s

-- Predecessor
pred ∷ ℕ → ℕ
pred zero = zero
pred (succ n) = n

-- Addition
add ∷ ℕ → ℕ → ℕ
add m zero = m
add m (succ n) = succ rec

zero-add ∷ (n : ℕ) → add zero n ≡ n
zero-add zero = refl
zero-add (succ n) = cong succ rec

add-assoc ∷ (l m n : ℕ) → add (add l m) n ≡ add l (add m n)
add-assoc l m zero = refl
add-assoc l m (succ n) = cong succ rec

-- Multiplication
mul ∷ ℕ → ℕ → ℕ
mul m zero = zero
mul m (succ n) = add rec m

one-mul ∷ (n : ℕ) → mul 1 n ≡ n
one-mul zero = refl
one-mul (succ n) = cong succ rec

mul-add ∷ (l m n : ℕ) → mul l (add m n) ≡ add (mul l m) (mul l n)
mul-add l m zero = refl
mul-add l m (succ n) = trans (cong (λ x . add x l) rec) (add-assoc (mul l m) (mul l n) l)

mul-assoc ∷ (l m n : ℕ) → mul (mul l m) n ≡ mul l (mul m n)
mul-assoc l m zero = refl
mul-assoc l m (succ n) = trans (cong (λ x . add x (mul l m)) rec) (sym (mul-add l (mul m n) m))

-- Order

le-succ ∷ (ℕ → U) → ℕ → U
le-succ r zero = ⊥
le-succ r (succ n) = r n

le ∷ ℕ → ℕ → U
le zero n = ⊤
le (succ m) n = le-succ rec n

lt ∷ ℕ → ℕ → U
lt m n = le (succ m) n

---
--- r/l nat recursion, derived from ordinary recursion
---

recᵣ-family ∷ (A ∷ U) → ℕ → (A × (ℕ → A → A)) →ₗ A
recᵣ-family A zero = λ w . Product.fst {A} {ℕ → A → A} w
recᵣ-family A (succ n) = λ w . Product.snd {A} {ℕ → A → A} w n (rec w)

-- oplax recursion
recᵣ ∷ (A ∷ U) → A → (ℕ → A → A) → (ℕ →ᵣ A)
recᵣ A z s =
  let E ∷ ℕ → (A × (ℕ → A → A)) →ₗ A = recᵣ-family A in
  λ n . E n (z , s)

recᵣ-zero ∷ (A ∷ U) (z : A) (s : ℕ → A → A) → recᵣ A z s 0 ≡ z
recᵣ-zero A z s = refl

recᵣ-succ ∷ (A ∷ U) (z : A) (s : ℕ → A → A) (n ∷ ℕ) → recᵣ A z s (succ n) ≡ s n (recᵣ A z s n)
recᵣ-succ A z s n = refl

recᵣ-succ' ∷ (A ∷ U) (z : A) (s : ℕ → A → A) →
  (λ n . recᵣ A z s (succ n)) ≡{ℕ →ᵣ A} (λ n . s n (recᵣ A z s n))
recᵣ-succ' A z s = refl

recₗ-family ∷ (A ∷ U) → ℕ → (A × (ℕ → A → A)) →ᵣ A
recₗ-family A zero = λ w . Product.fst {A} {ℕ → A → A} w
recₗ-family A (succ n) = λ w . Product.snd {A} {ℕ → A → A} w n (rec w)

-- lax recursion
recₗ ∷ (A ∷ U) → A → (ℕ → A → A) → (ℕ →ₗ A)
recₗ A z s =
  let E ∷ ℕ → (A × (ℕ → A → A)) →ᵣ A = recₗ-family A in
  λ n . E n (z , s)

recₗ-zero ∷ (A ∷ U) (z : A) (s : ℕ → A → A) → recₗ A z s 0 ≡ z
recₗ-zero A z s = refl

recₗ-succ ∷ (A ∷ U) (z : A) (s : ℕ → A → A) (n ∷ ℕ) → recₗ A z s (succ n) ≡ s n (recₗ A z s n)
recₗ-succ A z s n = refl

recₗ-succ' ∷ (A ∷ U) (z : A) (s : ℕ → A → A) →
  (λ n . recₗ A z s (succ n)) ≡{ℕ →ₗ A} (λ n . s n (recₗ A z s n))
recₗ-succ' A z s = refl
