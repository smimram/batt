open import Equality
open import Product

-- Dependent eliminator
ind ∷ (C : ℕ → U) → C zero → ((n : ℕ) → C n → C (succ n)) → (n : ℕ) → C n
ind C z s zero = z
ind C z s (succ n) = s n rec

-- Recursor
rec ∷ {C : U} → C → (ℕ → C → C) → ℕ → C
rec {C} z s = ind (λ _ . C) z s

-- Predecessor
pred ∷ ℕ → ℕ
pred zero = zero
pred (succ n) = n

-- Addition
add ∷ ℕ → ℕ → ℕ
add m zero = m
add m (succ n) = succ rec

zero-add ∷ (n : ℕ) → add zero n ≡ n
zero-add zero = refl
zero-add (succ n) = cong succ rec

add-assoc ∷ (l m n : ℕ) → add (add l m) n ≡ add l (add m n)
add-assoc l m zero = refl
add-assoc l m (succ n) = cong succ rec

-- Multiplication
mul ∷ ℕ → ℕ → ℕ
mul m zero = zero
mul m (succ n) = add rec m

one-mul ∷ (n : ℕ) → mul 1 n ≡ n
one-mul zero = refl
one-mul (succ n) = cong succ rec

mul-add ∷ (l m n : ℕ) → mul l (add m n) ≡ add (mul l m) (mul l n)
mul-add l m zero = refl
mul-add l m (succ n) = trans (cong (λ x . add x l) rec) (add-assoc (mul l m) (mul l n) l)

mul-assoc ∷ (l m n : ℕ) → mul (mul l m) n ≡ mul l (mul m n)
mul-assoc l m zero = refl
mul-assoc l m (succ n) = trans (cong (λ x . add x (mul l m)) rec) (sym (mul-add l (mul m n) m))

-- Order

le-succ ∷ (ℕ → U) → ℕ → U
le-succ r zero = ⊥
le-succ r (succ n) = r n

le ∷ ℕ → ℕ → U
le zero n = ⊤
le (succ m) n = le-succ rec n

lt ∷ ℕ → ℕ → U
lt m n = le (succ m) n

---
--- r/l nat recursion, derived from ordinary recursion
---

recᵣ-family ∷ (C ∷ U) → ℕ → (C × (ℕ → C → C)) →ₗ C
recᵣ-family C zero = λ w . prod-fst {C} {ℕ → C → C} w
recᵣ-family C (succ n) = λ w . prod-snd {C} {ℕ → C → C} w n (rec w)

-- oplax recursion
recᵣ ∷ (C ∷ U) → C → (ℕ → C → C) → (ℕ →ᵣ C)
recᵣ C z s =
  let E ∷ ℕ → (C × (ℕ → C → C)) →ₗ C = recᵣ-family C in
  λ n . E n (z , s)

recᵣ-zero ∷ (C ∷ U) (z : C) (s : ℕ → C → C) → recᵣ C z s 0 ≡ z
recᵣ-zero C z s = refl

recᵣ-succ ∷ (C ∷ U) (z : C) (s : ℕ → C → C) (n ∷ ℕ) → recᵣ C z s (succ n) ≡ s n (recᵣ C z s n)
recᵣ-succ C z s n = refl

recᵣ-succ' ∷ (C ∷ U) (z : C) (s : ℕ → C → C) →
  (λ n . recᵣ C z s (succ n)) ≡{ℕ →ᵣ C} (λ n . s n (recᵣ C z s n))
recᵣ-succ' C z s = refl

recₗ-family ∷ (C ∷ U) → ℕ → (C × (ℕ → C → C)) →ᵣ C
recₗ-family C zero = λ w . prod-fst {C} {ℕ → C → C} w
recₗ-family C (succ n) = λ w . prod-snd {C} {ℕ → C → C} w n (rec w)

-- lax recursion
recₗ ∷ (C ∷ U) → C → (ℕ → C → C) → (ℕ →ₗ C)
recₗ C z s =
  let E ∷ ℕ → (C × (ℕ → C → C)) →ᵣ C = recₗ-family C in
  λ n . E n (z , s)

recₗ-zero ∷ (C ∷ U) (z : C) (s : ℕ → C → C) → recₗ C z s 0 ≡ z
recₗ-zero C z s = refl

recₗ-succ ∷ (C ∷ U) (z : C) (s : ℕ → C → C) (n ∷ ℕ) → recₗ C z s (succ n) ≡ s n (recₗ C z s n)
recₗ-succ C z s n = refl

recₗ-succ' ∷ (C ∷ U) (z : C) (s : ℕ → C → C) →
  (λ n . recₗ C z s (succ n)) ≡{ℕ →ₗ C} (λ n . s n (recₗ C z s n))
recₗ-succ' C z s = refl
