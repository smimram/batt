--
-- Subtypes
--

open import Prop
open import HProp

-- A subtype of a type
subtype ∷ (X : U) → TYPE
subtype X = X → hProp

-- Whether an element belongs to a subtype
belongs ∷ {X : U} → X → subtype X → U
belongs x A = ⟨ A x ⟩

-- Collection of elements of a subtype
type ∷ {X : U} → subtype X → U
type A = Σ (x : X) . x ∈ A

-- A point in a subtype
pt ∷ {X : U} {A : subtype X} {x : X} → x ∈ A → ⟨ A ⟩
pt {X} {A} {x} a = (x , a)
