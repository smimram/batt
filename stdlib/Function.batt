--
-- Functions
--
-- Identity, composition, pre- and postcomposition and fibres, for cartesian, oplax (→ᵣ) and
-- lax (→ₗ) functions.
--

---
--- Regular functions
---

-- polymorphic identity
id ∷ {A : U} → A → A
id x = x

-- composition
circ ∷ {A B C : U} → (B → C) → (A → B) → (A → C)
circ g f a = g (f a)

-- Pre- and postcomposition all follow one pattern: for f : A → B and g : B → C,
--   post A g f = g ∘ f   (g fixed, f varies)      pre A g f = g ∘ f   (f fixed, g varies)
-- with the domain A explicit and first, B and C implicit, arguments in composition order.
-- For ordinary functions the two coincide; they differ for →ᵣ and →ₗ below.

-- postcomposition
post ∷ {A B C : U} → (B → C) → (A → B) → (A → C)
post g f a = g (f a)

-- precomposition
pre ∷ (A : U) {B C : U} → (B → C) → (A → B) → (A → C)
pre A g f a = g (f a)

-- constant
const ∷ {A : U} → {B : U} → (b : B) → A → B
const b _ = b

-- fibers
fib ∷ {A B : U} → (A → B) → B → U
fib {A} f y = Σ (x : A) . f x ≡ y

---
--- Directed functions
---

-- one direction only swaps
right-strong-swap ∷ {A B C ∷ U} → (A →ᵣ B → C) → (B → A →ᵣ C)
right-strong-swap f b a = f a b

left-strong-swap ∷ {A B C ∷ U} → (A →ₗ B → C) → (B → A →ₗ C)
left-strong-swap f b a = f a b

-- reversible swaps
right-left-swap ∷ {A B C ∷ U} → (A →ᵣ B →ₗ C) → (B →ₗ A →ᵣ C)
right-left-swap f b a = f a b

left-right-swap ∷ {A B C ∷ U} → (A →ₗ B →ᵣ C) → (B →ᵣ A →ₗ C)
left-right-swap f b a = f a b

-- crisp swaps: a crisp family of lax (resp. oplax) maps indexed by A is a family of oplax
-- (resp. lax) maps indexed by B; the converse direction is not internal (f would be used on both
-- sides of the tensor), but on global points both are inverse to each other
crisp-swapₗᵣ ∷ {A B C ∷ U} (f ∷ A → B →ₗ C) → B → A →ᵣ C
crisp-swapₗᵣ f b a = f a b

crisp-swapᵣₗ ∷ {A B C ∷ U} (f ∷ A → B →ᵣ C) → B → A →ₗ C
crisp-swapᵣₗ f b a = f a b

-- r-postcomposition: postᵣ A g f = g ∘ f
postᵣ ∷ {A B C ∷ U} → (B → C) → (A →ᵣ B) → (A →ᵣ C)
postᵣ g f a = g (f a)

-- l-postcomposition: postₗ A g f = g ∘ f
postₗ ∷ {A B C ∷ U} → (B → C) → (A →ₗ B) → (A →ₗ C)
postₗ g f a = g (f a)

-- r-precomposition: preᵣ A g f = g ∘ f.
preᵣ ∷ {A B C ∷ U} → (B →ᵣ C) → (A → B) →ᵣ (A →ᵣ C)
preᵣ g f a = g (f a)

-- l-precomposition: preₗ A g f = g ∘ f
preₗ ∷ {A B C ∷ U} → (B →ₗ C) → (A → B) →ₗ (A →ₗ C)
preₗ g f a = g (f a)
