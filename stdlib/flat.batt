--- Formalizing Shulman 2017

-- Lemma 4.4
-- flat-unique : (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → ((λ 𝄫u → f 𝄫 u) x) ≡ f x
-- flat-unique A C f 𝄫x = refl

-- -- Lemma 5.2
-- flat-commutation : (A : Type) (B : ♭A → Type) (M : ♭A) (N : (u : A) → B 𝄫u) →

flat-eta :: (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → C x
flat-eta A C f 𝄫x = f 𝄫x

flat-unique :: (A :: Type) (C : ♭A → Type) (f : (x : ♭A) → C x) (x : ♭A) → flat-eta A C f x ≡ f x
flat-unique A C f 𝄫x = refl

-- TODO: dependent version?
flat-map :: (A :: Type) (B :: Type) (f :: A → B) → ♭A → ♭B
flat-map A B f 𝄫a = 𝄫(f a)
