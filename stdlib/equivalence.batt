open import product
open import function

---
--- sections and retractions
---

is-section ∷ {A B : U} → (A → B) → (B → A) → U
is-section {A} {B} f s = (y : B) → f (s y) ≡ y

section ∷ {A B : U} → (A → B) → U
section {A} {B} f = Σ (s : B → A) . is-section {A} {B} f s

map-section ∷ {A B : U} (f : A → B) → section {A} {B} f → B → A
map-section f s' = fst _ s'

is-retraction ∷ {A B : U} → (A → B) → (B → A) → U
is-retraction {A} {B} f r = (x : A) → r (f x) ≡ x

retraction ∷ {A B : U} → (A → B) → U
retraction {A} {B} f = Σ (r : B → A) . is-retraction {A} {B} f r

map-retraction ∷ {A B : U} (f : A → B) → retraction f → B → A
map-retraction f r' = fst _ r'

---
--- equivalences
---

-- proof of equivalence

is-equiv ∷ {A B : U} → (A → B) → U
is-equiv f = section f × retraction f

-- sections and retraction obtained from a proof of equivalence

section-is-equiv ∷ {A B : U} (f : A → B) → is-equiv {A} {B} f → section {A} {B} f
section-is-equiv f (s, _) = s

map-section-is-equiv ∷ {A B : U} (f : A → B) → is-equiv {A} {B} f → B → A
map-section-is-equiv {A} {B} f (s', _) = map-section {A} {B} f s'

retraction-is-equiv ∷ {A B : U} (f : A → B) → is-equiv {A} {B} f → retraction {A} {B} f
retraction-is-equiv f (_, r) = r

map-retraction-is-equiv ∷ {A B : U} (f : A → B) → is-equiv f → B → A
map-retraction-is-equiv f (_, r') = map-retraction f r'

-- type of equivalences

equiv ∷ U → U → U
equiv A B = Σ (f : A → B) . is-equiv f

-- identity equivalence

is-equiv-id ∷ (A : U) → is-equiv {A} {A} id
is-equiv-id A = ((id , λ_.refl) , (id , λ_.refl))

id-equiv ∷ (A : U) → equiv A A
id-equiv A = (id , is-equiv-id A)

---
--- isomorphisms
---

is-iso :: {A B : U} → (A → B) → U
is-iso {A} {B} f = Σ (g : B → A) . (is-section f g) × (is-retraction {A} {B} f g)

is-iso→is-equiv :: {A B : U} → (f : A → B) → is-iso {A} {B} f → is-equiv {A} {B} f
is-iso→is-equiv f (g , sr) = (g , prod-fst sr) , (g , prod-snd sr)
