-- test η-conversion

f : bool → bool
f = ?

r : f ≡ f
r = refl

g : bool → bool
g = f

r : f ≡ g
r = refl

h : bool → bool
h x = f x

r : f ≡ h
r = refl

-- eta for tensors

eta ∷ {A B C ∷ U} → ((A ⨂ B) → C) → ((A ⨂ B) → C)
eta f (a ⊗ b) = f (a ⊗ b)

r ∷ {A B C ∷ U} (f : (A ⨂ B) → C) → f ≡ eta f
r f = refl
