open import Stdlib

-- Use sites of the derived oplax/lax eliminators of sum and ℕ (Sum.batt, Nat.batt).

-- a branch capturing a non-crisp oplax map k and a non-crisp point c
caseᵣ ∷ (A C ∷ U) → (k : A →ᵣ C) → (c : C) → (sum A ⊤ →ᵣ C)
caseᵣ A C k c = Sum.recᵣ A ⊤ C k (λ _ . c)

-- the scrutinee on the other side of the split from the branches
caseᵣ-app ∷ (A C ∷ U) → (k : A →ᵣ C) → (c : C) → (sum A ⊤ →ᵣ C)
caseᵣ-app A C k c = λ u . Sum.recᵣ A ⊤ C k (λ _ . c) u

caseₗ ∷ (A C ∷ U) → (k : A →ₗ C) → (c : C) → (sum A ⊤ →ₗ C)
caseₗ A C k c = λ u . Sum.recₗ A ⊤ C k (λ _ . c) u

-- iterating a non-crisp endofunction, oplax and lax in the index
iterᵣ ∷ (C ∷ U) → (C → C) → C → (ℕ →ᵣ C)
iterᵣ C f x = Nat.recᵣ C x (λ _ c . f c)

iterₗ ∷ (C ∷ U) → (C → C) → C → (ℕ →ₗ C)
iterₗ C f x = Nat.recₗ C x (λ _ c . f c)

iterᵣ-2 ∷ (C ∷ U) (f : C → C) (x : C) → iterᵣ C f x 2 ≡ f (f x)
iterᵣ-2 C f x = refl

iterₗ-2 ∷ (C ∷ U) (f : C → C) (x : C) → iterₗ C f x 2 ≡ f (f x)
iterₗ-2 C f x = refl
