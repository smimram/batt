-- Should type-check, but fails with
--   Error: ... line 15 characters 2-5, term has type (((?0 (x-0 x-1)) x-1) x-0) but Type expected
--
-- The implicit argument of id' becomes a metavariable created under the let. It is applied to
-- the let-bound *value* f b instead of the variable a, so its spine is not a pattern and
-- unification gives up. It works if the implicit is given (id' {bool} b) or if the let-bound
-- value is a variable or a constant (let a : bool = b, let a : bool = true).

id' ∷ {A : U} → A → A
id' x = x

let-meta ∷ (f : bool → bool) (b : bool) → bool
let-meta f b =
  let a : bool = f b in
  id' b
