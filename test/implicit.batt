id : {A : U} → A → A
id {A} x = x

id : {A : U} → A → A
id x = x

b : bool
b = id false

comp : {A B C : U} → (B → C) → (A → B) → (A → C)
comp g f a = g (f a)

not : bool → bool
not = bool_ind(false, true)

f : bool → bool
f = comp not (id {bool})

double : {A : U} → (A → A) → (A → A)
double f = comp f f

test : ((⊤ → ⊤) → bool) → bool
test f = f id
