id : {A : U} → A → A
id {A} x = x

id : {A : U} → A → A
id x = x

b : Bool
b = id false

comp : {A B C : U} → (B → C) → (A → B) → (A → C)
comp g f a = g (f a)

not : Bool → Bool
not = Bool_ind(false, true)

f : Bool → Bool
f = comp not (id {Bool})

double : {A : U} → (A → A) → (A → A)
double f = comp f f

test : ((⊤ → ⊤) → Bool) → Bool
test f = f id
