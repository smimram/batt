-- identity on Bool
idbool : Bool → Bool
idbool x = x

idbool' : Bool → Bool
idbool' false = false
idbool' true  = true

idbool'IsId : (b : Bool) → idbool' b ≡ b
idbool'IsId false = refl
idbool'IsId true = refl

-- definitions by multiple clauses
not : Bool → Bool
not false = true
not true  = false

and : Bool → Bool → Bool
and false _ = false
and true  b = b

or : Bool → Bool → Bool
or b false = b
or _ true  = true

xor : Bool → Bool → Bool
xor false x = x
xor true  y = not y

notnot : (b : Bool) → not (not b) ≡ b
notnot false = refl
notnot true  = refl

andfalse : (b : Bool) → and b false ≡ false
andfalse false = refl
andfalse true  = refl
