import Bool

import Bool

f : Bool → Bool → Bool
f = Bool.or

open Bool

f : Bool → Bool → Bool
f = or

x = record
  n : ℕ
  n = 5

  b : Bool
  b = false
end

y : ℕ
y = x.n

z : Bool
z = x.b

-- nested records and records referring to previous fields
w = record
  m : ℕ
  m = succ 3

  inner = record
    p : ℕ
    p = m
  end

  q : ℕ
  q = inner.p
end

w' : w.q ≡ 4
w' = refl

open x

n' : n ≡ 5
n' = refl
