--
-- Lax and oplax universal properties of pushouts
--
-- A crisp commuting square that is a pushout for ordinary maps is also a pushout for oplax and lax
-- maps (is-pushout→is-pushoutᵣ, is-pushout→is-pushoutₗ); in particular so is the pushout itself
-- (pushout-oplax-up, pushout-lax-up).
--
-- Proof: by the objectwise equivalence axiom, it suffices to compare global points of grids, where
-- lax currying reduces oplax cocones to ordinary cocones in a type of lax maps.
--
-- Postulates relied on: objectwise-equiv, pushout-up, univalence.
--

open import Stdlib
open import Axiom

--
-- Cocones curried along T
--

-- T-indexed oplax cocones, as a single Σ
curried-coconeᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → U
curried-coconeᵣ T {X} {A} {B} f g Y =
  Σ (α : T → A →ᵣ Y) . Σ (β : T → B →ᵣ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))

-- cocones in maps out of T ⨂ −
cocone-tensᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → U
cocone-tensᵣ T {X} {A} {B} f g Y =
  Σ (α : T ⨂ A → Y) . Σ (β : T ⨂ B → Y) .
    (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))

-- lax currying: to cocones in T →ₗ Y
cocone-tensᵣ→cocone-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α : T ⨂ A → Y) →
  (Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))) →
  Σ (β : B → T →ₗ Y) . (λ x . tens-curry-left' {T} {A} {Y} α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))
cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y α (β , p) = (tens-curry-left' {T} {B} {Y} β , cong (tens-curry-left' {T} {X} {Y}) p)

cocone-tensᵣ→cocone ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → cocone-tensᵣ T {X} {A} {B} f g Y → cocone {X} {A} {B} f g (T →ₗ Y)
cocone-tensᵣ→cocone T {X} {A} {B} f g Y =
  flat-Σ-map {T ⨂ A → Y} {A → T →ₗ Y}
    {λ α . Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
    {λ α' . Σ (β : B → T →ₗ Y) . (λ x . α' (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))}
    (tens-curry-left' {T} {A} {Y}) (cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y)

-- oplax currying: to T-indexed oplax cocones
cocone-tensᵣ→curried-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α : T ⨂ A → Y) →
  (Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))) →
  Σ (β : T → B →ᵣ Y) . (λ t . λ x . tens-curry-right' {T} {A} {Y} α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))
cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y α (β , p) = (tens-curry-right' {T} {B} {Y} β , cong (tens-curry-right' {T} {X} {Y}) p)

cocone-tensᵣ→curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → cocone-tensᵣ T {X} {A} {B} f g Y → curried-coconeᵣ T {X} {A} {B} f g Y
cocone-tensᵣ→curried T {X} {A} {B} f g Y =
  flat-Σ-map {T ⨂ A → Y} {T → A →ᵣ Y}
    {λ α . Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
    {λ α' . Σ (β : T → B →ᵣ Y) . (λ t . λ x . α' t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))}
    (tens-curry-right' {T} {A} {Y}) (cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y)

-- distributing T over the Σ (a genuine equivalence, by funext)
curried→coconesᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → curried-coconeᵣ T {X} {A} {B} f g Y → T → coconeᵣ {X} {A} {B} f g Y
curried→coconesᵣ T {X} {A} {B} f g Y (α , r) =
  let k : (r : Σ (β : T → B →ᵣ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))) → T → coconeᵣ {X} {A} {B} f g Y =
    fun (β , p) → λ t . (α t , β t , happly {T} {λ _ . X →ᵣ Y} {λ t' . λ x . α t' (f x)} {λ t' . λ x . β t' (g x)} p t) in
  k r

cocones→curriedᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → (T → coconeᵣ {X} {A} {B} f g Y) → curried-coconeᵣ T {X} {A} {B} f g Y
cocones→curriedᵣ T {X} {A} {B} f g Y F =
  let α : T → A →ᵣ Y = λ t . coconeᵣ-fst {X} {A} {B} f g Y (F t) in
  let β : T → B →ᵣ Y = λ t . coconeᵣ-snd {X} {A} {B} f g Y (F t) in
  (α , β , funext-htpy {T} {λ _ . X →ᵣ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) (λ t . coconeᵣ-glue {X} {A} {B} f g Y (F t)))

curried→coconesᵣ-sec ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (F : T → coconeᵣ {X} {A} {B} f g Y) →
  curried→coconesᵣ T {X} {A} {B} f g Y (cocones→curriedᵣ T {X} {A} {B} f g Y F) ≡ F
curried→coconesᵣ-sec T {X} {A} {B} f g Y F =
  let α : T → A →ᵣ Y = λ t . coconeᵣ-fst {X} {A} {B} f g Y (F t) in
  let β : T → B →ᵣ Y = λ t . coconeᵣ-snd {X} {A} {B} f g Y (F t) in
  let s : (t : T) → (λ x . α t (f x)) ≡{X →ᵣ Y} (λ x . β t (g x)) = λ t . coconeᵣ-glue {X} {A} {B} f g Y (F t) in
  let hs : happly {T} {λ _ . X →ᵣ Y} {λ t . λ x . α t (f x)} {λ t . λ x . β t (g x)}
             (funext-htpy {T} {λ _ . X →ᵣ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) s) ≡ s =
    happly-funext-htpy {T} {λ _ . X →ᵣ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) s in
  funext-htpy {T} {λ _ . coconeᵣ {X} {A} {B} f g Y} (curried→coconesᵣ T {X} {A} {B} f g Y (cocones→curriedᵣ T {X} {A} {B} f g Y F)) F
    (λ t . trans (cong {(λ x . α t (f x)) ≡{X →ᵣ Y} (λ x . β t (g x))} {coconeᵣ {X} {A} {B} f g Y}
                   (λ p . (α t , β t , p))
                   (happly {T} {λ t' . (λ x . α t' (f x)) ≡{X →ᵣ Y} (λ x . β t' (g x))} hs t))
             (coconeᵣ-eta {X} {A} {B} f g Y (F t)))

curried→coconesᵣ-retr ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (d : curried-coconeᵣ T {X} {A} {B} f g Y) →
  cocones→curriedᵣ T {X} {A} {B} f g Y (curried→coconesᵣ T {X} {A} {B} f g Y d) ≡ d
curried→coconesᵣ-retr T {X} {A} {B} f g Y (α , r) =
  let k : (r : Σ (β : T → B →ᵣ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))) →
      cocones→curriedᵣ T {X} {A} {B} f g Y (curried→coconesᵣ T {X} {A} {B} f g Y (α , r)) ≡ (α , r) =
    fun (β , p) →
      cong {(λ t . λ x . α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))} {curried-coconeᵣ T {X} {A} {B} f g Y}
        (λ p' . (α , β , p'))
        (funext-htpy-happly {T} {λ _ . X →ᵣ Y} {λ t . λ x . α t (f x)} {λ t . λ x . β t (g x)} p) in
  k r

is-equiv-curried→coconesᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → is-equiv (curried→coconesᵣ T {X} {A} {B} f g Y)
is-equiv-curried→coconesᵣ T {X} {A} {B} f g Y =
  ((cocones→curriedᵣ T {X} {A} {B} f g Y , curried→coconesᵣ-sec T {X} {A} {B} f g Y) ,
   (cocones→curriedᵣ T {X} {A} {B} f g Y , curried→coconesᵣ-retr T {X} {A} {B} f g Y))

-- the two currying maps are equivalences on global points
is-equiv-flat-cocone-tensᵣ→cocone-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α ∷ T ⨂ A → Y) →
  is-equiv (flat-map {Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
                     {Σ (β : B → T →ₗ Y) . (λ x . tens-curry-left' {T} {A} {Y} α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))}
                     (cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y α))
is-equiv-flat-cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y α =
  let S ∷ T ⨂ X → Y = λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z) in
  let src ∷ U = Σ (β : T ⨂ B → Y) . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)) in
  let tgt ∷ U = Σ (β : B → T →ₗ Y) . (λ x . tens-curry-left' {T} {A} {Y} α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x)) in
  let m ∷ src → tgt =
    flat-Σ-map {T ⨂ B → Y} {B → T →ₗ Y} {λ β . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
      {λ β . (λ x . tens-curry-left' {T} {A} {Y} α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))}
      (tens-curry-left' {T} {B} {Y}) (λ β . cong (tens-curry-left' {T} {X} {Y}) {S} {λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)}) in
  is-equiv-htpy {♭ src} {♭ tgt} {flat-map {src} {tgt} m} {flat-map {src} {tgt} (cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y α)}
    (fun 𝄫w → let h : (w ∷ src) → flat-map {src} {tgt} m 𝄫w ≡ flat-map {src} {tgt} (cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y α) 𝄫w =
                fun (β , p) → refl in h w)
    (flat-Σ-map-equiv {T ⨂ B → Y} {B → T →ₗ Y} {λ β . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
      {λ β . (λ x . tens-curry-left' {T} {A} {Y} α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))}
      (tens-curry-left' {T} {B} {Y}) (λ β . cong (tens-curry-left' {T} {X} {Y}) {S} {λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)})
      (is-equiv-flat-tens-uncurryₗ {T} {B} {Y})
      (λ β . flat-cong-equiv (tens-curry-left' {T} {X} {Y}) (is-equiv-flat-tens-uncurryₗ {T} {X} {Y})
               S (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))))

is-equiv-flat-cocone-tensᵣ→cocone ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  is-equiv (flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-tensᵣ→cocone T {X} {A} {B} f g Y))
is-equiv-flat-cocone-tensᵣ→cocone T {X} {A} {B} f g Y =
  flat-Σ-map-equiv {T ⨂ A → Y} {A → T →ₗ Y}
    {λ α . Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
    {λ α' . Σ (β : B → T →ₗ Y) . (λ x . α' (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))}
    (tens-curry-left' {T} {A} {Y}) (cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y)
    (is-equiv-flat-tens-uncurryₗ {T} {A} {Y})
    (is-equiv-flat-cocone-tensᵣ→cocone-fib T {X} {A} {B} f g Y)

is-equiv-flat-cocone-tensᵣ→curried-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α ∷ T ⨂ A → Y) →
  is-equiv (flat-map {Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
                     {Σ (β : T → B →ᵣ Y) . (λ t . λ x . tens-curry-right' {T} {A} {Y} α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))}
                     (cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y α))
is-equiv-flat-cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y α =
  let S ∷ T ⨂ X → Y = λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z) in
  let src ∷ U = Σ (β : T ⨂ B → Y) . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)) in
  let tgt ∷ U = Σ (β : T → B →ᵣ Y) . (λ t . λ x . tens-curry-right' {T} {A} {Y} α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x)) in
  let m ∷ src → tgt =
    flat-Σ-map {T ⨂ B → Y} {T → B →ᵣ Y} {λ β . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
      {λ β . (λ t . λ x . tens-curry-right' {T} {A} {Y} α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))}
      (tens-curry-right' {T} {B} {Y}) (λ β . cong (tens-curry-right' {T} {X} {Y}) {S} {λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)}) in
  is-equiv-htpy {♭ src} {♭ tgt} {flat-map {src} {tgt} m} {flat-map {src} {tgt} (cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y α)}
    (fun 𝄫w → let h : (w ∷ src) → flat-map {src} {tgt} m 𝄫w ≡ flat-map {src} {tgt} (cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y α) 𝄫w =
                fun (β , p) → refl in h w)
    (flat-Σ-map-equiv {T ⨂ B → Y} {T → B →ᵣ Y} {λ β . S ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
      {λ β . (λ t . λ x . tens-curry-right' {T} {A} {Y} α t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))}
      (tens-curry-right' {T} {B} {Y}) (λ β . cong (tens-curry-right' {T} {X} {Y}) {S} {λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z)})
      (is-equiv-flat-tens-uncurryᵣ {T} {B} {Y})
      (λ β . flat-cong-equiv (tens-curry-right' {T} {X} {Y}) (is-equiv-flat-tens-uncurryᵣ {T} {X} {Y})
               S (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))))

is-equiv-flat-cocone-tensᵣ→curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  is-equiv (flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {curried-coconeᵣ T {X} {A} {B} f g Y} (cocone-tensᵣ→curried T {X} {A} {B} f g Y))
is-equiv-flat-cocone-tensᵣ→curried T {X} {A} {B} f g Y =
  flat-Σ-map-equiv {T ⨂ A → Y} {T → A →ᵣ Y}
    {λ α . Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))}
    {λ α' . Σ (β : T → B →ᵣ Y) . (λ t . λ x . α' t (f x)) ≡{T → X →ᵣ Y} (λ t . λ x . β t (g x))}
    (tens-curry-right' {T} {A} {Y}) (cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y)
    (is-equiv-flat-tens-uncurryᵣ {T} {A} {Y})
    (is-equiv-flat-cocone-tensᵣ→curried-fib T {X} {A} {B} f g Y)

--
-- Swapping arguments on global points
--

-- a crisp cocone in T →ₗ Y gives a T-indexed family of oplax cocones, by swapping the arguments
-- (crisp only: see crisp-swapₗᵣ, Function.batt)
cocone-swapᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (c ∷ cocone {X} {A} {B} f g (T →ₗ Y)) → T → coconeᵣ {X} {A} {B} f g Y
cocone-swapᵣ T {X} {A} {B} f g Y (α , r) =
  let k : (r ∷ Σ (β : B → T →ₗ Y) . (λ x . α (f x)) ≡{X → T →ₗ Y} (λ x . β (g x))) → T → coconeᵣ {X} {A} {B} f g Y =
    fun (β , p) → λ t .
      (λ a . α a t , λ b . β b t ,
       happly {T} {λ _ . X →ᵣ Y} {crisp-swapₗᵣ {X} {T} {Y} (λ x . α (f x))} {crisp-swapₗᵣ {X} {T} {Y} (λ x . β (g x))}
         (crisp-cong {X → T →ₗ Y} {T → X →ᵣ Y} (crisp-swapₗᵣ {X} {T} {Y}) p) t) in
  k r

flat-cocone-swapᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone {X} {A} {B} f g (T →ₗ Y)) → ♭(T → coconeᵣ {X} {A} {B} f g Y)
flat-cocone-swapᵣ T {X} {A} {B} f g Y 𝄫c = 𝄫(cocone-swapᵣ T {X} {A} {B} f g Y c)

cong-restr-swapᵣ ∷ {T X P Y ∷ U} (ψ ∷ T → P →ᵣ Y) {k₀ k₁ ∷ X → P} (q ∷ k₀ ≡ k₁) (t : T) →
  happly {T} {λ _ . X →ᵣ Y}
    {crisp-swapₗᵣ {X} {T} {Y} (post {X} {P} {T →ₗ Y} (tens-curry-left' {T} {P} {Y} (tens-uncurry-crispᵣ {T} {P} {Y} ψ)) k₀)}
    {crisp-swapₗᵣ {X} {T} {Y} (post {X} {P} {T →ₗ Y} (tens-curry-left' {T} {P} {Y} (tens-uncurry-crispᵣ {T} {P} {Y} ψ)) k₁)}
    (crisp-cong {X → T →ₗ Y} {T → X →ᵣ Y} (crisp-swapₗᵣ {X} {T} {Y})
      (cong {X → P} {X → T →ₗ Y} (post {X} {P} {T →ₗ Y} (tens-curry-left' {T} {P} {Y} (tens-uncurry-crispᵣ {T} {P} {Y} ψ))) q)) t
  ≡ congᵣ {X → P} {X →ᵣ Y} (preᵣ {X} {P} {Y} (ψ t)) q
cong-restr-swapᵣ {T} {X} {P} {Y} ψ {k₀} refl t = refl

--
-- The oplax universal property
--

-- the triangle: swapping identifies the two curried forms of cocones in maps out of T ⨂ −
flat-cocone-tensᵣ→cocones-curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone-tensᵣ T {X} {A} {B} f g Y) → ♭(T → coconeᵣ {X} {A} {B} f g Y)
flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y c =
  flat-map {curried-coconeᵣ T {X} {A} {B} f g Y} {T → coconeᵣ {X} {A} {B} f g Y} (curried→coconesᵣ T {X} {A} {B} f g Y)
    (flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {curried-coconeᵣ T {X} {A} {B} f g Y} (cocone-tensᵣ→curried T {X} {A} {B} f g Y) c)

flat-cocone-tensᵣ→cocones-swapped ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone-tensᵣ T {X} {A} {B} f g Y) → ♭(T → coconeᵣ {X} {A} {B} f g Y)
flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y c =
  flat-cocone-swapᵣ T {X} {A} {B} f g Y
    (flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-tensᵣ→cocone T {X} {A} {B} f g Y) c)

flat-cocone-tensᵣ-triangle ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (c : ♭(cocone-tensᵣ T {X} {A} {B} f g Y)) →
  flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y c ≡ flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y c
flat-cocone-tensᵣ-triangle T {X} {A} {B} f g Y 𝄫c =
  let h : (c ∷ cocone-tensᵣ T {X} {A} {B} f g Y) →
          flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y 𝄫c ≡ flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y 𝄫c =
    fun (α , r) →
      let h2 : (r ∷ Σ (β : T ⨂ B → Y) . (λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z)) ≡{T ⨂ X → Y} (λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z))) →
               flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y 𝄫(α , r) ≡ flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y 𝄫(α , r) =
        fun (β , p) →
          let S ∷ T ⨂ X → Y = λ z . α (tens-map {T} {T} {X} {A} (λ t . t) f z) in
          let S' ∷ T ⨂ X → Y = λ z . β (tens-map {T} {T} {X} {B} (λ t . t) g z) in
          let e ∷ (tens-curry-right' {T} {X} {Y} S) ≡{T → X →ᵣ Y} (tens-curry-right' {T} {X} {Y} S') =
            cong (tens-curry-right' {T} {X} {Y}) p in
          let e' ∷ (tens-curry-right' {T} {X} {Y} S) ≡{T → X →ᵣ Y} (tens-curry-right' {T} {X} {Y} S') =
            crisp-cong {X → T →ₗ Y} {T → X →ᵣ Y} (crisp-swapₗᵣ {X} {T} {Y}) (cong (tens-curry-left' {T} {X} {Y}) p) in
          flat-≡ {T → coconeᵣ {X} {A} {B} f g Y}
            (funext-htpy {T} {λ _ . coconeᵣ {X} {A} {B} f g Y}
              (λ t . (tens-curry-right' {T} {A} {Y} α t , tens-curry-right' {T} {B} {Y} β t ,
                      happly {T} {λ _ . X →ᵣ Y} {tens-curry-right' {T} {X} {Y} S} {tens-curry-right' {T} {X} {Y} S'} e t))
              (λ t . (tens-curry-right' {T} {A} {Y} α t , tens-curry-right' {T} {B} {Y} β t ,
                      happly {T} {λ _ . X →ᵣ Y} {tens-curry-right' {T} {X} {Y} S} {tens-curry-right' {T} {X} {Y} S'} e' t))
              (λ t . cong {tens-curry-right' {T} {X} {Y} S t ≡{X →ᵣ Y} tens-curry-right' {T} {X} {Y} S' t} {coconeᵣ {X} {A} {B} f g Y}
                       (λ s . (tens-curry-right' {T} {A} {Y} α t , tens-curry-right' {T} {B} {Y} β t , s))
                       (cong {(tens-curry-right' {T} {X} {Y} S) ≡{T → X →ᵣ Y} (tens-curry-right' {T} {X} {Y} S')}
                             {tens-curry-right' {T} {X} {Y} S t ≡{X →ᵣ Y} tens-curry-right' {T} {X} {Y} S' t}
                          (λ d . happly {T} {λ _ . X →ᵣ Y} {tens-curry-right' {T} {X} {Y} S} {tens-curry-right' {T} {X} {Y} S'} d t)
                          (cong-curry-swapₗᵣ {T} {X} {Y} {S} {S'} p)))) in
      h2 r in
  h c

-- swapping is an equivalence on global points
is-equiv-flat-cocone-swapᵣ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → is-equiv (flat-cocone-swapᵣ T {X} {A} {B} f g Y)
is-equiv-flat-cocone-swapᵣ T {X} {A} {B} f g Y =
  let L : ♭(cocone-tensᵣ T {X} {A} {B} f g Y) → ♭(cocone {X} {A} {B} f g (T →ₗ Y)) =
    flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-tensᵣ→cocone T {X} {A} {B} f g Y) in
  let eR : is-equiv (flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y) =
    is-equiv-circ {♭(cocone-tensᵣ T {X} {A} {B} f g Y)} {♭(curried-coconeᵣ T {X} {A} {B} f g Y)} {♭(T → coconeᵣ {X} {A} {B} f g Y)}
      (flat-map {curried-coconeᵣ T {X} {A} {B} f g Y} {T → coconeᵣ {X} {A} {B} f g Y} (curried→coconesᵣ T {X} {A} {B} f g Y))
      (flat-map {cocone-tensᵣ T {X} {A} {B} f g Y} {curried-coconeᵣ T {X} {A} {B} f g Y} (cocone-tensᵣ→curried T {X} {A} {B} f g Y))
      (flat-map-equiv {curried-coconeᵣ T {X} {A} {B} f g Y} {T → coconeᵣ {X} {A} {B} f g Y} (curried→coconesᵣ T {X} {A} {B} f g Y)
        (is-equiv-curried→coconesᵣ T {X} {A} {B} f g Y))
      (is-equiv-flat-cocone-tensᵣ→curried T {X} {A} {B} f g Y) in
  let eSL : is-equiv (flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y) =
    is-equiv-htpy {♭(cocone-tensᵣ T {X} {A} {B} f g Y)} {♭(T → coconeᵣ {X} {A} {B} f g Y)}
      {flat-cocone-tensᵣ→cocones-curried T {X} {A} {B} f g Y} {flat-cocone-tensᵣ→cocones-swapped T {X} {A} {B} f g Y}
      (flat-cocone-tensᵣ-triangle T {X} {A} {B} f g Y) eR in
  is-equiv-cancel-r {♭(cocone-tensᵣ T {X} {A} {B} f g Y)} {♭(cocone {X} {A} {B} f g (T →ₗ Y))} {♭(T → coconeᵣ {X} {A} {B} f g Y)}
    (flat-cocone-swapᵣ T {X} {A} {B} f g Y) L (is-equiv-flat-cocone-tensᵣ→cocone T {X} {A} {B} f g Y) eSL

-- on global points, the comparison map is swapping after the cartesian restriction (curried)
flat-cocone-restr-curriedᵣ ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (Y ∷ U) → ♭(T → P →ᵣ Y) → ♭(cocone {X} {A} {B} f g (T →ₗ Y))
flat-cocone-restr-curriedᵣ T {X} {A} {B} {P} f g i j q Y c =
  flat-map {P → T →ₗ Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ₗ Y))
    (flat-tens-uncurryₗ {T} {P} {Y} (flat-tens-curryᵣ {T} {P} {Y} c))

flat-cocone-restrᵣ-factored-htpy ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (Y ∷ U) (c : ♭(T → P →ᵣ Y)) →
  flat-cocone-swapᵣ T {X} {A} {B} f g Y (flat-cocone-restr-curriedᵣ T {X} {A} {B} {P} f g i j q Y c)
    ≡ flat-map {T → P →ᵣ Y} {T → coconeᵣ {X} {A} {B} f g Y}
        (post {T} {P →ᵣ Y} {coconeᵣ {X} {A} {B} f g Y} (cocone-restrᵣ {X} {A} {B} {P} f g i j q Y)) c
flat-cocone-restrᵣ-factored-htpy T {X} {A} {B} {P} f g i j q Y 𝄫ψ =
  let K ∷ P → T →ₗ Y = tens-curry-left' {T} {P} {Y} (tens-uncurry-crispᵣ {T} {P} {Y} ψ) in
  flat-≡ {T → coconeᵣ {X} {A} {B} f g Y}
    (funext-htpy {T} {λ _ . coconeᵣ {X} {A} {B} f g Y}
      (cocone-swapᵣ T {X} {A} {B} f g Y (cocone-restr {X} {A} {B} {P} f g i j q (T →ₗ Y) K))
      (λ t . cocone-restrᵣ {X} {A} {B} {P} f g i j q Y (ψ t))
      (λ t . cong {crisp-swapₗᵣ {X} {T} {Y} (post {X} {P} {T →ₗ Y} K (λ x . i (f x))) t ≡{X →ᵣ Y} crisp-swapₗᵣ {X} {T} {Y} (post {X} {P} {T →ₗ Y} K (λ x . j (g x))) t}
                  {coconeᵣ {X} {A} {B} f g Y}
               (λ s . ((λ a . ψ t (i a)) , (λ b . ψ t (j b)) , s))
               (cong-restr-swapᵣ {T} {X} {P} {Y} ψ {λ x . i (f x)} {λ x . j (g x)} q t)))

-- the comparison map is an equivalence on the global points of any crisp T
is-equiv-flat-post-cocone-restrᵣ ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (up ∷ is-pushout {X} {A} {B} {P} f g i j q) (Y ∷ U) →
  is-equiv (flat-map {T → P →ᵣ Y} {T → coconeᵣ {X} {A} {B} f g Y}
                     (post {T} {P →ᵣ Y} {coconeᵣ {X} {A} {B} f g Y} (cocone-restrᵣ {X} {A} {B} {P} f g i j q Y)))
is-equiv-flat-post-cocone-restrᵣ T {X} {A} {B} {P} f g i j q up Y =
  let C : ♭(T → P →ᵣ Y) → ♭(P → T →ₗ Y) = λ c . flat-tens-uncurryₗ {T} {P} {Y} (flat-tens-curryᵣ {T} {P} {Y} c) in
  let eC : is-equiv C =
    is-equiv-circ {♭(T → P →ᵣ Y)} {♭(T ⨂ P → Y)} {♭(P → T →ₗ Y)} (flat-tens-uncurryₗ {T} {P} {Y}) (flat-tens-curryᵣ {T} {P} {Y})
      (is-equiv-flat-tens-uncurryₗ {T} {P} {Y}) (is-equiv-flat-tens-curryᵣ {T} {P} {Y}) in
  let eE : is-equiv (flat-cocone-restr-curriedᵣ T {X} {A} {B} {P} f g i j q Y) =
    is-equiv-circ {♭(T → P →ᵣ Y)} {♭(P → T →ₗ Y)} {♭(cocone {X} {A} {B} f g (T →ₗ Y))}
      (flat-map {P → T →ₗ Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ₗ Y))) C
      (flat-map-equiv {P → T →ₗ Y} {cocone {X} {A} {B} f g (T →ₗ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ₗ Y)) (up (T →ₗ Y)))
      eC in
  is-equiv-htpy {♭(T → P →ᵣ Y)} {♭(T → coconeᵣ {X} {A} {B} f g Y)}
    {λ c . flat-cocone-swapᵣ T {X} {A} {B} f g Y (flat-cocone-restr-curriedᵣ T {X} {A} {B} {P} f g i j q Y c)}
    {flat-map {T → P →ᵣ Y} {T → coconeᵣ {X} {A} {B} f g Y} (post {T} {P →ᵣ Y} {coconeᵣ {X} {A} {B} f g Y} (cocone-restrᵣ {X} {A} {B} {P} f g i j q Y))}
    (flat-cocone-restrᵣ-factored-htpy T {X} {A} {B} {P} f g i j q Y)
    (is-equiv-circ {♭(T → P →ᵣ Y)} {♭(cocone {X} {A} {B} f g (T →ₗ Y))} {♭(T → coconeᵣ {X} {A} {B} f g Y)}
      (flat-cocone-swapᵣ T {X} {A} {B} f g Y) (flat-cocone-restr-curriedᵣ T {X} {A} {B} {P} f g i j q Y)
      (is-equiv-flat-cocone-swapᵣ T {X} {A} {B} f g Y) eE)

-- the oplax universal property of a square with the cartesian universal property
--
-- Proof. By the objectwise equivalence axiom it suffices to check global points of grids T. There,
-- lax currying turns oplax maps out of P into cartesian maps into T →ₗ Y:
--
--   ♭(T → P →ᵣ Y) ≃ ♭(T ⨂ P → Y) ≃ ♭(P → T →ₗ Y) ─♭ cocone-restr─▶ ♭(cocone f g (T →ₗ Y))
--
-- and the last map is an equivalence by the cartesian universal property at Z = T →ₗ Y. It remains
-- to identify cocones in T →ₗ Y with T-indexed oplax cocones on global points. Neither direction is
-- an internal map, but both receive maps from cocones in maps out of T ⨂ − (cocone-tensᵣ), by lax and
-- oplax currying, which are equivalences on global points:
--
--   ♭(cocone f g (T →ₗ Y)) ◀─♭ cocone-tensᵣ→cocone─ ♭(cocone-tensᵣ T f g Y) ─♭ cocone-tensᵣ→curried─▶ ♭(T → coconeᵣ f g Y)
--
-- On global points, swapping the arguments (cocone-swapᵣ, crisp only) closes the triangle up to a
-- homotopy, and it also identifies the comparison map with the composite; both homotopies reduce to
-- a comparison of images of a crisp path, settled by crisp path induction.
--
-- The lax universal property is proved the same way, with the roles of lax and oplax currying
-- exchanged.
--
is-pushout→is-pushoutᵣ ∷ {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (up ∷ is-pushout {X} {A} {B} {P} f g i j q) → is-pushoutᵣ {X} {A} {B} {P} f g i j q
is-pushout→is-pushoutᵣ {X} {A} {B} {P} f g i j q up = λ Y .
  objectwise-equiv {P →ᵣ Y} {coconeᵣ {X} {A} {B} f g Y} (cocone-restrᵣ {X} {A} {B} {P} f g i j q Y)
    (λ a . is-equiv-flat-post-cocone-restrᵣ (grid a) {X} {A} {B} {P} f g i j q up Y)

--
-- The lax universal property: the same proof, with lax and oplax currying exchanged (T on the
-- right of the tensor)
--

--
-- Cocones curried along T
--

-- T-indexed lax cocones, as a single Σ
curried-coconeₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → U
curried-coconeₗ T {X} {A} {B} f g Y =
  Σ (α : T → A →ₗ Y) . Σ (β : T → B →ₗ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))

-- cocones in maps out of − ⨂ T
cocone-tensₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → U
cocone-tensₗ T {X} {A} {B} f g Y =
  Σ (α : A ⨂ T → Y) . Σ (β : B ⨂ T → Y) .
    (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))

-- oplax currying: to cocones in T →ᵣ Y
cocone-tensₗ→cocone-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α : A ⨂ T → Y) →
  (Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))) →
  Σ (β : B → T →ᵣ Y) . (λ x . tens-curry-right' {A} {T} {Y} α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))
cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y α (β , p) = (tens-curry-right' {B} {T} {Y} β , cong (tens-curry-right' {X} {T} {Y}) p)

cocone-tensₗ→cocone ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → cocone-tensₗ T {X} {A} {B} f g Y → cocone {X} {A} {B} f g (T →ᵣ Y)
cocone-tensₗ→cocone T {X} {A} {B} f g Y =
  flat-Σ-map {A ⨂ T → Y} {A → T →ᵣ Y}
    {λ α . Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
    {λ α' . Σ (β : B → T →ᵣ Y) . (λ x . α' (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))}
    (tens-curry-right' {A} {T} {Y}) (cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y)

-- lax currying: to T-indexed lax cocones
cocone-tensₗ→curried-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α : A ⨂ T → Y) →
  (Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))) →
  Σ (β : T → B →ₗ Y) . (λ t . λ x . tens-curry-left' {A} {T} {Y} α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))
cocone-tensₗ→curried-fib T {X} {A} {B} f g Y α (β , p) = (tens-curry-left' {B} {T} {Y} β , cong (tens-curry-left' {X} {T} {Y}) p)

cocone-tensₗ→curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → cocone-tensₗ T {X} {A} {B} f g Y → curried-coconeₗ T {X} {A} {B} f g Y
cocone-tensₗ→curried T {X} {A} {B} f g Y =
  flat-Σ-map {A ⨂ T → Y} {T → A →ₗ Y}
    {λ α . Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
    {λ α' . Σ (β : T → B →ₗ Y) . (λ t . λ x . α' t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))}
    (tens-curry-left' {A} {T} {Y}) (cocone-tensₗ→curried-fib T {X} {A} {B} f g Y)

-- distributing T over the Σ (a genuine equivalence, by funext)
curried→coconesₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → curried-coconeₗ T {X} {A} {B} f g Y → T → coconeₗ {X} {A} {B} f g Y
curried→coconesₗ T {X} {A} {B} f g Y (α , r) =
  let k : (r : Σ (β : T → B →ₗ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))) → T → coconeₗ {X} {A} {B} f g Y =
    fun (β , p) → λ t . (α t , β t , happly {T} {λ _ . X →ₗ Y} {λ t' . λ x . α t' (f x)} {λ t' . λ x . β t' (g x)} p t) in
  k r

cocones→curriedₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → (T → coconeₗ {X} {A} {B} f g Y) → curried-coconeₗ T {X} {A} {B} f g Y
cocones→curriedₗ T {X} {A} {B} f g Y F =
  let α : T → A →ₗ Y = λ t . coconeₗ-fst {X} {A} {B} f g Y (F t) in
  let β : T → B →ₗ Y = λ t . coconeₗ-snd {X} {A} {B} f g Y (F t) in
  (α , β , funext-htpy {T} {λ _ . X →ₗ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) (λ t . coconeₗ-glue {X} {A} {B} f g Y (F t)))

curried→coconesₗ-sec ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (F : T → coconeₗ {X} {A} {B} f g Y) →
  curried→coconesₗ T {X} {A} {B} f g Y (cocones→curriedₗ T {X} {A} {B} f g Y F) ≡ F
curried→coconesₗ-sec T {X} {A} {B} f g Y F =
  let α : T → A →ₗ Y = λ t . coconeₗ-fst {X} {A} {B} f g Y (F t) in
  let β : T → B →ₗ Y = λ t . coconeₗ-snd {X} {A} {B} f g Y (F t) in
  let s : (t : T) → (λ x . α t (f x)) ≡{X →ₗ Y} (λ x . β t (g x)) = λ t . coconeₗ-glue {X} {A} {B} f g Y (F t) in
  let hs : happly {T} {λ _ . X →ₗ Y} {λ t . λ x . α t (f x)} {λ t . λ x . β t (g x)}
             (funext-htpy {T} {λ _ . X →ₗ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) s) ≡ s =
    happly-funext-htpy {T} {λ _ . X →ₗ Y} (λ t . λ x . α t (f x)) (λ t . λ x . β t (g x)) s in
  funext-htpy {T} {λ _ . coconeₗ {X} {A} {B} f g Y} (curried→coconesₗ T {X} {A} {B} f g Y (cocones→curriedₗ T {X} {A} {B} f g Y F)) F
    (λ t . trans (cong {(λ x . α t (f x)) ≡{X →ₗ Y} (λ x . β t (g x))} {coconeₗ {X} {A} {B} f g Y}
                   (λ p . (α t , β t , p))
                   (happly {T} {λ t' . (λ x . α t' (f x)) ≡{X →ₗ Y} (λ x . β t' (g x))} hs t))
             (coconeₗ-eta {X} {A} {B} f g Y (F t)))

curried→coconesₗ-retr ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (d : curried-coconeₗ T {X} {A} {B} f g Y) →
  cocones→curriedₗ T {X} {A} {B} f g Y (curried→coconesₗ T {X} {A} {B} f g Y d) ≡ d
curried→coconesₗ-retr T {X} {A} {B} f g Y (α , r) =
  let k : (r : Σ (β : T → B →ₗ Y) . (λ t . λ x . α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))) →
      cocones→curriedₗ T {X} {A} {B} f g Y (curried→coconesₗ T {X} {A} {B} f g Y (α , r)) ≡ (α , r) =
    fun (β , p) →
      cong {(λ t . λ x . α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))} {curried-coconeₗ T {X} {A} {B} f g Y}
        (λ p' . (α , β , p'))
        (funext-htpy-happly {T} {λ _ . X →ₗ Y} {λ t . λ x . α t (f x)} {λ t . λ x . β t (g x)} p) in
  k r

is-equiv-curried→coconesₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → is-equiv (curried→coconesₗ T {X} {A} {B} f g Y)
is-equiv-curried→coconesₗ T {X} {A} {B} f g Y =
  ((cocones→curriedₗ T {X} {A} {B} f g Y , curried→coconesₗ-sec T {X} {A} {B} f g Y) ,
   (cocones→curriedₗ T {X} {A} {B} f g Y , curried→coconesₗ-retr T {X} {A} {B} f g Y))

-- the two currying maps are equivalences on global points
is-equiv-flat-cocone-tensₗ→cocone-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α ∷ A ⨂ T → Y) →
  is-equiv (flat-map {Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
                     {Σ (β : B → T →ᵣ Y) . (λ x . tens-curry-right' {A} {T} {Y} α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))}
                     (cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y α))
is-equiv-flat-cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y α =
  let S ∷ X ⨂ T → Y = λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z) in
  let src ∷ U = Σ (β : B ⨂ T → Y) . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)) in
  let tgt ∷ U = Σ (β : B → T →ᵣ Y) . (λ x . tens-curry-right' {A} {T} {Y} α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x)) in
  let m ∷ src → tgt =
    flat-Σ-map {B ⨂ T → Y} {B → T →ᵣ Y} {λ β . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
      {λ β . (λ x . tens-curry-right' {A} {T} {Y} α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))}
      (tens-curry-right' {B} {T} {Y}) (λ β . cong (tens-curry-right' {X} {T} {Y}) {S} {λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)}) in
  is-equiv-htpy {♭ src} {♭ tgt} {flat-map {src} {tgt} m} {flat-map {src} {tgt} (cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y α)}
    (fun 𝄫w → let h : (w ∷ src) → flat-map {src} {tgt} m 𝄫w ≡ flat-map {src} {tgt} (cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y α) 𝄫w =
                fun (β , p) → refl in h w)
    (flat-Σ-map-equiv {B ⨂ T → Y} {B → T →ᵣ Y} {λ β . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
      {λ β . (λ x . tens-curry-right' {A} {T} {Y} α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))}
      (tens-curry-right' {B} {T} {Y}) (λ β . cong (tens-curry-right' {X} {T} {Y}) {S} {λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)})
      (is-equiv-flat-tens-uncurryᵣ {B} {T} {Y})
      (λ β . flat-cong-equiv (tens-curry-right' {X} {T} {Y}) (is-equiv-flat-tens-uncurryᵣ {X} {T} {Y})
               S (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))))

is-equiv-flat-cocone-tensₗ→cocone ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  is-equiv (flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-tensₗ→cocone T {X} {A} {B} f g Y))
is-equiv-flat-cocone-tensₗ→cocone T {X} {A} {B} f g Y =
  flat-Σ-map-equiv {A ⨂ T → Y} {A → T →ᵣ Y}
    {λ α . Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
    {λ α' . Σ (β : B → T →ᵣ Y) . (λ x . α' (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))}
    (tens-curry-right' {A} {T} {Y}) (cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y)
    (is-equiv-flat-tens-uncurryᵣ {A} {T} {Y})
    (is-equiv-flat-cocone-tensₗ→cocone-fib T {X} {A} {B} f g Y)

is-equiv-flat-cocone-tensₗ→curried-fib ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (α ∷ A ⨂ T → Y) →
  is-equiv (flat-map {Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
                     {Σ (β : T → B →ₗ Y) . (λ t . λ x . tens-curry-left' {A} {T} {Y} α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))}
                     (cocone-tensₗ→curried-fib T {X} {A} {B} f g Y α))
is-equiv-flat-cocone-tensₗ→curried-fib T {X} {A} {B} f g Y α =
  let S ∷ X ⨂ T → Y = λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z) in
  let src ∷ U = Σ (β : B ⨂ T → Y) . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)) in
  let tgt ∷ U = Σ (β : T → B →ₗ Y) . (λ t . λ x . tens-curry-left' {A} {T} {Y} α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x)) in
  let m ∷ src → tgt =
    flat-Σ-map {B ⨂ T → Y} {T → B →ₗ Y} {λ β . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
      {λ β . (λ t . λ x . tens-curry-left' {A} {T} {Y} α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))}
      (tens-curry-left' {B} {T} {Y}) (λ β . cong (tens-curry-left' {X} {T} {Y}) {S} {λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)}) in
  is-equiv-htpy {♭ src} {♭ tgt} {flat-map {src} {tgt} m} {flat-map {src} {tgt} (cocone-tensₗ→curried-fib T {X} {A} {B} f g Y α)}
    (fun 𝄫w → let h : (w ∷ src) → flat-map {src} {tgt} m 𝄫w ≡ flat-map {src} {tgt} (cocone-tensₗ→curried-fib T {X} {A} {B} f g Y α) 𝄫w =
                fun (β , p) → refl in h w)
    (flat-Σ-map-equiv {B ⨂ T → Y} {T → B →ₗ Y} {λ β . S ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
      {λ β . (λ t . λ x . tens-curry-left' {A} {T} {Y} α t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))}
      (tens-curry-left' {B} {T} {Y}) (λ β . cong (tens-curry-left' {X} {T} {Y}) {S} {λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z)})
      (is-equiv-flat-tens-uncurryₗ {B} {T} {Y})
      (λ β . flat-cong-equiv (tens-curry-left' {X} {T} {Y}) (is-equiv-flat-tens-uncurryₗ {X} {T} {Y})
               S (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))))

is-equiv-flat-cocone-tensₗ→curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  is-equiv (flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {curried-coconeₗ T {X} {A} {B} f g Y} (cocone-tensₗ→curried T {X} {A} {B} f g Y))
is-equiv-flat-cocone-tensₗ→curried T {X} {A} {B} f g Y =
  flat-Σ-map-equiv {A ⨂ T → Y} {T → A →ₗ Y}
    {λ α . Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))}
    {λ α' . Σ (β : T → B →ₗ Y) . (λ t . λ x . α' t (f x)) ≡{T → X →ₗ Y} (λ t . λ x . β t (g x))}
    (tens-curry-left' {A} {T} {Y}) (cocone-tensₗ→curried-fib T {X} {A} {B} f g Y)
    (is-equiv-flat-tens-uncurryₗ {A} {T} {Y})
    (is-equiv-flat-cocone-tensₗ→curried-fib T {X} {A} {B} f g Y)

--
-- Swapping arguments on global points
--

-- a crisp cocone in T →ᵣ Y gives a T-indexed family of lax cocones, by swapping the arguments
-- (crisp only: see crisp-swapᵣₗ, Function.batt)
cocone-swapₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (c ∷ cocone {X} {A} {B} f g (T →ᵣ Y)) → T → coconeₗ {X} {A} {B} f g Y
cocone-swapₗ T {X} {A} {B} f g Y (α , r) =
  let k : (r ∷ Σ (β : B → T →ᵣ Y) . (λ x . α (f x)) ≡{X → T →ᵣ Y} (λ x . β (g x))) → T → coconeₗ {X} {A} {B} f g Y =
    fun (β , p) → λ t .
      (λ a . α a t , λ b . β b t ,
       happly {T} {λ _ . X →ₗ Y} {crisp-swapᵣₗ {X} {T} {Y} (λ x . α (f x))} {crisp-swapᵣₗ {X} {T} {Y} (λ x . β (g x))}
         (crisp-cong {X → T →ᵣ Y} {T → X →ₗ Y} (crisp-swapᵣₗ {X} {T} {Y}) p) t) in
  k r

flat-cocone-swapₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone {X} {A} {B} f g (T →ᵣ Y)) → ♭(T → coconeₗ {X} {A} {B} f g Y)
flat-cocone-swapₗ T {X} {A} {B} f g Y 𝄫c = 𝄫(cocone-swapₗ T {X} {A} {B} f g Y c)

cong-restr-swapₗ ∷ {T X P Y ∷ U} (ψ ∷ T → P →ₗ Y) {k₀ k₁ ∷ X → P} (q ∷ k₀ ≡ k₁) (t : T) →
  happly {T} {λ _ . X →ₗ Y}
    {crisp-swapᵣₗ {X} {T} {Y} (post {X} {P} {T →ᵣ Y} (tens-curry-right' {P} {T} {Y} (tens-uncurry-crispₗ {P} {T} {Y} ψ)) k₀)}
    {crisp-swapᵣₗ {X} {T} {Y} (post {X} {P} {T →ᵣ Y} (tens-curry-right' {P} {T} {Y} (tens-uncurry-crispₗ {P} {T} {Y} ψ)) k₁)}
    (crisp-cong {X → T →ᵣ Y} {T → X →ₗ Y} (crisp-swapᵣₗ {X} {T} {Y})
      (cong {X → P} {X → T →ᵣ Y} (post {X} {P} {T →ᵣ Y} (tens-curry-right' {P} {T} {Y} (tens-uncurry-crispₗ {P} {T} {Y} ψ))) q)) t
  ≡ congₗ {X → P} {X →ₗ Y} (preₗ {X} {P} {Y} (ψ t)) q
cong-restr-swapₗ {T} {X} {P} {Y} ψ {k₀} refl t = refl

--
-- The lax universal property
--

-- the triangle: swapping identifies the two curried forms of cocones in maps out of − ⨂ T
flat-cocone-tensₗ→cocones-curried ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone-tensₗ T {X} {A} {B} f g Y) → ♭(T → coconeₗ {X} {A} {B} f g Y)
flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y c =
  flat-map {curried-coconeₗ T {X} {A} {B} f g Y} {T → coconeₗ {X} {A} {B} f g Y} (curried→coconesₗ T {X} {A} {B} f g Y)
    (flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {curried-coconeₗ T {X} {A} {B} f g Y} (cocone-tensₗ→curried T {X} {A} {B} f g Y) c)

flat-cocone-tensₗ→cocones-swapped ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) →
  ♭(cocone-tensₗ T {X} {A} {B} f g Y) → ♭(T → coconeₗ {X} {A} {B} f g Y)
flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y c =
  flat-cocone-swapₗ T {X} {A} {B} f g Y
    (flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-tensₗ→cocone T {X} {A} {B} f g Y) c)

flat-cocone-tensₗ-triangle ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) (c : ♭(cocone-tensₗ T {X} {A} {B} f g Y)) →
  flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y c ≡ flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y c
flat-cocone-tensₗ-triangle T {X} {A} {B} f g Y 𝄫c =
  let h : (c ∷ cocone-tensₗ T {X} {A} {B} f g Y) →
          flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y 𝄫c ≡ flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y 𝄫c =
    fun (α , r) →
      let h2 : (r ∷ Σ (β : B ⨂ T → Y) . (λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z)) ≡{X ⨂ T → Y} (λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z))) →
               flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y 𝄫(α , r) ≡ flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y 𝄫(α , r) =
        fun (β , p) →
          let S ∷ X ⨂ T → Y = λ z . α (tens-map {X} {A} {T} {T} f (λ t . t) z) in
          let S' ∷ X ⨂ T → Y = λ z . β (tens-map {X} {B} {T} {T} g (λ t . t) z) in
          let e ∷ (tens-curry-left' {X} {T} {Y} S) ≡{T → X →ₗ Y} (tens-curry-left' {X} {T} {Y} S') =
            cong (tens-curry-left' {X} {T} {Y}) p in
          let e' ∷ (tens-curry-left' {X} {T} {Y} S) ≡{T → X →ₗ Y} (tens-curry-left' {X} {T} {Y} S') =
            crisp-cong {X → T →ᵣ Y} {T → X →ₗ Y} (crisp-swapᵣₗ {X} {T} {Y}) (cong (tens-curry-right' {X} {T} {Y}) p) in
          flat-≡ {T → coconeₗ {X} {A} {B} f g Y}
            (funext-htpy {T} {λ _ . coconeₗ {X} {A} {B} f g Y}
              (λ t . (tens-curry-left' {A} {T} {Y} α t , tens-curry-left' {B} {T} {Y} β t ,
                      happly {T} {λ _ . X →ₗ Y} {tens-curry-left' {X} {T} {Y} S} {tens-curry-left' {X} {T} {Y} S'} e t))
              (λ t . (tens-curry-left' {A} {T} {Y} α t , tens-curry-left' {B} {T} {Y} β t ,
                      happly {T} {λ _ . X →ₗ Y} {tens-curry-left' {X} {T} {Y} S} {tens-curry-left' {X} {T} {Y} S'} e' t))
              (λ t . cong {tens-curry-left' {X} {T} {Y} S t ≡{X →ₗ Y} tens-curry-left' {X} {T} {Y} S' t} {coconeₗ {X} {A} {B} f g Y}
                       (λ s . (tens-curry-left' {A} {T} {Y} α t , tens-curry-left' {B} {T} {Y} β t , s))
                       (cong {(tens-curry-left' {X} {T} {Y} S) ≡{T → X →ₗ Y} (tens-curry-left' {X} {T} {Y} S')}
                             {tens-curry-left' {X} {T} {Y} S t ≡{X →ₗ Y} tens-curry-left' {X} {T} {Y} S' t}
                          (λ d . happly {T} {λ _ . X →ₗ Y} {tens-curry-left' {X} {T} {Y} S} {tens-curry-left' {X} {T} {Y} S'} d t)
                          (cong-curry-swapᵣₗ {X} {T} {Y} {S} {S'} p)))) in
      h2 r in
  h c

-- swapping is an equivalence on global points
is-equiv-flat-cocone-swapₗ ∷ (T ∷ U) {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) (Y ∷ U) → is-equiv (flat-cocone-swapₗ T {X} {A} {B} f g Y)
is-equiv-flat-cocone-swapₗ T {X} {A} {B} f g Y =
  let L : ♭(cocone-tensₗ T {X} {A} {B} f g Y) → ♭(cocone {X} {A} {B} f g (T →ᵣ Y)) =
    flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-tensₗ→cocone T {X} {A} {B} f g Y) in
  let eR : is-equiv (flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y) =
    is-equiv-circ {♭(cocone-tensₗ T {X} {A} {B} f g Y)} {♭(curried-coconeₗ T {X} {A} {B} f g Y)} {♭(T → coconeₗ {X} {A} {B} f g Y)}
      (flat-map {curried-coconeₗ T {X} {A} {B} f g Y} {T → coconeₗ {X} {A} {B} f g Y} (curried→coconesₗ T {X} {A} {B} f g Y))
      (flat-map {cocone-tensₗ T {X} {A} {B} f g Y} {curried-coconeₗ T {X} {A} {B} f g Y} (cocone-tensₗ→curried T {X} {A} {B} f g Y))
      (flat-map-equiv {curried-coconeₗ T {X} {A} {B} f g Y} {T → coconeₗ {X} {A} {B} f g Y} (curried→coconesₗ T {X} {A} {B} f g Y)
        (is-equiv-curried→coconesₗ T {X} {A} {B} f g Y))
      (is-equiv-flat-cocone-tensₗ→curried T {X} {A} {B} f g Y) in
  let eSL : is-equiv (flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y) =
    is-equiv-htpy {♭(cocone-tensₗ T {X} {A} {B} f g Y)} {♭(T → coconeₗ {X} {A} {B} f g Y)}
      {flat-cocone-tensₗ→cocones-curried T {X} {A} {B} f g Y} {flat-cocone-tensₗ→cocones-swapped T {X} {A} {B} f g Y}
      (flat-cocone-tensₗ-triangle T {X} {A} {B} f g Y) eR in
  is-equiv-cancel-r {♭(cocone-tensₗ T {X} {A} {B} f g Y)} {♭(cocone {X} {A} {B} f g (T →ᵣ Y))} {♭(T → coconeₗ {X} {A} {B} f g Y)}
    (flat-cocone-swapₗ T {X} {A} {B} f g Y) L (is-equiv-flat-cocone-tensₗ→cocone T {X} {A} {B} f g Y) eSL

-- on global points, the comparison map is swapping after the cartesian restriction (curried)
flat-cocone-restr-curriedₗ ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (Y ∷ U) → ♭(T → P →ₗ Y) → ♭(cocone {X} {A} {B} f g (T →ᵣ Y))
flat-cocone-restr-curriedₗ T {X} {A} {B} {P} f g i j q Y c =
  flat-map {P → T →ᵣ Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ᵣ Y))
    (flat-tens-uncurryᵣ {P} {T} {Y} (flat-tens-curryₗ {P} {T} {Y} c))

flat-cocone-restrₗ-factored-htpy ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (Y ∷ U) (c : ♭(T → P →ₗ Y)) →
  flat-cocone-swapₗ T {X} {A} {B} f g Y (flat-cocone-restr-curriedₗ T {X} {A} {B} {P} f g i j q Y c)
    ≡ flat-map {T → P →ₗ Y} {T → coconeₗ {X} {A} {B} f g Y}
        (post {T} {P →ₗ Y} {coconeₗ {X} {A} {B} f g Y} (cocone-restrₗ {X} {A} {B} {P} f g i j q Y)) c
flat-cocone-restrₗ-factored-htpy T {X} {A} {B} {P} f g i j q Y 𝄫ψ =
  let K ∷ P → T →ᵣ Y = tens-curry-right' {P} {T} {Y} (tens-uncurry-crispₗ {P} {T} {Y} ψ) in
  flat-≡ {T → coconeₗ {X} {A} {B} f g Y}
    (funext-htpy {T} {λ _ . coconeₗ {X} {A} {B} f g Y}
      (cocone-swapₗ T {X} {A} {B} f g Y (cocone-restr {X} {A} {B} {P} f g i j q (T →ᵣ Y) K))
      (λ t . cocone-restrₗ {X} {A} {B} {P} f g i j q Y (ψ t))
      (λ t . cong {crisp-swapᵣₗ {X} {T} {Y} (post {X} {P} {T →ᵣ Y} K (λ x . i (f x))) t ≡{X →ₗ Y} crisp-swapᵣₗ {X} {T} {Y} (post {X} {P} {T →ᵣ Y} K (λ x . j (g x))) t}
                  {coconeₗ {X} {A} {B} f g Y}
               (λ s . ((λ a . ψ t (i a)) , (λ b . ψ t (j b)) , s))
               (cong-restr-swapₗ {T} {X} {P} {Y} ψ {λ x . i (f x)} {λ x . j (g x)} q t)))

-- the comparison map is an equivalence on the global points of any crisp T
is-equiv-flat-post-cocone-restrₗ ∷ (T ∷ U) {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (up ∷ is-pushout {X} {A} {B} {P} f g i j q) (Y ∷ U) →
  is-equiv (flat-map {T → P →ₗ Y} {T → coconeₗ {X} {A} {B} f g Y}
                     (post {T} {P →ₗ Y} {coconeₗ {X} {A} {B} f g Y} (cocone-restrₗ {X} {A} {B} {P} f g i j q Y)))
is-equiv-flat-post-cocone-restrₗ T {X} {A} {B} {P} f g i j q up Y =
  let C : ♭(T → P →ₗ Y) → ♭(P → T →ᵣ Y) = λ c . flat-tens-uncurryᵣ {P} {T} {Y} (flat-tens-curryₗ {P} {T} {Y} c) in
  let eC : is-equiv C =
    is-equiv-circ {♭(T → P →ₗ Y)} {♭(P ⨂ T → Y)} {♭(P → T →ᵣ Y)} (flat-tens-uncurryᵣ {P} {T} {Y}) (flat-tens-curryₗ {P} {T} {Y})
      (is-equiv-flat-tens-uncurryᵣ {P} {T} {Y}) (is-equiv-flat-tens-curryₗ {P} {T} {Y}) in
  let eE : is-equiv (flat-cocone-restr-curriedₗ T {X} {A} {B} {P} f g i j q Y) =
    is-equiv-circ {♭(T → P →ₗ Y)} {♭(P → T →ᵣ Y)} {♭(cocone {X} {A} {B} f g (T →ᵣ Y))}
      (flat-map {P → T →ᵣ Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ᵣ Y))) C
      (flat-map-equiv {P → T →ᵣ Y} {cocone {X} {A} {B} f g (T →ᵣ Y)} (cocone-restr {X} {A} {B} {P} f g i j q (T →ᵣ Y)) (up (T →ᵣ Y)))
      eC in
  is-equiv-htpy {♭(T → P →ₗ Y)} {♭(T → coconeₗ {X} {A} {B} f g Y)}
    {λ c . flat-cocone-swapₗ T {X} {A} {B} f g Y (flat-cocone-restr-curriedₗ T {X} {A} {B} {P} f g i j q Y c)}
    {flat-map {T → P →ₗ Y} {T → coconeₗ {X} {A} {B} f g Y} (post {T} {P →ₗ Y} {coconeₗ {X} {A} {B} f g Y} (cocone-restrₗ {X} {A} {B} {P} f g i j q Y))}
    (flat-cocone-restrₗ-factored-htpy T {X} {A} {B} {P} f g i j q Y)
    (is-equiv-circ {♭(T → P →ₗ Y)} {♭(cocone {X} {A} {B} f g (T →ᵣ Y))} {♭(T → coconeₗ {X} {A} {B} f g Y)}
      (flat-cocone-swapₗ T {X} {A} {B} f g Y) (flat-cocone-restr-curriedₗ T {X} {A} {B} {P} f g i j q Y)
      (is-equiv-flat-cocone-swapₗ T {X} {A} {B} f g Y) eE)

-- the lax universal property of a square with the cartesian universal property
is-pushout→is-pushoutₗ ∷ {X A B P ∷ U} (f ∷ X → A) (g ∷ X → B) (i ∷ A → P) (j ∷ B → P) (q ∷ (λ x . i (f x)) ≡{X → P} (λ x . j (g x)))
  (up ∷ is-pushout {X} {A} {B} {P} f g i j q) → is-pushoutₗ {X} {A} {B} {P} f g i j q
is-pushout→is-pushoutₗ {X} {A} {B} {P} f g i j q up = λ Y .
  objectwise-equiv {P →ₗ Y} {coconeₗ {X} {A} {B} f g Y} (cocone-restrₗ {X} {A} {B} {P} f g i j q Y)
    (λ a . is-equiv-flat-post-cocone-restrₗ (grid a) {X} {A} {B} {P} f g i j q up Y)

--
-- Pushouts
--

-- the oplax universal property of pushouts
pushout-oplax-up ∷ {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) →
  is-pushoutᵣ {X} {A} {B} {pushout-obj f g} f g (pushout-inl f g) (pushout-inr f g) (pushout-glue {X} {A} {B} f g)
pushout-oplax-up {X} {A} {B} f g =
  is-pushout→is-pushoutᵣ {X} {A} {B} {pushout-obj f g} f g (pushout-inl f g) (pushout-inr f g) (pushout-glue {X} {A} {B} f g)
    (pushout-is-pushout {X} {A} {B} f g)

-- the lax universal property of pushouts
pushout-lax-up ∷ {X A B ∷ U} (f ∷ X → A) (g ∷ X → B) →
  is-pushoutₗ {X} {A} {B} {pushout-obj f g} f g (pushout-inl f g) (pushout-inr f g) (pushout-glue {X} {A} {B} f g)
pushout-lax-up {X} {A} {B} f g =
  is-pushout→is-pushoutₗ {X} {A} {B} {pushout-obj f g} f g (pushout-inl f g) (pushout-inr f g) (pushout-glue {X} {A} {B} f g)
    (pushout-is-pushout {X} {A} {B} f g)
