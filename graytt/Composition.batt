--
-- Functorial binary composition of 1-cells in oplax-Segal types
--
-- The 1-cells of X are the oplax maps 𝕀 →ᵣ X. A composable pair of 1-cells is an oplax map out
-- of the 2-spine Λ² = Sp₂ (two edges glued at their common vertex). When X is oplax-Segal,
-- restriction (Δ² →ᵣ X) → (Sp₂ →ᵣ X) along the spine inclusion is an equivalence; the composite
-- of a composable pair φ is obtained by extending φ to a 2-simplex (the filler) and restricting
-- it to the long edge δ of Δ²:
--
--   compᵣ : (Sp₂ →ᵣ X) → (𝕀 →ᵣ X),    compᵣ = (filler of φ) ∘ δ
--
-- Composition is thus a function on the whole type of composable pairs.
--

open import Stdlib
open import Segal
open import Hom
open import Spine-up

--
-- The two 1-cells of a composable pair
--

fst-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (arrᵣ X)
fst-cell fg = preᵣ fg Spine2.edge₀₁

snd-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (arrᵣ X)
snd-cell fg = preᵣ fg Spine2.edge₁₂

--
-- Filler and composite
--

-- the unthickened oplax Segal condition for Λ² ↪ Δ²
is-segalᵣ-2 ∷ {X ∷ U} → is-segalᵣ X → is-equiv (segal-restrᵣ nil 2 nil X)
is-segalᵣ-2 s = s nil 2 nil

-- the section of restriction along Λ² ↪ Δ² given by the oplax Segal condition
segal-sectionᵣ ∷ {X ∷ U} → is-segalᵣ X → section (segal-restrᵣ nil 2 nil X)
segal-sectionᵣ {X} s = is-equiv-sec (segal-restrᵣ nil 2 nil X) (is-segalᵣ-2 s)

-- the extension of a (trivially thickened) composable pair to a (trivially thickened) 2-simplex
thick-fillerᵣ ∷ {X ∷ U} → is-segalᵣ X → (thick-spine nil 2 nil →ᵣ X) → (thick-simplex nil 2 nil →ᵣ X)
thick-fillerᵣ {X} s = section-map (segal-restrᵣ nil 2 nil X) (segal-sectionᵣ s)

-- it restricts back to the given pair
thick-fillerᵣ-restr ∷ {X ∷ U} (s : is-segalᵣ X) (ψ : thick-spine nil 2 nil →ᵣ X) →
  segal-restrᵣ nil 2 nil X (thick-fillerᵣ s ψ) ≡ ψ
thick-fillerᵣ-restr {X} s ψ =
  snd {(thick-spine nil 2 nil →ᵣ X) → (thick-simplex nil 2 nil →ᵣ X)}
    (is-section (segal-restrᵣ nil 2 nil X)) (segal-sectionᵣ s) ψ

-- the composable pair φ, trivially thickened
thick-pairᵣ ∷ {X ∷ U} → (spine 2 →ᵣ X) → (thick-spine nil 2 nil →ᵣ X)
thick-pairᵣ {X} φ =
  let u ∷ thick-spine nil 2 nil → spine 2 = thicken-unit {spine 2} in
  preᵣ {thick-spine nil 2 nil} φ u

-- the 2-simplex filling a composable pair: the Segal extension along Λ² ↪ Δ², transported
-- through the unit laws ⊤ ⊗ (− ⊗ ⊤) of the (trivial) thickening
comp-fillerᵣ ∷ {X ∷ U} → is-segalᵣ X → (spine 2 →ᵣ X) → (simplex 2 →ᵣ X)
comp-fillerᵣ s φ =
  let c ∷ simplex 2 → thick-simplex nil 2 nil = thicken-counit {simplex 2} in
  preᵣ {simplex 2} (thick-fillerᵣ s (thick-pairᵣ φ)) c

-- the composite of a composable pair: the long edge of its filler
compᵣ ∷ {X ∷ U} → is-segalᵣ X → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
compᵣ s φ =
  let δ ∷ 𝕀 → simplex 2 = Simplex2.edge₀₂ in
  preᵣ {𝕀} (comp-fillerᵣ s φ) δ

--
-- Boundary of the composite: it goes from the source of the first cell to the target of the
-- second one
--

-- on the image of the spine, the filler of φ agrees with φ
comp-fillerᵣ-spine ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) (v ∷ spine 2) {y ∷ simplex 2}
  (r ∷ y ≡ spine→simplex 2 v) → comp-fillerᵣ s φ y ≡ φ v
comp-fillerᵣ-spine {X} s φ v {y} r =
  let c ∷ simplex 2 → thick-simplex nil 2 nil = thicken-counit {simplex 2} in
  let r' ∷ c y ≡ c (spine→simplex 2 v) = cong c r in
  let w ∷ thick-spine nil 2 nil = thicken-counit {spine 2} v in
  let Φ : thick-simplex nil 2 nil →ᵣ X = thick-fillerᵣ s (thick-pairᵣ φ) in
  trans (congᵣ Φ r') (happlyᵣ (thick-fillerᵣ-restr s (thick-pairᵣ φ)) w)

compᵣ-src ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) → compᵣ s φ 𝕀0 ≡ fst-cell {X} φ 𝕀0
compᵣ-src s φ =
  comp-fillerᵣ-spine s φ (Spine2.edge₀₁ 𝕀0)
    (sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (Spine2.edge₀₁ 𝕀0))))

compᵣ-tgt ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) → compᵣ s φ 𝕀1 ≡ snd-cell {X} φ 𝕀1
compᵣ-tgt s φ =
  comp-fillerᵣ-spine s φ (Spine2.edge₁₂ 𝕀1)
    (sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (Spine2.edge₁₂ 𝕀1))))

--
-- Uniqueness of fillers: any 2-simplex restricting to φ on the spine is the filler of φ, so its
-- long edge is the composite of φ (unthickened oplax Segal condition, Segal.batt)
--

comp-fillerᵣ-restr ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) → spine-restrᵣ 2 X (comp-fillerᵣ s φ) ≡ φ
comp-fillerᵣ-restr {X} s φ =
  let c ∷ spine 2 → thick-spine nil 2 nil = thicken-counit {spine 2} in
  cong {thick-spine nil 2 nil →ᵣ X} {spine 2 →ᵣ X} (λ ψ . preᵣ {spine 2} {thick-spine nil 2 nil} {X} ψ c)
    (thick-fillerᵣ-restr s (thick-pairᵣ {X} φ))

comp-fillerᵣ-unique ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restrᵣ 2 X Ψ ≡ φ → comp-fillerᵣ s φ ≡ Ψ
comp-fillerᵣ-unique {X} s φ Ψ H =
  retraction-inj (spine-restrᵣ 2 X) (is-equiv-ret (spine-restrᵣ 2 X) (is-segalᵣ-unthick X s 2)) {comp-fillerᵣ s φ} {Ψ}
    (trans (comp-fillerᵣ-restr s φ) (sym H))

compᵣ-unique ∷ {X ∷ U} (s : is-segalᵣ X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restrᵣ 2 X Ψ ≡ φ → compᵣ s φ ≡ preᵣ {𝕀} {simplex 2} {X} Ψ Simplex2.edge₀₂
compᵣ-unique {X} s φ Ψ H =
  let δ ∷ 𝕀 → simplex 2 = Simplex2.edge₀₂ in
  cong {simplex 2 →ᵣ X} {𝕀 →ᵣ X} (λ F . preᵣ {𝕀} {simplex 2} {X} F δ) (comp-fillerᵣ-unique s φ Ψ H)

--
-- Composition on hom types
--
-- Two 1-cells u : hom X x y and v : hom X y z form an oplax cocone on the two edges of the
-- spine (homs→spine2-cocone), hence a composable pair homs→spine2 : spine 2 →ᵣ X by the oplax universal
-- property of the spine (Spine-up.batt, Wedge.batt).
--
-- The composite is read off a filler: a 2-simplex Ψ together with a path P from its restriction
-- to the two edges (simplex2→coconeᵣ) to the cocone of u and v, i.e. a point of the fibre of
-- simplex2→coconeᵣ over homs→spine2-cocone u v. Its cell is the long edge of Ψ; its source is
--   Ψ (δ 0) = Ψ (vertex 0 of the first edge) = (first edge of the cocone) 0 = u 0 = x,
-- using P at the vertex 0 of the first edge, and dually for the target (fill-hom). The fibre is
-- contractible (simplex2→coconeᵣ is an equivalence when X is oplax-Segal), and the composite is
-- fill-hom at the canonical filler (comp-fill). Any other filler gives the same hom, which is how
-- the unit laws are proved on hom types (Unitality.batt).
--

-- the first coordinate on the first edge, the second one on the second edge
spine2-edge-1→𝕀 ∷ spine2-edge-1 → 𝕀
spine2-edge-1→𝕀 (c , a) = cube-2-x1 c

spine2-edge-2→𝕀 ∷ spine2-edge-2 → 𝕀
spine2-edge-2→𝕀 (c , b) = cube-2-x2 c

-- the oplax cocone formed by two consecutive homs
homs→spine2-cocone ∷ {X ∷ U} {x y z : X} → hom x y → hom y z → spine2-coconeᵣ X
homs→spine2-cocone {X} {x} {y} {z} u v =
  let ca ∷ spine2-edge-1 → 𝕀 = spine2-edge-1→𝕀 in
  let cb ∷ spine2-edge-2 → 𝕀 = spine2-edge-2→𝕀 in
  (preᵣ {spine2-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) ca ,
   preᵣ {spine2-edge-2} {𝕀} {X} (hom-cell {X} {y} {z} v) cb ,
   trans (hom-tgt {X} {x} {y} u) (sym (hom-src {X} {y} {z} v)))

-- the composable pair they define
homs→spine2 ∷ (X ∷ U) {x y z : X} → hom x y → hom y z → (spine 2 →ᵣ X)
homs→spine2 X {x} {y} {z} u v = cocone→spine2ᵣ X (homs→spine2-cocone {X} {x} {y} {z} u v)

-- restriction of a 2-simplex to an oplax cocone on the two edges of the spine
simplex2→coconeᵣ ∷ (X ∷ U) → (simplex 2 →ᵣ X) → spine2-coconeᵣ X
simplex2→coconeᵣ X Ψ = spine2→coconeᵣ X (spine-restrᵣ 2 X Ψ)

is-equiv-simplex2→coconeᵣ ∷ {X ∷ U} → is-segalᵣ X → is-equiv (simplex2→coconeᵣ X)
is-equiv-simplex2→coconeᵣ {X} s =
  is-equiv-circ (spine2→coconeᵣ X) (spine-restrᵣ 2 X)
    (spine-oplax-up X) (is-segalᵣ-unthick X s 2)

-- fillers of the pair (u , v)
hom-fill ∷ (X ∷ U) {x y z : X} → hom x y → hom y z → U
hom-fill X {x} {y} {z} u v = fib (simplex2→coconeᵣ X) (homs→spine2-cocone {X} {x} {y} {z} u v)

is-contr-hom-fill ∷ {X ∷ U} (s : is-segalᵣ X) {x y z : X} (u : hom x y) (v : hom y z) →
  is-contr (hom-fill X {x} {y} {z} u v)
is-contr-hom-fill {X} s {x} {y} {z} u v =
  is-contr-fib (simplex2→coconeᵣ X) (is-equiv-simplex2→coconeᵣ s) (homs→spine2-cocone {X} {x} {y} {z} u v)

-- the long edge starts at the vertex 0 and ends at the vertex 2 of the spine
simplex2-edge₀₂-src ∷ Simplex2.edge₀₂ 𝕀0 ≡{simplex 2} spine→simplex 2 (spine2-edge-1-incl spine2-edge-1-start)
simplex2-edge₀₂-src =
  sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt)
    (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (spine2-edge-1-incl spine2-edge-1-start)))

simplex2-edge₀₂-tgt ∷ Simplex2.edge₀₂ 𝕀1 ≡{simplex 2} spine→simplex 2 (spine2-edge-2-incl spine2-edge-2-end)
simplex2-edge₀₂-tgt =
  sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt)
    (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (spine2-edge-2-incl spine2-edge-2-end)))

-- the hom given by a filler: its cell is the long edge, its boundary is read off at the outer
-- vertices of the spine
fill-hom ∷ (X ∷ U) {x y z : X} (u : hom x y) (v : hom y z) → hom-fill X {x} {y} {z} u v → hom x z
fill-hom X {x} {y} {z} u v (Ψ , P) =
  let δ ∷ 𝕀 → simplex 2 = Simplex2.edge₀₂ in
  (preᵣ {𝕀} {simplex 2} {X} Ψ δ ,
   trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-src)
     (trans (happlyᵣ {spine2-edge-1} {X} (cong (spine2-cocone-edge-1 {X}) P) spine2-edge-1-start) (hom-src {X} {x} {y} u)) ,
   trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-tgt)
     (trans (happlyᵣ {spine2-edge-2} {X} (cong (spine2-cocone-edge-2 {X}) P) spine2-edge-2-end) (hom-tgt {X} {y} {z} v)))

-- the canonical filler: the Segal filler of the composable pair homs→spine2
comp-fill ∷ {X ∷ U} (s : is-segalᵣ X) {x y z : X} (u : hom x y) (v : hom y z) → hom-fill X {x} {y} {z} u v
comp-fill {X} s {x} {y} {z} u v =
  (comp-fillerᵣ s (homs→spine2 X {x} {y} {z} u v) ,
   trans (cong {spine 2 →ᵣ X} {spine2-coconeᵣ X} (spine2→coconeᵣ X)
            (comp-fillerᵣ-restr s (homs→spine2 X {x} {y} {z} u v)))
     (spine2→coconeᵣ-sec X (homs→spine2-cocone {X} {x} {y} {z} u v)))

-- composition of 1-cells of an oplax-Segal type; its cell is compᵣ s (homs→spine2 X u v)
comp-homᵣ ∷ {X ∷ U} → is-segalᵣ X → {x y z : X} → hom x y → hom y z → hom x z
comp-homᵣ {X} s {x} {y} {z} u v = fill-hom X {x} {y} {z} u v (comp-fill s {x} {y} {z} u v)

-- any two fillers give the same hom
fill-hom-unique ∷ {X ∷ U} (s : is-segalᵣ X) {x y z : X} (u : hom x y) (v : hom y z)
  (F : hom-fill X {x} {y} {z} u v) →
  comp-homᵣ s {x} {y} {z} u v ≡ fill-hom X {x} {y} {z} u v F
fill-hom-unique {X} s {x} {y} {z} u v F =
  cong {hom-fill X {x} {y} {z} u v} {hom x z} (fill-hom X {x} {y} {z} u v)
    (is-contr-eq (is-contr-hom-fill s {x} {y} {z} u v) (comp-fill s {x} {y} {z} u v) F)

--
-- The edges of a 2-simplex compose to its long edge
--
-- A 2-simplex Ψ has three edges, homs with refl boundary paths (the endpoints agree
-- judgmentally). With the path from its restriction to the edges of the spine to the cocone of
-- its two first edges (simplex2→cocone-edges), Ψ is a filler of that pair, so the composite of the
-- pair is the hom read off Ψ, which is its long edge (comp-simplex2).
--

simplex2-hom₀₁ ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom (Ψ (Simplex2.edge₀₁ 𝕀0)) (Ψ (Simplex2.edge₀₁ 𝕀1))
simplex2-hom₀₁ {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = Simplex2.edge₀₁ in
  (preᵣ {𝕀} {simplex 2} {X} Ψ e , refl , refl)

simplex2-hom₁₂ ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom (Ψ (Simplex2.edge₁₂ 𝕀0)) (Ψ (Simplex2.edge₁₂ 𝕀1))
simplex2-hom₁₂ {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = Simplex2.edge₁₂ in
  (preᵣ {𝕀} {simplex 2} {X} Ψ e , refl , refl)

simplex2-hom₀₂ ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom (Ψ (Simplex2.edge₀₂ 𝕀0)) (Ψ (Simplex2.edge₀₂ 𝕀1))
simplex2-hom₀₂ {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = Simplex2.edge₀₂ in
  (preᵣ {𝕀} {simplex 2} {X} Ψ e , refl , refl)

-- on the two edges of the spine, the inclusion into the simplex is the edge of the simplex
spine2-edge-1-in-simplex-pt ∷ (a : spine2-edge-1) → spine→simplex 2 (spine2-edge-1-incl a) ≡ Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)
spine2-edge-1-in-simplex-pt (c , w) =
  let h : (c : cart-cube 2) (w : spine2-on-edge-1 c) → spine→simplex 2 (spine2-edge-1-incl (c , w)) ≡
    Simplex2.edge₀₁ (spine2-edge-1→𝕀 (c , w)) =
    fun (c1 , xs) w →
      simplex-path 1 {(c1 , xs)} {(c1 , 𝕀0 , tt)} (cong {cart-cube 1} {cart-cube 2} (λ z . (c1 , z)) w)
        (snd (is-sorted 1) (spine→simplex 2 (spine2-edge-1-incl ((c1 , xs) , w)))) (refl , tt)
  in
  h c w

spine2-edge-2-in-simplex-pt ∷ (b : spine2-edge-2) → spine→simplex 2 (spine2-edge-2-incl b) ≡ Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)
spine2-edge-2-in-simplex-pt (c , w) =
  let h : (c1 : 𝕀) (x2 : 𝕀) (u : ⊤) (w : spine2-on-edge-2 (c1 , x2 , u)) →
      spine→simplex 2 (spine2-edge-2-incl ((c1 , x2 , u) , w)) ≡ Simplex2.edge₁₂ (spine2-edge-2→𝕀 ((c1 , x2 , u) , w)) =
    fun c1 x2 tt w →
      simplex-path 1 {(c1 , x2 , tt)} {(𝕀1 , x2 , tt)}
        (cong {𝕀} {cart-cube 2} (λ z . (z , x2 , tt)) (Product.fst {c1 ≡ 𝕀1} {is-in-spine 1 (x2 , tt)} w))
        (snd (is-sorted 1) (spine→simplex 2 (spine2-edge-2-incl ((c1 , x2 , tt) , w)))) (refl , tt)
  in
  let k : (c : cart-cube 2) (w : spine2-on-edge-2 c) → spine→simplex 2 (spine2-edge-2-incl (c , w)) ≡
    Simplex2.edge₁₂ (spine2-edge-2→𝕀 (c , w)) =
    fun (c1 , xs) → let m : (xs : cart-cube 1) (w : spine2-on-edge-2 (c1 , xs)) → spine→simplex 2
      (spine2-edge-2-incl ((c1 , xs) , w)) ≡ Simplex2.edge₁₂ (spine2-edge-2→𝕀 ((c1 , xs) , w)) =
      fun (x2 , u) w → h c1 x2 u w in m xs
  in
  k c w

spine2-edge-1-in-simplex-htpy ∷ (λ a . spine→simplex 2 (spine2-edge-1-incl a))
  ≡{spine2-edge-1 → simplex 2} (λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a))
spine2-edge-1-in-simplex-htpy =
  funext-htpy {spine2-edge-1} {λ _ . simplex 2} (λ a . spine→simplex 2 (spine2-edge-1-incl a))
    (λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)) spine2-edge-1-in-simplex-pt

spine2-edge-2-in-simplex-htpy ∷ (λ b . spine→simplex 2 (spine2-edge-2-incl b))
  ≡{spine2-edge-2 → simplex 2} (λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b))
spine2-edge-2-in-simplex-htpy =
  funext-htpy {spine2-edge-2} {λ _ . simplex 2} (λ b . spine→simplex 2 (spine2-edge-2-incl b))
    (λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)) spine2-edge-2-in-simplex-pt

-- the restriction of a 2-simplex to the edges of the spine is the cocone of its two first edges
simplex2→cocone-edges ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) →
  simplex2→coconeᵣ X Ψ ≡ homs→spine2-cocone {X} {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} {Ψ (Simplex2.edge₁₂ 𝕀1)}
    (simplex2-hom₀₁ {X} Ψ) (simplex2-hom₁₂ {X} Ψ)
simplex2→cocone-edges {X} Ψ =
  let PA ∷ (λ a . spine→simplex 2 (spine2-edge-1-incl a)) ≡{spine2-edge-1 → simplex 2}
    (λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)) = spine2-edge-1-in-simplex-htpy in
  let PB ∷ (λ b . spine→simplex 2 (spine2-edge-2-incl b)) ≡{spine2-edge-2 → simplex 2}
    (λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)) = spine2-edge-2-in-simplex-htpy in
  spine2-cocone-path X
    (preᵣ {spine2-edge-1} {simplex 2} {X} Ψ (λ a . spine→simplex 2 (spine2-edge-1-incl a)))
    (preᵣ {spine2-edge-2} {simplex 2} {X} Ψ (λ b . spine→simplex 2 (spine2-edge-2-incl b)))
    (congᵣ {spine 2} {X} (spine-restrᵣ 2 X Ψ) {spine2-edge-1-incl spine2-edge-1-end}
        {spine2-edge-2-incl spine2-edge-2-start} spine2-glue)
    (preᵣ {spine2-edge-1} {simplex 2} {X} Ψ (λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)))
    (preᵣ-path spine2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine2-edge-1-incl a)}
        {λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)} PA Ψ)
    (preᵣ {spine2-edge-2} {simplex 2} {X} Ψ (λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)))
    (preᵣ-path spine2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine2-edge-2-incl b)}
        {λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)} PB Ψ)
    refl
    (trans
      (cong2 {Ψ (spine→simplex 2 (spine2-edge-1-incl spine2-edge-1-end)) ≡ Ψ
            (spine→simplex 2 (spine2-edge-2-incl spine2-edge-2-start))}
          {Ψ (spine→simplex 2 (spine2-edge-2-incl spine2-edge-2-start)) ≡ Ψ (Simplex2.edge₁₂ 𝕀0)}
             {Ψ (spine→simplex 2 (spine2-edge-1-incl spine2-edge-1-end)) ≡ Ψ (Simplex2.edge₁₂ 𝕀0)} (λ α β . trans α β)
        (congᵣ-preᵣ (spine 2) {simplex 2} {X} {spine2-edge-1-incl spine2-edge-1-end}
            {spine2-edge-2-incl spine2-edge-2-start} spine2-glue (spine→simplex 2) Ψ)
        (happlyᵣ-preᵣ-path spine2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine2-edge-2-incl b)}
            {λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)} PB spine2-edge-2-start Ψ))
      (trans (sym (congᵣ-trans {simplex 2} {X} (cong (spine→simplex 2) spine2-glue)
              (happly {spine2-edge-2} {λ _ . simplex 2} PB spine2-edge-2-start) Ψ))
        (trans (congᵣ-set (is-set-simplex 1) (trans (cong (spine→simplex 2) spine2-glue)
                (happly {spine2-edge-2} {λ _ . simplex 2} PB spine2-edge-2-start))
                  (happly {spine2-edge-1} {λ _ . simplex 2} PA spine2-edge-1-end) Ψ)
          (sym (happlyᵣ-preᵣ-path spine2-edge-1 {simplex 2} {X}
                {λ a . spine→simplex 2 (spine2-edge-1-incl a)} {λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)} PA
                spine2-edge-1-end Ψ)))))

-- the hom read off a 2-simplex is its long edge: the boundary paths are images of loops in the
-- set Δ²
fill-hom-simplex2 ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) →
  fill-hom X {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} {Ψ (Simplex2.edge₁₂ 𝕀1)} (simplex2-hom₀₁ {X} Ψ) (simplex2-hom₁₂ {X} Ψ)
    (Ψ , simplex2→cocone-edges {X} Ψ) ≡ simplex2-hom₀₂ {X} Ψ
fill-hom-simplex2 {X} Ψ =
  let PA ∷ (λ a . spine→simplex 2 (spine2-edge-1-incl a)) ≡{spine2-edge-1 → simplex 2}
    (λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)) = spine2-edge-1-in-simplex-htpy in
  let PB ∷ (λ b . spine→simplex 2 (spine2-edge-2-incl b)) ≡{spine2-edge-2 → simplex 2}
    (λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)) = spine2-edge-2-in-simplex-htpy in
  let fg : (cong (spine2-cocone-edge-1 {X}) (simplex2→cocone-edges {X} Ψ)
              ≡ preᵣ-path spine2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine2-edge-1-incl a)}
                {λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)} PA Ψ) ×
           (cong (spine2-cocone-edge-2 {X}) (simplex2→cocone-edges {X} Ψ)
              ≡ preᵣ-path spine2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine2-edge-2-incl b)}
                {λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)} PB Ψ) =
    spine2-cocone-path-maps X _ _ _ _ _ _ _ _ _ in
  let src : trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-src)
              (happlyᵣ {spine2-edge-1} {X} (cong (spine2-cocone-edge-1 {X}) (simplex2→cocone-edges {X} Ψ))
                  spine2-edge-1-start) ≡ refl =
    trans (cong {Ψ (spine→simplex 2 (spine2-edge-1-incl spine2-edge-1-start)) ≡ Ψ (Simplex2.edge₀₂ 𝕀0)}
        {Ψ (Simplex2.edge₀₂ 𝕀0) ≡ Ψ (Simplex2.edge₀₂ 𝕀0)}
            (λ β . trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-src) β)
            (trans (cong {_ ≡ _} {_ ≡ _} (λ p . happlyᵣ {spine2-edge-1} {X} p spine2-edge-1-start) (Product.fst fg))
              (happlyᵣ-preᵣ-path spine2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine2-edge-1-incl a)}
                  {λ a . Simplex2.edge₀₁ (spine2-edge-1→𝕀 a)} PA spine2-edge-1-start Ψ)))
      (trans (sym (congᵣ-trans {simplex 2} {X} simplex2-edge₀₂-src
              (happly {spine2-edge-1} {λ _ . simplex 2} PA spine2-edge-1-start) Ψ))
        (congᵣ-set (is-set-simplex 1) (trans simplex2-edge₀₂-src
              (happly {spine2-edge-1} {λ _ . simplex 2} PA spine2-edge-1-start)) refl Ψ)) in
  let tgt : trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-tgt)
              (happlyᵣ {spine2-edge-2} {X} (cong (spine2-cocone-edge-2 {X}) (simplex2→cocone-edges {X} Ψ))
                  spine2-edge-2-end) ≡ refl =
    trans (cong {Ψ (spine→simplex 2 (spine2-edge-2-incl spine2-edge-2-end)) ≡ Ψ (Simplex2.edge₀₂ 𝕀1)}
        {Ψ (Simplex2.edge₀₂ 𝕀1) ≡ Ψ (Simplex2.edge₀₂ 𝕀1)}
            (λ β . trans (congᵣ {simplex 2} {X} Ψ simplex2-edge₀₂-tgt) β)
            (trans (cong {_ ≡ _} {_ ≡ _} (λ p . happlyᵣ {spine2-edge-2} {X} p spine2-edge-2-end) (Product.snd fg))
              (happlyᵣ-preᵣ-path spine2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine2-edge-2-incl b)}
                  {λ b . Simplex2.edge₁₂ (spine2-edge-2→𝕀 b)} PB spine2-edge-2-end Ψ)))
      (trans (sym (congᵣ-trans {simplex 2} {X} simplex2-edge₀₂-tgt (happly {spine2-edge-2} {λ _ . simplex 2} PB spine2-edge-2-end) Ψ))
        (congᵣ-set (is-set-simplex 1) (trans simplex2-edge₀₂-tgt
              (happly {spine2-edge-2} {λ _ . simplex 2} PB spine2-edge-2-end)) refl Ψ)) in
  cong {(Ψ (Simplex2.edge₀₂ 𝕀0) ≡ Ψ (Simplex2.edge₀₂ 𝕀0)) × (Ψ (Simplex2.edge₀₂ 𝕀1) ≡ Ψ (Simplex2.edge₀₂ 𝕀1))}
    {hom (Ψ (Simplex2.edge₀₂ 𝕀0)) (Ψ (Simplex2.edge₀₂ 𝕀1))}
    (λ w . (preᵣ {𝕀} {simplex 2} {X} Ψ Simplex2.edge₀₂ , w))
    (cong2 {Ψ (Simplex2.edge₀₂ 𝕀0) ≡ Ψ (Simplex2.edge₀₂ 𝕀0)} {Ψ (Simplex2.edge₀₂ 𝕀1) ≡ Ψ (Simplex2.edge₀₂ 𝕀1)}
        {(Ψ (Simplex2.edge₀₂ 𝕀0) ≡ Ψ (Simplex2.edge₀₂ 𝕀0)) × (Ψ (Simplex2.edge₀₂ 𝕀1) ≡ Ψ (Simplex2.edge₀₂ 𝕀1))}
      pair src tgt)

-- the composite of the two first edges of a 2-simplex is its long edge
comp-simplex2 ∷ {X ∷ U} (s : is-segalᵣ X) (Ψ : simplex 2 →ᵣ X) →
  comp-homᵣ s {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} {Ψ (Simplex2.edge₁₂ 𝕀1)} (simplex2-hom₀₁ {X} Ψ)
    (simplex2-hom₁₂ {X} Ψ) ≡ simplex2-hom₀₂ {X} Ψ
comp-simplex2 {X} s Ψ =
  trans (fill-hom-unique s {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} {Ψ (Simplex2.edge₁₂ 𝕀1)}
      (simplex2-hom₀₁ {X} Ψ) (simplex2-hom₁₂ {X} Ψ)
           (Ψ , simplex2→cocone-edges {X} Ψ))
    (fill-hom-simplex2 {X} Ψ)

-- the same with a path from the first vertex to any point, as source path of the first edge
comp-simplex2-src ∷ {X ∷ U} (s : is-segalᵣ X) (Ψ : simplex 2 →ᵣ X) {x : X} (γ : Ψ (Simplex2.edge₀₁ 𝕀0) ≡ x) →
  comp-homᵣ s {x} {Ψ (Simplex2.edge₀₁ 𝕀1)} {Ψ (Simplex2.edge₁₂ 𝕀1)}
    (hom-cell {X} {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} (simplex2-hom₀₁ {X} Ψ) , γ , refl) (simplex2-hom₁₂ {X} Ψ)
    ≡ (hom-cell {X} {Ψ (Simplex2.edge₀₂ 𝕀0)} {Ψ (Simplex2.edge₀₂ 𝕀1)} (simplex2-hom₀₂ {X} Ψ) , γ , refl)
comp-simplex2-src {X} s Ψ refl = comp-simplex2 s Ψ

-- the same with a path from the middle vertex to any point, as target path of the first edge and
-- source path of the second
comp-simplex2-paths ∷ {X ∷ U} (s : is-segalᵣ X) (Ψ : simplex 2 →ᵣ X) {x : X} (γ₀ : Ψ (Simplex2.edge₀₁ 𝕀0) ≡ x)
  {z : X} (γ₁ : Ψ (Simplex2.edge₀₁ 𝕀1) ≡ z) →
  comp-homᵣ s {x} {z} {Ψ (Simplex2.edge₁₂ 𝕀1)}
    (hom-cell {X} {Ψ (Simplex2.edge₀₁ 𝕀0)} {Ψ (Simplex2.edge₀₁ 𝕀1)} (simplex2-hom₀₁ {X} Ψ) , γ₀ , γ₁)
    (hom-cell {X} {Ψ (Simplex2.edge₁₂ 𝕀0)} {Ψ (Simplex2.edge₁₂ 𝕀1)} (simplex2-hom₁₂ {X} Ψ) , γ₁ , refl)
    ≡ (hom-cell {X} {Ψ (Simplex2.edge₀₂ 𝕀0)} {Ψ (Simplex2.edge₀₂ 𝕀1)} (simplex2-hom₀₂ {X} Ψ) , γ₀ , refl)
comp-simplex2-paths {X} s Ψ {x} γ₀ refl = comp-simplex2-src s Ψ {x} γ₀
