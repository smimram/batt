--
-- Functorial binary composition of 1-cells in oplax-Segal types
--
-- The 1-cells of X are the oplax maps 𝕀 →ᵣ X. A composable pair of 1-cells is an oplax map out
-- of the 2-spine Λ² = Sp₂ (two edges glued at their common vertex). When X is oplax-Segal,
-- restriction (Δ² →ᵣ X) → (Sp₂ →ᵣ X) along the spine inclusion is an equivalence; the composite
-- of a composable pair φ is obtained by extending φ to a 2-simplex (the filler) and restricting
-- it to the long edge δ of Δ²:
--
--   comp-r : (Sp₂ →ᵣ X) → (𝕀 →ᵣ X),    comp-r φ = (filler of φ) ∘ δ
--
-- Composition is thus a function on the whole type of composable pairs.
--

open import Stdlib
open import Segal
open import Hom
open import Spine-up

--
-- The two 1-cells of a composable pair
--

fst-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
fst-cell {X} φ =
  let e ∷ 𝕀 → spine 2 = spine-edge-1 in
  pre-r {𝕀} φ e

snd-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
snd-cell {X} φ =
  let e ∷ 𝕀 → spine 2 = spine-edge-2 in
  pre-r {𝕀} φ e

--
-- Filler and composite
--

-- the unthickened oplax Segal condition for Λ² ↪ Δ²
abstract is-segal-r-2 ∷ (X ∷ U) → is-segal-r X → is-equiv (segal-restr-r nil 2 nil X)
is-segal-r-2 X s = s nil 2 nil

-- the section of restriction along Λ² ↪ Δ² given by the oplax Segal condition
segal-section-r ∷ (X ∷ U) → is-segal-r X → section (segal-restr-r nil 2 nil X)
segal-section-r X s = is-equiv-sec (segal-restr-r nil 2 nil X) (is-segal-r-2 X s)

-- the extension of a (trivially thickened) composable pair to a (trivially thickened) 2-simplex
thick-filler-r ∷ (X ∷ U) → is-segal-r X → (thick-spine nil 2 nil →ᵣ X) → (thick-simplex nil 2 nil →ᵣ X)
thick-filler-r X s = map-section (segal-restr-r nil 2 nil X) (segal-section-r X s)

-- it restricts back to the given pair
abstract thick-filler-r-restr ∷ (X ∷ U) (s : is-segal-r X) (ψ : thick-spine nil 2 nil →ᵣ X) →
  segal-restr-r nil 2 nil X (thick-filler-r X s ψ) ≡ ψ
thick-filler-r-restr X s ψ =
  snd {(thick-spine nil 2 nil →ᵣ X) → (thick-simplex nil 2 nil →ᵣ X)}
    (is-section (segal-restr-r nil 2 nil X)) (segal-section-r X s) ψ

-- the composable pair φ, trivially thickened
thick-pair-r ∷ {X ∷ U} → (spine 2 →ᵣ X) → (thick-spine nil 2 nil →ᵣ X)
thick-pair-r {X} φ =
  let u ∷ thick-spine nil 2 nil → spine 2 = thicken-unit {spine 2} in
  pre-r {thick-spine nil 2 nil} φ u

-- the 2-simplex filling a composable pair: the Segal extension along Λ² ↪ Δ², transported
-- through the unit laws ⊤ ⊗ (− ⊗ ⊤) of the (trivial) thickening
comp-filler-r ∷ (X ∷ U) → is-segal-r X → (spine 2 →ᵣ X) → (simplex 2 →ᵣ X)
comp-filler-r X s φ =
  let c ∷ simplex 2 → thick-simplex nil 2 nil = thicken-counit {simplex 2} in
  pre-r {simplex 2} (thick-filler-r X s (thick-pair-r {X} φ)) c

-- the composite of a composable pair: the long edge of its filler
comp-r ∷ (X ∷ U) → is-segal-r X → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
comp-r X s φ =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  pre-r {𝕀} (comp-filler-r X s φ) δ

--
-- Boundary of the composite: it goes from the source of the first cell to the target of the
-- second one
--

-- on the image of the spine, the filler of φ agrees with φ
abstract comp-filler-r-spine ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (v ∷ spine 2) {y ∷ simplex 2}
  (r ∷ y ≡ spine→simplex 2 v) → comp-filler-r X s φ y ≡ φ v
comp-filler-r-spine X s φ v {y} r =
  let c ∷ simplex 2 → thick-simplex nil 2 nil = thicken-counit {simplex 2} in
  let r' ∷ c y ≡ c (spine→simplex 2 v) = cong c r in
  let w ∷ thick-spine nil 2 nil = thicken-counit {spine 2} v in
  let Φ : thick-simplex nil 2 nil →ᵣ X = thick-filler-r X s (thick-pair-r {X} φ) in
  trans (ap-r r' Φ) (ev-r w (thick-filler-r-restr X s (thick-pair-r {X} φ)))

abstract comp-r-src ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → comp-r X s φ 𝕀0 ≡ fst-cell {X} φ 𝕀0
comp-r-src X s φ =
  comp-filler-r-spine X s φ (spine-edge-1 𝕀0)
    (sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (spine-edge-1 𝕀0))))

abstract comp-r-tgt ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → comp-r X s φ 𝕀1 ≡ snd-cell {X} φ 𝕀1
comp-r-tgt X s φ =
  comp-filler-r-spine X s φ (spine-edge-2 𝕀1)
    (sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (spine-edge-2 𝕀1))))

--
-- Uniqueness of fillers: any 2-simplex restricting to φ on the spine is the filler of φ, so its
-- long edge is the composite of φ (unthickened oplax Segal condition, Segal.batt)
--

abstract comp-filler-r-restr ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → spine-restr-r 2 X (comp-filler-r X s φ) ≡ φ
comp-filler-r-restr X s φ =
  let c ∷ spine 2 → thick-spine nil 2 nil = thicken-counit {spine 2} in
  cong {thick-spine nil 2 nil →ᵣ X} {spine 2 →ᵣ X} (λ ψ . pre-r {spine 2} {thick-spine nil 2 nil} {X} ψ c)
    (thick-filler-r-restr X s (thick-pair-r {X} φ))

abstract comp-filler-r-unique ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restr-r 2 X Ψ ≡ φ → comp-filler-r X s φ ≡ Ψ
comp-filler-r-unique X s φ Ψ H =
  retraction-inj (spine-restr-r 2 X) (is-equiv-ret (spine-restr-r 2 X) (is-segal-r-unthick X s 2)) {comp-filler-r X s φ} {Ψ}
    (trans (comp-filler-r-restr X s φ) (sym H))

abstract comp-r-unique ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restr-r 2 X Ψ ≡ φ → comp-r X s φ ≡ pre-r {𝕀} {simplex 2} {X} Ψ long-edge
comp-r-unique X s φ Ψ H =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  cong {simplex 2 →ᵣ X} {𝕀 →ᵣ X} (λ F . pre-r {𝕀} {simplex 2} {X} F δ) (comp-filler-r-unique X s φ Ψ H)

--
-- Composition on hom types
--
-- Two 1-cells u : hom X x y and v : hom X y z form an oplax cocone on the two edges of the
-- spine (hom-pair), hence a composable pair hom-spine : spine 2 →ᵣ X by the oplax universal
-- property of the spine (Spine-up.batt, Wedge.batt).
--
-- The composite is read off a filler: a 2-simplex Ψ together with a path P from its restriction
-- to the two edges (simplex-coc-r) to the cocone of u and v, i.e. a point of the fibre of
-- simplex-coc-r over hom-pair u v. Its cell is the long edge of Ψ; its source is
--   Ψ (δ 0) = Ψ (vertex 0 of the first edge) = (first edge of the cocone) 0 = u 0 = x,
-- using P at the vertex 0 of the first edge, and dually for the target (fill-hom). The fibre is
-- contractible (simplex-coc-r is an equivalence when X is oplax-Segal), and the composite is
-- fill-hom at the canonical filler (comp-fill). Any other filler gives the same hom, which is how
-- the unit laws are proved on hom types (Unitality.batt).
--
-- The cartesian universal property of the spine (spine-cart-up) is abstract, so that statements
-- mentioning it do not unfold its proof.
--

-- the first coordinate on the first edge, the second one on the second edge
spine-2-edge-1→𝕀 ∷ spine-2-edge-1 → 𝕀
spine-2-edge-1→𝕀 (c , a) = cube-2-x1 c

spine-2-edge-2→𝕀 ∷ spine-2-edge-2 → 𝕀
spine-2-edge-2→𝕀 (c , b) = cube-2-x2 c

-- the oplax cocone formed by two consecutive homs
hom-pair ∷ {X ∷ U} {x y z : X} → hom X x y → hom X y z → spine-cocone-r X
hom-pair {X} {x} {y} {z} u v =
  let ca ∷ spine-2-edge-1 → 𝕀 = spine-2-edge-1→𝕀 in
  let cb ∷ spine-2-edge-2 → 𝕀 = spine-2-edge-2→𝕀 in
  (pre-r {spine-2-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) ca ,
   pre-r {spine-2-edge-2} {𝕀} {X} (hom-cell {X} {y} {z} v) cb ,
   trans (hom-tgt {X} {x} {y} u) (sym (hom-src {X} {y} {z} v)))

-- the composable pair they define
hom-spine ∷ (X ∷ U) {x y z : X} → hom X x y → hom X y z → (spine 2 →ᵣ X)
hom-spine X {x} {y} {z} u v = cocone→spine-2-r X (hom-pair {X} {x} {y} {z} u v)

-- restriction of a 2-simplex to an oplax cocone on the two edges of the spine
simplex-coc-r ∷ (X ∷ U) → (simplex 2 →ᵣ X) → spine-cocone-r X
simplex-coc-r X Ψ = spine-2→cocone-r X (spine-restr-r 2 X Ψ)

abstract is-equiv-simplex-coc-r ∷ (X ∷ U) → is-segal-r X → is-equiv (simplex-coc-r X)
is-equiv-simplex-coc-r X s =
  is-equiv-circ (spine-2→cocone-r X) (spine-restr-r 2 X)
    (spine-oplax-up X) (is-segal-r-unthick X s 2)

-- fillers of the pair (u , v)
hom-fill ∷ (X ∷ U) {x y z : X} → hom X x y → hom X y z → U
hom-fill X {x} {y} {z} u v = fib (simplex-coc-r X) (hom-pair {X} {x} {y} {z} u v)

abstract is-contr-hom-fill ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z) →
  is-contr (hom-fill X {x} {y} {z} u v)
is-contr-hom-fill X s {x} {y} {z} u v =
  is-contr-fib (simplex-coc-r X) (is-equiv-simplex-coc-r X s) (hom-pair {X} {x} {y} {z} u v)

-- the long edge starts at the vertex 0 and ends at the vertex 2 of the spine
long-edge-src ∷ long-edge 𝕀0 ≡{simplex 2} spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)
long-edge-src =
  sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt)
    (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (spine-2-edge-1-incl spine-2-edge-1-start)))

long-edge-tgt ∷ long-edge 𝕀1 ≡{simplex 2} spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)
long-edge-tgt =
  sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt)
    (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (spine-2-edge-2-incl spine-2-edge-2-end)))

-- the hom given by a filler: its cell is the long edge, its boundary is read off at the outer
-- vertices of the spine
fill-hom ∷ (X ∷ U) {x y z : X} (u : hom X x y) (v : hom X y z) → hom-fill X {x} {y} {z} u v → hom X x z
fill-hom X {x} {y} {z} u v (Ψ , P) =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  (pre-r {𝕀} {simplex 2} {X} Ψ δ ,
   trans (ap-r {simplex 2} {X} long-edge-src Ψ)
     (trans (ev-r {spine-2-edge-1} {X} spine-2-edge-1-start (cong (spine-2-cocone-edge-1 {X}) P)) (hom-src {X} {x} {y} u)) ,
   trans (ap-r {simplex 2} {X} long-edge-tgt Ψ)
     (trans (ev-r {spine-2-edge-2} {X} spine-2-edge-2-end (cong (spine-2-cocone-edge-2 {X}) P)) (hom-tgt {X} {y} {z} v)))

-- the canonical filler: the Segal filler of the composable pair hom-spine
comp-fill ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z) → hom-fill X {x} {y} {z} u v
comp-fill X s {x} {y} {z} u v =
  (comp-filler-r X s (hom-spine X {x} {y} {z} u v) ,
   trans (cong {spine 2 →ᵣ X} {spine-cocone-r X} (spine-2→cocone-r X)
            (comp-filler-r-restr X s (hom-spine X {x} {y} {z} u v)))
     (spine-2→cocone-r-sec X (hom-pair {X} {x} {y} {z} u v)))

-- composition of 1-cells of an oplax-Segal type; its cell is comp-r X s (hom-spine X u v)
comp-hom-r ∷ (X ∷ U) → is-segal-r X → {x y z : X} → hom X x y → hom X y z → hom X x z
comp-hom-r X s {x} {y} {z} u v = fill-hom X {x} {y} {z} u v (comp-fill X s {x} {y} {z} u v)

-- any two fillers give the same hom
abstract fill-hom-unique ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z)
  (F : hom-fill X {x} {y} {z} u v) →
  comp-hom-r X s {x} {y} {z} u v ≡ fill-hom X {x} {y} {z} u v F
fill-hom-unique X s {x} {y} {z} u v F =
  cong {hom-fill X {x} {y} {z} u v} {hom X x z} (fill-hom X {x} {y} {z} u v)
    (is-contr-eq (is-contr-hom-fill X s {x} {y} {z} u v) (comp-fill X s {x} {y} {z} u v) F)

--
-- The edges of a 2-simplex compose to its long edge
--
-- A 2-simplex Ψ has three edges, homs with refl boundary paths (the endpoints agree
-- judgmentally). With the path from its restriction to the edges of the spine to the cocone of
-- its two first edges (simplex-coc-edges), Ψ is a filler of that pair, so the composite of the
-- pair is the hom read off Ψ, which is its long edge (comp-simplex-2).
--

simplex-2-hom01 ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom X (Ψ (simplex-2-e01 𝕀0)) (Ψ (simplex-2-e01 𝕀1))
simplex-2-hom01 {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = simplex-2-e01 in
  (pre-r {𝕀} {simplex 2} {X} Ψ e , refl , refl)

simplex-2-hom12 ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom X (Ψ (simplex-2-e12 𝕀0)) (Ψ (simplex-2-e12 𝕀1))
simplex-2-hom12 {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = simplex-2-e12 in
  (pre-r {𝕀} {simplex 2} {X} Ψ e , refl , refl)

simplex-2-hom02 ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) → hom X (Ψ (long-edge 𝕀0)) (Ψ (long-edge 𝕀1))
simplex-2-hom02 {X} Ψ =
  let e ∷ 𝕀 → simplex 2 = long-edge in
  (pre-r {𝕀} {simplex 2} {X} Ψ e , refl , refl)

-- on the two edges of the spine, the inclusion into the simplex is the edge of the simplex
spine-2-edge-1-in-simplex-pt ∷ (a : spine-2-edge-1) → spine→simplex 2 (spine-2-edge-1-incl a) ≡ simplex-2-e01 (spine-2-edge-1→𝕀 a)
spine-2-edge-1-in-simplex-pt (c , w) =
  let h : (c : cart-cube 2) (w : spine-2-on-edge-1 c) → spine→simplex 2 (spine-2-edge-1-incl (c , w)) ≡
    simplex-2-e01 (spine-2-edge-1→𝕀 (c , w)) =
    fun (c1 , xs) w →
      simplex-path 1 {(c1 , xs)} {(c1 , 𝕀0 , tt)} (cong {cart-cube 1} {cart-cube 2} (λ z . (c1 , z)) w)
        (snd (is-sorted 1) (spine→simplex 2 (spine-2-edge-1-incl ((c1 , xs) , w)))) (refl , tt)
  in
  h c w

spine-2-edge-2-in-simplex-pt ∷ (b : spine-2-edge-2) → spine→simplex 2 (spine-2-edge-2-incl b) ≡ simplex-2-e12 (spine-2-edge-2→𝕀 b)
spine-2-edge-2-in-simplex-pt (c , w) =
  let h : (c1 : 𝕀) (x2 : 𝕀) (u : ⊤) (w : spine-2-on-edge-2 (c1 , x2 , u)) →
      spine→simplex 2 (spine-2-edge-2-incl ((c1 , x2 , u) , w)) ≡ simplex-2-e12 (spine-2-edge-2→𝕀 ((c1 , x2 , u) , w)) =
    fun c1 x2 tt w →
      simplex-path 1 {(c1 , x2 , tt)} {(𝕀1 , x2 , tt)}
        (cong {𝕀} {cart-cube 2} (λ z . (z , x2 , tt)) (prod-fst {c1 ≡ 𝕀1} {is-in-spine 1 (x2 , tt)} w))
        (snd (is-sorted 1) (spine→simplex 2 (spine-2-edge-2-incl ((c1 , x2 , tt) , w)))) (refl , tt)
  in
  let k : (c : cart-cube 2) (w : spine-2-on-edge-2 c) → spine→simplex 2 (spine-2-edge-2-incl (c , w)) ≡
    simplex-2-e12 (spine-2-edge-2→𝕀 (c , w)) =
    fun (c1 , xs) → let m : (xs : cart-cube 1) (w : spine-2-on-edge-2 (c1 , xs)) → spine→simplex 2
      (spine-2-edge-2-incl ((c1 , xs) , w)) ≡ simplex-2-e12 (spine-2-edge-2→𝕀 ((c1 , xs) , w)) =
      fun (x2 , u) w → h c1 x2 u w in m xs
  in
  k c w

spine-2-edge-1-in-simplex-htpy ∷ (λ a . spine→simplex 2 (spine-2-edge-1-incl a))
  ≡{spine-2-edge-1 → simplex 2} (λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a))
spine-2-edge-1-in-simplex-htpy =
  funext-htpy {spine-2-edge-1} {λ _ . simplex 2} (λ a . spine→simplex 2 (spine-2-edge-1-incl a))
    (λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)) spine-2-edge-1-in-simplex-pt

spine-2-edge-2-in-simplex-htpy ∷ (λ b . spine→simplex 2 (spine-2-edge-2-incl b))
  ≡{spine-2-edge-2 → simplex 2} (λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b))
spine-2-edge-2-in-simplex-htpy =
  funext-htpy {spine-2-edge-2} {λ _ . simplex 2} (λ b . spine→simplex 2 (spine-2-edge-2-incl b))
    (λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)) spine-2-edge-2-in-simplex-pt

-- the restriction of a 2-simplex to the edges of the spine is the cocone of its two first edges
simplex-coc-edges ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) →
  simplex-coc-r X Ψ ≡ hom-pair {X} {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e01 𝕀1)} {Ψ (simplex-2-e12 𝕀1)}
    (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ)
simplex-coc-edges {X} Ψ =
  let PA ∷ (λ a . spine→simplex 2 (spine-2-edge-1-incl a)) ≡{spine-2-edge-1 → simplex 2}
    (λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)) = spine-2-edge-1-in-simplex-htpy in
  let PB ∷ (λ b . spine→simplex 2 (spine-2-edge-2-incl b)) ≡{spine-2-edge-2 → simplex 2}
    (λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)) = spine-2-edge-2-in-simplex-htpy in
  spine-2-cocone-path X
    (pre-r {spine-2-edge-1} {simplex 2} {X} Ψ (λ a . spine→simplex 2 (spine-2-edge-1-incl a)))
    (pre-r {spine-2-edge-2} {simplex 2} {X} Ψ (λ b . spine→simplex 2 (spine-2-edge-2-incl b)))
    (ap-r {spine 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start}
        spine-2-glue (spine-restr-r 2 X Ψ))
    (pre-r {spine-2-edge-1} {simplex 2} {X} Ψ (λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)))
    (pre-r-path spine-2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine-2-edge-1-incl a)}
        {λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)} PA Ψ)
    (pre-r {spine-2-edge-2} {simplex 2} {X} Ψ (λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)))
    (pre-r-path spine-2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine-2-edge-2-incl b)}
        {λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)} PB Ψ)
    refl
    (trans
      (cong2 {Ψ (spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-end)) ≡ Ψ
            (spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-start))}
          {Ψ (spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-start)) ≡ Ψ (simplex-2-e12 𝕀0)}
             {Ψ (spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-end)) ≡ Ψ (simplex-2-e12 𝕀0)} (λ α β . trans α β)
        (ap-r-pre-r (spine 2) {simplex 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end}
            {spine-2-edge-2-incl spine-2-edge-2-start} spine-2-glue (spine→simplex 2) Ψ)
        (ev-r-pre-r-path spine-2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine-2-edge-2-incl b)}
            {λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)} PB spine-2-edge-2-start Ψ))
      (trans (sym (ap-r-trans {simplex 2} {X} (cong (spine→simplex 2) spine-2-glue)
              (happly {spine-2-edge-2} {λ _ . simplex 2} PB spine-2-edge-2-start) Ψ))
        (trans (ap-r-set (is-set-simplex 1) (trans (cong (spine→simplex 2) spine-2-glue)
                (happly {spine-2-edge-2} {λ _ . simplex 2} PB spine-2-edge-2-start))
                  (happly {spine-2-edge-1} {λ _ . simplex 2} PA spine-2-edge-1-end) Ψ)
          (sym (ev-r-pre-r-path spine-2-edge-1 {simplex 2} {X}
                {λ a . spine→simplex 2 (spine-2-edge-1-incl a)} {λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)} PA
                spine-2-edge-1-end Ψ)))))

-- the hom read off a 2-simplex is its long edge: the boundary paths are images of loops in the
-- set Δ²
abstract fill-hom-simplex-2 ∷ {X ∷ U} (Ψ : simplex 2 →ᵣ X) →
  fill-hom X {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e01 𝕀1)} {Ψ (simplex-2-e12 𝕀1)} (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ)
    (Ψ , simplex-coc-edges {X} Ψ) ≡ simplex-2-hom02 {X} Ψ
fill-hom-simplex-2 {X} Ψ =
  let PA ∷ (λ a . spine→simplex 2 (spine-2-edge-1-incl a)) ≡{spine-2-edge-1 → simplex 2}
    (λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)) = spine-2-edge-1-in-simplex-htpy in
  let PB ∷ (λ b . spine→simplex 2 (spine-2-edge-2-incl b)) ≡{spine-2-edge-2 → simplex 2}
    (λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)) = spine-2-edge-2-in-simplex-htpy in
  let fg : (cong (spine-2-cocone-edge-1 {X}) (simplex-coc-edges {X} Ψ)
              ≡ pre-r-path spine-2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine-2-edge-1-incl a)}
                {λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)} PA Ψ) ×
           (cong (spine-2-cocone-edge-2 {X}) (simplex-coc-edges {X} Ψ)
              ≡ pre-r-path spine-2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine-2-edge-2-incl b)}
                {λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)} PB Ψ) =
    spine-2-cocone-path-fg X _ _ _ _ _ _ _ _ _ in
  let src : trans (ap-r {simplex 2} {X} long-edge-src Ψ)
              (ev-r {spine-2-edge-1} {X} spine-2-edge-1-start
                  (cong (spine-2-cocone-edge-1 {X}) (simplex-coc-edges {X} Ψ))) ≡ refl =
    trans (cong {Ψ (spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)) ≡ Ψ (long-edge 𝕀0)}
        {Ψ (long-edge 𝕀0) ≡ Ψ (long-edge 𝕀0)}
            (λ β . trans (ap-r {simplex 2} {X} long-edge-src Ψ) β)
            (trans (cong (ev-r {spine-2-edge-1} {X} spine-2-edge-1-start) (prod-fst fg))
              (ev-r-pre-r-path spine-2-edge-1 {simplex 2} {X} {λ a . spine→simplex 2 (spine-2-edge-1-incl a)}
                  {λ a . simplex-2-e01 (spine-2-edge-1→𝕀 a)} PA spine-2-edge-1-start Ψ)))
      (trans (sym (ap-r-trans {simplex 2} {X} long-edge-src
              (happly {spine-2-edge-1} {λ _ . simplex 2} PA spine-2-edge-1-start) Ψ))
        (ap-r-set (is-set-simplex 1) (trans long-edge-src
              (happly {spine-2-edge-1} {λ _ . simplex 2} PA spine-2-edge-1-start)) refl Ψ)) in
  let tgt : trans (ap-r {simplex 2} {X} long-edge-tgt Ψ)
              (ev-r {spine-2-edge-2} {X} spine-2-edge-2-end (cong (spine-2-cocone-edge-2 {X}) (simplex-coc-edges {X} Ψ))) ≡ refl =
    trans (cong {Ψ (spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)) ≡ Ψ (long-edge 𝕀1)}
        {Ψ (long-edge 𝕀1) ≡ Ψ (long-edge 𝕀1)}
            (λ β . trans (ap-r {simplex 2} {X} long-edge-tgt Ψ) β)
            (trans (cong (ev-r {spine-2-edge-2} {X} spine-2-edge-2-end) (prod-snd fg))
              (ev-r-pre-r-path spine-2-edge-2 {simplex 2} {X} {λ b . spine→simplex 2 (spine-2-edge-2-incl b)}
                  {λ b . simplex-2-e12 (spine-2-edge-2→𝕀 b)} PB spine-2-edge-2-end Ψ)))
      (trans (sym (ap-r-trans {simplex 2} {X} long-edge-tgt (happly {spine-2-edge-2} {λ _ . simplex 2} PB spine-2-edge-2-end) Ψ))
        (ap-r-set (is-set-simplex 1) (trans long-edge-tgt
              (happly {spine-2-edge-2} {λ _ . simplex 2} PB spine-2-edge-2-end)) refl Ψ)) in
  cong {(Ψ (long-edge 𝕀0) ≡ Ψ (long-edge 𝕀0)) × (Ψ (long-edge 𝕀1) ≡ Ψ (long-edge 𝕀1))}
    {hom X (Ψ (long-edge 𝕀0)) (Ψ (long-edge 𝕀1))}
    (λ w . (pre-r {𝕀} {simplex 2} {X} Ψ long-edge , w))
    (cong2 {Ψ (long-edge 𝕀0) ≡ Ψ (long-edge 𝕀0)} {Ψ (long-edge 𝕀1) ≡ Ψ (long-edge 𝕀1)}
        {(Ψ (long-edge 𝕀0) ≡ Ψ (long-edge 𝕀0)) × (Ψ (long-edge 𝕀1) ≡ Ψ (long-edge 𝕀1))}
      pair src tgt)

-- the composite of the two first edges of a 2-simplex is its long edge
abstract comp-simplex-2 ∷ (X ∷ U) (s : is-segal-r X) (Ψ : simplex 2 →ᵣ X) →
  comp-hom-r X s {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e01 𝕀1)} {Ψ (simplex-2-e12 𝕀1)} (simplex-2-hom01 {X} Ψ)
    (simplex-2-hom12 {X} Ψ) ≡ simplex-2-hom02 {X} Ψ
comp-simplex-2 X s Ψ =
  trans (fill-hom-unique X s {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e01 𝕀1)} {Ψ (simplex-2-e12 𝕀1)}
      (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ)
           (Ψ , simplex-coc-edges {X} Ψ))
    (fill-hom-simplex-2 {X} Ψ)
