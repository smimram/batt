--
-- Functorial binary composition of 1-cells in oplax-Segal types
--
-- The 1-cells of X are the oplax maps 𝕀 →ᵣ X. A composable pair of 1-cells is an oplax map out
-- of the 2-spine Λ² = Sp₂ (two edges glued at their common vertex). When X is oplax-Segal,
-- restriction (Δ² →ᵣ X) → (Sp₂ →ᵣ X) along the spine inclusion is an equivalence; the composite
-- of a composable pair φ is obtained by extending φ to a 2-simplex (the filler) and restricting
-- it to the long edge δ of Δ²:
--
--   comp-r : (Sp₂ →ᵣ X) → (𝕀 →ᵣ X),    comp-r φ = (filler of φ) ∘ δ
--
-- Composition is thus a function on the whole type of composable pairs.
--

open import Stdlib
open import Segal
open import Hom
open import Spine-up

--
-- The two 1-cells of a composable pair
--

fst-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
fst-cell {X} φ =
  let e ∷ 𝕀 → spine 2 = spine-edge-1 in
  pre-r 𝕀 φ e

snd-cell ∷ {X ∷ U} → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
snd-cell {X} φ =
  let e ∷ 𝕀 → spine 2 = spine-edge-2 in
  pre-r 𝕀 φ e

--
-- Filler and composite
--

-- the unthickened oplax Segal condition for Λ² ↪ Δ²
abstract is-segal-r-2 ∷ (X ∷ U) → is-segal-r X → is-equiv (segal-restr-r no-grid 0 2 no-grid 0 X)
is-segal-r-2 X s = s no-grid 0 2 no-grid 0

-- the section of restriction along Λ² ↪ Δ² given by the oplax Segal condition
segal-section-r ∷ (X ∷ U) → is-segal-r X → section (segal-restr-r no-grid 0 2 no-grid 0 X)
segal-section-r X s = is-equiv-sec (segal-restr-r no-grid 0 2 no-grid 0 X) (is-segal-r-2 X s)

-- the extension of a (trivially thickened) composable pair to a (trivially thickened) 2-simplex
thick-filler-r ∷ (X ∷ U) → is-segal-r X → (thick-spine no-grid 0 2 no-grid 0 →ᵣ X) → (thick-simplex no-grid 0 2 no-grid 0 →ᵣ X)
thick-filler-r X s = map-section (segal-restr-r no-grid 0 2 no-grid 0 X) (segal-section-r X s)

-- it restricts back to the given pair
abstract thick-filler-r-restr ∷ (X ∷ U) (s : is-segal-r X) (ψ : thick-spine no-grid 0 2 no-grid 0 →ᵣ X) →
  segal-restr-r no-grid 0 2 no-grid 0 X (thick-filler-r X s ψ) ≡ ψ
thick-filler-r-restr X s ψ =
  snd {(thick-spine no-grid 0 2 no-grid 0 →ᵣ X) → (thick-simplex no-grid 0 2 no-grid 0 →ᵣ X)}
    (is-section (segal-restr-r no-grid 0 2 no-grid 0 X)) (segal-section-r X s) ψ

-- the composable pair φ, trivially thickened
thick-pair-r ∷ {X ∷ U} → (spine 2 →ᵣ X) → (thick-spine no-grid 0 2 no-grid 0 →ᵣ X)
thick-pair-r {X} φ =
  let u ∷ thick-spine no-grid 0 2 no-grid 0 → spine 2 = thicken-unit {spine 2} in
  pre-r (thick-spine no-grid 0 2 no-grid 0) φ u

-- the 2-simplex filling a composable pair: the Segal extension along Λ² ↪ Δ², transported
-- through the unit laws ⊤ ⊗ (− ⊗ ⊤) of the (trivial) thickening
comp-filler-r ∷ (X ∷ U) → is-segal-r X → (spine 2 →ᵣ X) → (simplex 2 →ᵣ X)
comp-filler-r X s φ =
  let c ∷ simplex 2 → thick-simplex no-grid 0 2 no-grid 0 = thicken-counit {simplex 2} in
  pre-r (simplex 2) (thick-filler-r X s (thick-pair-r {X} φ)) c

-- the composite of a composable pair: the long edge of its filler
comp-r ∷ (X ∷ U) → is-segal-r X → (spine 2 →ᵣ X) → (𝕀 →ᵣ X)
comp-r X s φ =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  pre-r 𝕀 (comp-filler-r X s φ) δ

--
-- Boundary of the composite: it goes from the source of the first cell to the target of the
-- second one
--

-- on the image of the spine, the filler of φ agrees with φ
abstract comp-filler-r-spine ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (v ∷ spine 2) {y ∷ simplex 2}
  (r ∷ y ≡ spine→simplex 2 v) → comp-filler-r X s φ y ≡ φ v
comp-filler-r-spine X s φ v {y} r =
  let c ∷ simplex 2 → thick-simplex no-grid 0 2 no-grid 0 = thicken-counit {simplex 2} in
  let r' ∷ c y ≡ c (spine→simplex 2 v) = cong c r in
  let w ∷ thick-spine no-grid 0 2 no-grid 0 = thicken-counit {spine 2} v in
  let Φ : thick-simplex no-grid 0 2 no-grid 0 →ᵣ X = thick-filler-r X s (thick-pair-r {X} φ) in
  trans (ap-r r' Φ) (ev-r w (thick-filler-r-restr X s (thick-pair-r {X} φ)))

abstract comp-r-src ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → comp-r X s φ 𝕀0 ≡ fst-cell {X} φ 𝕀0
comp-r-src X s φ =
  comp-filler-r-spine X s φ (spine-edge-1 𝕀0)
    (sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (spine-edge-1 𝕀0))))

abstract comp-r-tgt ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → comp-r X s φ 𝕀1 ≡ snd-cell {X} φ 𝕀1
comp-r-tgt X s φ =
  comp-filler-r-spine X s φ (spine-edge-2 𝕀1)
    (sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt)
      (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (spine-edge-2 𝕀1))))

--
-- Uniqueness of fillers: any 2-simplex restricting to φ on the spine is the filler of φ, so its
-- long edge is the composite of φ (unthickened oplax Segal condition, Segal.batt)
--

abstract comp-filler-r-restr ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) → spine-restr-r 2 X (comp-filler-r X s φ) ≡ φ
comp-filler-r-restr X s φ =
  let c ∷ spine 2 → thick-spine no-grid 0 2 no-grid 0 = thicken-counit {spine 2} in
  cong {thick-spine no-grid 0 2 no-grid 0 →ᵣ X} {spine 2 →ᵣ X} (λ ψ . pre-r (spine 2) {thick-spine no-grid 0 2 no-grid 0} {X} ψ c)
    (thick-filler-r-restr X s (thick-pair-r {X} φ))

abstract comp-filler-r-unique ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restr-r 2 X Ψ ≡ φ → comp-filler-r X s φ ≡ Ψ
comp-filler-r-unique X s φ Ψ H =
  retraction-inj (spine-restr-r 2 X) (is-equiv-ret (spine-restr-r 2 X) (is-segal-r-unthick X s 2)) {comp-filler-r X s φ} {Ψ}
    (trans (comp-filler-r-restr X s φ) (sym H))

abstract comp-r-unique ∷ (X ∷ U) (s : is-segal-r X) (φ : spine 2 →ᵣ X) (Ψ : simplex 2 →ᵣ X) →
  spine-restr-r 2 X Ψ ≡ φ → comp-r X s φ ≡ pre-r 𝕀 {simplex 2} {X} Ψ long-edge
comp-r-unique X s φ Ψ H =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  cong {simplex 2 →ᵣ X} {𝕀 →ᵣ X} (λ F . pre-r 𝕀 {simplex 2} {X} F δ) (comp-filler-r-unique X s φ Ψ H)

--
-- Composition on hom types
--
-- Two 1-cells u : hom X x y and v : hom X y z form an oplax cocone on the two edges of the
-- spine (hom-pair), hence a composable pair hom-spine : spine 2 →ᵣ X by the oplax universal
-- property of the spine (Spine-up.batt, Wedge.batt).
--
-- The composite is read off a filler: a 2-simplex Ψ together with a path P from its restriction
-- to the two edges (simplex-coc-r) to the cocone of u and v, i.e. a point of the fibre of
-- simplex-coc-r over hom-pair u v. Its cell is the long edge of Ψ; its source is
--   Ψ (δ 0) = Ψ (vertex 0 of the first edge) = (first edge of the cocone) 0 = u 0 = x,
-- using P at the vertex 0 of the first edge, and dually for the target (fill-hom). The fibre is
-- contractible (simplex-coc-r is an equivalence when X is oplax-Segal), and the composite is
-- fill-hom at the canonical filler (comp-fill). Any other filler gives the same hom, which is how
-- the unit laws are proved on hom types (Unitality.batt).
--
-- The cartesian universal property of the spine (spine-cart-up) is abstract, so that statements
-- mentioning it do not unfold its proof.
--

-- the first coordinate on the first edge, the second one on the second edge
sp-EA-coord ∷ sp-EA → 𝕀
sp-EA-coord (c , a) = cc1 c

sp-EB-coord ∷ sp-EB → 𝕀
sp-EB-coord (c , b) = cc2 c

-- the oplax cocone formed by two consecutive homs
hom-pair ∷ {X ∷ U} {x y z : X} → hom X x y → hom X y z → spine-cocone-r X
hom-pair {X} {x} {y} {z} u v =
  let ca ∷ sp-EA → 𝕀 = sp-EA-coord in
  let cb ∷ sp-EB → 𝕀 = sp-EB-coord in
  (pre-r sp-EA {𝕀} {X} (hom-cell {X} {x} {y} u) ca ,
   pre-r sp-EB {𝕀} {X} (hom-cell {X} {y} {z} v) cb ,
   trans (hom-tgt {X} {x} {y} u) (sym (hom-src {X} {y} {z} v)))

-- the composable pair they define
hom-spine ∷ (X ∷ U) {x y z : X} → hom X x y → hom X y z → (spine 2 →ᵣ X)
hom-spine X {x} {y} {z} u v = wedge-σ-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ spine-cart-up X (hom-pair {X} {x} {y} {z} u v)

-- restriction of a 2-simplex to an oplax cocone on the two edges of the spine
simplex-coc-r ∷ (X ∷ U) → (simplex 2 →ᵣ X) → spine-cocone-r X
simplex-coc-r X Ψ = wedge-restr-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ X (spine-restr-r 2 X Ψ)

abstract is-equiv-simplex-coc-r ∷ (X ∷ U) → is-segal-r X → is-equiv (simplex-coc-r X)
is-equiv-simplex-coc-r X s =
  is-equiv-circ (wedge-restr-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ X) (spine-restr-r 2 X)
    (spine-oplax-up X) (is-segal-r-unthick X s 2)

-- fillers of the pair (u , v)
hom-fill ∷ (X ∷ U) {x y z : X} → hom X x y → hom X y z → U
hom-fill X {x} {y} {z} u v = fib (simplex-coc-r X) (hom-pair {X} {x} {y} {z} u v)

abstract is-contr-hom-fill ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z) → is-contr (hom-fill X {x} {y} {z} u v)
is-contr-hom-fill X s {x} {y} {z} u v =
  is-contr-fib (simplex-coc-r X) (is-equiv-simplex-coc-r X s) (hom-pair {X} {x} {y} {z} u v)

-- the outer vertices of the spine: 0 on the first edge, 2 on the second one
sp-a0 ∷ sp-EA
sp-a0 = ((𝕀0 , 𝕀0 , tt) , refl)

sp-b1 ∷ sp-EB
sp-b1 = ((𝕀1 , 𝕀1 , tt) , (refl , spine-1-pt 𝕀1))

-- the long edge starts at the vertex 0 and ends at the vertex 2 of the spine
long-edge-src ∷ long-edge 𝕀0 ≡{simplex 2} spine→simplex 2 (sp-i sp-a0)
long-edge-src =
  sorted-path 1 (𝕀0 , 𝕀0 , tt) (refl , tt) (is-in-spine→is-sorted 1 (𝕀0 , 𝕀0 , tt) (snd (is-in-spine 2) (sp-i sp-a0)))

long-edge-tgt ∷ long-edge 𝕀1 ≡{simplex 2} spine→simplex 2 (sp-j sp-b1)
long-edge-tgt =
  sorted-path 1 (𝕀1 , 𝕀1 , tt) (refl , tt) (is-in-spine→is-sorted 1 (𝕀1 , 𝕀1 , tt) (snd (is-in-spine 2) (sp-j sp-b1)))

-- the hom given by a filler: its cell is the long edge, its boundary is read off at the outer
-- vertices of the spine
fill-hom ∷ (X ∷ U) {x y z : X} (u : hom X x y) (v : hom X y z) → hom-fill X {x} {y} {z} u v → hom X x z
fill-hom X {x} {y} {z} u v (Ψ , P) =
  let δ ∷ 𝕀 → simplex 2 = long-edge in
  (pre-r 𝕀 {simplex 2} {X} Ψ δ ,
   trans (ap-r {simplex 2} {X} long-edge-src Ψ)
     (trans (ev-r {sp-EA} {X} sp-a0 (cong (wr-f {sp-EA} {sp-EB} {sp-a1} {sp-b0} {X}) P)) (hom-src {X} {x} {y} u)) ,
   trans (ap-r {simplex 2} {X} long-edge-tgt Ψ)
     (trans (ev-r {sp-EB} {X} sp-b1 (cong (wr-g {sp-EA} {sp-EB} {sp-a1} {sp-b0} {X}) P)) (hom-tgt {X} {y} {z} v)))

-- the canonical filler: the Segal filler of the composable pair hom-spine
comp-fill ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z) → hom-fill X {x} {y} {z} u v
comp-fill X s {x} {y} {z} u v =
  (comp-filler-r X s (hom-spine X {x} {y} {z} u v) ,
   trans (cong {spine 2 →ᵣ X} {spine-cocone-r X} (wedge-restr-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ X)
            (comp-filler-r-restr X s (hom-spine X {x} {y} {z} u v)))
     (wedge-σ-sec-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ spine-cart-up X (hom-pair {X} {x} {y} {z} u v)))

-- composition of 1-cells of an oplax-Segal type; its cell is comp-r X s (hom-spine X u v)
comp-hom-r ∷ (X ∷ U) → is-segal-r X → {x y z : X} → hom X x y → hom X y z → hom X x z
comp-hom-r X s {x} {y} {z} u v = fill-hom X {x} {y} {z} u v (comp-fill X s {x} {y} {z} u v)

-- any two fillers give the same hom
abstract fill-hom-unique ∷ (X ∷ U) (s : is-segal-r X) {x y z : X} (u : hom X x y) (v : hom X y z) (F : hom-fill X {x} {y} {z} u v) →
  comp-hom-r X s {x} {y} {z} u v ≡ fill-hom X {x} {y} {z} u v F
fill-hom-unique X s {x} {y} {z} u v F =
  cong {hom-fill X {x} {y} {z} u v} {hom X x z} (fill-hom X {x} {y} {z} u v)
    (is-contr-eq (is-contr-hom-fill X s {x} {y} {z} u v) (comp-fill X s {x} {y} {z} u v) F)
