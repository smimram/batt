--
-- The Yoneda lemma
--
-- For a Segal type A, a : A and a covariant family F over A (i.e. fst : Σ A F → A is a
-- cocartesian fibration), we have maps
--
--   evid φ := φ a id                    : ((x : A) → hom A a x → F x) → F a
--   yon u  := λ x f . f_* u             : F a → ((x : A) → hom A a x → F x)
--
-- where f_* u is the pushforward of u along f, i.e. the target of the cocartesian lift of f at u.
--
--   evid-yon : evid (yon u) ≡ u
--   yon-evid : yon (evid φ) x f ≡ φ x f, for a crisp a and a crisp cocartesian φ
--
-- (cocartesian maps are only defined for crisp maps, so the second one is stated pointwise
-- rather than as an equivalence of types).
--
--   yon-cocart : yon u is a cocartesian map, for a crisp u (prop:yon_cocart in BATT.tex)
--
-- Postulates relied on: hom-fam-conn-cocart (Hom-family.batt), for both; conn-cocart
-- (Fold.batt), for yon-cocart.
--

open import Stdlib
open import Hom
open import Segal
open import Functoriality
open import Iso
open import Fibration
open import Connection
open import Fold
open import Covariant
open import Hom-family

--
-- The Yoneda maps
--

evid ∷ {A ∷ U} (F ∷ A → U) {a : A} → ((x : A) → hom a x → F x) → F a
evid {A} F {a} φ = φ a (Hom.id {A} a)

yon ∷ {A ∷ U} (F ∷ A → U) (sA : is-segalᵣ A) (sF : is-segalᵣ (Σ (x : A) . F x)) (c : is-covariant {A} F sA sF)
  {a : A} → F a → (x : A) → hom a x → F x
yon {A} F sA sF c {a} u x f = push {A} F sA sF c {a} {x} f u

--
-- evid is a retraction of yon
--

evid-yon ∷ {A ∷ U} (F ∷ A → U) (sA : is-segalᵣ A) (sF : is-segalᵣ (Σ (x : A) . F x)) (c : is-covariant {A} F sA sF)
  {a : A} (u : F a) → evid {A} F {a} (yon {A} F sA sF c {a} u) ≡ u
evid-yon {A} F sA sF c {a} u = push-id {A} F sA sF c {a} u

--
-- yon is a retraction of evid, on cocartesian maps
--
-- For a crisp cocartesian φ : (x : A) → hom a x → F x and f : hom a x, the connection Γ̄_f is a
-- cocartesian arrow (a , id) → (x , f) of the hom family (hom-fam-conn-cocart), so its image by φ
-- is a cocartesian arrow (a , φ a id) → (x , φ x f) over f. By uniqueness of cocartesian lifts
-- (push-cocart), pushing φ a id forward along f gives φ x f.
--

-- the lift data of the image of the connection, by induction on the source path
yon-evid-data ∷ {A ∷ U} (F ∷ A → U) {a ∷ A} (φ ∷ (x : A) → hom a x → F x) (g : arrᵣ A)
  {b : A} (e : a ≡ b) {e' : b ≡ a} (k : sym e ≡ e') (d : b ≡ srcᵣ g) →
  Σ (E : ((b , φ b ((λ j . b) , e' , refl)) , g , d)
           ≡{pullback {Σ (x : A) . F x} {arrᵣ A} {A} (fst F) (λ g . srcᵣ g)} ((a , φ a (Hom.id {A} a)) , g , trans e d)) .
    cong {pullback {Σ (x : A) . F x} {arrᵣ A} {A} (fst F) (λ g . srcᵣ g)} {A} (λ w . tgtᵣ (fst _ (snd _ w))) E ≡ refl
yon-evid-data {A} F {a} φ g refl refl d =
  let P : U = pullback {Σ (x : A) . F x} {arrᵣ A} {A} (fst F) (λ g . srcᵣ g) in
  let T : P → A = λ w . tgtᵣ (fst _ (snd _ w)) in
  let h : (a ≡ srcᵣ g) → P = λ d' . ((a , φ a (Hom.id {A} a)) , g , d') in
  (cong h (sym (trans-refl-l d)) ,
   trans (sym (cong-comp T h (sym (trans-refl-l d)))) (cong-cst (tgtᵣ g) (sym (trans-refl-l d))))

-- the target, by induction on the target path
yon-evid-tgt ∷ {A ∷ U} (F ∷ A → U) {a ∷ A} (φ ∷ (x : A) → hom a x → F x) (g : arrᵣ A) (e0 : srcᵣ g ≡ a)
  {x : A} (e1 : tgtᵣ g ≡ x) → subst F e1 (φ (tgtᵣ g) (g , e0 , refl)) ≡ φ x (g , e0 , e1)
yon-evid-tgt {A} F {a} φ g e0 refl = refl

yon-evid ∷ {A ∷ U} (F ∷ A → U) (sA : is-segalᵣ A) (sF : is-segalᵣ (Σ (x : A) . F x)) (c : is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x))
  (φ ∷ (x : A) → hom a x → F x) (nφ : is-cocartesian-map {A} (λ x . hom {A} a x) F sA sH sF φ)
  (x : A) (f : hom a x) → yon {A} F sA sF c {a} (evid {A} F {a} φ) x f ≡ φ x f
yon-evid {A} F sA sF c {a} sH φ nφ x f =
  let H ∷ A → U = λ y . hom {A} a y in
  let P : U = pullback {Σ (y : A) . F y} {arrᵣ A} {A} (fst F) (λ g . srcᵣ g) in
  let T : P → A = λ w . tgtᵣ (fst _ (snd _ w)) in
  let t : arrᵣ A = hom-cell {A} {a} {x} f in
  let e0 : srcᵣ t ≡ a = hom-src {A} {a} {x} f in
  let e1 : tgtᵣ t ≡ x = hom-tgt {A} {a} {x} f in
  let w : arrᵣ (Σ (y : A) . H y) = hom-fam-conn {A} {a} {x} f in
  let w' : arrᵣ (Σ (y : A) . F y) = postᵣ {𝕀} {Σ (y : A) . H y} {Σ (y : A) . F y} (tot {A} {H} {F} φ) w in
  let cw' : is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F) {srcᵣ w'} {tgtᵣ w'} (cell-hom {Σ (y : A) . F y} w') =
    nφ {srcᵣ w} {tgtᵣ w} (cell-hom {Σ (y : A) . H y} w) (hom-fam-conn-cocart {A} sA {a} sH {x} f) in
  let D : Σ (E : ((srcᵣ t , φ (srcᵣ t) ((λ j . srcᵣ t) , e0 , refl)) , t , refl) ≡{P} ((a , φ a (Hom.id {A} a)) , t , trans (sym e0) refl)) .
            cong {P} {A} T E ≡ refl =
    yon-evid-data {A} F {a} φ t {srcᵣ t} (sym e0) {e0} (sym-sym e0) refl in
  let E : ((srcᵣ t , φ (srcᵣ t) ((λ j . srcᵣ t) , e0 , refl)) , t , refl) ≡{P} ((a , φ a (Hom.id {A} a)) , t , trans (sym e0) refl) =
    fst _ D in
  let Q : trans refl (trans (cong {P} {A} T E) e1) ≡ e1 =
    trans (trans-refl-l (trans (cong {P} {A} T E) e1))
      (trans (cong {tgtᵣ t ≡ tgtᵣ t} {tgtᵣ t ≡ x} (λ q . trans q e1) (snd _ D)) (trans-refl-l e1)) in
  trans (push-cocart {A} F sA sF c {a} {x} f (φ a (Hom.id {A} a)) (w' , cw') E)
    (trans (cong {tgtᵣ t ≡ x} {F x} (λ q . subst F q (φ (tgtᵣ t) (t , e0 , refl))) Q)
      (trans (yon-evid-tgt {A} F {a} φ t e0 e1) (cong {hom a x} {F x} (φ x) (hom-eta {A} {a} {x} f))))

--
-- yon u is a cocartesian map
--
-- Write Y for the total map of yon u, (x , f) ↦ (x , f_* u).
--
-- On connections (yon-conn-cocart): the image of the connection Γ̄_f is the 1-cell
-- i ↦ (f_{≤ i})_* u, the targets of the cocartesian lifts Θ i of the restrictions f_{≤ i} of f.
-- The connection of the cocartesian lift f̂ of f is also a 1-cell of cocartesian arrows R
-- (conn-cocart, Fold.batt). Θ and R have the same image in 𝕀 →ᵣ (Σ F ×_A (𝕀 →ᵣ A)) (the
-- restrictions of f at u), and postcomposition with the equivalence cocart-cell-lift is an
-- equivalence (postᵣ-equiv), so Θ ≡ R: taking targets, the image of Γ̄_f is f̂, which is cocartesian.
--
-- In general (yon-cocart-from-id): a cocartesian arrow h out of (a , id) factors as the connection
-- of its image followed by a cocartesian arrow m over an identity, which is an isomorphism
-- (is-iso-cocartesian), so that Y h is cocartesian. A cocartesian arrow g out of (x , f) is reduced
-- to this case by precomposing with the connection of f (yon-cocart-at), by cancellation.
--

funextᵣ-eq ∷ (A B ∷ U) (H : A →ᵣ path B) → postᵣ {A} (path-src {B}) H ≡ postᵣ {A} (path-tgt {B}) H
funextᵣ-eq A B H = snd _ (snd _ (funextᵣ A B H))

-- a point of a total space is its first component paired with its second
Σ-subst ∷ {A : U} (F : A → U) (z : Σ (x : A) . F x) {y : A} (P : fst F z ≡ y) → (y , subst F P (snd F z)) ≡{Σ (x : A) . F x} z
Σ-subst {A} F (x , v) refl = refl

-- the total map of yon u
yon-tot ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (u ∷ F a) → (Σ (x : A) . hom {A} a x) → Σ (x : A) . F x
yon-tot {A} F sA sF c {a} u = tot {A} {λ x . hom {A} a x} {F} (λ x f . yon {A} F sA sF c {a} u x f)

yon-conn-cocart ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (u ∷ F a) {x : A} (f : hom a x) →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {srcᵣ (postᵣ {𝕀} {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) (hom-fam-conn {A} {a} {x} f))}
    {tgtᵣ (postᵣ {𝕀} {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) (hom-fam-conn {A} {a} {x} f))}
    (cell-hom {Σ (y : A) . F y} (postᵣ {𝕀} {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) (hom-fam-conn {A} {a} {x} f)))
yon-conn-cocart {A} F sA sF c {a} u {x} f =
  let E ∷ U = Σ (y : A) . F y in
  let CCf ∷ arrᵣ E → U = λ w . is-cocartesian {E} {A} sF sA (fst F) {srcᵣ w} {tgtᵣ w} (cell-hom {E} w) in
  let CC ∷ U = cocart-cell {E} {A} sF sA (fst F) in
  let PB ∷ U = pullback {E} {arrᵣ A} {A} (fst F) (λ g . srcᵣ g) in
  let Λ ∷ CC → PB = cocart-cell-lift {E} {A} sF sA (fst F) in
  let σ ∷ section Λ = is-equiv-sec Λ c in
  let arr ∷ CC → arrᵣ E = cocart-cell-arr {E} {A} sF sA (fst F) in
  let Λ' ∷ arrᵣ E → PB = λ w . (w 𝕀0 , postᵣ {𝕀} {E} {A} (fst F) w , refl) in
  let Lpt : (z : CC) → Λ z ≡ Λ' (arr z) = fun (w , cw) → refl in
  let Φ : PB → (𝕀 →ᵣ PB) = λ z . λ i . (fst _ z , (λ j . fst _ (snd _ z) (i 𝕀∧ j)) , snd _ (snd _ z)) in
  let β : (𝕀 →ᵣ arrᵣ E) → arrᵣ E = λ W . λ i . W i 𝕀1 in
  let t : arrᵣ A = hom-cell {A} {a} {x} f in
  let e0 : srcᵣ t ≡ a = hom-src {A} {a} {x} f in
  -- the lift data of the restrictions of f, and their cocartesian lifts
  let D : 𝕀 →ᵣ PB = λ i . ((a , u) , (λ j . t (i 𝕀∧ j)) , sym e0) in
  let Θ : 𝕀 →ᵣ CC = λ i . section-map Λ σ (D i) in
  -- the cocartesian lift of f, and its restrictions
  let fh : CC = section-map Λ σ ((a , u) , t , sym e0) in
  let RR : Σ (R : 𝕀 →ᵣ CC) . postᵣ {𝕀} {CC} {arrᵣ E} arr R ≡ conn {E} (arr fh) = conn-cocart {E} {A} sF sA (fst F) fh in
  let R : 𝕀 →ᵣ CC = fst _ RR in
  let Req : postᵣ {𝕀} {CC} {arrᵣ E} arr R ≡ conn {E} (arr fh) = snd _ RR in
  -- both lie over D
  let P1 : postᵣ {𝕀} {CC} {PB} Λ Θ ≡ D = funextᵣ-eq 𝕀 PB (λ i . (Λ (Θ i) , D i , snd _ σ (D i))) in
  let P2 : postᵣ {𝕀} {CC} {PB} Λ R ≡ postᵣ {𝕀} {arrᵣ E} {PB} Λ' (postᵣ {𝕀} {CC} {arrᵣ E} arr R) =
    funextᵣ-eq 𝕀 PB (λ i . (Λ (R i) , Λ' (arr (R i)) , Lpt (R i))) in
  let P3 : postᵣ {𝕀} {arrᵣ E} {PB} Λ' (postᵣ {𝕀} {CC} {arrᵣ E} arr R) ≡ Φ (Λ' (arr fh)) =
    cong {𝕀 →ᵣ arrᵣ E} {𝕀 →ᵣ PB} (λ W . postᵣ {𝕀} {arrᵣ E} {PB} Λ' W) Req in
  let P4 : Φ (Λ' (arr fh)) ≡ D = cong {PB} {𝕀 →ᵣ PB} Φ (trans (sym (Lpt fh)) (snd _ σ ((a , u) , t , sym e0))) in
  let ΘR : Θ ≡ R =
    retraction-inj (postᵣ {𝕀} {CC} {PB} Λ) (is-equiv-ret (postᵣ {𝕀} {CC} {PB} Λ) (postᵣ-equiv 𝕀 Λ c))
      (trans P1 (sym (trans P2 (trans P3 P4)))) in
  -- the image of the connection is the target of the lifts of the restrictions
  let W : arrᵣ E = postᵣ {𝕀} {Σ (y : A) . hom {A} a y} {E} (yon-tot {A} F sA sF c {a} u) (hom-fam-conn {A} {a} {x} f) in
  let P6 : W ≡ β (postᵣ {𝕀} {CC} {arrᵣ E} arr Θ) =
    funextᵣ-eq 𝕀 E (λ i . (W i , arr (Θ i) 𝕀1 ,
      Σ-subst F (arr (Θ i) 𝕀1)
        (lift-tgt {A} F sA sF {a} {t i} ((λ j . t (i 𝕀∧ j)) , e0 , refl) u (Θ i) (snd _ σ (D i))))) in
  let P7 : β (postᵣ {𝕀} {CC} {arrᵣ E} arr Θ) ≡ arr fh =
    trans (cong {𝕀 →ᵣ CC} {arrᵣ E} (λ V . β (postᵣ {𝕀} {CC} {arrᵣ E} arr V)) ΘR)
      (cong {𝕀 →ᵣ arrᵣ E} {arrᵣ E} β Req) in
  subst CCf (sym (trans P6 P7)) (snd _ fh)

yon-conn-hom-cocart ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (u ∷ F a) (g : arrᵣ A) (e0 : srcᵣ g ≡ a) {y : A} (e1 : tgtᵣ g ≡ y) →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u (a , Hom.id {A} a)} {yon-tot {A} F sA sF c {a} u (y , (g , e0 , e1))}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u)
      {a , Hom.id {A} a} {y , (g , e0 , e1)} (conn-hom-fam {A} {a} g e0 {y} e1))
yon-conn-hom-cocart {A} F sA sF c {a} u g e0 {y} e1 =
  let Y ∷ (Σ (y : A) . hom {A} a y) → Σ (y : A) . F y = yon-tot {A} F sA sF c {a} u in
  is-cocartesian-endpoints {Σ (y : A) . F y} {A} sF sA (fst F)
    (postᵣ {𝕀} {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} Y (hom-fam-conn {A} {a} {y} (g , e0 , e1)))
    (cong Y (fst _ (conn-hom-src {A} {a} {srcᵣ g} (sym e0) {e0} (sym-sym e0))))
    (cong Y (fst _ (conn-hom-tgt {A} {a} g e0 {y} e1)))
    (yon-conn-cocart {A} F sA sF c {a} u {y} (g , e0 , e1))

-- the image of a cocartesian arrow out of (a , id a) is cocartesian: it is a connection followed
-- by a cocartesian arrow over an identity, i.e. an isomorphism
yon-cocart-from-id ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a)
  {s : Σ (x : A) . hom {A} a x} (h : hom {Σ (x : A) . hom {A} a x} (a , Hom.id {A} a) s) →
  is-cocartesian {Σ (x : A) . hom {A} a x} {A} sH sA (fst (λ y . hom {A} a y)) {a , Hom.id {A} a} {s} h →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u (a , Hom.id {A} a)} {yon-tot {A} F sA sF c {a} u s}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) {a , Hom.id {A} a} {s} h)
yon-cocart-from-id {A} F sA sF c {a} sH u {s} h ch =
  let X ∷ U = Σ (y : A) . hom {A} a y in
  let E ∷ U = Σ (y : A) . F y in
  let p ∷ X → A = fst (λ y . hom {A} a y) in
  let Y ∷ X → E = yon-tot {A} F sA sF c {a} u in
  let o : X = (a , Hom.id {A} a) in
  let y : A = p s in
  let g : arrᵣ A = postᵣ {𝕀} {X} {A} p (hom-cell {X} {o} {s} h) in
  let e0 : srcᵣ g ≡ a = cong p (hom-src {X} {o} {s} h) in
  let e1 : tgtᵣ g ≡ y = cong p (hom-tgt {X} {o} {s} h) in
  let s' : X = (y , (g , e0 , e1)) in
  let Γ : hom o s' = conn-hom-fam {A} {a} g e0 {y} e1 in
  let cΓ : is-cocartesian {X} {A} sH sA p {o} {s'} Γ = conn-hom-fam-cocart {A} sA {a} sH g e0 {y} e1 in
  -- factor h through Γ, over the identity
  let G : hom s' s → cocart-pb {X} {A} sA p {o} {s'} Γ s = cocart-gap {X} {A} sH sA p {o} {s'} Γ s in
  let π : cocart-pb {X} {A} sA p {o} {s'} Γ s =
    (h , Hom.id {A} y ,
     sym (trans (comp-homᵣ-runit A sA {a} {y} (hom-map {X} {A} p {o} {s'} Γ)) (conn-hom-fam-over {A} {a} g e0 {y} e1))) in
  let σ : section G = is-equiv-sec G (cΓ s) in
  let m : hom s' s = section-map G σ π in
  let Pm : G m ≡ π = snd _ σ π in
  let mh : comp-homᵣ X sH {o} {s'} {s} Γ m ≡ h = cong {cocart-pb {X} {A} sA p {o} {s'} Γ s} {hom o s} (λ z . fst _ z) Pm in
  let pm : hom-map {X} {A} p {s'} {s} m ≡ Hom.id {A} y =
    cong {cocart-pb {X} {A} sA p {o} {s'} Γ s} {hom y y} (λ z . fst _ (snd _ z)) Pm in
  let cm : is-cocartesian {X} {A} sH sA p {s'} {s} m =
    Product.snd (is-cocartesian-cancel {X} {A} sH sA p {o} {s'} {s} Γ m cΓ)
      (subst (λ k . is-cocartesian {X} {A} sH sA p {o} {s} k) (sym mh) ch) in
  let im : is-iso-hom {X} sH {s'} {s} m =
    is-iso-cocartesian {X} {A} sH sA p {s'} {s} m cm
      (subst (λ k . is-iso-hom {A} sA {y} {y} k) (sym pm) (is-iso-id {A} sA y)) in
  -- the image of h is the image of Γ followed by the image of an isomorphism
  let cYΓ : is-cocartesian {E} {A} sF sA (fst F) {Y o} {Y s'} (hom-map {X} {E} Y {o} {s'} Γ) =
    yon-conn-hom-cocart {A} F sA sF c {a} u g e0 {y} e1 in
  let cYm : is-cocartesian {E} {A} sF sA (fst F) {Y s'} {Y s} (hom-map {X} {E} Y {s'} {s} m) =
    is-cocartesian-iso {E} {A} sF sA (fst F) {Y s'} {Y s} (hom-map {X} {E} Y {s'} {s} m)
      (is-iso-hom-map {X} {E} sH sF Y {s'} {s} m im) in
  let cYΓm : is-cocartesian {E} {A} sF sA (fst F) {Y o} {Y s}
               (comp-homᵣ E sF {Y o} {Y s'} {Y s} (hom-map {X} {E} Y {o} {s'} Γ) (hom-map {X} {E} Y {s'} {s} m)) =
    Product.fst (is-cocartesian-cancel {E} {A} sF sA (fst F) {Y o} {Y s'} {Y s}
      (hom-map {X} {E} Y {o} {s'} Γ) (hom-map {X} {E} Y {s'} {s} m) cYΓ) cYm in
  subst (λ k . is-cocartesian {E} {A} sF sA (fst F) {Y o} {Y s} k)
    (trans (sym (hom-map-comp X E Y sH sF {o} {s'} {s} Γ m)) (cong (hom-map {X} {E} Y {o} {s}) mh))
    cYΓm

-- the image of a cocartesian arrow g out of (x , f): precompose with the connection of f
yon-cocart-at ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a)
  (x : A) (t : arrᵣ A) (e0 : srcᵣ t ≡ a) (e1 : tgtᵣ t ≡ x)
  {s : Σ (x : A) . hom {A} a x} (g : hom {Σ (x : A) . hom {A} a x} (x , (t , e0 , e1)) s) →
  is-cocartesian {Σ (x : A) . hom {A} a x} {A} sH sA (fst (λ y . hom {A} a y)) {x , (t , e0 , e1)} {s} g →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u (x , (t , e0 , e1))} {yon-tot {A} F sA sF c {a} u s}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) {x , (t , e0 , e1)} {s} g)
yon-cocart-at {A} F sA sF c {a} sH u x t e0 e1 {s} g cg =
  let X ∷ U = Σ (y : A) . hom {A} a y in
  let E ∷ U = Σ (y : A) . F y in
  let p ∷ X → A = fst (λ y . hom {A} a y) in
  let Y ∷ X → E = yon-tot {A} F sA sF c {a} u in
  let o : X = (a , Hom.id {A} a) in
  let s0 : X = (x , (t , e0 , e1)) in
  let Γ : hom o s0 = conn-hom-fam {A} {a} t e0 {x} e1 in
  let cΓ : is-cocartesian {X} {A} sH sA p {o} {s0} Γ = conn-hom-fam-cocart {A} sA {a} sH t e0 {x} e1 in
  let cΓg : is-cocartesian {X} {A} sH sA p {o} {s} (comp-homᵣ X sH {o} {s0} {s} Γ g) =
    Product.fst (is-cocartesian-cancel {X} {A} sH sA p {o} {s0} {s} Γ g cΓ) cg in
  let cYΓg : is-cocartesian {E} {A} sF sA (fst F) {Y o} {Y s}
               (comp-homᵣ E sF {Y o} {Y s0} {Y s} (hom-map {X} {E} Y {o} {s0} Γ) (hom-map {X} {E} Y {s0} {s} g)) =
    subst (λ k . is-cocartesian {E} {A} sF sA (fst F) {Y o} {Y s} k) (hom-map-comp X E Y sH sF {o} {s0} {s} Γ g)
      (yon-cocart-from-id {A} F sA sF c {a} sH u {s} (comp-homᵣ X sH {o} {s0} {s} Γ g) cΓg) in
  Product.snd (is-cocartesian-cancel {E} {A} sF sA (fst F) {Y o} {Y s0} {Y s}
    (hom-map {X} {E} Y {o} {s0} Γ) (hom-map {X} {E} Y {s0} {s} g) (yon-conn-hom-cocart {A} F sA sF c {a} u t e0 {x} e1))
    cYΓg

yon-cocart-pr ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a)
  (x : A) (t : arrᵣ A) (e : (srcᵣ t ≡ a) × (tgtᵣ t ≡ x))
  {s : Σ (x : A) . hom {A} a x} (g : hom {Σ (x : A) . hom {A} a x} (x , (t , e)) s) →
  is-cocartesian {Σ (x : A) . hom {A} a x} {A} sH sA (fst (λ y . hom {A} a y)) {x , (t , e)} {s} g →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u (x , (t , e))} {yon-tot {A} F sA sF c {a} u s}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) {x , (t , e)} {s} g)
yon-cocart-pr {A} F sA sF c {a} sH u x t (e0 , e1) = yon-cocart-at {A} F sA sF c {a} sH u x t e0 e1

yon-cocart-hom ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a)
  (x : A) (f : hom a x)
  {s : Σ (x : A) . hom {A} a x} (g : hom {Σ (x : A) . hom {A} a x} (x , f) s) →
  is-cocartesian {Σ (x : A) . hom {A} a x} {A} sH sA (fst (λ y . hom {A} a y)) {x , f} {s} g →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u (x , f)} {yon-tot {A} F sA sF c {a} u s}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) {x , f} {s} g)
yon-cocart-hom {A} F sA sF c {a} sH u x (t , e) = yon-cocart-pr {A} F sA sF c {a} sH u x t e

yon-cocart-obj ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a)
  (r : Σ (x : A) . hom {A} a x)
  {s : Σ (x : A) . hom {A} a x} (g : hom {Σ (x : A) . hom {A} a x} r s) →
  is-cocartesian {Σ (x : A) . hom {A} a x} {A} sH sA (fst (λ y . hom {A} a y)) {r} {s} g →
  is-cocartesian {Σ (y : A) . F y} {A} sF sA (fst F)
    {yon-tot {A} F sA sF c {a} u r} {yon-tot {A} F sA sF c {a} u s}
    (hom-map {Σ (y : A) . hom {A} a y} {Σ (y : A) . F y} (yon-tot {A} F sA sF c {a} u) {r} {s} g)
yon-cocart-obj {A} F sA sF c {a} sH u (x , f) = yon-cocart-hom {A} F sA sF c {a} sH u x f

-- yon u is a cocartesian map
yon-cocart ∷ {A ∷ U} (F ∷ A → U) (sA ∷ is-segalᵣ A) (sF ∷ is-segalᵣ (Σ (x : A) . F x)) (c ∷ is-covariant {A} F sA sF)
  {a ∷ A} (sH : is-segalᵣ (Σ (x : A) . hom {A} a x)) (u ∷ F a) →
  is-cocartesian-map {A} (λ x . hom {A} a x) F sA sH sF (λ x f . yon {A} F sA sF c {a} u x f)
yon-cocart {A} F sA sF c {a} sH u {r} {s} g cg = yon-cocart-obj {A} F sA sF c {a} sH u r {s} g cg
