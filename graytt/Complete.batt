--
-- The four notions of completeness
--
-- A type X is complete when it is local with respect to every thickened collapse of the
-- free-standing equivalence
--   τ : E_{𝐚,𝐛} → □[𝐚] ⊗ □[𝐛]      (E_{𝐚,𝐛} = □[𝐚] ⊗ E ⊗ □[𝐛], see FreeEquiv.batt)
-- i.e. when restriction along τ is an equivalence: every equivalence in X, thickened by grids,
-- is uniquely an identity. There is one notion per way of mapping out of the shapes:
--
--   internal : (□[𝐚] ⊗ □[𝐛] → X)  → (E_{𝐚,𝐛} → X)       any X
--   flat     : ♭(□[𝐚] ⊗ □[𝐛] → X) → ♭(E_{𝐚,𝐛} → X)     crisp X (global locality)
--   oplax    : (□[𝐚] ⊗ □[𝐛] →ᵣ X) → (E_{𝐚,𝐛} →ᵣ X)     crisp X
--   lax      : (□[𝐚] ⊗ □[𝐛] →ₗ X) → (E_{𝐚,𝐛} →ₗ X)     crisp X
--
-- Expected relations, as for Segalness: internal ⇒ flat, flat ⇔
-- lax and oplax; flat ⇒ internal should follow from an axiom characterizing → maps as a subtype of →ᵣ/→ₗ maps.
--

open import Stdlib
open import FreeEquiv
open import Segal

--
-- Restriction along τ, for each kind of arrow
--

complete-restr ∷ (a ∷ list ℕ) (b ∷ list ℕ) (X : U) → (grid a ⨂ grid b → X) → (thick-free-equiv a b → X)
complete-restr a b X g = pre (thick-free-equiv a b) g (thick-τ a b)

complete-restr♭ ∷ (a ∷ list ℕ) (b ∷ list ℕ) (X ∷ U) → ♭(grid a ⨂ grid b → X) → ♭(thick-free-equiv a b → X)
complete-restr♭ a b X = flat-map (complete-restr a b X)

complete-restrᵣ ∷ (a ∷ list ℕ) (b ∷ list ℕ) (X ∷ U) → (grid a ⨂ grid b →ᵣ X) → (thick-free-equiv a b →ᵣ X)
complete-restrᵣ a b X g =
  -- a crisp name for τ, so that the oplax application shares no free variable with its function
  let t ∷ thick-free-equiv a b → grid a ⨂ grid b = thick-τ a b in
  preᵣ {thick-free-equiv a b} g t

complete-restrₗ ∷ (a ∷ list ℕ) (b ∷ list ℕ) (X ∷ U) → (grid a ⨂ grid b →ₗ X) → (thick-free-equiv a b →ₗ X)
complete-restrₗ a b X g =
  -- a crisp name for τ, so that the lax application shares no free variable with its function
  let t ∷ thick-free-equiv a b → grid a ⨂ grid b = thick-τ a b in
  preₗ {thick-free-equiv a b} g t

--
-- The four completeness conditions
--

-- internal completeness: X is local, as a type, against every thickened τ
is-complete ∷ (X : U) → U
is-complete X = (a ∷ list ℕ) (b ∷ list ℕ) →
  is-equiv {grid a ⨂ grid b → X} {thick-free-equiv a b → X} (complete-restr a b X)

-- ♭-completeness (global locality): only the global maps out of the shapes are tested
is-complete♭ ∷ (X ∷ U) → U
is-complete♭ X = (a ∷ list ℕ) (b ∷ list ℕ) →
  is-equiv {♭(grid a ⨂ grid b → X)} {♭(thick-free-equiv a b → X)} (complete-restr♭ a b X)

-- oplax completeness: restriction of oplax maps out of the shapes is an equivalence
is-completeᵣ ∷ (X ∷ U) → U
is-completeᵣ X = (a ∷ list ℕ) (b ∷ list ℕ) →
  is-equiv {grid a ⨂ grid b →ᵣ X} {thick-free-equiv a b →ᵣ X} (complete-restrᵣ a b X)

-- lax completeness: restriction of lax maps out of the shapes is an equivalence
is-completeₗ ∷ (X ∷ U) → U
is-completeₗ X = (a ∷ list ℕ) (b ∷ list ℕ) →
  is-equiv {grid a ⨂ grid b →ₗ X} {thick-free-equiv a b →ₗ X} (complete-restrₗ a b X)

--
-- Arrow types of oplax-complete types are oplax-complete
--
-- As for Segalness (is-segal-arrᵣ, Segal.batt): curried, restriction along τ is the weakening
-- k ↦ λ q e . k q (cur-const), and for the arrow type it is conjugate, by crisp equivalences, to the
-- same weakening for A thickened by one more interval on the right: □[𝐛] →ᵣ 𝕀 →ᵣ A ≃ □[𝐛 , 1] →ᵣ A.
--

-- weakening by an unused middle argument
private
cur-const ∷ {Q S T ∷ U} → (Q →ᵣ T) → (Q →ᵣ S →ᵣ T)
cur-const {Q} {S} {T} k q s = k q

-- restriction along τ, curried, is the weakening by E
private
cur-complete-restr ∷ (a ∷ list ℕ) (b ∷ list ℕ) (X ∷ U) (g : grid a ⨂ grid b →ᵣ X) →
  cur-const {grid a} {free-equiv} {grid b →ᵣ X} (Tensor.curry-right {grid a} {grid b} {X} g)
    ≡ cur2 {grid a} {free-equiv} {grid b} {X} (complete-restrᵣ a b X g)
cur-complete-restr a b X g = refl

-- postcomposition with a crisp equivalence of the target
private
cur-const-equiv ∷ {Q S ∷ U} {T T' ∷ U} (h ∷ T → T') (eh ∷ is-equiv h) →
  is-equiv (cur-const {Q} {S} {T}) → is-equiv (cur-const {Q} {S} {T'})
cur-const-equiv {Q} {S} {T} {T'} h eh e =
  is-equiv-conj (cur-const {Q} {S} {T}) (cur-const {Q} {S} {T'})
    (postᵣ {Q} {T} {T'} h) (postᵣ {Q} {S →ᵣ T} {S →ᵣ T'} (postᵣ {S} {T} {T'} h))
    (λ k . refl)
    (postᵣ-equiv Q {T} {T'} h eh)
    (postᵣ-equiv Q {S →ᵣ T} {S →ᵣ T'} (postᵣ {S} {T} {T'} h) (postᵣ-equiv S {T} {T'} h eh))
    e

is-complete-arrᵣ ∷ {A ∷ U} → is-completeᵣ A → is-completeᵣ (arrᵣ A)
is-complete-arrᵣ {A} cA a b =
  let c ∷ list ℕ = cons 1 b in
  -- grid c is grid b ⨂ simplex 1, judgmentally
  let e2 : is-equiv (cur-const {grid a} {free-equiv} {grid b ⨂ simplex 1 →ᵣ A}) =
    is-equiv-conj (complete-restrᵣ a c A) (cur-const {grid a} {free-equiv} {grid c →ᵣ A})
      (Tensor.curry-right {grid a} {grid c} {A}) (cur2 {grid a} {free-equiv} {grid c} {A})
      (cur-complete-restr a c A) (snd _ (Tensor.curry-equiv-right {grid a} {grid c} {A})) (is-equiv-cur2 {grid a} {free-equiv} {grid c} {A})
      (cA a c) in
  let e3 : is-equiv (cur-const {grid a} {free-equiv} {grid b →ᵣ simplex 1 →ᵣ A}) =
    cur-const-equiv {grid a} {free-equiv} {grid b ⨂ simplex 1 →ᵣ A} {grid b →ᵣ simplex 1 →ᵣ A}
      (Tensor.curry-right {grid b} {simplex 1} {A}) (snd _ (Tensor.curry-equiv-right {grid b} {simplex 1} {A})) e2 in
  let e4 : is-equiv (cur-const {grid a} {free-equiv} {grid b →ᵣ arrᵣ A}) =
    cur-const-equiv {grid a} {free-equiv} {grid b →ᵣ simplex 1 →ᵣ A} {grid b →ᵣ arrᵣ A}
      (postᵣ {grid b} {simplex 1 →ᵣ A} {𝕀 →ᵣ A} (λ φ . preᵣ {𝕀} {simplex 1} {A} φ Simplex1.of𝕀))
      (postᵣ-equiv (grid b) {simplex 1 →ᵣ A} {𝕀 →ᵣ A} (λ φ . preᵣ {𝕀} {simplex 1} {A} φ Simplex1.of𝕀)
        (preᵣ-equiv 𝕀 (simplex 1) Simplex1.of𝕀 Simplex1.is-equiv-of𝕀 A)) e3 in
  is-equiv-conj' (complete-restrᵣ a b (arrᵣ A)) (cur-const {grid a} {free-equiv} {grid b →ᵣ arrᵣ A})
    (Tensor.curry-right {grid a} {grid b} {arrᵣ A}) (cur2 {grid a} {free-equiv} {grid b} {arrᵣ A})
    (cur-complete-restr a b (arrᵣ A)) (snd _ (Tensor.curry-equiv-right {grid a} {grid b} {arrᵣ A}))
    (is-equiv-cur2 {grid a} {free-equiv} {grid b} {arrᵣ A}) e4
