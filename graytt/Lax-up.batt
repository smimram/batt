--
-- Lax and oplax universal properties
--
-- Oplax universal property of pullbacks: for crisp g : A → C, h : B → C and a crisp K, oplax maps
-- into the pullback A ×_C B are pairs of oplax maps whose images are homotopic:
--
--   pb-cmpᵣ : (K →ᵣ A ×_C B) → pullbackᵣ K g h            (pullback-oplax-up)
--
-- is an equivalence. The homotopy is an oplax map H : K →ᵣ path C with two paths fixing its
-- endpoints, so that the comparison map involves no transport and its endpoint conditions hold
-- judgmentally.
--
-- Proof. The inverse cannot be written directly: it would evaluate a path of oplax maps at a
-- ⊗-generic point. By the objectwise equivalence axiom it suffices to check global points of
-- grids T, where objectwise-post pb-cmpᵣ is, judgmentally, the composite
--
--   ♭(T → (K →ᵣ P)) ─curry─▶ ♭(T ⨂ K → P) ─♭ pb-map-H─▶ ♭(pullback-H {T ⨂ K})
--                    ─♭ M─▶ ♭(Σ (curried data) . paths) ─♭ pb-pi-sigma─▶ ♭(T → pullbackᵣ K g h)
--
-- of equivalences: currying on global points (Flat.batt), the cartesian universal property of
-- pullbacks in homotopy form (Pullback.batt), M which curries the data and the paths (an
-- equivalence on global points by flat-Σ-map-equiv and flat-cong-equiv, Flat.batt), and the
-- distribution of T over Σ (pb-pi-sigma, with funext).
--
-- The lax universal property (pullback-lax-up, pb-cmpₗ : (K →ₗ A ×_C B) → pullbackₗ K g h) is proved
-- the same way, with lax currying on global points, ♭(T → K →ₗ W) ≃ ♭(K ⨂ T → W) (Flat.batt): the
-- tensor factor K moves to the left.
--
-- Postulates relied on: objectwise-equiv (Axiom.batt), univalence (funext).
--

open import Stdlib
open import Axiom

--
-- The oplax pullback and the comparison map
--

pb-data-r ∷ (K A B C ∷ U) → U
pb-data-r K A B C = (K →ᵣ A) × (K →ᵣ B) × (K →ᵣ path C)

pb-paths-r ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pb-data-r K A B C → U
pb-paths-r K {A} {B} {C} g h x =
  (postᵣ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ postᵣ {K} {A} {C} g (Product.fst x)) ×
  (postᵣ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ postᵣ {K} {B} {C} h (Product.fst (Product.snd x)))

pullbackᵣ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullbackᵣ K {A} {B} {C} g h = Σ (x : pb-data-r K A B C) . pb-paths-r K {A} {B} {C} g h x

pb-cmpᵣ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → (K →ᵣ pullback {A} {B} {C} g h) → pullbackᵣ K {A} {B} {C} g h
pb-cmpᵣ K {A} {B} {C} g h φ =
  (((λ k . fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
   (λ k . fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
   (λ k . (g (fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
           h (fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
           snd (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))))) ,
  refl , refl)

-- the oplax universal property of pullbacks
pullback-oplax-up-stmt ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullback-oplax-up-stmt K {A} {B} {C} g h = is-equiv (pb-cmpᵣ K {A} {B} {C} g h)

--
-- Curried data
--

-- the data, curried along T
pb-data-curried ∷ (T K A B C ∷ U) → U
pb-data-curried T K A B C = (T → K →ᵣ A) × (T → K →ᵣ B) × (T → K →ᵣ path C)

pb-paths-curried ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pb-data-curried T K A B C → U
pb-paths-curried T K {A} {B} {C} g h y =
  ((λ t . postᵣ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd y) t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {A} {C} g (Product.fst y t))) ×
  ((λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd y) t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {B} {C} h (Product.fst (Product.snd y) t)))

-- M: curry the data and the paths
pb-curry-data ∷ (T K A B C ∷ U) → pb-data-H (T ⨂ K) A B C → pb-data-curried T K A B C
pb-curry-data T K A B C =
  flat-Σ-map {T ⨂ K → A} {T → K →ᵣ A} {λ _ . (T ⨂ K → B) × (T ⨂ K → path C)} {λ _ . (T → K →ᵣ B) × (T → K →ᵣ path C)}
    (tens-curry-right' {T} {K} {A})
    (λ _ . flat-Σ-map {T ⨂ K → B} {T → K →ᵣ B} {λ _ . T ⨂ K → path C} {λ _ . T → K →ᵣ path C}
             (tens-curry-right' {T} {K} {B}) (λ _ . tens-curry-right' {T} {K} {path C}))

pb-curry-paths ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (x : pb-data-H (T ⨂ K) A B C) →
  ((post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {A} {C} g (Product.fst x)) ×
   (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {B} {C} h (Product.fst (Product.snd x)))) →
  pb-paths-curried T K {A} {B} {C} g h (pb-curry-data T K A B C x)
pb-curry-paths T K {A} {B} {C} g h (α , r) =
  let k : (r : (T ⨂ K → B) × (T ⨂ K → path C)) →
      ((post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd r) ≡ post {T ⨂ K} {A} {C} g α) ×
       (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd r) ≡ post {T ⨂ K} {B} {C} h (Product.fst r))) →
      pb-paths-curried T K {A} {B} {C} g h (pb-curry-data T K A B C (α , r)) = fun (β , H) → fun (p , p') →
    (cong (tens-curry-right' {T} {K} {C}) p , cong (tens-curry-right' {T} {K} {C}) p') in
  k r

pb-curry ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  pullback-H {T ⨂ K} {A} {B} {C} g h → Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y
pb-curry T K {A} {B} {C} g h =
  flat-Σ-map {pb-data-H (T ⨂ K) A B C} {pb-data-curried T K A B C}
    {λ x . (post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {A} {C} g (Product.fst x)) ×
           (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {B} {C} h (Product.fst (Product.snd x)))}
    {pb-paths-curried T K {A} {B} {C} g h}
    (pb-curry-data T K A B C) (pb-curry-paths T K {A} {B} {C} g h)

-- M is an equivalence on global points
is-equiv-flat-pb-curry-data ∷ (T K A B C ∷ U) → is-equiv (flat-map {pb-data-H (T ⨂ K) A B C} {pb-data-curried T K A B C} (pb-curry-data T K A B C))
is-equiv-flat-pb-curry-data T K A B C =
  flat-Σ-map-equiv {T ⨂ K → A} {T → K →ᵣ A} {λ _ . (T ⨂ K → B) × (T ⨂ K → path C)} {λ _ . (T → K →ᵣ B) × (T → K →ᵣ path C)}
    (tens-curry-right' {T} {K} {A})
    (λ _ . flat-Σ-map {T ⨂ K → B} {T → K →ᵣ B} {λ _ . T ⨂ K → path C} {λ _ . T → K →ᵣ path C}
             (tens-curry-right' {T} {K} {B}) (λ _ . tens-curry-right' {T} {K} {path C}))
    (is-equiv-flat-tens-uncurry {T} {K} {A})
    (λ _ . flat-Σ-map-equiv {T ⨂ K → B} {T → K →ᵣ B} {λ _ . T ⨂ K → path C} {λ _ . T → K →ᵣ path C}
             (tens-curry-right' {T} {K} {B}) (λ _ . tens-curry-right' {T} {K} {path C})
             (is-equiv-flat-tens-uncurry {T} {K} {B}) (λ _ . is-equiv-flat-tens-uncurry {T} {K} {path C}))

is-equiv-flat-pb-curry-paths ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (x ∷ pb-data-H (T ⨂ K) A B C) →
  is-equiv (flat-map {(post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {A} {C} g (Product.fst x)) ×
                      (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {B} {C} h (Product.fst (Product.snd x)))}
                     {pb-paths-curried T K {A} {B} {C} g h (pb-curry-data T K A B C x)}
                     (pb-curry-paths T K {A} {B} {C} g h x))
is-equiv-flat-pb-curry-paths T K {A} {B} {C} g h (α , r) =
  let k : (r ∷ (T ⨂ K → B) × (T ⨂ K → path C)) →
      is-equiv (flat-map {(post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd r) ≡ post {T ⨂ K} {A} {C} g α) ×
                          (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd r) ≡ post {T ⨂ K} {B} {C} h (Product.fst r))}
                         {pb-paths-curried T K {A} {B} {C} g h (pb-curry-data T K A B C (α , r))}
                         (pb-curry-paths T K {A} {B} {C} g h (α , r))) = fun (β , H) →
    let S ∷ T ⨂ K → C = post {T ⨂ K} {path C} {C} (path-src {C}) H in
    let S' ∷ T ⨂ K → C = post {T ⨂ K} {path C} {C} (path-tgt {C}) H in
    let G ∷ T ⨂ K → C = post {T ⨂ K} {A} {C} g α in
    let G' ∷ T ⨂ K → C = post {T ⨂ K} {B} {C} h β in
    let c ∷ (T ⨂ K → C) → (T → K →ᵣ C) = tens-curry-right' {T} {K} {C} in
    is-equiv-htpy {♭((S ≡ G) × (S' ≡ G'))} {♭((c S ≡ c G) × (c S' ≡ c G'))}
      {flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')}
         (flat-Σ-map {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'}))}
      {flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')} (pb-curry-paths T K {A} {B} {C} g h (α , β , H))}
      (fun 𝄫w → let hw : (w ∷ (S ≡ G) × (S' ≡ G')) →
                       flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')}
                         (flat-Σ-map {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'})) 𝄫w
                       ≡ flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')} (pb-curry-paths T K {A} {B} {C} g h (α , β , H)) 𝄫w =
                   fun (p , p') → refl in hw w)
      (flat-Σ-map-equiv {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'})
         (flat-cong-equiv c (is-equiv-flat-tens-uncurry {T} {K} {C}) S G)
         (λ _ . flat-cong-equiv c (is-equiv-flat-tens-uncurry {T} {K} {C}) S' G'))
  in
  k r

is-equiv-flat-pb-curry ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  is-equiv (flat-map {pullback-H {T ⨂ K} {A} {B} {C} g h} {Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y}
                     (pb-curry T K {A} {B} {C} g h))
is-equiv-flat-pb-curry T K {A} {B} {C} g h =
  flat-Σ-map-equiv {pb-data-H (T ⨂ K) A B C} {pb-data-curried T K A B C}
    {λ x . (post {T ⨂ K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {A} {C} g (Product.fst x)) ×
           (post {T ⨂ K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {T ⨂ K} {B} {C} h (Product.fst (Product.snd x)))}
    {pb-paths-curried T K {A} {B} {C} g h}
    (pb-curry-data T K A B C) (pb-curry-paths T K {A} {B} {C} g h)
    (is-equiv-flat-pb-curry-data T K A B C) (is-equiv-flat-pb-curry-paths T K {A} {B} {C} g h)

--
-- Distributing T over Σ (a genuine equivalence, by funext)
--

pb-pi-sigma ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  (Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y) → T → pullbackᵣ K {A} {B} {C} g h
pb-pi-sigma T K {A} {B} {C} g h (y , ps) t =
  ((Product.fst y t , Product.fst (Product.snd y) t , Product.snd (Product.snd y) t) ,
   happly {T} {λ _ . K →ᵣ C} {λ t' . postᵣ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd y) t')} {λ t' . postᵣ {K} {A} {C} g (Product.fst y t')} (Product.fst ps) t ,
   happly {T} {λ _ . K →ᵣ C} {λ t' . postᵣ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd y) t')} {λ t' . postᵣ {K} {B} {C} h (Product.fst (Product.snd y) t')} (Product.snd ps) t)

-- components of an element of the oplax pullback
pbr-u ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackᵣ K {A} {B} {C} g h → K →ᵣ A
pbr-u K {A} {B} {C} g h w = Product.fst (fst (pb-paths-r K {A} {B} {C} g h) w)

pbr-v ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackᵣ K {A} {B} {C} g h → K →ᵣ B
pbr-v K {A} {B} {C} g h w = Product.fst (Product.snd (fst (pb-paths-r K {A} {B} {C} g h) w))

pbr-H ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackᵣ K {A} {B} {C} g h → K →ᵣ path C
pbr-H K {A} {B} {C} g h w = Product.snd (Product.snd (fst (pb-paths-r K {A} {B} {C} g h) w))

pb-pi-sigma-inv ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  (T → pullbackᵣ K {A} {B} {C} g h) → Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y
pb-pi-sigma-inv T K {A} {B} {C} g h F =
  let U' : T → K →ᵣ A = λ t . pbr-u K {A} {B} {C} g h (F t) in
  let V' : T → K →ᵣ B = λ t . pbr-v K {A} {B} {C} g h (F t) in
  let H' : T → K →ᵣ path C = λ t . pbr-H K {A} {B} {C} g h (F t) in
  ((U' , V' , H') ,
   funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postᵣ {K} {A} {C} g (U' t))
     (λ t . Product.fst (snd (pb-paths-r K {A} {B} {C} g h) (F t))) ,
   funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postᵣ {K} {B} {C} h (V' t))
     (λ t . Product.snd (snd (pb-paths-r K {A} {B} {C} g h) (F t))))

-- η for the oplax pullback
pbr-eta ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (w : pullbackᵣ K {A} {B} {C} g h) →
  ((pbr-u K {A} {B} {C} g h w , pbr-v K {A} {B} {C} g h w , pbr-H K {A} {B} {C} g h w) ,
   Product.fst (snd (pb-paths-r K {A} {B} {C} g h) w) , Product.snd (snd (pb-paths-r K {A} {B} {C} g h) w))
    ≡{pullbackᵣ K {A} {B} {C} g h} w
pbr-eta K {A} {B} {C} g h (x , ps) =
  let k : (u : K →ᵣ A) (r : (K →ᵣ B) × (K →ᵣ path C)) (ps : pb-paths-r K {A} {B} {C} g h (u , r)) →
      ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullbackᵣ K {A} {B} {C} g h} ((u , r) , ps) =
    λ u r ps . let k2 : (r : (K →ᵣ B) × (K →ᵣ path C)) (ps : pb-paths-r K {A} {B} {C} g h (u , r)) →
                   ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullbackᵣ K {A} {B} {C} g h} ((u , r) , ps) =
                 fun (v , H) (p , p') → refl in k2 r ps in
  let k1 : (x : pb-data-r K A B C) (ps : pb-paths-r K {A} {B} {C} g h x) →
      ((Product.fst x , Product.fst (Product.snd x) , Product.snd (Product.snd x)) , Product.fst ps , Product.snd ps) ≡{pullbackᵣ K {A} {B} {C} g h} (x , ps) =
    fun (u , r) ps → k u r ps in
  k1 x ps

pb-pi-sigma-sec ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (F : T → pullbackᵣ K {A} {B} {C} g h) →
  pb-pi-sigma T K {A} {B} {C} g h (pb-pi-sigma-inv T K {A} {B} {C} g h F) ≡ F
pb-pi-sigma-sec T K {A} {B} {C} g h F =
  let U' : T → K →ᵣ A = λ t . pbr-u K {A} {B} {C} g h (F t) in
  let V' : T → K →ᵣ B = λ t . pbr-v K {A} {B} {C} g h (F t) in
  let H' : T → K →ᵣ path C = λ t . pbr-H K {A} {B} {C} g h (F t) in
  let s : (t : T) → postᵣ {K} {path C} {C} (path-src {C}) (H' t) ≡ postᵣ {K} {A} {C} g (U' t) = λ t . Product.fst (snd (pb-paths-r K {A} {B} {C} g h) (F t)) in
  let s' : (t : T) → postᵣ {K} {path C} {C} (path-tgt {C}) (H' t) ≡ postᵣ {K} {B} {C} h (V' t) = λ t . Product.snd (snd (pb-paths-r K {A} {B} {C} g h) (F t)) in
  let hs : happly {T} {λ _ . K →ᵣ C} {λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)} {λ t . postᵣ {K} {A} {C} g (U' t)}
             (funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postᵣ {K} {A} {C} g (U' t)) s) ≡ s =
    happly-funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postᵣ {K} {A} {C} g (U' t)) s in
  let hs' : happly {T} {λ _ . K →ᵣ C} {λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)} {λ t . postᵣ {K} {B} {C} h (V' t)}
              (funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postᵣ {K} {B} {C} h (V' t)) s') ≡ s' =
    happly-funext-htpy {T} {λ _ . K →ᵣ C} (λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postᵣ {K} {B} {C} h (V' t)) s' in
  funext-htpy {T} {λ _ . pullbackᵣ K {A} {B} {C} g h} (pb-pi-sigma T K {A} {B} {C} g h (pb-pi-sigma-inv T K {A} {B} {C} g h F)) F
    (λ t . trans (cong2 {postᵣ {K} {path C} {C} (path-src {C}) (H' t) ≡ postᵣ {K} {A} {C} g (U' t)}
                        {postᵣ {K} {path C} {C} (path-tgt {C}) (H' t) ≡ postᵣ {K} {B} {C} h (V' t)} {pullbackᵣ K {A} {B} {C} g h}
                   (λ p p' . ((U' t , V' t , H' t) , p , p'))
                   (happly {T} {λ t' . postᵣ {K} {path C} {C} (path-src {C}) (H' t') ≡ postᵣ {K} {A} {C} g (U' t')} hs t)
                   (happly {T} {λ t' . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t') ≡ postᵣ {K} {B} {C} h (V' t')} hs' t))
             (pbr-eta K {A} {B} {C} g h (F t)))

pb-pi-sigma-ret ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (d : Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y) →
  pb-pi-sigma-inv T K {A} {B} {C} g h (pb-pi-sigma T K {A} {B} {C} g h d) ≡ d
pb-pi-sigma-ret T K {A} {B} {C} g h (y , ps) =
  let k : (U' : T → K →ᵣ A) (V' : T → K →ᵣ B) (H' : T → K →ᵣ path C)
          (p : (λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {A} {C} g (U' t)))
          (p' : (λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {B} {C} h (V' t))) →
      pb-pi-sigma-inv T K {A} {B} {C} g h (pb-pi-sigma T K {A} {B} {C} g h ((U' , V' , H') , p , p')) ≡ ((U' , V' , H') , p , p') =
    λ U' V' H' p p' .
      cong2 {(λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {A} {C} g (U' t))}
            {(λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)) ≡{T → K →ᵣ C} (λ t . postᵣ {K} {B} {C} h (V' t))}
            {Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y}
        (λ q q' . ((U' , V' , H') , q , q'))
        (funext-htpy-happly {T} {λ _ . K →ᵣ C} {λ t . postᵣ {K} {path C} {C} (path-src {C}) (H' t)} {λ t . postᵣ {K} {A} {C} g (U' t)} p)
        (funext-htpy-happly {T} {λ _ . K →ᵣ C} {λ t . postᵣ {K} {path C} {C} (path-tgt {C}) (H' t)} {λ t . postᵣ {K} {B} {C} h (V' t)} p') in
  let k1 : (y : pb-data-curried T K A B C) (ps : pb-paths-curried T K {A} {B} {C} g h y) →
      pb-pi-sigma-inv T K {A} {B} {C} g h (pb-pi-sigma T K {A} {B} {C} g h (y , ps)) ≡ (y , ps) =
    fun (U' , r) ps → let k2 : (r : (T → K →ᵣ B) × (T → K →ᵣ path C)) (ps : pb-paths-curried T K {A} {B} {C} g h (U' , r)) →
                              pb-pi-sigma-inv T K {A} {B} {C} g h (pb-pi-sigma T K {A} {B} {C} g h ((U' , r) , ps)) ≡ ((U' , r) , ps) =
                        fun (V' , H') (p , p') → k U' V' H' p p' in k2 r ps in
  k1 y ps

is-equiv-pb-pi-sigma ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → is-equiv (pb-pi-sigma T K {A} {B} {C} g h)
is-equiv-pb-pi-sigma T K {A} {B} {C} g h =
  ((pb-pi-sigma-inv T K {A} {B} {C} g h , pb-pi-sigma-sec T K {A} {B} {C} g h) ,
   (pb-pi-sigma-inv T K {A} {B} {C} g h , pb-pi-sigma-ret T K {A} {B} {C} g h))

--
-- The oplax universal property of pullbacks
--

-- on the global points of T, the comparison map is the composite of the four equivalences above
pb-cmpᵣ-steps ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  ♭(T → K →ᵣ pullback {A} {B} {C} g h) → ♭(T → pullbackᵣ K {A} {B} {C} g h)
pb-cmpᵣ-steps T K {A} {B} {C} g h =
  flat-map {Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y} {T → pullbackᵣ K {A} {B} {C} g h}
    (pb-pi-sigma T K {A} {B} {C} g h) ∘
  (flat-map {pullback-H {T ⨂ K} {A} {B} {C} g h} {Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y}
    (pb-curry T K {A} {B} {C} g h) ∘
  (flat-map {T ⨂ K → pullback {A} {B} {C} g h} {pullback-H {T ⨂ K} {A} {B} {C} g h} (pb-map-H {T ⨂ K} {A} {B} {C} g h) ∘
   flat-tens-curry {T} {K} {pullback {A} {B} {C} g h}))

is-equiv-pb-cmpᵣ-steps ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → is-equiv (pb-cmpᵣ-steps T K {A} {B} {C} g h)
is-equiv-pb-cmpᵣ-steps T K {A} {B} {C} g h =
  let P ∷ U = pullback {A} {B} {C} g h in
  let PH ∷ U = pullback-H {T ⨂ K} {A} {B} {C} g h in
  let S ∷ U = Σ (y : pb-data-curried T K A B C) . pb-paths-curried T K {A} {B} {C} g h y in
  let Pr ∷ U = pullbackᵣ K {A} {B} {C} g h in
  let m1 : ♭(T → K →ᵣ P) → ♭(T ⨂ K → P) = flat-tens-curry {T} {K} {P} in
  let m2 : ♭(T ⨂ K → P) → ♭ PH = flat-map {T ⨂ K → P} {PH} (pb-map-H {T ⨂ K} {A} {B} {C} g h) in
  let m3 : ♭ PH → ♭ S = flat-map {PH} {S} (pb-curry T K {A} {B} {C} g h) in
  let m4 : ♭ S → ♭(T → Pr) = flat-map {S} {T → Pr} (pb-pi-sigma T K {A} {B} {C} g h) in
  is-equiv-circ {♭(T → K →ᵣ P)} {♭ S} {♭(T → Pr)} m4 (m3 ∘ (m2 ∘ m1))
    (flat-map-equiv {S} {T → Pr} (pb-pi-sigma T K {A} {B} {C} g h) (is-equiv-pb-pi-sigma T K {A} {B} {C} g h))
    (is-equiv-circ {♭(T → K →ᵣ P)} {♭ PH} {♭ S} m3 (m2 ∘ m1)
      (is-equiv-flat-pb-curry T K {A} {B} {C} g h)
      (is-equiv-circ {♭(T → K →ᵣ P)} {♭(T ⨂ K → P)} {♭ PH} m2 m1
        (flat-map-equiv {T ⨂ K → P} {PH} (pb-map-H {T ⨂ K} {A} {B} {C} g h) (is-equiv-pb-map-H {T ⨂ K} {A} {B} {C} g h))
        (is-equiv-flat-tens-curry {T} {K} {P})))

-- the composite agrees with the comparison map on global points, judgmentally
pb-cmpᵣ-steps-htpy ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (ψ : ♭(T → K →ᵣ pullback {A} {B} {C} g h)) →
  pb-cmpᵣ-steps T K {A} {B} {C} g h ψ ≡
  flat-map {T → K →ᵣ pullback {A} {B} {C} g h} {T → pullbackᵣ K {A} {B} {C} g h}
    (post {T} {K →ᵣ pullback {A} {B} {C} g h} {pullbackᵣ K {A} {B} {C} g h} (pb-cmpᵣ K {A} {B} {C} g h)) ψ
pb-cmpᵣ-steps-htpy T K {A} {B} {C} g h 𝄫ψ = refl

pullback-oplax-up ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-oplax-up-stmt K {A} {B} {C} g h
pullback-oplax-up K {A} {B} {C} g h =
  objectwise-equiv {K →ᵣ pullback {A} {B} {C} g h} {pullbackᵣ K {A} {B} {C} g h} (pb-cmpᵣ K {A} {B} {C} g h)
    (λ a . is-equiv-htpy {♭(grid a → K →ᵣ pullback {A} {B} {C} g h)} {♭(grid a → pullbackᵣ K {A} {B} {C} g h)}
             {pb-cmpᵣ-steps (grid a) K {A} {B} {C} g h}
             {objectwise-post {K →ᵣ pullback {A} {B} {C} g h} {pullbackᵣ K {A} {B} {C} g h} (pb-cmpᵣ K {A} {B} {C} g h) a}
             (pb-cmpᵣ-steps-htpy (grid a) K {A} {B} {C} g h)
             (is-equiv-pb-cmpᵣ-steps (grid a) K {A} {B} {C} g h))

--
-- The lax universal property of pullbacks: the same proof, with lax maps and the tensor on the
-- other side (♭(T → K →ₗ W) ≃ ♭(K ⨂ T → W))
--

--
-- The lax pullback and the comparison map
--

pb-data-l ∷ (K A B C ∷ U) → U
pb-data-l K A B C = (K →ₗ A) × (K →ₗ B) × (K →ₗ path C)

pb-paths-l ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pb-data-l K A B C → U
pb-paths-l K {A} {B} {C} g h x =
  (postₗ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ postₗ {K} {A} {C} g (Product.fst x)) ×
  (postₗ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ postₗ {K} {B} {C} h (Product.fst (Product.snd x)))

pullbackₗ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullbackₗ K {A} {B} {C} g h = Σ (x : pb-data-l K A B C) . pb-paths-l K {A} {B} {C} g h x

pb-cmpₗ ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → (K →ₗ pullback {A} {B} {C} g h) → pullbackₗ K {A} {B} {C} g h
pb-cmpₗ K {A} {B} {C} g h φ =
  (((λ k . fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
   (λ k . fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
   (λ k . (g (fst (λ a . Σ (b : B) . g a ≡ h b) (φ k)) ,
           h (fst (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))) ,
           snd (λ b . g (fst (λ a . Σ (b' : B) . g a ≡ h b') (φ k)) ≡ h b) (snd (λ a . Σ (b : B) . g a ≡ h b) (φ k))))) ,
  refl , refl)

-- the lax universal property of pullbacks
pullback-lax-up-stmt ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → U
pullback-lax-up-stmt K {A} {B} {C} g h = is-equiv (pb-cmpₗ K {A} {B} {C} g h)

--
-- Curried data
--

-- the data, curried along T
pb-data-curriedₗ ∷ (T K A B C ∷ U) → U
pb-data-curriedₗ T K A B C = (T → K →ₗ A) × (T → K →ₗ B) × (T → K →ₗ path C)

pb-paths-curriedₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pb-data-curriedₗ T K A B C → U
pb-paths-curriedₗ T K {A} {B} {C} g h y =
  ((λ t . postₗ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd y) t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {A} {C} g (Product.fst y t))) ×
  ((λ t . postₗ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd y) t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {B} {C} h (Product.fst (Product.snd y) t)))

-- M: curry the data and the paths
pb-curry-dataₗ ∷ (T K A B C ∷ U) → pb-data-H (K ⨂ T) A B C → pb-data-curriedₗ T K A B C
pb-curry-dataₗ T K A B C =
  flat-Σ-map {K ⨂ T → A} {T → K →ₗ A} {λ _ . (K ⨂ T → B) × (K ⨂ T → path C)} {λ _ . (T → K →ₗ B) × (T → K →ₗ path C)}
    (tens-curry-left' {K} {T} {A})
    (λ _ . flat-Σ-map {K ⨂ T → B} {T → K →ₗ B} {λ _ . K ⨂ T → path C} {λ _ . T → K →ₗ path C}
             (tens-curry-left' {K} {T} {B}) (λ _ . tens-curry-left' {K} {T} {path C}))

pb-curry-pathsₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (x : pb-data-H (K ⨂ T) A B C) →
  ((post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {A} {C} g (Product.fst x)) ×
   (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {B} {C} h (Product.fst (Product.snd x)))) →
  pb-paths-curriedₗ T K {A} {B} {C} g h (pb-curry-dataₗ T K A B C x)
pb-curry-pathsₗ T K {A} {B} {C} g h (α , r) =
  let k : (r : (K ⨂ T → B) × (K ⨂ T → path C)) →
      ((post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd r) ≡ post {K ⨂ T} {A} {C} g α) ×
       (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd r) ≡ post {K ⨂ T} {B} {C} h (Product.fst r))) →
      pb-paths-curriedₗ T K {A} {B} {C} g h (pb-curry-dataₗ T K A B C (α , r)) = fun (β , H) → fun (p , p') →
    (cong (tens-curry-left' {K} {T} {C}) p , cong (tens-curry-left' {K} {T} {C}) p') in
  k r

pb-curryₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  pullback-H {K ⨂ T} {A} {B} {C} g h → Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y
pb-curryₗ T K {A} {B} {C} g h =
  flat-Σ-map {pb-data-H (K ⨂ T) A B C} {pb-data-curriedₗ T K A B C}
    {λ x . (post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {A} {C} g (Product.fst x)) ×
           (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {B} {C} h (Product.fst (Product.snd x)))}
    {pb-paths-curriedₗ T K {A} {B} {C} g h}
    (pb-curry-dataₗ T K A B C) (pb-curry-pathsₗ T K {A} {B} {C} g h)

-- M is an equivalence on global points
is-equiv-flat-pb-curry-dataₗ ∷ (T K A B C ∷ U) → is-equiv (flat-map {pb-data-H (K ⨂ T) A B C} {pb-data-curriedₗ T K A B C} (pb-curry-dataₗ T K A B C))
is-equiv-flat-pb-curry-dataₗ T K A B C =
  flat-Σ-map-equiv {K ⨂ T → A} {T → K →ₗ A} {λ _ . (K ⨂ T → B) × (K ⨂ T → path C)} {λ _ . (T → K →ₗ B) × (T → K →ₗ path C)}
    (tens-curry-left' {K} {T} {A})
    (λ _ . flat-Σ-map {K ⨂ T → B} {T → K →ₗ B} {λ _ . K ⨂ T → path C} {λ _ . T → K →ₗ path C}
             (tens-curry-left' {K} {T} {B}) (λ _ . tens-curry-left' {K} {T} {path C}))
    (is-equiv-flat-tens-uncurryₗ {K} {T} {A})
    (λ _ . flat-Σ-map-equiv {K ⨂ T → B} {T → K →ₗ B} {λ _ . K ⨂ T → path C} {λ _ . T → K →ₗ path C}
             (tens-curry-left' {K} {T} {B}) (λ _ . tens-curry-left' {K} {T} {path C})
             (is-equiv-flat-tens-uncurryₗ {K} {T} {B}) (λ _ . is-equiv-flat-tens-uncurryₗ {K} {T} {path C}))

is-equiv-flat-pb-curry-pathsₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (x ∷ pb-data-H (K ⨂ T) A B C) →
  is-equiv (flat-map {(post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {A} {C} g (Product.fst x)) ×
                      (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {B} {C} h (Product.fst (Product.snd x)))}
                     {pb-paths-curriedₗ T K {A} {B} {C} g h (pb-curry-dataₗ T K A B C x)}
                     (pb-curry-pathsₗ T K {A} {B} {C} g h x))
is-equiv-flat-pb-curry-pathsₗ T K {A} {B} {C} g h (α , r) =
  let k : (r ∷ (K ⨂ T → B) × (K ⨂ T → path C)) →
      is-equiv (flat-map {(post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd r) ≡ post {K ⨂ T} {A} {C} g α) ×
                          (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd r) ≡ post {K ⨂ T} {B} {C} h (Product.fst r))}
                         {pb-paths-curriedₗ T K {A} {B} {C} g h (pb-curry-dataₗ T K A B C (α , r))}
                         (pb-curry-pathsₗ T K {A} {B} {C} g h (α , r))) = fun (β , H) →
    let S ∷ K ⨂ T → C = post {K ⨂ T} {path C} {C} (path-src {C}) H in
    let S' ∷ K ⨂ T → C = post {K ⨂ T} {path C} {C} (path-tgt {C}) H in
    let G ∷ K ⨂ T → C = post {K ⨂ T} {A} {C} g α in
    let G' ∷ K ⨂ T → C = post {K ⨂ T} {B} {C} h β in
    let c ∷ (K ⨂ T → C) → (T → K →ₗ C) = tens-curry-left' {K} {T} {C} in
    is-equiv-htpy {♭((S ≡ G) × (S' ≡ G'))} {♭((c S ≡ c G) × (c S' ≡ c G'))}
      {flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')}
         (flat-Σ-map {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'}))}
      {flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')} (pb-curry-pathsₗ T K {A} {B} {C} g h (α , β , H))}
      (fun 𝄫w → let hw : (w ∷ (S ≡ G) × (S' ≡ G')) →
                       flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')}
                         (flat-Σ-map {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'})) 𝄫w
                       ≡ flat-map {(S ≡ G) × (S' ≡ G')} {(c S ≡ c G) × (c S' ≡ c G')} (pb-curry-pathsₗ T K {A} {B} {C} g h (α , β , H)) 𝄫w =
                   fun (p , p') → refl in hw w)
      (flat-Σ-map-equiv {S ≡ G} {c S ≡ c G} {λ _ . S' ≡ G'} {λ _ . c S' ≡ c G'} (cong c {S} {G}) (λ _ . cong c {S'} {G'})
         (flat-cong-equiv c (is-equiv-flat-tens-uncurryₗ {K} {T} {C}) S G)
         (λ _ . flat-cong-equiv c (is-equiv-flat-tens-uncurryₗ {K} {T} {C}) S' G'))
  in
  k r

is-equiv-flat-pb-curryₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  is-equiv (flat-map {pullback-H {K ⨂ T} {A} {B} {C} g h} {Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y}
                     (pb-curryₗ T K {A} {B} {C} g h))
is-equiv-flat-pb-curryₗ T K {A} {B} {C} g h =
  flat-Σ-map-equiv {pb-data-H (K ⨂ T) A B C} {pb-data-curriedₗ T K A B C}
    {λ x . (post {K ⨂ T} {path C} {C} (path-src {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {A} {C} g (Product.fst x)) ×
           (post {K ⨂ T} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd x)) ≡ post {K ⨂ T} {B} {C} h (Product.fst (Product.snd x)))}
    {pb-paths-curriedₗ T K {A} {B} {C} g h}
    (pb-curry-dataₗ T K A B C) (pb-curry-pathsₗ T K {A} {B} {C} g h)
    (is-equiv-flat-pb-curry-dataₗ T K A B C) (is-equiv-flat-pb-curry-pathsₗ T K {A} {B} {C} g h)

--
-- Distributing T over Σ (a genuine equivalence, by funext)
--

pb-pi-sigmaₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  (Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y) → T → pullbackₗ K {A} {B} {C} g h
pb-pi-sigmaₗ T K {A} {B} {C} g h (y , ps) t =
  ((Product.fst y t , Product.fst (Product.snd y) t , Product.snd (Product.snd y) t) ,
   happly {T} {λ _ . K →ₗ C} {λ t' . postₗ {K} {path C} {C} (path-src {C}) (Product.snd (Product.snd y) t')} {λ t' . postₗ {K} {A} {C} g (Product.fst y t')} (Product.fst ps) t ,
   happly {T} {λ _ . K →ₗ C} {λ t' . postₗ {K} {path C} {C} (path-tgt {C}) (Product.snd (Product.snd y) t')} {λ t' . postₗ {K} {B} {C} h (Product.fst (Product.snd y) t')} (Product.snd ps) t)

-- components of an element of the lax pullback
pbl-u ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackₗ K {A} {B} {C} g h → K →ₗ A
pbl-u K {A} {B} {C} g h w = Product.fst (fst (pb-paths-l K {A} {B} {C} g h) w)

pbl-v ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackₗ K {A} {B} {C} g h → K →ₗ B
pbl-v K {A} {B} {C} g h w = Product.fst (Product.snd (fst (pb-paths-l K {A} {B} {C} g h) w))

pbl-H ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullbackₗ K {A} {B} {C} g h → K →ₗ path C
pbl-H K {A} {B} {C} g h w = Product.snd (Product.snd (fst (pb-paths-l K {A} {B} {C} g h) w))

pb-pi-sigma-invₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  (T → pullbackₗ K {A} {B} {C} g h) → Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y
pb-pi-sigma-invₗ T K {A} {B} {C} g h F =
  let U' : T → K →ₗ A = λ t . pbl-u K {A} {B} {C} g h (F t) in
  let V' : T → K →ₗ B = λ t . pbl-v K {A} {B} {C} g h (F t) in
  let H' : T → K →ₗ path C = λ t . pbl-H K {A} {B} {C} g h (F t) in
  ((U' , V' , H') ,
   funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postₗ {K} {A} {C} g (U' t))
     (λ t . Product.fst (snd (pb-paths-l K {A} {B} {C} g h) (F t))) ,
   funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postₗ {K} {B} {C} h (V' t))
     (λ t . Product.snd (snd (pb-paths-l K {A} {B} {C} g h) (F t))))

-- η for the lax pullback
pbl-eta ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (w : pullbackₗ K {A} {B} {C} g h) →
  ((pbl-u K {A} {B} {C} g h w , pbl-v K {A} {B} {C} g h w , pbl-H K {A} {B} {C} g h w) ,
   Product.fst (snd (pb-paths-l K {A} {B} {C} g h) w) , Product.snd (snd (pb-paths-l K {A} {B} {C} g h) w))
    ≡{pullbackₗ K {A} {B} {C} g h} w
pbl-eta K {A} {B} {C} g h (x , ps) =
  let k : (u : K →ₗ A) (r : (K →ₗ B) × (K →ₗ path C)) (ps : pb-paths-l K {A} {B} {C} g h (u , r)) →
      ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullbackₗ K {A} {B} {C} g h} ((u , r) , ps) =
    λ u r ps . let k2 : (r : (K →ₗ B) × (K →ₗ path C)) (ps : pb-paths-l K {A} {B} {C} g h (u , r)) →
                   ((u , Product.fst r , Product.snd r) , Product.fst ps , Product.snd ps) ≡{pullbackₗ K {A} {B} {C} g h} ((u , r) , ps) =
                 fun (v , H) (p , p') → refl in k2 r ps in
  let k1 : (x : pb-data-l K A B C) (ps : pb-paths-l K {A} {B} {C} g h x) →
      ((Product.fst x , Product.fst (Product.snd x) , Product.snd (Product.snd x)) , Product.fst ps , Product.snd ps) ≡{pullbackₗ K {A} {B} {C} g h} (x , ps) =
    fun (u , r) ps → k u r ps in
  k1 x ps

pb-pi-sigma-secₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (F : T → pullbackₗ K {A} {B} {C} g h) →
  pb-pi-sigmaₗ T K {A} {B} {C} g h (pb-pi-sigma-invₗ T K {A} {B} {C} g h F) ≡ F
pb-pi-sigma-secₗ T K {A} {B} {C} g h F =
  let U' : T → K →ₗ A = λ t . pbl-u K {A} {B} {C} g h (F t) in
  let V' : T → K →ₗ B = λ t . pbl-v K {A} {B} {C} g h (F t) in
  let H' : T → K →ₗ path C = λ t . pbl-H K {A} {B} {C} g h (F t) in
  let s : (t : T) → postₗ {K} {path C} {C} (path-src {C}) (H' t) ≡ postₗ {K} {A} {C} g (U' t) = λ t . Product.fst (snd (pb-paths-l K {A} {B} {C} g h) (F t)) in
  let s' : (t : T) → postₗ {K} {path C} {C} (path-tgt {C}) (H' t) ≡ postₗ {K} {B} {C} h (V' t) = λ t . Product.snd (snd (pb-paths-l K {A} {B} {C} g h) (F t)) in
  let hs : happly {T} {λ _ . K →ₗ C} {λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)} {λ t . postₗ {K} {A} {C} g (U' t)}
             (funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postₗ {K} {A} {C} g (U' t)) s) ≡ s =
    happly-funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)) (λ t . postₗ {K} {A} {C} g (U' t)) s in
  let hs' : happly {T} {λ _ . K →ₗ C} {λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)} {λ t . postₗ {K} {B} {C} h (V' t)}
              (funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postₗ {K} {B} {C} h (V' t)) s') ≡ s' =
    happly-funext-htpy {T} {λ _ . K →ₗ C} (λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)) (λ t . postₗ {K} {B} {C} h (V' t)) s' in
  funext-htpy {T} {λ _ . pullbackₗ K {A} {B} {C} g h} (pb-pi-sigmaₗ T K {A} {B} {C} g h (pb-pi-sigma-invₗ T K {A} {B} {C} g h F)) F
    (λ t . trans (cong2 {postₗ {K} {path C} {C} (path-src {C}) (H' t) ≡ postₗ {K} {A} {C} g (U' t)}
                        {postₗ {K} {path C} {C} (path-tgt {C}) (H' t) ≡ postₗ {K} {B} {C} h (V' t)} {pullbackₗ K {A} {B} {C} g h}
                   (λ p p' . ((U' t , V' t , H' t) , p , p'))
                   (happly {T} {λ t' . postₗ {K} {path C} {C} (path-src {C}) (H' t') ≡ postₗ {K} {A} {C} g (U' t')} hs t)
                   (happly {T} {λ t' . postₗ {K} {path C} {C} (path-tgt {C}) (H' t') ≡ postₗ {K} {B} {C} h (V' t')} hs' t))
             (pbl-eta K {A} {B} {C} g h (F t)))

pb-pi-sigma-retₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (d : Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y) →
  pb-pi-sigma-invₗ T K {A} {B} {C} g h (pb-pi-sigmaₗ T K {A} {B} {C} g h d) ≡ d
pb-pi-sigma-retₗ T K {A} {B} {C} g h (y , ps) =
  let k : (U' : T → K →ₗ A) (V' : T → K →ₗ B) (H' : T → K →ₗ path C)
          (p : (λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {A} {C} g (U' t)))
          (p' : (λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {B} {C} h (V' t))) →
      pb-pi-sigma-invₗ T K {A} {B} {C} g h (pb-pi-sigmaₗ T K {A} {B} {C} g h ((U' , V' , H') , p , p')) ≡ ((U' , V' , H') , p , p') =
    λ U' V' H' p p' .
      cong2 {(λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {A} {C} g (U' t))}
            {(λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)) ≡{T → K →ₗ C} (λ t . postₗ {K} {B} {C} h (V' t))}
            {Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y}
        (λ q q' . ((U' , V' , H') , q , q'))
        (funext-htpy-happly {T} {λ _ . K →ₗ C} {λ t . postₗ {K} {path C} {C} (path-src {C}) (H' t)} {λ t . postₗ {K} {A} {C} g (U' t)} p)
        (funext-htpy-happly {T} {λ _ . K →ₗ C} {λ t . postₗ {K} {path C} {C} (path-tgt {C}) (H' t)} {λ t . postₗ {K} {B} {C} h (V' t)} p') in
  let k1 : (y : pb-data-curriedₗ T K A B C) (ps : pb-paths-curriedₗ T K {A} {B} {C} g h y) →
      pb-pi-sigma-invₗ T K {A} {B} {C} g h (pb-pi-sigmaₗ T K {A} {B} {C} g h (y , ps)) ≡ (y , ps) =
    fun (U' , r) ps → let k2 : (r : (T → K →ₗ B) × (T → K →ₗ path C)) (ps : pb-paths-curriedₗ T K {A} {B} {C} g h (U' , r)) →
                              pb-pi-sigma-invₗ T K {A} {B} {C} g h (pb-pi-sigmaₗ T K {A} {B} {C} g h ((U' , r) , ps)) ≡ ((U' , r) , ps) =
                        fun (V' , H') (p , p') → k U' V' H' p p' in k2 r ps in
  k1 y ps

is-equiv-pb-pi-sigmaₗ ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → is-equiv (pb-pi-sigmaₗ T K {A} {B} {C} g h)
is-equiv-pb-pi-sigmaₗ T K {A} {B} {C} g h =
  ((pb-pi-sigma-invₗ T K {A} {B} {C} g h , pb-pi-sigma-secₗ T K {A} {B} {C} g h) ,
   (pb-pi-sigma-invₗ T K {A} {B} {C} g h , pb-pi-sigma-retₗ T K {A} {B} {C} g h))

--
-- The lax universal property of pullbacks
--

-- on the global points of T, the comparison map is the composite of the four equivalences above
pb-cmpₗ-steps ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) →
  ♭(T → K →ₗ pullback {A} {B} {C} g h) → ♭(T → pullbackₗ K {A} {B} {C} g h)
pb-cmpₗ-steps T K {A} {B} {C} g h =
  flat-map {Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y} {T → pullbackₗ K {A} {B} {C} g h}
    (pb-pi-sigmaₗ T K {A} {B} {C} g h) ∘
  (flat-map {pullback-H {K ⨂ T} {A} {B} {C} g h} {Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y}
    (pb-curryₗ T K {A} {B} {C} g h) ∘
  (flat-map {K ⨂ T → pullback {A} {B} {C} g h} {pullback-H {K ⨂ T} {A} {B} {C} g h} (pb-map-H {K ⨂ T} {A} {B} {C} g h) ∘
   flat-tens-curryₗ {K} {T} {pullback {A} {B} {C} g h}))

is-equiv-pb-cmpₗ-steps ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → is-equiv (pb-cmpₗ-steps T K {A} {B} {C} g h)
is-equiv-pb-cmpₗ-steps T K {A} {B} {C} g h =
  let P ∷ U = pullback {A} {B} {C} g h in
  let PH ∷ U = pullback-H {K ⨂ T} {A} {B} {C} g h in
  let S ∷ U = Σ (y : pb-data-curriedₗ T K A B C) . pb-paths-curriedₗ T K {A} {B} {C} g h y in
  let Pr ∷ U = pullbackₗ K {A} {B} {C} g h in
  let m1 : ♭(T → K →ₗ P) → ♭(K ⨂ T → P) = flat-tens-curryₗ {K} {T} {P} in
  let m2 : ♭(K ⨂ T → P) → ♭ PH = flat-map {K ⨂ T → P} {PH} (pb-map-H {K ⨂ T} {A} {B} {C} g h) in
  let m3 : ♭ PH → ♭ S = flat-map {PH} {S} (pb-curryₗ T K {A} {B} {C} g h) in
  let m4 : ♭ S → ♭(T → Pr) = flat-map {S} {T → Pr} (pb-pi-sigmaₗ T K {A} {B} {C} g h) in
  is-equiv-circ {♭(T → K →ₗ P)} {♭ S} {♭(T → Pr)} m4 (m3 ∘ (m2 ∘ m1))
    (flat-map-equiv {S} {T → Pr} (pb-pi-sigmaₗ T K {A} {B} {C} g h) (is-equiv-pb-pi-sigmaₗ T K {A} {B} {C} g h))
    (is-equiv-circ {♭(T → K →ₗ P)} {♭ PH} {♭ S} m3 (m2 ∘ m1)
      (is-equiv-flat-pb-curryₗ T K {A} {B} {C} g h)
      (is-equiv-circ {♭(T → K →ₗ P)} {♭(K ⨂ T → P)} {♭ PH} m2 m1
        (flat-map-equiv {K ⨂ T → P} {PH} (pb-map-H {K ⨂ T} {A} {B} {C} g h) (is-equiv-pb-map-H {K ⨂ T} {A} {B} {C} g h))
        (is-equiv-flat-tens-curryₗ {K} {T} {P})))

-- the composite agrees with the comparison map on global points, judgmentally
pb-cmpₗ-steps-htpy ∷ (T K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) (ψ : ♭(T → K →ₗ pullback {A} {B} {C} g h)) →
  pb-cmpₗ-steps T K {A} {B} {C} g h ψ ≡
  flat-map {T → K →ₗ pullback {A} {B} {C} g h} {T → pullbackₗ K {A} {B} {C} g h}
    (post {T} {K →ₗ pullback {A} {B} {C} g h} {pullbackₗ K {A} {B} {C} g h} (pb-cmpₗ K {A} {B} {C} g h)) ψ
pb-cmpₗ-steps-htpy T K {A} {B} {C} g h 𝄫ψ = refl

pullback-lax-up ∷ (K ∷ U) {A B C ∷ U} (g ∷ A → C) (h ∷ B → C) → pullback-lax-up-stmt K {A} {B} {C} g h
pullback-lax-up K {A} {B} {C} g h =
  objectwise-equiv {K →ₗ pullback {A} {B} {C} g h} {pullbackₗ K {A} {B} {C} g h} (pb-cmpₗ K {A} {B} {C} g h)
    (λ a . is-equiv-htpy {♭(grid a → K →ₗ pullback {A} {B} {C} g h)} {♭(grid a → pullbackₗ K {A} {B} {C} g h)}
             {pb-cmpₗ-steps (grid a) K {A} {B} {C} g h}
             {objectwise-post {K →ₗ pullback {A} {B} {C} g h} {pullbackₗ K {A} {B} {C} g h} (pb-cmpₗ K {A} {B} {C} g h) a}
             (pb-cmpₗ-steps-htpy (grid a) K {A} {B} {C} g h)
             (is-equiv-pb-cmpₗ-steps (grid a) K {A} {B} {C} g h))
