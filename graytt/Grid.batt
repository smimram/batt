--
-- Grids: □[a₀, …, a_{d-1}] := Δ^{a₀} ⊗ … ⊗ Δ^{a_{d-1}}
--
-- There are no lists or vectors yet, so a grid is given by its length d and a sequence
-- a : ℕ → ℕ of which only a 0, …, a (d-1) are used. It is nested to the left, with a leading
-- unit: grid a 3 = ((⊤ ⊗ Δ^{a 0}) ⊗ Δ^{a 1}) ⊗ Δ^{a 2}. grid a 0 = ⊤ is the unit of ⊗.
--

open import Stdlib

grid ∷ (a ∷ ℕ → ℕ) (d ∷ ℕ) → U
grid a zero = ⊤
grid a (succ d) = rec ⨂ simplex (a d)

-- the sequence of the empty grid (any sequence works with length 0): grid no-grid 0 = ⊤,
-- used for unthickened shapes
no-grid ∷ ℕ → ℕ
no-grid _ = 0

--
-- Extending a grid by one factor: grid b e ⊗ Δᵐ is the grid of length e + 1 of snoc e b m,
-- the sequence b with m at position e
--

case-nat ∷ {A : TYPE} → A → (ℕ → A) → ℕ → A
case-nat {A} z s zero = z
case-nat {A} z s (succ n) = s n

lt-succ-self ∷ (e : ℕ) → lt e (succ e)
lt-succ-self zero = tt
lt-succ-self (succ e) = rec

lt-succ-r-s ∷ (k : ℕ) (e : ℕ) → ((k' : ℕ) → lt k' e → lt k' (succ e)) → lt k (succ e) → lt k (succ (succ e))
lt-succ-r-s zero e IH h = tt
lt-succ-r-s (succ k) e IH h = IH k h

lt-succ-r ∷ (e : ℕ) (k : ℕ) → lt k e → lt k (succ e)
lt-succ-r zero k h = exfalso (lt k 1) h
lt-succ-r (succ e) k h = lt-succ-r-s k e rec h

-- the sequence b with m at position e (and shifted values after it)
snoc ∷ ℕ → (ℕ → ℕ) → ℕ → ℕ → ℕ
snoc zero b m = case-nat {ℕ} m (λ k' . b (succ k'))
snoc (succ e) b m = case-nat {ℕ} (b 0) (λ k' . rec (λ j . b (succ j)) m k')

snoc-lt-s ∷ (k : ℕ) (e : ℕ) (b : ℕ → ℕ) (m : ℕ) → ((k' : ℕ) → lt k' e → snoc e (λ j . b (succ j)) m k' ≡ b (succ k')) →
  lt k (succ e) → snoc (succ e) b m k ≡ b k
snoc-lt-s zero e b m IH h = refl
snoc-lt-s (succ k) e b m IH h = IH k h

snoc-lt ∷ (e : ℕ) (b : ℕ → ℕ) (m : ℕ) (k : ℕ) → lt k e → snoc e b m k ≡ b k
snoc-lt zero b m k h = exfalso (snoc 0 b m k ≡ b k) h
snoc-lt (succ e) b m k h = snoc-lt-s k e b m (λ k' h' . rec (λ j . b (succ j)) m k' h') h

snoc-last ∷ (e : ℕ) (b : ℕ → ℕ) (m : ℕ) → snoc e b m e ≡ m
snoc-last zero b m = refl
snoc-last (succ e) b m = rec (λ j . b (succ j)) m

tens-path-r ∷ {X Y Y' ∷ U} (q ∷ Y ≡ Y') → X ⨂ Y ≡ X ⨂ Y'
tens-path-r {X} {Y} refl = refl

tens-path-l ∷ {Y X X' ∷ U} (p ∷ X ≡ X') → X ⨂ Y ≡ X' ⨂ Y
tens-path-l {Y} {X} refl = refl

tens-path ∷ {X X' Y Y' ∷ U} (p ∷ X ≡ X') (q ∷ Y ≡ Y') → X ⨂ Y ≡ X' ⨂ Y'
tens-path {X} {X'} {Y} {Y'} p q = trans (tens-path-l {Y} {X} {X'} p) (tens-path-r {X'} {Y} {Y'} q)

simplex-path ∷ {m n ∷ ℕ} (p ∷ m ≡ n) → simplex m ≡ simplex n
simplex-path {m} refl = refl

grid-agree ∷ (e ∷ ℕ) (b c ∷ ℕ → ℕ) (h ∷ (k : ℕ) → lt k e → b k ≡ c k) → grid b e ≡ grid c e
grid-agree zero b c h = refl
grid-agree (succ e) b c h =
  tens-path {grid b e} {grid c e} {simplex (b e)} {simplex (c e)}
    (rec b c (λ k hk . h k (lt-succ-r e k hk))) (simplex-path {b e} {c e} (h e (lt-succ-self e)))

grid-snoc ∷ (b ∷ ℕ → ℕ) (e ∷ ℕ) (m ∷ ℕ) → grid (snoc e b m) (succ e) ≡ grid b e ⨂ simplex m
grid-snoc b e m =
  tens-path {grid (snoc e b m) e} {grid b e} {simplex (snoc e b m e)} {simplex m}
    (grid-agree e (snoc e b m) b (λ k h . snoc-lt e b m k h)) (simplex-path {snoc e b m e} {m} (snoc-last e b m))
