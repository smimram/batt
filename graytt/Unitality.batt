--
-- Unitality of composition in oplax-Segal types
--
--   comp-homᵣ-lunit : comp (id x , u) ≡ u
--   comp-homᵣ-runit : comp (u , id y) ≡ u
--
-- The argument is the usual one for Segal types. The degenerate 2-simplex (t₁ , t₂) ↦ f t₂ has
-- edges id , f and f, judgmentally, so that the composite of id and f is f by comp-simplex2
-- (Composition.batt). Dually, the edges of (t₁ , t₂) ↦ f t₁ are f , id and f. On hom types, the
-- endpoint paths are handled by path induction.
--
-- Since the unit laws are given by degenerate 2-simplices, they are compatible with the action
-- of maps on homs (hom-map-lunit, hom-map-runit), which is given by 2-simplices too
-- (hom-map-comp-edges, Functoriality.batt).
--
-- Postulates relied on: those of Composition.batt (univalence, is-set-𝕀, truncation).
--

open import Stdlib
open import Hom
open import Spine-up
open import Composition
open import Functoriality

--
-- left unit: the degenerate simplex (t₁ , t₂) ↦ f t₂ has edges id , f and f
--

private
lunit-aux ∷ (X ∷ U) (s : is-segalᵣ X) (f : arrᵣ X) {x : X} (e0 : f 𝕀0 ≡ x) {y : X} (e1 : f 𝕀1 ≡ y) →
  comp-homᵣ s {x} {x} {y} (Hom.id {X} x) (f , e0 , e1) ≡ (f , e0 , e1)
lunit-aux X s f refl refl = comp-simplex2 s (preᵣ {simplex 2} {𝕀} {X} f Simplex2.snd)

-- left unitality on hom types: the composite of id x and u is u
comp-homᵣ-lunit ∷ (X ∷ U) (s : is-segalᵣ X) {x y : X} (u : hom x y) → comp-homᵣ s {x} {x} {y} (Hom.id {X} x) u ≡ u
comp-homᵣ-lunit X s {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) → comp-homᵣ s {x} {x} {y} (Hom.id {X} x) (f , e) ≡ (f , e) =
    fun (e0 , e1) → lunit-aux X s f e0 e1 in
  h e

-- left unitality on cells
comp-homᵣ-lunit-cell ∷ (X ∷ U) (s : is-segalᵣ X) {x y : X} (u : hom x y) →
  hom-cell (comp-homᵣ s (Hom.id x) u) ≡ hom-cell u
comp-homᵣ-lunit-cell X s {x} {y} u = cong (hom-cell {X} {x} {y}) (comp-homᵣ-lunit X s u)

--
-- right unit: the degenerate simplex (t₁ , t₂) ↦ f t₁ has edges f , id and f
--

private
runit-aux ∷ (X ∷ U) (s : is-segalᵣ X) (f : arrᵣ X) {x : X} (e0 : f 𝕀0 ≡ x) {y : X} (e1 : f 𝕀1 ≡ y) →
  comp-homᵣ s {x} {y} {y} (f , e0 , e1) (Hom.id {X} y) ≡ (f , e0 , e1)
runit-aux X s f refl refl = comp-simplex2 s (preᵣ {simplex 2} {𝕀} {X} f Simplex2.fst)

-- right unitality on hom types: the composite of u and id y is u
comp-homᵣ-runit ∷ (X ∷ U) (s : is-segalᵣ X) {x y : X} (u : hom x y) → comp-homᵣ s {x} {y} {y} u (Hom.id {X} y) ≡ u
comp-homᵣ-runit X s {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) → comp-homᵣ s {x} {y} {y} (f , e) (Hom.id {X} y) ≡ (f , e) =
    fun (e0 , e1) → runit-aux X s f e0 e1 in
  h e

-- right unitality on cells
comp-homᵣ-runit-cell ∷ (X ∷ U) (s : is-segalᵣ X) {x y : X} (u : hom x y) →
  hom-cell (comp-homᵣ s u (Hom.id y)) ≡ hom-cell u
comp-homᵣ-runit-cell X s {x} {y} u = cong (hom-cell {X} {x} {y}) (comp-homᵣ-runit X s u)

--
-- Compatibility with the action of maps on homs
--
-- The image of the unit law in X, followed by the commutation of p with composition, is the
-- unit law in A: on the degenerate simplex Ψ, the commutation is the one given by Ψ
-- (hom-map-comp-edges), which is the image of the unit law in X followed by the inverse of the
-- unit law in A, since p ∘ Ψ is the degenerate simplex of p ∘ f.
--

private
hom-map-lunit-aux ∷ (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (f : arrᵣ X) {x : X} (e0 : f 𝕀0 ≡ x) {y : X} (e1 : f 𝕀1 ≡ y) →
  cong (hom-map p {x} {y}) (comp-homᵣ-lunit X sX (f , e0 , e1)) ≡
  trans (hom-map-comp X A p sX sA (Hom.id x) (f , e0 , e1)) (comp-homᵣ-lunit A sA (hom-map p (f , e0 , e1)))
hom-map-lunit-aux X A p sX sA f refl refl =
  let Ψ : simplex 2 →ᵣ X = preᵣ {simplex 2} {𝕀} {X} f Simplex2.snd in
  sym (trans (cong {_ ≡ _} {_ ≡ _} (λ c . trans c (comp-simplex2 sA (postᵣ p Ψ))) (hom-map-comp-edges X A p sX sA Ψ))
    (trans-sym-trans-cancel (cong (hom-map p {f 𝕀0} {f 𝕀1}) (comp-simplex2 sX Ψ)) (comp-simplex2 sA (postᵣ p Ψ))))

-- p preserves left unitality
hom-map-lunit ∷ (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A) {x y : X} (u : hom x y) →
  cong (hom-map p {x} {y}) (comp-homᵣ-lunit X sX u) ≡
  trans (hom-map-comp X A p sX sA (Hom.id x) u) (comp-homᵣ-lunit A sA (hom-map p u))
hom-map-lunit X A p sX sA {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) →
      cong (hom-map p {x} {y}) (comp-homᵣ-lunit X sX (f , e)) ≡
      trans (hom-map-comp X A p sX sA (Hom.id x) (f , e)) (comp-homᵣ-lunit A sA (hom-map p (f , e))) =
    fun (e0 , e1) → hom-map-lunit-aux X A p sX sA f e0 e1 in
  h e

private
hom-map-runit-aux ∷ (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (f : arrᵣ X) {x : X} (e0 : f 𝕀0 ≡ x) {y : X} (e1 : f 𝕀1 ≡ y) →
  cong (hom-map p {x} {y}) (comp-homᵣ-runit X sX (f , e0 , e1)) ≡
  trans (hom-map-comp X A p sX sA (f , e0 , e1) (Hom.id y)) (comp-homᵣ-runit A sA (hom-map p (f , e0 , e1)))
hom-map-runit-aux X A p sX sA f refl refl =
  let Ψ : simplex 2 →ᵣ X = preᵣ {simplex 2} {𝕀} {X} f Simplex2.fst in
  sym (trans (cong {_ ≡ _} {_ ≡ _} (λ c . trans c (comp-simplex2 sA (postᵣ p Ψ))) (hom-map-comp-edges X A p sX sA Ψ))
    (trans-sym-trans-cancel (cong (hom-map p {f 𝕀0} {f 𝕀1}) (comp-simplex2 sX Ψ)) (comp-simplex2 sA (postᵣ p Ψ))))

-- p preserves right unitality
hom-map-runit ∷ (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A) {x y : X} (u : hom x y) →
  cong (hom-map p {x} {y}) (comp-homᵣ-runit X sX u) ≡
  trans (hom-map-comp X A p sX sA u (Hom.id y)) (comp-homᵣ-runit A sA (hom-map p u))
hom-map-runit X A p sX sA {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) →
      cong (hom-map p {x} {y}) (comp-homᵣ-runit X sX (f , e)) ≡
      trans (hom-map-comp X A p sX sA (f , e) (Hom.id y)) (comp-homᵣ-runit A sA (hom-map p (f , e))) =
    fun (e0 , e1) → hom-map-runit-aux X A p sX sA f e0 e1 in
  h e
