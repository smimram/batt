--
-- Unitality of composition in oplax-Segal types
--
--   comp-hom-r-runit-cell : comp (u , id y) and u have the same underlying 1-cell
--   comp-hom-r-lunit-cell : comp (id x , u) and u have the same underlying 1-cell
--
-- The argument is the usual one for Segal types. The degenerate 2-simplex (t₁ , t₂) ↦ u t₁
-- restricts on the spine to the composable pair (u , id y), so by uniqueness of fillers
-- (comp-r-unique, Composition.batt) the composite of the pair is its long edge t ↦ u t, that is
-- u. Dually (t₁ , t₂) ↦ u t₂ is a filler of (id x , u).
--
-- The pair (u , id y) is given by the oplax universal property of the spine, as the inverse of
-- the cocone (u , id y) on the two edges; that the degenerate simplex restricts to it is checked
-- on cocones: the two maps agree because the coordinates agree on the edges, and the glue of
-- the degenerate simplex is trivial because 𝕀 is a set.
--
-- On hom types, the endpoint paths have to agree too. The degenerate simplex and its path of
-- cocones form a filler of the pair, so by contractibility of fillers the composite is the hom
-- read off that filler (fill-hom, Composition.batt); its endpoint paths are those of u up to
-- images of loops in 𝕀, which are refl.
--
-- Postulates relied on: those of Composition.batt (univalence, is-set-𝕀, truncation).
--

open import Stdlib
open import Hom
open import Spine-up
open import Composition

--
-- the coordinates of the 2-simplex on the two edges of the spine
--

-- on the first edge {x₂ = 0}: the first coordinate is the coordinate of the edge, the second is 0
simplex-2-fst-on-edge-1 ∷ (a : spine-2-edge-1) → simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ spine-2-edge-1→𝕀 a
simplex-2-fst-on-edge-1 (c , w) = refl

simplex-2-snd-on-edge-1 ∷ (a : spine-2-edge-1) → simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ 𝕀0
simplex-2-snd-on-edge-1 (c , w) = cong (prod-fst {𝕀} {⊤}) w

-- on the second edge {x₁ = 1}: the first coordinate is 1, the second is the coordinate of the edge
simplex-2-fst-on-edge-2 ∷ (b : spine-2-edge-2) → simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ 𝕀1
simplex-2-fst-on-edge-2 (c , w) = prod-fst {cube-2-x1 c ≡ 𝕀1} {is-in-spine 1 (cube-2-tail c)} w

simplex-2-snd-on-edge-2 ∷ (b : spine-2-edge-2) → simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ spine-2-edge-2→𝕀 b
simplex-2-snd-on-edge-2 (c , w) = refl

-- the same, as crisp paths of maps
simplex-2-fst-on-edge-1-path ∷ (λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a)))
  ≡{spine-2-edge-1 → 𝕀} spine-2-edge-1→𝕀
simplex-2-fst-on-edge-1-path = funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
  (λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))) spine-2-edge-1→𝕀 simplex-2-fst-on-edge-1

simplex-2-snd-on-edge-1-path ∷ (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))) ≡{spine-2-edge-1 → 𝕀} (λ a . 𝕀0)
simplex-2-snd-on-edge-1-path = funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
  (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))) (λ a . 𝕀0) simplex-2-snd-on-edge-1

simplex-2-fst-on-edge-2-path ∷ (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))) ≡{spine-2-edge-2 → 𝕀} (λ b . 𝕀1)
simplex-2-fst-on-edge-2-path = funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
  (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))) (λ b . 𝕀1) simplex-2-fst-on-edge-2

simplex-2-snd-on-edge-2-path ∷ (λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b)))
  ≡{spine-2-edge-2 → 𝕀} spine-2-edge-2→𝕀
simplex-2-snd-on-edge-2-path = funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
  (λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))) spine-2-edge-2→𝕀 simplex-2-snd-on-edge-2

-- at the vertex, these paths are refl
simplex-2-fst-on-edge-1-vertex ∷ happly {spine-2-edge-1} {λ _ . 𝕀}
  {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))} {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path
  spine-2-edge-1-end ≡ refl
simplex-2-fst-on-edge-1-vertex =
  happly {spine-2-edge-1} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ spine-2-edge-1→𝕀 a}
    {happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))}
        {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path} {simplex-2-fst-on-edge-1}
    (happly-funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
        (λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))) spine-2-edge-1→𝕀 simplex-2-fst-on-edge-1)
      spine-2-edge-1-end

simplex-2-snd-on-edge-1-vertex ∷ happly {spine-2-edge-1} {λ _ . 𝕀}
  {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))} {λ a . 𝕀0} simplex-2-snd-on-edge-1-path
  spine-2-edge-1-end ≡ refl
simplex-2-snd-on-edge-1-vertex =
  happly {spine-2-edge-1} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ 𝕀0}
    {happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))}
        {λ a . 𝕀0} simplex-2-snd-on-edge-1-path} {simplex-2-snd-on-edge-1}
    (happly-funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
        (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))) (λ a . 𝕀0) simplex-2-snd-on-edge-1)
      spine-2-edge-1-end

simplex-2-fst-on-edge-2-vertex ∷ happly {spine-2-edge-2} {λ _ . 𝕀}
  {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))} {λ b . 𝕀1} simplex-2-fst-on-edge-2-path
  spine-2-edge-2-start ≡ refl
simplex-2-fst-on-edge-2-vertex =
  happly {spine-2-edge-2} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ 𝕀1}
    {happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))}
        {λ b . 𝕀1} simplex-2-fst-on-edge-2-path} {simplex-2-fst-on-edge-2}
    (happly-funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
        (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))) (λ b . 𝕀1) simplex-2-fst-on-edge-2)
      spine-2-edge-2-start

simplex-2-snd-on-edge-2-vertex ∷ happly {spine-2-edge-2} {λ _ . 𝕀}
  {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))} {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path
  spine-2-edge-2-start ≡ refl
simplex-2-snd-on-edge-2-vertex =
  happly {spine-2-edge-2} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ spine-2-edge-2→𝕀 b}
    {happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))}
        {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path} {simplex-2-snd-on-edge-2}
    (happly-funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
        (λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))) spine-2-edge-2→𝕀 simplex-2-snd-on-edge-2)
      spine-2-edge-2-start

--
-- degenerate 2-simplices and their glue
--

-- the restriction to the spine of the degenerate simplex u ∘ k, for a coordinate k
degen-r ∷ (X ∷ U) (k ∷ simplex 2 → 𝕀) (u : 𝕀 →ᵣ X) → (spine 2 →ᵣ X)
degen-r X k u = spine-restr-r 2 X (pre-r {simplex 2} {𝕀} {X} u k)

-- its glue at the vertex is the image in u of the image of the vertex path in 𝕀
degen-r-glue ∷ (X ∷ U) (k ∷ simplex 2 → 𝕀) (u : 𝕀 →ᵣ X) →
  ap-r {spine 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start}
    spine-2-glue (degen-r X k u)
    ≡ ap-r {𝕀} {X} {k (spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-end))}
      {k (spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-start))}
      (cong k (cong (spine→simplex 2) spine-2-glue)) u
degen-r-glue X k u =
  trans (ap-r-pre-r (spine 2) {simplex 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end}
      {spine-2-edge-2-incl spine-2-edge-2-start} spine-2-glue (spine→simplex 2)
      (pre-r {simplex 2} {𝕀} {X} u k))
    (ap-r-pre-r (simplex 2) {𝕀} {X} {spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-end)}
        {spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-start)}
        (cong (spine→simplex 2) spine-2-glue) k u)

-- for the two coordinates, that path is a loop in the set 𝕀, hence refl, and so is the glue
degen-r-glue-fst ∷ (X ∷ U) (u : 𝕀 →ᵣ X) → ap-r {spine 2} {X}
  {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start} spine-2-glue
  (degen-r X simplex-2-fst u) ≡ refl
degen-r-glue-fst X u =
  trans (degen-r-glue X simplex-2-fst u)
    (ap-r-path {𝕀} {X} {𝕀1} {𝕀1} {cong simplex-2-fst (cong (spine→simplex 2) spine-2-glue)} {refl}
      (prop-path (is-set-𝕀 𝕀1 𝕀1) (cong simplex-2-fst (cong (spine→simplex 2) spine-2-glue)) refl) u)

degen-r-glue-snd ∷ (X ∷ U) (u : 𝕀 →ᵣ X) → ap-r {spine 2} {X}
  {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start} spine-2-glue
  (degen-r X simplex-2-snd u) ≡ refl
degen-r-glue-snd X u =
  trans (degen-r-glue X simplex-2-snd u)
    (ap-r-path {𝕀} {X} {𝕀0} {𝕀0} {cong simplex-2-snd (cong (spine→simplex 2) spine-2-glue)} {refl}
      (prop-path (is-set-𝕀 𝕀0 𝕀0) (cong simplex-2-snd (cong (spine→simplex 2) spine-2-glue)) refl) u)

--
-- right unit: the degenerate simplex (t₁ , t₂) ↦ u t₁ fills the pair (u , id y)
--

-- on cocones: the first edge is u, the second edge is constant at u 1 ≡ y, the glue is trivial
runit-coc ∷ (X ∷ U) {x y : X} (u : hom X x y) →
  spine-2→cocone-r X (degen-r X simplex-2-fst (hom-cell {X} {x} {y} u)) ≡ homs→spine-2-cocone {X} {x} {y} {y} u (id-hom {X} y)
runit-coc X {x} {y} u =
  spine-2-cocone-path X
    (pre-r {spine-2-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) (λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))))
    (pre-r {spine-2-edge-2} {𝕀} {X} (hom-cell {X} {x} {y} u) (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))))
    (ap-r {spine 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start}
        spine-2-glue (degen-r X simplex-2-fst (hom-cell {X} {x} {y} u)))
    (pre-r {spine-2-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) spine-2-edge-1→𝕀)
    (pre-r-path spine-2-edge-1 {𝕀} {X} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))}
        {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path (hom-cell {X} {x} {y} u))
    (λ b . y)
    (trans (pre-r-path spine-2-edge-2 {𝕀} {X} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))}
          {λ b . 𝕀1} simplex-2-fst-on-edge-2-path (hom-cell {X} {x} {y} u))
      (cong {X} {spine-2-edge-2 →ᵣ X} (λ v . λ b . v) (hom-tgt {X} {x} {y} u)))
    (hom-tgt {X} {x} {y} u)
    (trans
      (cong2 {hom-cell {X} {x} {y} u 𝕀1 ≡ hom-cell {X} {x} {y} u 𝕀1} {hom-cell {X} {x} {y} u 𝕀1 ≡ y}
          {hom-cell {X} {x} {y} u 𝕀1 ≡ y} (λ α β . trans α β)
        (degen-r-glue-fst X (hom-cell {X} {x} {y} u))
        (trans (cong-trans {spine-2-edge-2 →ᵣ X} {X} (λ h . h spine-2-edge-2-start)
                  (pre-r-path spine-2-edge-2 {𝕀} {X} {λ b . simplex-2-fst
                        (spine→simplex 2 (spine-2-edge-2-incl b))} {λ b . 𝕀1} simplex-2-fst-on-edge-2-path
                      (hom-cell {X} {x} {y} u))
                  (cong {X} {spine-2-edge-2 →ᵣ X} (λ v . λ b . v) (hom-tgt {X} {x} {y} u)))
          (cong2 {hom-cell {X} {x} {y} u 𝕀1 ≡ hom-cell {X} {x} {y} u 𝕀1} {hom-cell {X} {x} {y} u 𝕀1 ≡ y}
              {hom-cell {X} {x} {y} u 𝕀1 ≡ y} (λ α β . trans α β)
            (trans (ev-r-pre-r-path spine-2-edge-2 {𝕀} {X}
                  {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))} {λ b . 𝕀1} simplex-2-fst-on-edge-2-path
                  spine-2-edge-2-start (hom-cell {X} {x} {y} u))
              (ap-r-path {𝕀} {X} {𝕀1} {𝕀1} {happly {spine-2-edge-2} {λ _ . 𝕀}
                    {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))} {λ b . 𝕀1} simplex-2-fst-on-edge-2-path
                    spine-2-edge-2-start} {refl}
                simplex-2-fst-on-edge-2-vertex (hom-cell {X} {x} {y} u)))
            (ev-r-const {spine-2-edge-2} {X} spine-2-edge-2-start (hom-tgt {X} {x} {y} u)))))
      (trans (trans-refl-l (trans refl (hom-tgt {X} {x} {y} u)))
        (sym (cong {hom-cell {X} {x} {y} u 𝕀1 ≡ hom-cell {X} {x} {y} u 𝕀1} {hom-cell {X} {x} {y} u 𝕀1 ≡ y}
              (λ α . trans α (hom-tgt {X} {x} {y} u))
          (trans (ev-r-pre-r-path spine-2-edge-1 {𝕀} {X}
                {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))} {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path
                spine-2-edge-1-end (hom-cell {X} {x} {y} u))
            (ap-r-path {𝕀} {X} {𝕀1} {𝕀1} {happly {spine-2-edge-1} {λ _ . 𝕀}
                  {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))} {spine-2-edge-1→𝕀}
                  simplex-2-fst-on-edge-1-path spine-2-edge-1-end} {refl}
              simplex-2-fst-on-edge-1-vertex (hom-cell {X} {x} {y} u)))))))

-- hence the degenerate simplex restricts to the composable pair (u , id y)
runit-fill ∷ (X ∷ U) {x y : X} (u : hom X x y) →
  degen-r X simplex-2-fst (hom-cell {X} {x} {y} u) ≡ homs→spine-2 X {x} {y} {y} u (id-hom {X} y)
runit-fill X {x} {y} u =
  trans (sym (spine-2→cocone-r-retr X (degen-r X simplex-2-fst (hom-cell {X} {x} {y} u))))
    (cong {spine-2-cocone-r X} {spine 2 →ᵣ X} (cocone→spine-2-r X) (runit-coc X {x} {y} u))

-- right unitality: the composite of u and id y is u
comp-hom-r-runit-cell ∷ (X ∷ U) (s : is-segal-r X) {x y : X} (u : hom X x y) →
  hom-cell {X} {x} {y} (comp-hom-r X s {x} {y} {y} u (id-hom {X} y)) ≡ hom-cell {X} {x} {y} u
comp-hom-r-runit-cell X s {x} {y} u =
  comp-r-unique X s (homs→spine-2 X {x} {y} {y} u (id-hom {X} y))
    (pre-r {simplex 2} {𝕀} {X} (hom-cell {X} {x} {y} u) simplex-2-fst)
    (runit-fill X {x} {y} u)

--
-- left unit: the degenerate simplex (t₁ , t₂) ↦ u t₂ fills the pair (id x , u)
--

lunit-coc ∷ (X ∷ U) {x y : X} (u : hom X x y) →
  spine-2→cocone-r X (degen-r X simplex-2-snd (hom-cell {X} {x} {y} u)) ≡ homs→spine-2-cocone {X} {x} {x} {y} (id-hom {X} x) u
lunit-coc X {x} {y} u =
  spine-2-cocone-path X
    (pre-r {spine-2-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))))
    (pre-r {spine-2-edge-2} {𝕀} {X} (hom-cell {X} {x} {y} u) (λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))))
    (ap-r {spine 2} {X} {spine-2-edge-1-incl spine-2-edge-1-end} {spine-2-edge-2-incl spine-2-edge-2-start}
        spine-2-glue (degen-r X simplex-2-snd (hom-cell {X} {x} {y} u)))
    (λ a . x)
    (trans (pre-r-path spine-2-edge-1 {𝕀} {X} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))}
          {λ a . 𝕀0} simplex-2-snd-on-edge-1-path (hom-cell {X} {x} {y} u))
      (cong {X} {spine-2-edge-1 →ᵣ X} (λ v . λ a . v) (hom-src {X} {x} {y} u)))
    (pre-r {spine-2-edge-2} {𝕀} {X} (hom-cell {X} {x} {y} u) spine-2-edge-2→𝕀)
    (pre-r-path spine-2-edge-2 {𝕀} {X} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))}
        {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path (hom-cell {X} {x} {y} u))
    (trans refl (sym (hom-src {X} {x} {y} u)))
    (trans
      (cong2 {hom-cell {X} {x} {y} u 𝕀0 ≡ hom-cell {X} {x} {y} u 𝕀0}
          {hom-cell {X} {x} {y} u 𝕀0 ≡ hom-cell {X} {x} {y} u 𝕀0}
          {hom-cell {X} {x} {y} u 𝕀0 ≡ hom-cell {X} {x} {y} u 𝕀0} (λ α β . trans α β)
        (degen-r-glue-snd X (hom-cell {X} {x} {y} u))
        (trans (ev-r-pre-r-path spine-2-edge-2 {𝕀} {X}
              {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))} {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path
              spine-2-edge-2-start (hom-cell {X} {x} {y} u))
          (ap-r-path {𝕀} {X} {𝕀0} {𝕀0} {happly {spine-2-edge-2} {λ _ . 𝕀}
                {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))} {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path
                spine-2-edge-2-start} {refl}
            simplex-2-snd-on-edge-2-vertex (hom-cell {X} {x} {y} u))))
      (sym (trans
        (cong2 {hom-cell {X} {x} {y} u 𝕀0 ≡ x} {x ≡ hom-cell {X} {x} {y} u 𝕀0}
            {hom-cell {X} {x} {y} u 𝕀0 ≡ hom-cell {X} {x} {y} u 𝕀0} (λ α β . trans α β)
          (trans (trans (cong-trans {spine-2-edge-1 →ᵣ X} {X} (λ h . h spine-2-edge-1-end)
                          (pre-r-path spine-2-edge-1 {𝕀} {X} {λ a . simplex-2-snd
                                (spine→simplex 2 (spine-2-edge-1-incl a))} {λ a . 𝕀0} simplex-2-snd-on-edge-1-path
                              (hom-cell {X} {x} {y} u))
                          (cong {X} {spine-2-edge-1 →ᵣ X} (λ v . λ a . v) (hom-src {X} {x} {y} u)))
                    (cong2 {hom-cell {X} {x} {y} u 𝕀0 ≡ hom-cell {X} {x} {y} u 𝕀0}
                        {hom-cell {X} {x} {y} u 𝕀0 ≡ x} {hom-cell {X} {x} {y} u 𝕀0 ≡ x} (λ α β . trans α β)
                      (trans (ev-r-pre-r-path spine-2-edge-1 {𝕀} {X}
                            {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))} {λ a . 𝕀0}
                            simplex-2-snd-on-edge-1-path spine-2-edge-1-end (hom-cell {X} {x} {y} u))
                        (ap-r-path {𝕀} {X} {𝕀0} {𝕀0} {happly {spine-2-edge-1} {λ _ . 𝕀}
                              {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))} {λ a . 𝕀0}
                              simplex-2-snd-on-edge-1-path spine-2-edge-1-end} {refl}
                          simplex-2-snd-on-edge-1-vertex (hom-cell {X} {x} {y} u)))
                      (ev-r-const {spine-2-edge-1} {X} spine-2-edge-1-end (hom-src {X} {x} {y} u))))
            (trans-refl-l (hom-src {X} {x} {y} u)))
          (trans-refl-l (sym (hom-src {X} {x} {y} u))))
        (trans-sym-r (hom-src {X} {x} {y} u)))))

lunit-fill ∷ (X ∷ U) {x y : X} (u : hom X x y) →
  degen-r X simplex-2-snd (hom-cell {X} {x} {y} u) ≡ homs→spine-2 X {x} {x} {y} (id-hom {X} x) u
lunit-fill X {x} {y} u =
  trans (sym (spine-2→cocone-r-retr X (degen-r X simplex-2-snd (hom-cell {X} {x} {y} u))))
    (cong {spine-2-cocone-r X} {spine 2 →ᵣ X} (cocone→spine-2-r X) (lunit-coc X {x} {y} u))

-- left unitality: the composite of id x and u is u
comp-hom-r-lunit-cell ∷ (X ∷ U) (s : is-segal-r X) {x y : X} (u : hom X x y) →
  hom-cell (comp-hom-r X s (id-hom x) u) ≡ hom-cell u
comp-hom-r-lunit-cell X s {x} {y} u =
  comp-r-unique X s (homs→spine-2 X {x} {x} {y} (id-hom {X} x) u)
    (pre-r {simplex 2} {𝕀} {X} (hom-cell {X} {x} {y} u) simplex-2-snd)
    (lunit-fill X {x} {y} u)

--
-- Unit laws on hom types: the endpoint paths agree too
--
-- The degenerate simplex together with runit-coc (resp. lunit-coc) is a filler of the pair
-- (u , id y) (resp. (id x , u)), so by uniqueness of fillers (fill-hom-unique, Composition.batt)
-- the composite is the hom read off that filler. Its cell is u judgmentally; its endpoint paths
-- are those of u, up to loops in 𝕀 at the vertices, which are refl because 𝕀 is a set.
--

-- an oplax map sends a loop in the set 𝕀 to refl
ap-r-loop-𝕀 ∷ {X ∷ U} {i ∷ 𝕀} (c ∷ i ≡ i) (f : 𝕀 →ᵣ X) → ap-r {𝕀} {X} {i} {i} c f ≡ refl
ap-r-loop-𝕀 {X} {i} c f = ap-r-path {𝕀} {X} {i} {i} {c} {refl} (prop-path (is-set-𝕀 i i) c refl) f

-- the paths between the ends of the long edge and the outer vertices of the spine, seen
-- through a degenerate simplex, are refl
long-edge-src-degen ∷ {X ∷ U} (k ∷ simplex 2 → 𝕀) (f : 𝕀 →ᵣ X) →
  ap-r {simplex 2} {X} {long-edge 𝕀0} {spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)}
    long-edge-src (pre-r {simplex 2} {𝕀} {X} f k)
    ≡ ap-r {𝕀} {X} {k (long-edge 𝕀0)} {k (spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start))} (cong k long-edge-src) f
long-edge-src-degen {X} k f = ap-r-pre-r (simplex 2) {𝕀} {X} {long-edge 𝕀0}
  {spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)} long-edge-src k f

long-edge-tgt-degen ∷ {X ∷ U} (k ∷ simplex 2 → 𝕀) (f : 𝕀 →ᵣ X) →
  ap-r {simplex 2} {X} {long-edge 𝕀1} {spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)}
    long-edge-tgt (pre-r {simplex 2} {𝕀} {X} f k)
    ≡ ap-r {𝕀} {X} {k (long-edge 𝕀1)} {k (spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end))} (cong k long-edge-tgt) f
long-edge-tgt-degen {X} k f = ap-r-pre-r (simplex 2) {𝕀} {X} {long-edge 𝕀1}
  {spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)} long-edge-tgt k f

-- trans refl (trans refl p) ≡ p
trans-refl-l2 ∷ {A : U} {x y : A} (p : x ≡ y) → trans refl (trans refl p) ≡ p
trans-refl-l2 {A} {x} {y} p = trans (trans-refl-l (trans refl p)) (trans-refl-l p)

--
-- right unit
--

-- the filler of (u , id y) given by the degenerate simplex (t₁ , t₂) ↦ u t₁
runit-hom-fill ∷ (X ∷ U) {x y : X} (u : hom X x y) → hom-fill X {x} {y} {y} u (id-hom {X} y)
runit-hom-fill X {x} {y} u = (pre-r {simplex 2} {𝕀} {X} (hom-cell {X} {x} {y} u) simplex-2-fst , runit-coc X {x} {y} u)

runit-src ∷ (X ∷ U) {x y : X} (f : 𝕀 →ᵣ X) (e0 : f 𝕀0 ≡ x) (e1 : f 𝕀1 ≡ y) →
  hom-src {X} {x} {y} (fill-hom X {x} {y} {y} (f , e0 , e1) (id-hom {X} y) (runit-hom-fill X {x} {y} (f , e0 , e1))) ≡ e0
runit-src X {x} {y} f e0 e1 =
  let rf : cong (spine-2-cocone-edge-1 {X}) (runit-coc X {x} {y} (f , e0 , e1))
        ≡ pre-r-path spine-2-edge-1 {𝕀} {X} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))}
          {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path f =
    prod-fst (spine-2-cocone-path-maps X _ _ _ _ _ _ _ _ _) in
  let H ∷ happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))}
    {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path spine-2-edge-1-start ≡ refl =
    happly {spine-2-edge-1} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ spine-2-edge-1→𝕀 a}
      {happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))}
          {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path} {simplex-2-fst-on-edge-1}
      (happly-funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
          (λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))) spine-2-edge-1→𝕀 simplex-2-fst-on-edge-1)
        spine-2-edge-1-start in
  let L1 : ap-r {simplex 2} {X} {long-edge 𝕀0} {spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)}
    long-edge-src (pre-r {simplex 2} {𝕀} {X} f simplex-2-fst) ≡ refl =
    trans (long-edge-src-degen {X} simplex-2-fst f) (ap-r-loop-𝕀 {X} {𝕀0} (cong simplex-2-fst long-edge-src) f) in
  let L2 : ev-r {spine-2-edge-1} {X} spine-2-edge-1-start
    (cong (spine-2-cocone-edge-1 {X}) (runit-coc X {x} {y} (f , e0 , e1))) ≡ refl =
    trans (cong (ev-r {spine-2-edge-1} {X} spine-2-edge-1-start) rf)
      (trans (ev-r-pre-r-path spine-2-edge-1 {𝕀} {X}
            {λ a . simplex-2-fst (spine→simplex 2 (spine-2-edge-1-incl a))} {spine-2-edge-1→𝕀} simplex-2-fst-on-edge-1-path
            spine-2-edge-1-start f)
        (ap-r-path {𝕀} {X} {𝕀0} {𝕀0} H f)) in
  trans (cong2 {f 𝕀0 ≡ f 𝕀0} {f 𝕀0 ≡ x} {f 𝕀0 ≡ x} (λ α β . trans α β) L1
           (cong {f 𝕀0 ≡ f 𝕀0} {f 𝕀0 ≡ x} (λ β . trans β e0) L2))
    (trans-refl-l2 e0)

runit-tgt ∷ (X ∷ U) {x y : X} (f : 𝕀 →ᵣ X) (e0 : f 𝕀0 ≡ x) (e1 : f 𝕀1 ≡ y) →
  hom-tgt {X} {x} {y} (fill-hom X {x} {y} {y} (f , e0 , e1) (id-hom {X} y) (runit-hom-fill X {x} {y} (f , e0 , e1))) ≡ e1
runit-tgt X {x} {y} f e0 e1 =
  let P1 : pre-r {spine-2-edge-2} {𝕀} {X} f (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))) ≡
    pre-r {spine-2-edge-2} {𝕀} {X} f (λ b . 𝕀1) =
    pre-r-path spine-2-edge-2 {𝕀} {X} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))}
      {λ b . 𝕀1} simplex-2-fst-on-edge-2-path f in
  let P2 : (λ b . f 𝕀1) ≡{spine-2-edge-2 →ᵣ X} (λ b . y) = cong {X} {spine-2-edge-2 →ᵣ X} (λ v . λ b . v) e1 in
  let rg : cong (spine-2-cocone-edge-2 {X}) (runit-coc X {x} {y} (f , e0 , e1)) ≡ trans P1 P2 =
    prod-snd (spine-2-cocone-path-maps X _ _ _ _ _ _ _ _ _) in
  let H ∷ happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))}
    {λ b . 𝕀1} simplex-2-fst-on-edge-2-path spine-2-edge-2-end ≡ refl =
    happly {spine-2-edge-2} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ 𝕀1}
      {happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))}
          {λ b . 𝕀1} simplex-2-fst-on-edge-2-path} {simplex-2-fst-on-edge-2}
      (happly-funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
          (λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))) (λ b . 𝕀1) simplex-2-fst-on-edge-2)
        spine-2-edge-2-end in
  let L1 : ap-r {simplex 2} {X} {long-edge 𝕀1} {spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)}
    long-edge-tgt (pre-r {simplex 2} {𝕀} {X} f simplex-2-fst) ≡ refl =
    trans (long-edge-tgt-degen {X} simplex-2-fst f) (ap-r-loop-𝕀 {X} {𝕀1} (cong simplex-2-fst long-edge-tgt) f) in
  let L2 : ev-r {spine-2-edge-2} {X} spine-2-edge-2-end
    (cong (spine-2-cocone-edge-2 {X}) (runit-coc X {x} {y} (f , e0 , e1))) ≡ trans refl e1 =
    trans (cong (ev-r {spine-2-edge-2} {X} spine-2-edge-2-end) rg)
      (trans (cong-trans {spine-2-edge-2 →ᵣ X} {X} (λ h . h spine-2-edge-2-end) P1 P2)
        (cong2 {f 𝕀1 ≡ f 𝕀1} {f 𝕀1 ≡ y} {f 𝕀1 ≡ y} (λ α β . trans α β)
          (trans (ev-r-pre-r-path spine-2-edge-2 {𝕀} {X}
                {λ b . simplex-2-fst (spine→simplex 2 (spine-2-edge-2-incl b))} {λ b . 𝕀1} simplex-2-fst-on-edge-2-path
                spine-2-edge-2-end f)
            (ap-r-path {𝕀} {X} {𝕀1} {𝕀1} H f))
          (ev-r-const {spine-2-edge-2} {X} spine-2-edge-2-end e1))) in
  trans (cong2 {f 𝕀1 ≡ f 𝕀1} {f 𝕀1 ≡ y} {f 𝕀1 ≡ y} (λ α β . trans α β) L1 L2) (trans-refl-l2 e1)

-- right unitality on hom types: the composite of u and id y is u
comp-hom-r-runit ∷ (X ∷ U) (s : is-segal-r X) {x y : X} (u : hom X x y) → comp-hom-r X s {x} {y} {y} u (id-hom {X} y) ≡ u
comp-hom-r-runit X s {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) → comp-hom-r X s {x} {y} {y} (f , e) (id-hom {X} y) ≡ (f , e) = fun (e0 , e1) →
    trans (fill-hom-unique X s {x} {y} {y} (f , e0 , e1) (id-hom {X} y) (runit-hom-fill X {x} {y} (f , e0 , e1)))
      (cong {(f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)} {hom X x y} (λ w . (f , w))
        (cong2 {f 𝕀0 ≡ x} {f 𝕀1 ≡ y} {(f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)} pair (runit-src X {x} {y} f e0 e1) (runit-tgt X {x} {y} f e0 e1)))
  in
  h e

--
-- left unit
--

-- the filler of (id x , u) given by the degenerate simplex (t₁ , t₂) ↦ u t₂
lunit-hom-fill ∷ (X ∷ U) {x y : X} (u : hom X x y) → hom-fill X {x} {x} {y} (id-hom {X} x) u
lunit-hom-fill X {x} {y} u = (pre-r {simplex 2} {𝕀} {X} (hom-cell {X} {x} {y} u) simplex-2-snd , lunit-coc X {x} {y} u)

lunit-src ∷ (X ∷ U) {x y : X} (f : 𝕀 →ᵣ X) (e0 : f 𝕀0 ≡ x) (e1 : f 𝕀1 ≡ y) →
  hom-src {X} {x} {y} (fill-hom X {x} {x} {y} (id-hom {X} x) (f , e0 , e1) (lunit-hom-fill X {x} {y} (f , e0 , e1))) ≡ e0
lunit-src X {x} {y} f e0 e1 =
  let P1 : pre-r {spine-2-edge-1} {𝕀} {X} f (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))) ≡
    pre-r {spine-2-edge-1} {𝕀} {X} f (λ a . 𝕀0) =
    pre-r-path spine-2-edge-1 {𝕀} {X} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))}
      {λ a . 𝕀0} simplex-2-snd-on-edge-1-path f in
  let P2 : (λ a . f 𝕀0) ≡{spine-2-edge-1 →ᵣ X} (λ a . x) = cong {X} {spine-2-edge-1 →ᵣ X} (λ v . λ a . v) e0 in
  let rf : cong (spine-2-cocone-edge-1 {X}) (lunit-coc X {x} {y} (f , e0 , e1)) ≡ trans P1 P2 =
    prod-fst (spine-2-cocone-path-maps X _ _ _ _ _ _ _ _ _) in
  let H ∷ happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))}
    {λ a . 𝕀0} simplex-2-snd-on-edge-1-path spine-2-edge-1-start ≡ refl =
    happly {spine-2-edge-1} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a)) ≡ 𝕀0}
      {happly {spine-2-edge-1} {λ _ . 𝕀} {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))}
          {λ a . 𝕀0} simplex-2-snd-on-edge-1-path} {simplex-2-snd-on-edge-1}
      (happly-funext-htpy {spine-2-edge-1} {λ _ . 𝕀}
          (λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))) (λ a . 𝕀0) simplex-2-snd-on-edge-1)
        spine-2-edge-1-start in
  let L1 : ap-r {simplex 2} {X} {long-edge 𝕀0} {spine→simplex 2 (spine-2-edge-1-incl spine-2-edge-1-start)}
    long-edge-src (pre-r {simplex 2} {𝕀} {X} f simplex-2-snd) ≡ refl =
    trans (long-edge-src-degen {X} simplex-2-snd f) (ap-r-loop-𝕀 {X} {𝕀0} (cong simplex-2-snd long-edge-src) f) in
  let L2 : ev-r {spine-2-edge-1} {X} spine-2-edge-1-start
    (cong (spine-2-cocone-edge-1 {X}) (lunit-coc X {x} {y} (f , e0 , e1))) ≡ trans refl e0 =
    trans (cong (ev-r {spine-2-edge-1} {X} spine-2-edge-1-start) rf)
      (trans (cong-trans {spine-2-edge-1 →ᵣ X} {X} (λ h . h spine-2-edge-1-start) P1 P2)
        (cong2 {f 𝕀0 ≡ f 𝕀0} {f 𝕀0 ≡ x} {f 𝕀0 ≡ x} (λ α β . trans α β)
          (trans (ev-r-pre-r-path spine-2-edge-1 {𝕀} {X}
                {λ a . simplex-2-snd (spine→simplex 2 (spine-2-edge-1-incl a))} {λ a . 𝕀0} simplex-2-snd-on-edge-1-path
                spine-2-edge-1-start f)
            (ap-r-path {𝕀} {X} {𝕀0} {𝕀0} H f))
          (ev-r-const {spine-2-edge-1} {X} spine-2-edge-1-start e0))) in
  trans (cong2 {f 𝕀0 ≡ f 𝕀0} {f 𝕀0 ≡ x} {f 𝕀0 ≡ x} (λ α β . trans α β) L1 L2) (trans-refl-l2 e0)

lunit-tgt ∷ (X ∷ U) {x y : X} (f : 𝕀 →ᵣ X) (e0 : f 𝕀0 ≡ x) (e1 : f 𝕀1 ≡ y) →
  hom-tgt {X} {x} {y} (fill-hom X {x} {x} {y} (id-hom {X} x) (f , e0 , e1) (lunit-hom-fill X {x} {y} (f , e0 , e1))) ≡ e1
lunit-tgt X {x} {y} f e0 e1 =
  let rg : cong (spine-2-cocone-edge-2 {X}) (lunit-coc X {x} {y} (f , e0 , e1))
        ≡ pre-r-path spine-2-edge-2 {𝕀} {X} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))}
          {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path f =
    prod-snd (spine-2-cocone-path-maps X _ _ _ _ _ _ _ _ _) in
  let H ∷ happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))}
    {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path spine-2-edge-2-end ≡ refl =
    happly {spine-2-edge-2} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b)) ≡ spine-2-edge-2→𝕀 b}
      {happly {spine-2-edge-2} {λ _ . 𝕀} {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))}
          {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path} {simplex-2-snd-on-edge-2}
      (happly-funext-htpy {spine-2-edge-2} {λ _ . 𝕀}
          (λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))) spine-2-edge-2→𝕀 simplex-2-snd-on-edge-2)
        spine-2-edge-2-end in
  let L1 : ap-r {simplex 2} {X} {long-edge 𝕀1} {spine→simplex 2 (spine-2-edge-2-incl spine-2-edge-2-end)}
    long-edge-tgt (pre-r {simplex 2} {𝕀} {X} f simplex-2-snd) ≡ refl =
    trans (long-edge-tgt-degen {X} simplex-2-snd f) (ap-r-loop-𝕀 {X} {𝕀1} (cong simplex-2-snd long-edge-tgt) f) in
  let L2 : ev-r {spine-2-edge-2} {X} spine-2-edge-2-end
    (cong (spine-2-cocone-edge-2 {X}) (lunit-coc X {x} {y} (f , e0 , e1))) ≡ refl =
    trans (cong (ev-r {spine-2-edge-2} {X} spine-2-edge-2-end) rg)
      (trans (ev-r-pre-r-path spine-2-edge-2 {𝕀} {X}
            {λ b . simplex-2-snd (spine→simplex 2 (spine-2-edge-2-incl b))} {spine-2-edge-2→𝕀} simplex-2-snd-on-edge-2-path
            spine-2-edge-2-end f)
        (ap-r-path {𝕀} {X} {𝕀1} {𝕀1} H f)) in
  trans (cong2 {f 𝕀1 ≡ f 𝕀1} {f 𝕀1 ≡ y} {f 𝕀1 ≡ y} (λ α β . trans α β) L1
           (cong {f 𝕀1 ≡ f 𝕀1} {f 𝕀1 ≡ y} (λ β . trans β e1) L2))
    (trans-refl-l2 e1)

-- left unitality on hom types: the composite of id x and u is u
comp-hom-r-lunit ∷ (X ∷ U) (s : is-segal-r X) {x y : X} (u : hom X x y) → comp-hom-r X s {x} {x} {y} (id-hom {X} x) u ≡ u
comp-hom-r-lunit X s {x} {y} (f , e) =
  let h : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) → comp-hom-r X s {x} {x} {y} (id-hom {X} x) (f , e) ≡ (f , e) = fun (e0 , e1) →
    trans (fill-hom-unique X s {x} {x} {y} (id-hom {X} x) (f , e0 , e1) (lunit-hom-fill X {x} {y} (f , e0 , e1)))
      (cong {(f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)} {hom X x y} (λ w . (f , w))
        (cong2 {f 𝕀0 ≡ x} {f 𝕀1 ≡ y} {(f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)} pair (lunit-src X {x} {y} f e0 e1) (lunit-tgt X {x} {y} f e0 e1)))
  in
  h e
