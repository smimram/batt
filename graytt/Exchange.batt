--
-- 2×2 grids of squares, and the exchange law
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Composable
open import Simplex-edges
open import Pullback-up
open import HomSquare

open Square

--
-- Primitive grids
--
-- A primitive grid is an oplax map Θ : Δ² →ᵣ (Δ² →ᵣ A), the outer variable being horizontal and
-- the inner one vertical. Its squares are its restrictions along pairs of edges of Δ²: since the
-- target of the first edge of Δ² is judgmentally the source of the second one, the four squares
-- given by the first two edges share their sides judgmentally.
--

-- the square of a primitive grid along a horizontal and a vertical edge of Δ²
grid-sq : {A ∷ U} (Θ : simplex 2 →ᵣ (simplex 2 →ᵣ A)) (e e' ∷ 𝕀 → simplex 2) → squareᵣ A
grid-sq Θ e e' = of-arrᵣ (λ i . λ j . Θ (e i) (e' j))

-- vertical composition commutes with transporting along the bottom and top sides
private
comp-v-subst : {A ∷ U} (sA : is-segalᵣ A) {a b c d c' d' : A} {f1 : hom a c} {f2 : hom b d} {f1' : hom c c'} {f2' : hom d d'}
  {g : hom a b} {h : hom c d} {k : hom c' d'} (σ : square f1 f2 g h) (τ : square f1' f2' h k)
  {g' : hom a b} (p : g ≡ g') {h' : hom c d} (q : h ≡ h') {k' : hom c' d'} (r : k ≡ k') →
  comp-v sA (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , f1 , f2 , m , n)) p q) σ)
    (subst squares (cong2 {hom c d} {hom c' d'} {boundary A} (λ m n . (c , d , c' , d' , f1' , f2' , m , n)) q r) τ)
  ≡ subst squares (cong2 {hom a b} {hom c' d'} {boundary A} (λ m n . (a , b , c' , d' , comp-homᵣ sA f1 f1' , comp-homᵣ sA f2 f2' , m , n)) p r)
      (comp-v sA σ τ)
comp-v-subst {A} sA {a} {b} {c} {d} {c'} {d'} {f1} {f2} {f1'} {f2'} {g} {h} {k} σ τ p q r =
  J g (λ g' p . comp-v sA (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , f1 , f2 , m , n)) p q) σ)
        (subst squares (cong2 {hom c d} {hom c' d'} {boundary A} (λ m n . (c , d , c' , d' , f1' , f2' , m , n)) q r) τ)
      ≡ subst squares (cong2 {hom a b} {hom c' d'} {boundary A} (λ m n . (a , b , c' , d' , comp-homᵣ sA f1 f1' , comp-homᵣ sA f2 f2' , m , n)) p r)
          (comp-v sA σ τ))
    (J h (λ h' q . comp-v sA (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , f1 , f2 , m , n)) refl q) σ)
          (subst squares (cong2 {hom c d} {hom c' d'} {boundary A} (λ m n . (c , d , c' , d' , f1' , f2' , m , n)) q r) τ)
        ≡ subst squares (cong2 {hom a b} {hom c' d'} {boundary A} (λ m n . (a , b , c' , d' , comp-homᵣ sA f1 f1' , comp-homᵣ sA f2 f2' , m , n)) refl r)
            (comp-v sA σ τ))
      (J k (λ k' r . comp-v sA σ (subst squares (cong2 {hom c d} {hom c' d'} {boundary A} (λ m n . (c , d , c' , d' , f1' , f2' , m , n)) refl r) τ)
          ≡ subst squares (cong2 {hom a b} {hom c' d'} {boundary A} (λ m n . (a , b , c' , d' , comp-homᵣ sA f1 f1' , comp-homᵣ sA f2 f2' , m , n)) refl r)
              (comp-v sA σ τ))
        refl r)
      q)
    p

-- horizontal composition commutes with transporting along the left and right sides
private
comp-h-subst : {A ∷ U} (sA : is-segalᵣ A) {a b e c d f : A} {f1 : hom a c} {f2 : hom b d} {f3 : hom e f}
  {g : hom a b} {g' : hom b e} {h : hom c d} {h' : hom d f} (σ : square f1 f2 g h) (τ : square f2 f3 g' h')
  {f1' : hom a c} (p : f1 ≡ f1') {f2' : hom b d} (q : f2 ≡ f2') {f3' : hom e f} (r : f3 ≡ f3') →
  comp-h sA (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , g , h)) p q) σ)
    (subst squares (cong2 {hom b d} {hom e f} {boundary A} (λ l r . (b , e , d , f , l , r , g' , h')) q r) τ)
  ≡ subst squares (cong2 {hom a c} {hom e f} {boundary A} (λ l r . (a , e , c , f , l , r , comp-homᵣ sA g g' , comp-homᵣ sA h h')) p r)
      (comp-h sA σ τ)
comp-h-subst {A} sA {a} {b} {e} {c} {d} {f} {f1} {f2} {f3} {g} {g'} {h} {h'} σ τ p q r =
  J f1 (λ f1' p . comp-h sA (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , g , h)) p q) σ)
        (subst squares (cong2 {hom b d} {hom e f} {boundary A} (λ l r . (b , e , d , f , l , r , g' , h')) q r) τ)
      ≡ subst squares (cong2 {hom a c} {hom e f} {boundary A} (λ l r . (a , e , c , f , l , r , comp-homᵣ sA g g' , comp-homᵣ sA h h')) p r)
          (comp-h sA σ τ))
    (J f2 (λ f2' q . comp-h sA (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , g , h)) refl q) σ)
          (subst squares (cong2 {hom b d} {hom e f} {boundary A} (λ l r . (b , e , d , f , l , r , g' , h')) q r) τ)
        ≡ subst squares (cong2 {hom a c} {hom e f} {boundary A} (λ l r . (a , e , c , f , l , r , comp-homᵣ sA g g' , comp-homᵣ sA h h')) refl r)
            (comp-h sA σ τ))
      (J f3 (λ f3' r . comp-h sA σ (subst squares (cong2 {hom b d} {hom e f} {boundary A} (λ l r . (b , e , d , f , l , r , g' , h')) refl r) τ)
          ≡ subst squares (cong2 {hom a c} {hom e f} {boundary A} (λ l r . (a , e , c , f , l , r , comp-homᵣ sA g g' , comp-homᵣ sA h h')) refl r)
              (comp-h sA σ τ))
        refl r)
      q)
    p

-- transporting along the left and right sides commutes with transporting along the bottom and top sides
private
subst-lr-bt : {A ∷ U} {a b c d : A} {L L' : hom a c} (pl : L ≡ L') {R R' : hom b d} (pr : R ≡ R')
  {B B' : hom a b} (pb : B ≡ B') {T T' : hom c d} (pt : T ≡ T') (σ : square L R B T) →
  subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L' , R' , m , n)) pb pt)
    (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B , T)) pl pr) σ)
  ≡ subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B' , T')) pl pr)
      (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L , R , m , n)) pb pt) σ)
subst-lr-bt {A} {a} {b} {c} {d} {L} {L'} pl {R} {R'} pr {B} pb {T} pt σ =
  J B (λ B' pb . subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L' , R' , m , n)) pb pt)
        (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B , T)) pl pr) σ)
      ≡ subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B' , _)) pl pr)
          (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L , R , m , n)) pb pt) σ))
    (J T (λ T' pt . subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L' , R' , m , n)) refl pt)
          (subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B , T)) pl pr) σ)
        ≡ subst squares (cong2 {hom a c} {hom b d} {boundary A} (λ l r . (a , b , c , d , l , r , B , T')) pl pr)
            (subst squares (cong2 {hom a b} {hom c d} {boundary A} (λ m n . (a , b , c , d , L , R , m , n)) refl pt) σ))
      refl pt)
    pb

-- The exchange law for primitive grids: both composites are the square of Θ along the long edges,
-- moved along the composites of the edges of the 2-simplices on its boundary, the left and right
-- ones and the bottom and top ones in either order.
exchange-grid : {A ∷ U} (sA : is-segalᵣ A) (Θ : simplex 2 →ᵣ (simplex 2 →ᵣ A)) →
  comp-v sA (comp-h sA (grid-sq Θ Simplex2.edge₀₁ Simplex2.edge₀₁ , refl) (grid-sq Θ Simplex2.edge₁₂ Simplex2.edge₀₁ , refl))
    (comp-h sA (grid-sq Θ Simplex2.edge₀₁ Simplex2.edge₁₂ , refl) (grid-sq Θ Simplex2.edge₁₂ Simplex2.edge₁₂ , refl))
  ≡ comp-h sA (comp-v sA (grid-sq Θ Simplex2.edge₀₁ Simplex2.edge₀₁ , refl) (grid-sq Θ Simplex2.edge₀₁ Simplex2.edge₁₂ , refl))
      (comp-v sA (grid-sq Θ Simplex2.edge₁₂ Simplex2.edge₀₁ , refl) (grid-sq Θ Simplex2.edge₁₂ Simplex2.edge₁₂ , refl))
exchange-grid {A} sA Θ =
  let e01 ∷ 𝕀 → simplex 2 = Simplex2.edge₀₁ in
  let e12 ∷ 𝕀 → simplex 2 = Simplex2.edge₁₂ in
  let e02 ∷ 𝕀 → simplex 2 = Simplex2.edge₀₂ in
  let x : (e e' ∷ 𝕀 → simplex 2) → squareᵣ A = λ e e' . grid-sq Θ e e' in
  -- the rows and the columns of Θ
  let Ξ : (e ∷ 𝕀 → simplex 2) → simplex 2 →ᵣ arrᵣ A = λ e . λ s . λ j . Θ s (e j) in
  let Φ : (e ∷ 𝕀 → simplex 2) → 𝕀 →ᵣ (simplex 2 →ᵣ A) = λ e . λ i . Θ (e i) in
  -- the composites of the edges of the 2-simplices on the boundary
  let Pb : _ = comp-simplex2 sA (postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ (Ξ e01)) in
  let Pm : _ = comp-simplex2 sA (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ (Ξ e01)) in
  let Pt : _ = comp-simplex2 sA (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ (Ξ e12)) in
  let Pl : _ = comp-simplex2 sA (Θ (e01 𝕀0)) in
  let Pc : _ = comp-simplex2 sA (Θ (e01 𝕀1)) in
  let Pr : _ = comp-simplex2 sA (Θ (e12 𝕀1)) in
  -- the rows and columns of squares
  let H0 : _ = from-path-over2 (bdry-lr (Ξ e01 (e01 𝕀0)) (Ξ e01 (e12 𝕀1))) Pb Pm _ _ (comp-h-simplex sA (Ξ e01)) in
  let H1 : _ = from-path-over2 (bdry-lr (Ξ e12 (e01 𝕀0)) (Ξ e12 (e12 𝕀1))) Pm Pt _ _ (comp-h-simplex sA (Ξ e12)) in
  let H2 : _ = from-path-over2 (bdry-lr (Ξ e02 (e01 𝕀0)) (Ξ e02 (e12 𝕀1))) Pb Pt _ _ (comp-h-simplex sA (Ξ e02)) in
  let V0 : _ = from-path-over2 (bdry-st {A} {simplex 2 →ᵣ A} (λ c . c (e01 𝕀0)) (λ c . c (e12 𝕀1)) (Φ e01)) Pl Pc _ _ (comp-v-simplex sA (Φ e01)) in
  let V1 : _ = from-path-over2 (bdry-st {A} {simplex 2 →ᵣ A} (λ c . c (e01 𝕀0)) (λ c . c (e12 𝕀1)) (Φ e12)) Pc Pr _ _ (comp-v-simplex sA (Φ e12)) in
  let V2 : _ = from-path-over2 (bdry-st {A} {simplex 2 →ᵣ A} (λ c . c (e01 𝕀0)) (λ c . c (e12 𝕀1)) (Φ e02)) Pl Pr _ _ (comp-v-simplex sA (Φ e02)) in
  trans (cong2 (comp-v sA) H0 H1)
    (trans (comp-v-subst sA (x e02 e01 , refl) (x e02 e12 , refl) (sym Pb) (sym Pm) (sym Pt))
      (trans (cong (subst squares _) V2)
        (trans (subst-lr-bt (sym Pl) (sym Pr) (sym Pb) (sym Pt) (x e02 e02 , refl))
          (trans (cong (subst squares _) (sym H2))
            (trans (sym (comp-h-subst sA (x e01 e02 , refl) (x e12 e02 , refl) (sym Pl) (sym Pc) (sym Pr)))
              (sym (cong2 (comp-h sA) V0 V1)))))))

--
-- Rows
--
-- A row is a pair of horizontally adjacent squares. Its boundary is given by the composable pair
-- of its bottom sides, followed by its top corners, its vertical sides and its top sides, so that
-- the rows above a given row are the ones whose boundary starts with its top sides.
--

-- the components of a composable pair of homs
private
pr-x : {A ∷ U} → pairs A → A
pr-x w = fst _ w

private
pr-y : {A ∷ U} → pairs A → A
pr-y w = fst _ (snd _ w)

private
pr-z : {A ∷ U} → pairs A → A
pr-z w = fst _ (snd _ (snd _ w))

private
pr-u : {A ∷ U} (w : pairs A) → hom (pr-x w) (pr-y w)
pr-u w = Product.fst (snd _ (snd _ (snd _ w)))

private
pr-v : {A ∷ U} (w : pairs A) → hom (pr-y w) (pr-z w)
pr-v w = Product.snd (snd _ (snd _ (snd _ w)))

-- the rest of the boundary of a row above a composable pair of homs
row-rest : (A ∷ U) → pairs A → U
row-rest A w = Σ (c : A) . Σ (d : A) . Σ (f : A) . hom (pr-x w) c × hom (pr-y w) d × hom (pr-z w) f × hom c d × hom d f

-- the boundary of a row
row-bdry : (A ∷ U) → U
row-bdry A = Σ (w : pairs A) . row-rest A w

-- the components of the boundary of a row
private
rw-c : {A ∷ U} → row-bdry A → A
rw-c r = fst _ (snd _ r)

private
rw-d : {A ∷ U} → row-bdry A → A
rw-d r = fst _ (snd _ (snd _ r))

private
rw-f : {A ∷ U} → row-bdry A → A
rw-f r = fst _ (snd _ (snd _ (snd _ r)))

private
rw-f1 : {A ∷ U} (r : row-bdry A) → hom (pr-x (fst _ r)) (rw-c r)
rw-f1 r = Product.fst (snd _ (snd _ (snd _ (snd _ r))))

private
rw-f2 : {A ∷ U} (r : row-bdry A) → hom (pr-y (fst _ r)) (rw-d r)
rw-f2 r = Product.fst (Product.snd (snd _ (snd _ (snd _ (snd _ r)))))

private
rw-f3 : {A ∷ U} (r : row-bdry A) → hom (pr-z (fst _ r)) (rw-f r)
rw-f3 r = Product.fst (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ r))))))

private
rw-h : {A ∷ U} (r : row-bdry A) → hom (rw-c r) (rw-d r)
rw-h r = Product.fst (Product.snd (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ r)))))))

private
rw-h' : {A ∷ U} (r : row-bdry A) → hom (rw-d r) (rw-f r)
rw-h' r = Product.snd (Product.snd (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ r)))))))

-- the boundaries of the left and right squares of a row, and its top sides
row-left : {A ∷ U} → row-bdry A → boundary A
row-left r = (pr-x (fst _ r) , pr-y (fst _ r) , rw-c r , rw-d r , rw-f1 r , rw-f2 r , pr-u (fst _ r) , rw-h r)

row-right : {A ∷ U} → row-bdry A → boundary A
row-right r = (pr-y (fst _ r) , pr-z (fst _ r) , rw-d r , rw-f r , rw-f2 r , rw-f3 r , pr-v (fst _ r) , rw-h' r)

row-top : {A ∷ U} → row-bdry A → pairs A
row-top r = (rw-c r , rw-d r , rw-f r , rw-h r , rw-h' r)

-- the squares of a row
row-squares : {A ∷ U} → row-bdry A → U
row-squares r = squares (row-left r) × squares (row-right r)

-- the row given by a 2-simplex of arrows, and its squares
row-of : {A ∷ U} → (simplex 2 →ᵣ arrᵣ A) → row-bdry A
row-of {A} Ξ =
  (edges-2 (postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ Ξ) ,
   (Ξ (Simplex2.edge₀₁ 𝕀0) 𝕀1 , Ξ (Simplex2.edge₁₂ 𝕀0) 𝕀1 , Ξ (Simplex2.edge₁₂ 𝕀1) 𝕀1 ,
    arr-hom (Ξ (Simplex2.edge₀₁ 𝕀0)) , arr-hom (Ξ (Simplex2.edge₁₂ 𝕀0)) , arr-hom (Ξ (Simplex2.edge₁₂ 𝕀1)) ,
    simplex2-hom₀₁ (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ) , simplex2-hom₁₂ (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ)))

row-sq : {A ∷ U} (Ξ : simplex 2 →ᵣ arrᵣ A) → row-squares (row-of Ξ)
row-sq {A} Ξ = ((of-arrᵣ (λ i . Ξ (Simplex2.edge₀₁ i)) , refl) , (of-arrᵣ (λ i . Ξ (Simplex2.edge₁₂ i)) , refl))

-- induction on the boundaries of rows: it is enough to consider the ones given by their components
private
row-bdry-ind : {A ∷ U} (P : row-bdry A → TYPE) →
  ((a b e : A) (g : hom a b) (g' : hom b e) (c d f : A) (f1 : hom a c) (f2 : hom b d) (f3 : hom e f) (h : hom c d) (h' : hom d f) →
   P ((a , b , e , g , g') , (c , d , f , f1 , f2 , f3 , h , h'))) →
  (r : row-bdry A) → P r
row-bdry-ind {A} P k (w , rest) =
  let k1 : (w : pairs A) (rest : row-rest A w) → P (w , rest) = fun (a , w1) →
    let k2 : (w1 : pair-from A a) (rest : row-rest A (a , w1)) → P ((a , w1) , rest) = fun (b , w2) →
      let k3 : (w2 : Σ (e : A) . hom a b × hom b e) (rest : row-rest A (a , b , w2)) → P ((a , b , w2) , rest) = fun (e , w3) →
        let k4 : (w3 : hom a b × hom b e) (rest : row-rest A (a , b , e , w3)) → P ((a , b , e , w3) , rest) = fun (g , g') →
          let r1 : (rest : row-rest A (a , b , e , g , g')) → P ((a , b , e , g , g') , rest) = fun (c , r2) →
            let r2' : (r2 : Σ (d : A) . Σ (f : A) . hom a c × hom b d × hom e f × hom c d × hom d f) → P ((a , b , e , g , g') , (c , r2)) = fun (d , r3) →
              let r3' : (r3 : Σ (f : A) . hom a c × hom b d × hom e f × hom c d × hom d f) → P ((a , b , e , g , g') , (c , d , r3)) = fun (f , r4) →
                let r4' : (r4 : hom a c × hom b d × hom e f × hom c d × hom d f) → P ((a , b , e , g , g') , (c , d , f , r4)) = fun (f1 , r5) →
                  let r5' : (r5 : hom b d × hom e f × hom c d × hom d f) → P ((a , b , e , g , g') , (c , d , f , f1 , r5)) = fun (f2 , r6) →
                    let r6' : (r6 : hom e f × hom c d × hom d f) → P ((a , b , e , g , g') , (c , d , f , f1 , f2 , r6)) = fun (f3 , r7) →
                      let r7' : (r7 : hom c d × hom d f) → P ((a , b , e , g , g') , (c , d , f , f1 , f2 , f3 , r7)) = fun (h , h') →
                        k a b e g g' c d f f1 f2 f3 h h' in
                      r7' r7 in
                    r6' r6 in
                  r5' r5 in
                r4' r4 in
              r3' r3 in
            r2' r2 in
          r1 in
        k4 w3 in
      k3 w2 in
    k2 w1 in
  k1 w rest

-- the motive of row induction, for two squares glued along a path between their vertical sides
private
row-Q : {A ∷ U} (P : (r : row-bdry A) → row-squares r → U) (β : boundary A) → squares β → (β' : boundary A) → squares β' →
  bdry-right β ≡ bdry-left β' → U
row-Q {A} P β σ β' τ E =
  bdry-ind (λ β . squares β → (β' : boundary A) → squares β' → bdry-right β ≡ bdry-left β' → U)
    (λ a b c d f1 f2 g h σ β' τ E .
      bdry-ind (λ β' . squares β' → (b , d , f2) ≡{Homs.total A} bdry-left β' → U)
        (λ a' b' c' d' f1' f2' g' h' τ E .
          J-TYPE {Homs.total A} (b , d , f2)
            (λ t E . (g' : hom (Homs.src t) b') (h' : hom (Homs.tgt t) d') → squares (Homs.src t , b' , Homs.tgt t , d' , Homs.to-hom t , f2' , g' , h') → U)
            (λ g' h' τ . P ((a , b , b' , g , g') , (c , d , d' , f1 , f2 , f2' , h , h')) (σ , τ))
            E g' h' τ)
        β' τ E)
    β σ β' τ E

-- the row given by two homs between arrows
private
row-hom : {A ∷ U} {l r r' : arrᵣ A} → hom l r → hom r r' → row-bdry A
row-hom {A} {l} {r} {r'} u v =
  ((srcᵣ l , srcᵣ r , srcᵣ r' , hom-map srcᵣ u , hom-map srcᵣ v) ,
   (tgtᵣ l , tgtᵣ r , tgtᵣ r' , arr-hom l , arr-hom r , arr-hom r' , hom-map tgtᵣ u , hom-map tgtᵣ v))

-- Induction on rows: it is enough to consider the rows given by 2-simplices of arrows.
row-ind : {A ∷ U} (sA : is-segalᵣ A) (P : (r : row-bdry A) → row-squares r → U) →
  ((Ξ : simplex 2 →ᵣ arrᵣ A) → P (row-of Ξ) (row-sq Ξ)) → (r : row-bdry A) (s : row-squares r) → P r s
row-ind {A} sA P k r s =
  let sA' : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  -- for homs between arrows, by transport along the section of the edges of 2-simplices
  let S : (l r r' : arrᵣ A) → hom l r → hom r r' → U = λ l r r' u v . P (row-hom u v) (of-hom u , of-hom v) in
  let sec : section (edges-2 {arrᵣ A}) = is-equiv-sec (edges-2 {arrᵣ A}) (is-equiv-edges-2 (arrᵣ A) sA') in
  let kh : {l r r' : arrᵣ A} (u : hom l r) (v : hom r r') → P (row-hom u v) (of-hom u , of-hom v) = λ {l} {r} {r'} u v .
    subst (pair-family (arrᵣ A) S) (snd (is-section (edges-2 {arrᵣ A})) sec (l , r , r' , u , v))
      (k (section-map (edges-2 {arrᵣ A}) sec (l , r , r' , u , v))) in
  -- for squares glued along a path, by induction on the squares and on the path
  let kq : {β : boundary A} (σ : squares β) {β' : boundary A} (τ : squares β') (E : bdry-right β ≡ bdry-left β') → row-Q P β σ β' τ E =
    λ σ τ E .
      hom-square-ind (λ β σ . {β' : boundary A} (τ : squares β') (E : bdry-right β ≡ bdry-left β') → row-Q P β σ β' τ E)
        (λ {l} {r} u {β'} τ E .
          hom-square-ind (λ β' τ . (E : bdry-right (hom-bdry u) ≡ bdry-left β') → row-Q P (hom-bdry u) (of-hom u) β' τ E)
            (λ {l'} {r'} v E .
              tot-ind {A} {r} (λ l' E . (v : hom l' r') → row-Q P (hom-bdry u) (of-hom u) (hom-bdry v) (of-hom v) E)
                (λ v . kh u v) {l'} E v)
            τ E)
        σ τ E in
  row-bdry-ind (λ r . (s : row-squares r) → P r s)
    (λ a b e g g' c d f f1 f2 f3 h h' . fun (σ , τ) → kq σ τ refl)
    r s

--
-- Grids
--
-- A grid is a row (the lower one) with a row above it (the upper one), whose bottom sides are the
-- top sides of the lower one. Grids are given by primitive grids (grid-ind): the lower row is given
-- by a 2-simplex of arrows Ξ0 (row-ind). The upper row is generalized along a path Eb between its
-- bottom sides and the top sides of the lower one, and is then given by a 2-simplex of arrows Ξ1
-- (row-ind). Since composable pairs of homs are 2-simplices (edges-2), the path Eb is given by a
-- path between the top of Ξ0 and the bottom of Ξ1 (emb-ind), so that Ξ0 and Ξ1 form an oplax cone
-- over Δ², i.e. a 2-simplex of composable pairs of cells (pullback-oplax-up), which is given by a
-- primitive grid.
--

-- the boundary of a grid
grid-bdry : (A ∷ U) → U
grid-bdry A = Σ (r : row-bdry A) . row-rest A (row-top r)

-- its upper row
grid-upper : {A ∷ U} → grid-bdry A → row-bdry A
grid-upper γ = (row-top (fst _ γ) , snd _ γ)

-- the squares of a grid
grid-squares : {A ∷ U} → grid-bdry A → U
grid-squares γ = row-squares (fst _ γ) × row-squares (grid-upper γ)

-- the grid given by a primitive grid, and its squares
grid-of : {A ∷ U} → (simplex 2 →ᵣ (simplex 2 →ᵣ A)) → grid-bdry A
grid-of {A} Θ = (row-of (λ s . λ j . Θ s (Simplex2.edge₀₁ j)) , snd _ (row-of (λ s . λ j . Θ s (Simplex2.edge₁₂ j))))

grid-sqs : {A ∷ U} (Θ : simplex 2 →ᵣ (simplex 2 →ᵣ A)) → grid-squares (grid-of Θ)
grid-sqs {A} Θ = (row-sq (λ s . λ j . Θ s (Simplex2.edge₀₁ j)) , row-sq (λ s . λ j . Θ s (Simplex2.edge₁₂ j)))

-- the paths between images by an equivalence are images of paths
private
fib-snd-path : {S T : U} (e : S → T) {z : T} {a : S} (E : e a ≡ z) {w : fib e z} (P : (a , E) ≡{fib e z} w) →
  E ≡ trans (cong e (cong {fib e z} {S} (λ w . fst _ w) P)) (snd _ w)
fib-snd-path {S} {T} e {z} {a} E {w} P =
  J {fib e z} (a , E) (λ w P . E ≡ trans (cong e (cong {fib e z} {S} (λ w . fst _ w) P)) (snd _ w)) (sym (trans-refl-l E)) P

private
emb-ind : {S T : U} (e : S → T) (ee : is-equiv e) {a b : S} (R : e a ≡ e b → U) → ((Q : a ≡ b) → R (cong e Q)) → (E : e a ≡ e b) → R E
emb-ind {S} {T} e ee {a} {b} R k E =
  let c : is-contr (fib e (e b)) = is-contr-fib e ee (e b) in
  let P : (a , E) ≡{fib e (e b)} (b , refl) = is-contr-eq c (a , E) (b , refl) in
  subst R (sym (fib-snd-path e E P)) (k (cong {fib e (e b)} {S} (λ w . fst _ w) P))

-- oplax cones over Δ² for tgtᵣ and srcᵣ: a lower and an upper 2-simplex of arrows, glued along a
-- homotopy
private
cone2 : (A ∷ U) → U
cone2 A = pullback-coneᵣ (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ

private
c2-lower : {A ∷ U} → cone2 A → simplex 2 →ᵣ arrᵣ A
c2-lower {A} κ = pullback-coneᵣ-fst (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ

private
c2-upper : {A ∷ U} → cone2 A → simplex 2 →ᵣ arrᵣ A
c2-upper {A} κ = pullback-coneᵣ-snd (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ

-- the path between the top of the lower 2-simplex and the bottom of the upper one
private
c2-path : {A ∷ U} (κ : cone2 A) → postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ (c2-lower κ) ≡ postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ (c2-upper κ)
c2-path {A} κ =
  trans (sym (Product.fst (snd (pullback-coneᵣ-paths (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)))
    (trans (path-eq (Funext.funextᵣ (simplex 2) A (pullback-coneᵣ-htpy (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ)))
      (Product.snd (snd (pullback-coneᵣ-paths (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)))

-- the homotopy of a path between 2-simplices, and its endpoints
private
s2-htpy : {A ∷ U} {f k : simplex 2 →ᵣ A} → f ≡ k → simplex 2 →ᵣ path A
s2-htpy {A} {f} {k} P = Funext.happlyᵣ (simplex 2) A (f , k , P)

private
s2-htpy-src : {A ∷ U} (f : simplex 2 →ᵣ A) {k : simplex 2 →ᵣ A} (P : f ≡ k) → postᵣ {simplex 2} {path A} {A} path-src (s2-htpy P) ≡ f
s2-htpy-src {A} f {k} P = J f (λ k P . postᵣ {simplex 2} {path A} {A} path-src (s2-htpy P) ≡ f) refl P

private
s2-htpy-tgt : {A ∷ U} (f : simplex 2 →ᵣ A) {k : simplex 2 →ᵣ A} (P : f ≡ k) → postᵣ {simplex 2} {path A} {A} path-tgt (s2-htpy P) ≡ k
s2-htpy-tgt {A} f {k} P = J f (λ k P . postᵣ {simplex 2} {path A} {A} path-tgt (s2-htpy P) ≡ k) refl P

-- the cone of two 2-simplices of arrows glued along a path
private
cone2-of : {A ∷ U} (Ξ0 Ξ1 : simplex 2 →ᵣ arrᵣ A) → postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0 ≡ postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ Ξ1 → cone2 A
cone2-of {A} Ξ0 Ξ1 P =
  ((Ξ0 , Ξ1 , s2-htpy P) , s2-htpy-src (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0) P , s2-htpy-tgt (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0) P)

-- the injectivity of a map with a retraction sends refl to refl
private
retraction-inj-refl : {X Y : U} (f : X → Y) (r : retraction f) (x : X) → retraction-inj f r {x} {x} refl ≡ refl
retraction-inj-refl {X} {Y} f (g , η) x = trans (cong (trans (sym (η x))) (trans-refl-l (η x))) (trans-sym-l (η x))

-- the funext path of a constant homotopy is refl
private
funext-cst : {A ∷ U} (f : simplex 2 →ᵣ A) → path-eq (Funext.funextᵣ (simplex 2) A (λ a . (f a , f a , refl))) ≡ refl
funext-cst {A} f =
  let e ∷ is-equiv (postᵣ {simplex 2} (path-src {A})) = postᵣ-equiv (simplex 2) (path-src {A}) (is-equiv-path-src A) in
  cong (cong (postᵣ {simplex 2} (path-tgt {A})))
    (retraction-inj-refl (postᵣ {simplex 2} (path-src {A})) (is-equiv-ret (postᵣ {simplex 2} (path-src {A})) e) (λ a . (f a , f a , refl)))

-- the path of the cone of a path is that path
private
c2-path-of : {A ∷ U} (f : simplex 2 →ᵣ A) {k : simplex 2 →ᵣ A} (P : f ≡ k) →
  trans (sym (s2-htpy-src f P)) (trans (path-eq (Funext.funextᵣ (simplex 2) A (s2-htpy P))) (s2-htpy-tgt f P)) ≡ P
c2-path-of {A} f {k} P =
  J f (λ k P . trans (sym (s2-htpy-src f P)) (trans (path-eq (Funext.funextᵣ (simplex 2) A (s2-htpy P))) (s2-htpy-tgt f P)) ≡ P)
    (cong {f ≡ f} {f ≡ f} (λ q . trans refl q) (funext-cst f)) P

-- cone induction over Δ²: cones are 2-simplices of composable pairs of cells
private
cone2-ind : {A ∷ U} (Q : cone2 A → U) → ((Ψ : simplex 2 →ᵣ cell-pairs A) → Q (pullback→coneᵣ (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)) →
  (κ : cone2 A) → Q κ
cone2-ind {A} Q q κ =
  let f : (simplex 2 →ᵣ cell-pairs A) → cone2 A = pullback→coneᵣ (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  let s : section f = is-equiv-sec f (pullback-oplax-up (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) in
  subst Q (snd _ s κ) (q (section-map f s κ))

-- the composable pair of the first two edges of a 2-simplex, and a filler of a composable pair
private
simplex2-cells : {A ∷ U} → (simplex 2 →ᵣ A) → cell-pairs A
simplex2-cells c = ((λ j . c (Simplex2.edge₀₁ j)) , (λ j . c (Simplex2.edge₁₂ j)) , refl)

private
cells-fill : {A ∷ U} (sA : is-segalᵣ A) → cell-pairs A → simplex 2 →ᵣ A
cells-fill {A} sA c = section-map (edges-2 {A}) (is-equiv-sec (edges-2 {A}) (is-equiv-edges-2 A sA)) (cells→pair c)

private
cells-fill-sec : {A ∷ U} (sA : is-segalᵣ A) (c : cell-pairs A) → simplex2-cells (cells-fill sA c) ≡ c
cells-fill-sec {A} sA c =
  trans (cong (pair→cells {A}) (snd (is-section (edges-2 {A})) (is-equiv-sec (edges-2 {A}) (is-equiv-edges-2 A sA)) (cells→pair c)))
    (snd _ (is-equiv-ret (cells→pair {A}) (is-equiv-cells→pair {A})) c)

-- induction on 2-simplices of composable pairs of cells: they are given by primitive grids
private
cells-ind : {A ∷ U} (sA : is-segalᵣ A) (Q : (simplex 2 →ᵣ cell-pairs A) → U) →
  ((Θ : simplex 2 →ᵣ (simplex 2 →ᵣ A)) → Q (postᵣ simplex2-cells Θ)) → (Ψ : simplex 2 →ᵣ cell-pairs A) → Q Ψ
cells-ind {A} sA Q k Ψ =
  subst Q
    (cong (λ F . postᵣ {simplex 2} {cell-pairs A} {cell-pairs A} F Ψ)
      (funext-htpy {cell-pairs A} {λ _ . cell-pairs A} (λ c . simplex2-cells (cells-fill sA c)) (λ c . c) (cells-fill-sec sA)))
    (k (postᵣ (cells-fill sA) Ψ))

-- the statement for the upper row, generalized along a path between its bottom sides and the top
-- sides of the lower row given by Ξ0
private
upper-Q : {A ∷ U} (P : (γ : grid-bdry A) → grid-squares γ → U) (Ξ0 : simplex 2 →ᵣ arrᵣ A)
  (w : pairs A) → row-top (row-of Ξ0) ≡ w → (rest : row-rest A w) → row-squares (w , rest) → U
upper-Q {A} P Ξ0 w Eb rest s =
  J-TYPE (row-top (row-of Ξ0)) (λ w _ . (rest : row-rest A w) → row-squares (w , rest) → U)
    (λ rest s . P (row-of Ξ0 , rest) (row-sq Ξ0 , s)) Eb rest s

-- the same for the upper row given by Ξ1, glued along a path between the top of Ξ0 and the bottom of Ξ1
private
upper-S : {A ∷ U} (P : (γ : grid-bdry A) → grid-squares γ → U) (Ξ0 Ξ1 : simplex 2 →ᵣ arrᵣ A) →
  postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0 ≡ postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ Ξ1 → U
upper-S {A} P Ξ0 Ξ1 Q = upper-Q P Ξ0 (fst _ (row-of Ξ1)) (cong (edges-2 {A}) Q) (snd _ (row-of Ξ1)) (row-sq Ξ1)

-- Induction on grids: it is enough to consider the grids given by primitive grids.
grid-ind : {A ∷ U} (sA : is-segalᵣ A) (P : (γ : grid-bdry A) → grid-squares γ → U) →
  ((Θ : simplex 2 →ᵣ (simplex 2 →ᵣ A)) → P (grid-of Θ) (grid-sqs Θ)) → (γ : grid-bdry A) (s : grid-squares γ) → P γ s
grid-ind {A} sA P k (r0 , r1) (s0 , s1) =
  let pc : (simplex 2 →ᵣ cell-pairs A) → cone2 A = pullback→coneᵣ (simplex 2) {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  -- for the cones, by cone induction: they are given by primitive grids, glued along refl
  let kc : (κ : cone2 A) → upper-S P (c2-lower κ) (c2-upper κ) (c2-path κ) =
    cone2-ind (λ κ . upper-S P (c2-lower κ) (c2-upper κ) (c2-path κ))
      (cells-ind sA (λ Ψ . upper-S P (c2-lower (pc Ψ)) (c2-upper (pc Ψ)) (c2-path (pc Ψ)))
        (λ Θ . subst (upper-S P (λ s . λ j . Θ s (Simplex2.edge₀₁ j)) (λ s . λ j . Θ s (Simplex2.edge₁₂ j)))
                 (sym (cong {_ ≡ _} {_ ≡ _} (λ q . trans refl q) (funext-cst (λ s . Θ s (Simplex2.edge₀₁ 𝕀1)))))
                 (k Θ))) in
  -- for two 2-simplices of arrows glued along a path, they form a cone
  let kS : (Ξ0 Ξ1 : simplex 2 →ᵣ arrᵣ A) (Q : postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0 ≡ postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ Ξ1) → upper-S P Ξ0 Ξ1 Q =
    λ Ξ0 Ξ1 Q . subst (upper-S P Ξ0 Ξ1) (c2-path-of (postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0) Q) (kc (cone2-of Ξ0 Ξ1 Q)) in
  -- for the upper row, by row induction, the path between the composable pairs being the image of
  -- a path between 2-simplices
  let ku : (Ξ0 : simplex 2 →ᵣ arrᵣ A) (r : row-bdry A) (s : row-squares r) (Eb : row-top (row-of Ξ0) ≡ fst _ r) → upper-Q P Ξ0 (fst _ r) Eb (snd _ r) s =
    λ Ξ0 . row-ind sA (λ r s . (Eb : row-top (row-of Ξ0) ≡ fst _ r) → upper-Q P Ξ0 (fst _ r) Eb (snd _ r) s)
      (λ Ξ1 Eb . emb-ind (edges-2 {A}) (is-equiv-edges-2 A sA) {postᵣ {simplex 2} {arrᵣ A} {A} tgtᵣ Ξ0} {postᵣ {simplex 2} {arrᵣ A} {A} srcᵣ Ξ1}
                   (λ Eb . upper-Q P Ξ0 (fst _ (row-of Ξ1)) Eb (snd _ (row-of Ξ1)) (row-sq Ξ1)) (λ Q . kS Ξ0 Ξ1 Q) Eb) in
  -- for the lower row, by row induction
  row-ind sA (λ r0 s0 . (r1 : row-rest A (row-top r0)) (s1 : row-squares (row-top r0 , r1)) → P (r0 , r1) (s0 , s1))
    (λ Ξ0 r1 s1 . ku Ξ0 (row-top (row-of Ξ0) , r1) s1 refl)
    r0 s0 r1 s1

--
-- The exchange law
--

-- the statement of the exchange law for a grid
private
exchange-stmt : {A ∷ U} (sA : is-segalᵣ A) (γ : grid-bdry A) → grid-squares γ → U
exchange-stmt {A} sA γ s =
  comp-v sA (comp-h sA (Product.fst (Product.fst s)) (Product.snd (Product.fst s))) (comp-h sA (Product.fst (Product.snd s)) (Product.snd (Product.snd s)))
  ≡ comp-h sA (comp-v sA (Product.fst (Product.fst s)) (Product.fst (Product.snd s))) (comp-v sA (Product.snd (Product.fst s)) (Product.snd (Product.snd s)))

-- The exchange law: for a 2×2 grid of squares, composing its rows and then the composites, or its
-- columns and then the composites, gives the same square.
exchange : {A ∷ U} (sA : is-segalᵣ A) {a b e c d f c' d' f' : A}
  {f1 : hom a c} {f2 : hom b d} {f3 : hom e f} {f1' : hom c c'} {f2' : hom d d'} {f3' : hom f f'}
  {g : hom a b} {g' : hom b e} {h : hom c d} {h' : hom d f} {k : hom c' d'} {k' : hom d' f'}
  (σ00 : square f1 f2 g h) (σ10 : square f2 f3 g' h') (σ01 : square f1' f2' h k) (σ11 : square f2' f3' h' k') →
  comp-v sA (comp-h sA σ00 σ10) (comp-h sA σ01 σ11) ≡ comp-h sA (comp-v sA σ00 σ01) (comp-v sA σ10 σ11)
exchange {A} sA {a} {b} {e} {c} {d} {f} {c'} {d'} {f'} {f1} {f2} {f3} {f1'} {f2'} {f3'} {g} {g'} {h} {h'} {k} {k'} σ00 σ10 σ01 σ11 =
  grid-ind sA (exchange-stmt sA) (exchange-grid sA)
    (((a , b , e , g , g') , (c , d , f , f1 , f2 , f3 , h , h')) , (c' , d' , f' , f1' , f2' , f3' , k , k'))
    ((σ00 , σ10) , (σ01 , σ11))
