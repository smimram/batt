open import Stdlib
open import Hom
open import Segal
open import Composition
open import Functoriality
open import Simplex-edges
open import Unitality
open import PathOver
open import Pullback-up

--
-- Squares
--

open Square

--
-- Moving the endpoints of homs
--

-- a hom with its endpoints moved along paths
private
hom-move : {X ∷ U} {a b : X} (u : hom a b) {a' b' : X} → a ≡ a' → b ≡ b' → hom a' b'
hom-move u p q = (hom-cell u , trans (hom-src u) p , trans (hom-tgt u) q)

-- composition commutes with moving endpoints
private
hom-move-comp : {X ∷ U} (s : is-segalᵣ X) {a b c : X} (u : hom a b) (v : hom b c)
  {a' : X} (p : a ≡ a') {b' : X} (r : b ≡ b') {c' : X} (q : c ≡ c') →
  hom-move (comp-homᵣ s u v) p q ≡ comp-homᵣ s (hom-move u p r) (hom-move v r q)
hom-move-comp {X} s {a} {b} {c} u v refl refl refl =
  trans (hom-eta {X} {a} {c} (comp-homᵣ s u v))
    (sym (cong2 (comp-homᵣ s) (hom-eta {X} {a} {b} u) (hom-eta {X} {b} {c} v)))

-- an arrow as a hom between its endpoints
arr-hom : {A ∷ U} (f : arrᵣ A) → hom (srcᵣ f) (tgtᵣ f)
arr-hom f = (f , refl , refl)

-- paths between the endpoint paths give a path of homs
private
hom-path : {A ∷ U} (t : arrᵣ A) {a b : A} {p p' : srcᵣ t ≡ a} {q q' : tgtᵣ t ≡ b} →
  p ≡ p' → q ≡ q' → (t , p , q) ≡{hom a b} (t , p' , q')
hom-path {A} t {a} {b} P Q = cong2 {srcᵣ t ≡ a} {tgtᵣ t ≡ b} {hom a b} (λ p0 p1 . (t , p0 , p1)) P Q

-- a path of arrows gives a path of homs
private
arr-hom-move : {A ∷ U} (t : arrᵣ A) {k : arrᵣ A} (p : t ≡ k) {a c : A} (q0 : srcᵣ k ≡ a) (q1 : tgtᵣ k ≡ c) →
  (t , trans (cong srcᵣ p) q0 , trans (cong tgtᵣ p) q1) ≡{hom a c} (k , q0 , q1)
arr-hom-move {A} t refl q0 q1 = hom-path t (trans-refl-l q0) (trans-refl-l q1)

-- the endpoint paths of homs related by a path
private
hom-path-src : {A ∷ U} {a b : A} {u v : hom a b} (E : u ≡ v) →
  trans (cong srcᵣ (cong (hom-cell {A}) E)) (hom-src v) ≡ hom-src u
hom-path-src {A} {a} {b} {u} refl = trans-refl-l (hom-src u)

private
hom-path-tgt : {A ∷ U} {a b : A} {u v : hom a b} (E : u ≡ v) →
  trans (cong tgtᵣ (cong (hom-cell {A}) E)) (hom-tgt v) ≡ hom-tgt u
hom-path-tgt {A} {a} {b} {u} refl = trans-refl-l (hom-tgt u)

-- postcomposing with homotopic maps gives the same hom
private
post-htpy-hom : {S A ∷ U} (F G : S → A) (h : (s : S) → F s ≡ G s) (Φ : 𝕀 →ᵣ S) →
  (postᵣ F Φ , h (Φ 𝕀0) , h (Φ 𝕀1)) ≡{hom (G (Φ 𝕀0)) (G (Φ 𝕀1))} arr-hom (postᵣ G Φ)
post-htpy-hom {S} {A} F G h Φ =
  -- by contractibility of the maps t from S to the singletons at F
  let T : U = (s : S) → Σ (y : A) . F s ≡ y in
  let Q : T → U = λ t . (postᵣ F Φ , snd _ (t (Φ 𝕀0)) , snd _ (t (Φ 𝕀1))) ≡{hom (fst _ (t (Φ 𝕀0))) (fst _ (t (Φ 𝕀1)))} arr-hom (postᵣ (λ s . fst _ (t s)) Φ) in
  let t0 : T = λ s . (F s , refl) in
  let t : T = λ s . (G s , h s) in
  let c : is-contr T = is-contr-Π (λ s . Σ (y : A) . F s ≡ y) (λ s . is-contr-sing (F s)) in
  J t0 (λ t' _ . Q t') refl (is-contr-eq c t0 t)

--
-- Squares with given sides
--

-- the sides of a square, as homs between its corners
left-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-leftᵣ x) (top-leftᵣ x)
left-hom x = (leftᵣ x , refl , refl)

right-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-rightᵣ x) (top-rightᵣ x)
right-hom x = (rightᵣ x , refl , refl)

bottom-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-leftᵣ x) (bottom-rightᵣ x)
bottom-hom x = (bottomᵣ x , refl , refl)

top-hom : {A ∷ U} (x : squareᵣ A) → hom (top-leftᵣ x) (top-rightᵣ x)
top-hom x = (topᵣ x , refl , refl)

-- The oplax square x has left, right, bottom and top sides f1, f2, g and h: its corners are
-- identified with the given ones, and its sides with the given homs (along those identifications).
square-at : {A ∷ U} (x : squareᵣ A) {a b c d : A} (f1 : hom a c) (f2 : hom b d) (g : hom a b) (h : hom c d) → U
square-at {A} x {a} {b} {c} {d} f1 f2 g h =
  Σ (pa : bottom-leftᵣ x ≡ a) . Σ (pb : bottom-rightᵣ x ≡ b) .
  Σ (pc : top-leftᵣ x ≡ c) . Σ (pd : top-rightᵣ x ≡ d) .
    ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
    ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)

-- The oplax squares with given left, right, bottom and top sides.
square : {A ∷ U} {a b c d : A} (f1 : hom a c) (f2 : hom b d) (g : hom a b) (h : hom c d) → U
square {A} f1 f2 g h = Σ (x : squareᵣ A) . square-at x f1 f2 g h

-- the components of a square with given sides
sq-pa : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → bottom-leftᵣ x ≡ a
sq-pa σ = fst _ σ

sq-pb : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → bottom-rightᵣ x ≡ b
sq-pb σ = fst _ (snd _ σ)

sq-pc : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → top-leftᵣ x ≡ c
sq-pc σ = fst _ (snd _ (snd _ σ))

sq-pd : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → top-rightᵣ x ≡ d
sq-pd σ = fst _ (snd _ (snd _ (snd _ σ)))

sq-left : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (leftᵣ x , sq-pa σ , sq-pc σ) ≡{hom a c} f1
sq-left σ = Product.fst (snd _ (snd _ (snd _ (snd _ σ))))

sq-right : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (rightᵣ x , sq-pb σ , sq-pd σ) ≡{hom b d} f2
sq-right σ = Product.fst (Product.snd (snd _ (snd _ (snd _ (snd _ σ)))))

sq-bottom : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (bottomᵣ x , sq-pa σ , sq-pb σ) ≡{hom a b} g
sq-bottom σ = Product.fst (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ σ))))))

sq-top : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (topᵣ x , sq-pc σ , sq-pd σ) ≡{hom c d} h
sq-top σ = Product.snd (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ σ))))))

-- A hom l r in arrᵣ A (between vertical sides) is an oplax square from l to r: its bottom and
-- top sides are the images of the hom by srcᵣ and tgtᵣ.
of-hom : {A ∷ U} {l r : arrᵣ A} (u : hom l r) → square (arr-hom l) (arr-hom r) (hom-map srcᵣ u) (hom-map tgtᵣ u)
of-hom {A} {l} {r} u =
  (of-arrᵣ (hom-cell u) ,
   cong srcᵣ (hom-src u) , cong srcᵣ (hom-tgt u) , cong tgtᵣ (hom-src u) , cong tgtᵣ (hom-tgt u) ,
   arr-hom-move (srcᵣ (hom-cell u)) (hom-src u) refl refl ,
   arr-hom-move (tgtᵣ (hom-cell u)) (hom-tgt u) refl refl ,
   refl , refl)

-- Horizontal composition of squares: the composite of the squares as homs in arrᵣ A (along the
-- path between their common sides), whose bottom and top are the composites of the bottoms and tops.
comp-h : {A ∷ U} (sA : is-segalᵣ A) {a b e c d f : A}
  {f1 : hom a c} {f2 : hom b d} {f3 : hom e f} {g : hom a b} {g' : hom b e} {h : hom c d} {h' : hom d f} →
  square f1 f2 g h → square f2 f3 g' h' → square f1 f3 (comp-homᵣ sA g g') (comp-homᵣ sA h h')
comp-h {A} sA {a} {b} {e} {c} {d} {f} {f1} {f2} {f3} {g} {g'} {h} {h'} σ τ =
  let x : squareᵣ A = fst _ σ in
  let y : squareᵣ A = fst _ τ in
  let σ' : square-at x f1 f2 g h = snd _ σ in
  let τ' : square-at y f2 f3 g' h' = snd _ τ in
  let pa : bottom-leftᵣ x ≡ a = sq-pa σ' in
  let pb : bottom-rightᵣ x ≡ b = sq-pb σ' in
  let pc : top-leftᵣ x ≡ c = sq-pc σ' in
  let pd : top-rightᵣ x ≡ d = sq-pd σ' in
  let qb : bottom-leftᵣ y ≡ b = sq-pa τ' in
  let qe : bottom-rightᵣ y ≡ e = sq-pb τ' in
  let qd : top-leftᵣ y ≡ d = sq-pc τ' in
  let qf : top-rightᵣ y ≡ f = sq-pd τ' in
  let E : (rightᵣ x , pb , pd) ≡{hom b d} (leftᵣ y , qb , qd) = trans (sq-right σ') (sym (sq-left τ')) in
  let p : rightᵣ x ≡ leftᵣ y = cong (hom-cell {A}) E in
  let sA' : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  let u : hom (leftᵣ x) (leftᵣ y) = (to-arrᵣ x , refl , p) in
  let v : hom (leftᵣ y) (rightᵣ y) = (to-arrᵣ y , refl , refl) in
  let w : hom (leftᵣ x) (rightᵣ y) = comp-homᵣ sA' u v in
  -- the bottom and top sides of the two squares
  let gu : hom-move (hom-map srcᵣ u) pa qb ≡ g =
    trans (hom-path (bottomᵣ x) (trans-refl-l pa) (hom-path-src E)) (sq-bottom σ') in
  let gv : hom-move (hom-map srcᵣ v) qb qe ≡ g' =
    trans (hom-path (bottomᵣ y) (trans-refl-l qb) (trans-refl-l qe)) (sq-bottom τ') in
  let hu : hom-move (hom-map tgtᵣ u) pc qd ≡ h =
    trans (hom-path (topᵣ x) (trans-refl-l pc) (hom-path-tgt E)) (sq-top σ') in
  let hv : hom-move (hom-map tgtᵣ v) qd qf ≡ h' =
    trans (hom-path (topᵣ y) (trans-refl-l qd) (trans-refl-l qf)) (sq-top τ') in
  (of-arrᵣ (hom-cell w) ,
   trans (cong srcᵣ (hom-src w)) pa , trans (cong srcᵣ (hom-tgt w)) qe ,
   trans (cong tgtᵣ (hom-src w)) pc , trans (cong tgtᵣ (hom-tgt w)) qf ,
   trans (arr-hom-move (srcᵣ (hom-cell w)) (hom-src w) pa pc) (sq-left σ') ,
   trans (arr-hom-move (tgtᵣ (hom-cell w)) (hom-tgt w) qe qf) (sq-right τ') ,
   trans (cong {hom (bottom-leftᵣ x) (bottom-rightᵣ y)} (λ k . hom-move k pa qe) (hom-map-comp (arrᵣ A) A srcᵣ sA' sA u v))
     (trans (hom-move-comp sA (hom-map srcᵣ u) (hom-map srcᵣ v) pa qb qe) (cong2 (comp-homᵣ sA) gu gv)) ,
   trans (cong {hom (top-leftᵣ x) (top-rightᵣ y)} (λ k . hom-move k pc qf) (hom-map-comp (arrᵣ A) A tgtᵣ sA' sA u v))
     (trans (hom-move-comp sA (hom-map tgtᵣ u) (hom-map tgtᵣ v) pc qd qf) (cong2 (comp-homᵣ sA) hu hv)))

--
-- Vertical composition
--
-- Oplax squares only curry with the horizontal variable outside (to-arrᵣ), so vertical
-- composition is pointwise in the horizontal variable: it composes an oplax family
-- Ψ : 𝕀 →ᵣ cell-pairs A of composable pairs. Two squares glued along a path between the top of the
-- lower one and the bottom of the upper one form an oplax cone over tgtᵣ and srcᵣ, and such cones
-- are families of composable pairs by the oplax universal property of pullbacks
-- (pullback-oplax-up). We thus prove the statement for families, where the gluing is
-- judgmental, and extend it to all cones (cone-ind).
--

-- the components of a composable pair of cells
private
cp-fst : {A ∷ U} → cell-pairs A → arrᵣ A
cp-fst c = fst _ c

private
cp-snd : {A ∷ U} → cell-pairs A → arrᵣ A
cp-snd c = fst _ (snd _ c)

private
cp-glue : {A ∷ U} (c : cell-pairs A) → tgtᵣ (cp-fst c) ≡ srcᵣ (cp-snd c)
cp-glue c = snd _ (snd _ c)

-- the composite of a composable pair of cells
private
comp-cells : {A ∷ U} (sA : is-segalᵣ A) (c : cell-pairs A) → hom (srcᵣ (cp-fst c)) (tgtᵣ (cp-snd c))
comp-cells sA c = comp-homᵣ sA (cp-fst c , refl , cp-glue c) (cp-snd c , refl , refl)

-- oplax cones over tgtᵣ and srcᵣ: a lower and an upper square, glued along a homotopy
private
cone : (A ∷ U) → U
cone A = pullback-coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ

private
cone-lower : {A ∷ U} → cone A → squareᵣ A
cone-lower {A} κ = of-arrᵣ (pullback-coneᵣ-fst 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ)

private
cone-upper : {A ∷ U} → cone A → squareᵣ A
cone-upper {A} κ = of-arrᵣ (pullback-coneᵣ-snd 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ)

private
cone-htpy : {A ∷ U} → cone A → 𝕀 →ᵣ path A
cone-htpy {A} κ = pullback-coneᵣ-htpy 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ

private
cone-src : {A ∷ U} (κ : cone A) → postᵣ {𝕀} {path A} {A} path-src (cone-htpy κ) ≡ topᵣ (cone-lower κ)
cone-src {A} κ = Product.fst (snd (pullback-coneᵣ-paths 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)

private
cone-tgt : {A ∷ U} (κ : cone A) → postᵣ {𝕀} {path A} {A} path-tgt (cone-htpy κ) ≡ bottomᵣ (cone-upper κ)
cone-tgt {A} κ = Product.snd (snd (pullback-coneᵣ-paths 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)

-- the gluing path of a cone at a crisp point
private
cone-glue : {A ∷ U} (κ : cone A) (i ∷ 𝕀) → topᵣ (cone-lower κ) i ≡ bottomᵣ (cone-upper κ) i
cone-glue κ i = trans (sym (happlyᵣ (cone-src κ) i)) (trans (path-eq (cone-htpy κ i)) (happlyᵣ (cone-tgt κ) i))

-- cone induction: cones are families of composable pairs
private
cone-ind : {A ∷ U} (Q : cone A → U) → ((Ψ : 𝕀 →ᵣ cell-pairs A) → Q (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)) →
  (κ : cone A) → Q κ
cone-ind {A} Q q κ =
  let f : (𝕀 →ᵣ cell-pairs A) → cone A = pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  let s : section f = is-equiv-sec f (pullback-oplax-up 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) in
  subst Q (snd _ s κ) (q (section-map f s κ))

-- vertical composition for the squares of a cone, whose corners agree with the gluing paths
private
comp-v-stmt : {A ∷ U} (sA : is-segalᵣ A) → cone A → U
comp-v-stmt {A} sA κ =
  {a b c d e f : A} {f1 : hom a c} {f2 : hom b d} {f1' : hom c e} {f2' : hom d f} {g : hom a b} {h : hom c d} {h' : hom e f} →
  (σ : square-at (cone-lower κ) f1 f2 g h) (τ : square-at (cone-upper κ) f1' f2' h h') →
  trans (cone-glue κ 𝕀0) (sq-pa τ) ≡ sq-pc σ → trans (cone-glue κ 𝕀1) (sq-pb τ) ≡ sq-pd σ →
  square (comp-homᵣ sA f1 f1') (comp-homᵣ sA f2 f2') g h'

-- for a family of composable pairs: the pointwise composite
private
comp-v-fam : {A ∷ U} (sA : is-segalᵣ A) (Ψ : 𝕀 →ᵣ cell-pairs A) → comp-v-stmt sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)
comp-v-fam {A} sA Ψ {a} {b} {c} {d} {e} {f} {f1} {f2} {f1'} {f2'} {g} {h} {h'} σ τ gl0 gl1 =
  let x : squareᵣ A = cone-lower (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) in
  let y : squareᵣ A = cone-upper (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) in
  let pa : bottom-leftᵣ x ≡ a = sq-pa σ in
  let pb : bottom-rightᵣ x ≡ b = sq-pb σ in
  let pc : top-leftᵣ x ≡ c = sq-pc σ in
  let pd : top-rightᵣ x ≡ d = sq-pd σ in
  let qc : bottom-leftᵣ y ≡ c = sq-pa τ in
  let qd : bottom-rightᵣ y ≡ d = sq-pb τ in
  let qe : top-leftᵣ y ≡ e = sq-pc τ in
  let qf : top-rightᵣ y ≡ f = sq-pd τ in
  -- the composable pairs on the left and on the right, and their composites
  let u0 : hom (bottom-leftᵣ x) (bottom-leftᵣ y) = (cp-fst (Ψ 𝕀0) , refl , cp-glue (Ψ 𝕀0)) in
  let v0 : hom (bottom-leftᵣ y) (top-leftᵣ y) = (cp-snd (Ψ 𝕀0) , refl , refl) in
  let u1 : hom (bottom-rightᵣ x) (bottom-rightᵣ y) = (cp-fst (Ψ 𝕀1) , refl , cp-glue (Ψ 𝕀1)) in
  let v1 : hom (bottom-rightᵣ y) (top-rightᵣ y) = (cp-snd (Ψ 𝕀1) , refl , refl) in
  let C0 : hom (bottom-leftᵣ x) (top-leftᵣ y) = comp-cells sA (Ψ 𝕀0) in
  let C1 : hom (bottom-rightᵣ x) (top-rightᵣ y) = comp-cells sA (Ψ 𝕀1) in
  -- the gluing conditions, for the judgmental gluing paths of Ψ
  let G0 : trans (cp-glue (Ψ 𝕀0)) qc ≡ pc =
    trans (cong {top-leftᵣ x ≡ bottom-leftᵣ y} (λ p . trans p qc) (sym (trans-refl-l (cp-glue (Ψ 𝕀0))))) gl0 in
  let G1 : trans (cp-glue (Ψ 𝕀1)) qd ≡ pd =
    trans (cong {top-rightᵣ x ≡ bottom-rightᵣ y} (λ p . trans p qd) (sym (trans-refl-l (cp-glue (Ψ 𝕀1))))) gl1 in
  (of-arrᵣ (postᵣ (λ c . hom-cell (comp-cells sA c)) Ψ) ,
   trans (hom-src C0) pa , trans (hom-src C1) pb , trans (hom-tgt C0) qe , trans (hom-tgt C1) qf ,
   trans (hom-move-comp sA u0 v0 pa qc qe)
     (cong2 (comp-homᵣ sA)
       (trans (hom-path (leftᵣ x) (trans-refl-l pa) G0) (sq-left σ))
       (trans (hom-path (leftᵣ y) (trans-refl-l qc) (trans-refl-l qe)) (sq-left τ))) ,
   trans (hom-move-comp sA u1 v1 pb qd qf)
     (cong2 (comp-homᵣ sA)
       (trans (hom-path (rightᵣ x) (trans-refl-l pb) G1) (sq-right σ))
       (trans (hom-path (rightᵣ y) (trans-refl-l qd) (trans-refl-l qf)) (sq-right τ))) ,
   trans (cong {hom (bottom-leftᵣ x) (bottom-rightᵣ x)} (λ k . hom-move k pa pb)
            (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) Ψ))
     (trans (hom-path (bottomᵣ x) (trans-refl-l pa) (trans-refl-l pb)) (sq-bottom σ)) ,
   trans (cong {hom (top-leftᵣ y) (top-rightᵣ y)} (λ k . hom-move k qe qf)
            (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) Ψ))
     (trans (hom-path (topᵣ y) (trans-refl-l qe) (trans-refl-l qf)) (sq-top τ)))

-- for every cone, by cone induction
private
comp-v-cone : {A ∷ U} (sA : is-segalᵣ A) (κ : cone A) → comp-v-stmt sA κ
comp-v-cone {A} sA κ = cone-ind (comp-v-stmt sA) (comp-v-fam sA) κ

-- the homotopy of a path between arrows, and its endpoints
private
arr-htpy : {A ∷ U} {f k : arrᵣ A} → f ≡ k → 𝕀 →ᵣ path A
arr-htpy {A} {f} {k} P = Funext.happlyᵣ 𝕀 A (f , k , P)

private
arr-htpy-src : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) → postᵣ {𝕀} {path A} {A} path-src (arr-htpy P) ≡ f
arr-htpy-src f refl = refl

private
arr-htpy-tgt : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) → postᵣ {𝕀} {path A} {A} path-tgt (arr-htpy P) ≡ k
arr-htpy-tgt f refl = refl

-- the gluing path of the homotopy at a crisp point is the evaluation of the path
private
arr-htpy-glue : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) (i ∷ 𝕀) →
  trans (sym (happlyᵣ (arr-htpy-src f P) i)) (trans (path-eq (arr-htpy P i)) (happlyᵣ (arr-htpy-tgt f P) i)) ≡ happlyᵣ P i
arr-htpy-glue f refl i = refl

-- the cone of two squares glued along a path
private
cone-of : {A ∷ U} (x y : squareᵣ A) → topᵣ x ≡ bottomᵣ y → cone A
cone-of x y P = ((to-arrᵣ x , to-arrᵣ y , arr-htpy P) , arr-htpy-src (topᵣ x) P , arr-htpy-tgt (topᵣ x) P)

-- Vertical composition of squares: the pointwise composite of the composable pairs formed by the
-- two squares, whose left and right sides are the composites of the left and right sides.
comp-v : {A ∷ U} (sA : is-segalᵣ A) {a b c d e f : A}
  {f1 : hom a c} {f2 : hom b d} {f1' : hom c e} {f2' : hom d f} {g : hom a b} {h : hom c d} {h' : hom e f} →
  square f1 f2 g h → square f1' f2' h h' → square (comp-homᵣ sA f1 f1') (comp-homᵣ sA f2 f2') g h'
comp-v {A} sA {a} {b} {c} {d} {e} {f} {f1} {f2} {f1'} {f2'} {g} {h} {h'} σ τ =
  let x : squareᵣ A = fst _ σ in
  let y : squareᵣ A = fst _ τ in
  let σ' : square-at x f1 f2 g h = snd _ σ in
  let τ' : square-at y f1' f2' h h' = snd _ τ in
  let E : (topᵣ x , sq-pc σ' , sq-pd σ') ≡{hom c d} (bottomᵣ y , sq-pa τ' , sq-pb τ') = trans (sq-top σ') (sym (sq-bottom τ')) in
  let P : topᵣ x ≡ bottomᵣ y = cong (hom-cell {A}) E in
  comp-v-cone sA (cone-of x y P) σ' τ'
    (trans (cong {top-leftᵣ x ≡ bottom-leftᵣ y} (λ p . trans p (sq-pa τ')) (arr-htpy-glue (topᵣ x) P 𝕀0)) (hom-path-src E))
    (trans (cong {top-rightᵣ x ≡ bottom-rightᵣ y} (λ p . trans p (sq-pb τ')) (arr-htpy-glue (topᵣ x) P 𝕀1)) (hom-path-tgt E))

--
-- Identity squares
--

-- a constant arrow, with its endpoints moved along the same path, is an identity
private
const-hom : {A ∷ U} {x a : A} (p : x ≡ a) → ((λ t . x) , p , p) ≡{hom a a} Hom.id a
const-hom {A} {x} refl = refl

-- The horizontal identity on f: the square constant in the horizontal direction, whose left and
-- right sides are f and bottom and top sides are identities.
id-h : {A ∷ U} {a c : A} (f : hom a c) → square f f (Hom.id a) (Hom.id c)
id-h {A} {a} {c} f =
  (of-arrᵣ (λ i . hom-cell f) ,
   hom-src f , hom-src f , hom-tgt f , hom-tgt f ,
   hom-eta f , hom-eta f , const-hom (hom-src f) , const-hom (hom-tgt f))

-- The vertical identity on g: the square constant in the vertical direction, whose bottom and
-- top sides are g and left and right sides are identities.
id-v : {A ∷ U} {a b : A} (g : hom a b) → square (Hom.id a) (Hom.id b) g g
id-v {A} {a} {b} g =
  (of-arrᵣ (λ i . λ j . hom-cell g i) ,
   hom-src g , hom-tgt g , hom-src g , hom-tgt g ,
   const-hom (hom-src g) , const-hom (hom-tgt g) , hom-eta g , hom-eta g)

--
-- Unit laws for horizontal composition
--
-- The bottom and top sides of a horizontal composite with an identity are composites with
-- identities, so the composite lies over the original square along the unit laws of composition.
-- The composite is read off a hom w in arrᵣ A (hpack), whose bottom and top sides are the images
-- of w by srcᵣ and tgtᵣ, identified with the composites by the commutation of hom-map with
-- composition. Moving w along the unit law in arrᵣ A, this commutation followed by the unit law
-- in A is the image of the unit law in arrᵣ A (hom-map-lunit, hom-map-runit, Unitality.batt).
--

-- the squares with given left and right sides, as a family over their bottom and top sides
squares-lr : {A ∷ U} {a b c d : A} (f1 : hom a c) (f2 : hom b d) → hom a b × hom c d → U
squares-lr f1 f2 k = square f1 f2 (Product.fst k) (Product.snd k)

-- induction on squares: it is enough to consider squares given by their components
private
square-ind : {A ∷ U} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} (P : square f1 f2 g h → U) →
  ((x : squareᵣ A) (pa : bottom-leftᵣ x ≡ a) (pb : bottom-rightᵣ x ≡ b) (pc : top-leftᵣ x ≡ c) (pd : top-rightᵣ x ≡ d)
   (L : (leftᵣ x , pa , pc) ≡{hom a c} f1) (R : (rightᵣ x , pb , pd) ≡{hom b d} f2)
   (B : (bottomᵣ x , pa , pb) ≡{hom a b} g) (T : (topᵣ x , pc , pd) ≡{hom c d} h) →
   P (x , pa , pb , pc , pd , L , R , B , T)) →
  (σ : square f1 f2 g h) → P σ
square-ind {A} {a} {b} {c} {d} {f1} {f2} {g} {h} P k (x , s) =
  let k1 : (s : square-at x f1 f2 g h) → P (x , s) = fun (pa , s1) →
    let k2 : (s1 : Σ (pb : bottom-rightᵣ x ≡ b) . Σ (pc : top-leftᵣ x ≡ c) . Σ (pd : top-rightᵣ x ≡ d) .
        ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
        ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) → P (x , pa , s1) = fun (pb , s2) →
      let k3 : (s2 : Σ (pc : top-leftᵣ x ≡ c) . Σ (pd : top-rightᵣ x ≡ d) .
          ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
          ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) → P (x , pa , pb , s2) = fun (pc , s3) →
        let k4 : (s3 : Σ (pd : top-rightᵣ x ≡ d) .
            ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
            ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) → P (x , pa , pb , pc , s3) = fun (pd , s4) →
          let k5 : (s4 : ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
              ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) → P (x , pa , pb , pc , pd , s4) = fun (L , s5) →
            let k6 : (s5 : ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
                ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) → P (x , pa , pb , pc , pd , L , s5) = fun (R , s6) →
              let k7 : (s6 : ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)) →
                  P (x , pa , pb , pc , pd , L , R , s6) = fun (B , T) → k x pa pb pc pd L R B T in
              k7 s6 in
            k6 s5 in
          k5 s4 in
        k4 s3 in
      k3 s2 in
    k2 s1 in
  k1 s

-- the hom with its boundary paths, as a hom with refl boundary paths
private
hom-norm : {A ∷ U} {a b : A} → hom a b → hom a b
hom-norm {A} {a} {b} k = hom-move k {a} {b} refl refl

private
hom-move-cong : {A ∷ U} {a b : A} {k k' : hom a b} (p : k ≡ k') →
  cong (hom-norm {A} {a} {b}) p ≡ trans (trans (hom-eta k) p) (sym (hom-eta k'))
hom-move-cong {A} {a} {b} {k} refl = sym (trans-sym-r (hom-eta k))

-- the square read off a hom w in arrᵣ A between the sides of y, as horizontal composition does,
-- with given paths from the images of w to its bottom and top sides
private
hpack : {A ∷ U} (y : squareᵣ A) (w : hom (leftᵣ y) (rightᵣ y))
  {g : hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (β : hom-map srcᵣ w ≡ g)
  {h : hom (top-leftᵣ y) (top-rightᵣ y)} (τ : hom-map tgtᵣ w ≡ h) →
  square (left-hom y) (right-hom y) g h
hpack {A} y w β τ =
  (of-arrᵣ (hom-cell w) ,
   trans (cong srcᵣ (hom-src w)) refl , trans (cong srcᵣ (hom-tgt w)) refl ,
   trans (cong tgtᵣ (hom-src w)) refl , trans (cong tgtᵣ (hom-tgt w)) refl ,
   trans (arr-hom-move (srcᵣ (hom-cell w)) (hom-src w) refl refl) refl ,
   trans (arr-hom-move (tgtᵣ (hom-cell w)) (hom-tgt w) refl refl) refl ,
   β , τ)

-- transporting along paths between its bottom and top sides
private
subst-hpack : {A ∷ U} (y : squareᵣ A) (w : hom (leftᵣ y) (rightᵣ y))
  {g : hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (β : hom-map srcᵣ w ≡ g)
  {h : hom (top-leftᵣ y) (top-rightᵣ y)} (τ : hom-map tgtᵣ w ≡ h)
  {g' : hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (q : g ≡ g') {h' : hom (top-leftᵣ y) (top-rightᵣ y)} (q' : h ≡ h') →
  subst (squares-lr (left-hom y) (right-hom y)) (cong2 pair q q') (hpack y w β τ) ≡ hpack y w (trans β q) (trans τ q')
subst-hpack y w β τ refl refl = refl

-- moving w along a path
private
hpack-path : {A ∷ U} (y : squareᵣ A) {w w' : hom (leftᵣ y) (rightᵣ y)} (e : w ≡ w')
  {g : hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (β : hom-map srcᵣ w ≡ g)
  {h : hom (top-leftᵣ y) (top-rightᵣ y)} (τ : hom-map tgtᵣ w ≡ h) →
  hpack y w β τ ≡ hpack y w' (trans (sym (cong (hom-map {arrᵣ A} {A} (srcᵣ {A}) {leftᵣ y} {rightᵣ y}) e)) β) (trans (sym (cong (hom-map {arrᵣ A} {A} (tgtᵣ {A}) {leftᵣ y} {rightᵣ y}) e)) τ)
hpack-path y {w} refl {g} β {h} τ = cong2 {hom-map srcᵣ w ≡ g} {hom-map tgtᵣ w ≡ h} (λ β' τ' . hpack y w β' τ') (sym (trans-refl-l β)) (sym (trans-refl-l τ))

-- the side of the composite, followed by the unit law, cancels the image of the unit law
private
hpack-coh : {A ∷ U} {a b : A} {W : U} (F : W → hom a b) {w w' : W} (e : w ≡ w') {k : hom a b} (fn : F w ≡ k)
  (l : k ≡ F w') (fn' : F w ≡ k) → fn' ≡ fn → cong F e ≡ trans fn l → trans (sym (cong F e)) (trans fn' l) ≡ refl
hpack-coh {A} {a} {b} {W} F {w} {w'} e {k} fn l fn' M H =
  trans (cong {F w ≡ F w'} {F w' ≡ F w'} (λ r . trans (sym (cong F e)) r) (trans (cong {F w ≡ k} {F w ≡ F w'} (λ r . trans r l) M) (sym H)))
    (trans-sym-l (cong F e))

-- left unit law, for a square given by its components
private
comp-h-lunit-aux : {A ∷ U} (sA : is-segalᵣ A) (x : squareᵣ A) {a : A} (pa : bottom-leftᵣ x ≡ a) {b : A} (pb : bottom-rightᵣ x ≡ b)
  {c : A} (pc : top-leftᵣ x ≡ c) {d : A} (pd : top-rightᵣ x ≡ d)
  {f1 : hom a c} (L : (leftᵣ x , pa , pc) ≡{hom a c} f1) {f2 : hom b d} (R : (rightᵣ x , pb , pd) ≡{hom b d} f2)
  {g : hom a b} (B : (bottomᵣ x , pa , pb) ≡{hom a b} g) {h : hom c d} (T : (topᵣ x , pc , pd) ≡{hom c d} h) →
  path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-lunit A sA g) (comp-homᵣ-lunit A sA h))
    (comp-h sA (id-h f1) (x , pa , pb , pc , pd , L , R , B , T)) (x , pa , pb , pc , pd , L , R , B , T)
comp-h-lunit-aux {A} sA x refl refl refl refl refl refl refl refl =
  let sA' : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  let u : hom (leftᵣ x) (leftᵣ x) = Hom.id (leftᵣ x) in
  let v : hom (leftᵣ x) (rightᵣ x) = (to-arrᵣ x , refl , refl) in
  let e : comp-homᵣ sA' u v ≡ v = comp-homᵣ-lunit (arrᵣ A) sA' v in
  let fs : hom-map srcᵣ (comp-homᵣ sA' u v) ≡ comp-homᵣ sA (hom-map srcᵣ u) (hom-map srcᵣ v) = hom-map-comp (arrᵣ A) A srcᵣ sA' sA u v in
  let ft : hom-map tgtᵣ (comp-homᵣ sA' u v) ≡ comp-homᵣ sA (hom-map tgtᵣ u) (hom-map tgtᵣ v) = hom-map-comp (arrᵣ A) A tgtᵣ sA' sA u v in
  let lg : comp-homᵣ sA (Hom.id (bottom-leftᵣ x)) (bottom-hom x) ≡ bottom-hom x = comp-homᵣ-lunit A sA (bottom-hom x) in
  let lh : comp-homᵣ sA (Hom.id (top-leftᵣ x)) (top-hom x) ≡ top-hom x = comp-homᵣ-lunit A sA (top-hom x) in
  trans (subst-hpack x (comp-homᵣ sA' u v) (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) lg lh)
    (trans (hpack-path x e (trans (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) lg) (trans (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) lh))
      (cong2 {hom-map srcᵣ v ≡ bottom-hom x} {hom-map tgtᵣ v ≡ top-hom x} (λ β τ . hpack x v β τ)
        (hpack-coh (hom-map {arrᵣ A} {A} (srcᵣ {A}) {leftᵣ x} {rightᵣ x}) e fs lg (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) (trans (hom-move-cong fs) (trans-refl-l fs)) (hom-map-lunit (arrᵣ A) A srcᵣ sA' sA v))
        (hpack-coh (hom-map {arrᵣ A} {A} (tgtᵣ {A}) {leftᵣ x} {rightᵣ x}) e ft lh (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) (trans (hom-move-cong ft) (trans-refl-l ft)) (hom-map-lunit (arrᵣ A) A tgtᵣ sA' sA v))))

-- right unit law, for a square given by its components
private
comp-h-runit-aux : {A ∷ U} (sA : is-segalᵣ A) (x : squareᵣ A) {a : A} (pa : bottom-leftᵣ x ≡ a) {b : A} (pb : bottom-rightᵣ x ≡ b)
  {c : A} (pc : top-leftᵣ x ≡ c) {d : A} (pd : top-rightᵣ x ≡ d)
  {f1 : hom a c} (L : (leftᵣ x , pa , pc) ≡{hom a c} f1) {f2 : hom b d} (R : (rightᵣ x , pb , pd) ≡{hom b d} f2)
  {g : hom a b} (B : (bottomᵣ x , pa , pb) ≡{hom a b} g) {h : hom c d} (T : (topᵣ x , pc , pd) ≡{hom c d} h) →
  path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-runit A sA g) (comp-homᵣ-runit A sA h))
    (comp-h sA (x , pa , pb , pc , pd , L , R , B , T) (id-h f2)) (x , pa , pb , pc , pd , L , R , B , T)
comp-h-runit-aux {A} sA x refl refl refl refl refl refl refl refl =
  let sA' : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  let u : hom (leftᵣ x) (rightᵣ x) = (to-arrᵣ x , refl , refl) in
  let v : hom (rightᵣ x) (rightᵣ x) = Hom.id (rightᵣ x) in
  let e : comp-homᵣ sA' u v ≡ u = comp-homᵣ-runit (arrᵣ A) sA' u in
  let fs : hom-map srcᵣ (comp-homᵣ sA' u v) ≡ comp-homᵣ sA (hom-map srcᵣ u) (hom-map srcᵣ v) = hom-map-comp (arrᵣ A) A srcᵣ sA' sA u v in
  let ft : hom-map tgtᵣ (comp-homᵣ sA' u v) ≡ comp-homᵣ sA (hom-map tgtᵣ u) (hom-map tgtᵣ v) = hom-map-comp (arrᵣ A) A tgtᵣ sA' sA u v in
  let lg : comp-homᵣ sA (bottom-hom x) (Hom.id (bottom-rightᵣ x)) ≡ bottom-hom x = comp-homᵣ-runit A sA (bottom-hom x) in
  let lh : comp-homᵣ sA (top-hom x) (Hom.id (top-rightᵣ x)) ≡ top-hom x = comp-homᵣ-runit A sA (top-hom x) in
  trans (subst-hpack x (comp-homᵣ sA' u v) (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) lg lh)
    (trans (hpack-path x e (trans (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) lg) (trans (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) lh))
      (cong2 {hom-map srcᵣ u ≡ bottom-hom x} {hom-map tgtᵣ u ≡ top-hom x} (λ β τ . hpack x u β τ)
        (hpack-coh (hom-map {arrᵣ A} {A} (srcᵣ {A}) {leftᵣ x} {rightᵣ x}) e fs lg (cong (hom-norm {A} {bottom-leftᵣ x} {bottom-rightᵣ x}) fs) (trans (hom-move-cong fs) (trans-refl-l fs)) (hom-map-runit (arrᵣ A) A srcᵣ sA' sA u))
        (hpack-coh (hom-map {arrᵣ A} {A} (tgtᵣ {A}) {leftᵣ x} {rightᵣ x}) e ft lh (cong (hom-norm {A} {top-leftᵣ x} {top-rightᵣ x}) ft) (trans (hom-move-cong ft) (trans-refl-l ft)) (hom-map-runit (arrᵣ A) A tgtᵣ sA' sA u))))

-- Left unit law for horizontal composition: composing with the horizontal identity on the left
-- side gives back the square, over the left unit laws for its bottom and top sides.
comp-h-lunit : {A ∷ U} (sA : is-segalᵣ A) {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d}
  (σ : square f1 f2 g h) →
  path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-lunit A sA g) (comp-homᵣ-lunit A sA h)) (comp-h sA (id-h f1) σ) σ
comp-h-lunit {A} sA {a} {b} {c} {d} {f1} {f2} {g} {h} σ =
  square-ind (λ σ . path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-lunit A sA g) (comp-homᵣ-lunit A sA h)) (comp-h sA (id-h f1) σ) σ)
    (λ x pa pb pc pd L R B T . comp-h-lunit-aux sA x pa pb pc pd L R B T) σ

-- Right unit law for horizontal composition.
comp-h-runit : {A ∷ U} (sA : is-segalᵣ A) {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d}
  (σ : square f1 f2 g h) →
  path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-runit A sA g) (comp-homᵣ-runit A sA h)) (comp-h sA σ (id-h f2)) σ
comp-h-runit {A} sA {a} {b} {c} {d} {f1} {f2} {g} {h} σ =
  square-ind (λ σ . path-over (squares-lr f1 f2) (cong2 pair (comp-homᵣ-runit A sA g) (comp-homᵣ-runit A sA h)) (comp-h sA σ (id-h f2)) σ)
    (λ x pa pb pc pd L R B T . comp-h-runit-aux sA x pa pb pc pd L R B T) σ

--
-- Unit laws for vertical composition
--
-- The cone of a vertical composite with an identity is the one of the family of composable pairs
-- (id , e) (resp. (e , id)) for e running along the other square, so that the composite is
-- computed by comp-v-fam (comp-v-cone-β): it is read off the family of composites of those pairs
-- (vpack). Its left and right sides are the composites of the sides of the square with
-- identities, and moving the family along the pointwise unit laws gives the original square.
--

-- the squares with given bottom and top sides, as a family over their left and right sides
squares-bt : {A ∷ U} {a b c d : A} (g : hom a b) (h : hom c d) → hom a c × hom b d → U
squares-bt g h k = square (Product.fst k) (Product.snd k) g h

-- cone induction computes on families of composable pairs
private
comp-v-cone-β : {A ∷ U} (sA : is-segalᵣ A) (Ψ : 𝕀 →ᵣ cell-pairs A) →
  comp-v-cone sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)
  ≡{comp-v-stmt sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)} comp-v-fam sA Ψ
comp-v-cone-β {A} sA Ψ =
  let f : (𝕀 →ᵣ cell-pairs A) → cone A = pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  let e : is-equiv f = pullback-oplax-up 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  let s : section f = is-equiv-sec f e in
  transfer-equiv f e (comp-v-stmt sA) (comp-v-fam sA) Ψ (section-map f s (f Ψ)) (snd _ s (f Ψ))

-- the same, applied to squares
private
comp-v-cone-β-app : {A ∷ U} (sA : is-segalᵣ A) (Ψ : 𝕀 →ᵣ cell-pairs A) {a b c d e f : A}
  {f1 : hom a c} {f2 : hom b d} {f1' : hom c e} {f2' : hom d f} {g : hom a b} {h : hom c d} {h' : hom e f} →
  (σ : square-at (cone-lower (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)) f1 f2 g h)
  (τ : square-at (cone-upper (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)) f1' f2' h h') →
  (gl0 : trans (cone-glue (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) 𝕀0) (sq-pa τ) ≡ sq-pc σ) →
  (gl1 : trans (cone-glue (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) 𝕀1) (sq-pb τ) ≡ sq-pd σ) →
  comp-v-cone sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) σ τ gl0 gl1 ≡ comp-v-fam sA Ψ σ τ gl0 gl1
comp-v-cone-β-app {A} sA Ψ σ τ gl0 gl1 =
  cong {comp-v-stmt sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)} (λ F . F σ τ gl0 gl1) (comp-v-cone-β sA Ψ)

-- post-htpy-hom for the trivial homotopy
private
post-htpy-hom-refl : {S A ∷ U} (F : S → A) (Φ : 𝕀 →ᵣ S) → post-htpy-hom F F (λ s . refl) Φ ≡ refl
post-htpy-hom-refl {S} {A} F Φ =
  let T : U = (s : S) → Σ (y : A) . F s ≡ y in
  let Q : T → U = λ t . (postᵣ F Φ , snd _ (t (Φ 𝕀0)) , snd _ (t (Φ 𝕀1))) ≡{hom (fst _ (t (Φ 𝕀0))) (fst _ (t (Φ 𝕀1)))} arr-hom (postᵣ (λ s . fst _ (t s)) Φ) in
  let t0 : T = λ s . (F s , refl) in
  let c : is-contr T = is-contr-Π (λ s . Σ (y : A) . F s ≡ y) (λ s . is-contr-sing (F s)) in
  cong {t0 ≡ t0} (λ e . J t0 (λ t' _ . Q t') refl e) (is-contr-eq-refl c t0)

-- post-htpy-hom along a precomposed family
private
post-htpy-hom-pre : {R S A ∷ U} (φ : R → S) (F G : S → A) (h : (s : S) → F s ≡ G s) (Φ : 𝕀 →ᵣ R) →
  post-htpy-hom F G h (postᵣ φ Φ) ≡ post-htpy-hom (λ r . F (φ r)) (λ r . G (φ r)) (λ r . h (φ r)) Φ
post-htpy-hom-pre {R} {S} {A} φ F G h Φ =
  let T : U = (s : S) → Σ (y : A) . F s ≡ y in
  let Q : T → U = λ t .
    post-htpy-hom F (λ s . fst _ (t s)) (λ s . snd _ (t s)) (postᵣ φ Φ) ≡
    post-htpy-hom (λ r . F (φ r)) (λ r . fst _ (t (φ r))) (λ r . snd _ (t (φ r))) Φ in
  let t0 : T = λ s . (F s , refl) in
  let t : T = λ s . (G s , h s) in
  let c : is-contr T = is-contr-Π (λ s . Σ (y : A) . F s ≡ y) (λ s . is-contr-sing (F s)) in
  J t0 (λ t' _ . Q t') (trans (post-htpy-hom-refl F (postᵣ φ Φ)) (sym (post-htpy-hom-refl (λ r . F (φ r)) Φ)))
    (is-contr-eq c t0 t)

-- the square read off a family E of homs along the arrows of y, as vertical composition does,
-- given paths identifying its sides
private
vpack-at : {A ∷ U} (y : squareᵣ A) (E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e))
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (E (leftᵣ y)) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (E (rightᵣ y)) ≡ f2) →
  (postᵣ (λ e . hom-cell (E e) 𝕀0) (to-arrᵣ y) , hom-src (E (leftᵣ y)) , hom-src (E (rightᵣ y))) ≡{hom (bottom-leftᵣ y) (bottom-rightᵣ y)} bottom-hom y →
  (postᵣ (λ e . hom-cell (E e) 𝕀1) (to-arrᵣ y) , hom-tgt (E (leftᵣ y)) , hom-tgt (E (rightᵣ y))) ≡{hom (top-leftᵣ y) (top-rightᵣ y)} top-hom y →
  square f1 f2 (bottom-hom y) (top-hom y)
vpack-at {A} y E L R PB PT =
  (of-arrᵣ (postᵣ (λ e . hom-cell (E e)) (to-arrᵣ y)) ,
   trans (hom-src (E (leftᵣ y))) refl , trans (hom-src (E (rightᵣ y))) refl ,
   trans (hom-tgt (E (leftᵣ y))) refl , trans (hom-tgt (E (rightᵣ y))) refl ,
   L , R ,
   trans (cong {hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (λ k . hom-move k refl refl) PB)
     (trans (hom-path (bottomᵣ y) (trans-refl-l refl) (trans-refl-l refl)) refl) ,
   trans (cong {hom (top-leftᵣ y) (top-rightᵣ y)} (λ k . hom-move k refl refl) PT)
     (trans (hom-path (topᵣ y) (trans-refl-l refl) (trans-refl-l refl)) refl))

-- with the paths given by the homotopies hom-src and hom-tgt
private
vpack : {A ∷ U} (y : squareᵣ A) (E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e))
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (E (leftᵣ y)) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (E (rightᵣ y)) ≡ f2) →
  square f1 f2 (bottom-hom y) (top-hom y)
vpack {A} y E L R =
  vpack-at y E L R
    (post-htpy-hom (λ e . hom-cell (E e) 𝕀0) (λ e . srcᵣ e) (λ e . hom-src (E e)) (to-arrᵣ y))
    (post-htpy-hom (λ e . hom-cell (E e) 𝕀1) (λ e . tgtᵣ e) (λ e . hom-tgt (E e)) (to-arrᵣ y))

-- transporting along paths between its left and right sides
private
subst-vpack-at : {A ∷ U} (y : squareᵣ A) (E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e))
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (E (leftᵣ y)) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (E (rightᵣ y)) ≡ f2)
  (PB : (postᵣ (λ e . hom-cell (E e) 𝕀0) (to-arrᵣ y) , hom-src (E (leftᵣ y)) , hom-src (E (rightᵣ y))) ≡{hom (bottom-leftᵣ y) (bottom-rightᵣ y)} bottom-hom y)
  (PT : (postᵣ (λ e . hom-cell (E e) 𝕀1) (to-arrᵣ y) , hom-tgt (E (leftᵣ y)) , hom-tgt (E (rightᵣ y))) ≡{hom (top-leftᵣ y) (top-rightᵣ y)} top-hom y)
  {f1' : hom (bottom-leftᵣ y) (top-leftᵣ y)} (q : f1 ≡ f1') {f2' : hom (bottom-rightᵣ y) (top-rightᵣ y)} (q' : f2 ≡ f2') →
  subst (squares-bt (bottom-hom y) (top-hom y)) (cong2 pair q q') (vpack-at y E L R PB PT) ≡ vpack-at y E (trans L q) (trans R q') PB PT
subst-vpack-at y E L R PB PT refl refl = refl

-- moving the family along a path
private
vpack-path : {A ∷ U} (y : squareᵣ A) {E E' : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e)} (F : E ≡ E')
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (E (leftᵣ y)) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (E (rightᵣ y)) ≡ f2) →
  vpack y E L R ≡ vpack y E' (trans (sym (cong (hom-norm {A} {bottom-leftᵣ y} {top-leftᵣ y}) (happly {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} F (leftᵣ y)))) L) (trans (sym (cong (hom-norm {A} {bottom-rightᵣ y} {top-rightᵣ y}) (happly {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} F (rightᵣ y)))) R)
vpack-path {A} y {E} refl {f1} L {f2} R =
  cong2 {hom-norm (E (leftᵣ y)) ≡ f1} {hom-norm (E (rightᵣ y)) ≡ f2} (λ L' R' . vpack y E L' R')
    (sym (trans-refl-l L)) (sym (trans-refl-l R))

-- for the trivial family, it is y
private
vpack-arr-hom : {A ∷ U} (y : squareᵣ A) →
  vpack y (λ e . arr-hom e) refl refl ≡ (y , refl , refl , refl , refl , refl , refl , refl , refl)
vpack-arr-hom {A} y =
  cong2 (vpack-at y (λ e . arr-hom e) refl refl) (post-htpy-hom-refl {arrᵣ A} {A} (λ e . srcᵣ e) (to-arrᵣ y))
    (post-htpy-hom-refl {arrᵣ A} {A} (λ e . tgtᵣ e) (to-arrᵣ y))

-- the composable pairs (id , e) and (e , id)
private
id-pair : {A ∷ U} → arrᵣ A → cell-pairs A
id-pair {A} e = ((λ j . srcᵣ {A} e) , e , refl)

private
pair-id : {A ∷ U} → arrᵣ A → cell-pairs A
pair-id {A} e = (e , (λ j . tgtᵣ {A} e) , refl)

-- the bottom and top paths of the composite, read along the arrows of the square
private
vpack-pre-l : {A ∷ U} (sA : is-segalᵣ A) (y : squareᵣ A)
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (comp-cells sA (id-pair (leftᵣ y))) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (comp-cells sA (id-pair (rightᵣ y))) ≡ f2) →
  vpack-at y (λ e . comp-cells sA (id-pair e)) L R
    (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) (postᵣ id-pair (to-arrᵣ y)))
    (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) (postᵣ id-pair (to-arrᵣ y)))
  ≡ vpack y (λ e . comp-cells sA (id-pair e)) L R
vpack-pre-l {A} sA y L R =
  cong2 {_ ≡ _} {_ ≡ _} (λ PB PT . vpack-at y (λ e . comp-cells sA (id-pair e)) L R PB PT)
    (post-htpy-hom-pre id-pair (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) (to-arrᵣ y))
    (post-htpy-hom-pre id-pair (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) (to-arrᵣ y))

private
vpack-pre-r : {A ∷ U} (sA : is-segalᵣ A) (y : squareᵣ A)
  {f1 : hom (bottom-leftᵣ y) (top-leftᵣ y)} (L : hom-norm (comp-cells sA (pair-id (leftᵣ y))) ≡ f1)
  {f2 : hom (bottom-rightᵣ y) (top-rightᵣ y)} (R : hom-norm (comp-cells sA (pair-id (rightᵣ y))) ≡ f2) →
  vpack-at y (λ e . comp-cells sA (pair-id e)) L R
    (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) (postᵣ pair-id (to-arrᵣ y)))
    (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) (postᵣ pair-id (to-arrᵣ y)))
  ≡ vpack y (λ e . comp-cells sA (pair-id e)) L R
vpack-pre-r {A} sA y L R =
  cong2 {_ ≡ _} {_ ≡ _} (λ PB PT . vpack-at y (λ e . comp-cells sA (pair-id e)) L R PB PT)
    (post-htpy-hom-pre pair-id (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) (to-arrᵣ y))
    (post-htpy-hom-pre pair-id (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) (to-arrᵣ y))

-- a path composed with the inverse of an equal one
private
trans-sym-path : {T : U} {s t : T} {p q : s ≡ t} → p ≡ q → trans (sym p) q ≡ refl
trans-sym-path {T} {s} {t} {p} refl = trans-sym-l p

-- the image of a pointwise path under hom-norm
private
hom-norm-happly : {A ∷ U} {E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e)} (H : (e : arrᵣ A) → E e ≡ arr-hom e) (e : arrᵣ A) →
  cong (hom-norm {A} {srcᵣ e} {tgtᵣ e}) (happly (funext-htpy {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} E (λ e . arr-hom e) H) e) ≡ trans (hom-eta (E e)) (H e)
hom-norm-happly {A} {E} H e =
  trans (hom-move-cong (happly (funext-htpy {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} E (λ e . arr-hom e) H) e))
    (cong {E e ≡ arr-hom e} {hom-norm (E e) ≡ arr-hom e} (λ γ . trans (hom-eta (E e)) γ)
      (happly (happly-funext-htpy {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} E (λ e . arr-hom e) H) e))

-- left unit law, for a square given by its components
private
comp-v-lunit-aux : {A ∷ U} (sA : is-segalᵣ A) (y : squareᵣ A) {a : A} (pa : bottom-leftᵣ y ≡ a) {b : A} (pb : bottom-rightᵣ y ≡ b)
  {c : A} (pc : top-leftᵣ y ≡ c) {d : A} (pd : top-rightᵣ y ≡ d)
  {f1 : hom a c} (L : (leftᵣ y , pa , pc) ≡{hom a c} f1) {f2 : hom b d} (R : (rightᵣ y , pb , pd) ≡{hom b d} f2)
  {g : hom a b} (B : (bottomᵣ y , pa , pb) ≡{hom a b} g) {h : hom c d} (T : (topᵣ y , pc , pd) ≡{hom c d} h) →
  path-over (squares-bt g h) (cong2 pair (comp-homᵣ-lunit A sA f1) (comp-homᵣ-lunit A sA f2))
    (comp-v sA (id-v g) (y , pa , pb , pc , pd , L , R , B , T)) (y , pa , pb , pc , pd , L , R , B , T)
comp-v-lunit-aux {A} sA y refl refl refl refl refl refl refl refl =
  let Ψ : 𝕀 →ᵣ cell-pairs A = postᵣ id-pair (to-arrᵣ y) in
  let E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e) = λ e . comp-cells sA (id-pair e) in
  let H : (e : arrᵣ A) → E e ≡ arr-hom e = λ e . comp-homᵣ-lunit A sA (arr-hom e) in
  let F : E ≡ (λ e . arr-hom e) = funext-htpy {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} E (λ e . arr-hom e) H in
  -- the arguments of comp-v-cone in comp-v
  let x : squareᵣ A = fst _ (id-v (bottom-hom y)) in
  let σ' : square-at x (Hom.id (bottom-leftᵣ y)) (Hom.id (bottom-rightᵣ y)) (bottom-hom y) (bottom-hom y) = snd _ (id-v (bottom-hom y)) in
  let τ' : square-at y (left-hom y) (right-hom y) (bottom-hom y) (top-hom y) = (refl , refl , refl , refl , refl , refl , refl , refl) in
  let Eh : (topᵣ x , sq-pc σ' , sq-pd σ') ≡{hom (bottom-leftᵣ y) (bottom-rightᵣ y)} (bottomᵣ y , sq-pa τ' , sq-pb τ') = trans (sq-top σ') (sym (sq-bottom τ')) in
  let P : topᵣ x ≡ bottomᵣ y = cong (hom-cell {A}) Eh in
  let gl0 : trans (cone-glue (cone-of x y P) 𝕀0) (sq-pa τ') ≡ sq-pc σ' =
    trans (cong {top-leftᵣ x ≡ bottom-leftᵣ y} (λ p . trans p (sq-pa τ')) (arr-htpy-glue (topᵣ x) P 𝕀0)) (hom-path-src Eh) in
  let gl1 : trans (cone-glue (cone-of x y P) 𝕀1) (sq-pb τ') ≡ sq-pd σ' =
    trans (cong {top-rightᵣ x ≡ bottom-rightᵣ y} (λ p . trans p (sq-pb τ')) (arr-htpy-glue (topᵣ x) P 𝕀1)) (hom-path-tgt Eh) in
  let l1 : E (leftᵣ y) ≡ left-hom y = H (leftᵣ y) in
  let l2 : E (rightᵣ y) ≡ right-hom y = H (rightᵣ y) in
  let Q : U = square (E (leftᵣ y)) (E (rightᵣ y)) (bottom-hom y) (top-hom y) in
  trans (cong {Q} (subst (squares-bt (bottom-hom y) (top-hom y)) (cong2 pair l1 l2)) (comp-v-cone-β-app sA Ψ σ' τ' gl0 gl1))
    (trans (cong {Q} (subst (squares-bt (bottom-hom y) (top-hom y)) (cong2 pair l1 l2)) (vpack-pre-l sA y refl refl))
      (trans (subst-vpack-at y E refl refl _ _ l1 l2)
        (trans (vpack-path y F (trans refl l1) (trans refl l2))
          (trans (cong2 {hom-norm (arr-hom (leftᵣ y)) ≡ left-hom y} {hom-norm (arr-hom (rightᵣ y)) ≡ right-hom y}
                    (λ L' R' . vpack y (λ e . arr-hom e) L' R')
                    (trans-sym-path (hom-norm-happly H (leftᵣ y)))
                    (trans-sym-path (hom-norm-happly H (rightᵣ y))))
            (vpack-arr-hom y)))))

-- right unit law, for a square given by its components
private
comp-v-runit-aux : {A ∷ U} (sA : is-segalᵣ A) (y : squareᵣ A) {a : A} (pa : bottom-leftᵣ y ≡ a) {b : A} (pb : bottom-rightᵣ y ≡ b)
  {c : A} (pc : top-leftᵣ y ≡ c) {d : A} (pd : top-rightᵣ y ≡ d)
  {f1 : hom a c} (L : (leftᵣ y , pa , pc) ≡{hom a c} f1) {f2 : hom b d} (R : (rightᵣ y , pb , pd) ≡{hom b d} f2)
  {g : hom a b} (B : (bottomᵣ y , pa , pb) ≡{hom a b} g) {h : hom c d} (T : (topᵣ y , pc , pd) ≡{hom c d} h) →
  path-over (squares-bt g h) (cong2 pair (comp-homᵣ-runit A sA f1) (comp-homᵣ-runit A sA f2))
    (comp-v sA (y , pa , pb , pc , pd , L , R , B , T) (id-v h)) (y , pa , pb , pc , pd , L , R , B , T)
comp-v-runit-aux {A} sA y refl refl refl refl refl refl refl refl =
  let Ψ : 𝕀 →ᵣ cell-pairs A = postᵣ pair-id (to-arrᵣ y) in
  let E : (e : arrᵣ A) → hom (srcᵣ e) (tgtᵣ e) = λ e . comp-cells sA (pair-id e) in
  let H : (e : arrᵣ A) → E e ≡ arr-hom e = λ e . comp-homᵣ-runit A sA (arr-hom e) in
  let F : E ≡ (λ e . arr-hom e) = funext-htpy {arrᵣ A} {λ e . hom (srcᵣ e) (tgtᵣ e)} E (λ e . arr-hom e) H in
  -- the arguments of comp-v-cone in comp-v
  let x : squareᵣ A = fst _ (id-v (top-hom y)) in
  let σ' : square-at y (left-hom y) (right-hom y) (bottom-hom y) (top-hom y) = (refl , refl , refl , refl , refl , refl , refl , refl) in
  let τ' : square-at x (Hom.id (top-leftᵣ y)) (Hom.id (top-rightᵣ y)) (top-hom y) (top-hom y) = snd _ (id-v (top-hom y)) in
  let Eh : (topᵣ y , sq-pc σ' , sq-pd σ') ≡{hom (top-leftᵣ y) (top-rightᵣ y)} (bottomᵣ x , sq-pa τ' , sq-pb τ') = trans (sq-top σ') (sym (sq-bottom τ')) in
  let P : topᵣ y ≡ bottomᵣ x = cong (hom-cell {A}) Eh in
  let gl0 : trans (cone-glue (cone-of y x P) 𝕀0) (sq-pa τ') ≡ sq-pc σ' =
    trans (cong {top-leftᵣ y ≡ bottom-leftᵣ x} (λ p . trans p (sq-pa τ')) (arr-htpy-glue (topᵣ y) P 𝕀0)) (hom-path-src Eh) in
  let gl1 : trans (cone-glue (cone-of y x P) 𝕀1) (sq-pb τ') ≡ sq-pd σ' =
    trans (cong {top-rightᵣ y ≡ bottom-rightᵣ x} (λ p . trans p (sq-pb τ')) (arr-htpy-glue (topᵣ y) P 𝕀1)) (hom-path-tgt Eh) in
  let l1 : E (leftᵣ y) ≡ left-hom y = H (leftᵣ y) in
  let l2 : E (rightᵣ y) ≡ right-hom y = H (rightᵣ y) in
  let Q : U = square (E (leftᵣ y)) (E (rightᵣ y)) (bottom-hom y) (top-hom y) in
  trans (cong {Q} (subst (squares-bt (bottom-hom y) (top-hom y)) (cong2 pair l1 l2)) (comp-v-cone-β-app sA Ψ σ' τ' gl0 gl1))
    (trans (cong {Q} (subst (squares-bt (bottom-hom y) (top-hom y)) (cong2 pair l1 l2)) (vpack-pre-r sA y refl refl))
      (trans (subst-vpack-at y E refl refl _ _ l1 l2)
        (trans (vpack-path y F (trans refl l1) (trans refl l2))
          (trans (cong2 {hom-norm (arr-hom (leftᵣ y)) ≡ left-hom y} {hom-norm (arr-hom (rightᵣ y)) ≡ right-hom y}
                    (λ L' R' . vpack y (λ e . arr-hom e) L' R')
                    (trans-sym-path (hom-norm-happly H (leftᵣ y)))
                    (trans-sym-path (hom-norm-happly H (rightᵣ y))))
            (vpack-arr-hom y)))))

-- Left unit law for vertical composition: composing with the vertical identity on the bottom
-- side gives back the square, over the left unit laws for its left and right sides.
comp-v-lunit : {A ∷ U} (sA : is-segalᵣ A) {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d}
  (σ : square f1 f2 g h) →
  path-over (squares-bt g h) (cong2 pair (comp-homᵣ-lunit A sA f1) (comp-homᵣ-lunit A sA f2)) (comp-v sA (id-v g) σ) σ
comp-v-lunit {A} sA {a} {b} {c} {d} {f1} {f2} {g} {h} σ =
  square-ind (λ σ . path-over (squares-bt g h) (cong2 pair (comp-homᵣ-lunit A sA f1) (comp-homᵣ-lunit A sA f2)) (comp-v sA (id-v g) σ) σ)
    (λ x pa pb pc pd L R B T . comp-v-lunit-aux sA x pa pb pc pd L R B T) σ

-- Right unit law for vertical composition.
comp-v-runit : {A ∷ U} (sA : is-segalᵣ A) {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d}
  (σ : square f1 f2 g h) →
  path-over (squares-bt g h) (cong2 pair (comp-homᵣ-runit A sA f1) (comp-homᵣ-runit A sA f2)) (comp-v sA σ (id-v h)) σ
comp-v-runit {A} sA {a} {b} {c} {d} {f1} {f2} {g} {h} σ =
  square-ind (λ σ . path-over (squares-bt g h) (cong2 pair (comp-homᵣ-runit A sA f1) (comp-homᵣ-runit A sA f2)) (comp-v sA σ (id-v h)) σ)
    (λ x pa pb pc pd L R B T . comp-v-runit-aux sA x pa pb pc pd L R B T) σ
