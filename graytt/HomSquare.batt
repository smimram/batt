open import Stdlib
open import Hom
open import Segal
open import Composition
open import Functoriality
open import Simplex-edges
open import Pullback-up

--
-- Squares
--

open Square

--
-- Moving the endpoints of homs
--

-- a hom with its endpoints moved along paths
hom-move : {X ∷ U} {a b : X} (u : hom a b) {a' b' : X} → a ≡ a' → b ≡ b' → hom a' b'
hom-move u p q = (hom-cell u , trans (hom-src u) p , trans (hom-tgt u) q)

-- composition commutes with moving endpoints
hom-move-comp : {X ∷ U} (s : is-segalᵣ X) {a b c : X} (u : hom a b) (v : hom b c)
  {a' : X} (p : a ≡ a') {b' : X} (r : b ≡ b') {c' : X} (q : c ≡ c') →
  hom-move (comp-homᵣ s u v) p q ≡ comp-homᵣ s (hom-move u p r) (hom-move v r q)
hom-move-comp {X} s {a} {b} {c} u v refl refl refl =
  trans (hom-eta {X} {a} {c} (comp-homᵣ s u v))
    (sym (cong2 (comp-homᵣ s) (hom-eta {X} {a} {b} u) (hom-eta {X} {b} {c} v)))

-- an arrow as a hom between its endpoints
arr-hom : {A ∷ U} (f : arrᵣ A) → hom (srcᵣ f) (tgtᵣ f)
arr-hom f = (f , refl , refl)

-- paths between the endpoint paths give a path of homs
hom-path : {A ∷ U} (t : arrᵣ A) {a b : A} {p p' : srcᵣ t ≡ a} {q q' : tgtᵣ t ≡ b} →
  p ≡ p' → q ≡ q' → (t , p , q) ≡{hom a b} (t , p' , q')
hom-path {A} t {a} {b} P Q = cong2 {srcᵣ t ≡ a} {tgtᵣ t ≡ b} {hom a b} (λ p0 p1 . (t , p0 , p1)) P Q

-- a path of arrows gives a path of homs
arr-hom-move : {A ∷ U} (t : arrᵣ A) {k : arrᵣ A} (p : t ≡ k) {a c : A} (q0 : srcᵣ k ≡ a) (q1 : tgtᵣ k ≡ c) →
  (t , trans (cong srcᵣ p) q0 , trans (cong tgtᵣ p) q1) ≡{hom a c} (k , q0 , q1)
arr-hom-move {A} t refl q0 q1 = hom-path t (trans-refl-l q0) (trans-refl-l q1)

-- the endpoint paths of homs related by a path
hom-path-src : {A ∷ U} {a b : A} {u v : hom a b} (E : u ≡ v) →
  trans (cong srcᵣ (cong (hom-cell {A}) E)) (hom-src v) ≡ hom-src u
hom-path-src {A} {a} {b} {u} refl = trans-refl-l (hom-src u)

hom-path-tgt : {A ∷ U} {a b : A} {u v : hom a b} (E : u ≡ v) →
  trans (cong tgtᵣ (cong (hom-cell {A}) E)) (hom-tgt v) ≡ hom-tgt u
hom-path-tgt {A} {a} {b} {u} refl = trans-refl-l (hom-tgt u)

-- postcomposing with homotopic maps gives the same hom
post-htpy-hom : {S A ∷ U} (F G : S → A) (h : (s : S) → F s ≡ G s) (Φ : 𝕀 →ᵣ S) →
  (postᵣ F Φ , h (Φ 𝕀0) , h (Φ 𝕀1)) ≡{hom (G (Φ 𝕀0)) (G (Φ 𝕀1))} arr-hom (postᵣ G Φ)
post-htpy-hom {S} {A} F G h Φ =
  -- by contractibility of the maps t from S to the singletons at F
  let T : U = (s : S) → Σ (y : A) . F s ≡ y in
  let Q : T → U = λ t . (postᵣ F Φ , snd _ (t (Φ 𝕀0)) , snd _ (t (Φ 𝕀1))) ≡{hom (fst _ (t (Φ 𝕀0))) (fst _ (t (Φ 𝕀1)))} arr-hom (postᵣ (λ s . fst _ (t s)) Φ) in
  let t0 : T = λ s . (F s , refl) in
  let t : T = λ s . (G s , h s) in
  let c : is-contr T = is-contr-Π (λ s . Σ (y : A) . F s ≡ y) (λ s . is-contr-sing (F s)) in
  J t0 (λ t' _ . Q t') refl (is-contr-eq c t0 t)

--
-- Squares with given sides
--

-- the sides of a square, as homs between its corners
left-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-leftᵣ x) (top-leftᵣ x)
left-hom x = (leftᵣ x , refl , refl)

right-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-rightᵣ x) (top-rightᵣ x)
right-hom x = (rightᵣ x , refl , refl)

bottom-hom : {A ∷ U} (x : squareᵣ A) → hom (bottom-leftᵣ x) (bottom-rightᵣ x)
bottom-hom x = (bottomᵣ x , refl , refl)

top-hom : {A ∷ U} (x : squareᵣ A) → hom (top-leftᵣ x) (top-rightᵣ x)
top-hom x = (topᵣ x , refl , refl)

-- The oplax square x has left, right, bottom and top sides f1, f2, g and h: its corners are
-- identified with the given ones, and its sides with the given homs (along those identifications).
square-at : {A ∷ U} (x : squareᵣ A) {a b c d : A} (f1 : hom a c) (f2 : hom b d) (g : hom a b) (h : hom c d) → U
square-at {A} x {a} {b} {c} {d} f1 f2 g h =
  Σ (pa : bottom-leftᵣ x ≡ a) . Σ (pb : bottom-rightᵣ x ≡ b) .
  Σ (pc : top-leftᵣ x ≡ c) . Σ (pd : top-rightᵣ x ≡ d) .
    ((leftᵣ x , pa , pc) ≡{hom a c} f1) × ((rightᵣ x , pb , pd) ≡{hom b d} f2) ×
    ((bottomᵣ x , pa , pb) ≡{hom a b} g) × ((topᵣ x , pc , pd) ≡{hom c d} h)

-- The oplax squares with given left, right, bottom and top sides.
square : {A ∷ U} {a b c d : A} (f1 : hom a c) (f2 : hom b d) (g : hom a b) (h : hom c d) → U
square {A} f1 f2 g h = Σ (x : squareᵣ A) . square-at x f1 f2 g h

-- the components of a square with given sides
sq-pa : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → bottom-leftᵣ x ≡ a
sq-pa σ = fst _ σ

sq-pb : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → bottom-rightᵣ x ≡ b
sq-pb σ = fst _ (snd _ σ)

sq-pc : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → top-leftᵣ x ≡ c
sq-pc σ = fst _ (snd _ (snd _ σ))

sq-pd : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  square-at x f1 f2 g h → top-rightᵣ x ≡ d
sq-pd σ = fst _ (snd _ (snd _ (snd _ σ)))

sq-left : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (leftᵣ x , sq-pa σ , sq-pc σ) ≡{hom a c} f1
sq-left σ = Product.fst (snd _ (snd _ (snd _ (snd _ σ))))

sq-right : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (rightᵣ x , sq-pb σ , sq-pd σ) ≡{hom b d} f2
sq-right σ = Product.fst (Product.snd (snd _ (snd _ (snd _ (snd _ σ)))))

sq-bottom : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (bottomᵣ x , sq-pa σ , sq-pb σ) ≡{hom a b} g
sq-bottom σ = Product.fst (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ σ))))))

sq-top : {A ∷ U} {x : squareᵣ A} {a b c d : A} {f1 : hom a c} {f2 : hom b d} {g : hom a b} {h : hom c d} →
  (σ : square-at x f1 f2 g h) → (topᵣ x , sq-pc σ , sq-pd σ) ≡{hom c d} h
sq-top σ = Product.snd (Product.snd (Product.snd (snd _ (snd _ (snd _ (snd _ σ))))))

-- A hom l r in arrᵣ A (between vertical sides) is an oplax square from l to r: its bottom and
-- top sides are the images of the hom by srcᵣ and tgtᵣ.
of-hom : {A ∷ U} {l r : arrᵣ A} (u : hom l r) → square (arr-hom l) (arr-hom r) (hom-map srcᵣ u) (hom-map tgtᵣ u)
of-hom {A} {l} {r} u =
  (of-arrᵣ (hom-cell u) ,
   cong srcᵣ (hom-src u) , cong srcᵣ (hom-tgt u) , cong tgtᵣ (hom-src u) , cong tgtᵣ (hom-tgt u) ,
   arr-hom-move (srcᵣ (hom-cell u)) (hom-src u) refl refl ,
   arr-hom-move (tgtᵣ (hom-cell u)) (hom-tgt u) refl refl ,
   refl , refl)

-- Horizontal composition of squares: the composite of the squares as homs in arrᵣ A (along the
-- path between their common sides), whose bottom and top are the composites of the bottoms and tops.
comph : {A ∷ U} (sA : is-segalᵣ A) {a b e c d f : A}
  {f1 : hom a c} {f2 : hom b d} {f3 : hom e f} {g : hom a b} {g' : hom b e} {h : hom c d} {h' : hom d f} →
  square f1 f2 g h → square f2 f3 g' h' → square f1 f3 (comp-homᵣ sA g g') (comp-homᵣ sA h h')
comph {A} sA {a} {b} {e} {c} {d} {f} {f1} {f2} {f3} {g} {g'} {h} {h'} σ τ =
  let x : squareᵣ A = fst _ σ in
  let y : squareᵣ A = fst _ τ in
  let σ' : square-at x f1 f2 g h = snd _ σ in
  let τ' : square-at y f2 f3 g' h' = snd _ τ in
  let pa : bottom-leftᵣ x ≡ a = sq-pa σ' in
  let pb : bottom-rightᵣ x ≡ b = sq-pb σ' in
  let pc : top-leftᵣ x ≡ c = sq-pc σ' in
  let pd : top-rightᵣ x ≡ d = sq-pd σ' in
  let qb : bottom-leftᵣ y ≡ b = sq-pa τ' in
  let qe : bottom-rightᵣ y ≡ e = sq-pb τ' in
  let qd : top-leftᵣ y ≡ d = sq-pc τ' in
  let qf : top-rightᵣ y ≡ f = sq-pd τ' in
  let E : (rightᵣ x , pb , pd) ≡{hom b d} (leftᵣ y , qb , qd) = trans (sq-right σ') (sym (sq-left τ')) in
  let p : rightᵣ x ≡ leftᵣ y = cong (hom-cell {A}) E in
  let sA' : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  let u : hom (leftᵣ x) (leftᵣ y) = (to-arrᵣ x , refl , p) in
  let v : hom (leftᵣ y) (rightᵣ y) = (to-arrᵣ y , refl , refl) in
  let w : hom (leftᵣ x) (rightᵣ y) = comp-homᵣ sA' u v in
  -- the bottom and top sides of the two squares
  let gu : hom-move (hom-map srcᵣ u) pa qb ≡ g =
    trans (hom-path (bottomᵣ x) (trans-refl-l pa) (hom-path-src E)) (sq-bottom σ') in
  let gv : hom-move (hom-map srcᵣ v) qb qe ≡ g' =
    trans (hom-path (bottomᵣ y) (trans-refl-l qb) (trans-refl-l qe)) (sq-bottom τ') in
  let hu : hom-move (hom-map tgtᵣ u) pc qd ≡ h =
    trans (hom-path (topᵣ x) (trans-refl-l pc) (hom-path-tgt E)) (sq-top σ') in
  let hv : hom-move (hom-map tgtᵣ v) qd qf ≡ h' =
    trans (hom-path (topᵣ y) (trans-refl-l qd) (trans-refl-l qf)) (sq-top τ') in
  (of-arrᵣ (hom-cell w) ,
   trans (cong srcᵣ (hom-src w)) pa , trans (cong srcᵣ (hom-tgt w)) qe ,
   trans (cong tgtᵣ (hom-src w)) pc , trans (cong tgtᵣ (hom-tgt w)) qf ,
   trans (arr-hom-move (srcᵣ (hom-cell w)) (hom-src w) pa pc) (sq-left σ') ,
   trans (arr-hom-move (tgtᵣ (hom-cell w)) (hom-tgt w) qe qf) (sq-right τ') ,
   trans (cong {hom (bottom-leftᵣ x) (bottom-rightᵣ y)} (λ k . hom-move k pa qe) (hom-map-comp (arrᵣ A) A srcᵣ sA' sA u v))
     (trans (hom-move-comp sA (hom-map srcᵣ u) (hom-map srcᵣ v) pa qb qe) (cong2 (comp-homᵣ sA) gu gv)) ,
   trans (cong {hom (top-leftᵣ x) (top-rightᵣ y)} (λ k . hom-move k pc qf) (hom-map-comp (arrᵣ A) A tgtᵣ sA' sA u v))
     (trans (hom-move-comp sA (hom-map tgtᵣ u) (hom-map tgtᵣ v) pc qd qf) (cong2 (comp-homᵣ sA) hu hv)))

--
-- Vertical composition
--
-- Oplax squares only curry with the horizontal variable outside (to-arrᵣ), so vertical
-- composition is pointwise in the horizontal variable: it composes an oplax family
-- Ψ : 𝕀 →ᵣ cell-pairs A of composable pairs. Two squares glued along a path between the top of the
-- lower one and the bottom of the upper one form an oplax cone over tgtᵣ and srcᵣ, and such cones
-- are families of composable pairs by the oplax universal property of pullbacks
-- (pullback-oplax-up). We thus prove the statement for families, where the gluing is
-- judgmental, and extend it to all cones (cone-ind).
--

-- the components of a composable pair of cells
cp-fst : {A ∷ U} → cell-pairs A → arrᵣ A
cp-fst c = fst _ c

cp-snd : {A ∷ U} → cell-pairs A → arrᵣ A
cp-snd c = fst _ (snd _ c)

cp-glue : {A ∷ U} (c : cell-pairs A) → tgtᵣ (cp-fst c) ≡ srcᵣ (cp-snd c)
cp-glue c = snd _ (snd _ c)

-- the composite of a composable pair of cells
comp-cells : {A ∷ U} (sA : is-segalᵣ A) (c : cell-pairs A) → hom (srcᵣ (cp-fst c)) (tgtᵣ (cp-snd c))
comp-cells sA c = comp-homᵣ sA (cp-fst c , refl , cp-glue c) (cp-snd c , refl , refl)

-- oplax cones over tgtᵣ and srcᵣ: a lower and an upper square, glued along a homotopy
cone : (A ∷ U) → U
cone A = pullback-coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ

cone-lower : {A ∷ U} → cone A → squareᵣ A
cone-lower {A} κ = of-arrᵣ (pullback-coneᵣ-fst 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ)

cone-upper : {A ∷ U} → cone A → squareᵣ A
cone-upper {A} κ = of-arrᵣ (pullback-coneᵣ-snd 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ)

cone-htpy : {A ∷ U} → cone A → 𝕀 →ᵣ path A
cone-htpy {A} κ = pullback-coneᵣ-htpy 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ κ

cone-src : {A ∷ U} (κ : cone A) → postᵣ {𝕀} {path A} {A} path-src (cone-htpy κ) ≡ topᵣ (cone-lower κ)
cone-src {A} κ = Product.fst (snd (pullback-coneᵣ-paths 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)

cone-tgt : {A ∷ U} (κ : cone A) → postᵣ {𝕀} {path A} {A} path-tgt (cone-htpy κ) ≡ bottomᵣ (cone-upper κ)
cone-tgt {A} κ = Product.snd (snd (pullback-coneᵣ-paths 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) κ)

-- the gluing path of a cone at a crisp point
cone-glue : {A ∷ U} (κ : cone A) (i ∷ 𝕀) → topᵣ (cone-lower κ) i ≡ bottomᵣ (cone-upper κ) i
cone-glue κ i = trans (sym (happlyᵣ (cone-src κ) i)) (trans (path-eq (cone-htpy κ i)) (happlyᵣ (cone-tgt κ) i))

-- cone induction: cones are families of composable pairs
cone-ind : {A ∷ U} (Q : cone A → U) → ((Ψ : 𝕀 →ᵣ cell-pairs A) → Q (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)) →
  (κ : cone A) → Q κ
cone-ind {A} Q q κ =
  let f : (𝕀 →ᵣ cell-pairs A) → cone A = pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ in
  let s : section f = is-equiv-sec f (pullback-oplax-up 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ) in
  subst Q (snd _ s κ) (q (section-map f s κ))

-- vertical composition for the squares of a cone, whose corners agree with the gluing paths
compv-stmt : {A ∷ U} (sA : is-segalᵣ A) → cone A → U
compv-stmt {A} sA κ =
  {a b c d e f : A} {f1 : hom a c} {f2 : hom b d} {f1' : hom c e} {f2' : hom d f} {g : hom a b} {h : hom c d} {h' : hom e f} →
  (σ : square-at (cone-lower κ) f1 f2 g h) (τ : square-at (cone-upper κ) f1' f2' h h') →
  trans (cone-glue κ 𝕀0) (sq-pa τ) ≡ sq-pc σ → trans (cone-glue κ 𝕀1) (sq-pb τ) ≡ sq-pd σ →
  square (comp-homᵣ sA f1 f1') (comp-homᵣ sA f2 f2') g h'

-- for a family of composable pairs: the pointwise composite
compv-fam : {A ∷ U} (sA : is-segalᵣ A) (Ψ : 𝕀 →ᵣ cell-pairs A) → compv-stmt sA (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ)
compv-fam {A} sA Ψ {a} {b} {c} {d} {e} {f} {f1} {f2} {f1'} {f2'} {g} {h} {h'} σ τ gl0 gl1 =
  let x : squareᵣ A = cone-lower (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) in
  let y : squareᵣ A = cone-upper (pullback→coneᵣ 𝕀 {arrᵣ A} {arrᵣ A} {A} tgtᵣ srcᵣ Ψ) in
  let pa : bottom-leftᵣ x ≡ a = sq-pa σ in
  let pb : bottom-rightᵣ x ≡ b = sq-pb σ in
  let pc : top-leftᵣ x ≡ c = sq-pc σ in
  let pd : top-rightᵣ x ≡ d = sq-pd σ in
  let qc : bottom-leftᵣ y ≡ c = sq-pa τ in
  let qd : bottom-rightᵣ y ≡ d = sq-pb τ in
  let qe : top-leftᵣ y ≡ e = sq-pc τ in
  let qf : top-rightᵣ y ≡ f = sq-pd τ in
  -- the composable pairs on the left and on the right, and their composites
  let u0 : hom (bottom-leftᵣ x) (bottom-leftᵣ y) = (cp-fst (Ψ 𝕀0) , refl , cp-glue (Ψ 𝕀0)) in
  let v0 : hom (bottom-leftᵣ y) (top-leftᵣ y) = (cp-snd (Ψ 𝕀0) , refl , refl) in
  let u1 : hom (bottom-rightᵣ x) (bottom-rightᵣ y) = (cp-fst (Ψ 𝕀1) , refl , cp-glue (Ψ 𝕀1)) in
  let v1 : hom (bottom-rightᵣ y) (top-rightᵣ y) = (cp-snd (Ψ 𝕀1) , refl , refl) in
  let C0 : hom (bottom-leftᵣ x) (top-leftᵣ y) = comp-cells sA (Ψ 𝕀0) in
  let C1 : hom (bottom-rightᵣ x) (top-rightᵣ y) = comp-cells sA (Ψ 𝕀1) in
  -- the gluing conditions, for the judgmental gluing paths of Ψ
  let G0 : trans (cp-glue (Ψ 𝕀0)) qc ≡ pc =
    trans (cong {top-leftᵣ x ≡ bottom-leftᵣ y} (λ p . trans p qc) (sym (trans-refl-l (cp-glue (Ψ 𝕀0))))) gl0 in
  let G1 : trans (cp-glue (Ψ 𝕀1)) qd ≡ pd =
    trans (cong {top-rightᵣ x ≡ bottom-rightᵣ y} (λ p . trans p qd) (sym (trans-refl-l (cp-glue (Ψ 𝕀1))))) gl1 in
  (of-arrᵣ (postᵣ (λ c . hom-cell (comp-cells sA c)) Ψ) ,
   trans (hom-src C0) pa , trans (hom-src C1) pb , trans (hom-tgt C0) qe , trans (hom-tgt C1) qf ,
   trans (hom-move-comp sA u0 v0 pa qc qe)
     (cong2 (comp-homᵣ sA)
       (trans (hom-path (leftᵣ x) (trans-refl-l pa) G0) (sq-left σ))
       (trans (hom-path (leftᵣ y) (trans-refl-l qc) (trans-refl-l qe)) (sq-left τ))) ,
   trans (hom-move-comp sA u1 v1 pb qd qf)
     (cong2 (comp-homᵣ sA)
       (trans (hom-path (rightᵣ x) (trans-refl-l pb) G1) (sq-right σ))
       (trans (hom-path (rightᵣ y) (trans-refl-l qd) (trans-refl-l qf)) (sq-right τ))) ,
   trans (cong {hom (bottom-leftᵣ x) (bottom-rightᵣ x)} (λ k . hom-move k pa pb)
            (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀0) (λ c . cp-fst c 𝕀0) (λ c . hom-src (comp-cells sA c)) Ψ))
     (trans (hom-path (bottomᵣ x) (trans-refl-l pa) (trans-refl-l pb)) (sq-bottom σ)) ,
   trans (cong {hom (top-leftᵣ y) (top-rightᵣ y)} (λ k . hom-move k qe qf)
            (post-htpy-hom (λ c . hom-cell (comp-cells sA c) 𝕀1) (λ c . cp-snd c 𝕀1) (λ c . hom-tgt (comp-cells sA c)) Ψ))
     (trans (hom-path (topᵣ y) (trans-refl-l qe) (trans-refl-l qf)) (sq-top τ)))

-- for every cone, by cone induction
compv-cone : {A ∷ U} (sA : is-segalᵣ A) (κ : cone A) → compv-stmt sA κ
compv-cone {A} sA κ = cone-ind (compv-stmt sA) (compv-fam sA) κ

-- the homotopy of a path between arrows, and its endpoints
arr-htpy : {A ∷ U} {f k : arrᵣ A} → f ≡ k → 𝕀 →ᵣ path A
arr-htpy {A} {f} {k} P = Funext.happlyᵣ 𝕀 A (f , k , P)

arr-htpy-src : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) → postᵣ {𝕀} {path A} {A} path-src (arr-htpy P) ≡ f
arr-htpy-src f refl = refl

arr-htpy-tgt : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) → postᵣ {𝕀} {path A} {A} path-tgt (arr-htpy P) ≡ k
arr-htpy-tgt f refl = refl

-- the gluing path of the homotopy at a crisp point is the evaluation of the path
arr-htpy-glue : {A ∷ U} (f : arrᵣ A) {k : arrᵣ A} (P : f ≡ k) (i ∷ 𝕀) →
  trans (sym (happlyᵣ (arr-htpy-src f P) i)) (trans (path-eq (arr-htpy P i)) (happlyᵣ (arr-htpy-tgt f P) i)) ≡ happlyᵣ P i
arr-htpy-glue f refl i = refl

-- the cone of two squares glued along a path
cone-of : {A ∷ U} (x y : squareᵣ A) → topᵣ x ≡ bottomᵣ y → cone A
cone-of x y P = ((to-arrᵣ x , to-arrᵣ y , arr-htpy P) , arr-htpy-src (topᵣ x) P , arr-htpy-tgt (topᵣ x) P)

-- Vertical composition of squares: the pointwise composite of the composable pairs formed by the
-- two squares, whose left and right sides are the composites of the left and right sides.
compv : {A ∷ U} (sA : is-segalᵣ A) {a b c d e f : A}
  {f1 : hom a c} {f2 : hom b d} {f1' : hom c e} {f2' : hom d f} {g : hom a b} {h : hom c d} {h' : hom e f} →
  square f1 f2 g h → square f1' f2' h h' → square (comp-homᵣ sA f1 f1') (comp-homᵣ sA f2 f2') g h'
compv {A} sA {a} {b} {c} {d} {e} {f} {f1} {f2} {f1'} {f2'} {g} {h} {h'} σ τ =
  let x : squareᵣ A = fst _ σ in
  let y : squareᵣ A = fst _ τ in
  let σ' : square-at x f1 f2 g h = snd _ σ in
  let τ' : square-at y f1' f2' h h' = snd _ τ in
  let E : (topᵣ x , sq-pc σ' , sq-pd σ') ≡{hom c d} (bottomᵣ y , sq-pa τ' , sq-pb τ') = trans (sq-top σ') (sym (sq-bottom τ')) in
  let P : topᵣ x ≡ bottomᵣ y = cong (hom-cell {A}) E in
  compv-cone sA (cone-of x y P) σ' τ'
    (trans (cong {top-leftᵣ x ≡ bottom-leftᵣ y} (λ p . trans p (sq-pa τ')) (arr-htpy-glue (topᵣ x) P 𝕀0)) (hom-path-src E))
    (trans (cong {top-rightᵣ x ≡ bottom-rightᵣ y} (λ p . trans p (sq-pb τ')) (arr-htpy-glue (topᵣ x) P 𝕀1)) (hom-path-tgt E))
