--
-- Composable pairs and triples of 1-cells, and oplax maps out of spines
--

open import Stdlib
open import Hom
open import Spine-up
open import Composition

pair-from ∷ (X ∷ U) → X → U
pair-from X y = Σ (z : X) . Σ (t : X) . hom X y z × hom X z t

pairs ∷ (X ∷ U) → U
pairs X = Σ (y : X) . pair-from X y

triples ∷ (X ∷ U) → U
triples X = Σ (x : X) . Σ (y : X) . hom X x y × pair-from X y

-- a family over composable pairs, given by a statement S about (v , w)
pair-family ∷ (X ∷ U) (S : (y z t : X) → hom X y z → hom X z t → U) → pairs X → U
pair-family X S (y , r) =
  let h : (z : X) (b : Σ (t : X) . hom X y z × hom X z t) → U = fun z (t , c) →
    let k : (c : hom X y z × hom X z t) → U = fun (v , w) → S y z t v w in
    k c
  in
  h (fst (λ z . Σ (t : X) . hom X y z × hom X z t) r) (snd (λ z . Σ (t : X) . hom X y z × hom X z t) r)

-- a family over composable triples, given by a statement S about (u , v , w)
tri-family ∷ (X ∷ U) (S : (x y z t : X) → hom X x y → hom X y z → hom X z t → U) → triples X → U
tri-family X S (x , r) =
  let h : (y : X) (b : hom X x y × pair-from X y) → U = fun y (u , c) →
    let k : (z : X) (d : Σ (t : X) . hom X y z × hom X z t) → U = fun z (t , e) →
      let l : (e : hom X y z × hom X z t) → U = fun (v , w) → S x y z t u v w in
      l e
    in
    k (fst (λ z . Σ (t : X) . hom X y z × hom X z t) c) (snd (λ z . Σ (t : X) . hom X y z × hom X z t) c)
  in
  h (fst (λ y . hom X x y × pair-from X y) r) (snd (λ y . hom X x y × pair-from X y) r)

--
-- Pairs out of the 2-spine
--

-- the edges of the two pieces of the 2-spine
𝕀→spine-2-edge-1 ∷ 𝕀 → spine-2-edge-1
𝕀→spine-2-edge-1 t = ((t , 𝕀0 , tt) , refl)

𝕀→spine-2-edge-2 ∷ 𝕀 → spine-2-edge-2
𝕀→spine-2-edge-2 t = ((𝕀1 , t , tt) , (refl , spine-1-pt t))

-- the pair of edges of an oplax cocone on the 2-spine
coc-pair ∷ {X ∷ U} → spine-cocone-r X → pairs X
coc-pair {X} c =
  (spine-2-cocone-edge-1 {X} c spine-2-edge-1-start ,
    spine-2-cocone-edge-2 {X} c spine-2-edge-2-start ,
    spine-2-cocone-edge-2 {X} c spine-2-edge-2-end ,
    ((λ t . spine-2-cocone-edge-1 {X} c (𝕀→spine-2-edge-1 t)) , refl , spine-2-cocone-glue {X} c) ,
    ((λ t . spine-2-cocone-edge-2 {X} c (𝕀→spine-2-edge-2 t)) , refl , refl))

-- reading a pair of homs off their cocone gives them back, with their boundary paths moved to
-- the free endpoints
pair-path-J ∷ {X ∷ U} (g h : 𝕀 →ᵣ X) {y : X} (e0 : g 𝕀0 ≡ y) {t : X} (e2 : h 𝕀1 ≡ t) {z : X} (e1' : h 𝕀0 ≡ z) (e1 : g 𝕀1 ≡ z) →
  (g 𝕀0 , h 𝕀0 , h 𝕀1 , (g , refl , trans e1 (sym e1')) , (h , refl , refl)) ≡{pairs X}
    (y , z , t , (g , e0 , e1) , (h , e1' , e2))
pair-path-J {X} g h {y} e0 {t} e2 {z} e1' e1 =
  J (g 𝕀0) (λ y e0 . (g 𝕀0 , h 𝕀0 , h 𝕀1 , (g , refl , trans e1 (sym e1')) , (h , refl , refl)) ≡{pairs X}
      (y , z , t , (g , e0 , e1) , (h , e1' , e2)))
    (J (h 𝕀1) (λ t e2 . (g 𝕀0 , h 𝕀0 , h 𝕀1 , (g , refl , trans e1 (sym e1')) , (h , refl , refl)) ≡{pairs X}
          (g 𝕀0 , z , t , (g , refl , e1) , (h , e1' , e2)))
      (J (h 𝕀0) (λ z e1' . (e1 : g 𝕀1 ≡ z) →
            (g 𝕀0 , h 𝕀0 , h 𝕀1 , (g , refl , trans e1 (sym e1')) , (h , refl , refl)) ≡{pairs X}
              (g 𝕀0 , z , h 𝕀1 , (g , refl , e1) , (h , e1' , refl)))
        (λ e1 . refl) e1' e1)
      e2)
    e0

abstract coc-pair-hom-pair ∷ {X ∷ U} {y z t : X} (v : hom X y z) (w : hom X z t) →
  coc-pair {X} (hom-pair {X} {y} {z} {t} v w) ≡ (y , z , t , v , w)
coc-pair-hom-pair {X} {y} {z} {t} (g , ev) (h , ew) =
  let k : (ev : (g 𝕀0 ≡ y) × (g 𝕀1 ≡ z)) (ew : (h 𝕀0 ≡ z) × (h 𝕀1 ≡ t)) →
      coc-pair {X} (hom-pair {X} {y} {z} {t} (g , ev) (h , ew)) ≡ (y , z , t , (g , ev) , (h , ew)) =
    fun (e0 , e1) (e1' , e2) → pair-path-J {X} g h {y} e0 {t} e2 {z} e1' e1
  in
  k ev ew

-- every composable pair is the pair of edges of an oplax map out of the 2-spine
pair-section ∷ (X ∷ U) {y z t : X} (v : hom X y z) (w : hom X z t) → (spine 2 →ᵣ X)
pair-section X {y} {z} {t} v w = hom-spine X {y} {z} {t} v w

abstract pair-section-path ∷ (X ∷ U) {y z t : X} (v : hom X y z) (w : hom X z t) →
  coc-pair {X} (spine-2→cocone-r X (pair-section X {y} {z} {t} v w)) ≡ (y , z , t , v , w)
pair-section-path X {y} {z} {t} v w =
  trans (cong {spine-cocone-r X} {pairs X} (coc-pair {X})
          (spine-2→cocone-r-sec X (hom-pair {X} {y} {z} {t} v w)))
    (coc-pair-hom-pair {X} {y} {z} {t} v w)

--
-- Triples out of the 3-spine
--

-- prepending a 1-cell to a composable pair
tri-cons ∷ {X ∷ U} (f : 𝕀 →ᵣ X) (r : pairs X) → f 𝕀1 ≡ fst (pair-from X) r → triples X
tri-cons {X} f r q = (f 𝕀0 , fst (pair-from X) r , (f , refl , q) , snd (pair-from X) r)

tri-cons-path ∷ {X ∷ U} (f : 𝕀 →ᵣ X) {r r' : pairs X} (P : r ≡ r') (q : f 𝕀1 ≡ fst (pair-from X) r) →
  tri-cons {X} f r q ≡ tri-cons {X} f r' (trans q (cong (fst (pair-from X)) P))
tri-cons-path {X} f {r} {r'} P =
  J r (λ r' P . (q : f 𝕀1 ≡ fst (pair-from X) r) → tri-cons {X} f r q ≡ tri-cons {X} f r' (trans q (cong (fst (pair-from X)) P)))
    (λ q . refl) P

-- the edges of the pieces of the 3-spine: the first edge, and the two edges of the copy of the
-- 2-spine, glued at their common vertex
𝕀→spine-3-edge-1 ∷ 𝕀 → spine-3-edge-1
𝕀→spine-3-edge-1 t = ((t , 𝕀0 , 𝕀0 , tt) , refl)

𝕀→spine-3-tail-edge-1 ∷ 𝕀 → spine-3-tail
𝕀→spine-3-tail-edge-1 t = spine-2→spine-3-tail (spine-2-edge-1-incl (𝕀→spine-2-edge-1 t))

𝕀→spine-3-tail-edge-2 ∷ 𝕀 → spine-3-tail
𝕀→spine-3-tail-edge-2 t = spine-2→spine-3-tail (spine-2-edge-2-incl (𝕀→spine-2-edge-2 t))

spine-3-tail-glue ∷ 𝕀→spine-3-tail-edge-1 𝕀1 ≡{spine-3-tail} 𝕀→spine-3-tail-edge-2 𝕀0
spine-3-tail-glue = cong spine-2→spine-3-tail spine-2-glue

-- the pair of edges of an oplax map out of the copy of the 2-spine
spine-3-tail-pair ∷ {X ∷ U} → (spine-3-tail →ᵣ X) → pairs X
spine-3-tail-pair {X} g =
  (g spine-3-tail-start , g (𝕀→spine-3-tail-edge-2 𝕀0) , g (𝕀→spine-3-tail-edge-2 𝕀1) ,
    ((λ t . g (𝕀→spine-3-tail-edge-1 t)) , refl , ap-r {spine-3-tail} {X} {𝕀→spine-3-tail-edge-1 𝕀1}
        {𝕀→spine-3-tail-edge-2 𝕀0} spine-3-tail-glue g) ,
    ((λ t . g (𝕀→spine-3-tail-edge-2 t)) , refl , refl))

-- the triple of edges of an oplax cocone on the 3-spine
coc3-tri ∷ {X ∷ U} → spine-3-cocone-r X → triples X
coc3-tri {X} c =
  tri-cons {X} (λ t . spine-3-cocone-edge-1 {X} c (𝕀→spine-3-edge-1 t))
    (spine-3-tail-pair {X} (spine-3-cocone-tail {X} c))
      (spine-3-cocone-glue {X} c)

-- an oplax map out of the 2-spine, seen on the copy of the 2-spine, has the same pair of edges
abstract spine-3-tail-pair-proj ∷ {X ∷ U} (Φ : spine 2 →ᵣ X) →
  spine-3-tail-pair {X} (pre-r {spine-3-tail} {spine 2} {X} Φ spine-3-tail→spine-2) ≡ coc-pair {X} (spine-2→cocone-r X Φ)
spine-3-tail-pair-proj {X} Φ =
  cong {Φ (spine-2-edge-1-incl spine-2-edge-1-end) ≡ Φ (spine-2-edge-2-incl spine-2-edge-2-start)} {pairs X}
    (λ e . (Φ (spine-2-edge-1-incl spine-2-edge-1-start) , Φ (spine-2-edge-2-incl spine-2-edge-2-start) , Φ
          (spine-2-edge-2-incl spine-2-edge-2-end) ,
          ((λ t . Φ (spine-2-edge-1-incl (𝕀→spine-2-edge-1 t))) , refl , e) ,
          ((λ t . Φ (spine-2-edge-2-incl (𝕀→spine-2-edge-2 t))) , refl , refl)))
    (trans (ap-r-pre-r spine-3-tail {spine 2} {X} {𝕀→spine-3-tail-edge-1 𝕀1} {𝕀→spine-3-tail-edge-2 𝕀0}
          spine-3-tail-glue spine-3-tail→spine-2 Φ)
      (ap-r-set (is-set-spine 2) (cong spine-3-tail→spine-2 spine-3-tail-glue) spine-2-glue Φ))

-- every composable triple is the triple of edges of an oplax cocone on the 3-spine
spine-3-edge-1→𝕀 ∷ spine-3-edge-1 → 𝕀
spine-3-edge-1→𝕀 (c , a) = cube-3-x1 c

tri-section ∷ (X ∷ U) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) → spine-3-cocone-r X
tri-section X {x} {y} {z} {t} u v w =
  let P : spine-3-tail-pair {X} (pre-r {spine-3-tail} {spine 2} {X} (pair-section X {y} {z} {t} v w)
      spine-3-tail→spine-2) ≡ (y , z , t , v , w) =
    trans (spine-3-tail-pair-proj {X} (pair-section X {y} {z} {t} v w)) (pair-section-path X {y} {z} {t} v w) in
  (pre-r {spine-3-edge-1} {𝕀} {X} (hom-cell {X} {x} {y} u) spine-3-edge-1→𝕀 ,
    pre-r {spine-3-tail} {spine 2} {X} (pair-section X {y} {z} {t} v w) spine-3-tail→spine-2 ,
    trans (hom-tgt {X} {x} {y} u) (sym (cong (fst (pair-from X)) P)))

-- trans (trans p (sym q)) q ≡ p
trans-sym-cancel-r ∷ {A : U} {x y : A} (p : x ≡ y) {z : A} (q : z ≡ y) → trans (trans p (sym q)) q ≡ p
trans-sym-cancel-r {A} {x} {y} p {z} q = trans (assoc p (sym q) q) (cong {y ≡ y} {x ≡ y} (λ r . trans p r) (trans-sym-l q))

-- moving the source path of a hom to a free endpoint
tri-src-J ∷ {X ∷ U} (f : 𝕀 →ᵣ X) {x : X} (e0 : f 𝕀0 ≡ x) {y : X} (e1 : f 𝕀1 ≡ y) (r : pair-from X y) →
  (f 𝕀0 , y , (f , refl , e1) , r) ≡{triples X} (x , y , (f , e0 , e1) , r)
tri-src-J {X} f {x} e0 {y} e1 r =
  J (f 𝕀0) (λ x e0 . (f 𝕀0 , y , (f , refl , e1) , r) ≡{triples X} (x , y , (f , e0 , e1) , r)) refl e0

abstract tri-section-path ∷ (X ∷ U) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  coc3-tri {X} (tri-section X {x} {y} {z} {t} u v w) ≡ (x , y , u , z , t , v , w)
tri-section-path X {x} {y} {z} {t} (f , e) v w =
  let P : spine-3-tail-pair {X} (pre-r {spine-3-tail} {spine 2} {X} (pair-section X {y} {z} {t} v w)
      spine-3-tail→spine-2) ≡ (y , z , t , v , w) =
    trans (spine-3-tail-pair-proj {X} (pair-section X {y} {z} {t} v w)) (pair-section-path X {y} {z} {t} v w) in
  let k : (e : (f 𝕀0 ≡ x) × (f 𝕀1 ≡ y)) → coc3-tri {X} (tri-section X {x} {y} {z} {t} (f , e) v w) ≡
    (x , y , (f , e) , z , t , v , w) =
    fun (e0 , e1) →
      trans (tri-cons-path {X} f {spine-3-tail-pair {X}
            (pre-r {spine-3-tail} {spine 2} {X} (pair-section X {y} {z} {t} v w) spine-3-tail→spine-2)}
          {(y , z , t , v , w)} P
              (trans e1 (sym (cong (fst (pair-from X)) P))))
        (trans (cong {f 𝕀1 ≡ y} {triples X} (λ q . (f 𝕀0 , y , (f , refl , q) , z , t , v , w))
                (trans-sym-cancel-r e1 (cong (fst (pair-from X)) P)))
          (tri-src-J {X} f e0 e1 (z , t , v , w)))
  in
  k e
