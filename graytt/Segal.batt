--
-- The four notions of Segalness
--
-- A type X is Segal when it is local with respect to every thickened spine inclusion
--   ι : Sp_{n,𝐚,𝐛} → Δⁿ_{𝐚,𝐛}      (Sp_{n,𝐚,𝐛} = □[𝐚] ⊗ Spₙ ⊗ □[𝐛], see Spine.batt)
-- i.e. when restriction along ι is an equivalence. There is one notion per way of mapping
-- out of the shapes:
--
--   internal : (Δⁿ_{𝐚,𝐛} → X)  → (Sp_{n,𝐚,𝐛} → X)       any X
--   flat     : ♭(Δⁿ_{𝐚,𝐛} → X) → ♭(Sp_{n,𝐚,𝐛} → X)     crisp X (global locality)
--   oplax    : (Δⁿ_{𝐚,𝐛} →ᵣ X) → (Sp_{n,𝐚,𝐛} →ᵣ X)     crisp X
--   lax      : (Δⁿ_{𝐚,𝐛} →ₗ X) → (Sp_{n,𝐚,𝐛} →ₗ X)     crisp X
--
-- Expected relations: internal ⇒ flat, flat ⇔ lax and oplax;
-- flat ⇒ internal should follow from an axiom characterizing → maps as a subtype of →ᵣ/→ₗ maps.
--

open import Stdlib
open import Spine

-- the thickened spine inclusion ι_{𝐚,𝐛} : Sp_{n,𝐚,𝐛} → Δⁿ_{𝐚,𝐛}
thick-incl ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) → thick-spine a n b → thick-simplex a n b
thick-incl = thick-spine→thick-simplex

--
-- Restriction along ι, for each kind of arrow
--

segal-restr ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) (X : U) → (thick-simplex a n b → X) → (thick-spine a n b → X)
segal-restr a n b X g = pre (thick-spine a n b) g (thick-incl a n b)

segal-restr-flat ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) (X ∷ U) → ♭(thick-simplex a n b → X) → ♭(thick-spine a n b → X)
segal-restr-flat a n b X = flat-map (segal-restr a n b X)

segal-restr-r ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) (X ∷ U) → (thick-simplex a n b →ᵣ X) → (thick-spine a n b →ᵣ X)
segal-restr-r a n b X g =
  -- a crisp name for ι, so that the oplax application shares no free variable with its function
  let ι ∷ thick-spine a n b → thick-simplex a n b = thick-incl a n b in
  pre-r {thick-spine a n b} g ι

segal-restr-l ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) (X ∷ U) → (thick-simplex a n b →ₗ X) → (thick-spine a n b →ₗ X)
segal-restr-l a n b X g =
  -- a crisp name for ι, so that the lax application shares no free variable with its function
  let ι ∷ thick-spine a n b → thick-simplex a n b = thick-incl a n b in
  pre-l {thick-spine a n b} g ι

--
-- The four Segal conditions
--

-- internal Segalness: X is local, as a type, against every thickened spine inclusion
is-segal ∷ (X : U) → U
is-segal X = (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) →
  is-equiv {thick-simplex a n b → X} {thick-spine a n b → X} (segal-restr a n b X)

-- ♭-Segalness (global locality): only the global maps out of the shapes are tested
is-segal-flat ∷ (X ∷ U) → U
is-segal-flat X = (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) →
  is-equiv {♭(thick-simplex a n b → X)} {♭(thick-spine a n b → X)} (segal-restr-flat a n b X)

-- oplax Segalness: restriction of oplax maps out of the shapes is an equivalence
is-segal-r ∷ (X ∷ U) → U
is-segal-r X = (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) →
  is-equiv {thick-simplex a n b →ᵣ X} {thick-spine a n b →ᵣ X} (segal-restr-r a n b X)

-- lax Segalness: restriction of lax maps out of the shapes is an equivalence
is-segal-l ∷ (X ∷ U) → U
is-segal-l X = (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) →
  is-equiv {thick-simplex a n b →ₗ X} {thick-spine a n b →ₗ X} (segal-restr-l a n b X)

--
-- The unthickened oplax Segal condition: restriction (Δⁿ →ᵣ X) → (Spₙ →ᵣ X) along the spine
-- inclusion is an equivalence. It is the thickened condition with empty grids, conjugated by
-- the unit laws ⊤ ⊗ (− ⊗ ⊤) ≃ −, along which precomposition is an equivalence (pre-r-equiv).
--

spine-restr-r ∷ (n ∷ ℕ) (X ∷ U) → (simplex n →ᵣ X) → (spine n →ᵣ X)
spine-restr-r n X Ψ =
  let ι ∷ spine n → simplex n = spine→simplex n in
  pre-r {spine n} {simplex n} {X} Ψ ι

abstract is-segal-r-unthick ∷ (X ∷ U) → is-segal-r X → (n ∷ ℕ) → is-equiv (spine-restr-r n X)
is-segal-r-unthick X s n =
  let u ∷ thick-simplex nil n nil → simplex n = thicken-unit {simplex n} in
  let c ∷ spine n → thick-spine nil n nil = thicken-counit {spine n} in
  is-equiv-circ {simplex n →ᵣ X} {thick-spine nil n nil →ᵣ X} {spine n →ᵣ X}
    (λ ψ . pre-r {spine n} {thick-spine nil n nil} {X} ψ c)
    (λ Ψ . segal-restr-r nil n nil X (pre-r {thick-simplex nil n nil} {simplex n} {X} Ψ u))
    (pre-r-equiv (spine n) (thick-spine nil n nil) c (is-equiv-thicken-counit {spine n}) X)
    (is-equiv-circ {simplex n →ᵣ X} {thick-simplex nil n nil →ᵣ X} {thick-spine nil n nil →ᵣ X}
      (segal-restr-r nil n nil X)
      (λ Ψ . pre-r {thick-simplex nil n nil} {simplex n} {X} Ψ u)
      (s nil n nil)
      (pre-r-equiv (thick-simplex nil n nil) (simplex n) u (is-equiv-thicken-unit {simplex n}) X))

---
--- Arrow types are oplax-Segal
---
--- By currying, an oplax map Δⁿ_{𝐚,𝐛} →ᵣ (𝕀 →ᵣ A) is an oplax map Δⁿ_{𝐚,𝐛} ⊗ 𝕀 →ᵣ A, and
--- Δⁿ_{𝐚,𝐛} ⊗ 𝕀 is the thickened simplex Δⁿ_{𝐚,𝐛'} where 𝐛' = (𝐛, 1) extends 𝐛 by one factor
--- 𝕀 ≃ Δ¹ (judgmentally, grid (cons 1 𝐛) is □[𝐛] ⊗ Δ¹, see stdlib/Cube.batt). Both restrictions are conjugate, by currying, to the restriction
--- (□[𝐚] →ᵣ Δⁿ →ᵣ T) → (□[𝐚] →ᵣ Spₙ →ᵣ T) along the spine inclusion on the middle variable
--- (cur-restr), for T = □[𝐛] →ᵣ 𝕀 →ᵣ A and T = □[𝐛'] →ᵣ A, which are equivalent types.
---

--
-- currying thickened shapes
--

cur2 ∷ {Q S G T ∷ U} → (Q ⨂ (S ⨂ G) →ᵣ T) → (Q →ᵣ S →ᵣ G →ᵣ T)
cur2 {Q} {S} {G} {T} f = post-r {Q} {S ⨂ G →ᵣ T} {S →ᵣ G →ᵣ T} (tens-curry-right {S} {G} {T}) (tens-curry-right {Q} {S ⨂ G} {T} f)

abstract is-equiv-cur2 ∷ {Q S G T ∷ U} → is-equiv (cur2 {Q} {S} {G} {T})
is-equiv-cur2 {Q} {S} {G} {T} =
  is-equiv-circ (post-r {Q} {S ⨂ G →ᵣ T} {S →ᵣ G →ᵣ T} (tens-curry-right {S} {G} {T})) (tens-curry-right {Q} {S ⨂ G} {T})
    (post-r-equiv Q {S ⨂ G →ᵣ T} {S →ᵣ G →ᵣ T} (tens-curry-right {S} {G} {T}) (snd _ (tens-curry-equiv-right {S} {G} {T})))
    (snd _ (tens-curry-equiv-right {Q} {S ⨂ G} {T}))

-- the restriction along a map of the middle factor, curried
cur-restr ∷ {Q S S' T ∷ U} (ι ∷ S' → S) → (Q →ᵣ S →ᵣ T) → (Q →ᵣ S' →ᵣ T)
cur-restr {Q} {S} {S'} {T} ι k q s = k q (ι s)

cur-segal-restr ∷ (a ∷ List ℕ) (n ∷ ℕ) (b ∷ List ℕ) (X ∷ U) (f : thick-simplex a n b →ᵣ X) →
  cur2 {grid a} {spine n} {grid b} {X} (segal-restr-r a n b X f)
    ≡ cur-restr {grid a} {simplex n} {spine n} {grid b →ᵣ X} (spine→simplex n) (cur2 {grid a} {simplex n} {grid b} {X} f)
cur-segal-restr a n b X f = refl

-- postcomposition with a crisp equivalence of the target
abstract cur-restr-equiv ∷ {Q S S' ∷ U} (ι ∷ S' → S) {T T' ∷ U} (h ∷ T → T') (eh ∷ is-equiv h) →
  is-equiv (cur-restr {Q} {S} {S'} {T} ι) → is-equiv (cur-restr {Q} {S} {S'} {T'} ι)
cur-restr-equiv {Q} {S} {S'} ι {T} {T'} h eh e =
  is-equiv-conj (cur-restr {Q} {S} {S'} {T} ι) (cur-restr {Q} {S} {S'} {T'} ι)
    (post-r {Q} {S →ᵣ T} {S →ᵣ T'} (post-r {S} {T} {T'} h)) (post-r {Q} {S' →ᵣ T} {S' →ᵣ T'} (post-r {S'} {T} {T'} h))
    (λ k . refl)
    (post-r-equiv Q {S →ᵣ T} {S →ᵣ T'} (post-r {S} {T} {T'} h) (post-r-equiv S {T} {T'} h eh))
    (post-r-equiv Q {S' →ᵣ T} {S' →ᵣ T'} (post-r {S'} {T} {T'} h) (post-r-equiv S' {T} {T'} h eh))
    e

--
-- The interval as the 1-simplex
--

𝕀→simplex-1 ∷ 𝕀 → simplex 1
𝕀→simplex-1 t = ((t , tt) , tt)

simplex-1→𝕀 ∷ simplex 1 → 𝕀
simplex-1→𝕀 x = prod-fst {𝕀} {⊤} (fst (is-sorted 0) x)

simplex-1-eta-aux ∷ (t : 𝕀) (u v : ⊤) → ((t , tt) , tt) ≡{simplex 1} ((t , u) , v)
simplex-1-eta-aux t = λ tt . λ tt . refl

simplex-1-eta' ∷ (c : 𝕀 × ⊤) (v : ⊤) → 𝕀→simplex-1 (simplex-1→𝕀 (c , v)) ≡ (c , v)
simplex-1-eta' (t , u) v = simplex-1-eta-aux t u v

simplex-1-eta ∷ (x : simplex 1) → 𝕀→simplex-1 (simplex-1→𝕀 x) ≡ x
simplex-1-eta (c , v) = simplex-1-eta' c v

is-equiv-𝕀→simplex-1 ∷ is-equiv 𝕀→simplex-1
is-equiv-𝕀→simplex-1 = ((simplex-1→𝕀 , simplex-1-eta) , (simplex-1→𝕀 , λ t . refl))

--
-- Arrow types are oplax-Segal
--

abstract is-segal-arrᵣ ∷ {A ∷ U} → is-segal-r A → is-segal-r (arrᵣ A)
is-segal-arrᵣ {A} sA a n b =
  let c ∷ List ℕ = cons 1 b in
  let ι ∷ spine n → simplex n = spine→simplex n in
  -- grid c is grid b ⨂ simplex 1, judgmentally
  let e2 : is-equiv (cur-restr {grid a} {simplex n} {spine n} {grid b ⨂ simplex 1 →ᵣ A} ι) =
    is-equiv-conj (segal-restr-r a n c A) (cur-restr {grid a} {simplex n} {spine n} {grid c →ᵣ A} ι)
      (cur2 {grid a} {simplex n} {grid c} {A}) (cur2 {grid a} {spine n} {grid c} {A})
      (λ f . refl) (is-equiv-cur2 {grid a} {simplex n} {grid c} {A}) (is-equiv-cur2 {grid a} {spine n} {grid c} {A})
      (sA a n c) in
  let e3 : is-equiv (cur-restr {grid a} {simplex n} {spine n} {grid b →ᵣ simplex 1 →ᵣ A} ι) =
    cur-restr-equiv {grid a} {simplex n} {spine n} ι {grid b ⨂ simplex 1 →ᵣ A} {grid b →ᵣ simplex 1 →ᵣ A}
      (tens-curry-right {grid b} {simplex 1} {A}) (snd _ (tens-curry-equiv-right {grid b} {simplex 1} {A})) e2 in
  let e4 : is-equiv (cur-restr {grid a} {simplex n} {spine n} {grid b →ᵣ arrᵣ A} ι) =
    cur-restr-equiv {grid a} {simplex n} {spine n} ι {grid b →ᵣ simplex 1 →ᵣ A} {grid b →ᵣ arrᵣ A}
      (post-r {grid b} {simplex 1 →ᵣ A} {𝕀 →ᵣ A} (λ φ . pre-r {𝕀} {simplex 1} {A} φ 𝕀→simplex-1))
      (post-r-equiv (grid b) {simplex 1 →ᵣ A} {𝕀 →ᵣ A} (λ φ . pre-r {𝕀} {simplex 1} {A} φ 𝕀→simplex-1)
        (pre-r-equiv 𝕀 (simplex 1) 𝕀→simplex-1 is-equiv-𝕀→simplex-1 A)) e3 in
  is-equiv-conj' (segal-restr-r a n b (arrᵣ A)) (cur-restr {grid a} {simplex n} {spine n} {grid b →ᵣ arrᵣ A} ι)
    (cur2 {grid a} {simplex n} {grid b} {arrᵣ A}) (cur2 {grid a} {spine n} {grid b} {arrᵣ A})
    (λ f . refl) (is-equiv-cur2 {grid a} {simplex n} {grid b} {arrᵣ A}) (is-equiv-cur2 {grid a} {spine n} {grid b} {arrᵣ A})
    e4
