--
-- The hom family
--
-- For a crisp a : A, the representable family hom a over A has total space Σ (x : A) . hom a x
-- (the coslice of A under a, see Coslice.batt). An arrow f = (t , e0 , e1) : hom a x lifts to the
-- connection of f in the total space,
--
--   Γ̄_f := λ i . (t i , (λ j . t (i ∧ j) , e0 , refl)) : (t 0 , (λ j . t 0 , e0 , refl)) → (t 1 , (t , e0 , refl))
--
-- whose underlying square is the connection Γ_t (Connection.batt). The source is the identity at a
-- (up to e0) and the target is f (up to e1).
--
-- Γ̄_f is cocartesian for the projection to A: this is the hom fibration proposition of BATT.tex
-- (prop:hom_fib), which follows from the fold lemma (fold-lemma, Fold.batt: Γ_t is
-- ev₁-cocartesian in 𝕀 →ᵣ A) by base change along a : 1 → A and ev₀ (lem:cocart_arrow_comp_fib,
-- lem:cocart_arrow_base_change, lem:hom_pb). Formalizing this transfer requires the oplax universal
-- property of pullbacks (lem:pb_oplax_up) and coherences between hom types of pullbacks and
-- composition, so it is postulated here.
--
-- Postulates introduced: hom-fam-conn-cocart.
--

open import Stdlib
open import Hom
open import Segal
open import Fibration

-- the connection of f, as a 1-cell of the total space of the hom family
hom-fam-conn ∷ {A ∷ U} {a ∷ A} {x : A} (f : hom a x) → arrᵣ (Σ (y : A) . hom {A} a y)
hom-fam-conn {A} {a} {x} f =
  let t : arrᵣ A = hom-cell {A} {a} {x} f in
  let e0 : srcᵣ t ≡ a = hom-src {A} {a} {x} f in
  λ i . (t i , ((λ j . t (i 𝕀∧ j)) , e0 , refl))

-- [prop:hom_fib] the connection of f is cocartesian for the projection to A
postulate hom-fam-conn-cocart ∷ {A ∷ U} (sA : is-segalᵣ A) {a ∷ A} (sH : is-segalᵣ (Σ (y : A) . hom {A} a y))
  {x : A} (f : hom a x) →
  is-cocartesian {Σ (y : A) . hom {A} a y} {A} sH sA (fst (λ y . hom {A} a y))
    {srcᵣ (hom-fam-conn {A} {a} {x} f)} {tgtᵣ (hom-fam-conn {A} {a} {x} f)} (cell-hom {Σ (y : A) . hom {A} a y} (hom-fam-conn {A} {a} {x} f))

--
-- The connection, as a hom out of (a , id a)
--
--

conn-hom-src ∷ {A ∷ U} {a ∷ A} {b : A} (e : a ≡ b) {e' : b ≡ a} (κ : sym e ≡ e') →
  Σ (P : (b , ((λ j . b) , e' , refl)) ≡{Σ (y : A) . hom {A} a y} (a , Hom.id {A} a)) .
    cong {Σ (y : A) . hom {A} a y} {A} (fst (λ y . hom {A} a y)) P ≡ e'
conn-hom-src {A} {a} refl refl = (refl , refl)

conn-hom-tgt ∷ {A ∷ U} {a ∷ A} (c : arrᵣ A) (e0 : srcᵣ c ≡ a) {y : A} (e1 : tgtᵣ c ≡ y) →
  Σ (Q : (tgtᵣ c , (c , e0 , refl)) ≡{Σ (y : A) . hom {A} a y} (y , (c , e0 , e1))) .
    cong {Σ (y : A) . hom {A} a y} {A} (fst (λ y . hom {A} a y)) Q ≡ e1
conn-hom-tgt {A} {a} c e0 refl = (refl , refl)

conn-hom-fam ∷ {A ∷ U} {a ∷ A} (c : arrᵣ A) (e0 : srcᵣ c ≡ a) {y : A} (e1 : tgtᵣ c ≡ y) →
  hom {Σ (y : A) . hom {A} a y} (a , Hom.id {A} a) (y , (c , e0 , e1))
conn-hom-fam {A} {a} c e0 {y} e1 =
  (hom-fam-conn {A} {a} {y} (c , e0 , e1) ,
   fst _ (conn-hom-src {A} {a} {srcᵣ c} (sym e0) {e0} (sym-sym e0)) ,
   fst _ (conn-hom-tgt {A} {a} c e0 {y} e1))

-- it lies over (c , e0 , e1)
conn-hom-fam-over ∷ {A ∷ U} {a ∷ A} (c : arrᵣ A) (e0 : srcᵣ c ≡ a) {y : A} (e1 : tgtᵣ c ≡ y) →
  hom-map {Σ (y : A) . hom {A} a y} {A} (fst (λ y . hom {A} a y)) {a , Hom.id {A} a} {y , (c , e0 , e1)}
    (conn-hom-fam {A} {a} c e0 {y} e1) ≡ (c , e0 , e1)
conn-hom-fam-over {A} {a} c e0 {y} e1 =
  cong2 {srcᵣ c ≡ a} {tgtᵣ c ≡ y} {hom a y} (λ p q . (c , p , q))
    (snd _ (conn-hom-src {A} {a} {srcᵣ c} (sym e0) {e0} (sym-sym e0)))
    (snd _ (conn-hom-tgt {A} {a} c e0 {y} e1))

conn-hom-fam-cocart ∷ {A ∷ U} (sA : is-segalᵣ A) {a ∷ A} (sH : is-segalᵣ (Σ (y : A) . hom {A} a y))
  (c : arrᵣ A) (e0 : srcᵣ c ≡ a) {y : A} (e1 : tgtᵣ c ≡ y) →
  is-cocartesian {Σ (y : A) . hom {A} a y} {A} sH sA (fst (λ y . hom {A} a y)) {a , Hom.id {A} a} {y , (c , e0 , e1)}
    (conn-hom-fam {A} {a} c e0 {y} e1)
conn-hom-fam-cocart {A} sA {a} sH c e0 {y} e1 =
  is-cocartesian-endpoints {Σ (y : A) . hom {A} a y} {A} sH sA (fst (λ y . hom {A} a y)) (hom-fam-conn {A} {a} {y} (c , e0 , e1))
    (fst _ (conn-hom-src {A} {a} {srcᵣ c} (sym e0) {e0} (sym-sym e0)))
    (fst _ (conn-hom-tgt {A} {a} c e0 {y} e1))
    (hom-fam-conn-cocart {A} sA {a} sH {y} (c , e0 , e1))
