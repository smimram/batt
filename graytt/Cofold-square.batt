--
-- Folding squares along a coconnection
--
-- Dually to Fold-square.batt: for a 2-simplex w of an oplax-Segal type C, with edges k : c → a,
-- t : a → b and long edge l : c → b, and any hom r : c → x, composing with the coconnection Γ'_t
-- on the right
--
--   cofold-sq : (Σ h . square r t k h) → (Σ h' . square r (id b) (k ; t) h')
--               (h , σ) ↦ (h ; id b , σ ; Γ'_t)
--
-- should be an equivalence, with inverse the vertical composite with the square
-- Z (i , j) = w (i , i ∧ j) from k to l (cofold-Z) below, whose right side is t; the two round
-- trips would be the exchange law applied to the grids
--
--      σ    | Γ'_t                τ | id b
--      id k | Γ_t                 Z | Γ'_t
--
-- where Γ_t is the connection. This file only contains the identifications of the composites of
-- the rows and columns of these grids, read off 2-simplices of arrows (cofold-Z-split,
-- cofold-tr-bl, cofold-bl-id, cofold-Z-bl); the map, its inverse and the round trips are not
-- formalised yet. The 2-simplex is extended by w (u , u ∧ v) (cofold-pt), so that the unit laws
-- appearing on shared sides are those of HomSquare.batt.
--
-- Postulates: those of the exchange law (objectwise-equiv, univalence, truncation, is-set-𝕀).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Unitality
open import Composable
open import Simplex-edges
open import HomSquare
open import Exchange
open import Square-paths

open Square

--
-- The 2-simplex on the whole square
--

cofold-pt ∷ 𝕀 → 𝕀 → simplex 2
cofold-pt u v = ((u , u 𝕀∧ v , tt) , (refl , tt))

cofold-nrm ∷ {C ∷ U} (w : simplex 2 →ᵣ C) → simplex 2 →ᵣ C
cofold-nrm w = λ y . w (cofold-pt (Simplex2.fst y) (Simplex2.snd y))

-- the composite of the first two edges is the long edge, read off the restriction
cofold-comp ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  comp-homᵣ sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w) ≡ simplex2-hom₀₂ w
cofold-comp sC w = comp-simplex2 sC (cofold-nrm w)

-- the right unit law for t, read off the 2-simplex t (y₁ ∨ y₂)
cofold-runit ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  comp-homᵣ sC (simplex2-hom₁₂ w) (Hom.id (w (Simplex2.edge₁₂ 𝕀1))) ≡ simplex2-hom₁₂ w
cofold-runit sC w = comp-simplex2 sC (λ y . w (Simplex2.edge₁₂ (Simplex2.fst y 𝕀∨ Simplex2.snd y)))

-- the square Z (i , j) = w (i , i ∧ j): left side the identity, right side t, bottom side k,
-- top side the long edge
cofold-Z ∷ {C ∷ U} (w : simplex 2 →ᵣ C) →
  square (Hom.id (w (Simplex2.edge₀₁ 𝕀0))) (simplex2-hom₁₂ w) (simplex2-hom₀₁ w) (simplex2-hom₀₂ w)
cofold-Z w = (of-arrᵣ (λ i . λ j . w (cofold-pt i j)) , refl)

--
-- Identifications of composites of squares
--

-- Z is the composite of the vertical identity on k and the connection on t
cofold-Z-split ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move refl refl (comp-homᵣ-runit C sC (simplex2-hom₀₁ w)) (cofold-comp sC w)
    (comp-h sC (id-v (simplex2-hom₀₁ w)) (connection-tr (simplex2-hom₁₂ w)))
  ≡ cofold-Z w
cofold-Z-split {C} sC w =
  let Ξ : simplex 2 →ᵣ arrᵣ C = λ y . λ j . w (cofold-pt (Simplex2.fst y) (Simplex2.snd y 𝕀∧ j)) in
  trans (sym (bdry-lr-move (Ξ (Simplex2.edge₀₁ 𝕀0)) (Ξ (Simplex2.edge₁₂ 𝕀1))
                (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} srcᵣ Ξ)) (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} tgtᵣ Ξ))
                (comp-h sC (id-v (simplex2-hom₀₁ w)) (connection-tr (simplex2-hom₁₂ w)))))
    (comp-h-simplex sC Ξ)

-- the connection on t below the coconnection on t is the horizontal identity on t
cofold-tr-bl ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move (comp-homᵣ-lunit C sC (simplex2-hom₁₂ w)) (cofold-runit sC w) refl refl
    (comp-v sC (connection-tr (simplex2-hom₁₂ w)) (connection-bl (simplex2-hom₁₂ w)))
  ≡ id-h (simplex2-hom₁₂ w)
cofold-tr-bl {C} sC w =
  let Φ : 𝕀 →ᵣ (simplex 2 →ᵣ C) = λ i . λ y . w (Simplex2.edge₁₂ ((i 𝕀∧ Simplex2.fst y) 𝕀∨ Simplex2.snd y)) in
  let s : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₀₁ 𝕀0) in
  let t : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₁₂ 𝕀1) in
  trans (sym (bdry-st-move s t Φ (comp-simplex2 sC (Φ 𝕀0)) (comp-simplex2 sC (Φ 𝕀1))
                (comp-v sC (connection-tr (simplex2-hom₁₂ w)) (connection-bl (simplex2-hom₁₂ w)))))
    (comp-v-simplex sC Φ)

-- the coconnection on t below the identity is the coconnection on t
cofold-bl-id ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move (cofold-runit sC w) (comp-homᵣ-lunit C sC (Hom.id (w (Simplex2.edge₁₂ 𝕀1)))) refl refl
    (comp-v sC (connection-bl (simplex2-hom₁₂ w)) (id-h (Hom.id (w (Simplex2.edge₁₂ 𝕀1)))))
  ≡ connection-bl (simplex2-hom₁₂ w)
cofold-bl-id {C} sC w =
  let Φ : 𝕀 →ᵣ (simplex 2 →ᵣ C) = λ i . λ y . w (Simplex2.edge₁₂ ((i 𝕀∨ Simplex2.fst y) 𝕀∨ Simplex2.snd y)) in
  let s : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₀₁ 𝕀0) in
  let t : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₁₂ 𝕀1) in
  trans (sym (bdry-st-move s t Φ (comp-simplex2 sC (Φ 𝕀0)) (comp-simplex2 sC (Φ 𝕀1))
                (comp-v sC (connection-bl (simplex2-hom₁₂ w)) (id-h (Hom.id (w (Simplex2.edge₁₂ 𝕀1)))))))
    (comp-v-simplex sC Φ)

-- Z followed by the coconnection on t is the vertical identity on the long edge
cofold-Z-bl ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move refl refl (cofold-comp sC w) (comp-homᵣ-runit C sC (simplex2-hom₀₂ w))
    (comp-h sC (cofold-Z w) (connection-bl (simplex2-hom₁₂ w)))
  ≡ id-v (simplex2-hom₀₂ w)
cofold-Z-bl {C} sC w =
  let Ξ : simplex 2 →ᵣ arrᵣ C = λ y . λ j . w (cofold-pt (Simplex2.fst y) (j 𝕀∨ Simplex2.snd y)) in
  trans (sym (bdry-lr-move (Ξ (Simplex2.edge₀₁ 𝕀0)) (Ξ (Simplex2.edge₁₂ 𝕀1))
                (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} srcᵣ Ξ)) (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} tgtᵣ Ξ))
                (comp-h sC (cofold-Z w) (connection-bl (simplex2-hom₁₂ w)))))
    (comp-h-simplex sC Ξ)
