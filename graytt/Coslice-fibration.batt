--
-- Coslices are Rezk, and the hom fibration
--
-- For crisp a and A oplax-Rezk:
--
--   - a/A is oplax-Segal and oplax-complete (is-segalᵣ-coslice, is-completeᵣ-coslice), as the pullback
--     of a : 1 → A along ev₀ (Local.batt);
--   - ev₁ : a/A → A is a cocartesian fibration (coslice-fibration).
--
-- Proof of the second point: the cocartesian lift for the codomain fibration has a constant source,
-- so it lifts to a/A (coslice-lift); it is cocartesian there by base change (a/A is a pullback) and
-- the composite lemma (is-cocartesian-circ, Fibration.batt), and lifts are unique since a/A is univalent.
--
-- Postulates relied on: fold-lemma, objectwise-equiv, pushout-up, univalence, truncation, is-set-𝕀.
--

open import Stdlib
open import Segal
open import Coslice

--
-- The coslice is a pullback, hence oplax-Segal and oplax-complete
--
-- a/A is the pullback of a : 1 → A along ev₀ : 𝕀 →ᵣ A → A, and pullbacks of oplax-Segal (resp.
-- oplax-complete) types are oplax-Segal (resp. oplax-complete) (Local.batt). The arrow type
-- 𝕀 →ᵣ A is oplax-Segal (resp. oplax-complete) when A is (is-segal-arrᵣ, is-complete-arrᵣ).
--

open import Point-pullback
open import Local
open import Complete

-- the coslice as the pullback of a : 1 → A along ev₀ (with the path in the other direction)
point-pullback→coslice ∷ {A ∷ U} (a ∷ A) → point-pullback {arrᵣ A} srcᵣ a → coslice a
point-pullback→coslice a w =
  (point-pullback-proj srcᵣ a w , sym (point-pullback-path srcᵣ a w))

is-equiv-point-pullback→coslice ∷ {A ∷ U} (a ∷ A) → is-equiv (point-pullback→coslice a)
is-equiv-point-pullback→coslice {A} a =
  let inv : coslice a → point-pullback {arrᵣ A} srcᵣ a = λ w . (coslice-cell w , sym (coslice-src w)) in
  ((inv , fun (f , d) → cong {f 𝕀0 ≡ a} {coslice a} (λ d' . (f , d')) (sym-sym d)) ,
   (inv , fun (f , d) → cong {a ≡ f 𝕀0} {point-pullback srcᵣ a} (λ d' . (f , d')) (sym-sym d)))

-- a/A is oplax-Segal when A is
is-segalᵣ-coslice ∷ {A ∷ U} → is-segalᵣ A → (a ∷ A) → is-segalᵣ (coslice a)
is-segalᵣ-coslice sA a =
  is-segalᵣ-equiv-cod (point-pullback→coslice a) (is-equiv-point-pullback→coslice a)
    (is-segalᵣ-equiv (point-pullback→pullback srcᵣ a) (is-equiv-point-pullback→pullback srcᵣ a)
      (is-segalᵣ-pullback (λ _ . a) srcᵣ is-segalᵣ-unit (is-segal-arrᵣ sA) sA))

-- a/A is oplax-complete when A is
is-completeᵣ-coslice ∷ {A ∷ U} → is-completeᵣ A → (a ∷ A) → is-completeᵣ (coslice a)
is-completeᵣ-coslice cA a =
  is-completeᵣ-equiv-cod (point-pullback→coslice a) (is-equiv-point-pullback→coslice a)
    (is-completeᵣ-equiv (point-pullback→pullback srcᵣ a) (is-equiv-point-pullback→pullback srcᵣ a)
      (is-completeᵣ-pullback (λ _ . a) srcᵣ is-completeᵣ-unit (is-complete-arrᵣ cA) cA))

--
-- The projection to A is a cocartesian fibration
--

open import Hom
open import Fibration
open import Fold
open import Transported-id
open import Pullback-hom
open import Base-change
open import Codomain
open import Univalent
open import Lift-unique
open import Complete-univalent

-- the source of the first arrow of a lifting datum for the codomain fibration
private
datum-src ∷ {A ∷ U} → pullback {arrᵣ A} tgtᵣ srcᵣ → A
datum-src {A} d = srcᵣ (fst {arrᵣ A} (λ y . Σ (u : arrᵣ A) . tgtᵣ y ≡ srcᵣ u) d)

-- lifting data for the codomain fibration, with a path from the source of the first arrow to a,
-- are lifting data for the coslice
private
coslice-lift-data ∷ {A ∷ U} (a ∷ A) (d : pullback {arrᵣ A} tgtᵣ srcᵣ) →
  datum-src d ≡ a → pullback {coslice a} coslice-tgt srcᵣ
coslice-lift-data a (y , r) δ = ((y , δ) , r)

-- paths of lifting data lift to the coslice
private
coslice-lift-data-path ∷ {A ∷ U} (a ∷ A) {d₀ d : pullback {arrᵣ A} tgtᵣ srcᵣ} (Q : d₀ ≡ d)
  (δ : datum-src d ≡ a) →
  coslice-lift-data a d₀ (trans (cong datum-src Q) δ) ≡ coslice-lift-data a d δ
coslice-lift-data-path a {d₀} Q =
  J d₀ (λ d' Q' . (δ : datum-src d' ≡ a) →
          coslice-lift-data a d₀ (trans (cong datum-src Q') δ) ≡ coslice-lift-data a d' δ)
    (λ δ . cong (coslice-lift-data a d₀) (trans-refl-l δ)) Q

-- the lift χ̄_σ := λ i . (χ_σ i , γ) of the square χ_σ (lift-sq, Codomain.batt) of a 2-simplex σ of A,
-- for a path γ from its first vertex to a, is cocartesian
coslice-lift-sq ∷ {A ∷ U} (sA : is-segalᵣ A) (a ∷ A) (σ : simplex 2 →ᵣ A) (γ : srcᵣ (lift-sq σ 𝕀0) ≡ a) →
  cocart-cell (is-segalᵣ-coslice sA a) sA coslice-tgt
coslice-lift-sq {A} sA a σ γ =
  let sY : is-segalᵣ (arrᵣ A) = is-segal-arrᵣ sA in
  let S ∷ U = coslice a in
  let χ : arrᵣ (arrᵣ A) = lift-sq σ in
  let χ-cell : arrᵣ S = λ i . (χ i , γ) in
  -- the same cell in the pullback of a along ev₀
  let S' ∷ U = point-pullback {arrᵣ A} srcᵣ a in
  let e ∷ S' → S = point-pullback→coslice a in
  let ee ∷ is-equiv e = is-equiv-point-pullback→coslice a in
  let sS' : is-segalᵣ S' = is-segalᵣ-equiv e ee (is-segalᵣ-coslice sA a) in
  let ι ∷ S' → arrᵣ A = point-pullback-proj srcᵣ a in
  let χ' : arrᵣ S' = λ i . (χ i , sym γ) in
  -- it is ι-cocartesian (base change lemma), and its image is ev₁-cocartesian (codomain fibration)
  let cι : is-cocartesian sS' sY ι (cell-hom χ') =
    is-cocartesian-point-pullback-proj sY sA srcᵣ a sS' (cell-hom χ') in
  let cq : is-cocartesian sY sA tgtᵣ (hom-map ι (cell-hom χ')) =
    lift-sq-cocart sA σ in
  -- hence (ev₁ ∘ ι)-cocartesian (is-cocartesian-circ), and so is its image in the coslice
  let c' : is-cocartesian sS' sA (λ w . tgtᵣ (ι w)) (cell-hom χ') =
    is-cocartesian-circ sS' sY sA ι tgtᵣ (cell-hom χ') cι cq in
  let c0 : is-cocartesian (is-segalᵣ-coslice sA a) sA coslice-tgt (hom-map e (cell-hom χ')) =
    is-cocartesian-equiv sS' (is-segalᵣ-coslice sA a) sA e ee coslice-tgt (cell-hom χ') c' in
  (χ-cell ,
   subst (λ c . is-cocartesian (is-segalᵣ-coslice sA a) sA coslice-tgt (cell-hom {S} c))
     (cong {srcᵣ (χ 𝕀0) ≡ a} {arrᵣ S} (λ γ' . λ i . (χ i , γ')) (sym-sym γ)) c0)

-- the cocartesian lift of a lifting datum of the coslice: χ̄_σ for the 2-simplex σ of the codomain lift
coslice-lift ∷ {A ∷ U} (sA : is-segalᵣ A) (a ∷ A) →
  pullback {coslice a} coslice-tgt srcᵣ → cocart-cell (is-segalᵣ-coslice sA a) sA coslice-tgt
coslice-lift {A} sA a (w , r) =
  let k : (w : coslice a) (r : Σ (u : arrᵣ A) . coslice-tgt w ≡ srcᵣ u) → cocart-cell (is-segalᵣ-coslice sA a) sA coslice-tgt =
    fun (y , δ) r →
      let d : pullback {arrᵣ A} tgtᵣ srcᵣ = (y , r) in
      let σ : simplex 2 →ᵣ A = lift-simplex sA d in
      -- the source of χ_σ is constant, and is sent to a by the path of the codomain lift
      let γ : srcᵣ (lift-sq σ 𝕀0) ≡ a = trans (cong datum-src (codomain-lift-over sA d)) δ in
      coslice-lift-sq sA a σ γ
  in
  k w r

-- it lies over the datum
coslice-lift-over ∷ {A ∷ U} (sA : is-segalᵣ A) (a ∷ A) (w : pullback {coslice a} coslice-tgt srcᵣ) →
  cocart-cell-lift (is-segalᵣ-coslice sA a) sA coslice-tgt (coslice-lift sA a w) ≡ w
coslice-lift-over {A} sA a (w , r) =
  let k : (w : coslice a) (r : Σ (u : arrᵣ A) . coslice-tgt w ≡ srcᵣ u) →
          cocart-cell-lift (is-segalᵣ-coslice sA a) sA coslice-tgt (coslice-lift sA a (w , r)) ≡ (w , r) =
    fun (y , δ) r → coslice-lift-data-path a (codomain-lift-over sA (y , r)) δ in
  k w r

-- every arrow of A has a cocartesian lift at every object of the coslice
coslice-lift-section ∷ {A ∷ U} (sA : is-segalᵣ A) (a ∷ A) →
  section (cocart-cell-lift (is-segalᵣ-coslice sA a) sA coslice-tgt)
coslice-lift-section sA a = (coslice-lift sA a , coslice-lift-over sA a)

-- the projection of a coslice is a cocartesian fibration when the coslice is univalent
coslice-fibration-univalent ∷ {A ∷ U} (sA : is-segalᵣ A) (a ∷ A) →
  is-univalentᵣ (coslice a) (is-segalᵣ-coslice sA a) → is-cocartesian-fibration (is-segalᵣ-coslice sA a) sA coslice-tgt
coslice-fibration-univalent sA a u =
  is-cocartesian-fibration-univalent (is-segalᵣ-coslice sA a) sA coslice-tgt u (coslice-lift-section sA a)

open import Rezk

-- for A oplax-Rezk, the projection of the coslice is a cocartesian fibration
coslice-fibration ∷ {A ∷ U} (rA : is-rezkᵣ A) (a ∷ A) →
  is-cocartesian-fibration (is-segalᵣ-coslice (rezk-segalᵣ rA) a) (rezk-segalᵣ rA) coslice-tgt
coslice-fibration {A} rA a =
  let sA : is-segalᵣ A = rezk-segalᵣ rA in
  coslice-fibration-univalent sA a
    (complete→univalentᵣ (coslice a) (is-segalᵣ-coslice sA a) (is-completeᵣ-coslice (rezk-completeᵣ rA) a))
