--
-- Coslices
--
-- The coslice of a crisp type A under a : A, i.e. the type of 1-cells of A starting at a:
--
--   a/A := Σ (f : 𝕀 →ᵣ A) . f 0 ≡ a
--
-- with its projections. That a/A is oplax-Rezk and that ev₁ : a/A → A is a cocartesian fibration is
-- in Coslice-fibration.batt.
--

open import Stdlib

coslice ∷ {A ∷ U} (a : A) → U
coslice {A} a = Σ (f : arrᵣ A) . srcᵣ f ≡ a

-- the underlying 1-cell
coslice-cell ∷ {A ∷ U} {a : A} → coslice a → (arrᵣ A)
coslice-cell {A} {a} s = fst {𝕀 →ᵣ A} (λ f . srcᵣ f ≡ a) s

-- its source is a
coslice-src ∷ {A ∷ U} {a : A} (s : coslice a) → srcᵣ (coslice-cell {A} {a} s) ≡ a
coslice-src {A} {a} s = snd {arrᵣ A} (λ f . srcᵣ f ≡ a) s

-- evaluation at the target
coslice-tgt ∷ {A ∷ U} {a : A} → coslice a → A
coslice-tgt s = tgtᵣ (coslice-cell s)

-- the identity of a, as an object of the coslice
coslice-id ∷ {A ∷ U} (a : A) → coslice a
coslice-id a = ((λ t . a) , refl)
