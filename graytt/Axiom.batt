--
-- Axioms
--
-- The axioms of the theory, each with a comment. Postulates of the standard library (univalence,
-- truncation, pushouts, properties of the interval) and the fold lemmas (Fold.batt) are not
-- repeated here.
--
-- Equivalences are objectwise: a crisp map f : X → Y is an equivalence as soon as postcomposition
-- with f is an equivalence on the global points ♭(□[𝐚] → −) of every grid. The converse is proved
-- (objectwise-equiv-converse).
--
-- Postulates introduced: objectwise-equiv.
--

open import Stdlib

-- postcomposition with f on the global points of a grid
objectwise-post ∷ {X Y ∷ U} (f ∷ X → Y) (a ∷ list ℕ) → ♭(grid a → X) → ♭(grid a → Y)
objectwise-post {X} {Y} f a = flat-map {grid a → X} {grid a → Y} (post {grid a} {X} {Y} f)

-- f is an objectwise equivalence
is-objectwise-equiv ∷ {X Y ∷ U} (f ∷ X → Y) → U
is-objectwise-equiv {X} {Y} f = (a ∷ list ℕ) → is-equiv (objectwise-post {X} {Y} f a)

-- postulate: equivalences are objectwise
postulate objectwise-equiv ∷ {X Y ∷ U} (f ∷ X → Y) → is-objectwise-equiv {X} {Y} f → is-equiv f

--
-- The converse
--

objectwise-equiv-converse ∷ {X Y ∷ U} (f ∷ X → Y) (e ∷ is-equiv f) → is-objectwise-equiv {X} {Y} f
objectwise-equiv-converse {X} {Y} f e a =
  flat-map-equiv {grid a → X} {grid a → Y} (post {grid a} {X} {Y} f) (post-equiv {X} {Y} f e (grid a))
