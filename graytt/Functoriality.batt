--
-- Functoriality of maps on hom types
--
-- A map p ∷ X → A between oplax-Segal types acts on homs (hom-map, written P below), and this
-- action commutes with composition (hom-map-comp, written fn below): for u : x → y, v : y → z,
--
--   fn u v : P (u ; v) ≡ P u ; P v
--
-- where u ; v is comp-homᵣ X sX u v (composition in diagrammatic order). This commutation is
-- coherent with associativity (hom-map-comp-assoc).
--
-- Both statements are proved on simplices, then extended to all composable pairs and triples,
-- since 2-simplices are composable pairs and 3-simplices are composable triples
-- (is-equiv-edges-2, is-equiv-edges-tri, Simplex-edges.batt).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Composable
open import Simplex-edges
open import Associativity

--
-- Action of a map on homs
--

hom-map ∷ {A B ∷ U} (f : A → B) {x y : A} → hom x y → hom (f x) (f y)
hom-map f u = (postᵣ f (hom-cell u) , cong f (hom-src u) , cong f (hom-tgt u))

-- the identity acts as the identity
hom-map-idfun ∷ {X ∷ U} {x y : X} (u : hom x y) → hom-map {X} {X} (λ z . z) {x} {y} u ≡ u
hom-map-idfun {X} {x} {y} (c , r) =
  let k : (r : (srcᵣ c ≡ x) × (tgtᵣ c ≡ y)) → hom-map {X} {X} (λ z . z) {x} {y} (c , r) ≡ (c , r) = fun (p , q) →
    cong2 {srcᵣ c ≡ x} {tgtᵣ c ≡ y} {hom x y} (λ p' q' . (c , p' , q')) (cong-id {X} p) (cong-id {X} q) in
  k r

--
-- Commutation with composition
--
-- On the edges of a 2-simplex Ψ, both P (Ψ₀₁ ; Ψ₁₂) and P Ψ₀₁ ; P Ψ₁₂ are the long edge
-- (comp-simplex-2, in X and in A). This extends to all composable pairs by transport along the
-- section of edges-2, and, the fibres of edges-2 being contractible, on the edges of a 2-simplex
-- the result is the commutation given by that 2-simplex (hom-map-comp-edges).
--

-- the statement, for a composable pair
hom-map-comp-stmt ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z)
  → U
hom-map-comp-stmt X A p sX sA {x} {y} {z} u v =
  hom-map p (comp-homᵣ X sX u v) ≡ comp-homᵣ A sA (hom-map p u) (hom-map p v)

-- the statement, as a family over composable pairs
pair-stmt ∷ (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A) → pairs X → U
pair-stmt X A p sX sA = pair-family X (λ y z t v w . hom-map-comp-stmt X A p sX sA {y} {z} {t} v w)

-- on the edges of a 2-simplex: both composites are the long edge
hom-map-comp-simplex ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (Ψ : simplex 2 →ᵣ X)
  → pair-stmt X A p sX sA (edges-2 {X} Ψ)
hom-map-comp-simplex X A p sX sA Ψ =
  trans (cong (hom-map p {Ψ (simplex-2-e₀₁ 𝕀0)} {Ψ (simplex-2-e₁₂ 𝕀1)}) (comp-simplex-2 X sX Ψ))
    (sym (comp-simplex-2 A sA (postᵣ {simplex 2} {X} {A} p Ψ)))

-- for an arbitrary composable pair, by transport along the section of the edges
hom-map-comp-def ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z)
  → hom-map p (comp-homᵣ X sX u v) ≡ comp-homᵣ A sA (hom-map p u) (hom-map p v)
hom-map-comp-def X A p sX sA {x} {y} {z} u v =
  let s : section (edges-2 {X}) = is-equiv-sec (edges-2 {X}) (is-equiv-edges-2 X sX) in
  let r : pairs X = (x , y , z , u , v) in
  subst (pair-stmt X A p sX sA) (snd (is-section (edges-2 {X})) s r)
    (hom-map-comp-simplex X A p sX sA (section-map (edges-2 {X}) s r))

-- frozen (as assoc-simplex-3): it does not unfold, but it is equal to its definition
hom-map-comp-freeze ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z)
  → Σ (e : hom-map p (comp-homᵣ X sX u v) ≡ comp-homᵣ A sA (hom-map p u) (hom-map p v)) .
      e ≡ hom-map-comp-def X A p sX sA {x} {y} {z} u v
hom-map-comp-freeze X A p sX sA {x} {y} {z} u v = (hom-map-comp-def X A p sX sA {x} {y} {z} u v , refl)

-- the action of p on homs commutes with composition
hom-map-comp ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z)
  → hom-map p (comp-homᵣ X sX u v) ≡ comp-homᵣ A sA (hom-map p u) (hom-map p v)
hom-map-comp X A p sX sA {x} {y} {z} u v = fst _ (hom-map-comp-freeze X A p sX sA {x} {y} {z} u v)

-- on the edges of a 2-simplex, it is the commutation given by that 2-simplex
hom-map-comp-edges ∷
  (X A ∷ U) (p : X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (Ψ : simplex 2 →ᵣ X)
  → hom-map-comp X A p sX sA (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ) ≡ hom-map-comp-simplex X A p sX sA Ψ
hom-map-comp-edges X A p sX sA Ψ =
  let s : section (edges-2 {X}) = is-equiv-sec (edges-2 {X}) (is-equiv-edges-2 X sX) in
  trans (snd _ (hom-map-comp-freeze X A p sX sA (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ)))
    (transfer-equiv (edges-2 {X}) (is-equiv-edges-2 X sX) (pair-stmt X A p sX sA) (hom-map-comp-simplex X A p sX sA) Ψ
      (section-map (edges-2 {X}) s (edges-2 {X} Ψ)) (snd (is-section (edges-2 {X})) s (edges-2 {X} Ψ)))

--
-- Faces of 2-simplices
--
-- A face path c : u ; v ≡ a in X has an image in A, going through the commutation:
--
--   P u ; P v ──(fn u v)⁻¹──→ P (u ; v) ──P c──→ P a
--
-- On a 2-simplex Ψ, the image of the face path of Ψ is the face path of p ∘ Ψ
-- (hom-map-comp-face): this is hom-map-comp-edges, solved for the face path of p ∘ Ψ.
--

-- the image of a face path
face-image ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z) {a : hom x z} (c : comp-homᵣ X sX u v ≡ a)
  → comp-homᵣ A sA (hom-map p u) (hom-map p v) ≡ hom-map p a
face-image X A p sX sA {x} {y} {z} u v {a} c =
  trans (sym (hom-map-comp X A p sX sA u v)) (cong (hom-map p {x} {z}) c)

-- solving f ≡ q · c⁻¹ for c
trans-solve ∷ {T : U} {x y : T} {z : T} (c : y ≡ z) (q : x ≡ z) {f : x ≡ y} → trans q (sym c) ≡ f → trans (sym f) q ≡ c
trans-solve {T} {x} {y} refl q refl = trans-sym-l q

hom-map-comp-face ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (Ψ : simplex 2 →ᵣ X)
  → face-image X A p sX sA (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ) (comp-simplex-2 X sX Ψ)
      ≡ comp-simplex-2 A sA (postᵣ {simplex 2} {X} {A} p Ψ)
hom-map-comp-face X A p sX sA Ψ =
  trans-solve (comp-simplex-2 A sA (postᵣ {simplex 2} {X} {A} p Ψ))
    (cong (hom-map p {Ψ (simplex-2-e₀₁ 𝕀0)} {Ψ (simplex-2-e₁₂ 𝕀1)}) (comp-simplex-2 X sX Ψ))
    (sym (hom-map-comp-edges X A p sX sA Ψ))

--
-- Coherence with associativity
--
-- For u : x → y, v : y → z, w : z → t, the commutation is coherent with associators αX in X and
-- αA in A when the following hexagon of paths in hom A (p x) (p t) commutes:
--
--   P ((u ; v) ; w) ─────────── P αX ──────────→ P (u ; (v ; w))
--          │                                            │
--   fn (u ; v) w                                 fn u (v ; w)
--          ↓                                            ↓
--   P (u ; v) ; P w                              P u ; P (v ; w)
--          │                                            │
--   (fn u v) ; P w                               P u ; (fn v w)
--          ↓                                            ↓
--   (P u ; P v) ; P w ─────────── αA ──────────→ P u ; (P v ; P w)
--
-- This holds for associators given by faces (hom-map-tetrahedron): if a, b, c are homs with paths
-- c3, c1, c2, c0 as for the faces of a 3-simplex (see assoc-of-faces, Associativity.batt), and the
-- paths c3', c1', c2', c0' in A are their images (face-image), then the hexagon commutes for
-- αX = assoc-of-faces c3 c1 c2 c0 and αA = assoc-of-faces c3' c1' c2' c0'.
--
-- The proof is by path induction: a, b and c are free, so that c3, c0 and c2 can be taken to be
-- refl (the tetrahedron degenerates, with a = u ; v, b = v ; w and c = u ; (v ; w)), and the
-- images c3', c0', c1', c2' are then given by the commutation. What remains is the path algebra
-- of tetra-alg, where everything cancels.
--
-- On the edges of a 3-simplex Θ, the associators are given by the faces of Θ and of p ∘ Θ
-- (comp-homᵣ-assoc-edges, Simplex-edges.batt), and the faces of p ∘ Θ are the images of the
-- faces of Θ (hom-map-comp-face): the hexagon commutes (assoc-coh-simplex). It extends to all
-- composable triples since 3-simplices are composable triples (hom-map-comp-assoc).
--

-- the hexagon, for given associators αX and αA
hom-map-hexagon ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z t : X} (u : hom x y) (v : hom y z) (w : hom z t)
  (αX : comp-homᵣ X sX (comp-homᵣ X sX u v) w ≡ comp-homᵣ X sX u (comp-homᵣ X sX v w))
  (αA : comp-homᵣ A sA (comp-homᵣ A sA (hom-map p u) (hom-map p v)) (hom-map p w)
          ≡ comp-homᵣ A sA (hom-map p u) (comp-homᵣ A sA (hom-map p v) (hom-map p w)))
  → U
hom-map-hexagon X A p sX sA {x} {y} {z} {t} u v w αX αA =
  trans (cong (hom-map p {x} {t}) αX)
    (trans (hom-map-comp X A p sX sA u (comp-homᵣ X sX v w))
      (cong (λ m . comp-homᵣ A sA {p x} {p y} {p t} (hom-map p u) m) (hom-map-comp X A p sX sA v w)))
  ≡ trans (hom-map-comp X A p sX sA (comp-homᵣ X sX u v) w)
      (trans (cong (λ m . comp-homᵣ A sA {p x} {p z} {p t} m (hom-map p w)) (hom-map-comp X A p sX sA u v))
        αA)

-- the path algebra of the degenerate tetrahedron
tetra-core ∷ {T : U} {t0 : T} {y4 : T} (F4 : t0 ≡ y4) {y1 : T} (F1 : t0 ≡ y1) →
  trans refl F1 ≡ trans F4 (trans refl (trans refl (trans (sym F4) (sym (sym F1)))))
tetra-core {T} {t0} refl refl = refl

-- the hexagon for the degenerate tetrahedron, with P = hom-map p, L = - ; P w, R = P u ; -,
-- g = fn u v, h = fn v w, F4 = fn (u ; v) w, F1 = fn u (v ; w), and c1 the remaining face
tetra-alg ∷
  {H S1 S2 T : U} (P : H → T) (L : S1 → T) (R : S2 → T)
  {s : S1} {s' : S1} (g : s ≡ s')
  {r : S2} {r' : S2} (h : r ≡ r')
  {k0 : H} {k1 : H} (c1 : k0 ≡ k1)
  (F4 : P k0 ≡ L s) (F1 : P k1 ≡ R r)
  → trans (cong P (trans refl c1)) (trans F1 (cong R h))
      ≡ trans F4 (trans (cong L g)
          (trans (cong L (sym g))
            (trans (trans (sym F4) (cong P c1))
              (trans (sym (sym F1)) (cong R (sym (sym h)))))))
tetra-alg {H} {S1} {S2} {T} P L R {s} refl {r} refl {k0} refl F4 F1 = tetra-core F4 F1

-- the hexagon commutes for associators given by faces and their images
hom-map-tetrahedron ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z t : X} (u : hom x y) (v : hom y z) (w : hom z t)
  -- the faces in X
  {a : hom x z} (c3 : comp-homᵣ X sX u v ≡ a)
  {b : hom y t} (c0 : comp-homᵣ X sX v w ≡ b)
  {c : hom x t} (c2 : comp-homᵣ X sX u b ≡ c)
  (c1 : comp-homᵣ X sX a w ≡ c)
  -- the faces in A are their images
  {c3' : comp-homᵣ A sA (hom-map p u) (hom-map p v) ≡ hom-map p a} (e3 : face-image X A p sX sA u v c3 ≡ c3')
  {c0' : comp-homᵣ A sA (hom-map p v) (hom-map p w) ≡ hom-map p b} (e0 : face-image X A p sX sA v w c0 ≡ c0')
  {c1' : comp-homᵣ A sA (hom-map p a) (hom-map p w) ≡ hom-map p c} (e1 : face-image X A p sX sA a w c1 ≡ c1')
  {c2' : comp-homᵣ A sA (hom-map p u) (hom-map p b) ≡ hom-map p c} (e2 : face-image X A p sX sA u b c2 ≡ c2')
  → hom-map-hexagon X A p sX sA u v w
      (assoc-of-faces X sX u v w {a} {b} {c} c3 c1 c2 c0)
      (assoc-of-faces A sA (hom-map p u) (hom-map p v) (hom-map p w) {hom-map p a} {hom-map p b} {hom-map p c} c3' c1' c2' c0')
hom-map-tetrahedron X A p sX sA {x} {y} {z} {t} u v w refl refl refl c1 refl refl refl refl =
  tetra-alg
    (hom-map p {x} {t})
    (λ m . comp-homᵣ A sA {p x} {p z} {p t} m (hom-map p w))
    (λ m . comp-homᵣ A sA {p x} {p y} {p t} (hom-map p u) m)
    (hom-map-comp X A p sX sA u v)
    (hom-map-comp X A p sX sA v w)
    c1
    (hom-map-comp X A p sX sA (comp-homᵣ X sX u v) w)
    (hom-map-comp X A p sX sA u (comp-homᵣ X sX v w))

-- the coherence, for a composable triple: the hexagon for the associators of X and A
assoc-coh-stmt ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z t : X} (u : hom x y) (v : hom y z) (w : hom z t)
  → U
assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w =
  hom-map-hexagon X A p sX sA u v w
    (comp-homᵣ-assoc X sX u v w)
    (comp-homᵣ-assoc A sA (hom-map p u) (hom-map p v) (hom-map p w))

-- on the edges of a 3-simplex Θ: the associators are given by the faces of Θ and of p ∘ Θ
assoc-coh-simplex ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  (Θ : simplex 3 →ᵣ X)
  → assoc-coh-stmt X A p sX sA (simplex-3-hom {X} simplex-3-e₀₁ Θ) (simplex-3-hom {X} simplex-3-e₁₂ Θ) (simplex-3-hom {X} simplex-3-e₂₃ Θ)
assoc-coh-simplex X A p sX sA Θ =
  let pΘ : simplex 3 →ᵣ A = postᵣ {simplex 3} {X} {A} p Θ in
  let u : hom (Θ (simplex-3-e₀₁ 𝕀0)) (Θ (simplex-3-e₀₁ 𝕀1)) = simplex-3-hom {X} simplex-3-e₀₁ Θ in
  let v : hom (Θ (simplex-3-e₁₂ 𝕀0)) (Θ (simplex-3-e₁₂ 𝕀1)) = simplex-3-hom {X} simplex-3-e₁₂ Θ in
  let w : hom (Θ (simplex-3-e₂₃ 𝕀0)) (Θ (simplex-3-e₂₃ 𝕀1)) = simplex-3-hom {X} simplex-3-e₂₃ Θ in
  let hexagon-for-αA : (comp-homᵣ A sA (comp-homᵣ A sA (hom-map p u) (hom-map p v)) (hom-map p w)
                          ≡ comp-homᵣ A sA (hom-map p u) (comp-homᵣ A sA (hom-map p v) (hom-map p w))) → U =
    λ αA . hom-map-hexagon X A p sX sA u v w (assoc-simplex-3-def X sX Θ) αA in
  let hexagon-for-αX : (comp-homᵣ X sX (comp-homᵣ X sX u v) w ≡ comp-homᵣ X sX u (comp-homᵣ X sX v w)) → U =
    λ αX . hom-map-hexagon X A p sX sA u v w αX (comp-homᵣ-assoc A sA (hom-map p u) (hom-map p v) (hom-map p w)) in
  -- the hexagon for the associators given by the faces of Θ and of p ∘ Θ
  let tetrahedron : hexagon-for-αA (assoc-simplex-3-def A sA pΘ) =
    hom-map-tetrahedron X A p sX sA u v w
      {simplex-3-hom {X} simplex-3-e₀₂ Θ} (simplex-3-face-path X sX simplex-3-d₃ Θ)
      {simplex-3-hom {X} simplex-3-e₁₃ Θ} (simplex-3-face-path X sX simplex-3-d₀ Θ)
      {simplex-3-hom {X} simplex-3-e₀₃ Θ} (simplex-3-face-path X sX simplex-3-d₂ Θ)
      (simplex-3-face-path X sX simplex-3-d₁ Θ)
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d₃ Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d₀ Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d₁ Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d₂ Θ))
  in
  -- the associators on the edges of Θ and of p ∘ Θ are the ones given by the faces
  subst hexagon-for-αX (sym (comp-homᵣ-assoc-edges X sX Θ))
    (subst hexagon-for-αA (sym (comp-homᵣ-assoc-edges A sA pΘ)) tetrahedron)

-- the coherence, as a family over composable triples
assoc-coh-tri ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A) → triples X → U
assoc-coh-tri X A p sX sA = tri-family X (λ x y z t u v w . assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w)

-- the commutation of p with composition is coherent with associativity: transport the coherence
-- on the edges of the 3-simplex filling the triple
hom-map-comp-assoc ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segalᵣ X) (sA : is-segalᵣ A)
  {x y z t : X} (u : hom x y) (v : hom y z) (w : hom z t)
  → assoc-coh-stmt X A p sX sA u v w
hom-map-comp-assoc X A p sX sA {x} {y} {z} {t} u v w =
  subst {triples X} (assoc-coh-tri X A p sX sA) (assoc-filler-edges X sX u v w)
    (assoc-coh-simplex X A p sX sA (assoc-filler X sX u v w))

--
-- Composite maps
--
-- For maps ι : X → Y and q : Y → A, the action on homs of q ∘ ι is the composite of the actions
-- (hom-map-circ), and the commutations with composition are coherent: the commutation for q ∘ ι
-- is the composite of the commutations for ι and q (hom-map-comp-circ). As for the coherence with
-- associativity, this is checked on the edges of a 2-simplex, where all the commutations are given
-- by the 2-simplex (hom-map-comp-edges), and transported to all composable pairs.
--

-- the action on homs of a composite map is the composite of the actions, up to the images of the
-- boundary paths
hom-map-circ-aux ∷ {X Y A ∷ U} (ι ∷ X → Y) (q ∷ Y → A) (c : arrᵣ X) {x : X} (e0 : srcᵣ c ≡ x) {y : X} (e1 : tgtᵣ c ≡ y) →
  hom-map {X} {A} (λ w . q (ι w)) {x} {y} (c , e0 , e1) ≡ hom-map {Y} {A} q {ι x} {ι y} (hom-map {X} {Y} ι {x} {y} (c , e0 , e1))
hom-map-circ-aux {X} {Y} {A} ι q c refl refl = refl

hom-map-circ ∷ {X Y A ∷ U} (ι ∷ X → Y) (q ∷ Y → A) {x y : X} (u : hom x y) →
  hom-map {X} {A} (λ w . q (ι w)) {x} {y} u ≡ hom-map {Y} {A} q {ι x} {ι y} (hom-map {X} {Y} ι {x} {y} u)
hom-map-circ {X} {Y} {A} ι q {x} {y} u =
  trans (cong {hom x y} {hom (q (ι x)) (q (ι y))} (hom-map {X} {A} (λ w . q (ι w)) {x} {y}) (sym (hom-eta {X} {x} {y} u)))
    (trans (hom-map-circ-aux {X} {Y} {A} ι q (hom-cell {X} {x} {y} u) (hom-src {X} {x} {y} u) (hom-tgt {X} {x} {y} u))
      (cong {hom x y} {hom (q (ι x)) (q (ι y))} (λ v . hom-map {Y} {A} q {ι x} {ι y} (hom-map {X} {Y} ι {x} {y} v)) (hom-eta {X} {x} {y} u)))

-- the coherence of the commutations with composition of ι, q and their composite
hom-map-comp-circ-stmt ∷
  (X Y A ∷ U) (ι ∷ X → Y) (q ∷ Y → A) (sX : is-segalᵣ X) (sY : is-segalᵣ Y) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z) → U
hom-map-comp-circ-stmt X Y A ι q sX sY sA {x} {y} {z} u v =
  hom-map-comp X A (λ w . q (ι w)) sX sA {x} {y} {z} u v
  ≡ trans (hom-map-circ {X} {Y} {A} ι q {x} {z} (comp-homᵣ X sX {x} {y} {z} u v))
      (trans (cong (hom-map {Y} {A} q {ι x} {ι z}) (hom-map-comp X Y ι sX sY {x} {y} {z} u v))
        (trans (hom-map-comp Y A q sY sA {ι x} {ι y} {ι z} (hom-map {X} {Y} ι {x} {y} u) (hom-map {X} {Y} ι {y} {z} v))
          (sym (cong2 (λ m n . comp-homᵣ A sA {q (ι x)} {q (ι y)} {q (ι z)} m n)
                 (hom-map-circ {X} {Y} {A} ι q {x} {y} u) (hom-map-circ {X} {Y} {A} ι q {y} {z} v)))))

-- the path algebra on the edges of a 2-simplex
circ-alg ∷ {H M T : U} (P : H → T) (I : H → M) (Q : M → T) (c : (h : H) → P h ≡ Q (I h))
  {h h' : H} (α : h ≡ h') {m : M} (β : I h' ≡ m) {t : T} (γ : Q (I h') ≡ t) →
  trans (cong P α) (trans (c h') γ) ≡ trans (c h) (trans (cong Q (trans (cong I α) β)) (trans (cong Q (sym β)) γ))
circ-alg {H} {M} {T} P I Q c {h} refl refl refl = trans-refl-l (c h)

hom-map-comp-circ-simplex ∷
  (X Y A ∷ U) (ι ∷ X → Y) (q ∷ Y → A) (sX : is-segalᵣ X) (sY : is-segalᵣ Y) (sA : is-segalᵣ A)
  (Ψ : simplex 2 →ᵣ X) →
  hom-map-comp-circ-stmt X Y A ι q sX sY sA (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ)
hom-map-comp-circ-simplex X Y A ι q sX sY sA Ψ =
  let x0 : X = Ψ (simplex-2-e₀₁ 𝕀0) in
  let x2 : X = Ψ (simplex-2-e₁₂ 𝕀1) in
  let ιΨ : simplex 2 →ᵣ Y = postᵣ {simplex 2} {X} {Y} ι Ψ in
  let P : hom x0 x2 → hom (q (ι x0)) (q (ι x2)) = hom-map {X} {A} (λ w . q (ι w)) {x0} {x2} in
  let I : hom x0 x2 → hom (ι x0) (ι x2) = hom-map {X} {Y} ι {x0} {x2} in
  let Q : hom (ι x0) (ι x2) → hom (q (ι x0)) (q (ι x2)) = hom-map {Y} {A} q {ι x0} {ι x2} in
  let qιΨ : simplex 2 →ᵣ A = postᵣ {simplex 2} {Y} {A} q ιΨ in
  let C : hom x0 x2 = comp-homᵣ X sX (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ) in
  let csX : C ≡ simplex-2-hom₀₂ {X} Ψ = comp-simplex-2 X sX Ψ in
  let csY : comp-homᵣ Y sY (simplex-2-hom₀₁ {Y} ιΨ) (simplex-2-hom₁₂ {Y} ιΨ) ≡ simplex-2-hom₀₂ {Y} ιΨ = comp-simplex-2 Y sY ιΨ in
  let csA : comp-homᵣ A sA (simplex-2-hom₀₁ {A} qιΨ) (simplex-2-hom₁₂ {A} qιΨ) ≡ simplex-2-hom₀₂ {A} qιΨ = comp-simplex-2 A sA qιΨ in
  let Eqι : hom-map-comp X A (λ w . q (ι w)) sX sA (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ) ≡ trans (cong P csX) (sym csA) =
    hom-map-comp-edges X A (λ w . q (ι w)) sX sA Ψ in
  let Eι : hom-map-comp X Y ι sX sY (simplex-2-hom₀₁ {X} Ψ) (simplex-2-hom₁₂ {X} Ψ) ≡ trans (cong I csX) (sym csY) =
    hom-map-comp-edges X Y ι sX sY Ψ in
  let Eq : hom-map-comp Y A q sY sA (simplex-2-hom₀₁ {Y} ιΨ) (simplex-2-hom₁₂ {Y} ιΨ) ≡ trans (cong Q csY) (sym csA) =
    hom-map-comp-edges Y A q sY sA ιΨ in
  let TA : hom (q (ι x0)) (q (ι x2)) = comp-homᵣ A sA (simplex-2-hom₀₁ {A} qιΨ) (simplex-2-hom₁₂ {A} qιΨ) in
  let CY : hom (ι x0) (ι x2) = comp-homᵣ Y sY (simplex-2-hom₀₁ {Y} ιΨ) (simplex-2-hom₁₂ {Y} ιΨ) in
  let e02A : hom (q (ι x0)) (q (ι x2)) = simplex-2-hom₀₂ {A} qιΨ in
  let e02Y : hom (ι x0) (ι x2) = simplex-2-hom₀₂ {Y} ιΨ in
  trans Eqι
    (trans (sym (cong {e02A ≡ TA} {P C ≡ TA} (λ z . trans (cong P csX) z) (trans-refl-l (sym csA))))
      (trans (circ-alg P I Q (hom-map-circ {X} {Y} {A} ι q {x0} {x2}) csX (sym csY) (sym csA))
        (cong {Q (I C) ≡ TA} {P C ≡ TA} (λ z . trans (hom-map-circ {X} {Y} {A} ι q {x0} {x2} C) z)
          (cong2 {I C ≡ CY} {Q CY ≡ TA} {Q (I C) ≡ TA} (λ k l . trans (cong Q k) l) (sym Eι)
            (trans (cong {CY ≡ e02Y} {Q CY ≡ TA} (λ w . trans (cong Q w) (sym csA)) (sym-sym csY)) (sym Eq))))))

hom-map-comp-circ ∷
  (X Y A ∷ U) (ι ∷ X → Y) (q ∷ Y → A) (sX : is-segalᵣ X) (sY : is-segalᵣ Y) (sA : is-segalᵣ A)
  {x y z : X} (u : hom x y) (v : hom y z) → hom-map-comp-circ-stmt X Y A ι q sX sY sA {x} {y} {z} u v
hom-map-comp-circ X Y A ι q sX sY sA {x} {y} {z} u v =
  let s : section (edges-2 {X}) = is-equiv-sec (edges-2 {X}) (is-equiv-edges-2 X sX) in
  let r : pairs X = (x , y , z , u , v) in
  subst (pair-family X (λ x' y' z' u' v' . hom-map-comp-circ-stmt X Y A ι q sX sY sA {x'} {y'} {z'} u' v'))
    (snd (is-section (edges-2 {X})) s r)
    (hom-map-comp-circ-simplex X Y A ι q sX sY sA (section-map (edges-2 {X}) s r))
