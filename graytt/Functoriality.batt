      (trans (cong {(hom-map {X} {A} p {x1} {x3}) b ≡ (hom-map {X} {A} p {x1} {x3}) (comp-hom-r X sX {x1} {x2} {x3} v w)} {(hom-map {X} {A} p {x1} {x3}) b ≡ (comp-hom-r A sA {p x1} {p x2} {p x3} ((hom-map {X} {A} p {x1} {x2}) v) ((hom-map {X} {A} p {x2} {x3}) w))} (λ e . trans e (trans (cong (hom-map {X} {A} p {x1} {x3}) c0) (sym c0'))) (cong-sym (hom-map {X} {A} p {x1} {x3}) c0))
