-- on the edges of a 3-simplex Θ: the faces of Θ and of p ∘ Θ
abstract assoc-coh-simplex ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A) (Θ : simplex 3 →ᵣ X) →
  assoc-coh-stmt X A p sX sA {Θ (simplex-3-e01 𝕀0)} {Θ (simplex-3-e12 𝕀0)} {Θ (simplex-3-e23 𝕀0)} {Θ (simplex-3-e23 𝕀1)} (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)
assoc-coh-simplex X A p sX sA Θ =
  assoc-coh-faces X A p sX sA {Θ (simplex-3-e01 𝕀0)} {Θ (simplex-3-e12 𝕀0)} {Θ (simplex-3-e23 𝕀0)} {Θ (simplex-3-e23 𝕀1)} (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)
    (simplex-3-hom {X} simplex-3-e02 Θ) (simplex-3-hom {X} simplex-3-e13 Θ) (simplex-3-hom {X} simplex-3-e03 Θ)
    (comp-simplex-2 X sX (simplex-3-face {X} simplex-3-d3 Θ)) (comp-simplex-2 X sX (simplex-3-face {X} simplex-3-d1 Θ)) (comp-simplex-2 X sX (simplex-3-face {X} simplex-3-d2 Θ)) (comp-simplex-2 X sX (simplex-3-face {X} simplex-3-d0 Θ))
    (comp-simplex-2 A sA (simplex-3-face {A} simplex-3-d3 (post-r {simplex 3} {X} {A} p Θ))) (comp-simplex-2 A sA (simplex-3-face {A} simplex-3-d1 (post-r {simplex 3} {X} {A} p Θ))) (comp-simplex-2 A sA (simplex-3-face {A} simplex-3-d2 (post-r {simplex 3} {X} {A} p Θ))) (comp-simplex-2 A sA (simplex-3-face {A} simplex-3-d0 (post-r {simplex 3} {X} {A} p Θ)))
    (hom-map-comp-edges X A p sX sA (simplex-3-face {X} simplex-3-d3 Θ)) (hom-map-comp-edges X A p sX sA (simplex-3-face {X} simplex-3-d1 Θ))
    (hom-map-comp-edges X A p sX sA (simplex-3-face {X} simplex-3-d2 Θ)) (hom-map-comp-edges X A p sX sA (simplex-3-face {X} simplex-3-d0 Θ))
    (trans (comp-hom-r-assoc-eq X sX {Θ (simplex-3-e01 𝕀0)} {Θ (simplex-3-e12 𝕀0)} {Θ (simplex-3-e23 𝕀0)} {Θ (simplex-3-e23 𝕀1)} (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ))
      (trans (transfer-equiv (edges-tri {X}) (is-equiv-edges-tri X sX) (tri-assoc X sX) (assoc-simplex-3 X sX) Θ
               (assoc-filler X sX {Θ (simplex-3-e01 𝕀0)} {Θ (simplex-3-e12 𝕀0)} {Θ (simplex-3-e23 𝕀0)} {Θ (simplex-3-e23 𝕀1)} (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)) (assoc-filler-edges X sX {Θ (simplex-3-e01 𝕀0)} {Θ (simplex-3-e12 𝕀0)} {Θ (simplex-3-e23 𝕀0)} {Θ (simplex-3-e23 𝕀1)} (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)))
        (assoc-simplex-3-eq X sX Θ)))
    (trans (comp-hom-r-assoc-eq A sA {p (Θ (simplex-3-e01 𝕀0))} {p (Θ (simplex-3-e12 𝕀0))} {p (Θ (simplex-3-e23 𝕀0))} {p (Θ (simplex-3-e23 𝕀1))} (simplex-3-hom {A} simplex-3-e01 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e12 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e23 (post-r {simplex 3} {X} {A} p Θ)))
      (trans (transfer-equiv (edges-tri {A}) (is-equiv-edges-tri A sA) (tri-assoc A sA) (assoc-simplex-3 A sA) (post-r {simplex 3} {X} {A} p Θ)
               (assoc-filler A sA {p (Θ (simplex-3-e01 𝕀0))} {p (Θ (simplex-3-e12 𝕀0))} {p (Θ (simplex-3-e23 𝕀0))} {p (Θ (simplex-3-e23 𝕀1))} (simplex-3-hom {A} simplex-3-e01 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e12 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e23 (post-r {simplex 3} {X} {A} p Θ))) (assoc-filler-edges A sA {p (Θ (simplex-3-e01 𝕀0))} {p (Θ (simplex-3-e12 𝕀0))} {p (Θ (simplex-3-e23 𝕀0))} {p (Θ (simplex-3-e23 𝕀1))} (simplex-3-hom {A} simplex-3-e01 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e12 (post-r {simplex 3} {X} {A} p Θ)) (simplex-3-hom {A} simplex-3-e23 (post-r {simplex 3} {X} {A} p Θ))))
        (assoc-simplex-3-eq A sA (post-r {simplex 3} {X} {A} p Θ))))

-- the coherence, as a family over composable triples
assoc-coh-tri ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A) → triples X → U
assoc-coh-tri X A p sX sA (x , a) =
  let h : (y : X) (b : hom X x y × pair-from X y) → U = fun y (u , c) →
    let h' : (z : X) (d : Σ (t : X) . hom X y z × hom X z t) → U = fun z (t , e) →
      let h'' : (e : hom X y z × hom X z t) → U = fun (v , w) → assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w in
      h'' e
    in
    h' (fst (λ z . Σ (t : X) . hom X y z × hom X z t) c) (snd (λ z . Σ (t : X) . hom X y z × hom X z t) c)
  in
  h (fst (λ y . hom X x y × pair-from X y) a) (snd (λ y . hom X x y × pair-from X y) a)

-- the functoriality of p on homs is coherent with associativity: transport the coherence on the
-- edges of the 3-simplex filling the triple
abstract hom-map-comp-assoc ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A) {x y z t : X}
  (u : hom X x y) (v : hom X y z) (w : hom X z t) → assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w
hom-map-comp-assoc X A p sX sA {x} {y} {z} {t} u v w =
  subst {triples X} (assoc-coh-tri X A p sX sA) (assoc-filler-edges X sX {x} {y} {z} {t} u v w)
    (assoc-coh-simplex X A p sX sA (assoc-filler X sX {x} {y} {z} {t} u v w))
