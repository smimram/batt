--
-- Functoriality of maps on hom types
--
-- A map p ∷ X → A between oplax-Segal types acts on homs (hom-map, written P below), and this
-- action commutes with composition (hom-map-comp, written fn below): for u : x → y, v : y → z,
--
--   fn u v : P (u ; v) ≡ P u ; P v
--
-- where u ; v is comp-hom-r X sX u v (composition in diagrammatic order). This commutation is
-- coherent with associativity (hom-map-comp-assoc).
--
-- Both statements are proved on simplices, then extended to all composable pairs and triples,
-- since 2-simplices are composable pairs and 3-simplices are composable triples
-- (is-equiv-edges-2, is-equiv-edges-tri, Simplex-edges.batt).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Composable
open import Simplex-edges
open import Associativity

--
-- Action of a map on homs
--

hom-map ∷ {X A ∷ U} (p ∷ X → A) {x y : X} → hom X x y → hom A (p x) (p y)
hom-map {X} {A} p {x} {y} u =
  (post-r {𝕀} {X} {A} p (hom-cell {X} {x} {y} u) ,
   cong p (hom-src {X} {x} {y} u) ,
   cong p (hom-tgt {X} {x} {y} u))

--
-- Commutation with composition
--
-- On the edges of a 2-simplex Ψ, both P (Ψ₀₁ ; Ψ₁₂) and P Ψ₀₁ ; P Ψ₁₂ are the long edge
-- (comp-simplex-2, in X and in A). This extends to all composable pairs by transport along the
-- section of edges-2, and, the fibres of edges-2 being contractible, on the edges of a 2-simplex
-- the result is the commutation given by that 2-simplex (hom-map-comp-edges).
--

-- the statement, for a composable pair
hom-map-comp-stmt ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z : X} (u : hom X x y) (v : hom X y z)
  → U
hom-map-comp-stmt X A p sX sA {x} {y} {z} u v =
  hom-map p (comp-hom-r X sX u v) ≡ comp-hom-r A sA (hom-map p u) (hom-map p v)

-- the statement, as a family over composable pairs
pair-stmt ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A) → pairs X → U
pair-stmt X A p sX sA = pair-family X (λ y z t v w . hom-map-comp-stmt X A p sX sA {y} {z} {t} v w)

-- on the edges of a 2-simplex: both composites are the long edge
hom-map-comp-simplex ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  (Ψ : simplex 2 →ᵣ X)
  → pair-stmt X A p sX sA (edges-2 {X} Ψ)
hom-map-comp-simplex X A p sX sA Ψ =
  trans (cong (hom-map p {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e12 𝕀1)}) (comp-simplex-2 X sX Ψ))
    (sym (comp-simplex-2 A sA (post-r {simplex 2} {X} {A} p Ψ)))

-- for an arbitrary composable pair, by transport along the section of the edges
hom-map-comp-def ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z : X} (u : hom X x y) (v : hom X y z)
  → hom-map p (comp-hom-r X sX u v) ≡ comp-hom-r A sA (hom-map p u) (hom-map p v)
hom-map-comp-def X A p sX sA {x} {y} {z} u v =
  let s : section (edges-2 {X}) = is-equiv-sec (edges-2 {X}) (is-equiv-edges-2 X sX) in
  let r : pairs X = (x , y , z , u , v) in
  subst (pair-stmt X A p sX sA) (snd (is-section (edges-2 {X})) s r)
    (hom-map-comp-simplex X A p sX sA (map-section (edges-2 {X}) s r))

-- frozen (as assoc-simplex-3): it does not unfold, but it is equal to its definition
hom-map-comp-freeze ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z : X} (u : hom X x y) (v : hom X y z)
  → Σ (e : hom-map p (comp-hom-r X sX u v) ≡ comp-hom-r A sA (hom-map p u) (hom-map p v)) .
      e ≡ hom-map-comp-def X A p sX sA {x} {y} {z} u v
hom-map-comp-freeze X A p sX sA {x} {y} {z} u v = (hom-map-comp-def X A p sX sA {x} {y} {z} u v , refl)

-- the action of p on homs commutes with composition
hom-map-comp ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z : X} (u : hom X x y) (v : hom X y z)
  → hom-map p (comp-hom-r X sX u v) ≡ comp-hom-r A sA (hom-map p u) (hom-map p v)
hom-map-comp X A p sX sA {x} {y} {z} u v = fst _ (hom-map-comp-freeze X A p sX sA {x} {y} {z} u v)

-- on the edges of a 2-simplex, it is the commutation given by that 2-simplex
hom-map-comp-edges ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  (Ψ : simplex 2 →ᵣ X)
  → hom-map-comp X A p sX sA (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ) ≡ hom-map-comp-simplex X A p sX sA Ψ
hom-map-comp-edges X A p sX sA Ψ =
  let s : section (edges-2 {X}) = is-equiv-sec (edges-2 {X}) (is-equiv-edges-2 X sX) in
  trans (snd _ (hom-map-comp-freeze X A p sX sA (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ)))
    (transfer-equiv (edges-2 {X}) (is-equiv-edges-2 X sX) (pair-stmt X A p sX sA) (hom-map-comp-simplex X A p sX sA) Ψ
      (map-section (edges-2 {X}) s (edges-2 {X} Ψ)) (snd (is-section (edges-2 {X})) s (edges-2 {X} Ψ)))

--
-- Faces of 2-simplices
--
-- A face path c : u ; v ≡ a in X has an image in A, going through the commutation:
--
--   P u ; P v ──(fn u v)⁻¹──→ P (u ; v) ──P c──→ P a
--
-- On a 2-simplex Ψ, the image of the face path of Ψ is the face path of p ∘ Ψ
-- (hom-map-comp-face): this is hom-map-comp-edges, solved for the face path of p ∘ Ψ.
--

-- the image of a face path
face-image ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z : X} (u : hom X x y) (v : hom X y z) {a : hom X x z} (c : comp-hom-r X sX u v ≡ a)
  → comp-hom-r A sA (hom-map p u) (hom-map p v) ≡ hom-map p a
face-image X A p sX sA {x} {y} {z} u v {a} c =
  trans (sym (hom-map-comp X A p sX sA u v)) (cong (hom-map p {x} {z}) c)

-- solving f ≡ q · c⁻¹ for c
trans-solve ∷ {T : U} {x y : T} {z : T} (c : y ≡ z) (q : x ≡ z) {f : x ≡ y} → trans q (sym c) ≡ f → trans (sym f) q ≡ c
trans-solve {T} {x} {y} refl q refl = trans-sym-l q

hom-map-comp-face ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  (Ψ : simplex 2 →ᵣ X)
  → face-image X A p sX sA (simplex-2-hom01 {X} Ψ) (simplex-2-hom12 {X} Ψ) (comp-simplex-2 X sX Ψ)
      ≡ comp-simplex-2 A sA (post-r {simplex 2} {X} {A} p Ψ)
hom-map-comp-face X A p sX sA Ψ =
  trans-solve (comp-simplex-2 A sA (post-r {simplex 2} {X} {A} p Ψ))
    (cong (hom-map p {Ψ (simplex-2-e01 𝕀0)} {Ψ (simplex-2-e12 𝕀1)}) (comp-simplex-2 X sX Ψ))
    (sym (hom-map-comp-edges X A p sX sA Ψ))

--
-- Coherence with associativity
--
-- For u : x → y, v : y → z, w : z → t, the commutation is coherent with associators αX in X and
-- αA in A when the following hexagon of paths in hom A (p x) (p t) commutes:
--
--   P ((u ; v) ; w) ─────────── P αX ──────────→ P (u ; (v ; w))
--          │                                            │
--   fn (u ; v) w                                 fn u (v ; w)
--          ↓                                            ↓
--   P (u ; v) ; P w                              P u ; P (v ; w)
--          │                                            │
--   (fn u v) ; P w                               P u ; (fn v w)
--          ↓                                            ↓
--   (P u ; P v) ; P w ─────────── αA ──────────→ P u ; (P v ; P w)
--
-- This holds for associators given by faces (hom-map-tetrahedron): if a, b, c are homs with paths
-- c3, c1, c2, c0 as for the faces of a 3-simplex (see assoc-of-faces, Associativity.batt), and the
-- paths c3', c1', c2', c0' in A are their images (face-image), then the hexagon commutes for
-- αX = assoc-of-faces c3 c1 c2 c0 and αA = assoc-of-faces c3' c1' c2' c0'.
--
-- The proof is by path induction: a, b and c are free, so that c3, c0 and c2 can be taken to be
-- refl (the tetrahedron degenerates, with a = u ; v, b = v ; w and c = u ; (v ; w)), and the
-- images c3', c0', c1', c2' are then given by the commutation. What remains is the path algebra
-- of tetra-alg, where everything cancels.
--
-- On the edges of a 3-simplex Θ, the associators are given by the faces of Θ and of p ∘ Θ
-- (comp-hom-r-assoc-edges, Simplex-edges.batt), and the faces of p ∘ Θ are the images of the
-- faces of Θ (hom-map-comp-face): the hexagon commutes (assoc-coh-simplex). It extends to all
-- composable triples since 3-simplices are composable triples (hom-map-comp-assoc).
--

-- the hexagon, for given associators αX and αA
hom-map-hexagon ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t)
  (αX : comp-hom-r X sX (comp-hom-r X sX u v) w ≡ comp-hom-r X sX u (comp-hom-r X sX v w))
  (αA : comp-hom-r A sA (comp-hom-r A sA (hom-map p u) (hom-map p v)) (hom-map p w)
          ≡ comp-hom-r A sA (hom-map p u) (comp-hom-r A sA (hom-map p v) (hom-map p w)))
  → U
hom-map-hexagon X A p sX sA {x} {y} {z} {t} u v w αX αA =
  trans (cong (hom-map p {x} {t}) αX)
    (trans (hom-map-comp X A p sX sA u (comp-hom-r X sX v w))
      (cong (λ m . comp-hom-r A sA {p x} {p y} {p t} (hom-map p u) m) (hom-map-comp X A p sX sA v w)))
  ≡ trans (hom-map-comp X A p sX sA (comp-hom-r X sX u v) w)
      (trans (cong (λ m . comp-hom-r A sA {p x} {p z} {p t} m (hom-map p w)) (hom-map-comp X A p sX sA u v))
        αA)

-- the path algebra of the degenerate tetrahedron
tetra-core ∷ {T : U} {t0 : T} {y4 : T} (F4 : t0 ≡ y4) {y1 : T} (F1 : t0 ≡ y1) →
  trans refl F1 ≡ trans F4 (trans refl (trans refl (trans (sym F4) (sym (sym F1)))))
tetra-core {T} {t0} refl refl = refl

-- the hexagon for the degenerate tetrahedron, with P = hom-map p, L = - ; P w, R = P u ; -,
-- g = fn u v, h = fn v w, F4 = fn (u ; v) w, F1 = fn u (v ; w), and c1 the remaining face
tetra-alg ∷
  {H S1 S2 T : U} (P : H → T) (L : S1 → T) (R : S2 → T)
  {s : S1} {s' : S1} (g : s ≡ s')
  {r : S2} {r' : S2} (h : r ≡ r')
  {k0 : H} {k1 : H} (c1 : k0 ≡ k1)
  (F4 : P k0 ≡ L s) (F1 : P k1 ≡ R r)
  → trans (cong P (trans refl c1)) (trans F1 (cong R h))
      ≡ trans F4 (trans (cong L g)
          (trans (cong L (sym g))
            (trans (trans (sym F4) (cong P c1))
              (trans (sym (sym F1)) (cong R (sym (sym h)))))))
tetra-alg {H} {S1} {S2} {T} P L R {s} refl {r} refl {k0} refl F4 F1 = tetra-core F4 F1

-- the hexagon commutes for associators given by faces and their images
hom-map-tetrahedron ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t)
  -- the faces in X
  {a : hom X x z} (c3 : comp-hom-r X sX u v ≡ a)
  {b : hom X y t} (c0 : comp-hom-r X sX v w ≡ b)
  {c : hom X x t} (c2 : comp-hom-r X sX u b ≡ c)
  (c1 : comp-hom-r X sX a w ≡ c)
  -- the faces in A are their images
  {c3' : comp-hom-r A sA (hom-map p u) (hom-map p v) ≡ hom-map p a} (e3 : face-image X A p sX sA u v c3 ≡ c3')
  {c0' : comp-hom-r A sA (hom-map p v) (hom-map p w) ≡ hom-map p b} (e0 : face-image X A p sX sA v w c0 ≡ c0')
  {c1' : comp-hom-r A sA (hom-map p a) (hom-map p w) ≡ hom-map p c} (e1 : face-image X A p sX sA a w c1 ≡ c1')
  {c2' : comp-hom-r A sA (hom-map p u) (hom-map p b) ≡ hom-map p c} (e2 : face-image X A p sX sA u b c2 ≡ c2')
  → hom-map-hexagon X A p sX sA u v w
      (assoc-of-faces X sX u v w {a} {b} {c} c3 c1 c2 c0)
      (assoc-of-faces A sA (hom-map p u) (hom-map p v) (hom-map p w) {hom-map p a} {hom-map p b} {hom-map p c} c3' c1' c2' c0')
hom-map-tetrahedron X A p sX sA {x} {y} {z} {t} u v w refl refl refl c1 refl refl refl refl =
  tetra-alg
    (hom-map p {x} {t})
    (λ m . comp-hom-r A sA {p x} {p z} {p t} m (hom-map p w))
    (λ m . comp-hom-r A sA {p x} {p y} {p t} (hom-map p u) m)
    (hom-map-comp X A p sX sA u v)
    (hom-map-comp X A p sX sA v w)
    c1
    (hom-map-comp X A p sX sA (comp-hom-r X sX u v) w)
    (hom-map-comp X A p sX sA u (comp-hom-r X sX v w))

-- the coherence, for a composable triple: the hexagon for the associators of X and A
assoc-coh-stmt ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t)
  → U
assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w =
  hom-map-hexagon X A p sX sA u v w
    (comp-hom-r-assoc X sX u v w)
    (comp-hom-r-assoc A sA (hom-map p u) (hom-map p v) (hom-map p w))

-- on the edges of a 3-simplex Θ: the associators are given by the faces of Θ and of p ∘ Θ
assoc-coh-simplex ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  (Θ : simplex 3 →ᵣ X)
  → assoc-coh-stmt X A p sX sA (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)
assoc-coh-simplex X A p sX sA Θ =
  let pΘ : simplex 3 →ᵣ A = post-r {simplex 3} {X} {A} p Θ in
  let u : hom X (Θ (simplex-3-e01 𝕀0)) (Θ (simplex-3-e01 𝕀1)) = simplex-3-hom {X} simplex-3-e01 Θ in
  let v : hom X (Θ (simplex-3-e12 𝕀0)) (Θ (simplex-3-e12 𝕀1)) = simplex-3-hom {X} simplex-3-e12 Θ in
  let w : hom X (Θ (simplex-3-e23 𝕀0)) (Θ (simplex-3-e23 𝕀1)) = simplex-3-hom {X} simplex-3-e23 Θ in
  let hexagon-for-αA : (comp-hom-r A sA (comp-hom-r A sA (hom-map p u) (hom-map p v)) (hom-map p w)
                          ≡ comp-hom-r A sA (hom-map p u) (comp-hom-r A sA (hom-map p v) (hom-map p w))) → U =
    λ αA . hom-map-hexagon X A p sX sA u v w (assoc-simplex-3-def X sX Θ) αA in
  let hexagon-for-αX : (comp-hom-r X sX (comp-hom-r X sX u v) w ≡ comp-hom-r X sX u (comp-hom-r X sX v w)) → U =
    λ αX . hom-map-hexagon X A p sX sA u v w αX (comp-hom-r-assoc A sA (hom-map p u) (hom-map p v) (hom-map p w)) in
  -- the hexagon for the associators given by the faces of Θ and of p ∘ Θ
  let tetrahedron : hexagon-for-αA (assoc-simplex-3-def A sA pΘ) =
    hom-map-tetrahedron X A p sX sA u v w
      {simplex-3-hom {X} simplex-3-e02 Θ} (simplex-3-face-path X sX simplex-3-d3 Θ)
      {simplex-3-hom {X} simplex-3-e13 Θ} (simplex-3-face-path X sX simplex-3-d0 Θ)
      {simplex-3-hom {X} simplex-3-e03 Θ} (simplex-3-face-path X sX simplex-3-d2 Θ)
      (simplex-3-face-path X sX simplex-3-d1 Θ)
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d3 Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d0 Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d1 Θ))
      (hom-map-comp-face X A p sX sA (simplex-3-face {X} simplex-3-d2 Θ))
  in
  -- the associators on the edges of Θ and of p ∘ Θ are the ones given by the faces
  subst hexagon-for-αX (sym (comp-hom-r-assoc-edges X sX Θ))
    (subst hexagon-for-αA (sym (comp-hom-r-assoc-edges A sA pΘ)) tetrahedron)

-- the coherence, as a family over composable triples
assoc-coh-tri ∷ (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A) → triples X → U
assoc-coh-tri X A p sX sA = tri-family X (λ x y z t u v w . assoc-coh-stmt X A p sX sA {x} {y} {z} {t} u v w)

-- the commutation of p with composition is coherent with associativity: transport the coherence
-- on the edges of the 3-simplex filling the triple
hom-map-comp-assoc ∷
  (X A ∷ U) (p ∷ X → A) (sX : is-segal-r X) (sA : is-segal-r A)
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t)
  → assoc-coh-stmt X A p sX sA u v w
hom-map-comp-assoc X A p sX sA {x} {y} {z} {t} u v w =
  subst {triples X} (assoc-coh-tri X A p sX sA) (assoc-filler-edges X sX u v w)
    (assoc-coh-simplex X A p sX sA (assoc-filler X sX u v w))
