--
-- The fold lemmas
--
-- For a crisp oplax-Segal type C, the arrow type 𝕀 →ᵣ C is oplax-Segal (is-segal-arrᵣ, Segal.batt)
-- and comes with the two evaluations ev₀ = srcᵣ, ev₁ = tgtᵣ : (𝕀 →ᵣ C) → C. For an arrow t of C,
-- the connection and coconnection squares (Connection.batt) are arrows of 𝕀 →ᵣ C:
--
--   Γ_t  : id (t 0) → t      lying over t along ev₁       (fold-conn-over-tgt)
--   Γ'_t : t → id (t 1)      lying over t along ev₀       (fold-coconn-over-src)
--
-- (squares are read horizontally: the first variable i is the arrow of 𝕀 →ᵣ C, the second j the
-- arrow of C).
--
--   fold lemma       : Γ_t is ev₁-cocartesian                  (fold-lemma)
--   dual fold lemma  : Γ'_t is ev₀-cartesian                   (dual-fold-lemma)
--
-- These are the forms needed for the Yoneda lemma for covariant families: the fold lemma
-- identifies the cocartesian lift of an arrow f of A at the identity of the coslice (the
-- connection Γ_f), and the dual fold lemma gives representability of the fibre by its
-- cocartesian lift.
--
-- Both are proved by the same argument: a hom of 𝕀 →ᵣ C is a square (Square-hom.batt), the gap
-- map of Γ_t (resp. Γ'_t) becomes horizontal composition with the connection (resp. coconnection)
-- square on t, and this is an equivalence over each top (resp. bottom) side, by two round trips
-- given by the exchange law (Fold-square.batt, Cofold-square.batt). The proofs are in Fold-hom.batt
-- and Cofold-hom.batt, imported qualified so that the square library does not leak into the files
-- using the fold lemmas.
--
-- Postulates: none of their own; those of the exchange law (objectwise-equiv, univalence,
-- truncation, is-set-𝕀).
--

open import Stdlib
open import Hom
open import Segal
open import Fibration
open import Connection
import Fold-hom
import Cofold-hom

--
-- The (co)connection lies over the arrow itself, judgmentally
--

-- along ev₁, Γ_t is t : λ i . t (i ∧ 1) ≡ t
fold-conn-over-tgt ∷ {C ∷ U} (t : arrᵣ C) →
  hom-map {arrᵣ C} {C} (tgtᵣ {C}) {λ j . srcᵣ t} {t} (conn-hom {C} t) ≡ cell-hom {C} t
fold-conn-over-tgt {C} t = refl

-- along ev₀, Γ'_t is t : λ i . t (i ∨ 0) ≡ t
fold-coconn-over-src ∷ {C ∷ U} (t : arrᵣ C) →
  hom-map {arrᵣ C} {C} (srcᵣ {C}) {t} {λ j . tgtᵣ t} (coconn-hom {C} t) ≡ cell-hom {C} t
fold-coconn-over-src {C} t = refl

--
-- Statements
--

-- Γ_t is ev₁-cocartesian
fold-stmt ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → U
fold-stmt {C} sC t =
  is-cocartesian {arrᵣ C} {C} (is-segal-arrᵣ {C} sC) sC (tgtᵣ {C}) {λ j . srcᵣ t} {t} (conn-hom {C} t)

-- Γ'_t is ev₀-cartesian
dual-fold-stmt ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → U
dual-fold-stmt {C} sC t =
  is-cartesian {arrᵣ C} {C} (is-segal-arrᵣ {C} sC) sC (srcᵣ {C}) {t} {λ j . tgtᵣ t} (coconn-hom {C} t)

-- both statements are propositions, so postulating them adds no structure
is-prop-fold-stmt ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → is-prop (fold-stmt {C} sC t)
is-prop-fold-stmt {C} sC t =
  is-prop-is-cocartesian {arrᵣ C} {C} (is-segal-arrᵣ {C} sC) sC (tgtᵣ {C}) {λ j . srcᵣ t} {t} (conn-hom {C} t)

is-prop-dual-fold-stmt ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → is-prop (dual-fold-stmt {C} sC t)
is-prop-dual-fold-stmt {C} sC t =
  is-prop-Π (λ x' . is-equiv (cart-gap {arrᵣ C} {C} (is-segal-arrᵣ {C} sC) sC (srcᵣ {C}) {t} {λ j . tgtᵣ t} (coconn-hom {C} t) x'))
    (λ x' . is-prop-is-equiv (cart-gap {arrᵣ C} {C} (is-segal-arrᵣ {C} sC) sC (srcᵣ {C}) {t} {λ j . tgtᵣ t} (coconn-hom {C} t) x'))

--
-- The fold lemma (proved in Fold-hom.batt)
--

abstract fold-lemma ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → fold-stmt {C} sC t
fold-lemma {C} sC t = Fold-hom.fold-cocartesian sC t

--
-- The dual fold lemma (proved in Cofold-hom.batt)
--

abstract dual-fold-lemma ∷ {C ∷ U} (sC : is-segalᵣ C) (t : arrᵣ C) → dual-fold-stmt {C} sC t
dual-fold-lemma {C} sC t = Cofold-hom.coconn-cartesian sC t
