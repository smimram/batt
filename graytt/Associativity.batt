--
-- Associativity of composition in oplax-Segal types
--
--   comp-hom-r-assoc : comp (comp u v) w ≡ comp u (comp v w)     in hom X x t
--
-- for u : hom X x y, v : hom X y z, w : hom X z t.
--

open import Stdlib
open import Hom
open import Segal
open import Spine-up
open import Composition
open import Composable

--
-- Edges of a 3-simplex, as homs with refl boundary paths
--

simplex-3-hom ∷ {X ∷ U} (e ∷ 𝕀 → simplex 3) (Θ : simplex 3 →ᵣ X) → hom X (Θ (e 𝕀0)) (Θ (e 𝕀1))
simplex-3-hom {X} e Θ = (pre-r {𝕀} {simplex 3} {X} Θ e , refl , refl)

-- the faces of a 3-simplex
simplex-3-face ∷ {X ∷ U} (d ∷ simplex 2 → simplex 3) (Θ : simplex 3 →ᵣ X) → (simplex 2 →ᵣ X)
simplex-3-face {X} d Θ = pre-r {simplex 2} {simplex 3} {X} Θ d

--
-- Associativity for the edges of a 3-simplex
--
-- A 3-simplex Θ has edges u = Θ₀₁, v = Θ₁₂, w = Θ₂₃, a = Θ₀₂, b = Θ₁₃, c = Θ₀₃, and its four faces
-- (the face dᵢ omits the vertex i) give paths
--
--   c3 : comp u v ≡ a     (d3 = 012)        c1 : comp a w ≡ c     (d1 = 023)
--   c0 : comp v w ≡ b     (d0 = 123)        c2 : comp u b ≡ c     (d2 = 013)
--
-- from which the associator is read off:
--
--   comp (comp u v) w ──c3──→ comp a w ──c1──→ c ←──c2── comp u b ←──c0── comp u (comp v w)
--

-- the associator given by four such paths, for arbitrary homs a, b, c
assoc-of-faces ∷
  (X ∷ U) (s : is-segal-r X)
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t)
  {a : hom X x z} {b : hom X y t} {c : hom X x t}
  (c3 : comp-hom-r X s u v ≡ a)
  (c1 : comp-hom-r X s a w ≡ c)
  (c2 : comp-hom-r X s u b ≡ c)
  (c0 : comp-hom-r X s v w ≡ b)
  → comp-hom-r X s (comp-hom-r X s u v) w ≡ comp-hom-r X s u (comp-hom-r X s v w)
assoc-of-faces X s {x} {y} {z} {t} u v w {a} {b} {c} c3 c1 c2 c0 =
  trans (cong (λ h . comp-hom-r X s {x} {z} {t} h w) c3)
    (trans c1
      (trans (sym c2)
        (cong (λ h . comp-hom-r X s {x} {y} {t} u h) (sym c0))))

-- the path given by a face of a 3-simplex
simplex-3-face-path ∷ (X ∷ U) (s : is-segal-r X) (d ∷ simplex 2 → simplex 3) (Θ : simplex 3 →ᵣ X) →
  comp-hom-r X s (simplex-2-hom01 {X} (simplex-3-face {X} d Θ)) (simplex-2-hom12 {X} (simplex-3-face {X} d Θ))
    ≡ simplex-2-hom02 {X} (simplex-3-face {X} d Θ)
simplex-3-face-path X s d Θ = comp-simplex-2 X s (simplex-3-face {X} d Θ)

-- the associator of the edges of a 3-simplex, from its four faces
assoc-simplex-3-def ∷ (X ∷ U) (s : is-segal-r X) (Θ : simplex 3 →ᵣ X) →
  comp-hom-r X s (comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ))
    (simplex-3-hom {X} simplex-3-e23 Θ)
    ≡ comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ)
      (comp-hom-r X s (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ))
assoc-simplex-3-def X s Θ =
  assoc-of-faces X s
    (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ)
    {simplex-3-hom {X} simplex-3-e02 Θ} {simplex-3-hom {X} simplex-3-e13 Θ} {simplex-3-hom {X} simplex-3-e03 Θ}
    (simplex-3-face-path X s simplex-3-d3 Θ)
    (simplex-3-face-path X s simplex-3-d1 Θ)
    (simplex-3-face-path X s simplex-3-d2 Θ)
    (simplex-3-face-path X s simplex-3-d0 Θ)

-- frozen: assoc-simplex-3 does not unfold (unfolding it in unified terms is expensive), but it
-- is equal to its definition (assoc-simplex-3-eq)
abstract assoc-simplex-3-freeze ∷ (X ∷ U) (s : is-segal-r X) (Θ : simplex 3 →ᵣ X) →
  Σ (a : comp-hom-r X s (comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ)
        (simplex-3-hom {X} simplex-3-e12 Θ)) (simplex-3-hom {X} simplex-3-e23 Θ)
    ≡ comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ)
      (comp-hom-r X s (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ))) .
    a ≡ assoc-simplex-3-def X s Θ
assoc-simplex-3-freeze X s Θ = (assoc-simplex-3-def X s Θ , refl)

assoc-simplex-3 ∷ (X ∷ U) (s : is-segal-r X) (Θ : simplex 3 →ᵣ X) →
  comp-hom-r X s (comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ) (simplex-3-hom {X} simplex-3-e12 Θ))
    (simplex-3-hom {X} simplex-3-e23 Θ)
    ≡ comp-hom-r X s (simplex-3-hom {X} simplex-3-e01 Θ)
      (comp-hom-r X s (simplex-3-hom {X} simplex-3-e12 Θ) (simplex-3-hom {X} simplex-3-e23 Θ))
assoc-simplex-3 X s Θ = fst _ (assoc-simplex-3-freeze X s Θ)

assoc-simplex-3-eq ∷ (X ∷ U) (s : is-segal-r X) (Θ : simplex 3 →ᵣ X) → assoc-simplex-3 X s Θ ≡ assoc-simplex-3-def X s Θ
assoc-simplex-3-eq X s Θ = snd _ (assoc-simplex-3-freeze X s Θ)

--
-- Composable triples drawn on a 3-simplex
--

-- the triple given by three crisp paths in Δ³ and paths between the images of their endpoints
tri-shape ∷ {X ∷ U} (Θ : simplex 3 →ᵣ X) (path-u path-v path-w ∷ 𝕀 → simplex 3) → Θ (path-u 𝕀1) ≡ Θ
  (path-v 𝕀0) → Θ (path-v 𝕀1) ≡ Θ (path-w 𝕀0) → triples X
tri-shape {X} Θ path-u path-v path-w α β =
  (Θ (path-u 𝕀0) , Θ (path-v 𝕀0) , (pre-r {𝕀} {simplex 3} {X} Θ path-u , refl , α) , Θ (path-w 𝕀0) , Θ (path-w 𝕀1) ,
   (pre-r {𝕀} {simplex 3} {X} Θ path-v , refl , β) , (pre-r {𝕀} {simplex 3} {X} Θ path-w , refl , refl))

-- the triple of edges of a 3-simplex
edges-tri ∷ {X ∷ U} (Θ : simplex 3 →ᵣ X) → triples X
edges-tri {X} Θ = tri-shape {X} Θ simplex-3-e01 simplex-3-e12 simplex-3-e23 refl refl

-- homotopic shape data give the same triple: by crisp path induction, then the glues are images
-- of crisp paths in the set Δ³
tri-shape-path ∷ {X ∷ U} (Θ : simplex 3 →ᵣ X) (path-u ∷ 𝕀 → simplex 3) {path-u' ∷ 𝕀 → simplex 3} (htpy-u ∷ path-u ≡ path-u')
  (path-v ∷ 𝕀 → simplex 3) {path-v' ∷ 𝕀 → simplex 3} (htpy-v ∷ path-v ≡ path-v') (path-w ∷ 𝕀 → simplex 3)
    {path-w' ∷ 𝕀 → simplex 3} (htpy-w ∷ path-w ≡ path-w')
  (glue-uv ∷ path-u 𝕀1 ≡ path-v 𝕀0) (glue-uv' ∷ path-u' 𝕀1 ≡ path-v' 𝕀0) (glue-vw ∷ path-v 𝕀1 ≡ path-w 𝕀0)
    (glue-vw' ∷ path-v' 𝕀1 ≡ path-w' 𝕀0) →
  tri-shape {X} Θ path-u path-v path-w (ap-r {simplex 3} {X} glue-uv Θ) (ap-r {simplex 3} {X} glue-vw Θ)
    ≡ tri-shape {X} Θ path-u' path-v' path-w' (ap-r {simplex 3} {X} glue-uv' Θ) (ap-r {simplex 3} {X} glue-vw' Θ)
tri-shape-path {X} Θ path-u refl path-v refl path-w refl glue-uv glue-uv' glue-vw glue-vw' =
  cong2 {Θ (path-u 𝕀1) ≡ Θ (path-v 𝕀0)} {Θ (path-v 𝕀1) ≡ Θ (path-w 𝕀0)} {triples X}
    (λ α β . tri-shape {X} Θ path-u path-v path-w α β)
    (ap-r-set (is-set-simplex 2) glue-uv glue-uv' Θ) (ap-r-set (is-set-simplex 2) glue-vw glue-vw' Θ)

-- the edges of the 3-spine, included in the 3-simplex
spine-3-edge-1-in-simplex ∷ 𝕀 → simplex 3
spine-3-edge-1-in-simplex t = spine→simplex 3 (spine-3-edge-1-incl (𝕀→spine-3-edge-1 t))

spine-3-edge-2-in-simplex ∷ 𝕀 → simplex 3
spine-3-edge-2-in-simplex t = spine→simplex 3 (spine-3-tail-incl (𝕀→spine-3-tail-edge-1 t))

spine-3-edge-3-in-simplex ∷ 𝕀 → simplex 3
spine-3-edge-3-in-simplex t = spine→simplex 3 (spine-3-tail-incl (𝕀→spine-3-tail-edge-2 t))

spine-3-edge-1-in-simplex-path ∷ spine-3-edge-1-in-simplex ≡{𝕀 → simplex 3} simplex-3-e01
spine-3-edge-1-in-simplex-path = funext-htpy {𝕀} {λ _ . simplex 3} spine-3-edge-1-in-simplex simplex-3-e01
  (λ t . simplex-path 2 {(t , 𝕀0 , 𝕀0 , tt)} {(t , 𝕀0 , 𝕀0 , tt)} refl
      (snd (is-sorted 2) (spine-3-edge-1-in-simplex t)) (refl , (refl , tt)))

spine-3-edge-2-in-simplex-path ∷ spine-3-edge-2-in-simplex ≡{𝕀 → simplex 3} simplex-3-e12
spine-3-edge-2-in-simplex-path = funext-htpy {𝕀} {λ _ . simplex 3} spine-3-edge-2-in-simplex simplex-3-e12
  (λ t . simplex-path 2 {(𝕀1 , t , 𝕀0 , tt)} {(𝕀1 , t , 𝕀0 , tt)} refl
      (snd (is-sorted 2) (spine-3-edge-2-in-simplex t)) (refl , (refl , tt)))

spine-3-edge-3-in-simplex-path ∷ spine-3-edge-3-in-simplex ≡{𝕀 → simplex 3} simplex-3-e23
spine-3-edge-3-in-simplex-path = funext-htpy {𝕀} {λ _ . simplex 3} spine-3-edge-3-in-simplex simplex-3-e23
  (λ t . simplex-path 2 {(𝕀1 , 𝕀1 , t , tt)} {(𝕀1 , 𝕀1 , t , tt)} refl
      (snd (is-sorted 2) (spine-3-edge-3-in-simplex t)) (refl , (refl , tt)))

-- the triple read off the restriction of a 3-simplex to the 3-spine is its triple of edges
abstract spine-restr-edges-tri ∷ {X ∷ U} (Θ : simplex 3 →ᵣ X) →
  spine-3-cocone→triple {X} (spine-3→cocone-r X (spine-restr-r 3 X Θ)) ≡ edges-tri {X} Θ
spine-restr-edges-tri {X} Θ =
  trans
    (cong2 {Θ (spine-3-edge-1-in-simplex 𝕀1) ≡ Θ (spine-3-edge-2-in-simplex 𝕀0)}
        {Θ (spine-3-edge-2-in-simplex 𝕀1) ≡ Θ (spine-3-edge-3-in-simplex 𝕀0)} {triples X}
        (λ α β . tri-shape {X} Θ spine-3-edge-1-in-simplex spine-3-edge-2-in-simplex
          spine-3-edge-3-in-simplex α β)
      (ap-r-pre-r (spine 3) {simplex 3} {X} {spine-3-edge-1-incl spine-3-edge-1-end}
          {spine-3-tail-incl spine-3-tail-start} spine-3-glue (spine→simplex 3) Θ)
      (ap-r-pre-r spine-3-tail {simplex 3} {X} {𝕀→spine-3-tail-edge-1 𝕀1} {𝕀→spine-3-tail-edge-2 𝕀0}
          spine-3-tail-glue (λ b . spine→simplex 3 (spine-3-tail-incl b)) Θ))
    (tri-shape-path {X} Θ spine-3-edge-1-in-simplex spine-3-edge-1-in-simplex-path spine-3-edge-2-in-simplex
        spine-3-edge-2-in-simplex-path spine-3-edge-3-in-simplex spine-3-edge-3-in-simplex-path
      (cong (spine→simplex 3) spine-3-glue) refl (cong (λ b . spine→simplex 3 (spine-3-tail-incl b)) spine-3-tail-glue) refl)

--
-- Associativity, as a family over composable triples
--

assoc-stmt ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} → hom X x y → hom X y z → hom X z t → U
assoc-stmt X s {x} {y} {z} {t} u v w =
  comp-hom-r X s {x} {z} {t} (comp-hom-r X s {x} {y} {z} u v) w ≡ comp-hom-r X s {x} {y} {t} u (comp-hom-r X s {y} {z} {t} v w)

tri-assoc ∷ (X ∷ U) (s : is-segal-r X) → triples X → U
tri-assoc X s = tri-family X (λ x y z t u v w . assoc-stmt X s {x} {y} {z} {t} u v w)

--
-- Associativity
--

-- the 3-simplex filling a composable triple
assoc-filler ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) → (simplex 3 →ᵣ X)
assoc-filler X s {x} {y} {z} {t} u v w =
  map-section (spine-restr-r 3 X) (is-equiv-sec (spine-restr-r 3 X) (is-segal-r-unthick X s 3))
    (cocone→spine-3-r X (tri-section X {x} {y} {z} {t} u v w))

-- its triple of edges is the given triple
abstract assoc-filler-edges ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  edges-tri {X} (assoc-filler X s {x} {y} {z} {t} u v w) ≡ (x , y , u , z , t , v , w)
assoc-filler-edges X s {x} {y} {z} {t} u v w =
  let Θs : spine 3 →ᵣ X =
    cocone→spine-3-r X (tri-section X {x} {y} {z} {t} u v w) in
  trans (sym (spine-restr-edges-tri {X} (assoc-filler X s {x} {y} {z} {t} u v w)))
    (trans (cong {spine 3 →ᵣ X} {triples X} (λ φ . spine-3-cocone→triple {X} (spine-3→cocone-r X φ))
             (snd (is-section (spine-restr-r 3 X)) (is-equiv-sec (spine-restr-r 3 X) (is-segal-r-unthick X s 3)) Θs))
      (trans (cong {spine-3-cocone-r X} {triples X} (spine-3-cocone→triple {X})
               (spine-3→cocone-r-sec X (tri-section X {x} {y} {z} {t} u v w)))
        (tri-section-path X {x} {y} {z} {t} u v w)))

-- associativity of composition in an oplax-Segal type: the associativity of the 3-simplex
-- filling the triple, transported along its edges
comp-hom-r-assoc-def ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  comp-hom-r X s {x} {z} {t} (comp-hom-r X s {x} {y} {z} u v) w ≡ comp-hom-r X s {x} {y} {t} u (comp-hom-r X s {y} {z} {t} v w)
comp-hom-r-assoc-def X s {x} {y} {z} {t} u v w =
  subst {triples X} (tri-assoc X s) (assoc-filler-edges X s {x} {y} {z} {t} u v w)
    (assoc-simplex-3 X s (assoc-filler X s {x} {y} {z} {t} u v w))

-- frozen, as assoc-simplex-3
abstract comp-hom-r-assoc-freeze ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  Σ (a : comp-hom-r X s {x} {z} {t} (comp-hom-r X s {x} {y} {z} u v) w ≡ comp-hom-r X s {x} {y} {t} u
      (comp-hom-r X s {y} {z} {t} v w)) . a ≡ comp-hom-r-assoc-def X s {x} {y} {z} {t} u v w
comp-hom-r-assoc-freeze X s {x} {y} {z} {t} u v w = (comp-hom-r-assoc-def X s {x} {y} {z} {t} u v w , refl)

comp-hom-r-assoc ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  comp-hom-r X s {x} {z} {t} (comp-hom-r X s {x} {y} {z} u v) w ≡ comp-hom-r X s {x} {y} {t} u (comp-hom-r X s {y} {z} {t} v w)
comp-hom-r-assoc X s {x} {y} {z} {t} u v w = fst _ (comp-hom-r-assoc-freeze X s {x} {y} {z} {t} u v w)

comp-hom-r-assoc-eq ∷ (X ∷ U) (s : is-segal-r X) {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  comp-hom-r-assoc X s {x} {y} {z} {t} u v w ≡ comp-hom-r-assoc-def X s {x} {y} {z} {t} u v w
comp-hom-r-assoc-eq X s {x} {y} {z} {t} u v w = snd _ (comp-hom-r-assoc-freeze X s {x} {y} {z} {t} u v w)
