--
-- The universal property of the 2-spine, cartesian, oplax and lax
--
-- The spine Sp₂ = {x : 𝕀² | x₂ = 0 ∨ x₁ = 1} (spine 2 in Cube.batt) is, judgmentally, the union of
-- the two subtypes {x₂ = 0} and {x₁ = 1} of 𝕀² (Union.batt). Their intersection is the single
-- vertex (1, 0), so the spine is the wedge of its two edges glued at the vertex:
--
--   spine-cart-up  : maps spine 2 → Y are wedge cocones, for every Y,
--   spine-oplax-up : maps spine 2 →ᵣ X are oplax wedge cocones, for every crisp X,
--   spine-lax-up   : maps spine 2 →ₗ X are lax wedge cocones, for every crisp X.
--
-- The proof is three lines on top of three general facts:
--   - a union of two subtypes is a pushout over their intersection (union-up, Union.batt);
--   - with a contractible intersection, it is a pushout over a point (union-pt-up, Union.batt);
--   - the universal property of a wedge transfers from cartesian to lax and oplax maps
--     (wedge-oplax-up, wedge-lax-up, Wedge.batt).
-- What is specific to the spine is only the contractibility of the intersection.
--
-- The edges are the subtypes sp-EA = {x₂ = 0} and sp-EB = {x₁ = 1} of 𝕀², glued at the vertex.
--

open import Stdlib
open import Wedge

--
-- the spine as a union of two subtypes of 𝕀²
--

-- coordinates, with explicit implicit arguments
cc1 ∷ cart-cube 2 → 𝕀
cc1 c = prod-fst {𝕀} {cart-cube 1} c

ccxs ∷ cart-cube 2 → cart-cube 1
ccxs c = prod-snd {𝕀} {cart-cube 1} c

cc2 ∷ cart-cube 2 → 𝕀
cc2 c = prod-fst {𝕀} {⊤} (ccxs c)

-- the two propositions whose disjunction defines the spine
sp-A ∷ cart-cube 2 → U
sp-A c = ccxs c ≡{cart-cube 1} zero-cube 1

sp-B ∷ cart-cube 2 → U
sp-B c = (cc1 c ≡ 𝕀1) × is-in-spine 1 (ccxs c)

is-prop-sp-A ∷ (c : cart-cube 2) → is-prop (sp-A c)
is-prop-sp-A c = is-set-cart-cube 1 (ccxs c) (zero-cube 1)

is-prop-sp-B ∷ (c : cart-cube 2) → is-prop (sp-B c)
is-prop-sp-B c = is-prop-prod (is-set-𝕀 (cc1 c) 𝕀1) (is-prop-is-in-spine 1 (ccxs c))

spine-is-union ∷ spine 2 ≡ union sp-A sp-B
spine-is-union = refl

--
-- the spine as a wedge of its two edges
--

-- the two edges, as subtypes of 𝕀²
sp-EA ∷ U
sp-EA = Σ (c : cart-cube 2) . sp-A c

sp-EB ∷ U
sp-EB = Σ (c : cart-cube 2) . sp-B c

sp-i ∷ sp-EA → spine 2
sp-i = union-inl sp-A sp-B

sp-j ∷ sp-EB → spine 2
sp-j = union-inr sp-A sp-B

-- the vertex (1 , 0), on each edge
sp-a1 ∷ sp-EA
sp-a1 = ((𝕀1 , 𝕀0 , tt) , refl)

sp-b0 ∷ sp-EB
sp-b0 = ((𝕀1 , 𝕀0 , tt) , (refl , spine-1-pt 𝕀0))

-- the outer vertices of the spine: 0 on the first edge, 2 on the second one
sp-a0 ∷ sp-EA
sp-a0 = ((𝕀0 , 𝕀0 , tt) , refl)

sp-b1 ∷ sp-EB
sp-b1 = ((𝕀1 , 𝕀1 , tt) , (refl , spine-1-pt 𝕀1))

-- the glue is the vertex path of Cube.batt
sp-γ ∷ sp-i sp-a1 ≡{spine 2} sp-j sp-b0
sp-γ = spine-glue

-- the intersection of the two edges is contractible, with centre the vertex
sp-κ2 ∷ (c1 : 𝕀) (xs : cart-cube 1) (w : sp-A (c1 , xs) × sp-B (c1 , xs)) →
  ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I sp-A sp-B} ((c1 , xs) , w)
sp-κ2 c1 xs w =
  subtype-path (λ c . sp-A c × sp-B c) (λ c . is-prop-prod (is-prop-sp-A c) (is-prop-sp-B c)) {(𝕀1 , 𝕀0 , tt)} {(c1 , xs)}
    (cong2 {𝕀} {cart-cube 1} {cart-cube 2} pair
      (sym (prod-fst {c1 ≡ 𝕀1} {is-in-spine 1 xs} (prod-snd {sp-A (c1 , xs)} {sp-B (c1 , xs)} w)))
      (sym (prod-fst {sp-A (c1 , xs)} {sp-B (c1 , xs)} w)))
    (refl , (refl , spine-1-pt 𝕀0)) w

sp-κ1 ∷ (c : cart-cube 2) (w : sp-A c × sp-B c) → ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I sp-A sp-B} (c , w)
sp-κ1 (c1 , xs) w = sp-κ2 c1 xs w

sp-κ ∷ (t : union-I sp-A sp-B) → ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I sp-A sp-B} t
sp-κ (c , w) = sp-κ1 c w

--
-- the universal properties of the spine
--

spine-cart-up ∷ wedge-cart-up (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ
spine-cart-up Y = union-pt-up sp-A sp-B is-prop-sp-A is-prop-sp-B Y (𝕀1 , 𝕀0 , tt) refl (refl , spine-1-pt 𝕀0) sp-κ

spine-oplax-up ∷ (X ∷ U) → is-equiv (wedge-restr-r (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ X)
spine-oplax-up X = wedge-oplax-up (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ spine-cart-up X

spine-lax-up ∷ (X ∷ U) → is-equiv (wedge-restr-l (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ X)
spine-lax-up X = wedge-lax-up (spine 2) sp-EA sp-EB sp-i sp-j sp-a1 sp-b0 sp-γ spine-cart-up X

--
-- oplax cocones on the two edges (the domain of the inverse used in Composition.batt)
--

spine-cocone-r ∷ (X ∷ U) → U
spine-cocone-r X = wedge-cocone-r sp-EA sp-EB sp-a1 sp-b0 X

--
-- The 3-spine as a wedge of an edge and a 2-spine
--
-- Sp₃ = {x : 𝕀³ | (x₂ , x₃) = 0 ∨ (x₁ = 1 ∧ (x₂ , x₃) ∈ Sp₂)} is, judgmentally, the union of the
-- subtypes {(x₂ , x₃) = 0} (the first edge) and {x₁ = 1 , (x₂ , x₃) ∈ Sp₂} (a copy of the 2-spine),
-- which meet at the single vertex (1 , 0 , 0). The same three general facts as for the 2-spine
-- give its universal properties.
--

-- coordinates
cc3-1 ∷ cart-cube 3 → 𝕀
cc3-1 c = prod-fst {𝕀} {cart-cube 2} c

cc3-xs ∷ cart-cube 3 → cart-cube 2
cc3-xs c = prod-snd {𝕀} {cart-cube 2} c

sp3-A ∷ cart-cube 3 → U
sp3-A c = cc3-xs c ≡{cart-cube 2} zero-cube 2

sp3-B ∷ cart-cube 3 → U
sp3-B c = (cc3-1 c ≡ 𝕀1) × is-in-spine 2 (cc3-xs c)

is-prop-sp3-A ∷ (c : cart-cube 3) → is-prop (sp3-A c)
is-prop-sp3-A c = is-set-cart-cube 2 (cc3-xs c) (zero-cube 2)

is-prop-sp3-B ∷ (c : cart-cube 3) → is-prop (sp3-B c)
is-prop-sp3-B c = is-prop-prod (is-set-𝕀 (cc3-1 c) 𝕀1) (is-prop-is-in-spine 2 (cc3-xs c))

spine-3-is-union ∷ spine 3 ≡ union sp3-A sp3-B
spine-3-is-union = refl

-- the two pieces: the first edge, and the copy {1} × Sp₂ of the 2-spine
sp3-EA ∷ U
sp3-EA = Σ (c : cart-cube 3) . sp3-A c

sp3-EB ∷ U
sp3-EB = Σ (c : cart-cube 3) . sp3-B c

sp3-i ∷ sp3-EA → spine 3
sp3-i = union-inl sp3-A sp3-B

sp3-j ∷ sp3-EB → spine 3
sp3-j = union-inr sp3-A sp3-B

-- the 2-spine as the second piece, and back
sp3-incl ∷ spine 2 → sp3-EB
sp3-incl (xs , w) = ((𝕀1 , xs) , (refl , w))

sp3-proj ∷ sp3-EB → spine 2
sp3-proj (c , w) = (cc3-xs c , prod-snd {cc3-1 c ≡ 𝕀1} {is-in-spine 2 (cc3-xs c)} w)

-- the vertex (1 , 0 , 0), on each piece; on the second one it is the vertex 0 of the 2-spine
sp3-a1 ∷ sp3-EA
sp3-a1 = ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl)

sp3-b0 ∷ sp3-EB
sp3-b0 = sp3-incl (sp-i sp-a0)

sp3-q0 ∷ sp3-B (𝕀1 , 𝕀0 , 𝕀0 , tt)
sp3-q0 = snd sp3-B sp3-b0

sp3-γ ∷ sp3-i sp3-a1 ≡{spine 3} sp3-j sp3-b0
sp3-γ = union-glue sp3-A sp3-B (𝕀1 , 𝕀0 , 𝕀0 , tt) refl sp3-q0

-- the intersection of the two pieces is contractible, with centre the vertex
sp3-κ2 ∷ (c1 : 𝕀) (xs : cart-cube 2) (w : sp3-A (c1 , xs) × sp3-B (c1 , xs)) →
  ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , sp3-q0) ≡{union-I sp3-A sp3-B} ((c1 , xs) , w)
sp3-κ2 c1 xs w =
  subtype-path (λ c . sp3-A c × sp3-B c) (λ c . is-prop-prod (is-prop-sp3-A c) (is-prop-sp3-B c)) {(𝕀1 , 𝕀0 , 𝕀0 , tt)} {(c1 , xs)}
    (cong2 {𝕀} {cart-cube 2} {cart-cube 3} pair
      (sym (prod-fst {c1 ≡ 𝕀1} {is-in-spine 2 xs} (prod-snd {sp3-A (c1 , xs)} {sp3-B (c1 , xs)} w)))
      (sym (prod-fst {sp3-A (c1 , xs)} {sp3-B (c1 , xs)} w)))
    (refl , sp3-q0) w

sp3-κ1 ∷ (c : cart-cube 3) (w : sp3-A c × sp3-B c) → ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , sp3-q0) ≡{union-I sp3-A sp3-B} (c , w)
sp3-κ1 (c1 , xs) w = sp3-κ2 c1 xs w

sp3-κ ∷ (t : union-I sp3-A sp3-B) → ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , sp3-q0) ≡{union-I sp3-A sp3-B} t
sp3-κ (c , w) = sp3-κ1 c w

-- the universal properties of the 3-spine
spine-3-cart-up ∷ wedge-cart-up (spine 3) sp3-EA sp3-EB sp3-i sp3-j sp3-a1 sp3-b0 sp3-γ
spine-3-cart-up Y = union-pt-up sp3-A sp3-B is-prop-sp3-A is-prop-sp3-B Y (𝕀1 , 𝕀0 , 𝕀0 , tt) refl sp3-q0 sp3-κ

spine-3-oplax-up ∷ (X ∷ U) → is-equiv (wedge-restr-r (spine 3) sp3-EA sp3-EB sp3-i sp3-j sp3-a1 sp3-b0 sp3-γ X)
spine-3-oplax-up X = wedge-oplax-up (spine 3) sp3-EA sp3-EB sp3-i sp3-j sp3-a1 sp3-b0 sp3-γ spine-3-cart-up X

spine-3-cocone-r ∷ (X ∷ U) → U
spine-3-cocone-r X = wedge-cocone-r sp3-EA sp3-EB sp3-a1 sp3-b0 X
