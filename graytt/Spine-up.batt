--
-- The universal property of the 2-spine, cartesian, oplax and lax
--
-- The spine Sp₂ = {x : 𝕀² | x₂ = 0 ∨ x₁ = 1} (spine 2 in Cube.batt) is, judgmentally, the union of
-- the two subtypes {x₂ = 0} and {x₁ = 1} of 𝕀² (Union.batt). Their intersection is the single
-- vertex (1, 0), so the spine is the wedge of its two edges glued at the vertex:
--
--   spine-cart-up  : maps spine 2 → Y are wedge cocones, for every Y,
--   spine-oplax-up : maps spine 2 →ᵣ X are oplax wedge cocones, for every crisp X,
--   spine-lax-up   : maps spine 2 →ₗ X are lax wedge cocones, for every crisp X.
--
-- The proof is three lines on top of three general facts:
--   - a union of two subtypes is a pushout over their intersection (union-up, Union.batt);
--   - with a contractible intersection, it is a pushout over a point (union-pt-up, Union.batt);
--   - the universal property of a wedge transfers from cartesian to lax and oplax maps
--     (wedge-oplax-up, wedge-lax-up, Wedge.batt).
-- What is specific to the spine is only the contractibility of the intersection.
--
-- The edges are the subtypes spine-2-edge-1 = {x₂ = 0} and spine-2-edge-2 = {x₁ = 1} of 𝕀²,
-- glued at the vertex.
--

open import Stdlib
open import Wedge

--
-- the spine as a union of two subtypes of 𝕀²
--

-- coordinates, with explicit implicit arguments
cube-2-x1 ∷ cart-cube 2 → 𝕀
cube-2-x1 c = prod-fst {𝕀} {cart-cube 1} c

cube-2-tail ∷ cart-cube 2 → cart-cube 1
cube-2-tail c = prod-snd {𝕀} {cart-cube 1} c

cube-2-x2 ∷ cart-cube 2 → 𝕀
cube-2-x2 c = prod-fst {𝕀} {⊤} (cube-2-tail c)

-- the two propositions whose disjunction defines the spine
spine-2-on-edge-1 ∷ cart-cube 2 → U
spine-2-on-edge-1 c = cube-2-tail c ≡{cart-cube 1} zero-cube 1

spine-2-on-edge-2 ∷ cart-cube 2 → U
spine-2-on-edge-2 c = (cube-2-x1 c ≡ 𝕀1) × is-in-spine 1 (cube-2-tail c)

is-prop-spine-2-on-edge-1 ∷ (c : cart-cube 2) → is-prop (spine-2-on-edge-1 c)
is-prop-spine-2-on-edge-1 c = is-set-cart-cube 1 (cube-2-tail c) (zero-cube 1)

is-prop-spine-2-on-edge-2 ∷ (c : cart-cube 2) → is-prop (spine-2-on-edge-2 c)
is-prop-spine-2-on-edge-2 c = is-prop-prod (is-set-𝕀 (cube-2-x1 c) 𝕀1) (is-prop-is-in-spine 1 (cube-2-tail c))

spine-is-union ∷ spine 2 ≡ union spine-2-on-edge-1 spine-2-on-edge-2
spine-is-union = refl

--
-- the spine as a wedge of its two edges
--

-- the two edges, as subtypes of 𝕀²
spine-2-edge-1 ∷ U
spine-2-edge-1 = Σ (c : cart-cube 2) . spine-2-on-edge-1 c

spine-2-edge-2 ∷ U
spine-2-edge-2 = Σ (c : cart-cube 2) . spine-2-on-edge-2 c

spine-2-edge-1-incl ∷ spine-2-edge-1 → spine 2
spine-2-edge-1-incl = union-inl spine-2-on-edge-1 spine-2-on-edge-2

spine-2-edge-2-incl ∷ spine-2-edge-2 → spine 2
spine-2-edge-2-incl = union-inr spine-2-on-edge-1 spine-2-on-edge-2

-- the vertex (1 , 0), on each edge
spine-2-edge-1-end ∷ spine-2-edge-1
spine-2-edge-1-end = ((𝕀1 , 𝕀0 , tt) , refl)

spine-2-edge-2-start ∷ spine-2-edge-2
spine-2-edge-2-start = ((𝕀1 , 𝕀0 , tt) , (refl , spine-1-pt 𝕀0))

-- the outer vertices of the spine: 0 on the first edge, 2 on the second one
spine-2-edge-1-start ∷ spine-2-edge-1
spine-2-edge-1-start = ((𝕀0 , 𝕀0 , tt) , refl)

spine-2-edge-2-end ∷ spine-2-edge-2
spine-2-edge-2-end = ((𝕀1 , 𝕀1 , tt) , (refl , spine-1-pt 𝕀1))

-- the glue is the vertex path of Cube.batt
spine-2-glue ∷ spine-2-edge-1-incl spine-2-edge-1-end ≡{spine 2} spine-2-edge-2-incl spine-2-edge-2-start
spine-2-glue = spine-glue

-- the intersection of the two edges is contractible, with centre the vertex
spine-2-meet-contr-aux2 ∷ (c1 : 𝕀) (xs : cart-cube 1) (w : spine-2-on-edge-1 (c1 , xs) × spine-2-on-edge-2 (c1 , xs)) →
  ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I spine-2-on-edge-1 spine-2-on-edge-2} ((c1 , xs) , w)
spine-2-meet-contr-aux2 c1 xs w =
  subtype-path (λ c . spine-2-on-edge-1 c × spine-2-on-edge-2 c)
    (λ c . is-prop-prod (is-prop-spine-2-on-edge-1 c) (is-prop-spine-2-on-edge-2 c)) {(𝕀1 , 𝕀0 , tt)}
    {(c1 , xs)}
    (cong2 {𝕀} {cart-cube 1} {cart-cube 2} pair
      (sym (prod-fst {c1 ≡ 𝕀1} {is-in-spine 1 xs} (prod-snd {spine-2-on-edge-1 (c1 , xs)} {spine-2-on-edge-2 (c1 , xs)} w)))
      (sym (prod-fst {spine-2-on-edge-1 (c1 , xs)} {spine-2-on-edge-2 (c1 , xs)} w)))
    (refl , (refl , spine-1-pt 𝕀0)) w

spine-2-meet-contr-aux1 ∷ (c : cart-cube 2) (w : spine-2-on-edge-1 c × spine-2-on-edge-2 c) →
  ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I spine-2-on-edge-1 spine-2-on-edge-2} (c , w)
spine-2-meet-contr-aux1 (c1 , xs) w = spine-2-meet-contr-aux2 c1 xs w

spine-2-meet-contr ∷ (t : union-I spine-2-on-edge-1 spine-2-on-edge-2) →
  ((𝕀1 , 𝕀0 , tt) , refl , (refl , spine-1-pt 𝕀0)) ≡{union-I spine-2-on-edge-1 spine-2-on-edge-2} t
spine-2-meet-contr (c , w) = spine-2-meet-contr-aux1 c w

--
-- the universal properties of the spine
--

spine-cart-up ∷
  wedge-cart-up (spine 2)
    spine-2-edge-1 spine-2-edge-2
    spine-2-edge-1-incl spine-2-edge-2-incl
    spine-2-edge-1-end spine-2-edge-2-start
    spine-2-glue
spine-cart-up Y =
  union-pt-up spine-2-on-edge-1 spine-2-on-edge-2 is-prop-spine-2-on-edge-1 is-prop-spine-2-on-edge-2 Y
    (𝕀1 , 𝕀0 , tt) refl (refl , spine-1-pt 𝕀0) spine-2-meet-contr

spine-oplax-up ∷ (X ∷ U) →
  is-equiv (wedge→cocone-r (spine 2)
    spine-2-edge-1 spine-2-edge-2
    spine-2-edge-1-incl spine-2-edge-2-incl
    spine-2-edge-1-end spine-2-edge-2-start
    spine-2-glue
    X)
spine-oplax-up X =
  wedge-oplax-up (spine 2)
    spine-2-edge-1 spine-2-edge-2
    spine-2-edge-1-incl spine-2-edge-2-incl
    spine-2-edge-1-end spine-2-edge-2-start
    spine-2-glue
    spine-cart-up X

spine-lax-up ∷ (X ∷ U) →
  is-equiv (wedge→cocone-l (spine 2)
    spine-2-edge-1 spine-2-edge-2
    spine-2-edge-1-incl spine-2-edge-2-incl
    spine-2-edge-1-end spine-2-edge-2-start
    spine-2-glue
    X)
spine-lax-up X =
  wedge-lax-up (spine 2)
    spine-2-edge-1 spine-2-edge-2
    spine-2-edge-1-incl spine-2-edge-2-incl
    spine-2-edge-1-end spine-2-edge-2-start
    spine-2-glue
    spine-cart-up X

--
-- oplax cocones on the two edges (the domain of the inverse used in Composition.batt)
--

spine-2-cocone-r ∷ (X ∷ U) → U
spine-2-cocone-r X = wedge-cocone-r spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-end spine-2-edge-2-start X

--
-- abbreviations of the wedge combinators, for the 2-spine
--

-- restricting an oplax map out of the spine to a cocone on its edges, and back
spine-2→cocone-r ∷ (X ∷ U) → (spine 2 →ᵣ X) → spine-2-cocone-r X
spine-2→cocone-r X = wedge→cocone-r (spine 2) spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-incl
  spine-2-edge-2-incl spine-2-edge-1-end spine-2-edge-2-start spine-2-glue X

cocone→spine-2-r ∷ (X ∷ U) → spine-2-cocone-r X → (spine 2 →ᵣ X)
cocone→spine-2-r X = cocone→wedge-r (spine 2) spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-incl
  spine-2-edge-2-incl spine-2-edge-1-end spine-2-edge-2-start spine-2-glue spine-cart-up X

spine-2→cocone-r-sec ∷ (X ∷ U) (w : spine-2-cocone-r X) → spine-2→cocone-r X (cocone→spine-2-r X w) ≡ w
spine-2→cocone-r-sec X w = wedge→cocone-r-sec (spine 2) spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-incl
  spine-2-edge-2-incl spine-2-edge-1-end spine-2-edge-2-start spine-2-glue spine-cart-up X w

spine-2→cocone-r-retr ∷ (X ∷ U) (φ : spine 2 →ᵣ X) → cocone→spine-2-r X (spine-2→cocone-r X φ) ≡ φ
spine-2→cocone-r-retr X φ = wedge→cocone-r-retr (spine 2) spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-incl
  spine-2-edge-2-incl spine-2-edge-1-end spine-2-edge-2-start spine-2-glue spine-cart-up X φ

-- the components of a cocone: the maps on the two edges, and the glue
spine-2-cocone-edge-1 ∷ {X ∷ U} → spine-2-cocone-r X → (spine-2-edge-1 →ᵣ X)
spine-2-cocone-edge-1 {X} w = wedge-cocone-r-fst {spine-2-edge-1} {spine-2-edge-2} {spine-2-edge-1-end}
  {spine-2-edge-2-start} {X} w

spine-2-cocone-edge-2 ∷ {X ∷ U} → spine-2-cocone-r X → (spine-2-edge-2 →ᵣ X)
spine-2-cocone-edge-2 {X} w = wedge-cocone-r-snd {spine-2-edge-1} {spine-2-edge-2} {spine-2-edge-1-end}
  {spine-2-edge-2-start} {X} w

spine-2-cocone-glue ∷ {X ∷ U} (w : spine-2-cocone-r X) →
  spine-2-cocone-edge-1 {X} w spine-2-edge-1-end ≡ spine-2-cocone-edge-2 {X} w spine-2-edge-2-start
spine-2-cocone-glue {X} w = wedge-cocone-r-glue {spine-2-edge-1} {spine-2-edge-2} {spine-2-edge-1-end}
  {spine-2-edge-2-start} {X} w

-- paths of cocones
spine-2-cocone-path ∷
  (X ∷ U) (f : spine-2-edge-1 →ᵣ X) (g : spine-2-edge-2 →ᵣ X) (q : f spine-2-edge-1-end ≡ g spine-2-edge-2-start)
  (f' : spine-2-edge-1 →ᵣ X) (Pf : f ≡ f') (g' : spine-2-edge-2 →ᵣ X) (Pg : g ≡ g')
    (q' : f' spine-2-edge-1-end ≡ g' spine-2-edge-2-start)
  → trans q (ev-r {spine-2-edge-2} {X} spine-2-edge-2-start {g} {g'} Pg) ≡ trans
    (ev-r {spine-2-edge-1} {X} spine-2-edge-1-end {f} {f'} Pf) q'
  → (f , g , q) ≡{spine-2-cocone-r X} (f' , g' , q')
spine-2-cocone-path = wedge-cocone-r-path spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-end spine-2-edge-2-start

spine-2-cocone-path-maps ∷
  (X ∷ U) (f : spine-2-edge-1 →ᵣ X) (g : spine-2-edge-2 →ᵣ X) (q : f spine-2-edge-1-end ≡ g spine-2-edge-2-start)
  (f' : spine-2-edge-1 →ᵣ X) (Pf : f ≡ f') (g' : spine-2-edge-2 →ᵣ X) (Pg : g ≡ g')
    (q' : f' spine-2-edge-1-end ≡ g' spine-2-edge-2-start)
  (θ : trans q (ev-r {spine-2-edge-2} {X} spine-2-edge-2-start {g} {g'} Pg) ≡ trans
      (ev-r {spine-2-edge-1} {X} spine-2-edge-1-end {f} {f'} Pf) q')
  → (cong (spine-2-cocone-edge-1 {X}) (spine-2-cocone-path X f g q f' Pf g' Pg q' θ) ≡ Pf)
    × (cong (spine-2-cocone-edge-2 {X}) (spine-2-cocone-path X f g q f' Pf g' Pg q' θ) ≡ Pg)
spine-2-cocone-path-maps = wedge-cocone-r-path-maps spine-2-edge-1 spine-2-edge-2 spine-2-edge-1-end spine-2-edge-2-start

--
-- The 3-spine as a wedge of an edge and a 2-spine
--
-- Sp₃ = {x : 𝕀³ | (x₂ , x₃) = 0 ∨ (x₁ = 1 ∧ (x₂ , x₃) ∈ Sp₂)} is, judgmentally, the union of the
-- subtypes {(x₂ , x₃) = 0} (the first edge) and {x₁ = 1 , (x₂ , x₃) ∈ Sp₂} (a copy of the 2-spine),
-- which meet at the single vertex (1 , 0 , 0). The same three general facts as for the 2-spine
-- give its universal properties.
--

-- coordinates
cube-3-x1 ∷ cart-cube 3 → 𝕀
cube-3-x1 c = prod-fst {𝕀} {cart-cube 2} c

cube-3-tail ∷ cart-cube 3 → cart-cube 2
cube-3-tail c = prod-snd {𝕀} {cart-cube 2} c

spine-3-on-edge-1 ∷ cart-cube 3 → U
spine-3-on-edge-1 c = cube-3-tail c ≡{cart-cube 2} zero-cube 2

spine-3-on-tail ∷ cart-cube 3 → U
spine-3-on-tail c = (cube-3-x1 c ≡ 𝕀1) × is-in-spine 2 (cube-3-tail c)

is-prop-spine-3-on-edge-1 ∷ (c : cart-cube 3) → is-prop (spine-3-on-edge-1 c)
is-prop-spine-3-on-edge-1 c = is-set-cart-cube 2 (cube-3-tail c) (zero-cube 2)

is-prop-spine-3-on-tail ∷ (c : cart-cube 3) → is-prop (spine-3-on-tail c)
is-prop-spine-3-on-tail c = is-prop-prod (is-set-𝕀 (cube-3-x1 c) 𝕀1) (is-prop-is-in-spine 2 (cube-3-tail c))

spine-3-is-union ∷ spine 3 ≡ union spine-3-on-edge-1 spine-3-on-tail
spine-3-is-union = refl

-- the two pieces: the first edge, and the copy {1} × Sp₂ of the 2-spine
spine-3-edge-1 ∷ U
spine-3-edge-1 = Σ (c : cart-cube 3) . spine-3-on-edge-1 c

spine-3-tail ∷ U
spine-3-tail = Σ (c : cart-cube 3) . spine-3-on-tail c

spine-3-edge-1-incl ∷ spine-3-edge-1 → spine 3
spine-3-edge-1-incl = union-inl spine-3-on-edge-1 spine-3-on-tail

spine-3-tail-incl ∷ spine-3-tail → spine 3
spine-3-tail-incl = union-inr spine-3-on-edge-1 spine-3-on-tail

-- the 2-spine as the second piece, and back
spine-2→spine-3-tail ∷ spine 2 → spine-3-tail
spine-2→spine-3-tail (xs , w) = ((𝕀1 , xs) , (refl , w))

spine-3-tail→spine-2 ∷ spine-3-tail → spine 2
spine-3-tail→spine-2 (c , w) = (cube-3-tail c , prod-snd {cube-3-x1 c ≡ 𝕀1} {is-in-spine 2 (cube-3-tail c)} w)

-- the vertex (1 , 0 , 0), on each piece; on the second one it is the vertex 0 of the 2-spine
spine-3-edge-1-end ∷ spine-3-edge-1
spine-3-edge-1-end = ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl)

spine-3-tail-start ∷ spine-3-tail
spine-3-tail-start = spine-2→spine-3-tail (spine-2-edge-1-incl spine-2-edge-1-start)

spine-3-on-tail-vertex ∷ spine-3-on-tail (𝕀1 , 𝕀0 , 𝕀0 , tt)
spine-3-on-tail-vertex = snd spine-3-on-tail spine-3-tail-start

spine-3-glue ∷ spine-3-edge-1-incl spine-3-edge-1-end ≡{spine 3} spine-3-tail-incl spine-3-tail-start
spine-3-glue = union-glue spine-3-on-edge-1 spine-3-on-tail (𝕀1 , 𝕀0 , 𝕀0 , tt) refl spine-3-on-tail-vertex

-- the intersection of the two pieces is contractible, with centre the vertex
spine-3-meet-contr-aux2 ∷ (c1 : 𝕀) (xs : cart-cube 2) (w : spine-3-on-edge-1 (c1 , xs) × spine-3-on-tail (c1 , xs)) →
  ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , spine-3-on-tail-vertex) ≡{union-I spine-3-on-edge-1 spine-3-on-tail} ((c1 , xs) , w)
spine-3-meet-contr-aux2 c1 xs w =
  subtype-path (λ c . spine-3-on-edge-1 c × spine-3-on-tail c)
    (λ c . is-prop-prod (is-prop-spine-3-on-edge-1 c) (is-prop-spine-3-on-tail c)) {(𝕀1 , 𝕀0 , 𝕀0 , tt)}
    {(c1 , xs)}
    (cong2 {𝕀} {cart-cube 2} {cart-cube 3} pair
      (sym (prod-fst {c1 ≡ 𝕀1} {is-in-spine 2 xs} (prod-snd {spine-3-on-edge-1 (c1 , xs)} {spine-3-on-tail (c1 , xs)} w)))
      (sym (prod-fst {spine-3-on-edge-1 (c1 , xs)} {spine-3-on-tail (c1 , xs)} w)))
    (refl , spine-3-on-tail-vertex) w

spine-3-meet-contr-aux1 ∷ (c : cart-cube 3) (w : spine-3-on-edge-1 c × spine-3-on-tail c) →
  ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , spine-3-on-tail-vertex) ≡{union-I spine-3-on-edge-1 spine-3-on-tail} (c , w)
spine-3-meet-contr-aux1 (c1 , xs) w = spine-3-meet-contr-aux2 c1 xs w

spine-3-meet-contr ∷ (t : union-I spine-3-on-edge-1 spine-3-on-tail) →
  ((𝕀1 , 𝕀0 , 𝕀0 , tt) , refl , spine-3-on-tail-vertex) ≡{union-I spine-3-on-edge-1 spine-3-on-tail} t
spine-3-meet-contr (c , w) = spine-3-meet-contr-aux1 c w

-- the universal properties of the 3-spine
spine-3-cart-up ∷
  wedge-cart-up (spine 3)
    spine-3-edge-1 spine-3-tail
    spine-3-edge-1-incl spine-3-tail-incl
    spine-3-edge-1-end spine-3-tail-start
    spine-3-glue
spine-3-cart-up Y =
  union-pt-up spine-3-on-edge-1 spine-3-on-tail is-prop-spine-3-on-edge-1 is-prop-spine-3-on-tail Y
    (𝕀1 , 𝕀0 , 𝕀0 , tt) refl spine-3-on-tail-vertex spine-3-meet-contr

spine-3-oplax-up ∷ (X ∷ U) →
  is-equiv (wedge→cocone-r (spine 3)
    spine-3-edge-1 spine-3-tail
    spine-3-edge-1-incl spine-3-tail-incl
    spine-3-edge-1-end spine-3-tail-start
    spine-3-glue
    X)
spine-3-oplax-up X =
  wedge-oplax-up (spine 3)
    spine-3-edge-1 spine-3-tail
    spine-3-edge-1-incl spine-3-tail-incl
    spine-3-edge-1-end spine-3-tail-start
    spine-3-glue
    spine-3-cart-up X

spine-3-cocone-r ∷ (X ∷ U) → U
spine-3-cocone-r X = wedge-cocone-r spine-3-edge-1 spine-3-tail spine-3-edge-1-end spine-3-tail-start X

--
-- abbreviations of the wedge combinators, for the 3-spine
--

spine-3→cocone-r ∷ (X ∷ U) → (spine 3 →ᵣ X) → spine-3-cocone-r X
spine-3→cocone-r X = wedge→cocone-r (spine 3) spine-3-edge-1 spine-3-tail spine-3-edge-1-incl
  spine-3-tail-incl spine-3-edge-1-end spine-3-tail-start spine-3-glue X

cocone→spine-3-r ∷ (X ∷ U) → spine-3-cocone-r X → (spine 3 →ᵣ X)
cocone→spine-3-r X = cocone→wedge-r (spine 3) spine-3-edge-1 spine-3-tail spine-3-edge-1-incl spine-3-tail-incl
  spine-3-edge-1-end spine-3-tail-start spine-3-glue spine-3-cart-up X

spine-3→cocone-r-sec ∷ (X ∷ U) (w : spine-3-cocone-r X) → spine-3→cocone-r X (cocone→spine-3-r X w) ≡ w
spine-3→cocone-r-sec X w = wedge→cocone-r-sec (spine 3) spine-3-edge-1 spine-3-tail spine-3-edge-1-incl
  spine-3-tail-incl spine-3-edge-1-end spine-3-tail-start spine-3-glue spine-3-cart-up X w

spine-3-cocone-edge-1 ∷ {X ∷ U} → spine-3-cocone-r X → (spine-3-edge-1 →ᵣ X)
spine-3-cocone-edge-1 {X} w = wedge-cocone-r-fst {spine-3-edge-1} {spine-3-tail} {spine-3-edge-1-end} {spine-3-tail-start} {X} w

spine-3-cocone-tail ∷ {X ∷ U} → spine-3-cocone-r X → (spine-3-tail →ᵣ X)
spine-3-cocone-tail {X} w = wedge-cocone-r-snd {spine-3-edge-1} {spine-3-tail} {spine-3-edge-1-end} {spine-3-tail-start} {X} w

spine-3-cocone-glue ∷ {X ∷ U} (w : spine-3-cocone-r X) →
  spine-3-cocone-edge-1 {X} w spine-3-edge-1-end ≡ spine-3-cocone-tail {X} w spine-3-tail-start
spine-3-cocone-glue {X} w = wedge-cocone-r-glue {spine-3-edge-1} {spine-3-tail} {spine-3-edge-1-end} {spine-3-tail-start} {X} w
