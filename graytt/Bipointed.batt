--
-- Bipointed types
--

open import Stdlib

-- type of bipointed types
U⁎⁎ ∷ TYPE
U⁎⁎ = Σ (X : U) . (X × X)

-- underlying type
type ∷ U⁎⁎ → U
type (X, _) = X

left ∷ (X' : U⁎⁎) → ⟨ X' ⟩
left (X, u) = fst (λ_.X) u

right ∷ (X' : U⁎⁎) → ⟨ X' ⟩
right (X, u) = snd (λ_.X) u

-- type of bipointed maps between bipointed types
map⁎⁎ ∷ (X' Y' : U⁎⁎) → U
map⁎⁎ X' Y' =
  let X : U = ⟨ X' ⟩ in
  let Y : U = ⟨ Y' ⟩ in
  Σ (f : X → Y) . ((f (left X') ≡{ Y } left Y') × (f (right X') ≡{ Y } right Y'))

map-map⁎⁎ ∷ {X' Y' : U⁎⁎} → map⁎⁎ X' Y' → ⟨ X' ⟩ → ⟨ Y' ⟩
map-map⁎⁎ (f, _) = f

map⁎⁎-left ∷ {X' Y' : U⁎⁎} → (f' : map⁎⁎ X' Y') → map-map⁎⁎ f' (left X') ≡ left Y'
map⁎⁎-left {X'} {Y'} (f, u) = fst (λ_. f (right X') ≡ right Y') u

map⁎⁎-right ∷ {X' Y' : U⁎⁎} → (f' : map⁎⁎ X' Y') → map-map⁎⁎ f' (right X') ≡ right Y'
map⁎⁎-right {X'} {Y'} (f, u) = snd (λ_. f (right X') ≡ right Y') u

-- identity and composition for bipointed maps
id⁎⁎ ∷ {X' : U⁎⁎} → map⁎⁎ X' X'
id⁎⁎ {X'} = (id, refl, refl)

circ⁎⁎ ∷ {X' Y' Z' : U⁎⁎} → map⁎⁎ Y' Z' → map⁎⁎ X' Y' → map⁎⁎ X' Z'
circ⁎⁎ {X'} {Y'} {Z'} g' f' =
  let X : U = ⟨ X' ⟩ in
  let x0 : X = left X' in
  let x1 : X = right X' in
  let Y : U = ⟨ Y' ⟩ in
  let y0 : Y = left Y' in
  let y1 : Y = right Y' in
  let Z : U = ⟨ Z' ⟩ in
  let z0 : Z = left Z' in
  let z1 : Z = right Z' in
  let f : X → Y = map-map⁎⁎ {X'} {Y'} f' in
  let g : Y → Z = map-map⁎⁎ {Y'} {Z'} g' in
  let fx0-y0 : f x0 ≡{Y} y0 = map⁎⁎-left {X'} {Y'} f' in
  let fx1-y1 : f x1 ≡{Y} y1 = map⁎⁎-right {X'} {Y'} f' in
  let gy0-z0 : g y0 ≡{Z} z0 = map⁎⁎-left {Y'} {Z'} g' in
  let gy1-z1 : g y1 ≡{Z} z1 = map⁎⁎-right {Y'} {Z'} g' in
  let gf : X → Z = circ g f in
  let gfx0-gy0 : g (f x0) ≡ g y0 = cong g fx0-y0 in
  let gfx1-gy1 : g (f x1) ≡ g y1 = cong g fx1-y1 in
  let gfx0-z0 : g (f x0) ≡ z0 = trans gfx0-gy0 gy0-z0 in
  let gfx1-z1 : g (f x1) ≡ z1 = trans gfx1-gy1 gy1-z1 in
  (gf, (gfx0-z0, gfx1-z1))

-- oplax type of bipointed maps between bipointed types
oplax⁎⁎ ∷ (X' Y' ∷ U⁎⁎) → U
oplax⁎⁎ X' Y' =
  let X ∷ U = ⟨ X' ⟩ in
  let Y ∷ U = ⟨ Y' ⟩ in
  Σ (f : X →ᵣ Y) . ((f (left X') ≡ left Y') × (f (right X') ≡ right Y'))

oplax-oplax⁎⁎ ∷ {X' Y' ∷ U⁎⁎} → oplax⁎⁎ X' Y' → ⟨ X' ⟩ →ᵣ ⟨ Y' ⟩
oplax-oplax⁎⁎ (f, _) = f

oplax⁎⁎-left ∷ {X' Y' ∷ U⁎⁎} → (f' : oplax⁎⁎ X' Y') → oplax-oplax⁎⁎ f' (left X') ≡ left Y'
oplax⁎⁎-left {X'} {Y'} (f, u) = fst (λ_. f (right X') ≡ right Y') u

oplax⁎⁎-right ∷ {X' Y' ∷ U⁎⁎} → (f' : oplax⁎⁎ X' Y') → oplax-oplax⁎⁎ f' (right X') ≡ right Y'
oplax⁎⁎-right {X'} {Y'} (f, u) = snd (λ_. f (right X') ≡ right Y') u

-- bipointed homotopies of bipointed maps

ho⁎⁎ : {X' Y' ∷ U⁎⁎} (f' g' : map⁎⁎ X' Y') → U
ho⁎⁎ {X'} {Y'} f' g' =
  let X : U = ⟨ X' ⟩ in
  let Y : U = ⟨ Y' ⟩ in
  let x0 : X = left X' in
  let x1 : X = right X' in
  let y0 : Y = left Y' in
  let y1 : Y = right Y' in
  let f : X → Y = map-map⁎⁎ f' in
  let f0 : f x0 ≡ y0 = map⁎⁎-left f' in
  let f1 : f x1 ≡ y1 = map⁎⁎-right f' in
  let g : X → Y = map-map⁎⁎ g' in
  let g0 : g x0 ≡ y0 = map⁎⁎-left g' in
  let g1 : g x1 ≡ y1 = map⁎⁎-right g' in
  Σ (H : ho f g) . (f0 ≡ trans (H x0) g0) × (f1 ≡ trans (H x1) g1)

-- Bipointed interval
𝕀' ∷ U⁎⁎
𝕀' = (𝕀, 𝕀0, 𝕀1)