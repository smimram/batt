open import Stdlib
open import Interval
open import Bipointed

-- Gray cylinder
cyl ∷ (X ∷ U) → U
cyl X = X ⨂ 𝕀

-- Boundary of the Gray cylinder
cylbnd ∷ (X ∷ U) → U
cylbnd X = X ⨂ bool

-- Inclusion X ⨂ ∂𝕀 ↪ X ⨂ 𝕀
cylbnd-inclusion ∷ (X ∷ U) → cylbnd X → cyl X
cylbnd-inclusion X = Tensor.map id boundary-inclusion

-- Suspension operation
susp ∷ (X ∷ U) → U
susp X = pushout-obj (cylbnd-inclusion X) Tensor.snd

-- map from the Gray cylinder (quotient map)
cyl→susp ∷ (X ∷ U) → X ⨂ 𝕀 → susp X
cyl→susp X = pushout-inl (cylbnd-inclusion X) Tensor.snd

-- inclusion ∂𝕀 ↪ susp X
bool→susp ∷ (X ∷ U) → bool → susp X
bool→susp X = pushout-inr (cylbnd-inclusion X) Tensor.snd

-- left (source) point of the suspension
left-susp ∷ (X ∷ U) → susp X
left-susp X = bool→susp X false

-- right (sink) point of the suspension
right-susp ∷ (X ∷ U) → susp X
right-susp X = bool→susp X true

-- bipointed suspension type
susp' ∷ (X ∷ U) → U⁎⁎
susp' X = (susp(X), (left-susp(X), right-susp(X)))

cyl→susp-leftcoh ∷ {X ∷ U} (x : X) → cyl→susp X (x ⊗ 𝕀0) ≡ left-susp X
cyl→susp-leftcoh {X} x = pushout-eq (cylbnd-inclusion X) Tensor.snd (x ⊗ false)

cyl→susp-rightcoh ∷ {X ∷ U} (x : X) → cyl→susp X (x ⊗ 𝕀1) ≡ right-susp X
cyl→susp-rightcoh {X} x = pushout-eq (cylbnd-inclusion X) Tensor.snd (x ⊗ true)

--
-- canonical projection (susp X → 𝕀)
--

-- auxiliary homotopy
private
ho-susp-to-I ∷ (X ∷ U) (u : X ⨂ bool) → Tensor.snd (cylbnd-inclusion X u) ≡ boundary-inclusion (Tensor.snd {X} {bool} u)
ho-susp-to-I X (x ⊗ b) = Bool.ind (λb. Tensor.snd (cylbnd-inclusion X (x ⊗ b)) ≡ boundary-inclusion b) refl refl b

-- the projection
susp-to-I ∷ (X ∷ U) → susp X → 𝕀
susp-to-I X = pushout-univ (cylbnd-inclusion X) Tensor.snd 𝕀
  Tensor.snd boundary-inclusion (ho-susp-to-I X)

-- meridian map
merid ∷ {X ∷ U} (x : X) → (𝕀 →ᵣ susp X)
merid {X} x s = cyl→susp X (x ⊗ s)

lcoh-merid ∷ {X ∷ U} (x : X) → merid x 𝕀0 ≡ left-susp X
lcoh-merid x = cyl→susp-leftcoh x

rcoh-merid ∷ {X ∷ U} (x : X) → merid x 𝕀1 ≡ right-susp X
rcoh-merid x = cyl→susp-rightcoh x

merid' ∷ {X ∷ U} (x : X) → oplax⁎⁎ 𝕀⁎⁎ (susp' X)
merid' x = (merid(x), (lcoh-merid(x), rcoh-merid(x)))

--
-- functoriality of the suspension
--

susp-map ∷ (X Y ∷ U) (f ∷ X → Y) → susp X → susp Y
susp-map X Y f =
  let leg-cyl ∷ X ⨂ 𝕀 → susp Y = circ (cyl→susp Y) (Tensor.map f id) in
  let leg-bool ∷ bool → susp Y = bool→susp Y in
  let ho-legs ∷ (u : X ⨂ bool) → leg-cyl (cylbnd-inclusion X u) ≡ leg-bool (Tensor.snd u) =
    λ (x ⊗ b) . pushout-eq (cylbnd-inclusion Y) Tensor.snd (f(x) ⊗ b)
  in
  pushout-univ (cylbnd-inclusion X) Tensor.snd (susp Y)
    leg-cyl leg-bool ho-legs