--
-- Columns of cocartesian cells
--
-- For a crisp map p : X → A between oplax-Segal types and an oplax family lc of p-cocartesian
-- 1-cells, the square of lc is a column at every hom n out of the target of its last cell
-- (cocart-column), as soon as its image in A is a column (at every hom out of the image).
--
-- Proof. On families with a given end, the square of lc is a column iff pointwise composition
-- of pairs is an equivalence (Column-families.batt). A cocartesian cell c has an equivalence as
-- gap map: the composable pairs with first hom c are the pullback of the composable pairs in A
-- with first hom p c along the image of homs out of the source of c (cocart-pairs→gaps, written
-- as the pulled-back family cc-tot). Families with a given end of such a pulled-back family behave
-- like those of the family in A (families-pb-ends, Family-pullback.batt), where composition is an
-- equivalence by hypothesis.
--
-- Postulates: those of the exchange law (objectwise-equiv, univalence, truncation, is-set-𝕀).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Functoriality
open import Fibration
open import HomSquare
open import Square-fibres
open import Family-pullback
open import Column
open import Column-families

--
-- The gap map on composable pairs with a cocartesian first hom
--

-- composable pairs of homs whose first hom is a cocartesian 1-cell
private
cocart-pairs ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → U
cocart-pairs {X} {A} sX sA p = pairs-at {X} {cocart-cell sX sA p} (cocart-cell-arr sX sA p)

-- the corresponding gap data
private
cocart-gaps ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → U
cocart-gaps {X} {A} sX sA p =
  Σ (c : cocart-cell sX sA p) . Σ (z : X) . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z

-- the gap map
private
cocart-pairs→gaps ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → cocart-pairs sX sA p → cocart-gaps sX sA p
cocart-pairs→gaps {X} {A} sX sA p w =
  let c : cocart-cell sX sA p = fst _ w in
  (c , (fst _ (snd _ w) ,
        cocart-gap {X} {A} sX sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) (fst _ (snd _ w)) (snd _ (snd _ w))))

private
is-equiv-cocart-pairs→gaps ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → is-equiv (cocart-pairs→gaps sX sA p)
is-equiv-cocart-pairs→gaps {X} {A} sX sA p =
  is-equiv-htpy {cocart-pairs sX sA p} {cocart-gaps sX sA p}
    {tot {cocart-cell sX sA p} {λ c . Σ (z : X) . hom (tgtᵣ (fst _ c)) z}
       {λ c . Σ (z : X) . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
       (λ c . tot {X} {λ z . hom (tgtᵣ (fst _ c)) z} {λ z . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
                (λ z . cocart-gap {X} {A} sX sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z))}
    {cocart-pairs→gaps sX sA p}
    (fun (c , w) → let h : (w : Σ (z : X) . hom (tgtᵣ (fst _ c)) z) →
         tot {X} {λ z . hom (tgtᵣ (fst _ c)) z} {λ z . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
           (λ z . cocart-gap {X} {A} sX sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z) w
         ≡ snd _ (cocart-pairs→gaps sX sA p (c , w)) = fun (z , g) → refl in
       cong {Σ (z : X) . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z} {cocart-gaps sX sA p}
         (λ y . (c , y)) (h w))
  (is-equiv-tot {cocart-cell sX sA p} {λ c . Σ (z : X) . hom (tgtᵣ (fst _ c)) z}
    {λ c . Σ (z : X) . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
    (λ c . tot {X} {λ z . hom (tgtᵣ (fst _ c)) z} {λ z . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
             (λ z . cocart-gap {X} {A} sX sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z))
    (λ c . is-equiv-tot {X} {λ z . hom (tgtᵣ (fst _ c)) z}
             {λ z . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z}
             (λ z . cocart-gap {X} {A} sX sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z)
             (snd _ c)))

--
-- The pulled-back family
--

-- the image in A of a cocartesian cell
cc-kA ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → cocart-cell sX sA p → arrᵣ A
cc-kA {X} {A} sX sA p c = postᵣ p (cocart-cell-arr sX sA p c)

-- homs out of the source of a cell, and out of its image
private
cc-TH ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → cocart-cell sX sA p → U
cc-TH {X} {A} sX sA p c = Σ (z : X) . hom (srcᵣ (cocart-cell-arr sX sA p c)) z

private
cc-TA ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → cocart-cell sX sA p → U
cc-TA {X} {A} sX sA p c = Σ (z : A) . hom (srcᵣ (cc-kA sX sA p c)) z

private
cc-pc ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (c : cocart-cell sX sA p) →
  cc-TH sX sA p c → cc-TA sX sA p c
cc-pc {X} {A} sX sA p c w = (p (fst _ w) , hom-map {X} {A} p {srcᵣ (cocart-cell-arr sX sA p c)} {fst _ w} (snd _ w))

-- the factorisations of a hom out of the image through the image
private
cc-G ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (c : cocart-cell sX sA p) → cc-TA sX sA p c → U
cc-G {X} {A} sX sA p c w =
  Σ (v : hom (tgtᵣ (cc-kA sX sA p c)) (fst _ w)) . snd _ w ≡ comp-homᵣ sA (arr-hom (cc-kA sX sA p c)) v

-- gap data, as points of the pulled-back family
private
cc-gaps→tot ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) →
  cocart-gaps sX sA p → pb-tot (cc-TH sX sA p) (cc-TA sX sA p) (cc-pc sX sA p) (cc-G sX sA p)
cc-gaps→tot {X} {A} sX sA p w =
  (fst _ w , ((fst _ (snd _ w) , fst _ (snd _ (snd _ w))) , snd _ (snd _ (snd _ w))))

private
is-equiv-cc-gaps→tot ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → is-equiv (cc-gaps→tot sX sA p)
is-equiv-cc-gaps→tot {X} {A} sX sA p =
  let D : U = cocart-gaps sX sA p in
  let E : U = pb-tot (cc-TH sX sA p) (cc-TA sX sA p) (cc-pc sX sA p) (cc-G sX sA p) in
  let inv : E → D = λ w . (fst _ w , (fst _ (fst _ (snd _ w)) , (snd _ (fst _ (snd _ w)) , snd _ (snd _ w)))) in
  let sec : (w : E) → cc-gaps→tot sX sA p (inv w) ≡ w = fun (c , w1) →
    let k1 : (w1 : Σ (w : cc-TH sX sA p c) . cc-G sX sA p c (cc-pc sX sA p c w)) → cc-gaps→tot sX sA p (inv (c , w1)) ≡{E} (c , w1) =
      fun (zh , y) →
        let k2 : (zh : cc-TH sX sA p c) (y : cc-G sX sA p c (cc-pc sX sA p c zh)) → cc-gaps→tot sX sA p (inv (c , (zh , y))) ≡{E} (c , (zh , y)) =
          fun (z , h) → λ y . refl in
        k2 zh y in
    k1 w1 in
  let retr : (w : D) → inv (cc-gaps→tot sX sA p w) ≡ w = fun (c , w1) →
    let k1 : (w1 : Σ (z : X) . cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z) →
        inv (cc-gaps→tot sX sA p (c , w1)) ≡{D} (c , w1) = fun (z , w2) →
      let k2 : (w2 : cocart-pb {X} {A} sA p {srcᵣ (fst _ c)} {tgtᵣ (fst _ c)} (cell-hom (fst _ c)) z) →
          inv (cc-gaps→tot sX sA p (c , (z , w2))) ≡{D} (c , (z , w2)) = fun (h , y) → refl in
      k2 w2 in
    k1 w1 in
  is-iso→is-equiv (cc-gaps→tot sX sA p) (inv , (sec , retr))

-- composable pairs with a cocartesian first hom, as points of the pulled-back family
private
cc-γX ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) →
  cocart-pairs sX sA p → pb-tot (cc-TH sX sA p) (cc-TA sX sA p) (cc-pc sX sA p) (cc-G sX sA p)
cc-γX {X} {A} sX sA p w = cc-gaps→tot sX sA p (cocart-pairs→gaps sX sA p w)

private
is-equiv-cc-γX ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → is-equiv (cc-γX sX sA p)
is-equiv-cc-γX {X} {A} sX sA p =
  is-equiv-circ (cc-gaps→tot sX sA p) (cocart-pairs→gaps sX sA p) (is-equiv-cc-gaps→tot sX sA p) (is-equiv-cocart-pairs→gaps sX sA p)

-- composable pairs in A, as points of the total space of the factorisations
private
cc-γA ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) →
  pairs-at (cc-kA sX sA p) → pb-tot' (cc-TA sX sA p) (cc-G sX sA p)
cc-γA {X} {A} sX sA p w =
  (fst _ w , ((fst _ (snd _ w) , comp-homᵣ sA (arr-hom (cc-kA sX sA p (fst _ w))) (snd _ (snd _ w))) , (snd _ (snd _ w) , refl)))

private
cc-γA-path ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (c : cocart-cell sX sA p) (z : A)
  (v : hom (tgtᵣ (cc-kA sX sA p c)) z) {h : hom (srcᵣ (cc-kA sX sA p c)) z}
  (π : comp-homᵣ sA (arr-hom (cc-kA sX sA p c)) v ≡ h) →
  ((z , comp-homᵣ sA (arr-hom (cc-kA sX sA p c)) v) , (v , refl)) ≡{Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w} ((z , h) , (v , sym π))
cc-γA-path {X} {A} sX sA p c z v refl = refl

private
is-equiv-cc-γA ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) → is-equiv (cc-γA sX sA p)
is-equiv-cc-γA {X} {A} sX sA p =
  let D : U = pairs-at (cc-kA sX sA p) in
  let E : U = pb-tot' (cc-TA sX sA p) (cc-G sX sA p) in
  let inv : E → D = λ w . (fst _ w , (fst _ (fst _ (snd _ w)) , fst _ (snd _ (snd _ w)))) in
  let sec : (w : E) → cc-γA sX sA p (inv w) ≡ w = fun (c , w1) →
    let k1 : (w1 : Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w) → cc-γA sX sA p (inv (c , w1)) ≡{E} (c , w1) = fun (zh , y) →
      let k2 : (zh : cc-TA sX sA p c) (y : cc-G sX sA p c zh) → cc-γA sX sA p (inv (c , (zh , y))) ≡{E} (c , (zh , y)) =
        fun (z , h) → fun (v , π) →
          cong {Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w} {E} (λ q . (c , q))
            (trans (cc-γA-path sX sA p c z v (sym π))
              (cong {h ≡ comp-homᵣ sA (arr-hom (cc-kA sX sA p c)) v} {Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w}
                (λ q . ((z , h) , (v , q))) (sym-sym π))) in
      k2 zh y in
    k1 w1 in
  let retr : (w : D) → inv (cc-γA sX sA p w) ≡ w = fun (c , w1) →
    let k1 : (w1 : Σ (z : A) . hom (tgtᵣ (cc-kA sX sA p c)) z) → inv (cc-γA sX sA p (c , w1)) ≡{D} (c , w1) = fun (z , v) → refl in
    k1 w1 in
  is-iso→is-equiv (cc-γA sX sA p) (inv , (sec , retr))

-- the same, fibrewise over the cells
private
cc-γX-fib ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (c : cocart-cell sX sA p) →
  (Σ (z : X) . hom (tgtᵣ (cocart-cell-arr sX sA p c)) z) → Σ (w : cc-TH sX sA p c) . cc-G sX sA p c (cc-pc sX sA p c w)
cc-γX-fib {X} {A} sX sA p c w = snd _ (cc-γX sX sA p (c , w))

private
is-equiv-tot-cc-γX-fib ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) →
  is-equiv (tot {cocart-cell sX sA p} {λ c . Σ (z : X) . hom (tgtᵣ (cocart-cell-arr sX sA p c)) z}
              {λ c . Σ (w : cc-TH sX sA p c) . cc-G sX sA p c (cc-pc sX sA p c w)} (cc-γX-fib sX sA p))
is-equiv-tot-cc-γX-fib {X} {A} sX sA p =
  is-equiv-htpy {cocart-pairs sX sA p} {pb-tot (cc-TH sX sA p) (cc-TA sX sA p) (cc-pc sX sA p) (cc-G sX sA p)}
    {cc-γX sX sA p}
    {tot {cocart-cell sX sA p} {λ c . Σ (z : X) . hom (tgtᵣ (cocart-cell-arr sX sA p c)) z}
       {λ c . Σ (w : cc-TH sX sA p c) . cc-G sX sA p c (cc-pc sX sA p c w)} (cc-γX-fib sX sA p)}
    (fun (c , w) → refl) (is-equiv-cc-γX sX sA p)

private
cc-γA-fib ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (c : cocart-cell sX sA p) →
  (Σ (z : A) . hom (tgtᵣ (cc-kA sX sA p c)) z) → Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w
cc-γA-fib {X} {A} sX sA p c w = snd _ (cc-γA sX sA p (c , w))

private
is-equiv-tot-cc-γA-fib ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) →
  is-equiv (tot {cocart-cell sX sA p} {λ c . Σ (z : A) . hom (tgtᵣ (cc-kA sX sA p c)) z}
              {λ c . Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w} (cc-γA-fib sX sA p))
is-equiv-tot-cc-γA-fib {X} {A} sX sA p =
  is-equiv-htpy {pairs-at (cc-kA sX sA p)} {pb-tot' (cc-TA sX sA p) (cc-G sX sA p)}
    {cc-γA sX sA p}
    {tot {cocart-cell sX sA p} {λ c . Σ (z : A) . hom (tgtᵣ (cc-kA sX sA p c)) z}
       {λ c . Σ (w : cc-TA sX sA p c) . cc-G sX sA p c w} (cc-γA-fib sX sA p)}
    (fun (c , w) → refl) (is-equiv-cc-γA sX sA p)

--
-- Columns of cocartesian cells
--

cocart-column ∷ {X A ∷ U} (sX ∷ is-segalᵣ X) (sA ∷ is-segalᵣ A) (p ∷ X → A) (lc : 𝕀 →ᵣ cocart-cell sX sA p) →
  ((e0 : ends (λ c . tgtᵣ (cc-kA sX sA p c))) → fst _ e0 ≡ lc →
    is-column sA (fam-arr-sq (cc-kA sX sA p) (fst _ e0)) (snd _ (snd _ e0))) →
  (e : ends (λ c . tgtᵣ (cocart-cell-arr sX sA p c))) → fst _ e ≡ lc →
  is-column sX (fam-arr-sq (cocart-cell-arr sX sA p) (fst _ e)) (snd _ (snd _ e))
cocart-column {X} {A} sX sA p lc hA e o =
  let C ∷ U = cocart-cell sX sA p in
  let kX ∷ C → arrᵣ X = cocart-cell-arr sX sA p in
  let kA ∷ C → arrᵣ A = cc-kA sX sA p in
  let TH ∷ C → U = cc-TH sX sA p in
  let TA ∷ C → U = cc-TA sX sA p in
  let pc ∷ (c : C) → TH c → TA c = cc-pc sX sA p in
  let G ∷ (c : C) → TA c → U = cc-G sX sA p in
  let EA : U = pb-tot' (end-fam TA) (end-dfam TA G) in
  let EX : U = pb-tot (end-fam TH) (end-fam TA) (end-map TH TA pc) (end-dfam TA G) in
  let PA : C → U = λ c . Σ (z : A) . hom (tgtᵣ (kA c)) z in
  let QA : C → U = λ c . Σ (w : TA c) . G c w in
  let PX : C → U = λ c . Σ (z : X) . hom (tgtᵣ (kX c)) z in
  let QX : C → U = λ c . Σ (w : TH c) . G c (pc c w) in
  let gAe : ends (λ c . tgtᵣ (kA c)) → EA = end-tot {C} {PA} {QA} (cc-γA-fib sX sA p) in
  let egAe : is-equiv gAe = is-equiv-end-tot {C} {PA} {QA} (cc-γA-fib sX sA p) (is-equiv-tot-cc-γA-fib sX sA p) in
  let gXe : ends (λ c . tgtᵣ (kX c)) → EX = end-tot {C} {PX} {QX} (cc-γX-fib sX sA p) in
  let egXe : is-equiv gXe = is-equiv-end-tot {C} {PX} {QX} (cc-γX-fib sX sA p) (is-equiv-tot-cc-γX-fib sX sA p) in
  -- in A, the hypothesis, read on the total space of the factorisations
  let hA' : (e' : EA) → fst _ e' ≡ lc → is-equiv (pb-ends-fib' TA G e') = λ e' o' .
    let e0 : ends (λ c . tgtᵣ (kA c)) = section-map gAe (is-equiv-sec gAe egAe) e' in
    let P : gAe e0 ≡ e' = snd _ (is-equiv-sec gAe egAe) e' in
    let o0 : fst _ e0 ≡ lc = trans (cong {EA} {𝕀 →ᵣ C} (λ x . fst _ x) P) o' in
    let eq0 : is-equiv (pb-ends-fib' TA G (gAe e0)) =
      base-fib-pre-equiv-inv {𝕀 →ᵣ pairs-at kA} {𝕀 →ᵣ pb-tot' TA G} {𝕀 →ᵣ pb-base TA} {ends (λ c . tgtᵣ (kA c))} {EA}
        {pb-base (end-fam TA)}
        (postᵣ (pb-pr' TA G)) (pb-ends' TA G) (pb-base-ends TA) (pb-pr' (end-fam TA) (end-dfam TA G)) (λ Ψ . refl)
        (postᵣ (cc-γA sX sA p)) (fam-ends (λ c . tgtᵣ (kA c))) gAe (λ x . refl)
        (postᵣ-equiv 𝕀 (cc-γA sX sA p) (is-equiv-cc-γA sX sA p)) egAe e0
        (is-column→fib sA kA e0 (hA e0 o0)) in
    subst {EA} (λ e' . is-equiv (pb-ends-fib' TA G e')) P eq0 in
  -- in X, by the cube
  let hX : is-equiv (pb-ends-fib TH TA pc G (gXe e)) = families-pb-ends TH TA pc G lc hA' (gXe e) o in
  let hP : is-equiv (pairs-fib-comp sX kX e) =
    base-fib-pre-equiv {𝕀 →ᵣ cocart-pairs sX sA p} {𝕀 →ᵣ pb-tot TH TA pc G} {𝕀 →ᵣ pb-base TH}
      {ends (λ c . tgtᵣ (kX c))} {EX} {pb-base (end-fam TH)}
      (postᵣ (pb-pr TH TA pc G)) (pb-ends TH TA pc G) (pb-base-ends TH) (pb-pr (end-fam TH) (end-fam TA) (end-map TH TA pc) (end-dfam TA G))
      (λ Ψ . refl) (postᵣ (cc-γX sX sA p)) (fam-ends (λ c . tgtᵣ (kX c))) gXe (λ x . refl)
      (postᵣ-equiv 𝕀 (cc-γX sX sA p) (is-equiv-cc-γX sX sA p)) egXe e hX in
  fib→is-column sX kX e hP
