--
-- Folding squares along a connection
--
-- For a 2-simplex w of an oplax-Segal type C, with edges t : a → b, k : b → d and long edge
-- l : a → d, and any hom r : c → d, composing with the connection Γ_t on the left
--
--   fold-sq : (Σ g . square t r g k) → (Σ g' . square (id a) r g' (t ; k))
--             (g , σ) ↦ (id a ; g , Γ_t ; σ)
--
-- is an equivalence (is-equiv-fold-sq). Its inverse composes vertically with the square
-- Y (i , j) = w (i ∨ j , i) from l to k (fold-Y), whose left side is t: the two round trips are
-- the exchange law applied to the grids
--
--      Γ'_t | id k                id a | Y
--      Γ_t  | σ                   id a | τ
--
-- (Γ'_t is the coconnection), together with the identifications of the composites of their rows
-- and columns with identities, which are all read off 2-simplices of arrows (comp-h-simplex,
-- comp-v-simplex). The 2-simplex is extended to the whole square by w (u ∨ v , v) (fold-pt),
-- so that these 2-simplices of arrows exist for all pairs (t , k) of edges.
--
-- Postulates: those of the exchange law (objectwise-equiv, univalence, truncation, is-set-𝕀).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Unitality
open import Composable
open import Simplex-edges
open import HomSquare
open import Exchange
open import Square-paths

open Square

--
-- The 2-simplex on the whole square
--
-- A 2-simplex w is extended to all pairs (u , v) of the interval by w (u ∨ v , v) (fold-pt).
-- Its restriction to Δ² (fold-nrm w) has the same edges as w, judgmentally.
--

fold-pt ∷ 𝕀 → 𝕀 → simplex 2
fold-pt u v = ((u 𝕀∨ v , v , tt) , (refl , tt))

fold-nrm ∷ {C ∷ U} (w : simplex 2 →ᵣ C) → simplex 2 →ᵣ C
fold-nrm w = λ y . w (fold-pt (Simplex2.fst y) (Simplex2.snd y))

-- the composite of the first two edges is the long edge, read off the restriction
fold-comp ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  comp-homᵣ sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w) ≡ simplex2-hom₀₂ w
fold-comp sC w = comp-simplex2 sC (fold-nrm w)

-- the left unit law for t, read off the 2-simplex t (y₁ ∧ y₂)
fold-lunit ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  comp-homᵣ sC (Hom.id (w (Simplex2.edge₀₁ 𝕀0))) (simplex2-hom₀₁ w) ≡ simplex2-hom₀₁ w
fold-lunit sC w = comp-simplex2 sC (λ y . w (Simplex2.edge₀₁ (Simplex2.fst y 𝕀∧ Simplex2.snd y)))

-- the square Y (i , j) = w (i ∨ j , i): left side t, right side the identity, bottom side the
-- long edge, top side k
private
fold-Y ∷ {C ∷ U} (w : simplex 2 →ᵣ C) →
  square (simplex2-hom₀₁ w) (Hom.id (w (Simplex2.edge₁₂ 𝕀1))) (simplex2-hom₀₂ w) (simplex2-hom₁₂ w)
fold-Y w = (of-arrᵣ (λ i . λ j . w (fold-pt (i 𝕀∨ j) i)) , refl)

--
-- Identifications of composites of squares
--

-- Y is the composite of the coconnection on t and the vertical identity on k
private
fold-Y-split ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move refl refl (fold-comp sC w) (comp-homᵣ-lunit C sC (simplex2-hom₁₂ w))
    (comp-h sC (connection-bl (simplex2-hom₀₁ w)) (id-v (simplex2-hom₁₂ w)))
  ≡ fold-Y w
fold-Y-split {C} sC w =
  let Ξ : simplex 2 →ᵣ arrᵣ C = λ y . λ j . w (fold-pt (Simplex2.fst y 𝕀∨ j) (Simplex2.snd y)) in
  trans (sym (bdry-lr-move (Ξ (Simplex2.edge₀₁ 𝕀0)) (Ξ (Simplex2.edge₁₂ 𝕀1))
                (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} srcᵣ Ξ)) (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} tgtᵣ Ξ))
                (comp-h sC (connection-bl (simplex2-hom₀₁ w)) (id-v (simplex2-hom₁₂ w)))))
    (comp-h-simplex sC Ξ)

-- the connection on t below the coconnection on t is the horizontal identity on t
private
fold-tr-bl ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move (fold-lunit sC w) (comp-homᵣ-runit C sC (simplex2-hom₀₁ w)) refl refl
    (comp-v sC (connection-tr (simplex2-hom₀₁ w)) (connection-bl (simplex2-hom₀₁ w)))
  ≡ id-h (simplex2-hom₀₁ w)
fold-tr-bl {C} sC w =
  let Φ : 𝕀 →ᵣ (simplex 2 →ᵣ C) = λ i . λ y . w (Simplex2.edge₀₁ ((i 𝕀∨ Simplex2.snd y) 𝕀∧ Simplex2.fst y)) in
  let s : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₀₁ 𝕀0) in
  let t : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₁₂ 𝕀1) in
  trans (sym (bdry-st-move s t Φ (comp-simplex2 sC (Φ 𝕀0)) (comp-simplex2 sC (Φ 𝕀1))
                (comp-v sC (connection-tr (simplex2-hom₀₁ w)) (connection-bl (simplex2-hom₀₁ w)))))
    (comp-v-simplex sC Φ)

-- the vertical identity on the identity below the connection on t is the connection on t
private
fold-id-tr ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move (comp-homᵣ-runit C sC (Hom.id (w (Simplex2.edge₀₁ 𝕀0)))) (fold-lunit sC w) refl refl
    (comp-v sC (id-h (Hom.id (w (Simplex2.edge₀₁ 𝕀0)))) (connection-tr (simplex2-hom₀₁ w)))
  ≡ connection-tr (simplex2-hom₀₁ w)
fold-id-tr {C} sC w =
  let Φ : 𝕀 →ᵣ (simplex 2 →ᵣ C) = λ i . λ y . w (Simplex2.edge₀₁ ((Simplex2.fst y 𝕀∧ Simplex2.snd y) 𝕀∧ i)) in
  let s : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₀₁ 𝕀0) in
  let t : (simplex 2 →ᵣ C) → C = λ c . c (Simplex2.edge₁₂ 𝕀1) in
  trans (sym (bdry-st-move s t Φ (comp-simplex2 sC (Φ 𝕀0)) (comp-simplex2 sC (Φ 𝕀1))
                (comp-v sC (id-h (Hom.id (w (Simplex2.edge₀₁ 𝕀0)))) (connection-tr (simplex2-hom₀₁ w)))))
    (comp-v-simplex sC Φ)

-- the connection on t followed by Y is the vertical identity on the long edge
private
fold-tr-Y ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) →
  sq-move refl refl (comp-homᵣ-lunit C sC (simplex2-hom₀₂ w)) (fold-comp sC w)
    (comp-h sC (connection-tr (simplex2-hom₀₁ w)) (fold-Y w))
  ≡ id-v (simplex2-hom₀₂ w)
fold-tr-Y {C} sC w =
  let Ξ : simplex 2 →ᵣ arrᵣ C = λ y . λ j . w (fold-pt ((Simplex2.fst y 𝕀∧ j) 𝕀∨ Simplex2.snd y) (Simplex2.snd y)) in
  trans (sym (bdry-lr-move (Ξ (Simplex2.edge₀₁ 𝕀0)) (Ξ (Simplex2.edge₁₂ 𝕀1))
                (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} srcᵣ Ξ)) (comp-simplex2 sC (postᵣ {simplex 2} {arrᵣ C} {C} tgtᵣ Ξ))
                (comp-h sC (connection-tr (simplex2-hom₀₁ w)) (fold-Y w))))
    (comp-h-simplex sC Ξ)

--
-- Folding and unfolding
--

-- composing with the connection on the left
fold-sq ∷ {C ∷ U} (sC : is-segalᵣ C) {a b c d : C} (t : hom a b) (k : hom b d) (r : hom c d) →
  (Σ (g : hom a c) . square t r g k) → Σ (g' : hom a c) . square (Hom.id a) r g' (comp-homᵣ sC t k)
fold-sq sC {a} t k r (g , σ) = (comp-homᵣ sC (Hom.id a) g , comp-h sC (connection-tr t) σ)

-- composing vertically with Y, on the edges of a 2-simplex
private
unfold-sq ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) {c : C} (r : hom c (w (Simplex2.edge₁₂ 𝕀1))) →
  (Σ (g' : hom (w (Simplex2.edge₀₁ 𝕀0)) c) . square (Hom.id (w (Simplex2.edge₀₁ 𝕀0))) r g' (comp-homᵣ sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w))) →
  Σ (g : hom (w (Simplex2.edge₀₁ 𝕀0)) c) . square (simplex2-hom₀₁ w) r g (simplex2-hom₁₂ w)
unfold-sq {C} sC w r (g' , τ) =
  (g' , sq-move (fold-lunit sC w) (comp-homᵣ-runit C sC r) refl refl (comp-v sC (sq-move refl refl refl (fold-comp sC w) τ) (fold-Y w)))

fold-cancel ∷ {T : U} {x y : T} (p : x ≡ y) → trans (trans refl (sym p)) p ≡ refl
fold-cancel {T} {x} refl = refl

-- unfolding a folded square: the exchange law for the grid (Γ'_t , id k ; Γ_t , σ)
private
unfold-fold-sq ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) {c : C} (r : hom c (w (Simplex2.edge₁₂ 𝕀1)))
  (g : hom (w (Simplex2.edge₀₁ 𝕀0)) c) (σ : square (simplex2-hom₀₁ w) r g (simplex2-hom₁₂ w)) →
  sq-move refl refl (comp-homᵣ-lunit C sC g) refl
    (sq-move (fold-lunit sC w) (comp-homᵣ-runit C sC r) refl refl
      (comp-v sC (sq-move refl refl refl (fold-comp sC w) (comp-h sC (connection-tr (simplex2-hom₀₁ w)) σ)) (fold-Y w)))
  ≡ σ
unfold-fold-sq {C} sC w {c} r g σ =
  let a : C = w (Simplex2.edge₀₁ 𝕀0) in
  let b : C = w (Simplex2.edge₁₂ 𝕀0) in
  let d : C = w (Simplex2.edge₁₂ 𝕀1) in
  let t : hom a b = simplex2-hom₀₁ w in
  let k : hom b d = simplex2-hom₁₂ w in
  let lt : comp-homᵣ sC (Hom.id a) t ≡ t = fold-lunit sC w in
  let rt : comp-homᵣ sC t (Hom.id b) ≡ t = comp-homᵣ-runit C sC t in
  let rr : comp-homᵣ sC r (Hom.id d) ≡ r = comp-homᵣ-runit C sC r in
  let lg : comp-homᵣ sC (Hom.id a) g ≡ g = comp-homᵣ-lunit C sC g in
  let lk : comp-homᵣ sC (Hom.id b) k ≡ k = comp-homᵣ-lunit C sC k in
  let cw : comp-homᵣ sC t k ≡ simplex2-hom₀₂ w = fold-comp sC w in
  let Γ : square (Hom.id a) t (Hom.id a) t = connection-tr t in
  let Z : square t (Hom.id d) (comp-homᵣ sC t k) (comp-homᵣ sC (Hom.id b) k) = comp-h sC (connection-bl t) (id-v k) in
  let X1 : square (Hom.id a) r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k) = comp-h sC Γ σ in
  let L : hom a d = simplex2-hom₀₂ w in
  let S1 : U = square (comp-homᵣ sC (Hom.id a) t) (comp-homᵣ sC r (Hom.id d)) (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC (Hom.id b) k) in
  let S2 : U = square (comp-homᵣ sC (Hom.id a) t) (comp-homᵣ sC r (Hom.id d)) (comp-homᵣ sC (Hom.id a) g) k in
  let W : square t r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC (Hom.id b) k) = comp-h sC (id-h t) σ in
  -- the grid, composed by columns
  let e4 : comp-v sC Γ (connection-bl t) ≡ sq-move (sym lt) (sym rt) refl refl (id-h t) =
    sq-move-sym lt rt refl refl (comp-v sC Γ (connection-bl t)) (id-h t) (fold-tr-bl sC w) in
  let e5 : comp-v sC σ (id-v k) ≡ sq-move (sym rt) (sym rr) refl refl σ =
    sq-move-sym rt rr refl refl (comp-v sC σ (id-v k)) σ (trans (sym (bt-move rt rr (comp-v sC σ (id-v k)))) (comp-v-runit sC σ)) in
  let e36 : comp-v sC X1 Z ≡ sq-move (sym lt) (sym rr) refl refl W =
    trans (exchange sC Γ σ (connection-bl t) (id-v k))
      (trans (cong2 {square (comp-homᵣ sC (Hom.id a) t) (comp-homᵣ sC t (Hom.id b)) (Hom.id a) (Hom.id b)}
                    {square (comp-homᵣ sC t (Hom.id b)) (comp-homᵣ sC r (Hom.id d)) g k}
                    {square (comp-homᵣ sC (Hom.id a) t) (comp-homᵣ sC r (Hom.id d)) (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC (Hom.id b) k)}
                    (λ x y . comp-h sC x y) e4 e5)
        (comp-h-move sC (sym lt) (sym rt) (sym rr) refl refl refl refl (id-h t) σ)) in
  -- moving the top side of the square Y
  let X0 : comp-v sC (sq-move refl refl refl cw X1) (fold-Y w) ≡ sq-move refl refl refl lk (sq-move (sym lt) (sym rr) refl refl W) =
    trans (cong {square t (Hom.id d) L k} {S2} (λ y . comp-v sC (sq-move refl refl refl cw X1) y) (sym (fold-Y-split sC w)))
      (trans (comp-v-move sC refl refl refl refl refl cw lk X1 Z)
        (cong {S1} {S2} (λ x . sq-move refl refl refl lk x) e36)) in
  -- flattening the moves
  trans (cong {S2} {square t r g k} (λ x . sq-move refl refl lg refl (sq-move lt rr refl refl x)) X0)
    (trans (cong {S2} {square t r g k} (λ x . sq-move refl refl lg refl (sq-move lt rr refl refl x)) (sq-move-trans (sym lt) (sym rr) refl refl W refl refl refl lk))
      (trans (cong {square t r (comp-homᵣ sC (Hom.id a) g) k} {square t r g k} (λ x . sq-move refl refl lg refl x) (sq-move-trans (sym lt) (sym rr) refl (trans refl lk) W lt rr refl refl))
        (trans (sq-move-trans (trans (sym lt) lt) (trans (sym rr) rr) refl (trans refl lk) W refl refl lg refl)
          (trans (sq-move-path W (trans (sym lt) lt) (trans-sym-l lt) (trans (sym rr) rr) (trans-sym-l rr)
                    (trans refl lg) (trans-refl-l lg) (trans refl lk) (trans-refl-l lk))
            (trans (sym (lr-move lg lk W)) (comp-h-lunit sC σ))))))

-- folding an unfolded square: the exchange law for the grid (id a , Y ; id a , τ)
private
fold-unfold-sq ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) {c : C} (r : hom c (w (Simplex2.edge₁₂ 𝕀1)))
  (g : hom (w (Simplex2.edge₀₁ 𝕀0)) c) (τ : square (Hom.id (w (Simplex2.edge₀₁ 𝕀0))) r g (comp-homᵣ sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w))) →
  sq-move refl refl (comp-homᵣ-lunit C sC g) refl
    (comp-h sC (connection-tr (simplex2-hom₀₁ w))
      (sq-move (fold-lunit sC w) (comp-homᵣ-runit C sC r) refl refl (comp-v sC (sq-move refl refl refl (fold-comp sC w) τ) (fold-Y w))))
  ≡ τ
fold-unfold-sq {C} sC w {c} r g τ =
  let a : C = w (Simplex2.edge₀₁ 𝕀0) in
  let b : C = w (Simplex2.edge₁₂ 𝕀0) in
  let d : C = w (Simplex2.edge₁₂ 𝕀1) in
  let t : hom a b = simplex2-hom₀₁ w in
  let k : hom b d = simplex2-hom₁₂ w in
  let L : hom a d = simplex2-hom₀₂ w in
  let lt : comp-homᵣ sC (Hom.id a) t ≡ t = fold-lunit sC w in
  let ra : comp-homᵣ sC (Hom.id a) (Hom.id a) ≡ Hom.id a = comp-homᵣ-runit C sC (Hom.id a) in
  let rr : comp-homᵣ sC r (Hom.id d) ≡ r = comp-homᵣ-runit C sC r in
  let lg : comp-homᵣ sC (Hom.id a) g ≡ g = comp-homᵣ-lunit C sC g in
  let lL : comp-homᵣ sC (Hom.id a) L ≡ L = comp-homᵣ-lunit C sC L in
  let cw : comp-homᵣ sC t k ≡ L = fold-comp sC w in
  let Γ : square (Hom.id a) t (Hom.id a) t = connection-tr t in
  let A : square (Hom.id a) (Hom.id a) (Hom.id a) (Hom.id a) = id-h (Hom.id a) in
  let τ' : square (Hom.id a) r g L = sq-move refl refl refl cw τ in
  let V : square (comp-homᵣ sC (Hom.id a) t) (comp-homᵣ sC r (Hom.id d)) g k = comp-v sC τ' (fold-Y w) in
  let S0 : U = square (comp-homᵣ sC (Hom.id a) (Hom.id a)) (comp-homᵣ sC r (Hom.id d)) (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k) in
  -- the grid, composed by rows
  let b4 : comp-h sC A τ' ≡ sq-move refl refl (sym lg) (sym lL) τ' =
    sq-move-sym refl refl lg lL (comp-h sC A τ') τ' (trans (sym (lr-move lg lL (comp-h sC A τ'))) (comp-h-lunit sC τ')) in
  let b5 : comp-h sC Γ (fold-Y w) ≡ sq-move refl refl (sym lL) (sym cw) (id-v L) =
    sq-move-sym refl refl lL cw (comp-h sC Γ (fold-Y w)) (id-v L) (fold-tr-Y sC w) in
  let b7 : comp-v sC τ' (id-v L) ≡ sq-move (sym ra) (sym rr) refl refl τ' =
    sq-move-sym ra rr refl refl (comp-v sC τ' (id-v L)) τ' (trans (sym (bt-move ra rr (comp-v sC τ' (id-v L)))) (comp-v-runit sC τ')) in
  let rows : comp-h sC (comp-v sC A Γ) V ≡ sq-move refl refl (sym lg) (sym cw) (sq-move (sym ra) (sym rr) refl refl τ') =
    trans (sym (exchange sC A τ' Γ (fold-Y w)))
      (trans (cong2 {square (Hom.id a) r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC (Hom.id a) L)}
                    {square (Hom.id a) (Hom.id d) (comp-homᵣ sC (Hom.id a) L) (comp-homᵣ sC t k)}
                    {S0}
                    (λ x y . comp-v sC x y) b4 b5)
        (trans (comp-v-move sC refl refl refl refl (sym lg) (sym lL) (sym cw) τ' (id-v L))
          (cong {square (comp-homᵣ sC (Hom.id a) (Hom.id a)) (comp-homᵣ sC r (Hom.id d)) g L}
                {square (comp-homᵣ sC (Hom.id a) (Hom.id a)) (comp-homᵣ sC r (Hom.id d)) (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k)}
                (λ x . sq-move refl refl (sym lg) (sym cw) x) b7))) in
  -- the connection is the connection below an identity
  let all : comp-h sC Γ (sq-move lt rr refl refl V)
            ≡ sq-move ra rr refl refl (sq-move refl refl (sym lg) (sym cw) (sq-move (sym ra) (sym rr) refl refl τ')) =
    trans (cong {square (Hom.id a) t (Hom.id a) t}
                {square (Hom.id a) r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k)}
                (λ x . comp-h sC x (sq-move lt rr refl refl V)) (sym (fold-id-tr sC w)))
      (trans (comp-h-move sC ra lt rr refl refl refl refl (comp-v sC A Γ) V)
        (cong {S0} {square (Hom.id a) r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k)} (λ x . sq-move ra rr refl refl x) rows)) in
  -- flattening the moves
  let T0 : U = square (Hom.id a) r (comp-homᵣ sC (Hom.id a) g) (comp-homᵣ sC t k) in
  trans (cong {T0} {square (Hom.id a) r g (comp-homᵣ sC t k)} (λ x . sq-move refl refl lg refl x) all)
    (trans (cong {square (comp-homᵣ sC (Hom.id a) (Hom.id a)) (comp-homᵣ sC r (Hom.id d)) g L} {square (Hom.id a) r g (comp-homᵣ sC t k)}
                 (λ x . sq-move refl refl lg refl (sq-move ra rr refl refl (sq-move refl refl (sym lg) (sym cw) x)))
                 (sq-move-trans refl refl refl cw τ (sym ra) (sym rr) refl refl))
      (trans (cong {S0} {square (Hom.id a) r g (comp-homᵣ sC t k)}
                   (λ x . sq-move refl refl lg refl (sq-move ra rr refl refl x))
                   (sq-move-trans (trans refl (sym ra)) (trans refl (sym rr)) refl cw τ refl refl (sym lg) (sym cw)))
        (trans (cong {T0} {square (Hom.id a) r g (comp-homᵣ sC t k)}
                     (λ x . sq-move refl refl lg refl x)
                     (sq-move-trans (trans refl (sym ra)) (trans refl (sym rr)) (trans refl (sym lg)) (trans cw (sym cw)) τ ra rr refl refl))
          (trans (sq-move-trans (trans (trans refl (sym ra)) ra) (trans (trans refl (sym rr)) rr) (trans refl (sym lg)) (trans cw (sym cw)) τ refl refl lg refl)
            (sq-move-path τ (trans (trans refl (sym ra)) ra) (fold-cancel ra) (trans (trans refl (sym rr)) rr) (fold-cancel rr)
               (trans (trans refl (sym lg)) lg) (fold-cancel lg) (trans cw (sym cw)) (trans-sym-r cw))))))

-- on the edges of a 2-simplex, folding is an equivalence
private
is-equiv-fold-sq-simplex ∷ {C ∷ U} (sC : is-segalᵣ C) (w : simplex 2 →ᵣ C) {c : C} (r : hom c (w (Simplex2.edge₁₂ 𝕀1))) →
  is-equiv (fold-sq sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w) r)
is-equiv-fold-sq-simplex {C} sC w {c} r =
  let a : C = w (Simplex2.edge₀₁ 𝕀0) in
  let A : U = Σ (g : hom a c) . square (simplex2-hom₀₁ w) r g (simplex2-hom₁₂ w) in
  let B : U = Σ (g : hom a c) . square (Hom.id a) r g (comp-homᵣ sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w)) in
  let f : A → B = fold-sq sC (simplex2-hom₀₁ w) (simplex2-hom₁₂ w) r in
  let u : B → A = unfold-sq sC w r in
  let sec : (y : B) → f (u y) ≡ y = fun (g , τ) →
    squares-g-path (comp-homᵣ-lunit C sC g) _ τ (fold-unfold-sq sC w r g τ) in
  let ret : (x : A) → u (f x) ≡ x = fun (g , σ) →
    squares-g-path (comp-homᵣ-lunit C sC g) _ σ (unfold-fold-sq sC w r g σ) in
  is-iso→is-equiv f (u , sec , ret)

-- folding is an equivalence for every composable pair (t , k): every pair is given by the edges of
-- a 2-simplex, up to a path
private
fold-sq-stmt ∷ {C ∷ U} (sC : is-segalᵣ C) → pairs C → U
fold-sq-stmt {C} sC p =
  (c : C) (r : hom c (fst _ (snd _ (snd _ p)))) →
  is-equiv (fold-sq sC (Product.fst (snd _ (snd _ (snd _ p)))) (Product.snd (snd _ (snd _ (snd _ p)))) r)

is-equiv-fold-sq ∷ {C ∷ U} (sC : is-segalᵣ C) {a b c d : C} (t : hom a b) (k : hom b d) (r : hom c d) → is-equiv (fold-sq sC t k r)
is-equiv-fold-sq {C} sC {a} {b} {c} {d} t k r =
  let s : section (edges-2 {C}) = is-equiv-sec (edges-2 {C}) (is-equiv-edges-2 C sC) in
  let p0 : pairs C = (a , b , d , t , k) in
  let w : simplex 2 →ᵣ C = section-map (edges-2 {C}) s p0 in
  subst (fold-sq-stmt sC) (snd (is-section (edges-2 {C})) s p0) (λ c' r' . is-equiv-fold-sq-simplex sC w r') c r
