--
-- Fibres
--
-- For crisp r : Y → B and b : B, the fibre S := Σ (y : Y) . r y ≡ b comes with the projection
-- fst : S → Y. On homs, r ∘ fst is the transported identity at b (κ, fib-ρ): by crisp path
-- induction on the path from the constant map at b to r ∘ fst, this reduces to the action on
-- homs of a constant map, whose commutation with composition is given by the degenerate
-- 2-simplex (κ0-comp, κ-comp).
--
-- Homs of the fibre are the homs of Y whose image is the transported identity
-- (is-equiv-fib-hom-map). This is the hom types of pullbacks lemma of BATT.tex (lem:hom_pb), for
-- the pullback of b : 1 → B along r, which follows from the oplax universal property of pullbacks
-- (lem:pb_oplax_up); it is postulated here.
--
-- Consequently, every arrow of the fibre is cocartesian for the projection to Y
-- (is-cocartesian-fib, the base change lemma lem:cocart_arrow_base_change for this pullback): the
-- fibre products of the gap map reduce to homs of Y, and the gap map to composition with the image
-- of the arrow in B, a transported identity.
--
-- Postulates introduced: is-equiv-fib-hom-map.
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Composable
open import Simplex-edges
open import Unitality
open import Functoriality
open import Iso
open import Fibration

--
-- Transported identities and maps to a constant
--

-- a transported identity
idt ∷ {B ∷ U} {b ∷ B} {x y : B} (p : b ≡ x) (q : b ≡ y) → hom {B} x y
idt {B} {b} {x} {y} p q = ((λ _ . b) , p , q)

idt-comp ∷ {B ∷ U} (sB : is-segalᵣ B) {b ∷ B} {x : B} (p : b ≡ x) {y : B} (q : b ≡ y) {z : B} (r : b ≡ z) →
  comp-homᵣ B sB {x} {y} {z} (idt {B} {b} {x} {y} p q) (idt {B} {b} {y} {z} q r) ≡ idt {B} {b} {x} {z} p r
idt-comp {B} sB {b} refl refl refl = comp-simplex-2 B sB (λ σ . b)

is-iso-idt ∷ {B ∷ U} (sB : is-segalᵣ B) {b ∷ B} {x : B} (p : b ≡ x) {y : B} (q : b ≡ y) →
  is-iso-hom {B} sB {x} {y} (idt {B} {b} {x} {y} p q)
is-iso-idt {B} sB {b} refl refl = is-iso-id {B} sB b

-- the action on homs of a constant map
κ0-aux ∷ {S B ∷ U} (b ∷ B) (c : arrᵣ S) {w0 : S} (e0 : srcᵣ c ≡ w0) {w1 : S} (e1 : tgtᵣ c ≡ w1) →
  hom-map {S} {B} (λ _ . b) {w0} {w1} (c , e0 , e1) ≡ Hom.id {B} b
κ0-aux {S} {B} b c {w0} e0 {w1} e1 =
  cong2 {b ≡ b} {b ≡ b} {hom {B} b b} (λ p q . ((λ _ . b) , p , q)) (cong-cst b e0) (cong-cst b e1)

κ0 ∷ {S B ∷ U} (b ∷ B) {w0 w1 : S} (g : hom w0 w1) → hom-map {S} {B} (λ _ . b) {w0} {w1} g ≡ Hom.id {B} b
κ0 {S} {B} b {w0} {w1} g =
  trans (cong {hom w0 w1} {hom {B} b b} (hom-map {S} {B} (λ _ . b) {w0} {w1}) (sym (hom-eta {S} {w0} {w1} g)))
    (κ0-aux {S} {B} b (hom-cell {S} {w0} {w1} g) (hom-src {S} {w0} {w1} g) (hom-tgt {S} {w0} {w1} g))

-- the action on homs of a map with a path to a constant map
κ ∷ {S B ∷ U} {b ∷ B} (f ∷ S → B) (G ∷ (λ _ . b) ≡{S → B} f) {w0 w1 : S} (g : hom w0 w1) →
  hom-map {S} {B} f {w0} {w1} g ≡ idt {B} {b} {f w0} {f w1} (happly {S} {λ _ . B} G w0) (happly {S} {λ _ . B} G w1)
κ {S} {B} {b} refl {w0} {w1} g = κ0 {S} {B} b {w0} {w1} g

-- naturality of a family of paths to a fixed point
nat-cst ∷ {H T : U} (P : H → T) {t : T} (k : (h : H) → P h ≡ t) {h h' : H} (α : h ≡ h') → k h ≡ trans (cong P α) (k h')
nat-cst {H} {T} P {t} k {h} refl = sym (trans-refl-l (k h))

trans-sym-refl-r ∷ {T : U} {x y z : T} (a : x ≡ y) (c : z ≡ y) → a ≡ trans (trans a (sym c)) (trans refl c)
trans-sym-refl-r {T} {x} {y} {z} a c =
  J' (λ z' y' c' . (a' : x ≡ y') → a' ≡ trans (trans a' (sym c')) (trans refl c')) (λ y' a' . refl) c a

κ0-comp-stmt ∷ (S B ∷ U) (b ∷ B) (sS : is-segalᵣ S) (sB : is-segalᵣ B) {x y z : S} (u : hom x y) (v : hom y z) → U
κ0-comp-stmt S B b sS sB {x} {y} {z} u v =
  κ0 {S} {B} b {x} {z} (comp-homᵣ S sS {x} {y} {z} u v)
  ≡ trans (hom-map-comp S B (λ _ . b) sS sB {x} {y} {z} u v)
      (trans (cong2 {hom {B} b b} {hom {B} b b} {hom {B} b b} (λ m n . comp-homᵣ B sB {b} {b} {b} m n) (κ0 {S} {B} b {x} {y} u) (κ0 {S} {B} b {y} {z} v))
        (idt-comp {B} sB {b} {b} refl {b} refl {b} refl))

κ0-comp-simplex ∷ (S B ∷ U) (b ∷ B) (sS : is-segalᵣ S) (sB : is-segalᵣ B) (Ψ : simplex 2 →ᵣ S) →
  κ0-comp-stmt S B b sS sB (simplex-2-hom₀₁ {S} Ψ) (simplex-2-hom₁₂ {S} Ψ)
κ0-comp-simplex S B b sS sB Ψ =
  let x0 : S = Ψ (simplex-2-e₀₁ 𝕀0) in
  let x2 : S = Ψ (simplex-2-e₁₂ 𝕀1) in
  let hm : hom x0 x2 → hom {B} b b = hom-map {S} {B} (λ _ . b) {x0} {x2} in
  let C : hom x0 x2 = comp-homᵣ S sS (simplex-2-hom₀₁ {S} Ψ) (simplex-2-hom₁₂ {S} Ψ) in
  let csX : C ≡ simplex-2-hom₀₂ {S} Ψ = comp-simplex-2 S sS Ψ in
  let cs0 : comp-homᵣ B sB {b} {b} {b} (Hom.id {B} b) (Hom.id {B} b) ≡ Hom.id {B} b = comp-simplex-2 B sB (λ σ . b) in
  let E : hom-map-comp S B (λ _ . b) sS sB (simplex-2-hom₀₁ {S} Ψ) (simplex-2-hom₁₂ {S} Ψ) ≡ trans (cong hm csX) (sym cs0) =
    hom-map-comp-edges S B (λ _ . b) sS sB Ψ in
  trans (nat-cst hm (κ0 {S} {B} b {x0} {x2}) csX)
    (trans (trans-sym-refl-r (cong hm csX) cs0)
      (cong {hm C ≡ comp-homᵣ B sB {b} {b} {b} (Hom.id {B} b) (Hom.id {B} b)} {hm C ≡ Hom.id {B} b}
        (λ w . trans w (trans refl cs0)) (sym E)))

κ0-comp ∷ (S B ∷ U) (b ∷ B) (sS : is-segalᵣ S) (sB : is-segalᵣ B) {x y z : S} (u : hom x y) (v : hom y z) →
  κ0-comp-stmt S B b sS sB {x} {y} {z} u v
κ0-comp S B b sS sB {x} {y} {z} u v =
  let s : section (edges-2 {S}) = is-equiv-sec (edges-2 {S}) (is-equiv-edges-2 S sS) in
  let r : pairs S = (x , y , z , u , v) in
  subst (pair-family S (λ x' y' z' u' v' . κ0-comp-stmt S B b sS sB {x'} {y'} {z'} u' v'))
    (snd (is-section (edges-2 {S})) s r)
    (κ0-comp-simplex S B b sS sB (section-map (edges-2 {S}) s r))

-- the coherence for a map with a path to a constant map
κ-comp ∷ {S B ∷ U} (sS : is-segalᵣ S) (sB : is-segalᵣ B) {b ∷ B} (f ∷ S → B) (G ∷ (λ _ . b) ≡{S → B} f)
  {x y z : S} (u : hom x y) (v : hom y z) →
  κ {S} {B} {b} f G {x} {z} (comp-homᵣ S sS {x} {y} {z} u v)
  ≡ trans (hom-map-comp S B f sS sB {x} {y} {z} u v)
      (trans (cong2 {hom (f x) (f y)} {hom (f y) (f z)} {hom (f x) (f z)} (λ m n . comp-homᵣ B sB {f x} {f y} {f z} m n)
               (κ {S} {B} {b} f G {x} {y} u) (κ {S} {B} {b} f G {y} {z} v))
        (idt-comp {B} sB {b} {f x} (happly {S} {λ _ . B} G x) {f y} (happly {S} {λ _ . B} G y) {f z} (happly {S} {λ _ . B} G z)))
κ-comp {S} {B} sS sB {b} refl {x} {y} {z} u v = κ0-comp S B b sS sB {x} {y} {z} u v

--
-- Fibres
--

-- the path from the constant map to r ∘ fst on the fibre of r over b
fib-path ∷ {Y B ∷ U} (r ∷ Y → B) (b ∷ B) → (λ _ . b) ≡{(Σ (y : Y) . r y ≡ b) → B} (λ w . r (fst (λ y . r y ≡ b) w))
fib-path {Y} {B} r b =
  funext-nd {Σ (y : Y) . r y ≡ b} {B} (λ _ . b) (λ w . r (fst (λ y . r y ≡ b) w)) (λ w . sym (snd (λ y . r y ≡ b) w))

-- the transported identity between the images of two points of the fibre
fib-idt ∷ {Y B ∷ U} (r ∷ Y → B) (b ∷ B) (w0 w1 : Σ (y : Y) . r y ≡ b) →
  hom {B} (r (fst (λ y . r y ≡ b) w0)) (r (fst (λ y . r y ≡ b) w1))
fib-idt {Y} {B} r b w0 w1 =
  idt {B} {b} (happly {Σ (y : Y) . r y ≡ b} {λ _ . B} (fib-path {Y} {B} r b) w0) (happly {Σ (y : Y) . r y ≡ b} {λ _ . B} (fib-path {Y} {B} r b) w1)

-- the image of a hom of the fibre is the transported identity
fib-ρ ∷ {Y B ∷ U} (r ∷ Y → B) (b ∷ B) {w0 w1 : Σ (y : Y) . r y ≡ b} (g : hom w0 w1) →
  hom-map {Y} {B} r (hom-map {Σ (y : Y) . r y ≡ b} {Y} (fst (λ y . r y ≡ b)) {w0} {w1} g) ≡ fib-idt {Y} {B} r b w0 w1
fib-ρ {Y} {B} r b {w0} {w1} g =
  trans (sym (hom-map-circ {Σ (y : Y) . r y ≡ b} {Y} {B} (fst (λ y . r y ≡ b)) r {w0} {w1} g))
    (κ {Σ (y : Y) . r y ≡ b} {B} {b} (λ w . r (fst (λ y . r y ≡ b) w)) (fib-path {Y} {B} r b) {w0} {w1} g)

-- homs of the fibre, as homs of Y whose image is the transported identity
fib-hom-map ∷ {Y B ∷ U} (r ∷ Y → B) (b ∷ B) (w0 w1 : Σ (y : Y) . r y ≡ b) →
  hom w0 w1 → Σ (k : hom (fst (λ y . r y ≡ b) w0) (fst (λ y . r y ≡ b) w1)) . hom-map {Y} {B} r k ≡ fib-idt {Y} {B} r b w0 w1
fib-hom-map {Y} {B} r b w0 w1 g =
  (hom-map {Σ (y : Y) . r y ≡ b} {Y} (fst (λ y . r y ≡ b)) {w0} {w1} g , fib-ρ {Y} {B} r b {w0} {w1} g)

-- [lem:hom_pb, for the pullback of b : 1 → B along r] this is an equivalence
postulate is-equiv-fib-hom-map ∷ {Y B ∷ U} (r ∷ Y → B) (b ∷ B) (w0 w1 : Σ (y : Y) . r y ≡ b) →
  is-equiv (fib-hom-map {Y} {B} r b w0 w1)

--
-- Path algebra
--

trans-assoc' ∷ {T : U} {x y z : T} (a : x ≡ y) (b : y ≡ z) {w : T} (c : z ≡ w) → trans (trans a b) c ≡ trans a (trans b c)
trans-assoc' {T} {x} {y} {z} a b refl = refl

subst-eq-l ∷ {M T : U} (P : M → T) {t : T} {m m' : M} (e : m ≡ m') (c : P m ≡ t) →
  subst (λ n . P n ≡ t) e c ≡ trans (cong P (sym e)) c
subst-eq-l {M} {T} P {t} {m} refl c = sym (trans-refl-l c)

cong2-split ∷ {P1 P2 T : U} (F : P1 → P2 → T) {a a' : P1} (p : a ≡ a') {c c' : P2} (q : c ≡ c') →
  cong2 F p q ≡ trans (cong (λ x . F x c) p) (cong (F a') q)
cong2-split {P1} {P2} {T} F {a} refl {c} refl = refl

rho-alg-core ∷ {T : U} {X0 Y0 : T} (c0 : X0 ≡ Y0) {Z0 : T} (h : Y0 ≡ Z0) → trans refl (trans (sym c0) (trans c0 (trans refl h))) ≡ h
rho-alg-core {T} {X0} {Y0} c0 refl = trans (trans-refl-l (trans (sym c0) c0)) (trans-sym-l c0)

rho-alg ∷ {M T P1 P2 : U} (P : M → T) (F : P1 → P2 → T) {X0 : T} {m : M} (c0 : X0 ≡ P m) {m' : M} (e : m ≡ m')
  {a0 a : P1} (d1 : a0 ≡ a) {b0 b : P2} (d2 : b0 ≡ b) (h : P m' ≡ F a b)
  {i1 : P1} (k1 : a0 ≡ i1) {i2 : P2} (k2 : b0 ≡ i2) {t : T} (z : F i1 i2 ≡ t) →
  trans (cong P (sym e)) (trans (sym c0) (trans (trans c0 (trans (cong P e) (trans h (sym (cong2 F d1 d2))))) (trans (cong2 F k1 k2) z)))
  ≡ trans h (trans (cong2 F (trans (sym d1) k1) (trans (sym d2) k2)) z)
rho-alg {M} {T} {P1} {P2} P F {X0} {m} c0 refl {a0} refl {b0} refl h refl refl refl = rho-alg-core c0 h

-- contracting the path in Σ (mc : Σ m . C m) . Σ k . fst mc ≡ φ k
contr2 ∷ {M K : U} (C : M → U) (φ : K → M) → (Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k) → Σ (k : K) . C (φ k)
contr2 {M} {K} C φ (mc , r) =
  let h : (mc : Σ (m : M) . C m) (r : Σ (k : K) . fst C mc ≡ φ k) → Σ (k : K) . C (φ k) =
    fun (m , c) (k , e) → (k , subst C e c) in
  h mc r

uncontr2 ∷ {M K : U} (C : M → U) (φ : K → M) → (Σ (k : K) . C (φ k)) → Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k
uncontr2 {M} {K} C φ (k , c) = ((φ k , c) , (k , refl))

contr2-ret-aux ∷ {M K : U} (C : M → U) (φ : K → M) (k : K) {m : M} (e' : φ k ≡ m) (c : C m) →
  uncontr2 C φ (contr2 C φ ((m , c) , (k , sym e')))
    ≡{Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k} ((m , c) , (k , sym e'))
contr2-ret-aux {M} {K} C φ k refl c = refl

contr2-ret ∷ {M K : U} (C : M → U) (φ : K → M) (w : Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k) →
  uncontr2 C φ (contr2 C φ w) ≡ w
contr2-ret {M} {K} C φ (mc , r) =
  let T : U = Σ (mc : Σ (m : M) . C m) . Σ (k : K) . fst C mc ≡ φ k in
  let h : (mc : Σ (m : M) . C m) (r : Σ (k : K) . fst C mc ≡ φ k) → uncontr2 C φ (contr2 C φ (mc , r)) ≡{T} (mc , r) =
    fun (m , c) (k , e) →
      let P : (m ≡ φ k) → U = λ e'' . uncontr2 C φ (contr2 C φ ((m , c) , (k , e''))) ≡{T} ((m , c) , (k , e'')) in
      subst P (sym-sym e) (contr2-ret-aux C φ k {m} (sym e) c) in
  h mc r

is-equiv-contr2 ∷ {M K : U} (C : M → U) (φ : K → M) → is-equiv (contr2 C φ)
is-equiv-contr2 {M} {K} C φ = ((uncontr2 C φ , fun (k , c) → refl) , (uncontr2 C φ , contr2-ret C φ))

--
-- [lem:cocart_arrow_base_change, for the pullback of b : 1 → B along r] every arrow of the fibre
-- of r over b is cocartesian for the projection to Y
--

is-cocartesian-fib ∷ {Y B ∷ U} (sY : is-segalᵣ Y) (sB : is-segalᵣ B) (r ∷ Y → B) (b ∷ B) (sS : is-segalᵣ (Σ (y : Y) . r y ≡ b))
  {u v : Σ (y : Y) . r y ≡ b} (γ : hom u v) → is-cocartesian {Σ (y : Y) . r y ≡ b} {Y} sS sY (fst (λ y . r y ≡ b)) {u} {v} γ
is-cocartesian-fib {Y} {B} sY sB r b sS {u} {v} γ s =
  let S ∷ U = Σ (y : Y) . r y ≡ b in
  let ι ∷ S → Y = fst (λ y . r y ≡ b) in
  let f ∷ S → B = λ w . r (ι w) in
  let G ∷ (λ _ . b) ≡{S → B} f = fib-path {Y} {B} r b in
  let hG : (w : S) → b ≡ f w = happly {S} {λ _ . B} G in
  let ιγ : hom (ι u) (ι v) = hom-map {S} {Y} ι {u} {v} γ in
  let C : (w0 w1 : S) → hom (ι w0) (ι w1) → U = λ w0 w1 k . hom-map {Y} {B} r {ι w0} {ι w1} k ≡ fib-idt {Y} {B} r b w0 w1 in
  let cY : hom (ι v) (ι s) → hom (ι u) (ι s) = λ k . comp-homᵣ Y sY {ι u} {ι v} {ι s} ιγ k in
  let FB : hom (f u) (f v) → hom (f v) (f s) → hom (f u) (f s) = λ m n . comp-homᵣ B sB {f u} {f v} {f s} m n in
  let Ωus : hom u s → Σ (m : hom (ι u) (ι s)) . C u s m = fib-hom-map {Y} {B} r b u s in
  let Ωvs : hom v s → Σ (k : hom (ι v) (ι s)) . C v s k = fib-hom-map {Y} {B} r b v s in
  let Q : (Σ (m : hom (ι u) (ι s)) . C u s m) → U = λ mc . Σ (k : hom (ι v) (ι s)) . fst (C u s) mc ≡ cY k in
  let Gap : hom v s → cocart-pb {S} {Y} sY ι {u} {v} γ s = cocart-gap {S} {Y} sS sY ι {u} {v} γ s in
  let Θ1 : cocart-pb {S} {Y} sY ι {u} {v} γ s → Σ (mc : Σ (m : hom (ι u) (ι s)) . C u s m) . Q mc = Σ-base Ωus Q in
  let Θ2 : (Σ (mc : Σ (m : hom (ι u) (ι s)) . C u s m) . Q mc) → Σ (k : hom (ι v) (ι s)) . C u s (cY k) = contr2 (C u s) cY in
  let IC : FB (fib-idt {Y} {B} r b u v) (fib-idt {Y} {B} r b v s) ≡ fib-idt {Y} {B} r b u s =
    idt-comp {B} sB {b} {f u} (hG u) {f v} (hG v) {f s} (hG s) in
  let ργ : hom-map {Y} {B} r {ι u} {ι v} ιγ ≡ fib-idt {Y} {B} r b u v = fib-ρ {Y} {B} r b {u} {v} γ in
  -- the map on fibres: compose with the image of γ
  let φ : (k : hom (ι v) (ι s)) → C v s k → C u s (cY k) = λ k c .
    trans (hom-map-comp Y B r sY sB {ι u} {ι v} {ι s} ιγ k) (trans (cong2 FB ργ c) IC) in
  let φ' : (k : hom (ι v) (ι s)) → C v s k → C u s (cY k) = λ k c .
    trans (trans (hom-map-comp Y B r sY sB {ι u} {ι v} {ι s} ιγ k) (cong (λ x . FB x (hom-map {Y} {B} r {ι v} {ι s} k)) ργ))
      (trans (cong (FB (fib-idt {Y} {B} r b u v)) c) IC) in
  let A0 : (k : hom (ι v) (ι s)) → hom-map {Y} {B} r {ι u} {ι s} (cY k) ≡ FB (fib-idt {Y} {B} r b u v) (hom-map {Y} {B} r {ι v} {ι s} k) = λ k .
    trans (hom-map-comp Y B r sY sB {ι u} {ι v} {ι s} ιγ k) (cong (λ x . FB x (hom-map {Y} {B} r {ι v} {ι s} k)) ργ) in
  let eφ' : (k : hom (ι v) (ι s)) → is-equiv (φ' k) = λ k .
    is-equiv-circ {hom-map {Y} {B} r {ι v} {ι s} k ≡ fib-idt {Y} {B} r b v s}
      {FB (fib-idt {Y} {B} r b u v) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ FB (fib-idt {Y} {B} r b u v) (fib-idt {Y} {B} r b v s)}
      {hom-map {Y} {B} r {ι u} {ι s} (cY k) ≡ fib-idt {Y} {B} r b u s}
      (λ p . trans (A0 k) (trans p IC)) (cong (FB (fib-idt {Y} {B} r b u v)) {hom-map {Y} {B} r {ι v} {ι s} k} {fib-idt {Y} {B} r b v s})
      (is-equiv-trans-trans (A0 k) IC)
      (ap-equiv (FB (fib-idt {Y} {B} r b u v))
        (is-equiv-comp-iso-l {B} sB {f u} {f v} (fib-idt {Y} {B} r b u v) (is-iso-idt {B} sB {b} {f u} (hG u) {f v} (hG v)) (f s))
        (hom-map {Y} {B} r {ι v} {ι s} k) (fib-idt {Y} {B} r b v s)) in
  let φφ' : (k : hom (ι v) (ι s)) (c : C v s k) → φ' k c ≡ φ k c = λ k c .
    let H : hom-map {Y} {B} r {ι u} {ι s} (cY k) ≡ FB (hom-map {Y} {B} r {ι u} {ι v} ιγ) (hom-map {Y} {B} r {ι v} {ι s} k) =
      hom-map-comp Y B r sY sB {ι u} {ι v} {ι s} ιγ k in
    let Ap : FB (hom-map {Y} {B} r {ι u} {ι v} ιγ) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ FB (fib-idt {Y} {B} r b u v) (hom-map {Y} {B} r {ι v} {ι s} k) =
      cong (λ x . FB x (hom-map {Y} {B} r {ι v} {ι s} k)) ργ in
    let Bp : FB (fib-idt {Y} {B} r b u v) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ FB (fib-idt {Y} {B} r b u v) (fib-idt {Y} {B} r b v s) =
      cong (FB (fib-idt {Y} {B} r b u v)) c in
    trans (trans-assoc' H Ap (trans Bp IC))
      (cong {FB (hom-map {Y} {B} r {ι u} {ι v} ιγ) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ fib-idt {Y} {B} r b u s}
            {hom-map {Y} {B} r {ι u} {ι s} (cY k) ≡ fib-idt {Y} {B} r b u s}
        (λ z . trans H z)
        (trans (sym (trans-assoc' Ap Bp IC))
          (cong {FB (hom-map {Y} {B} r {ι u} {ι v} ιγ) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ FB (fib-idt {Y} {B} r b u v) (fib-idt {Y} {B} r b v s)}
                {FB (hom-map {Y} {B} r {ι u} {ι v} ιγ) (hom-map {Y} {B} r {ι v} {ι s} k) ≡ fib-idt {Y} {B} r b u s}
            (λ z . trans z IC) (sym (cong2-split FB ργ c))))) in
  let eφ : (k : hom (ι v) (ι s)) → is-equiv (φ k) = λ k .
    is-equiv-htpy {C v s k} {C u s (cY k)} {φ' k} {φ k} (φφ' k) (eφ' k) in
  -- the gap map, up to these equivalences, is the map on fibres
  let ρcomp : (g : hom v s) →
      subst (C u s) (hom-map-comp S Y ι sS sY {u} {v} {s} γ g) (fib-ρ {Y} {B} r b {u} {s} (comp-homᵣ S sS {u} {v} {s} γ g))
      ≡ φ (hom-map {S} {Y} ι {v} {s} g) (fib-ρ {Y} {B} r b {v} {s} g) = λ g .
    let Cg : hom u s = comp-homᵣ S sS {u} {v} {s} γ g in
    let ιg : hom (ι v) (ι s) = hom-map {S} {Y} ι {v} {s} g in
    let hr : hom (ι u) (ι s) → hom (f u) (f s) = hom-map {Y} {B} r {ι u} {ι s} in
    let e : hom-map {S} {Y} ι {u} {s} Cg ≡ cY ιg = hom-map-comp S Y ι sS sY {u} {v} {s} γ g in
    let circC : hom-map {S} {B} f {u} {s} Cg ≡ hr (hom-map {S} {Y} ι {u} {s} Cg) = hom-map-circ {S} {Y} {B} ι r {u} {s} Cg in
    let κγ : hom-map {S} {B} f {u} {v} γ ≡ fib-idt {Y} {B} r b u v = κ {S} {B} {b} f G {u} {v} γ in
    let κg : hom-map {S} {B} f {v} {s} g ≡ fib-idt {Y} {B} r b v s = κ {S} {B} {b} f G {v} {s} g in
    let K2 : FB (hom-map {S} {B} f {u} {v} γ) (hom-map {S} {B} f {v} {s} g) ≡ fib-idt {Y} {B} r b u s = trans (cong2 FB κγ κg) IC in
    trans (subst-eq-l hr e (fib-ρ {Y} {B} r b {u} {s} Cg))
      (trans (cong {hom-map {S} {B} f {u} {s} Cg ≡ fib-idt {Y} {B} r b u s} {hr (cY ιg) ≡ fib-idt {Y} {B} r b u s}
                  (λ z . trans (cong hr (sym e)) (trans (sym circC) z))
                  (trans (κ-comp {S} {B} sS sB {b} f G {u} {v} {s} γ g)
                    (cong {hom-map {S} {B} f {u} {s} Cg ≡ FB (hom-map {S} {B} f {u} {v} γ) (hom-map {S} {B} f {v} {s} g)}
                          {hom-map {S} {B} f {u} {s} Cg ≡ fib-idt {Y} {B} r b u s}
                      (λ z . trans z K2) (hom-map-comp-circ S Y B ι r sS sY sB {u} {v} {s} γ g))))
          (rho-alg {hom (ι u) (ι s)} {hom (f u) (f s)} {hom (f u) (f v)} {hom (f v) (f s)} hr FB
            {hom-map {S} {B} f {u} {s} Cg} {hom-map {S} {Y} ι {u} {s} Cg} circC {cY ιg} e
            {hom-map {S} {B} f {u} {v} γ} {hom-map {Y} {B} r {ι u} {ι v} ιγ} (hom-map-circ {S} {Y} {B} ι r {u} {v} γ)
            {hom-map {S} {B} f {v} {s} g} {hom-map {Y} {B} r {ι v} {ι s} ιg} (hom-map-circ {S} {Y} {B} ι r {v} {s} g)
            (hom-map-comp Y B r sY sB {ι u} {ι v} {ι s} ιγ ιg)
            {fib-idt {Y} {B} r b u v} κγ {fib-idt {Y} {B} r b v s} κg {fib-idt {Y} {B} r b u s} IC)) in
  let Θ : cocart-pb {S} {Y} sY ι {u} {v} γ s → Σ (k : hom (ι v) (ι s)) . C u s (cY k) = λ w . Θ2 (Θ1 w) in
  let eΘ : is-equiv Θ = is-equiv-circ Θ2 Θ1 (is-equiv-contr2 (C u s) cY) (is-equiv-Σ-base Ωus (is-equiv-fib-hom-map {Y} {B} r b u s) Q) in
  let T : hom v s → Σ (k : hom (ι v) (ι s)) . C u s (cY k) =
    λ g . tot {hom (ι v) (ι s)} {C v s} {λ k . C u s (cY k)} φ (Ωvs g) in
  let eT : is-equiv T =
    is-equiv-circ (tot {hom (ι v) (ι s)} {C v s} {λ k . C u s (cY k)} φ) Ωvs
      (is-equiv-tot {hom (ι v) (ι s)} {C v s} {λ k . C u s (cY k)} φ eφ) (is-equiv-fib-hom-map {Y} {B} r b v s) in
  is-equiv-cancel-l Θ Gap eΘ
    (is-equiv-htpy {hom v s} {Σ (k : hom (ι v) (ι s)) . C u s (cY k)} {T} {λ g . Θ (Gap g)}
      (λ g . cong {C u s (cY (hom-map {S} {Y} ι {v} {s} g))} {Σ (k : hom (ι v) (ι s)) . C u s (cY k)}
               (λ c . (hom-map {S} {Y} ι {v} {s} g , c)) (sym (ρcomp g)))
      eT)
