open import Stdlib
open import Interval
open import Bipointed

-- hom type of a crisp bipointed type (both endpoints crisp)
hom' ∷ (X' ∷ Ubipt) → U
hom' X' = oplaxbipt 𝕀' X'

-- hom type between arbitrary (possibly non-crisp) endpoints of a crisp type: only X has to be
-- crisp, for 𝕀 →ᵣ X to be formed
hom ∷ (X ∷ U) (x0 x1 : X) → U
hom X x0 x1 = Σ (f : 𝕀 →ᵣ X) . (f 𝕀0 ≡ x0) × (f 𝕀1 ≡ x1)

-- the underlying 1-cell and its boundary
hom-cell ∷ {X ∷ U} {x0 x1 : X} → hom X x0 x1 → (𝕀 →ᵣ X)
hom-cell (f , _) = f

hom-src ∷ {X ∷ U} {x0 x1 : X} (u : hom X x0 x1) → hom-cell {X} {x0} {x1} u 𝕀0 ≡ x0
hom-src {X} {x0} {x1} (f , p) = prod-fst {f 𝕀0 ≡ x0} {f 𝕀1 ≡ x1} p

hom-tgt ∷ {X ∷ U} {x0 x1 : X} (u : hom X x0 x1) → hom-cell {X} {x0} {x1} u 𝕀1 ≡ x1
hom-tgt {X} {x0} {x1} (f , p) = prod-snd {f 𝕀0 ≡ x0} {f 𝕀1 ≡ x1} p

-- for crisp endpoints, hom is the hom of the bipointed type (X, x0, x1), judgmentally
hom-crisp ∷ (X ∷ U) (x0 x1 ∷ X) → hom X x0 x1 ≡ hom' (X , (x0 , x1))
hom-crisp X x0 x1 = refl

-- the identity 1-cell on a point: the constant oplax map
id-hom ∷ {X ∷ U} (x : X) → hom X x x
id-hom {X} x = ((λ t . x) , refl , refl)
