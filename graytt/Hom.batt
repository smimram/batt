open import Stdlib
open import Bipointed

-- hom type of a crisp bipointed type (both endpoints crisp)
hom' ∷ (X' ∷ U⁎⁎) → U
hom' X' = oplax⁎⁎ 𝕀⁎⁎ X'

-- hom type between arbitrary (possibly non-crisp) endpoints of a crisp type: only X has to be
-- crisp, for 𝕀 →ᵣ X to be formed
hom ∷ {X ∷ U} (x0 x1 : X) → U
hom x0 x1 = Σ (f : arrᵣ X) . (srcᵣ f ≡ x0) × (tgtᵣ f ≡ x1)

-- the boundary conditions of a hom (hom x0 x1 = Σ (f : arrᵣ X) . hom-boundary x0 x1 f)
hom-boundary ∷ {X ∷ U} (x0 x1 : X) → arrᵣ X → U
hom-boundary {X} x0 x1 f = (srcᵣ f ≡ x0) × (tgtᵣ f ≡ x1)

-- the underlying 1-cell and its boundary
hom-cell ∷ {X ∷ U} {x0 x1 : X} → hom x0 x1 → (arrᵣ X)
hom-cell (f , _) = f

hom-src ∷ {X ∷ U} {x0 x1 : X} (u : hom x0 x1) → srcᵣ (hom-cell u) ≡ x0
hom-src (f , p) = Product.fst p

hom-tgt ∷ {X ∷ U} {x0 x1 : X} (u : hom x0 x1) → tgtᵣ (hom-cell u) ≡ x1
hom-tgt (f , p) = Product.snd p

-- η for homs
hom-eta-aux ∷ {X ∷ U} {x0 x1 : X} (t : arrᵣ X) (p : (srcᵣ t ≡ x0) × (tgtᵣ t ≡ x1)) →
  (t , Product.fst {srcᵣ t ≡ x0} {tgtᵣ t ≡ x1} p , Product.snd {srcᵣ t ≡ x0} {tgtᵣ t ≡ x1} p) ≡{hom x0 x1} (t , p)
hom-eta-aux {X} {x0} {x1} t (e0 , e1) = refl
hom-eta ∷ {X ∷ U} {x0 x1 : X} (f : hom x0 x1) → (hom-cell {X} {x0} {x1} f , hom-src {X} {x0} {x1} f , hom-tgt {X} {x0} {x1} f) ≡{hom x0 x1} f
hom-eta {X} {x0} {x1} (t , p) = hom-eta-aux {X} {x0} {x1} t p

-- for crisp endpoints, hom is the hom of the bipointed type (X, x0, x1), judgmentally
hom-crisp ∷ {X ∷ U} (x0 x1 ∷ X) → hom x0 x1 ≡ hom' (X , (x0 , x1))
hom-crisp x0 x1 = refl

-- the identity 1-cell on a point: the constant oplax map
id ∷ {X ∷ U} (x : X) → hom x x
id x = ((λ t . x) , refl , refl)

--
-- Homs with free endpoints
--

Homs = record
  -- homs with fixed endpoints
  hom ∷ {X ∷ U} (x0 x1 : X) → U
  hom = hom

  -- homs with free endpoints
  total ∷ (X ∷ U) → U
  total X = Σ (x : X) . Σ (y : X) . hom x y

  src ∷ {X ∷ U} → total X → X
  src {X} w = fst {X} (λ x . Σ (y : X) . hom x y) w

  tgt ∷ {X ∷ U} → total X → X
  tgt {X} w = fst {X} (λ y . hom (src {X} w) y) (snd {X} (λ x . Σ (y : X) . hom x y) w)

  to-hom ∷ {X ∷ U} (w : total X) → hom (src {X} w) (tgt {X} w)
  to-hom {X} w = snd {X} (λ y . hom (src {X} w) y) (snd {X} (λ x . Σ (y : X) . hom x y) w)

  eta ∷ {X ∷ U} (w : total X) → (src {X} w , tgt {X} w , to-hom {X} w) ≡{total X} w
  eta {X} (x , r) =
    let k : (r : Σ (y : X) . hom x y) → (x , fst {X} (λ y . hom x y) r , snd {X} (λ y . hom x y) r) ≡{total X} (x , r) = fun (y , f) → refl in
    k r

  -- homs with free endpoints are arrows
  to-arr ∷ {X ∷ U} → total X → arrᵣ X
  to-arr {X} w = hom-cell {X} {src {X} w} {tgt {X} w} (to-hom {X} w)

  of-arr ∷ {X ∷ U} → arrᵣ X → total X
  of-arr {X} f = (f 𝕀0 , f 𝕀1 , (f , refl , refl))

  of-arr-retr ∷ {X ∷ U} (w : total X) → of-arr {X} (to-arr {X} w) ≡ w
  of-arr-retr {X} (x , r) =
    let h : (r : Σ (y : X) . hom x y) → of-arr {X} (to-arr {X} (x , r)) ≡{total X} (x , r) = fun (y , g) →
      let h2 : (g : hom x y) → of-arr {X} (to-arr {X} (x , y , g)) ≡{total X} (x , y , g) = fun (f , es) →
        let h3 : (es : (srcᵣ f ≡ x) × (tgtᵣ f ≡ y)) → of-arr {X} (to-arr {X} (x , y , f , es)) ≡{total X} (x , y , f , es) =
          fun (e0 , e1) →
            J (srcᵣ f) (λ x' e0' . of-arr {X} f ≡{total X} (x' , y , f , e0' , e1))
              (J (tgtᵣ f) (λ y' e1' . of-arr {X} f ≡{total X} (srcᵣ f , y' , f , refl , e1')) refl e1) e0 in
        h3 es in
      h2 g in
    h r

  is-equiv-to-arr ∷ {X ∷ U} → is-equiv (to-arr {X})
  is-equiv-to-arr {X} = ((of-arr {X} , λ f . refl) , (of-arr {X} , of-arr-retr {X}))
end

--
-- Moving the target of a hom along its target path
--

-- transport of a hom with refl target path along a path of its target
subst-hom-tgt ∷ {X ∷ U} {a : X} (f : arrᵣ X) (p : srcᵣ f ≡ a) {x : X} (q : tgtᵣ f ≡ x) →
  subst (λ y . hom {X} a y) q (f , p , refl) ≡ (f , p , q)
subst-hom-tgt {X} {a} f p refl = refl

-- the same, as a path of homs out of a with free target
homs-from-tgt-path ∷ {X ∷ U} {a : X} (f : arrᵣ X) (p : srcᵣ f ≡ a) {x : X} (q : tgtᵣ f ≡ x) →
  (tgtᵣ f , f , p , refl) ≡{Σ (y : X) . hom {X} a y} (x , f , p , q)
homs-from-tgt-path {X} {a} f p refl = refl

--
-- Squares
--

Square = record
  open Square

  -- the oplax squares with given left, right, bottom and top sides
  withinᵣ : {A ∷ U} (l r b t : arrᵣ A) → subtype (squareᵣ A)
  withinᵣ l r b t x = prop-trunc ((leftᵣ x ≡ l) × (rightᵣ x ≡ r) × (bottomᵣ x ≡ b) × (topᵣ x ≡ t))
end
