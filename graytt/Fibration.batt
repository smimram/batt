--
-- (Co)cartesian arrows
--
-- Following Gepner–Heine, for a map p ∷ X → A between oplax-Segal types, an arrow f : x → y of
-- X is p-cartesian when, for every x' : X, the gap map
--
--   hom X x' x → hom X x' y ×_{hom A (p x') (p y)} hom A (p x') (p x)
--   g ↦ (f ∘ g , p g , functoriality of p on (g , f))
--
-- is an equivalence, i.e. the square
--
--   hom X x' x ──f∘─→ hom X x' y
--       │p               │p
--       ↓                ↓
--   hom A (p x') (p x) ──(p f)∘─→ hom A (p x') (p y)
--
-- is a pullback. Dually, f is p-cocartesian when, for every y' : X, the gap map
--
--   hom X y y' → hom X x y' ×_{hom A (p x) (p y')} hom A (p y) (p y')
--   g ↦ (g ∘ f , p g , functoriality of p on (f , g))
--
-- is an equivalence. Composition is written diagrammatically: f ∘ g is comp-hom-r X s g f, and the
-- third components come from the functoriality of p on homs (Functoriality.batt).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Functoriality
open import Iso

--
-- Cartesian arrows
--

-- the fibre product hom X x' y ×_{hom A (p x') (p y)} hom A (p x') (p x), over p and (p f) ∘ -
cart-pb ∷ {X A ∷ U} (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) (x' : X) → U
cart-pb {X} {A} sA p {x} {y} f x' =
  Σ (h : hom X x' y) . Σ (k : hom A (p x') (p x)) .
    hom-map {X} {A} p {x'} {y} h ≡ comp-hom-r A sA {p x'} {p x} {p y} k (hom-map {X} {A} p {x} {y} f)

-- the gap map g ↦ (f ∘ g , p g , functoriality of p on (g , f))
cart-gap ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) (x' : X) →
  hom X x' x → cart-pb {X} {A} sA p {x} {y} f x'
cart-gap {X} {A} sX sA p {x} {y} f x' g =
  (comp-hom-r X sX {x'} {x} {y} g f , hom-map {X} {A} p {x'} {x} g , hom-map-comp X A p sX sA {x'} {x} {y} g f)

-- f is p-cartesian when its gap maps are equivalences
is-cartesian ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} → hom X x y → U
is-cartesian {X} {A} sX sA p {x} {y} f = (x' : X) → is-equiv (cart-gap {X} {A} sX sA p {x} {y} f x')

--
-- Cocartesian arrows
--

-- the fibre product hom X x y' ×_{hom A (p x) (p y')} hom A (p y) (p y'), over p and - ∘ (p f)
cocart-pb ∷ {X A ∷ U} (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) (y' : X) → U
cocart-pb {X} {A} sA p {x} {y} f y' =
  Σ (h : hom X x y') . Σ (k : hom A (p y) (p y')) .
    hom-map {X} {A} p {x} {y'} h ≡ comp-hom-r A sA {p x} {p y} {p y'} (hom-map {X} {A} p {x} {y} f) k

-- the gap map g ↦ (g ∘ f , p g , functoriality of p on (f , g))
cocart-gap ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) (y' : X) →
  hom X y y' → cocart-pb {X} {A} sA p {x} {y} f y'
cocart-gap {X} {A} sX sA p {x} {y} f y' g =
  (comp-hom-r X sX {x} {y} {y'} f g , hom-map {X} {A} p {y} {y'} g , hom-map-comp X A p sX sA {x} {y} {y'} f g)

-- f is p-cocartesian when its gap maps are equivalences
is-cocartesian ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} → hom X x y → U
is-cocartesian {X} {A} sX sA p {x} {y} f = (y' : X) → is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y')

-- being cocartesian is a proposition
abstract is-prop-is-cocartesian ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) →
  is-prop (is-cocartesian {X} {A} sX sA p {x} {y} f)
is-prop-is-cocartesian {X} {A} sX sA p {x} {y} f =
  is-prop-Π (λ y' . is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y'))
    (λ y' . is-prop-is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y'))

--
-- Cartesian fibrations
--
-- p is a cartesian fibration when every arrow of A admits a unique cartesian lift with a given
-- target, i.e. when the map
--
--   (ev₁ , p ∘ -) : Σ (f : 𝕀 →ᵣ X) . is-cartesian p f → X ×_A (𝕀 →ᵣ A)
--
-- is an equivalence (the pullback is over p and ev₁).
--

-- a 1-cell, as a hom between its endpoints
cell-hom ∷ {X ∷ U} (f : 𝕀 →ᵣ X) → hom X (f 𝕀0) (f 𝕀1)
cell-hom {X} f = (f , refl , refl)

-- cartesian 1-cells
cart-cell ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → U
cart-cell {X} {A} sX sA p = Σ (f : arrᵣ X) . is-cartesian {X} {A} sX sA p {f 𝕀0} {f 𝕀1} (cell-hom {X} f)

-- the target of a cartesian 1-cell together with its image
cart-cell-lift ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) →
  cart-cell {X} {A} sX sA p → pullback {X} {𝕀 →ᵣ A} {A} p (λ u . u 𝕀1)
cart-cell-lift {X} {A} sX sA p (f , c) = (f 𝕀1 , post-r {𝕀} {X} {A} p f , refl)

is-cartesian-fibration ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → U
is-cartesian-fibration {X} {A} sX sA p = is-equiv (cart-cell-lift {X} {A} sX sA p)

--
-- Cocartesian fibrations
--
-- Dually, p is a cocartesian fibration when every arrow of A admits a unique cocartesian lift
-- with a given source, i.e. when the map
--
--   (ev₀ , p ∘ -) : Σ (f : 𝕀 →ᵣ X) . is-cocartesian p f → X ×_A (𝕀 →ᵣ A)
--
-- is an equivalence (the pullback is over p and ev₀).
--

-- cocartesian 1-cells
cocart-cell ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → U
cocart-cell {X} {A} sX sA p = Σ (f : arrᵣ X) . is-cocartesian {X} {A} sX sA p {srcᵣ f} {tgtᵣ f} (cell-hom {X} f)

-- the source of a cocartesian 1-cell together with its image
cocart-cell-lift ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) →
  cocart-cell {X} {A} sX sA p → pullback {X} {arrᵣ A} {A} p (λ u . srcᵣ u)
cocart-cell-lift {X} {A} sX sA p (f , c) = (f 𝕀0 , post-r {𝕀} {X} {A} p f , refl)

abstract is-cocartesian-fibration ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → U
is-cocartesian-fibration {X} {A} sX sA p = is-equiv (cocart-cell-lift {X} {A} sX sA p)

--
-- Isomorphisms are (co)cartesian
--
-- For an isomorphism f, the first projection of the fibre product is an equivalence: its fibres
-- are fibres of composition with the isomorphism p f, which are contractible. Its composite with
-- the gap map is composition with f, which is an equivalence, hence so is the gap map.
--

-- the type of preimages, with the path in the other direction, is contractible
abstract is-contr-fib-sym ∷ {A B : U} (f : A → B) → is-equiv f → (y : B) → is-contr (Σ (a : A) . y ≡ f a)
is-contr-fib-sym {A} {B} f e y =
  let s : (Σ (a : A) . y ≡ f a) → fib f y = fun (a , q) → (a , sym q) in
  let r : fib f y → Σ (a : A) . y ≡ f a = fun (a , q) → (a , sym q) in
  let rs : (w : Σ (a : A) . y ≡ f a) → r (s w) ≡ w = fun (a , q) →
    cong {y ≡ f a} {Σ (a' : A) . y ≡ f a'} (λ q' . (a , q')) (sym-sym q) in
  is-contr-retract s (r , rs) (is-contr-fib f e y)

abstract is-cocartesian-iso ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) →
  is-iso-hom {X} sX {x} {y} f → is-cocartesian {X} {A} sX sA p {x} {y} f
is-cocartesian-iso {X} {A} sX sA p {x} {y} f i y' =
  let pf : hom A (p x) (p y) = hom-map {X} {A} p {x} {y} f in
  let P : hom X x y' → U = λ h . Σ (k : hom A (p y) (p y')) . hom-map {X} {A} p {x} {y'} h ≡ comp-hom-r A sA {p x} {p y} {p y'} pf k in
  let π : cocart-pb {X} {A} sA p {x} {y} f y' → hom X x y' = fst P in
  let eπ : is-equiv π =
    is-equiv-fst-contr P (λ h . is-contr-fib-sym (λ k . comp-hom-r A sA {p x} {p y} {p y'} pf k)
      (is-equiv-comp-iso-l {A} sA {p x} {p y} pf (is-iso-hom-map {X} {A} sX sA p {x} {y} f i) (p y'))
      (hom-map {X} {A} p {x} {y'} h)) in
  is-equiv-cancel-l π (cocart-gap {X} {A} sX sA p {x} {y} f y') eπ (is-equiv-comp-iso-l {X} sX {x} {y} f i y')

abstract is-cartesian-iso ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y : X} (f : hom X x y) →
  is-iso-hom {X} sX {x} {y} f → is-cartesian {X} {A} sX sA p {x} {y} f
is-cartesian-iso {X} {A} sX sA p {x} {y} f i x' =
  let pf : hom A (p x) (p y) = hom-map {X} {A} p {x} {y} f in
  let P : hom X x' y → U = λ h . Σ (k : hom A (p x') (p x)) . hom-map {X} {A} p {x'} {y} h ≡ comp-hom-r A sA {p x'} {p x} {p y} k pf in
  let π : cart-pb {X} {A} sA p {x} {y} f x' → hom X x' y = fst P in
  let eπ : is-equiv π =
    is-equiv-fst-contr P (λ h . is-contr-fib-sym (λ k . comp-hom-r A sA {p x'} {p x} {p y} k pf)
      (is-equiv-comp-iso-r {A} sA {p x} {p y} pf (is-iso-hom-map {X} {A} sX sA p {x} {y} f i) (p x'))
      (hom-map {X} {A} p {x'} {y} h)) in
  is-equiv-cancel-l π (cart-gap {X} {A} sX sA p {x} {y} f x') eπ (is-equiv-comp-iso-r {X} sX {x} {y} f i x')

--
-- Cancellation of cocartesian arrows
--
-- For f : x → y cocartesian and g : y → z, comp f g is cocartesian iff g is. The fibre product
-- of g, base changed along the gap map of f, pastes with the fibre product of f into the fibre
-- product of comp f g (pb-paste), and this comparison map Φ is an equivalence. Its composite
-- with the gap map of g is the gap map of comp f g, up to associativity: on the third
-- components, this needs the functoriality of p on homs to be coherent with associativity
-- (hom-map-assoc-coh), which is taken as a hypothesis.
--

-- paths in a fibre product with fixed second component
pb-path ∷ {H B C : U} (F : H → C) (G : B → C) {h1 h2 : H} (α : h1 ≡ h2) (k : B) (e1 : F h1 ≡ G k) (e2 : F h2 ≡ G k) →
  e1 ≡ trans (cong F α) e2 → (h1 , k , e1) ≡{Σ (h : H) . Σ (k' : B) . F h ≡ G k'} (h2 , k , e2)
pb-path {H} {B} {C} F G {h1} refl k e1 e2 E = cong {F h1 ≡ G k} {Σ (h : H) . Σ (k' : B) . F h ≡ G k'} (λ e . (h1 , k , e)) (trans E (trans-refl-l e2))

--
-- Pasting fibre products: for a : H → C, b : L → C, c : K → L and d : K → C with b ∘ c = d,
--   (H ×_C L) ×_L K ≃ H ×_C K
--

pb-Q ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) → (Σ (h : H) . Σ (l : L) . a h ≡ b l) → U
pb-Q {H} {L} {K} {C} a b c (h , r) = Σ (k : K) . fst (λ l . a h ≡ b l) r ≡ c k

pb-paste-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (l : L) (e1 : a h ≡ b l) →
  (Σ (k : K) . l ≡ c k) → Σ (h' : H) . Σ (k : K) . a h' ≡ d k
pb-paste-r {H} {L} {K} {C} a b c d R h l e1 (k , e2) = (h , k , trans e1 (trans (cong b e2) (R k)))

pb-paste-h ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (r : Σ (l : L) . a h ≡ b l) →
  pb-Q a b c (h , r) → Σ (h' : H) . Σ (k : K) . a h' ≡ d k
pb-paste-h {H} {L} {K} {C} a b c d R h (l , e1) = pb-paste-r a b c d R h l e1

pb-paste-t ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) →
  pb-Q a b c t → Σ (h' : H) . Σ (k : K) . a h' ≡ d k
pb-paste-t {H} {L} {K} {C} a b c d R (h , r) = pb-paste-h a b c d R h r

pb-paste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  (Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t) → Σ (h' : H) . Σ (k : K) . a h' ≡ d k
pb-paste {H} {L} {K} {C} a b c d R (t , q) = pb-paste-t a b c d R t q

pb-unpaste-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) →
  (Σ (k : K) . a h ≡ d k) → Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t
pb-unpaste-r {H} {L} {K} {C} a b c d R h (k , e) = ((h , c k , trans e (sym (R k))) , (k , refl))

pb-unpaste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  (Σ (h' : H) . Σ (k : K) . a h' ≡ d k) → Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t
pb-unpaste {H} {L} {K} {C} a b c d R (h , r) = pb-unpaste-r a b c d R h r

trans-sym-trans-r ∷ {T : U} {x y z : T} (r : y ≡ z) (e : x ≡ z) → trans (trans e (sym r)) (trans refl r) ≡ e
trans-sym-trans-r {T} {x} {y} refl e = refl

trans-trans-sym ∷ {T : U} {x y : T} (e : x ≡ y) {z : T} (r : y ≡ z) → trans (trans e (trans refl r)) (sym r) ≡ e
trans-trans-sym {T} {x} {y} e refl = refl

pb-paste-sec-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (w : Σ (k : K) . a h ≡ d k) →
  pb-paste a b c d R (pb-unpaste-r a b c d R h w) ≡ (h , w)
pb-paste-sec-r {H} {L} {K} {C} a b c d R h (k , e) =
  cong {a h ≡ d k} {Σ (h' : H) . Σ (k' : K) . a h' ≡ d k'} (λ e' . (h , k , e')) (trans-sym-trans-r (R k) e)

pb-paste-sec ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (w : Σ (h' : H) . Σ (k : K) . a h' ≡ d k) →
  pb-paste a b c d R (pb-unpaste a b c d R w) ≡ w
pb-paste-sec {H} {L} {K} {C} a b c d R (h , w) = pb-paste-sec-r a b c d R h w

-- the second round trip, by induction on the path l ≡ c k
pb-paste-ret-aux ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (k : K) {l : L} (e2 : c k ≡ l) (e1 : a h ≡ b l) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , (k , sym e2))) ≡{Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t} ((h , l , e1) , (k , sym e2))
pb-paste-ret-aux {H} {L} {K} {C} a b c d R h k refl e1 =
  cong {a h ≡ b (c k)} {Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t} (λ e . ((h , c k , e) , (k , refl))) (trans-trans-sym e1 (R k))

pb-paste-ret-r ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (l : L) (e1 : a h ≡ b l)
  (q : Σ (k : K) . l ≡ c k) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , q)) ≡{Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t} ((h , l , e1) , q)
pb-paste-ret-r {H} {L} {K} {C} a b c d R h l e1 (k , e2) =
  let T : U = Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t in
  trans (cong {l ≡ c k} {T} (λ e . pb-unpaste a b c d R (pb-paste a b c d R ((h , l , e1) , (k , e)))) (sym (sym-sym e2)))
    (trans (pb-paste-ret-aux a b c d R h k (sym e2) e1)
      (cong {l ≡ c k} {T} (λ e . ((h , l , e1) , (k , e))) (sym-sym e2)))

pb-paste-ret-h ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (h : H) (r : Σ (l : L) . a h ≡ b l)
  (q : pb-Q a b c (h , r)) →
  pb-unpaste a b c d R (pb-paste a b c d R ((h , r) , q)) ≡{Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t} ((h , r) , q)
pb-paste-ret-h {H} {L} {K} {C} a b c d R h (l , e1) = pb-paste-ret-r a b c d R h l e1

pb-paste-ret-t ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) (t : Σ (h : H) . Σ (l : L) . a h ≡ b l)
  (q : pb-Q a b c t) →
  pb-unpaste a b c d R (pb-paste a b c d R (t , q)) ≡{Σ (t : Σ (h : H) . Σ (l : L) . a h ≡ b l) . pb-Q a b c t} (t , q)
pb-paste-ret-t {H} {L} {K} {C} a b c d R (h , r) = pb-paste-ret-h a b c d R h r

abstract is-equiv-pb-paste ∷ {H L K C : U} (a : H → C) (b : L → C) (c : K → L) (d : K → C) (R : (k : K) → b (c k) ≡ d k) →
  is-equiv (pb-paste a b c d R)
is-equiv-pb-paste {H} {L} {K} {C} a b c d R =
  ((pb-unpaste a b c d R , pb-paste-sec a b c d R) ,
   (pb-unpaste a b c d R , fun (t , q) → pb-paste-ret-t a b c d R t q))

-- the functoriality of p on homs is coherent with associativity
hom-map-assoc-coh ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → U
hom-map-assoc-coh {X} {A} sX sA p =
  {x y z t : X} (u : hom X x y) (v : hom X y z) (w : hom X z t) →
  trans (cong (hom-map {X} {A} p {x} {t}) (comp-hom-r-assoc X sX {x} {y} {z} {t} u v w))
    (trans (hom-map-comp X A p sX sA {x} {y} {t} u (comp-hom-r X sX {y} {z} {t} v w))
      (cong (λ m . comp-hom-r A sA {p x} {p y} {p t} (hom-map {X} {A} p {x} {y} u) m) (hom-map-comp X A p sX sA {y} {z} {t} v w)))
  ≡ trans (hom-map-comp X A p sX sA {x} {z} {t} (comp-hom-r X sX {x} {y} {z} u v) w)
      (trans (cong (λ m . comp-hom-r A sA {p x} {p z} {p t} m (hom-map {X} {A} p {z} {t} w)) (hom-map-comp X A p sX sA {x} {y} {z} u v))
        (comp-hom-r-assoc A sA {p x} {p y} {p z} {p t}
          (hom-map {X} {A} p {x} {y} u) (hom-map {X} {A} p {y} {z} v) (hom-map {X} {A} p {z} {t} w)))

-- the comparison map between the fibre products of g and of comp f g
cancel-R ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y z : X} (f : hom X x y) (g : hom X y z) (z' : X)
  (k : hom A (p z) (p z')) →
  comp-hom-r A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) (comp-hom-r A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k)
    ≡ comp-hom-r A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-hom-r X sX {x} {y} {z} f g)) k
cancel-R {X} {A} sX sA p {x} {y} {z} f g z' k =
  trans (sym (comp-hom-r-assoc A sA {p x} {p y} {p z} {p z'} (hom-map {X} {A} p {x} {y} f) (hom-map {X} {A} p {y} {z} g) k))
    (sym (cong (λ m . comp-hom-r A sA {p x} {p z} {p z'} m k) (hom-map-comp X A p sX sA {x} {y} {z} f g)))

cancel-Φ ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y z : X} (f : hom X x y) (g : hom X y z) (z' : X) →
  cocart-pb {X} {A} sA p {y} {z} g z' → cocart-pb {X} {A} sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z'
cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z' v =
  let a : hom X x z' → hom A (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let b : hom A (p y) (p z') → hom A (p x) (p z') = λ l . comp-hom-r A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) l in
  let c : hom A (p z) (p z') → hom A (p y) (p z') = λ k . comp-hom-r A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k in
  let d : hom A (p z) (p z') → hom A (p x) (p z') =
    λ k . comp-hom-r A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-hom-r X sX {x} {y} {z} f g)) k in
  pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z')
    (Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (pb-Q a b c) v)

abstract is-equiv-cancel-Φ ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) {x y z : X} (f : hom X x y) (g : hom X y z) →
  is-cocartesian {X} {A} sX sA p {x} {y} f → (z' : X) → is-equiv (cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z')
is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z' =
  let a : hom X x z' → hom A (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let b : hom A (p y) (p z') → hom A (p x) (p z') = λ l . comp-hom-r A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) l in
  let c : hom A (p z) (p z') → hom A (p y) (p z') = λ k . comp-hom-r A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k in
  let d : hom A (p z) (p z') → hom A (p x) (p z') =
    λ k . comp-hom-r A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-hom-r X sX {x} {y} {z} f g)) k in
  is-equiv-circ (pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z'))
    (Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (pb-Q a b c))
    (is-equiv-pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z'))
    (is-equiv-Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (cf z') (pb-Q a b c))

-- Φ sends the gap map of g to the gap map of comp f g
abstract cancel-Φ-gap ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → hom-map-assoc-coh {X} {A} sX sA p →
  {x y z : X} (f : hom X x y) (g : hom X y z) (z' : X) (w : hom X z z') →
  cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z' (cocart-gap {X} {A} sX sA p {y} {z} g z' w)
    ≡ cocart-gap {X} {A} sX sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z' w
cancel-Φ-gap {X} {A} sX sA p coh {x} {y} {z} f g z' w =
  let a : hom X x z' → hom A (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let d : hom A (p z) (p z') → hom A (p x) (p z') =
    λ k . comp-hom-r A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-hom-r X sX {x} {y} {z} f g)) k in
  let α : comp-hom-r X sX {x} {z} {z'} (comp-hom-r X sX {x} {y} {z} f g) w ≡ comp-hom-r X sX {x} {y} {z'} f (comp-hom-r X sX {y} {z} {z'} g w) =
    comp-hom-r-assoc X sX {x} {y} {z} {z'} f g w in
  let D : a (comp-hom-r X sX {x} {z} {z'} (comp-hom-r X sX {x} {y} {z} f g) w) ≡ d (hom-map {X} {A} p {z} {z'} w) =
    hom-map-comp X A p sX sA {x} {z} {z'} (comp-hom-r X sX {x} {y} {z} f g) w in
  pb-path a d (sym α) (hom-map {X} {A} p {z} {z'} w) _ D
    (trans (path-rot (cong a α) _ _ D _ _ (coh {x} {y} {z} {z'} f g w))
      (cong {a (comp-hom-r X sX {x} {y} {z'} f (comp-hom-r X sX {y} {z} {z'} g w)) ≡ a (comp-hom-r X sX {x} {z} {z'} (comp-hom-r X sX {x} {y} {z} f g) w)}
            {a (comp-hom-r X sX {x} {y} {z'} f (comp-hom-r X sX {y} {z} {z'} g w)) ≡ d (hom-map {X} {A} p {z} {z'} w)}
            (λ q . trans q D) (sym (cong-sym a α))))

abstract is-cocartesian-cancel ∷ {X A ∷ U} (sX : is-segal-r X) (sA : is-segal-r A) (p ∷ X → A) → hom-map-assoc-coh {X} {A} sX sA p →
  {x y z : X} (f : hom X x y) (g : hom X y z) → is-cocartesian {X} {A} sX sA p {x} {y} f →
  (is-cocartesian {X} {A} sX sA p {y} {z} g → is-cocartesian {X} {A} sX sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g)) ×
  (is-cocartesian {X} {A} sX sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) → is-cocartesian {X} {A} sX sA p {y} {z} g)
is-cocartesian-cancel {X} {A} sX sA p coh {x} {y} {z} f g cf =
  let Φ : (z' : X) → cocart-pb {X} {A} sA p {y} {z} g z' → cocart-pb {X} {A} sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z' =
    cancel-Φ {X} {A} sX sA p {x} {y} {z} f g in
  let gg : (z' : X) → hom X z z' → cocart-pb {X} {A} sA p {y} {z} g z' = cocart-gap {X} {A} sX sA p {y} {z} g in
  let gfg : (z' : X) → hom X z z' → cocart-pb {X} {A} sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z' =
    cocart-gap {X} {A} sX sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) in
  ((λ cg z' .
     is-equiv-htpy {hom X z z'} {cocart-pb {X} {A} sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z'} {Φ z' ∘ gg z'} {gfg z'}
       (cancel-Φ-gap {X} {A} sX sA p coh {x} {y} {z} f g z')
       (is-equiv-circ (Φ z') (gg z') (is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z') (cg z'))) ,
   (λ cgf z' .
     is-equiv-cancel-l (Φ z') (gg z') (is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z')
       (is-equiv-htpy {hom X z z'} {cocart-pb {X} {A} sA p {x} {z} (comp-hom-r X sX {x} {y} {z} f g) z'} {gfg z'} {Φ z' ∘ gg z'}
         (λ w . sym (cancel-Φ-gap {X} {A} sX sA p coh {x} {y} {z} f g z' w))
         (cgf z'))))
