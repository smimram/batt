--
-- (Co)cartesian arrows
--
-- Following Gepner–Heine, for a map p ∷ X → A between oplax-Segal types, an arrow f : x → y of
-- X is p-cartesian when, for every x' : X, the gap map
--
--   hom X x' x → hom X x' y ×_{hom A (p x') (p y)} hom A (p x') (p x)
--   g ↦ (f ∘ g , p g , functoriality of p on (g , f))
--
-- is an equivalence, i.e. the square
--
--   hom X x' x ───────f∘─→ hom X x' y
--       │p                     │p
--       ↓                      ↓
--   hom A (p x') (p x) ──(p f)∘─→ hom A (p x') (p y)
--
-- is a pullback. Dually, f is p-cocartesian when, for every y' : X, the gap map
--
--   hom X y y' → hom X x y' ×_{hom A (p x) (p y')} hom A (p y) (p y')
--   g ↦ (g ∘ f , p g , functoriality of p on (f , g))
--
-- is an equivalence. Composition is written diagrammatically: f ∘ g is comp-homᵣ X s g f, and the
-- third components come from the functoriality of p on homs (Functoriality.batt).
--

open import Stdlib
open import Hom
open import Segal
open import Composition
open import Unitality
open import Associativity
open import Functoriality
open import Iso

--
-- Cartesian arrows
--

-- the fibre product hom X x' y ×_{hom A (p x') (p y)} hom A (p x') (p x), over p and (p f) ∘ -
cart-pb ∷ {X A ∷ U} (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) (x' : X) → U
cart-pb {X} {A} sA p {x} {y} f x' =
  Σ (h : hom x' y) . Σ (k : hom (p x') (p x)) .
    hom-map {X} {A} p {x'} {y} h ≡ comp-homᵣ A sA {p x'} {p x} {p y} k (hom-map {X} {A} p {x} {y} f)

-- the gap map g ↦ (f ∘ g , p g , functoriality of p on (g , f))
cart-gap ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) (x' : X) →
  hom x' x → cart-pb {X} {A} sA p {x} {y} f x'
cart-gap {X} {A} sX sA p {x} {y} f x' g =
  (comp-homᵣ X sX {x'} {x} {y} g f , hom-map {X} {A} p {x'} {x} g , hom-map-comp X A p sX sA {x'} {x} {y} g f)

-- f is p-cartesian when its gap maps are equivalences
is-cartesian ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} → hom x y → U
is-cartesian {X} {A} sX sA p {x} {y} f = (x' : X) → is-equiv (cart-gap {X} {A} sX sA p {x} {y} f x')

--
-- Cocartesian arrows
--

-- the fibre product hom X x y' ×_{hom A (p x) (p y')} hom A (p y) (p y'), over p and - ∘ (p f)
cocart-pb ∷ {X A ∷ U} (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) (y' : X) → U
cocart-pb {X} {A} sA p {x} {y} f y' =
  Σ (h : hom x y') . Σ (k : hom (p y) (p y')) .
    hom-map {X} {A} p {x} {y'} h ≡ comp-homᵣ A sA {p x} {p y} {p y'} (hom-map {X} {A} p {x} {y} f) k

-- the gap map g ↦ (g ∘ f , p g , functoriality of p on (f , g))
cocart-gap ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) (y' : X) →
  hom y y' → cocart-pb {X} {A} sA p {x} {y} f y'
cocart-gap {X} {A} sX sA p {x} {y} f y' g =
  (comp-homᵣ X sX {x} {y} {y'} f g , hom-map {X} {A} p {y} {y'} g , hom-map-comp X A p sX sA {x} {y} {y'} f g)

-- f is p-cocartesian when its gap maps are equivalences
is-cocartesian ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} → hom x y → U
is-cocartesian {X} {A} sX sA p {x} {y} f = (y' : X) → is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y')

-- being cocartesian is a proposition
is-prop-is-cocartesian ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) →
  is-prop (is-cocartesian {X} {A} sX sA p {x} {y} f)
is-prop-is-cocartesian {X} {A} sX sA p {x} {y} f =
  is-prop-Π (λ y' . is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y'))
    (λ y' . is-prop-is-equiv (cocart-gap {X} {A} sX sA p {x} {y} f y'))

--
-- Cartesian fibrations
--
-- p is a cartesian fibration when every arrow of A admits a unique cartesian lift with a given
-- target, i.e. when the map
--
--   (ev₁ , p ∘ -) : Σ (f : 𝕀 →ᵣ X) . is-cartesian p f → X ×_A (𝕀 →ᵣ A)
--
-- is an equivalence (the pullback is over p and ev₁).
--

-- a 1-cell, as a hom between its endpoints
cell-hom ∷ {X ∷ U} (f : 𝕀 →ᵣ X) → hom (f 𝕀0) (f 𝕀1)
cell-hom {X} f = (f , refl , refl)

-- being cocartesian, for the homs of 1-cells, is invariant under paths of 1-cells
is-cocartesian-cell-path ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {f g : 𝕀 →ᵣ X} (e : f ≡ g) →
  is-cocartesian {X} {A} sX sA p {srcᵣ g} {tgtᵣ g} (cell-hom {X} g) → is-cocartesian {X} {A} sX sA p {srcᵣ f} {tgtᵣ f} (cell-hom {X} f)
is-cocartesian-cell-path {X} {A} sX sA p {f} {g} e =
  subst {𝕀 →ᵣ X} (λ c . is-cocartesian {X} {A} sX sA p {srcᵣ c} {tgtᵣ c} (cell-hom {X} c)) (sym e)

-- cartesian 1-cells
cart-cell ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) → U
cart-cell {X} {A} sX sA p = Σ (f : arrᵣ X) . is-cartesian {X} {A} sX sA p {f 𝕀0} {f 𝕀1} (cell-hom {X} f)

-- the target of a cartesian 1-cell together with its image
cart-cell-lift ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) →
  cart-cell {X} {A} sX sA p → pullback {X} {𝕀 →ᵣ A} {A} p (λ u . u 𝕀1)
cart-cell-lift {X} {A} sX sA p (f , c) = (f 𝕀1 , postᵣ {𝕀} {X} {A} p f , refl)

is-cartesian-fibration ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) → U
is-cartesian-fibration {X} {A} sX sA p = is-equiv (cart-cell-lift {X} {A} sX sA p)

-- being a cartesian fibration is a proposition
is-prop-is-cartesian-fibration ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) →
  is-prop (is-cartesian-fibration {X} {A} sX sA p)
is-prop-is-cartesian-fibration {X} {A} sX sA p = is-prop-is-equiv (cart-cell-lift {X} {A} sX sA p)

--
-- Cocartesian fibrations
--
-- Dually, p is a cocartesian fibration when every arrow of A admits a unique cocartesian lift
-- with a given source, i.e. when the map
--
--   (ev₀ , p ∘ -) : Σ (f : 𝕀 →ᵣ X) . is-cocartesian p f → X ×_A (𝕀 →ᵣ A)
--
-- is an equivalence (the pullback is over p and ev₀).
--

-- cocartesian 1-cells
cocart-cell ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) → U
cocart-cell {X} {A} sX sA p = Σ (f : arrᵣ X) . is-cocartesian {X} {A} sX sA p {srcᵣ f} {tgtᵣ f} (cell-hom {X} f)

-- the underlying 1-cell of a cocartesian 1-cell
cocart-cell-arr ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) → cocart-cell {X} {A} sX sA p → arrᵣ X
cocart-cell-arr {X} {A} sX sA p w = fst _ w

-- the source of a cocartesian 1-cell together with its image
cocart-cell-lift ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) →
  cocart-cell {X} {A} sX sA p → pullback {X} {arrᵣ A} {A} p (λ u . srcᵣ u)
cocart-cell-lift {X} {A} sX sA p (f , c) = (f 𝕀0 , postᵣ {𝕀} {X} {A} p f , refl)

is-cocartesian-fibration ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) → U
is-cocartesian-fibration {X} {A} sX sA p = is-equiv (cocart-cell-lift {X} {A} sX sA p)

-- being a cocartesian fibration is a proposition
is-prop-is-cocartesian-fibration ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) →
  is-prop (is-cocartesian-fibration {X} {A} sX sA p)
is-prop-is-cocartesian-fibration {X} {A} sX sA p = is-prop-is-equiv (cocart-cell-lift {X} {A} sX sA p)

--
-- Isomorphisms are (co)cartesian
--
-- For an isomorphism f, the first projection of the fibre product is an equivalence: its fibres
-- are fibres of composition with the isomorphism p f, which are contractible. Its composite with
-- the gap map is composition with f, which is an equivalence, hence so is the gap map.
--

-- the type of preimages, with the path in the other direction, is contractible
is-contr-fib-sym ∷ {A B : U} (f : A → B) → is-equiv f → (y : B) → is-contr (Σ (a : A) . y ≡ f a)
is-contr-fib-sym {A} {B} f e y =
  let s : (Σ (a : A) . y ≡ f a) → fib f y = fun (a , q) → (a , sym q) in
  let r : fib f y → Σ (a : A) . y ≡ f a = fun (a , q) → (a , sym q) in
  let rs : (w : Σ (a : A) . y ≡ f a) → r (s w) ≡ w = fun (a , q) →
    cong {y ≡ f a} {Σ (a' : A) . y ≡ f a'} (λ q' . (a , q')) (sym-sym q) in
  is-contr-retract s (r , rs) (is-contr-fib f e y)

is-cocartesian-iso ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) →
  is-iso-hom {X} sX {x} {y} f → is-cocartesian {X} {A} sX sA p {x} {y} f
is-cocartesian-iso {X} {A} sX sA p {x} {y} f i y' =
  let pf : hom (p x) (p y) = hom-map {X} {A} p {x} {y} f in
  let P : hom x y' → U = λ h . Σ (k : hom (p y) (p y')) . hom-map {X} {A} p {x} {y'} h ≡ comp-homᵣ A sA {p x} {p y} {p y'} pf k in
  let π : cocart-pb {X} {A} sA p {x} {y} f y' → hom x y' = fst P in
  let eπ : is-equiv π =
    is-equiv-fst-contr P (λ h . is-contr-fib-sym (λ k . comp-homᵣ A sA {p x} {p y} {p y'} pf k)
      (is-equiv-comp-iso-l {A} sA {p x} {p y} pf (is-iso-hom-map {X} {A} sX sA p {x} {y} f i) (p y'))
      (hom-map {X} {A} p {x} {y'} h)) in
  is-equiv-cancel-l π (cocart-gap {X} {A} sX sA p {x} {y} f y') eπ (is-equiv-comp-iso-l {X} sX {x} {y} f i y')

is-cartesian-iso ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y : X} (f : hom x y) →
  is-iso-hom {X} sX {x} {y} f → is-cartesian {X} {A} sX sA p {x} {y} f
is-cartesian-iso {X} {A} sX sA p {x} {y} f i x' =
  let pf : hom (p x) (p y) = hom-map {X} {A} p {x} {y} f in
  let P : hom x' y → U = λ h . Σ (k : hom (p x') (p x)) . hom-map {X} {A} p {x'} {y} h ≡ comp-homᵣ A sA {p x'} {p x} {p y} k pf in
  let π : cart-pb {X} {A} sA p {x} {y} f x' → hom x' y = fst P in
  let eπ : is-equiv π =
    is-equiv-fst-contr P (λ h . is-contr-fib-sym (λ k . comp-homᵣ A sA {p x'} {p x} {p y} k pf)
      (is-equiv-comp-iso-r {A} sA {p x} {p y} pf (is-iso-hom-map {X} {A} sX sA p {x} {y} f i) (p x'))
      (hom-map {X} {A} p {x'} {y} h)) in
  is-equiv-cancel-l π (cart-gap {X} {A} sX sA p {x} {y} f x') eπ (is-equiv-comp-iso-r {X} sX {x} {y} f i x')

--
-- Cancellation of cocartesian arrows
--
-- For f : x → y cocartesian and g : y → z, comp f g is cocartesian iff g is. The fibre product
-- of g, base changed along the gap map of f, pastes with the fibre product of f into the fibre
-- product of comp f g (pb-paste, Pullback.batt), and this comparison map Φ is an equivalence. Its composite
-- with the gap map of g is the gap map of comp f g, up to associativity: on the third
-- components, this is the coherence of the functoriality of p on homs with associativity
-- (hom-map-comp-assoc, Functoriality.batt).
--

-- the comparison map between the fibre products of g and of comp f g
cancel-R ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y z : X} (f : hom x y) (g : hom y z) (z' : X)
  (k : hom (p z) (p z')) →
  comp-homᵣ A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) (comp-homᵣ A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k)
    ≡ comp-homᵣ A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g)) k
cancel-R {X} {A} sX sA p {x} {y} {z} f g z' k =
  trans (sym (comp-homᵣ-assoc A sA {p x} {p y} {p z} {p z'} (hom-map {X} {A} p {x} {y} f) (hom-map {X} {A} p {y} {z} g) k))
    (sym (cong (λ m . comp-homᵣ A sA {p x} {p z} {p z'} m k) (hom-map-comp X A p sX sA {x} {y} {z} f g)))

cancel-Φ ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y z : X} (f : hom x y) (g : hom y z) (z' : X) →
  cocart-pb {X} {A} sA p {y} {z} g z' → cocart-pb {X} {A} sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z'
cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z' v =
  let a : hom x z' → hom (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let b : hom (p y) (p z') → hom (p x) (p z') = λ l . comp-homᵣ A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) l in
  let c : hom (p z) (p z') → hom (p y) (p z') = λ k . comp-homᵣ A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k in
  let d : hom (p z) (p z') → hom (p x) (p z') =
    λ k . comp-homᵣ A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g)) k in
  pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z')
    (Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (pb-Q a b c) v)

is-equiv-cancel-Φ ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {x y z : X} (f : hom x y) (g : hom y z) →
  is-cocartesian {X} {A} sX sA p {x} {y} f → (z' : X) → is-equiv (cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z')
is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z' =
  let a : hom x z' → hom (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let b : hom (p y) (p z') → hom (p x) (p z') = λ l . comp-homᵣ A sA {p x} {p y} {p z'} (hom-map {X} {A} p {x} {y} f) l in
  let c : hom (p z) (p z') → hom (p y) (p z') = λ k . comp-homᵣ A sA {p y} {p z} {p z'} (hom-map {X} {A} p {y} {z} g) k in
  let d : hom (p z) (p z') → hom (p x) (p z') =
    λ k . comp-homᵣ A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g)) k in
  is-equiv-circ (pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z'))
    (Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (pb-Q a b c))
    (is-equiv-pb-paste a b c d (cancel-R {X} {A} sX sA p {x} {y} {z} f g z'))
    (is-equiv-Σ-base (cocart-gap {X} {A} sX sA p {x} {y} f z') (cf z') (pb-Q a b c))

-- Φ sends the gap map of g to the gap map of comp f g
cancel-Φ-gap ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A)
  {x y z : X} (f : hom x y) (g : hom y z) (z' : X) (w : hom z z') →
  cancel-Φ {X} {A} sX sA p {x} {y} {z} f g z' (cocart-gap {X} {A} sX sA p {y} {z} g z' w)
    ≡ cocart-gap {X} {A} sX sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z' w
cancel-Φ-gap {X} {A} sX sA p {x} {y} {z} f g z' w =
  let a : hom x z' → hom (p x) (p z') = hom-map {X} {A} p {x} {z'} in
  let d : hom (p z) (p z') → hom (p x) (p z') =
    λ k . comp-homᵣ A sA {p x} {p z} {p z'} (hom-map {X} {A} p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g)) k in
  let α : comp-homᵣ X sX {x} {z} {z'} (comp-homᵣ X sX {x} {y} {z} f g) w ≡ comp-homᵣ X sX {x} {y} {z'} f (comp-homᵣ X sX {y} {z} {z'} g w) =
    comp-homᵣ-assoc X sX {x} {y} {z} {z'} f g w in
  let D : a (comp-homᵣ X sX {x} {z} {z'} (comp-homᵣ X sX {x} {y} {z} f g) w) ≡ d (hom-map {X} {A} p {z} {z'} w) =
    hom-map-comp X A p sX sA {x} {z} {z'} (comp-homᵣ X sX {x} {y} {z} f g) w in
  pb-path a d (sym α) (hom-map {X} {A} p {z} {z'} w) _ D
    (trans (path-rot (cong a α) _ _ D _ _ (hom-map-comp-assoc X A p sX sA {x} {y} {z} {z'} f g w))
      (cong {a (comp-homᵣ X sX {x} {y} {z'} f (comp-homᵣ X sX {y} {z} {z'} g w)) ≡ a (comp-homᵣ X sX {x} {z} {z'} (comp-homᵣ X sX {x} {y} {z} f g) w)}
            {a (comp-homᵣ X sX {x} {y} {z'} f (comp-homᵣ X sX {y} {z} {z'} g w)) ≡ d (hom-map {X} {A} p {z} {z'} w)}
            (λ q . trans q D) (sym (cong-sym a α))))

is-cocartesian-cancel ∷ 
  {X A ∷ U}
  (sX : is-segalᵣ X)
  (sA : is-segalᵣ A)
  (p ∷ X → A)
  → {x y z : X} (f : hom x y) (g : hom y z) 
  → is-cocartesian {X} {A} sX sA p {x} {y} f
  → (is-cocartesian {X} {A} sX sA p {y} {z} g 
      → is-cocartesian {X} {A} sX sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g))
  × (is-cocartesian {X} {A} sX sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) 
      → is-cocartesian {X} {A} sX sA p {y} {z} g)
is-cocartesian-cancel {X} {A} sX sA p {x} {y} {z} f g cf =
  let Φ : (z' : X) → cocart-pb {X} {A} sA p {y} {z} g z' → cocart-pb {X} {A} sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z' =
    cancel-Φ {X} {A} sX sA p {x} {y} {z} f g in
  let gg : (z' : X) → hom z z' → cocart-pb {X} {A} sA p {y} {z} g z' = cocart-gap {X} {A} sX sA p {y} {z} g in
  let gfg : (z' : X) → hom z z' → cocart-pb {X} {A} sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z' =
    cocart-gap {X} {A} sX sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) in
  ((λ cg z' .
    is-equiv-htpy {hom z z'} {cocart-pb {X} {A} sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z'} {Φ z' ∘ gg z'} {gfg z'}
      (cancel-Φ-gap {X} {A} sX sA p {x} {y} {z} f g z')
      (is-equiv-circ (Φ z') (gg z') (is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z') (cg z'))) ,
  (λ cgf z' .
    is-equiv-cancel-l (Φ z') (gg z') (is-equiv-cancel-Φ {X} {A} sX sA p {x} {y} {z} f g cf z')
      (is-equiv-htpy {hom z z'} {cocart-pb {X} {A} sA p {x} {z} (comp-homᵣ X sX {x} {y} {z} f g) z'} {gfg z'} {Φ z' ∘ gg z'}
        (λ w . sym (cancel-Φ-gap {X} {A} sX sA p {x} {y} {z} f g z' w))
        (cgf z'))))

--
-- Endpoints and isomorphisms
--

-- cocartesianness of a 1-cell does not depend on the paths identifying its endpoints
is-cocartesian-endpoints ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) (f : arrᵣ X)
  {x : X} (e0 : srcᵣ f ≡ x) {y : X} (e1 : tgtᵣ f ≡ y) →
  is-cocartesian {X} {A} sX sA p {srcᵣ f} {tgtᵣ f} (cell-hom {X} f) → is-cocartesian {X} {A} sX sA p {x} {y} (f , e0 , e1)
is-cocartesian-endpoints {X} {A} sX sA p f refl refl = λ c . c

-- a cocartesian arrow m whose image has a right inverse k has a right inverse lying over k
cocart-right-inv ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {y1 y2 : X} (m : hom y1 y2) →
  is-cocartesian {X} {A} sX sA p {y1} {y2} m →
  (k : hom (p y2) (p y1)) → comp-homᵣ A sA {p y1} {p y2} {p y1} (hom-map {X} {A} p {y1} {y2} m) k ≡ Hom.id {A} (p y1) →
  Σ (n : hom y2 y1) . (comp-homᵣ X sX {y1} {y2} {y1} m n ≡ Hom.id {X} y1) × (hom-map {X} {A} p {y2} {y1} n ≡ k)
cocart-right-inv {X} {A} sX sA p {y1} {y2} m cm k e =
  let G : hom y2 y1 → cocart-pb {X} {A} sA p {y1} {y2} m y1 = cocart-gap {X} {A} sX sA p {y1} {y2} m y1 in
  let σ : section G = is-equiv-sec G (cm y1) in
  let π : cocart-pb {X} {A} sA p {y1} {y2} m y1 = (Hom.id {X} y1 , k , sym e) in
  let n : hom y2 y1 = section-map G σ π in
  let P : G n ≡ π = snd _ σ π in
  (n ,
   cong {cocart-pb {X} {A} sA p {y1} {y2} m y1} {hom y1 y1} (λ z . fst _ z) P ,
   cong {cocart-pb {X} {A} sA p {y1} {y2} m y1} {hom (p y2) (p y1)} (λ z . fst _ (snd _ z)) P)

-- a cocartesian arrow whose image is an isomorphism is an isomorphism: it has a right inverse n
-- over the inverse of its image, n is cocartesian by cancellation, so it has a right inverse n'
-- too, and n' is m
is-iso-cocartesian ∷ {X A ∷ U} (sX : is-segalᵣ X) (sA : is-segalᵣ A) (p ∷ X → A) {y1 y2 : X} (m : hom y1 y2) →
  is-cocartesian {X} {A} sX sA p {y1} {y2} m →
  is-iso-hom {A} sA {p y1} {p y2} (hom-map {X} {A} p {y1} {y2} m) → is-iso-hom {X} sX {y1} {y2} m
is-iso-cocartesian {X} {A} sX sA p {y1} {y2} m cm (k , ek) =
  let pm : hom (p y1) (p y2) = hom-map {X} {A} p {y1} {y2} m in
  let ek1 : comp-homᵣ A sA {p y1} {p y2} {p y1} pm k ≡ Hom.id {A} (p y1) = Product.fst ek in
  let ek2 : comp-homᵣ A sA {p y2} {p y1} {p y2} k pm ≡ Hom.id {A} (p y2) = Product.snd ek in
  let r1 : Σ (n : hom y2 y1) . (comp-homᵣ X sX {y1} {y2} {y1} m n ≡ Hom.id {X} y1) × (hom-map {X} {A} p {y2} {y1} n ≡ k) =
    cocart-right-inv {X} {A} sX sA p {y1} {y2} m cm k ek1 in
  let n : hom y2 y1 = fst _ r1 in
  let mn : comp-homᵣ X sX {y1} {y2} {y1} m n ≡ Hom.id {X} y1 = Product.fst (snd _ r1) in
  let pn : hom-map {X} {A} p {y2} {y1} n ≡ k = Product.snd (snd _ r1) in
  let cmn : is-cocartesian {X} {A} sX sA p {y1} {y1} (comp-homᵣ X sX {y1} {y2} {y1} m n) =
    subst (λ h . is-cocartesian {X} {A} sX sA p {y1} {y1} h) (sym mn)
      (is-cocartesian-iso {X} {A} sX sA p {y1} {y1} (Hom.id {X} y1) (is-iso-id {X} sX y1)) in
  let cn : is-cocartesian {X} {A} sX sA p {y2} {y1} n =
    Product.snd (is-cocartesian-cancel {X} {A} sX sA p {y1} {y2} {y1} m n cm) cmn in
  let e2 : comp-homᵣ A sA {p y2} {p y1} {p y2} (hom-map {X} {A} p {y2} {y1} n) pm ≡ Hom.id {A} (p y2) =
    trans (cong {hom (p y2) (p y1)} {hom (p y2) (p y2)} (λ l . comp-homᵣ A sA {p y2} {p y1} {p y2} l pm) pn) ek2 in
  let r2 : Σ (n' : hom y1 y2) . (comp-homᵣ X sX {y2} {y1} {y2} n n' ≡ Hom.id {X} y2) × (hom-map {X} {A} p {y1} {y2} n' ≡ pm) =
    cocart-right-inv {X} {A} sX sA p {y2} {y1} n cn pm e2 in
  let n' : hom y1 y2 = fst _ r2 in
  let nn' : comp-homᵣ X sX {y2} {y1} {y2} n n' ≡ Hom.id {X} y2 = Product.fst (snd _ r2) in
  -- m = m (n n') = (m n) n' = n'
  let mn' : m ≡ n' =
    trans (sym (comp-homᵣ-runit X sX {y1} {y2} m))
      (trans (cong {hom y2 y2} {hom y1 y2} (λ l . comp-homᵣ X sX {y1} {y2} {y2} m l) (sym nn'))
        (trans (sym (comp-homᵣ-assoc X sX {y1} {y2} {y1} {y2} m n n'))
          (trans (cong {hom y1 y1} {hom y1 y2} (λ l . comp-homᵣ X sX {y1} {y1} {y2} l n') mn)
            (comp-homᵣ-lunit X sX {y1} {y2} n')))) in
  (n , mn ,
   trans (cong {hom y1 y2} {hom y2 y2} (λ l . comp-homᵣ X sX {y2} {y1} {y2} n l) mn') nn')

--
-- Composite maps
--
-- Composite lemma: for ι : X → Y and q : Y → A, if ι γ is q-cocartesian and γ is
-- ι-cocartesian, then γ is (q ∘ ι)-cocartesian. The fibre product of γ for q ∘ ι is obtained from
-- the one for ι by replacing the arrow of Y by its image under the gap map of ι γ (an
-- equivalence), contracting a singleton, and adjusting the paths by hom-map-circ. Under this
-- equivalence, the gap map of γ for ι is sent to the one for q ∘ ι, by the coherence of the
-- commutations with composition (hom-map-comp-circ, Functoriality.batt).
--

-- pre- and post-composition with fixed paths is an equivalence
is-equiv-trans-trans ∷ {T : U} {x y : T} (p : x ≡ y) {z w : T} (r : z ≡ w) →
  is-equiv {y ≡ z} {x ≡ w} (λ f . trans p (trans f r))
is-equiv-trans-trans {T} {x} refl {z} refl =
  is-equiv-htpy {x ≡ z} {x ≡ z} {id} {λ f . trans refl (trans f refl)} (λ f . sym (trans-refl-l f)) (is-equiv-id (x ≡ z))

-- contracting a singleton in a fibre product
singl-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) {m : M} (e : a h ≡ m) (s : Σ (l : L) . Q m ≡ b l) →
  Σ (l : L) . Q (a h) ≡ b l
singl-r {H} {M} {L} {T} a Q b h e (l , f) = (l , trans (cong Q e) f)

singl-z ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) →
  a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z → Σ (l : L) . Q (a h) ≡ b l
singl-z {H} {M} {L} {T} a Q b h (m , s) e = singl-r a Q b h {m} e s

singl ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) →
  (Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l
singl {H} {M} {L} {T} a Q b (h , r) =
  let k : (r : Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) → Σ (l : L) . Q (a h) ≡ b l =
    fun (z , e) → singl-z a Q b h z e in
  (h , k r)

unsingl ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) →
  (Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l) →
  Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z
unsingl {H} {M} {L} {T} a Q b (h , s) = (h , ((a h , s) , refl))

singl-sec-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (s : Σ (l : L) . Q (a h) ≡ b l) →
  singl a Q b (unsingl a Q b (h , s)) ≡{Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l} (h , s)
singl-sec-r {H} {M} {L} {T} a Q b h (l , f) =
  cong {Q (a h) ≡ b l} {Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l} (λ f' . (h , (l , f'))) (trans-refl-l f)

singl-ret-r ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) {m : M} (e : a h ≡ m) (l : L) (f : Q m ≡ b l) →
  unsingl a Q b (singl a Q b (h , ((m , (l , f)) , e)))
    ≡{Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , ((m , (l , f)) , e))
singl-ret-r {H} {M} {L} {T} a Q b h refl l f =
  cong {Q (a h) ≡ b l} {Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z}
    (λ f' . (h , ((a h , (l , f')) , refl))) (trans-refl-l f)

singl-ret-s ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (m : M) (s : Σ (l : L) . Q m ≡ b l) (e : a h ≡ m) →
  unsingl a Q b (singl a Q b (h , ((m , s) , e)))
    ≡{Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , ((m , s) , e))
singl-ret-s {H} {M} {L} {T} a Q b h m (l , f) e = singl-ret-r a Q b h {m} e l f

singl-ret-z ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (h : H) (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l)
  (e : a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  unsingl a Q b (singl a Q b (h , (z , e)))
    ≡{Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , (z , e))
singl-ret-z {H} {M} {L} {T} a Q b h (m , s) e = singl-ret-s a Q b h m s e

singl-ret ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T)
  (w : Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
  unsingl a Q b (singl a Q b w) ≡ w
singl-ret {H} {M} {L} {T} a Q b (h , r) =
  let k : (r : Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z) →
          unsingl a Q b (singl a Q b (h , r))
            ≡{Σ (h : H) . Σ (z : Σ (m : M) . Σ (l : L) . Q m ≡ b l) . a h ≡ fst (λ m . Σ (l : L) . Q m ≡ b l) z} (h , r) =
    fun (z , e) → singl-ret-z a Q b h z e in
  k r

singl-sec ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) (w : Σ (h : H) . Σ (l : L) . Q (a h) ≡ b l) →
  singl a Q b (unsingl a Q b w) ≡ w
singl-sec {H} {M} {L} {T} a Q b (h , s) = singl-sec-r a Q b h s

is-equiv-singl ∷ {H M L T : U} (a : H → M) (Q : M → T) (b : L → T) → is-equiv (singl a Q b)
is-equiv-singl {H} {M} {L} {T} a Q b =
  ((unsingl a Q b , singl-sec a Q b) , (unsingl a Q b , singl-ret a Q b))

-- paths in a fibre product with the same first component
pb-path2 ∷ {H L T : U} (a : H → T) (b : L → T) (h : H) {l1 l2 : L} (α : l1 ≡ l2) (e1 : a h ≡ b l1) (e2 : a h ≡ b l2) →
  trans e1 (cong b α) ≡ e2 → (h , l1 , e1) ≡{Σ (h : H) . Σ (l : L) . a h ≡ b l} (h , l2 , e2)
pb-path2 {H} {L} {T} a b h {l1} refl e1 e2 E =
  cong {a h ≡ b l1} {Σ (h : H) . Σ (l : L) . a h ≡ b l} (λ e . (h , l1 , e)) E

comp-fib-alg ∷ {T S1 S2 : U} (f : S1 → S2 → T) {t0 t1 t2 : T} (a : t0 ≡ t1) (b : t1 ≡ t2)
  {x x' : S1} (d : x ≡ x') {y y' : S2} (e : y ≡ y') (c : t2 ≡ f x' y') →
  trans (trans a (trans b (trans c (sym (cong2 f d e))))) (cong (f x) e)
    ≡ trans a (trans (trans b c) (cong (λ m . f m y') (sym d)))
comp-fib-alg {T} {S1} {S2} f a b {x} refl {y} refl c = refl

-- composite lemma: if ι γ is q-cocartesian and γ is ι-cocartesian, then γ is (q ∘ ι)-cocartesian
is-cocartesian-comp-fib ∷ {X Y A ∷ U} (sX : is-segalᵣ X) (sY : is-segalᵣ Y) (sA : is-segalᵣ A) (ι ∷ X → Y) (q ∷ Y → A)
  {u v : X} (γ : hom u v) →
  is-cocartesian {X} {Y} sX sY ι {u} {v} γ →
  is-cocartesian {Y} {A} sY sA q {ι u} {ι v} (hom-map {X} {Y} ι {u} {v} γ) →
  is-cocartesian {X} {A} sX sA (λ w . q (ι w)) {u} {v} γ
is-cocartesian-comp-fib {X} {Y} {A} sX sY sA ι q {u} {v} γ cι cq s =
  let p ∷ X → A = λ w . q (ι w) in
  let ιγ : hom (ι u) (ι v) = hom-map {X} {Y} ι {u} {v} γ in
  let qιγ : hom (q (ι u)) (q (ι v)) = hom-map {Y} {A} q {ι u} {ι v} ιγ in
  let pγ : hom (p u) (p v) = hom-map {X} {A} p {u} {v} γ in
  let hι : hom u s → hom (ι u) (ι s) = hom-map {X} {Y} ι {u} {s} in
  let hq : hom (ι u) (ι s) → hom (q (ι u)) (q (ι s)) = hom-map {Y} {A} q {ι u} {ι s} in
  let bq : hom (q (ι v)) (q (ι s)) → hom (q (ι u)) (q (ι s)) = λ l . comp-homᵣ A sA {p u} {p v} {p s} qιγ l in
  let bp : hom (q (ι v)) (q (ι s)) → hom (q (ι u)) (q (ι s)) = λ l . comp-homᵣ A sA {p u} {p v} {p s} pγ l in
  let Gι : hom v s → cocart-pb {X} {Y} sY ι {u} {v} γ s = cocart-gap {X} {Y} sX sY ι {u} {v} γ s in
  let Gq : hom (ι v) (ι s) → cocart-pb {Y} {A} sA q {ι u} {ι v} ιγ (ι s) = cocart-gap {Y} {A} sY sA q {ι u} {ι v} ιγ (ι s) in
  let Gp : hom v s → cocart-pb {X} {A} sA p {u} {v} γ s = cocart-gap {X} {A} sX sA p {u} {v} γ s in
  let CPq : U = cocart-pb {Y} {A} sA q {ι u} {ι v} ιγ (ι s) in
  let Qz : hom u s → CPq → U = λ h z . hι h ≡ fst (λ m . Σ (l : hom (q (ι v)) (q (ι s))) . hq m ≡ bq l) z in
  -- replace the second component by its gap (an equivalence), contract, and adjust the paths
  let E1 : cocart-pb {X} {Y} sY ι {u} {v} γ s → Σ (h : hom u s) . Σ (z : CPq) . Qz h z =
    tot {hom u s} {λ h . Σ (k : hom (ι v) (ι s)) . Qz h (Gq k)} {λ h . Σ (z : CPq) . Qz h z} (λ h . Σ-base Gq (Qz h)) in
  let eE1 : is-equiv E1 =
    is-equiv-tot {hom u s} {λ h . Σ (k : hom (ι v) (ι s)) . Qz h (Gq k)} {λ h . Σ (z : CPq) . Qz h z} (λ h . Σ-base Gq (Qz h))
      (λ h . is-equiv-Σ-base Gq (cq (ι s)) (Qz h)) in
  let E2 : (Σ (h : hom u s) . Σ (z : CPq) . Qz h z) → Σ (h : hom u s) . Σ (l : hom (q (ι v)) (q (ι s))) . hq (hι h) ≡ bq l =
    singl hι hq bq in
  let eE2 : is-equiv E2 = is-equiv-singl hι hq bq in
  let adj : (h : hom u s) (l : hom (q (ι v)) (q (ι s))) → hq (hι h) ≡ bq l → hom-map {X} {A} p {u} {s} h ≡ bp l =
    λ h l f . trans (hom-map-circ {X} {Y} {A} ι q {u} {s} h)
      (trans f (cong {hom (p u) (p v)} {hom (p u) (p s)} (λ m . comp-homᵣ A sA {p u} {p v} {p s} m l) (sym (hom-map-circ {X} {Y} {A} ι q {u} {v} γ)))) in
  let E3 : (Σ (h : hom u s) . Σ (l : hom (q (ι v)) (q (ι s))) . hq (hι h) ≡ bq l) → cocart-pb {X} {A} sA p {u} {v} γ s =
    tot {hom u s} {λ h . Σ (l : hom (q (ι v)) (q (ι s))) . hq (hι h) ≡ bq l} {λ h . Σ (l : hom (q (ι v)) (q (ι s))) . hom-map {X} {A} p {u} {s} h ≡ bp l}
      (λ h . tot {hom (q (ι v)) (q (ι s))} {λ l . hq (hι h) ≡ bq l} {λ l . hom-map {X} {A} p {u} {s} h ≡ bp l} (adj h)) in
  let eE3 : is-equiv E3 =
    is-equiv-tot {hom u s} {λ h . Σ (l : hom (q (ι v)) (q (ι s))) . hq (hι h) ≡ bq l} {λ h . Σ (l : hom (q (ι v)) (q (ι s))) . hom-map {X} {A} p {u} {s} h ≡ bp l}
      (λ h . tot {hom (q (ι v)) (q (ι s))} {λ l . hq (hι h) ≡ bq l} {λ l . hom-map {X} {A} p {u} {s} h ≡ bp l} (adj h))
      (λ h . is-equiv-tot {hom (q (ι v)) (q (ι s))} {λ l . hq (hι h) ≡ bq l} {λ l . hom-map {X} {A} p {u} {s} h ≡ bp l} (adj h)
        (λ l . is-equiv-trans-trans (hom-map-circ {X} {Y} {A} ι q {u} {s} h)
          (cong {hom (p u) (p v)} {hom (p u) (p s)} (λ m . comp-homᵣ A sA {p u} {p v} {p s} m l) (sym (hom-map-circ {X} {Y} {A} ι q {u} {v} γ))))) in
  let Ψ : cocart-pb {X} {Y} sY ι {u} {v} γ s → cocart-pb {X} {A} sA p {u} {v} γ s = λ w . E3 (E2 (E1 w)) in
  let eΨ : is-equiv Ψ = is-equiv-circ E3 (λ w . E2 (E1 w)) eE3 (is-equiv-circ E2 E1 eE2 eE1) in
  -- the gap maps agree, by the coherence of the commutations
  let H : (g : hom v s) → Gp g ≡ Ψ (Gι g) = λ g .
    let C : hom u s = comp-homᵣ X sX {u} {v} {s} γ g in
    let pg : hom (p v) (p s) = hom-map {X} {A} p {v} {s} g in
    let qιg : hom (p v) (p s) = hom-map {Y} {A} q {ι v} {ι s} (hom-map {X} {Y} ι {v} {s} g) in
    pb-path2 (hom-map {X} {A} p {u} {s}) bp C (hom-map-circ {X} {Y} {A} ι q {v} {s} g)
      (hom-map-comp X A p sX sA {u} {v} {s} γ g) (snd _ (snd _ (Ψ (Gι g))))
      (trans (cong {hom-map {X} {A} p {u} {s} C ≡ bp pg} {hom-map {X} {A} p {u} {s} C ≡ bp qιg}
                (λ z . trans z (cong bp (hom-map-circ {X} {Y} {A} ι q {v} {s} g)))
                (hom-map-comp-circ X Y A ι q sX sY sA {u} {v} {s} γ g))
        (comp-fib-alg (λ m n . comp-homᵣ A sA {p u} {p v} {p s} m n)
          (hom-map-circ {X} {Y} {A} ι q {u} {s} C)
          (cong hq (hom-map-comp X Y ι sX sY {u} {v} {s} γ g))
          (hom-map-circ {X} {Y} {A} ι q {u} {v} γ)
          (hom-map-circ {X} {Y} {A} ι q {v} {s} g)
          (hom-map-comp Y A q sY sA {ι u} {ι v} {ι s} ιγ (hom-map {X} {Y} ι {v} {s} g)))) in
  is-equiv-htpy {hom v s} {cocart-pb {X} {A} sA p {u} {v} γ s} {λ g . Ψ (Gι g)} {Gp} (λ g . sym (H g))
    (is-equiv-circ Ψ Gι eΨ (cι s))

--
-- Equivalences
--
-- Cocartesian arrows and cocartesian fibrations are invariant under crisp equivalences (for the
-- Segal condition, see is-segalᵣ-equiv, Local.batt). The action on homs of a crisp equivalence is an
-- equivalence (is-equiv-hom-map), and for e : S → X over A, the gap maps of γ and of e γ are
-- conjugate (cocart-gap-equiv-square), by the coherence of the commutations with composition for
-- p ∘ e (hom-map-comp-circ). So γ is cocartesian iff e γ is (is-cocartesian-equiv, and
-- is-cocartesian-equiv-inv), e induces an equivalence of cocartesian 1-cells (cocart-cell-equiv)
-- compatible with the lifting maps, and p is a cocartesian fibration when p ∘ e is
-- (is-cocartesian-fibration-equiv).
--

-- the action on homs of a crisp equivalence is an equivalence
hom-map-dec ∷ {S X ∷ U} (e ∷ S → X) {x y : S} → hom x y → hom (e x) (e y)
hom-map-dec {S} {X} e {x} {y} =
  λ u . Σ-base {𝕀 →ᵣ S} {𝕀 →ᵣ X} (postᵣ {𝕀} {S} {X} e) (λ c' . (c' 𝕀0 ≡ e x) × (c' 𝕀1 ≡ e y))
    (tot {𝕀 →ᵣ S} {λ c . (c 𝕀0 ≡ x) × (c 𝕀1 ≡ y)} {λ c . (e (c 𝕀0) ≡ e x) × (e (c 𝕀1) ≡ e y)}
      (λ c . prod-map (cong e {c 𝕀0} {x}) (cong e {c 𝕀1} {y})) u)

hom-map-dec-eq-aux ∷ {S X ∷ U} (e ∷ S → X) {x y : S} (c : 𝕀 →ᵣ S) (p : (c 𝕀0 ≡ x) × (c 𝕀1 ≡ y)) →
  hom-map-dec {S} {X} e {x} {y} (c , p) ≡ hom-map {S} {X} e {x} {y} (c , p)
hom-map-dec-eq-aux {S} {X} e {x} {y} c (p0 , p1) = refl

hom-map-dec-eq ∷ {S X ∷ U} (e ∷ S → X) {x y : S} (u : hom x y) → hom-map-dec {S} {X} e {x} {y} u ≡ hom-map {S} {X} e {x} {y} u
hom-map-dec-eq {S} {X} e {x} {y} (c , p) = hom-map-dec-eq-aux {S} {X} e {x} {y} c p

is-equiv-hom-map ∷ {S X ∷ U} (e ∷ S → X) (ee ∷ is-equiv e) {x y : S} → is-equiv (hom-map {S} {X} e {x} {y})
is-equiv-hom-map {S} {X} e ee {x} {y} =
  is-equiv-htpy {hom x y} {hom (e x) (e y)} {hom-map-dec {S} {X} e {x} {y}} {hom-map {S} {X} e {x} {y}} (hom-map-dec-eq {S} {X} e {x} {y})
    (is-equiv-circ (Σ-base {𝕀 →ᵣ S} {𝕀 →ᵣ X} (postᵣ {𝕀} {S} {X} e) (λ c' . (c' 𝕀0 ≡ e x) × (c' 𝕀1 ≡ e y)))
      (tot {𝕀 →ᵣ S} {λ c . (c 𝕀0 ≡ x) × (c 𝕀1 ≡ y)} {λ c . (e (c 𝕀0) ≡ e x) × (e (c 𝕀1) ≡ e y)}
        (λ c . prod-map (cong e {c 𝕀0} {x}) (cong e {c 𝕀1} {y})))
      (is-equiv-Σ-base (postᵣ {𝕀} {S} {X} e) (postᵣ-equiv 𝕀 e ee) (λ c' . (c' 𝕀0 ≡ e x) × (c' 𝕀1 ≡ e y)))
      (is-equiv-tot {𝕀 →ᵣ S} {λ c . (c 𝕀0 ≡ x) × (c 𝕀1 ≡ y)} {λ c . (e (c 𝕀0) ≡ e x) × (e (c 𝕀1) ≡ e y)}
        (λ c . prod-map (cong e {c 𝕀0} {x}) (cong e {c 𝕀1} {y}))
        (λ c . is-equiv-prod-map (cong e {c 𝕀0} {x}) (cong e {c 𝕀1} {y}) (ap-equiv e ee (c 𝕀0) x) (ap-equiv e ee (c 𝕀1) y))))

-- path algebra for the conjugation of the gap maps of γ and e γ (cocart-gap-equiv-square)
cocart-gap-equiv-alg-core ∷ {T : U} {X0 Y0 : T} (c0 : X0 ≡ Y0) {Z0 : T} (h : Y0 ≡ Z0) → trans refl h ≡ trans (sym c0) (trans c0 (trans refl h))
cocart-gap-equiv-alg-core {T} {X0} {Y0} c0 refl = sym (trans-sym-l c0)

cocart-gap-equiv-alg ∷ {M T P1 P2 : U} (P : M → T) (F : P1 → P2 → T) {X0 : T} {m : M} (c0 : X0 ≡ P m) {m' : M} (e' : m ≡ m')
  {a0 a : P1} (d1 : a0 ≡ a) {b0 b : P2} (d2 : b0 ≡ b) (h : P m' ≡ F a b) →
  trans (sym (cong P (sym e'))) (trans h (cong (F a) (sym d2)))
  ≡ trans (sym c0) (trans (trans c0 (trans (cong P e') (trans h (sym (cong2 F d1 d2))))) (cong (λ x . F x b0) d1))
cocart-gap-equiv-alg {M} {T} {P1} {P2} P F {X0} {m} c0 refl {a0} refl {b0} refl h = cocart-gap-equiv-alg-core c0 h

-- the gap maps of γ (for pX ∘ e) and of its image e γ (for pX) are conjugate, at every target in S
cocart-gap-equiv-square ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A)
  {u v : S} (γ : hom u v) (s' : S) →
  Σ (M : cocart-pb {S} {A} sA (λ w . pX (e w)) {u} {v} γ s' → cocart-pb {X} {A} sA pX {e u} {e v} (hom-map {S} {X} e {u} {v} γ) (e s')) .
    is-equiv M ×
    ((g : hom v s') → cocart-gap {X} {A} sX sA pX {e u} {e v} (hom-map {S} {X} e {u} {v} γ) (e s') (hom-map {S} {X} e {v} {s'} g)
                        ≡ M (cocart-gap {S} {A} sS sA (λ w . pX (e w)) {u} {v} γ s' g))
cocart-gap-equiv-square {S} {X} {A} sS sX sA e ee pX {u} {v} γ s' =
  let pS ∷ S → A = λ w . pX (e w) in
  let eγ : hom (e u) (e v) = hom-map {S} {X} e {u} {v} γ in
  let GS : hom v s' → cocart-pb {S} {A} sA pS {u} {v} γ s' = cocart-gap {S} {A} sS sA pS {u} {v} γ s' in
  let GX : hom (e v) (e s') → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s') = cocart-gap {X} {A} sX sA pX {e u} {e v} eγ (e s') in
  let hme : hom v s' → hom (e v) (e s') = hom-map {S} {X} e {v} {s'} in
  let hmeU : hom u s' → hom (e u) (e s') = hom-map {S} {X} e {u} {s'} in
  let F : hom (pS u) (pS v) → hom (pS v) (pS s') → hom (pS u) (pS s') = λ m n . comp-homᵣ A sA {pS u} {pS v} {pS s'} m n in
  let Q' : hom (e u) (e s') → U = λ h' . Σ (l : hom (pS v) (pS s')) . hom-map {X} {A} pX {e u} {e s'} h' ≡ F (hom-map {X} {A} pX {e u} {e v} eγ) l in
  let cγ : hom-map {S} {A} pS {u} {v} γ ≡ hom-map {X} {A} pX {e u} {e v} eγ = hom-map-circ {S} {X} {A} e pX {u} {v} γ in
  let AT : (h : hom u s') (l : hom (pS v) (pS s')) → U = λ h l . hom-map {X} {A} pX {e u} {e s'} (hmeU h) ≡ F (hom-map {X} {A} pX {e u} {e v} eγ) l in
  let adj : (h : hom u s') (l : hom (pS v) (pS s')) → hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l → AT h l = λ h l c .
    trans (sym (hom-map-circ {S} {X} {A} e pX {u} {s'} h)) (trans c (cong (λ m . F m l) cγ)) in
  let T1 : cocart-pb {S} {A} sA pS {u} {v} γ s' → Σ (h : hom u s') . Q' (hmeU h) =
    tot {hom u s'} {λ h . Σ (l : hom (pS v) (pS s')) . hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l} {λ h . Q' (hmeU h)}
      (λ h . tot {hom (pS v) (pS s')} {λ l . hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l} {λ l . AT h l} (adj h)) in
  let eT1 : is-equiv T1 =
    is-equiv-tot {hom u s'} {λ h . Σ (l : hom (pS v) (pS s')) . hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l} {λ h . Q' (hmeU h)}
      (λ h . tot {hom (pS v) (pS s')} {λ l . hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l} {λ l . AT h l} (adj h))
      (λ h . is-equiv-tot {hom (pS v) (pS s')} {λ l . hom-map {S} {A} pS {u} {s'} h ≡ F (hom-map {S} {A} pS {u} {v} γ) l} {λ l . AT h l} (adj h)
        (λ l . is-equiv-trans-trans (sym (hom-map-circ {S} {X} {A} e pX {u} {s'} h)) (cong (λ m . F m l) cγ))) in
  let M : cocart-pb {S} {A} sA pS {u} {v} γ s' → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s') = λ w . Σ-base hmeU Q' (T1 w) in
  let eM : is-equiv M = is-equiv-circ (Σ-base hmeU Q') T1 (is-equiv-Σ-base hmeU (is-equiv-hom-map {S} {X} e ee {u} {s'}) Q') eT1 in
  let H : (g : hom v s') → GX (hme g) ≡ M (GS g) = λ g .
    let C : hom u s' = comp-homᵣ S sS {u} {v} {s'} γ g in
    let circC : hom-map {S} {A} pS {u} {s'} C ≡ hom-map {X} {A} pX {e u} {e s'} (hmeU C) = hom-map-circ {S} {X} {A} e pX {u} {s'} C in
    let cg : hom-map {S} {A} pS {v} {s'} g ≡ hom-map {X} {A} pX {e v} {e s'} (hme g) = hom-map-circ {S} {X} {A} e pX {v} {s'} g in
    let he : hmeU C ≡ comp-homᵣ X sX {e u} {e v} {e s'} eγ (hme g) = hom-map-comp S X e sS sX {u} {v} {s'} γ g in
    let hX : hom-map {X} {A} pX {e u} {e s'} (comp-homᵣ X sX {e u} {e v} {e s'} eγ (hme g))
               ≡ F (hom-map {X} {A} pX {e u} {e v} eγ) (hom-map {X} {A} pX {e v} {e s'} (hme g)) =
      hom-map-comp X A pX sX sA {e u} {e v} {e s'} eγ (hme g) in
    pb-path-both (hom-map {X} {A} pX {e u} {e s'}) (λ l . F (hom-map {X} {A} pX {e u} {e v} eγ) l) (sym he) (sym cg)
      hX (adj C (hom-map {S} {A} pS {v} {s'} g) (hom-map-comp S A pS sS sA {u} {v} {s'} γ g))
      (trans (cocart-gap-equiv-alg {hom (e u) (e s')} {hom (pS u) (pS s')} {hom (pS u) (pS v)} {hom (pS v) (pS s')}
                (hom-map {X} {A} pX {e u} {e s'}) F {hom-map {S} {A} pS {u} {s'} C} {hmeU C} circC
                {comp-homᵣ X sX {e u} {e v} {e s'} eγ (hme g)} he
                {hom-map {S} {A} pS {u} {v} γ} {hom-map {X} {A} pX {e u} {e v} eγ} cγ
                {hom-map {S} {A} pS {v} {s'} g} {hom-map {X} {A} pX {e v} {e s'} (hme g)} cg hX)
        (cong {hom-map {S} {A} pS {u} {s'} C ≡ F (hom-map {S} {A} pS {u} {v} γ) (hom-map {S} {A} pS {v} {s'} g)}
              {hom-map {X} {A} pX {e u} {e s'} (hmeU C) ≡ F (hom-map {X} {A} pX {e u} {e v} eγ) (hom-map {S} {A} pS {v} {s'} g)}
          (λ z . trans (sym circC) (trans z (cong (λ m . F m (hom-map {S} {A} pS {v} {s'} g)) cγ)))
          (sym (hom-map-comp-circ S X A e pX sS sX sA {u} {v} {s'} γ g)))) in
  (M , eM , H)

-- cocartesian arrows are preserved by crisp equivalences over the base
is-cocartesian-equiv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A)
  {u v : S} (γ : hom u v) →
  is-cocartesian {S} {A} sS sA (λ w . pX (e w)) {u} {v} γ → is-cocartesian {X} {A} sX sA pX {e u} {e v} (hom-map {S} {X} e {u} {v} γ)
is-cocartesian-equiv {S} {X} {A} sS sX sA e ee pX {u} {v} γ cS t =
  let pS ∷ S → A = λ w . pX (e w) in
  let eγ : hom (e u) (e v) = hom-map {S} {X} e {u} {v} γ in
  let at : (s' : S) → is-equiv (cocart-gap {X} {A} sX sA pX {e u} {e v} eγ (e s')) = λ s' .
    let GS : hom v s' → cocart-pb {S} {A} sA pS {u} {v} γ s' = cocart-gap {S} {A} sS sA pS {u} {v} γ s' in
    let GX : hom (e v) (e s') → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s') = cocart-gap {X} {A} sX sA pX {e u} {e v} eγ (e s') in
    let hme : hom v s' → hom (e v) (e s') = hom-map {S} {X} e {v} {s'} in
    let k : (Σ (M : cocart-pb {S} {A} sA pS {u} {v} γ s' → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s')) .
               is-equiv M × ((g : hom v s') → GX (hme g) ≡ M (GS g))) → is-equiv GX =
      fun (M , r) →
        let eM : is-equiv M = Product.fst r in
        let H : (g : hom v s') → GX (hme g) ≡ M (GS g) = Product.snd r in
        is-equiv-cancel-r GX hme (is-equiv-hom-map {S} {X} e ee {v} {s'})
          (is-equiv-htpy {hom v s'} {cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s')} {λ g . M (GS g)} {λ g . GX (hme g)}
            (λ g . sym (H g)) (is-equiv-circ M GS eM (cS s'))) in
    k (cocart-gap-equiv-square {S} {X} {A} sS sX sA e ee pX {u} {v} γ s') in
  let σ : section e = is-equiv-sec e ee in
  subst (λ y . is-equiv (cocart-gap {X} {A} sX sA pX {e u} {e v} eγ y)) (snd _ σ t) (at (section-map e σ t))

-- and reflected by them
is-cocartesian-equiv-inv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A)
  {u v : S} (γ : hom u v) →
  is-cocartesian {X} {A} sX sA pX {e u} {e v} (hom-map {S} {X} e {u} {v} γ) → is-cocartesian {S} {A} sS sA (λ w . pX (e w)) {u} {v} γ
is-cocartesian-equiv-inv {S} {X} {A} sS sX sA e ee pX {u} {v} γ cX s' =
  let pS ∷ S → A = λ w . pX (e w) in
  let eγ : hom (e u) (e v) = hom-map {S} {X} e {u} {v} γ in
  let GS : hom v s' → cocart-pb {S} {A} sA pS {u} {v} γ s' = cocart-gap {S} {A} sS sA pS {u} {v} γ s' in
  let GX : hom (e v) (e s') → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s') = cocart-gap {X} {A} sX sA pX {e u} {e v} eγ (e s') in
  let hme : hom v s' → hom (e v) (e s') = hom-map {S} {X} e {v} {s'} in
  let k : (Σ (M : cocart-pb {S} {A} sA pS {u} {v} γ s' → cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s')) .
             is-equiv M × ((g : hom v s') → GX (hme g) ≡ M (GS g))) → is-equiv GS =
    fun (M , r) →
      let eM : is-equiv M = Product.fst r in
      let H : (g : hom v s') → GX (hme g) ≡ M (GS g) = Product.snd r in
      is-equiv-cancel-l M GS eM
        (is-equiv-htpy {hom v s'} {cocart-pb {X} {A} sA pX {e u} {e v} eγ (e s')} {λ g . GX (hme g)} {λ g . M (GS g)}
          H (is-equiv-circ GX hme (cX (e s')) (is-equiv-hom-map {S} {X} e ee {v} {s'}))) in
  k (cocart-gap-equiv-square {S} {X} {A} sS sX sA e ee pX {u} {v} γ s')

-- cocartesian 1-cells for pX ∘ e and for pX correspond, along e
cocart-cell-equiv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A) →
  cocart-cell {S} {A} sS sA (λ w . pX (e w)) → cocart-cell {X} {A} sX sA pX
cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX w =
  Σ-base {arrᵣ S} {arrᵣ X} (postᵣ {𝕀} {S} {X} e) (λ f' . is-cocartesian {X} {A} sX sA pX {srcᵣ f'} {tgtᵣ f'} (cell-hom {X} f'))
    (tot {arrᵣ S} {λ f . is-cocartesian {S} {A} sS sA (λ w . pX (e w)) {srcᵣ f} {tgtᵣ f} (cell-hom {S} f)}
         {λ f . is-cocartesian {X} {A} sX sA pX {e (srcᵣ f)} {e (tgtᵣ f)} (cell-hom {X} (postᵣ {𝕀} {S} {X} e f))}
      (λ f . is-cocartesian-equiv {S} {X} {A} sS sX sA e ee pX {srcᵣ f} {tgtᵣ f} (cell-hom {S} f)) w)

is-equiv-cocart-cell-equiv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A) →
  is-equiv (cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX)
is-equiv-cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX =
  let C : arrᵣ X → U = λ f' . is-cocartesian {X} {A} sX sA pX {srcᵣ f'} {tgtᵣ f'} (cell-hom {X} f') in
  let CS : arrᵣ S → U = λ f . is-cocartesian {S} {A} sS sA (λ w . pX (e w)) {srcᵣ f} {tgtᵣ f} (cell-hom {S} f) in
  let c : (f : arrᵣ S) → CS f → C (postᵣ {𝕀} {S} {X} e f) =
    λ f . is-cocartesian-equiv {S} {X} {A} sS sX sA e ee pX {srcᵣ f} {tgtᵣ f} (cell-hom {S} f) in
  is-equiv-circ (Σ-base {arrᵣ S} {arrᵣ X} (postᵣ {𝕀} {S} {X} e) C) (tot {arrᵣ S} {CS} {λ f . C (postᵣ {𝕀} {S} {X} e f)} c)
    (is-equiv-Σ-base (postᵣ {𝕀} {S} {X} e) (postᵣ-equiv 𝕀 e ee) C)
    (is-equiv-tot {arrᵣ S} {CS} {λ f . C (postᵣ {𝕀} {S} {X} e f)} c
      (λ f . is-equiv-prop
        (is-prop-is-cocartesian {S} {A} sS sA (λ w . pX (e w)) {srcᵣ f} {tgtᵣ f} (cell-hom {S} f))
        (is-prop-is-cocartesian {X} {A} sX sA pX {e (srcᵣ f)} {e (tgtᵣ f)} (cell-hom {X} (postᵣ {𝕀} {S} {X} e f)))
        (c f)
        (is-cocartesian-equiv-inv {S} {X} {A} sS sX sA e ee pX {srcᵣ f} {tgtᵣ f} (cell-hom {S} f))))

-- the lifting maps commute with these equivalences
cocart-cell-lift-equiv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A)
  (w : cocart-cell {S} {A} sS sA (λ s . pX (e s))) →
  cocart-cell-lift {X} {A} sX sA pX (cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX w)
    ≡ Σ-base {S} {X} e (λ x . Σ (u : arrᵣ A) . pX x ≡ srcᵣ u) (cocart-cell-lift {S} {A} sS sA (λ s . pX (e s)) w)
cocart-cell-lift-equiv {S} {X} {A} sS sX sA e ee pX (f , c) = refl

-- cocartesian fibrations are invariant under crisp equivalences over the base
is-cocartesian-fibration-equiv ∷ {S X A ∷ U} (sS : is-segalᵣ S) (sX : is-segalᵣ X) (sA : is-segalᵣ A) (e ∷ S → X) (ee ∷ is-equiv e) (pX ∷ X → A) →
  is-cocartesian-fibration {S} {A} sS sA (λ s . pX (e s)) → is-cocartesian-fibration {X} {A} sX sA pX
is-cocartesian-fibration-equiv {S} {X} {A} sS sX sA e ee pX cS =
  is-equiv-conj (cocart-cell-lift {S} {A} sS sA (λ s . pX (e s))) (cocart-cell-lift {X} {A} sX sA pX)
    (cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX)
    (Σ-base {S} {X} e (λ x . Σ (u : arrᵣ A) . pX x ≡ srcᵣ u))
    (cocart-cell-lift-equiv {S} {X} {A} sS sX sA e ee pX)
    (is-equiv-cocart-cell-equiv {S} {X} {A} sS sX sA e ee pX)
    (is-equiv-Σ-base e ee (λ x . Σ (u : arrᵣ A) . pX x ≡ srcᵣ u))
    cS
