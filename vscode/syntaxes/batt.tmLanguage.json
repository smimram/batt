{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BATT",
  "patterns": [
    { "include": "#comments" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#builtins" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-dash.batt",
          "match": "--.*$"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "entity.name.function.batt",
          "match": "^\\s*([^\\s(=]+)",
          "captures": {
            "1": {
              "name": "entity.name.function.batt"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.batt",
          "match": "\\b(let|in|fun|open|import)\\b|λ|:|∷|="
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.batt",
          "match": "\\b(true|false|tt|refl|zero|succ)\\b"
        },
        {
          "name": "constant.numeric.batt",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.type.batt",
          "match": "\\\\(bigotimes|otimes|Sigma|times|fflat|flat|equiv|simeq|circ|top|bot|tol|tor|to)|\\b(U|Type|Bool|Unit|Empty|II[01vw]?)\\b|\\b(Nat|ℕ)\\b(?!-)|𝕀[01∨∧]?|->[lr]?|→[ₗᵣ]?|⨂|⊗|@|≡|≃|∘|Σ|×|⊥|⊤|♭|𝄫"
        }
      ]
    }
  },
  "scopeName": "source.batt"
}